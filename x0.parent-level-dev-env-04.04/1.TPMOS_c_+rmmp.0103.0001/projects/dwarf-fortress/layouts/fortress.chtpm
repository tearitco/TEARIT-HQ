# Dwarf Fortress Layout
# Tile legend:
#   #  = stone wall
#   .  = floor/tunnel
#   +  = fortification
#   D  = dwarf (player)
#   G  = goblin (enemy)
#   ~  = underground river
#   ^  = ore deposit

layout fortress_map:
    size 80x80x1
    tiles:
        "##########################.###################"
        "D.........................................G..."
        ".............................................."
        "..^.....................................^....."
        ".............................................."
        "~............................................~"
        "....................................+........."
        ".............................................."
        "G............................................D"
        "#################################.############"

on_input:
    KEY_PRESSED -> call_method on_move
    ENTER -> call_method on_mining
    REST_KEY -> call_method on_rest
    LOOK_KEY -> call_method on_look
