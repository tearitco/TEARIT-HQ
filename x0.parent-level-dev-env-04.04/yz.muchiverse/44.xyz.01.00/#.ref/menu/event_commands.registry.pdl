# Change Parameter - actor_id + param_id compounded into one field
# (see this file's own header note above on the picker's real 2-field
# ceiling), e.g. "1:2" for actor 1's parameter 2. Shared
# actor_params.txt, keyed "param_<actor_id>:<param_id>".
COMMAND change_parameter
  LABEL Change Parameter
  FIELD1 Actor:Param id (e.g. 1:2):
  FIELD2 Amount:
  PARAMS actor_param,amount
  PAL li x15, 6
  PAL li x13, 0
  PAL ecall "{STATE_DIR}/actor_params.txt" "param_{actor_param}"
  PAL addi x12, x12, {amount}
  PAL li x15, 7
  PAL ecall "{STATE_DIR}/actor_params.txt" "param_{actor_param}"
END

# Recover All - real, defined semantics: reads max_hp/max_mp/max_tp
# (defaulting to 9999 if not yet set - no max-stat system exists in
# this house yet, so 9999 is a documented, real, honest default, not a
# guess dressed up as data) and writes each straight into hp/mp/tp.
# GET_KV_INT already leaves the read value in x12, and SET_KV_INT reads
# its value from x12 too, so no ADDI is needed between them - a true
# heal-to-max, not a delta.
COMMAND recover_all
  LABEL Recover All
  FIELD1 Actor id:
  FIELD2 -
  PARAMS actor_id
  PAL li x15, 6
  PAL li x13, 9999
  PAL ecall "{STATE_DIR}/actor_{actor_id}_stats.txt" "max_hp"
  PAL li x15, 7
  PAL ecall "{STATE_DIR}/actor_{actor_id}_stats.txt" "hp"
  PAL li x15, 6
  PAL li x13, 9999
  PAL ecall "{STATE_DIR}/actor_{actor_id}_stats.txt" "max_mp"
  PAL li x15, 7
  PAL ecall "{STATE_DIR}/actor_{actor_id}_stats.txt" "mp"
  PAL li x15, 6
  PAL li x13, 9999
  PAL ecall "{STATE_DIR}/actor_{actor_id}_stats.txt" "max_tp"
  PAL li x15, 7
  PAL ecall "{STATE_DIR}/actor_{actor_id}_stats.txt" "tp"
END

# Change State - actor_id + state_id compounded (same shape as Change
# Parameter). Add(1)/Remove(0) is a plain SET, not an ADD.
COMMAND change_state
  LABEL Change State
  FIELD1 Actor:State id (e.g. 1:4):
  FIELD2 Add(1)/Remove(0):
  SELECT2 1:0
  PARAMS actor_state,add_remove
  PAL li x15, 7
  PAL li x12, {add_remove}
  PAL ecall "{STATE_DIR}/actor_states.txt" "state_{actor_state}"
END

# Change Skill - actor_id + skill_id compounded. Learn(1)/Forget(0).
COMMAND change_skill
  LABEL Change Skill
  FIELD1 Actor:Skill id (e.g. 1:3):
  FIELD2 Learn(1)/Forget(0):
  SELECT2 1:0
  PARAMS actor_skill,learn_forget
  PAL li x15, 7
  PAL li x12, {learn_forget}
  PAL ecall "{STATE_DIR}/actor_skills.txt" "skill_{actor_skill}"
END

# Change Equipment - actor_id + equipment slot compounded into field1
# (e.g. "1:0" = actor 1, slot 0), item id to equip in field2. Plain SET
# (equipping is "this slot now holds item X", not an add/delta).
COMMAND change_equipment
  LABEL Change Equipment
  FIELD1 Actor:Slot (e.g. 1:0):
  FIELD2 Item id:
  PARAMS actor_slot,item_id
  PAL li x15, 7
  PAL li x12, {item_id}
  PAL ecall "{STATE_DIR}/actor_equipment.txt" "equip_{actor_slot}"
END

# Change Class - real integer class_id SET (see this file's header
# note - grouped with the string commands in the original task
# description, but RPG Maker MV's real field is an int id, so this one
# genuinely fits Shape 1 with no compounding needed).
COMMAND change_class
  LABEL Change Class
  FIELD1 Actor id:
  FIELD2 Class id:
  PARAMS actor_id,class_id
  PAL li x15, 7
  PAL li x12, {class_id}
  PAL ecall "{STATE_DIR}/actor_{actor_id}_stats.txt" "class_id"
END

# ------------------------------------------------------------------
# Change Name / Change Nickname / Change Profile - the three genuine
# STRING SETs, 2026-08-30 (Task 1/2b). Deliberately NOT Shape 1 (PAL):
# prisc+x's real ecall kv system is integer-only (SYS_GET_KV_INT /
# SYS_SET_KV_INT, atoi/"%d\n") - there is no string-set primitive, so
# this is genuinely Shape 2 (new C op + registry TEMPLATE exec), added
# as ONE op binary mr_actor_string.+x dispatched by its own first arg
# (the same pattern mr_character.+x already set). Lives entirely in
# events-hq's own ops dir - no shared-engine/prisc/renderer edits.
# TEMPLATE single-quotes the value (house style); a value containing a
# single quote is the documented limitation every exec-template shares.
# Non-blocking: an actor name/nickname/profile is DATA - no popup, no
# clock coupling.

COMMAND change_name
  LABEL Change Name
  FIELD1 Actor id:
  FIELD2 New name:
  PARAMS actor_id,name
  TEMPLATE exec "$D/&.widgits/events-hq/ops/+x/mr_actor_string.+x" "$ENT" '{actor_id}' name '{name}'
END

COMMAND change_nickname
  LABEL Change Nickname
  FIELD1 Actor id:
  FIELD2 New nickname:
  PARAMS actor_id,nickname
  TEMPLATE exec "$D/&.widgits/events-hq/ops/+x/mr_actor_string.+x" "$ENT" '{actor_id}' nickname '{nickname}'
END

COMMAND change_profile
  LABEL Change Profile
  FIELD1 Actor id:
  FIELD2 Profile text:
  PARAMS actor_id,profile
  TEMPLATE exec "$D/&.widgits/events-hq/ops/+x/mr_actor_string.+x" "$ENT" '{actor_id}' profile '{profile}'
END
