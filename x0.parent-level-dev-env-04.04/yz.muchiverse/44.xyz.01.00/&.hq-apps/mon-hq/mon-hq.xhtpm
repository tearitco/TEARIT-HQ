<!-- mon-hq.xhtpm - "session monitor" HQ window.
     Two headings: GOOD (owned / accounted for) and BAD (stray / leaked).
     Backend: <module> forks mon_refresh.sh, a shell loop that re-runs
     `mon_scan.sh publish state/ui.txt` every couple seconds. The
     renderer substitutes ${...} from state/ui.txt and re-reads it when
     it changes (same shape as stats-hq-pal.xhtpm, minus prisc).
     class "mon-hq" is safe (no built-in C fast-path trips on it). -->
<window label="Session Monitor" class="mon-hq database-window" vars="state/ui.txt">
  <module id="mon_refresh" src="&.hq-apps/mon-hq/mon_refresh.sh"/>
  <page name="main">
    <panel id="bar" class="settings-block">
      <text label="scanned ${scan_time}  -  ${good_count} good / ${bad_count} bad" class="block-title"/>
      <row>
        <item class="btn" label="   refresh now   " action="sh '${PKG}/mon_scan.sh' publish '${PKG}/state/ui.txt'"/>
        <item class="btn danger" label="   KILL ALL BAD   " action="sh '${PKG}/mon_scan.sh' kill-all"/>
        <item class="btn danger" label="  + pals/singletons  " action="sh '${PKG}/mon_scan.sh' kill-all --with-pals"/>
      </row>
    </panel>

    <panel id="bad" class="settings-block">
      <text label="BAD - stray / leaked (no live owner, or a detached engine stack)" class="block-title"/>
      <scrolllist class="from-top">
        <repeat count="${bad_count}" bind="bad">
          <text label="${bad.text}"/>
        </repeat>
        <text label="(none - nothing leaked)" class="quiet" show="${no_bad}"/>
      </scrolllist>
    </panel>

    <panel id="good" class="settings-block">
      <text label="GOOD - owned / accounted for (taskbar, pals, managers, live -hq windows)" class="block-title"/>
      <scrolllist class="from-top">
        <repeat count="${good_count}" bind="good">
          <text label="${good.text}"/>
        </repeat>
        <text label="(nothing running that this house spawned)" class="quiet" show="${no_good}"/>
      </scrolllist>
    </panel>
  </page>
</window>
