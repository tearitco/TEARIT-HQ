<!-- mon-hq.xhtpm - "session monitor" HQ window.

     Uses the db-hq / stats-hq <sidebar> + <panel> structure ON PURPOSE:
     khtpm_core_render only runs layout_sidebar_panel() - which wires the
     X / _ chrome trio, minimize/restore, AND the bottom-taskbar entry -
     when the page has a <sidebar>. A <panel>-only page renders with no
     chrome and never registers with the strip. class "database-window"
     also sets g_default_persistent (a button click must not close it).

     Backend: <module> forks mon_refresh.sh, a shell loop that re-runs
     `mon_scan.sh publish state/ui.txt` every few seconds; the renderer
     substitutes ${...} from state/ui.txt and re-reads it on change.

     <repeat bind="X"> resolves ${X.text} -> ${X_<n>_text}, so the bind
     name MUST equal the key prefix mon_scan.sh writes (good_ / bad_). -->
<window label="Session Monitor" class="mon-hq database-window" vars="state/ui.txt">
  <module id="mon_refresh" src="&.hq-apps/mon-hq/mon_refresh.sh"/>
  <page name="main">
    <sidebar id="sidebar" class="sidebar">
      <text label="scanned ${scan_time}" class="quiet"/>
      <text label="${good_count} good  /  ${bad_count} bad" class="block-title"/>
      <item id="b_refresh" class="btn" label="  refresh now  " action="sh '${PKG}/mon_scan.sh' publish '${PKG}/state/ui.txt'"/>
      <item id="b_kill" class="btn danger" label="  KILL ALL BAD  " action="sh '${PKG}/mon_scan.sh' kill-all"/>
      <item id="b_kill2" class="btn danger" label=" + pals/singletons " action="sh '${PKG}/mon_scan.sh' kill-all --with-pals"/>
      <text label="BAD - stray / leaked" class="block-title"/>
      <scrolllist>
        <repeat count="${bad_count}" bind="bad">
          <item id="bad${bad.#}" class="data-item" label="${bad.text}"/>
        </repeat>
        <text label="(none - nothing leaked)" class="quiet" show="${no_bad}"/>
      </scrolllist>
    </sidebar>
    <panel id="detail" class="settings-block">
      <text label="GOOD - owned / accounted for" class="block-title"/>
      <text label="taskbar group, registered pals, house-wide managers, live -hq windows" class="quiet"/>
      <scrolllist class="from-top">
        <repeat count="${good_count}" bind="good">
          <text label="${good.text}"/>
        </repeat>
        <text label="(nothing running that this house spawned)" class="quiet" show="${no_good}"/>
      </scrolllist>
    </panel>
  </page>
</window>
