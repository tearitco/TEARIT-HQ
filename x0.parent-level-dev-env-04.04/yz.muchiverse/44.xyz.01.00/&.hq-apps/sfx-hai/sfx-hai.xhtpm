<!-- sfx-hai.xhtpm - STATIC TEMPLATE (SCAFFOLD; design BOOK 19.audio/SFX-TOY-DESIGN.md). Layout only; copied from the working img-hai layout shape
     (sidebar rows + one panel with a canvas and two overlay rows). The module tag forks sfx_hai_manager.+x which writes state/ui.txt and the waveform canvas.
     Left: voices (click one), actions, status lines. Centre: waveform of the last sound. Bottom strip: knobs and the words field (cli_io). Right column: verdicts. -->
<window label="sfx-hai - ${status_line}" class="database-window" vars="state/ui.txt">
  <module src="&.hq-apps/sfx-hai/+x/sfx_hai_manager.+x" id="_"/>
  <page name="main">
    <sidebar>
      <text label="Sounds (click to select)" class="quiet"/>
      <repeat count="${s_count}" bind="s">
        <item id="sf${s.#}" class="ms-row ${s.class}" label="${s.label}" action="${s.action}"/>
      </repeat>
      <item id="make" label="Make this sound (and check it)" action="${make_action}"/>
      <item id="play" label="▶ Play the last sound" action="${play_action}"/>
      <text label="recipe: ${sel_line}" class="quiet"/>
      <text label="${words_line}" class="quiet"/>
      <text label="${say_line}" class="quiet"/>
    </sidebar>
    <panel id="wave_p" class="mix-panel">
      <canvas id="view" class="ms-canvas" sprite="${canvas_raw}"/>
      <row id="tb-cursor" class="canvas-overlay-bottom ov-chrome">
        <item id="fm" class="ov-btn" label="f-" action="${fm_action}"/>
        <item id="fp" class="ov-btn" label="f+" action="${fp_action}"/>
        <item id="dm" class="ov-btn" label="d-" action="${dm_action}"/>
        <item id="dp" class="ov-btn" label="d+" action="${dp_action}"/>
        <cli_io id="words" target_id="words" label="words &gt; " action="${words_action}"/>
      </row>
      <row id="tb-place" class="canvas-overlay-right ov-top ov-chrome">
        <item id="jc_yes" class="ov-btn" label="c yes" action="${jc_yes_action}"/>
        <item id="jc_no" class="ov-btn" label="c no" action="${jc_no_action}"/>
        <item id="jo_yes" class="ov-btn" label="o yes" action="${jo_yes_action}"/>
        <item id="jo_no" class="ov-btn" label="o no" action="${jo_no_action}"/>
      </row>
    </panel>
    <footer id="statusbar" class="pchq-footer">
      <text label="${msg}" class="quiet"/>
    </footer>
  </page>
</window>
