<!-- h-ai-lab.xhtpm - "h-ai-lab" HQ window. H-AI-LAB-DESIGN.md Part 3,
     smallest first step: one sidebar row per real AI-registry entry,
     one embedded read-only viewer panel. No chat/retrain tiers yet -
     real, separate, later steps once this embed pattern is proven.

     Same real shape proc-mon already proves (sidebar+panel <window
     class="database-window">, a <module> backend re-publishing
     state/ui.txt on a timer) - NOT db-hq's own bespoke C-side panel-
     injector (dbhq_ce_inject_panel etc.) - this house's standing rule
     is zero new per-project C in khtpm_core_render.c, so the detail
     viewer is a plain <text_area> reading ${detail_text} (see
     ai_lab_scan.sh's own header comment for why content= specifically,
     not <text>).

     H-AI-LAB-DESIGN.md Part 6: a KIND=fsm entry ALSO gets a real
     "scratch block" view (one bordered item per real STATE row in its
     fsm_table.pdl, showing its real NEXT= options, the live-running
     state highlighted) - reuses events-hq's own real, live
     publish_scratch_blocks() visual language, not a new mechanism.
     View-only for now; events-hq's own event.pal has no native
     branching (confirmed via direct code research), so this
     deliberately does NOT pretend cursword's real conditional
     transitions are events-hq "choices" - it's h-ai-lab's own real
     viewer, styled the same way. -->
<window label="h-ai-lab" class="h-ai-lab database-window" vars="state/ui.txt">
  <module id="ai_lab_refresh" src="&.hq-apps/h-ai-lab/ai_lab_refresh.sh"/>
  <page name="main">
    <!-- H-AI-LAB-DESIGN.md Part 7: real <tabbar>/<tab> - MUST be a
         direct child of <page> (confirmed by khtpm_core_render.c's own
         layout code, which iterates page->children looking for it -
         nesting it inside <panel> silently renders nothing). Content-
         switching is driven by h-ai-lab's own already-proven
         action=+var mechanism (view_is_viewer/view_is_new), not
         db-hq's bespoke g_is_db_hq C-side embed logic - that stays a
         grandfathered exception, not a pattern to copy. -->
    <tabbar class="tab-bar" show="${has_detail}">
      <tab id="tab_viewer" label="Viewer" action="sh '${PKG}/ai_lab_scan.sh' '${HOUSE}' view viewer"/>
      <tab id="tab_new" label="New State" action="sh '${PKG}/ai_lab_scan.sh' '${HOUSE}' view new_state"/>
    </tabbar>
    <sidebar id="sidebar" class="sidebar">
      <text label="scanned ${scan_time}" class="quiet"/>
      <text label="${n_instances} AI instance(s)" class="block-title"/>
      <item id="b_refresh" class="btn" label="  refresh now  " action="sh '${PKG}/ai_lab_scan.sh' '${HOUSE}' publish '${PKG}/state/ui.txt'"/>
      <scrolllist>
        <repeat count="${n_instances}" bind="inst">
          <item id="inst${inst.#}" class="data-item inst-row selected${inst.selected}" label="${inst.name}  [${inst.kind}]" action="${inst.action}"/>
        </repeat>
        <text label="(no AI instances registered yet - see H-AI-LAB-DESIGN.md Part 1/2)" class="quiet" show="${no_instances}"/>
      </scrolllist>
    </sidebar>
    <panel id="detail" class="settings-block">
      <text label="Select an instance on the left" class="quiet" show="${no_detail}"/>
      <text label="${detail_name}  —  kind: ${detail_kind}" class="block-title" show="${has_detail}"/>
      <text label="PATH: ${detail_path}" class="quiet" show="${has_detail}"/>
      <text label="IFACE: ${detail_iface}" class="quiet" show="${has_detail}"/>

      <text label="live state: ${fsm_live_state}" class="block-title" show="${show_blocks}"/>
      <scrolllist show="${show_blocks}">
        <repeat count="${n_blocks}" bind="block">
          <item id="blk${block.#}" class="data-item fsm-block current${block.iscurrent}" label="${block.state}  →  ${block.next}"/>
        </repeat>
      </scrolllist>
      <text_area id="detail_view" content="${detail_text}" class="detail-view" show="${show_raw_text}"/>

      <!-- New State tab: same real two-stage PICKER shape as
           events-hq's own "+ Add Command" (direct live report,
           2026-09-13: "it should have same kind of setup that add
           commands from events has, right?" - yes). NEXT targets are
           a closed, real set (the fsm's own other STATE rows) - pick
           them by clicking to toggle, don't type a comma list by
           hand. Name still typed (cli_io) - a NEW state genuinely has
           no existing set to pick from, same real reasoning
           events-hq's own field editor uses typed cli_io fields for
           free-text params. See ai_lab_scan.sh's own addstate_* verbs
           (header comment there) for the backend half. -->
      <text label="Add a new STATE to ${detail_name}" class="block-title" show="${view_is_new}"/>
      <item id="as-add" class="data-item" label="+ Add State" show="${view_is_new}" action="sh '${PKG}/ai_lab_scan.sh' addstate_open '${HOUSE}'"/>
      <!-- REAL FIX 2026-09-13 - a bare top-level <item>/<cli_io>
           sitting AFTER this panel's first <scrolllist> (the "blocks"
           one above, even hidden) gets swept into that one shared
           scroll region instead of staying fixed - confirmed live
           (the cli_io and Save/Cancel rendered inside the picker's
           own cramped scroll box, out of source order). db-hq-pal's
           own working picker never hits this: Cancel/fields are
           always nested INSIDE their scrolllist, never siblings after
           it. Same fix here - name field, toggle list, and Save/
           Cancel all real children of ONE <scrolllist>. -->
      <scrolllist show="${as_open}">
        <repeat count="${n_as_pick}" bind="as_pick">
          <item id="asp${as_pick.#}" class="data-item" label="${as_pick.mark}  ${as_pick.name}" action="sh '${PKG}/ai_lab_scan.sh' addstate_toggle '${HOUSE}' '${as_pick.name}'"/>
        </repeat>
        <text label="(no other states yet - this will be a terminal state)" class="quiet" show="${no_as_pick}"/>
        <text label="name" class="quiet"/>
        <cli_io id="as_name_field" label="[${as_name}]  " action="sh '${PKG}/ai_lab_scan.sh' addstate_name"/>
        <text label="NEXT targets - click to toggle" class="quiet"/>
        <item id="as-save" class="data-item" label="Save state" action="sh '${PKG}/ai_lab_scan.sh' create_state '${PKG}' '${HOUSE}'"/>
        <item id="as-cancel" class="data-item" label="&lt; Cancel" action="sh '${PKG}/ai_lab_scan.sh' addstate_cancel '${HOUSE}'"/>
      </scrolllist>
      <text label="${last_result}" class="quiet" show="${view_is_new}"/>
    </panel>
  </page>
</window>
