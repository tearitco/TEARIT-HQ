<!-- video-player-hq.xhtpm - X11-HQ "Video Player": a queue you drop video files onto, played in an ffplay window, with a file check.
     Drop = the renderer's generic XDND support (<window drop_action>, $DROP_PATH = first dropped path; ZERO renderer C); the handler is the
     compiled op ops/+x/video_player_op.+x (verb drop). One <module>: ops/+x/video_player_manager.+x publishes video_player_ui.txt (vars=).
     Every control is a numbered row, so the relay can drive it. Shape = eden-viewer-hq / csv-lab-hq. -->
<window label="${head}" class="vp-window database-window" vars="video_player_ui.txt" drop_highlight="#88ff66"
        drop_action="sh -c 'exec &quot;$0/ops/+x/video_player_op.+x&quot; &quot;$0&quot; drop'">
  <module src="&.hq-apps/video-player-hq/ops/+x/video_player_manager.+x"/>
  <page name="main">
    <sidebar id="sidebar" class="vp-sidebar">
      <text id="who" label="video player" class="vp-who"/>
      <item id="b-play"   class="vp-tab" label="play"   action="'${PKG}/ops/+x/video_player_op.+x' '${PKG}' play"/>
      <item id="b-pause"  class="vp-tab" label="pause"  action="'${PKG}/ops/+x/video_player_op.+x' '${PKG}' pause"/>
      <item id="b-resume" class="vp-tab" label="resume" action="'${PKG}/ops/+x/video_player_op.+x' '${PKG}' resume"/>
      <item id="b-stop"   class="vp-tab" label="stop"   action="'${PKG}/ops/+x/video_player_op.+x' '${PKG}' stop"/>
      <item id="b-prev"   class="vp-tab" label="prev"   action="'${PKG}/ops/+x/video_player_op.+x' '${PKG}' prev"/>
      <item id="b-next"   class="vp-tab" label="next"   action="'${PKG}/ops/+x/video_player_op.+x' '${PKG}' next"/>
      <item id="b-clear"  class="vp-tab" label="clear"  action="'${PKG}/ops/+x/video_player_op.+x' '${PKG}' clear"/>
    </sidebar>
    <panel id="content" class="vp-panel">
      <text id="status" class="vp-status" label="${status}"/>
      <text id="hint" class="vp-hint" label="${hint}"/>
      <text id="log" class="vp-hint" label="${log}"/>
      <text id="ih" class="vp-hdr" label="file check"/>
      <repeat count="${n_info}" bind="i">
        <text id="i${i.#}" class="vp-info ${i.cls}" label="${i.text}"/>
      </repeat>
      <text id="qh" class="vp-hdr" label="queue (press a row to play it)"/>
      <scrolllist class="from-top">
        <repeat count="${n_q}" bind="q">
          <item id="q${q.#}" class="vp-q ${q.cls}" label="${q.text}" action="'${PKG}/ops/+x/video_player_op.+x' '${PKG}' ${q.act}"/>
        </repeat>
      </scrolllist>
    </panel>
  </page>
</window>
