<!-- video-player-hq.xhtpm - X11-HQ "Video Player": a queue you drop video files onto, played IN this window (ffmpeg frames blitted by the generic <canvas>, sound by an ffplay -nodisp child), with a file check.
     Drop = the renderer's generic XDND support (<window drop_action>, $DROP_PATH = first dropped path; ZERO renderer C); the handler is the
     compiled op ops/+x/video_player_op.+x (verb drop). One <module>: ops/+x/video_player_manager.+x publishes video_player_ui.txt (vars=).
     Every control is a numbered row, so the relay can drive it. Shape = eden-viewer-hq / csv-lab-hq. -->
<window label="${head}" class="vp-window database-window" vars="video_player_ui.txt" drop_highlight="#88ff66"
        drop_action="sh -c 'exec &quot;$0/ops/+x/video_player_op.+x&quot; &quot;$0&quot; drop'">
  <module src="&.hq-apps/video-player-hq/ops/+x/video_player_manager.+x"/>
  <page name="main">
    <!-- left: the queue, status and the file check; centre: the screen (a generic canvas fed raw frames, fills the region); bottom: transport buttons (footer, like pc-hq) -->
    <sidebar id="sidebar" class="${side_cls}">
      <text id="who" label="queue (press a row)" class="vp-who" show="${side_on}"/>
      <repeat count="${n_q}" bind="q">
        <item id="q${q.#}" class="vp-q ${q.cls}" label="${q.text}" action="'${PKG}/ops/+x/video_player_op.+x' '${PKG}' ${q.act}" show="${side_on}" show="${side_on}"/>
      </repeat>
      <text id="ih0" class="vp-hdr" label="now" show="${side_on}"/>
      <text id="status" class="vp-status" label="${status}" show="${side_on}"/>
      <text id="prog" class="vp-hint" label="${prog}" show="${side_on}"/>
      <text id="log" class="vp-hint" label="${log}" show="${side_on}"/>
      <text id="ih" class="vp-hdr" label="file check" show="${side_on}"/>
      <repeat count="${n_info}" bind="i">
      <text id="i${i.#}" class="vp-info ${i.cls}" label="${i.text}" show="${side_on}"/>
      </repeat>
      <text id="hint" class="vp-hint" label="${hint}" show="${side_on}"/>
      <item id="b-follow" class="vp-tab" label="${follow_label}" action="'${PKG}/ops/+x/video_player_op.+x' '${PKG}' follow" show="${side_on}"/>
      <scrolllist class="from-top">
        <repeat count="${n_sc}" bind="c">
          <item id="sc${c.#}" class="vp-sc sprite-inline sprite-big ${c.cls}" label="${c.text}" sprite="${c.sprite}" action="'${PKG}/ops/+x/video_player_op.+x' '${PKG}' ${c.act}" show="${side_on}"/>
        </repeat>
      </scrolllist>
    </sidebar>
    <panel id="content" class="vp-panel"><canvas id="screen" sprite="${canvas_raw}"/></panel>
    <footer id="transport" class="vp-footer">
      <item id="b-play"   class="vp-btn" label="play"     action="'${PKG}/ops/+x/video_player_op.+x' '${PKG}' play"/>
      <item id="b-pause"  class="vp-btn" label="pause"    action="'${PKG}/ops/+x/video_player_op.+x' '${PKG}' pause"/>
      <item id="b-resume" class="vp-btn" label="resume"   action="'${PKG}/ops/+x/video_player_op.+x' '${PKG}' resume"/>
      <item id="b-stop"   class="vp-btn" label="stop"     action="'${PKG}/ops/+x/video_player_op.+x' '${PKG}' stop"/>
      <item id="b-sm"     class="vp-btn" label="scene -" action="'${PKG}/ops/+x/video_player_op.+x' '${PKG}' scene-"/>
      <item id="b-sp"     class="vp-btn" label="scene +" action="'${PKG}/ops/+x/video_player_op.+x' '${PKG}' scene+"/>
      <item id="b-back"   class="vp-btn" label="back 10s" action="'${PKG}/ops/+x/video_player_op.+x' '${PKG}' back"/>
      <item id="b-fwd"    class="vp-btn" label="fwd 10s"  action="'${PKG}/ops/+x/video_player_op.+x' '${PKG}' fwd"/>
      <item id="b-prev"   class="vp-btn" label="prev"     action="'${PKG}/ops/+x/video_player_op.+x' '${PKG}' prev"/>
      <item id="b-next"   class="vp-btn" label="next"     action="'${PKG}/ops/+x/video_player_op.+x' '${PKG}' next"/>
      <item id="b-side"   class="vp-btn" label="${side_label}" action="'${PKG}/ops/+x/video_player_op.+x' '${PKG}' side"/>
      <item id="b-clear"  class="vp-btn" label="clear"    action="'${PKG}/ops/+x/video_player_op.+x' '${PKG}' clear"/>
    </footer>
  </page>
</window>
