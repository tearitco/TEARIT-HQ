<!-- tomom-hq.xhtpm - X11-HQ EDITOR for tomom's plain-text weights.
     Static layout only; shared khtpm_core_render.+x; class="tomom-window
     database-window" hits no g_is_* trigger (generic sidebar/panel/
     scrolllist/cli_io path) - ZERO renderer C.  Design:
     #.#.calendar-dox/!.HQ-IQ-BOOK/08-roadmap/design-docs/TOMOM-HQ-DESIGN.md

     One <module>: ops/+x/tomom_manager.+x - owns the target dir, the cached
     rows, the audit log; publishes tomom_ui.txt, polls tomom_action.txt
     (written by the thin ops/tomom_*.sh shims).  ONE scrolllist serves all
     tabs (meta rows / vocab page / ask transcript): the manager changes
     what the rows ARE, the layout never changes.  Vocab is paged by the
     manager (150 rows) because the generic path scrolls, it does not
     virtualise 1363 rows. -->
<window label="tomom  ·  ${target}  ·  ${safe}" class="tomom-window database-window" vars="tomom_ui.txt">
  <module src="&.hq-apps/tomom-hq/ops/+x/tomom_manager.+x"/>
  <page name="main">

    <sidebar id="sidebar" class="tomom-sidebar">
      <text id="who" label="tomom weights" class="tomom-who"/>
      <item id="tm" class="tomom-tab ${cls_meta}"  label="Meta-RL" action="'${PKG}/ops/tomom_item.sh' 'TAB meta'"/>
      <item id="tv" class="tomom-tab ${cls_vocab}" label="Vocab"   action="'${PKG}/ops/tomom_item.sh' 'TAB vocab'"/>
      <item id="tj" class="tomom-tab ${cls_subject}" label="Subject" action="'${PKG}/ops/tomom_item.sh' 'TAB subject'"/>
      <item id="ta" class="tomom-tab ${cls_ask}"   label="Ask"     action="'${PKG}/ops/tomom_item.sh' 'TAB ask'"/>
      <item id="ti" class="tomom-tab" label="init scratch" action="'${PKG}/ops/tomom_item.sh' 'INIT'"/>
      <item id="tr" class="tomom-tab" label="reload"       action="'${PKG}/ops/tomom_item.sh' 'RELOAD'"/>
    </sidebar>

    <panel id="content" class="tomom-panel">
      <text id="status" class="tomom-status" label="${status}"/>

      <!-- selection detail + edit buttons (meta + vocab tabs) -->
      <text id="s1" class="tomom-sel" label="${sel1}" show="${has_sel}"/>
      <text id="s2" class="tomom-kv"  label="${sel2}" show="${has_sel}"/>
      <text id="s3" class="tomom-kv"  label="${sel3}" show="${has_sel}"/>
      <item id="b-dn"  class="tomom-btn" label="-  (${step})"          action="'${PKG}/ops/tomom_item.sh' 'DOWN'"  show="${tab_edit}"/>
      <item id="b-up"  class="tomom-btn" label="+  (${step})"          action="'${PKG}/ops/tomom_item.sh' 'UP'"    show="${tab_edit}"/>
      <item id="b-rs"  class="tomom-btn" label="reset to original"  action="'${PKG}/ops/tomom_item.sh' 'RESET'" show="${tab_edit}"/>
      <item id="b-un"  class="tomom-btn" label="undo last (${undo_n})" action="'${PKG}/ops/tomom_item.sh' 'UNDO'" show="${tab_edit}"/>

      <!-- subject: breadcrumb + back (3 levels share the one list) -->
      <text id="crumb" class="tomom-quiet" label="${crumb}" show="${crumb}"/>
      <item id="bk" class="tomom-btn" label="&lt; back" action="'${PKG}/ops/tomom_item.sh' 'BACK'" show="${show_back}"/>

      <!-- vocab / subject cells: filter box + page nav -->
      <cli_io id="flt" target_id="flt" rows="1" class="tomom-flt top" content="${flt}"
              label="find word: " action="'${PKG}/ops/tomom_filter.sh'" show="${show_flt}"/>
      <text id="pg" class="tomom-quiet" label="${page_txt}" show="${show_page}"/>
      <item id="pg-p" class="tomom-btn" label="&lt; prev page" action="'${PKG}/ops/tomom_item.sh' 'PGPREV'" show="${show_page}"/>
      <item id="pg-n" class="tomom-btn" label="next page &gt;" action="'${PKG}/ops/tomom_item.sh' 'PGNEXT'" show="${show_page}"/>

      <!-- ask -->
      <text id="ah" class="tomom-quiet" label="${ask_hint}" show="${ask_hint}"/>
      <cli_io id="askbox" target_id="askbox" rows="1" class="tomom-flt top"
              label="ask: " action="'${PKG}/ops/tomom_ask.sh'" show="${tab_ask}"/>
      <text id="as" class="tomom-quiet" label="${ask_state}" show="${tab_ask}"/>

      <scrolllist class="from-top">
        <repeat count="${n_list}" bind="l">
          <item id="l${l.#}" class="tomom-row ${l.cls}" label="${l.text}"
                action="'${PKG}/ops/tomom_item.sh' 'SEL ${l.idx}'"/>
        </repeat>
      </scrolllist>

    </panel>
  </page>
</window>
