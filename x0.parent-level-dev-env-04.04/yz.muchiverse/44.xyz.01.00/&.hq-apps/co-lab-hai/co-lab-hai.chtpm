<!-- co-lab-hai.chtpm - STATIC TEMPLATE (see 08-roadmap/design-docs/
     CHTPM-ARCHITECTURE-FIX.md). Layout only, NOT regenerated at
     runtime. The (module) tag forks colab_hai_manager.+x, which writes
     plain key=value to state/ui.txt; the shared renderer substitutes
     the tokens, expands the repeat blocks from p_0_* / session_0_* /
     msg_0_* , and drops any row whose show= is "" / "0" / "false".
     vars= resolves against this file's own dir. button.sh restores
     this file from the .bootstrap if the module tag goes missing. Do
     not hand-generate this markup from the manager. -->
<window label="Co-lab-h-ai" class="co-lab-hai" vars="state/ui.txt">
  <module src="&.hq-apps/co-lab-hai/+x/colab_hai_manager.+x"/>
  <page name="main">
    <sidebar>
      <text label="Participants" class="quiet"/>
      <repeat count="${participants_count}" bind="p">
        <text label="${p.name}" class="${p.class}"/>
      </repeat>
      <text label="Pending: ${n_pending}" class="pending-count" show="${has_pending}"/>
      <text label="Sessions" class="quiet"/>
      <item id="ch-newsession" label="+ New session" action="${newsession_action}"/>
      <repeat count="${sessions_count}" bind="session">
        <item id="ch-sess-${session.#}" label="${session.label}" action="${session.action}"/>
      </repeat>
    </sidebar>
    <panel>
      <row class="toolbar">
        <item id="ch-menu" label="Menu" onclick="ACTIVATE"/>
      </row>
      <item id="ch-menu-dir" label="Dir" target_id="ch-menu" class="dropdown-child" action="${dir_action}"/>
      <item id="ch-menu-faq" label="FAQ" target_id="ch-menu" class="dropdown-child" action="${faq_action}"/>
      <text label="PENDING (${pend_agent}): ${pend_msg}" class="pending-text" show="${has_pending}"/>
      <row class="toolbar" show="${has_pending}">
        <item id="ch-approve" label="Approve" action="${approve_action}"/>
        <item id="ch-reject" label="Reject" action="${reject_action}"/>
      </row>
      <scrolllist id="conv" class="from-bottom conv-list">
        <repeat count="${conv_count}" bind="msg">
          <text label="${msg.text}" class="${msg.class}"/>
        </repeat>
      </scrolllist>
      <cli_io id="composer" target_id="composer" label="&gt; " action="${post_action}"/>
    </panel>
  </page>
</window>
