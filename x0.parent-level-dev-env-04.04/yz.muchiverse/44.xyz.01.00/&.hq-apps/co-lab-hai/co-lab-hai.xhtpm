<!-- co-lab-hai.chtpm - STATIC TEMPLATE (see 08-roadmap/design-docs/
     CHTPM-ARCHITECTURE-FIX.md). Layout only, NOT regenerated at
     runtime. The (module) tag forks colab_hai_manager.+x, which writes
     plain key=value to state/ui.txt; the shared renderer substitutes
     the tokens, expands the repeat blocks from p_0_* / session_0_* /
     msg_0_* , and drops any row whose show= is "" / "0" / "false".
     vars= resolves against this file's own dir. button.sh restores
     this file from the .bootstrap if the module tag goes missing. Do
     not hand-generate this markup from the manager. -->
<window label="Co-lab-h-ai" class="co-lab-hai database-window" vars="state/ui.txt">
  <module src="&.hq-apps/co-lab-hai/+x/colab_hai_manager.+x"/>
  <page name="main">
    <sidebar>
      <text label="Participants" class="quiet"/>
      <repeat count="${participants_count}" bind="p">
        <text label="${p.name}" class="${p.class}"/>
      </repeat>
      <text label="Pending: ${n_pending}" class="pending-count" show="${has_pending}"/>
      <text label="Sessions" class="quiet"/>
      <item id="ch-newsession" label="+ New session" action="${newsession_action}"/>
      <repeat count="${sessions_count}" bind="session">
        <item id="ch-sess-${session.#}" label="${session.label}" action="${session.action}"/>
      </repeat>
    </sidebar>
    <panel>
      <row class="toolbar">
        <item id="ch-menu" label="Menu" onclick="ACTIVATE"/>
      </row>
      <item id="ch-menu-dir" label="Dir" target_id="ch-menu" class="dropdown-child" action="${dir_action}"/>
      <item id="ch-menu-faq" label="FAQ" target_id="ch-menu" class="dropdown-child" action="${faq_action}"/>
      <!-- REAL FIX 2026-09-29 (bug_bounty.md's OPEN co-lab-hai entry;
           direct live report, with a real screenshot: truncating with
           "..." was NOT acceptable - "user should be able to read the
           message they need to approve"). A bare text_area with no
           class does not get its own height in this panel's shape - it
           inherits the shared bottom-composer sizing (khtpm_core_
           render.c, ~line 4897's else branch: c-&gt;h = composer_h),
           same as the real bottom composer field, not its own rows=.
           The real fix is class=top, a documented, already-used escape
           hatch (see sql-hq.xhtpm's own real text_area, rows=7, class
           top sql-editor - same core-render.c header comment, ~line
           4713, on that mechanism) that lays the field inline in
           normal top-down flow using its own rows= height instead of
           gluing it to the bottom.

           A long message's drawn text still overflows this box's own
           height uncapped when it exceeds rows=4 - a real, smaller,
           cosmetic-only remaining issue (visual overlap on the row
           below), not a missing-content one. rows=8 was tried and
           reverted - it consumed enough panel height that everything
           after it (approve/reject, the whole conversation list)
           vanished from the frame outright, worse than the overlap.
           Note for future editors of this comment block: do not paste
           literal angle-bracket tag examples in here - an earlier pass
           did, and this house's own template parser is not fully
           comment-aware, so literal tag-like text inside a comment can
           still break well-formedness. Describe tags in prose only. -->
      <!-- REAL FIX 2026-09-29, direct live report ("it keeps asking
           for approval for an old message... [hi x.com!]") - class=
           "no-persist" (khtpm_core_render.c's default_text_area_save()/
           kh_text_areas_reload()) opts this OUT of the generic "restore
           a text_area's typed buffer across reparse" mechanism - this
           field is 100% server-driven (content= above), never user-
           edited, and without this it can get permanently stuck on
           whatever was last saved to text_area_pend-msg.txt (which is
           exactly what happened here) regardless of any later content=
           change, restart, or rebuild. -->
      <text_area id="pend-msg" class="top pending-text no-persist" content="PENDING (${pend_agent}): ${pend_msg}" show="${has_pending}" rows="${pend_rows}"/>
      <row class="toolbar" show="${has_pending}">
        <item id="ch-approve" label="Approve" action="${approve_action}"/>
        <item id="ch-reject" label="Reject" action="${reject_action}"/>
      </row>
      <scrolllist id="conv" class="from-bottom conv-list">
        <repeat count="${conv_count}" bind="msg">
          <text label="${msg.text}" class="${msg.class}"/>
        </repeat>
      </scrolllist>
      <cli_io id="composer" target_id="composer" label="&gt; " action="${post_action}"/>
    </panel>
  </page>
</window>
