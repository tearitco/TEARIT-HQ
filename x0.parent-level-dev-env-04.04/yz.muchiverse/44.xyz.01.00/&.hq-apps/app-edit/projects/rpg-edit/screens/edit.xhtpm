<!-- edit.xhtpm - the rpg-edit phone screen (2026-11-17): the EDITOR inside the phone window. The phone's own top bar and footer (${PHONE_BARS}, ${PHONE_FOOTER}) stay; between them: a small editor toolbar (the In switch and the page picker) and the map canvas of this phone's own editor instance. Every value is a ${var} written by redit_op (the host and bridge): bv_session and canvas_raw come from the editor's projector as they are (the renderer routes the canvas size and clicks into that session), everything else has the prefix ed_. Design BOOK 16.game/PLUS-PHONE-RPG-EDIT-EMBEDDED-DESIGN-2026-11-17.md (slice S1: map view and page picker). -->
<window label="${window_title}" class="rpgedit database-window phone-portrait managed">
  <module id="projector" src="&.hq-apps/plus-phone/apps/rpg-edit/ops/+x/redit_op.+x"/>
  <page name="main">
    ${PHONE_BARS}
    ${APP_CHROME}
    <tabbar id="edtb" class="tab-bar">
      <tab id="ed-in" class="tab ${interact_class}" label="In: ${ed_interact_label}" relay="${bv_h1},${bv_h2}" onclick="'${HOUSE}/@.apps/piececraft-hq/ops/pchq_board_action.sh' '${bv_session}' 'interact'"/>
      <tab id="ed-book" class="tab" label="${ed_book_label} v" onclick="ACTIVATE" target_id="ed-book"/>
      <tab id="ed-page" class="tab" label="${ed_page_label} v" onclick="ACTIVATE" target_id="ed-page"/>
    </tabbar>
    <repeat count="${ed_n_file_opts}" bind="ed_f">
      <item id="fo-${ed_f.#}" class="dd-row dropdown-child ${ed_f.active}" target_id="ed-book" label="${ed_f.label}" action="'${HOUSE}/@.apps/piececraft-hq/ops/pchq_board_action.sh' '${bv_session}' '${ed_f.verb}' '${ed_f.arg}'"/>
    </repeat>
    <item id="fo-cancel" class="dd-row dropdown-child quiet" target_id="ed-book" label="- cancel -" action="void"/>
    <repeat count="${ed_n_desk_opts}" bind="ed_d">
      <item id="do-${ed_d.#}" class="dd-row dropdown-child ${ed_d.active}" target_id="ed-page" label="${ed_d.label}" action="'${HOUSE}/@.apps/piececraft-hq/ops/pchq_board_action.sh' '${bv_session}' 'desk' '${ed_d.id}'"/>
    </repeat>
    <item id="do-cancel" class="dd-row dropdown-child quiet" target_id="ed-page" label="- cancel -" action="void"/>
    <text label="${status}" class="quiet"/>
    <canvas id="view" class="edview" sprite="${canvas_raw}"/>
    ${PHONE_FOOTER}
  </page>
</window>
