<!-- dashboard.xhtpm - db-hq as a STATIC template driven by a PAL
     projector (CHTPM-ARCHITECTURE-FIX.md ; _shared-lib/system/string-ops.md).
     ONE window: the 15 RPG-Maker tabs as toolbar rows across the top of
     the panel, the active tab's record list in the sidebar, the
     selected record's fields in the panel. Clicking a tab or a record
     runs ops/dbhq_action.sh, which rewrites state/active.pdl; the
     <module> projector re-reads that + the tab's
     #.desktop/db_hq_<x>.state.txt and rewrites state/ui.txt.

     class="db-hq-pal" (NOT "db-hq") so the renderer's built-in
     g_is_db_hq C path stays dormant - this is a plain generic
     sidebar+panel window. Common Events keeps its own editor (its tab
     just links to it). Pick a tab -> ACTIVATE scopes nav into the "records" list (the
     spirit of db-hq_activate_scope / piececraft INTERACT); Esc exits
     back to the tab row. -->
<window label="DB (PAL)" class="db-hq-pal" vars="state/ui.txt">
  <module src="&.widgits/_shared-lib/system/+x/prisc+x.+x pal/dbhq_projector.pal"/>
  <page name="main">
    <sidebar>
      <text label="${tab_title}"/>
      <scrolllist id="records">
        <repeat count="${rows_count}" bind="row">
          <item id="r${row.#}" label="${row.text}" action="'${PKG}/ops/dbhq_action.sh' 'sel' '${row.#}'"/>
        </repeat>
      </scrolllist>
    </sidebar>
    <panel>
      <row class="toolbar">
        <item label="Actors"     onclick="ACTIVATE '${PKG}/ops/dbhq_action.sh' 'tab' 'db_hq_actors.state.txt' 'ACTOR' 'Actors'" target_id="records"/>
        <item label="Classes"    onclick="ACTIVATE '${PKG}/ops/dbhq_action.sh' 'tab' 'db_hq_classes.state.txt' 'CLASS' 'Classes'" target_id="records"/>
        <item label="Skills"     onclick="ACTIVATE '${PKG}/ops/dbhq_action.sh' 'tab' 'db_hq_skills.state.txt' 'SKILL' 'Skills'" target_id="records"/>
        <item label="Items"      onclick="ACTIVATE '${PKG}/ops/dbhq_action.sh' 'tab' 'db_hq_items.state.txt' 'ITEM' 'Items'" target_id="records"/>
        <item label="Weapons"    onclick="ACTIVATE '${PKG}/ops/dbhq_action.sh' 'tab' 'db_hq_weapons.state.txt' 'WEAPON' 'Weapons'" target_id="records"/>
      </row>
      <row class="toolbar">
        <item label="Armors"     onclick="ACTIVATE '${PKG}/ops/dbhq_action.sh' 'tab' 'db_hq_armors.state.txt' 'ARMOR' 'Armors'" target_id="records"/>
        <item label="Enemies"    onclick="ACTIVATE '${PKG}/ops/dbhq_action.sh' 'tab' 'db_hq_enemies.state.txt' 'ENEMY' 'Enemies'" target_id="records"/>
        <item label="Troops"     onclick="ACTIVATE '${PKG}/ops/dbhq_action.sh' 'tab' 'db_hq_troops.state.txt' 'TROOP' 'Troops'" target_id="records"/>
        <item label="States"     onclick="ACTIVATE '${PKG}/ops/dbhq_action.sh' 'tab' 'db_hq_states.state.txt' 'STATE' 'States'" target_id="records"/>
        <item label="Animations" onclick="ACTIVATE '${PKG}/ops/dbhq_action.sh' 'tab' 'db_hq_animations.state.txt' 'ANIMATION' 'Animations'" target_id="records"/>
      </row>
      <row class="toolbar">
        <item label="Tilesets"   onclick="ACTIVATE '${PKG}/ops/dbhq_action.sh' 'tab' 'db_hq_tilesets.state.txt' 'TILESET' 'Tilesets'" target_id="records"/>
        <item label="Common Ev"  onclick="ACTIVATE '${PKG}/ops/dbhq_action.sh' 'tab' 'db_hq_common_events.state.txt' 'CE' 'Common Events'" target_id="records"/>
        <item label="System"     onclick="ACTIVATE '${PKG}/ops/dbhq_action.sh' 'tab' 'db_hq_system.state.txt' 'SYSTEM' 'System'" target_id="records"/>
        <item label="Types"      onclick="ACTIVATE '${PKG}/ops/dbhq_action.sh' 'tab' 'db_hq_types.state.txt' 'TYPE' 'Types'" target_id="records"/>
        <item label="Terms"      onclick="ACTIVATE '${PKG}/ops/dbhq_action.sh' 'tab' 'db_hq_terms.state.txt' 'TERM' 'Terms'" target_id="records"/>
      </row>
      <text label="${detail_title}" class="quiet"/>
      <scrolllist class="from-top">
        <repeat count="${kv_count}" bind="kv">
          <text label="${kv.text}"/>
        </repeat>
        <text label="Common Events has its own command editor." class="quiet" show="${is_ce}"/>
        <item label="Open the Common Events editor" action="'${PKG}/ops/dbhq_action.sh' 'open-ce'" show="${is_ce}"/>
      </scrolllist>
    </panel>
  </page>
</window>
