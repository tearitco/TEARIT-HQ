<!-- dashboard.xhtpm - db-hq as a STATIC template driven by a PAL
     projector (CHTPM-ARCHITECTURE-FIX.md ; _shared-lib/system/string-ops.md).
     Same shape as the original db-hq: a <tabbar> of the 15 RPG-Maker
     categories, the active tab's record list in the <sidebar>, the
     selected record's fields in the <panel>.

     Choosing a tab runs ops/dbhq_action.sh (rewrites state/active.pdl),
     marks the tab active, and scopes nav into the record list ([^],
     Esc returns to the tab row) - the generic renderer's <tab> +
     ACTIVATE-scope handling, spirit of db-hq's own dbhq_activate_scope
     and piececraft INTERACT. The <module> projector re-reads
     active.pdl + the tab's #.desktop/db_hq_<x>.state.txt and rewrites
     state/ui.txt.

     class="db-hq-pal" (NOT "db-hq") so the renderer's built-in
     g_is_db_hq C path stays dormant. Common Events tab embeds the
     same events-hq command editor (compile chain unchanged). Other
     tabs show per-field tiles (cli_io + graphic swatches). -->
<window label="DB (PAL)" class="db-hq-pal database-window" vars="state/ui.txt state/ui_ce.txt">
  <module src="&.widgits/_shared-lib/system/+x/prisc+x.+x pal/dbhq_projector.pal"/>
  <module src="&.hq-apps/db-hq-pal/ops/+x/dbhq_ce_bridge.+x"/>
  <page name="main">
    <!-- REAL FIX 2026-09-13, direct live report: on a fresh process
         (before any click in ITS OWN lifetime), the tab bar used to
         hardcode Actors as class="active" regardless of what the real
         PERSISTED state (active.pdl's own tag, read by dbhq_ce_bridge.c
         every poll) actually says - confirmed live: real state said
         tag=CE, panel correctly showed Common Events, tab bar still
         showed no tab as active. Each tab's class now comes straight
         from dbhq_ce_bridge.c's own real active_<tab> var (the literal
         word "active" or empty - see that function's own header
         comment for why not a 0/1 boolean suffix) instead of a static
         default. -->
    <tabbar class="tab-bar">
      <tab id="tab-actors"     class="${active_actors}"     label="Actors"        target_id="sidebar" action="'${PKG}/ops/dbhq_action.sh' 'tab' 'db_hq_actors.state.txt' 'ACTOR' 'Actors'"/>
      <tab id="tab-classes"    class="${active_classes}"    label="Classes"       target_id="sidebar" action="'${PKG}/ops/dbhq_action.sh' 'tab' 'db_hq_classes.state.txt' 'CLASS' 'Classes'"/>
      <tab id="tab-skills"     class="${active_skills}"     label="Skills"        target_id="sidebar" action="'${PKG}/ops/dbhq_action.sh' 'tab' 'db_hq_skills.state.txt' 'SKILL' 'Skills'"/>
      <tab id="tab-items"      class="${active_items}"      label="Items"         target_id="sidebar" action="'${PKG}/ops/dbhq_action.sh' 'tab' 'db_hq_items.state.txt' 'ITEM' 'Items'"/>
      <tab id="tab-weapons"    class="${active_weapons}"    label="Weapons"       target_id="sidebar" action="'${PKG}/ops/dbhq_action.sh' 'tab' 'db_hq_weapons.state.txt' 'WEAPON' 'Weapons'"/>
      <tab id="tab-armors"     class="${active_armors}"     label="Armors"        target_id="sidebar" action="'${PKG}/ops/dbhq_action.sh' 'tab' 'db_hq_armors.state.txt' 'ARMOR' 'Armors'"/>
      <tab id="tab-enemies"    class="${active_enemies}"    label="Enemies"       target_id="sidebar" action="'${PKG}/ops/dbhq_action.sh' 'tab' 'db_hq_enemies.state.txt' 'ENEMY' 'Enemies'"/>
      <tab id="tab-troops"     class="${active_troops}"     label="Troops"        target_id="sidebar" action="'${PKG}/ops/dbhq_action.sh' 'tab' 'db_hq_troops.state.txt' 'TROOP' 'Troops'"/>
      <tab id="tab-states"     class="${active_states}"     label="States"        target_id="sidebar" action="'${PKG}/ops/dbhq_action.sh' 'tab' 'db_hq_states.state.txt' 'STATE' 'States'"/>
      <tab id="tab-animations" class="${active_animations}" label="Animations"    target_id="sidebar" action="'${PKG}/ops/dbhq_action.sh' 'tab' 'db_hq_animations.state.txt' 'ANIMATION' 'Animations'"/>
      <tab id="tab-tilesets"   class="${active_tilesets}"   label="Tilesets"      target_id="sidebar" action="'${PKG}/ops/dbhq_action.sh' 'tab' 'db_hq_tilesets.state.txt' 'TILESET' 'Tilesets'"/>
      <tab id="tab-ce"         class="${active_ce}"         label="Common Events" target_id="sidebar" action="'${PKG}/ops/dbhq_action.sh' 'tab' 'db_hq_common_events.state.txt' 'CE' 'Common Events'"/>
      <tab id="tab-system"     class="${active_system}"     label="System"        target_id="sidebar" action="'${PKG}/ops/dbhq_action.sh' 'tab' 'db_hq_system.state.txt' 'SYSTEM' 'System'"/>
      <tab id="tab-types"      class="${active_types}"      label="Types"         target_id="sidebar" action="'${PKG}/ops/dbhq_action.sh' 'tab' 'db_hq_types.state.txt' 'TYPE' 'Types'"/>
      <tab id="tab-terms"      class="${active_terms}"      label="Terms"         target_id="sidebar" action="'${PKG}/ops/dbhq_action.sh' 'tab' 'db_hq_terms.state.txt' 'TERM' 'Terms'"/>
    </tabbar>
    <sidebar id="sidebar" class="sidebar">
      <text label="${tab_title}" class="quiet"/>
      <scrolllist>
        <repeat count="${rows_count}" bind="row">
          <!-- REAL FIX 2026-09-13, direct live report ("it skips 20,
               21"): a row's own selection used to just fire its plain
               action= - nothing ever widened nav scope past the tab
               click's own confinement to <sidebar> (see <tab
               target_id="sidebar"> above), so anything the selection
               reveals in <panel id="detail"> (Common Events' own
               Trigger/+Add Command/Play/command-list controls, or any
               other tab's own detail fields) sat structurally outside
               the confined scope and arrow-nav silently skipped past
               it - real, reproduced, not guessed (kh_nav_step()'s own
               scope-confine branch, khtpm_core_render.c ~line 5157).
               Real, existing house precedent for "click, then widen
               scope into a container, then also run a real action":
               onclick="ACTIVATE <command>" + target_id=<container id>
               - the exact mechanism <tab target_id="sidebar"> above
               already uses to scope INTO the sidebar in the first
               place. Reusing it here to scope back OUT into the
               panel once a row is picked, instead of inventing
               anything new. -->
          <item id="r${row.#}" class="data-item" label="${row.text}" target_id="detail" action="ACTIVATE '${PKG}/ops/dbhq_action.sh' 'sel' '${row.#}'"/>
        </repeat>
      </scrolllist>
    </sidebar>
    <panel id="detail" class="settings-block">
      <!-- RPG Maker field tiles (Actors/Items/…) -->
      <text label="${detail_title}" class="block-title" show="${is_db}"/>
      <scrolllist class="from-top" show="${is_db}">
        <repeat count="${kv_count}" bind="kv">
          <item class="swatch db-field-tile" sprite="${kv.sprite}" label="${kv.key}" show="${kv.has_sprite}"/>
          <cli_io id="fld_${kv.key}" target_id="fld_${kv.key}" class="data-item" label="${kv.key}  [${kv.value}]  " action="'${PKG}/ops/dbhq_action.sh' 'field' '${kv.key}'"/>
        </repeat>
      </scrolllist>

      <!-- Common Events: same editor as events-hq for entities -->
      <text label="Trigger" class="block-title" show="${is_ce}"/>
      <text label="${trigger}" show="${is_ce}"/>
      <item id="ce-add" class="data-item" label="+ Add Command" show="${is_ce}" action="'${HOUSE}/&.widgits/events-hq/ops/evhq_action.sh' 'picker' 'open' '${ce_pkg}'"/>
      <item id="ce-play" class="data-item" label="Play" show="${is_ce}" action="'${HOUSE}/&.widgits/events-hq/ops/evhq_action.sh' 'play' '-' '${ce_pkg}'"/>
      <text label="${detail_hint}" class="quiet" show="${is_ce}"/>

      <text label="${ce_list_title}" class="block-title" show="${list_open}"/>
      <scrolllist class="from-top" show="${list_open}">
        <repeat count="${n_cmds}" bind="cmd">
          <item id="c${cmd.#}" class="data-item" label="${cmd.text}" action="'${HOUSE}/&.widgits/events-hq/ops/evhq_action.sh' 'edit' '${cmd.id}' '${ce_pkg}'"/>
          <item id="cd${cmd.#}" class="quiet" label="   - delete #${cmd.id}" action="'${HOUSE}/&.widgits/events-hq/ops/evhq_action.sh' 'del' '${cmd.id}' '${ce_pkg}'"/>
        </repeat>
        <text label="(no commands on this event yet)" class="quiet" show="${empty_list}"/>
      </scrolllist>

      <text label="Add Command  -  pick a type" class="block-title" show="${picker_open}"/>
      <scrolllist class="from-top" show="${picker_open}">
        <item id="ce-picker-cancel" class="data-item" label="&lt; Cancel" action="'${HOUSE}/&.widgits/events-hq/ops/evhq_action.sh' 'picker' 'close' '${ce_pkg}'"/>
        <repeat count="${n_picker}" bind="pk">
          <item id="cpk${pk.#}" class="data-item" label="${pk.label}" action="'${HOUSE}/&.widgits/events-hq/ops/evhq_action.sh' 'pick' '${pk.type}' '${ce_pkg}'"/>
        </repeat>
      </scrolllist>

      <text label="${editor_title}  -  fields" class="block-title" show="${fields_open}"/>
      <scrolllist class="from-top" show="${fields_open}">
        <item id="ce-fld-cancel" class="data-item" label="&lt; Cancel" action="'${HOUSE}/&.widgits/events-hq/ops/evhq_action.sh' 'cancel-fields' '-' '${ce_pkg}'"/>
        <repeat count="${n_fields}" bind="f">
          <cli_io id="cefld_${f.name}" target_id="cefld_${f.name}" label="${f.prompt}  [${f.value}]  " action="'${HOUSE}/&.widgits/events-hq/ops/evhq_action.sh' 'field' '${editor_type}' '${f.name}' '${ce_pkg}'"/>
        </repeat>
        <item id="ce-fld-save" class="data-item" label="Save command" action="'${HOUSE}/&.widgits/events-hq/ops/evhq_action.sh' 'commit' '-' '${ce_pkg}'"/>
      </scrolllist>
    </panel>
  </page>
</window>
