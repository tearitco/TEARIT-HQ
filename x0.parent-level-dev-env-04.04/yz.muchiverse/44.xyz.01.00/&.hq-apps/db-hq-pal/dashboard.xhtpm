<!-- dashboard.chtpm - db-hq as a STATIC template driven by a PAL
     projector (CHTPM-ARCHITECTURE-FIX.md ; _shared-lib/system/string-ops.md).
     ONE window: the 15 RPG-Maker tabs as toolbar rows across the top of
     the panel, the active tab's record list in the sidebar, the
     selected record's fields in the panel. Clicking a tab or a record
     runs ops/dbhq_action.sh, which rewrites state/active.pdl; the
     <module> projector re-reads that + the tab's
     #.desktop/db_hq_<x>.state.txt and rewrites state/ui.txt.

     class="db-hq-pal" (NOT "db-hq") so the renderer's built-in
     g_is_db_hq C path stays dormant - this is a plain generic
     sidebar+panel window. Common Events keeps its own editor (its tab
     just links to it). button.sh restores this file from the .bootstrap. -->
<window label="DB (PAL)" class="db-hq-pal" vars="state/ui.txt">
  <module src="&.widgits/_shared-lib/system/+x/prisc+x.+x pal/dbhq_projector.pal"/>
  <page name="main">
    <sidebar>
      <text label="${tab_title}"/>
      <scrolllist>
        <repeat count="${rows_count}" bind="row">
          <item id="r${row.#}" label="${row.text}" action="'${PKG}/ops/dbhq_action.sh' 'sel' '${row.#}'"/>
        </repeat>
      </scrolllist>
    </sidebar>
    <panel>
      <row class="toolbar">
        <item label="Actors"     action="'${PKG}/ops/dbhq_action.sh' 'tab' 'db_hq_actors.state.txt' 'ACTOR' 'Actors'"/>
        <item label="Classes"    action="'${PKG}/ops/dbhq_action.sh' 'tab' 'db_hq_classes.state.txt' 'CLASS' 'Classes'"/>
        <item label="Skills"     action="'${PKG}/ops/dbhq_action.sh' 'tab' 'db_hq_skills.state.txt' 'SKILL' 'Skills'"/>
        <item label="Items"      action="'${PKG}/ops/dbhq_action.sh' 'tab' 'db_hq_items.state.txt' 'ITEM' 'Items'"/>
        <item label="Weapons"    action="'${PKG}/ops/dbhq_action.sh' 'tab' 'db_hq_weapons.state.txt' 'WEAPON' 'Weapons'"/>
      </row>
      <row class="toolbar">
        <item label="Armors"     action="'${PKG}/ops/dbhq_action.sh' 'tab' 'db_hq_armors.state.txt' 'ARMOR' 'Armors'"/>
        <item label="Enemies"    action="'${PKG}/ops/dbhq_action.sh' 'tab' 'db_hq_enemies.state.txt' 'ENEMY' 'Enemies'"/>
        <item label="Troops"     action="'${PKG}/ops/dbhq_action.sh' 'tab' 'db_hq_troops.state.txt' 'TROOP' 'Troops'"/>
        <item label="States"     action="'${PKG}/ops/dbhq_action.sh' 'tab' 'db_hq_states.state.txt' 'STATE' 'States'"/>
        <item label="Animations" action="'${PKG}/ops/dbhq_action.sh' 'tab' 'db_hq_animations.state.txt' 'ANIMATION' 'Animations'"/>
      </row>
      <row class="toolbar">
        <item label="Tilesets"   action="'${PKG}/ops/dbhq_action.sh' 'tab' 'db_hq_tilesets.state.txt' 'TILESET' 'Tilesets'"/>
        <item label="Common Ev"  action="'${PKG}/ops/dbhq_action.sh' 'tab' 'db_hq_common_events.state.txt' 'CE' 'Common Events'"/>
        <item label="System"     action="'${PKG}/ops/dbhq_action.sh' 'tab' 'db_hq_system.state.txt' 'SYSTEM' 'System'"/>
        <item label="Types"      action="'${PKG}/ops/dbhq_action.sh' 'tab' 'db_hq_types.state.txt' 'TYPE' 'Types'"/>
        <item label="Terms"      action="'${PKG}/ops/dbhq_action.sh' 'tab' 'db_hq_terms.state.txt' 'TERM' 'Terms'"/>
      </row>
      <text label="${detail_title}" class="quiet"/>
      <scrolllist class="from-top">
        <repeat count="${kv_count}" bind="kv">
          <text label="${kv.text}"/>
        </repeat>
        <text label="Common Events has its own command editor." class="quiet" show="${is_ce}"/>
        <item label="Open the Common Events editor" action="'${PKG}/ops/dbhq_action.sh' 'open-ce'" show="${is_ce}"/>
      </scrolllist>
    </panel>
  </page>
</window>
