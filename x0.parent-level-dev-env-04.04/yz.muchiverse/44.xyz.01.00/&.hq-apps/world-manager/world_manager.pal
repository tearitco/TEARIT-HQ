# world_manager.pal - Central world state manager
# Orchestrates house-level game state via append-only ledgers.
# Syncs entity positions, detects movement, queues animations.
# Mirrors RPG Maker GameManager + house prisc+op architecture.
#
# Each op (world_manager_init, world_manager_tick) handles its own
# world_root derivation; ops are invoked via absolute paths from
# the world_manager directory in xyzfs.

# Initial setup: derive world_root and call init
exec /home/no/Desktop/github/work/NNEST-12.00/x0.parent-level-dev-env-04.04/yz.muchiverse/44.xyz.01.00/\&.hq-apps/world-manager/ops/world_manager_init
hit_frame

loop:
  exec /home/no/Desktop/github/work/NNEST-12.00/x0.parent-level-dev-env-04.04/yz.muchiverse/44.xyz.01.00/\&.hq-apps/world-manager/ops/world_manager_tick
  sleep 16
  j loop
