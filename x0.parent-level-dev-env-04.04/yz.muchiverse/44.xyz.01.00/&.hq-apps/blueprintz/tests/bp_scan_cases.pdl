SECTION | KEY | VALUE
------------------------------
# bp_scan_cases.pdl - proofs for bp_scan (the blueprintz page view data + problem flags, BOOK BLUEPRINTZ-DESIGN.md 12.9). Run with auto's case_run and env  S=<bp_scan.+x>  F=<scratch fixture house>  TM=<recompiled m8 template entity dir>  HOUSE_REAL=<the real house, read only: only the registry and one binary are copied>  BLUEPRINTZ_STATE_DIR=$F/st.  Every known-bad fixture must raise exactly its own flag; the good one must raise none.
# CASE | name | expected exit code | must contain ONE substring (- none) | must NOT contain ONE substring (- none) | command (sh -c). Fields cannot contain a pipe character.
CASE | s0 build the fixture house | 0 | fixtures built: 10 | - | rm -rf "$F"; mkdir -p "$F/xyzfs" "$F/#.ref/menu" "$F/&.widgits/events-hq/ops/+x" "$F/ev" "$F/st"; cp "$HOUSE_REAL/#.ref/menu/event_commands.registry.pdl" "$F/#.ref/menu/"; cp "$HOUSE_REAL/&.widgits/events-hq/ops/+x/mr_change_gold.+x" "$F/&.widgits/events-hq/ops/+x/"; cp -r "$TM" "$F/ev/good"; pg() { d="$F/ev/$1/event_pkg/pages/page_1"; mkdir -p "$d"; printf 'SECTION | KEY | VALUE\n---\nCOND | trigger | on-click\n' > "$d/condition.pdl"; }; wr() { printf '#!/bin/sh\ncd "$(dirname "$0")/../../.." || exit 1\nD="$PWD"\nwhile [ "$D" != "/" ] && [ ! -d "$D/xyzfs" ]; do D="$(dirname "$D")"; done\nexec "$D/%s" "$PWD" 10\n' "$2" > "$F/ev/$1/event_pkg/pages/page_1/cmd_1.sh"; }; ir() { printf 'SECTION | KEY | VALUE\n---\nMETA | piece_id | %s\n' "$1" > "$F/ev/$1/event_pkg/pages/page_1/event.ir.pdl"; }; pal() { printf 'exec cmd_1.sh\nhalt\n' > "$F/ev/$1/event_pkg/pages/page_1/event.pal"; }; GOOD='&.widgits/events-hq/ops/+x/mr_change_gold.+x'; pg dup; ir dup; printf 'NODE | id=1 type=change_gold | amount=1\nNODE | id=1 type=change_gold | amount=2\n' >> "$F/ev/dup/event_pkg/pages/page_1/event.ir.pdl"; pal dup; wr dup "$GOOD"; pg unk; ir unk; printf 'NODE | id=1 type=frobnicate | x=1\n' >> "$F/ev/unk/event_pkg/pages/page_1/event.ir.pdl"; pal unk; wr unk "$GOOD"; pg empty; ir empty; printf 'NODE | id=1 type=change_gold | \n' >> "$F/ev/empty/event_pkg/pages/page_1/event.ir.pdl"; pal empty; wr empty "$GOOD"; pg nocond; ir nocond; printf 'NODE | id=1 type=change_gold | amount=1\n' >> "$F/ev/nocond/event_pkg/pages/page_1/event.ir.pdl"; pal nocond; wr nocond "$GOOD"; rm "$F/ev/nocond/event_pkg/pages/page_1/condition.pdl"; pg nopal; ir nopal; printf 'NODE | id=1 type=change_gold | amount=1\n' >> "$F/ev/nopal/event_pkg/pages/page_1/event.ir.pdl"; pg misscmd; ir misscmd; printf 'NODE | id=1 type=change_gold | amount=1\n' >> "$F/ev/misscmd/event_pkg/pages/page_1/event.ir.pdl"; printf 'exec cmd_9.sh\nhalt\n' > "$F/ev/misscmd/event_pkg/pages/page_1/event.pal"; pg dead; ir dead; printf 'NODE | id=1 type=change_gold | amount=1\n' >> "$F/ev/dead/event_pkg/pages/page_1/event.ir.pdl"; pal dead; wr dead '&.widgits/events-hq/ops/+x/does_not_exist.+x'; pg abs; ir abs; printf 'NODE | id=1 type=change_gold | amount=1\n' >> "$F/ev/abs/event_pkg/pages/page_1/event.ir.pdl"; printf 'ecall "/home/elsewhere/old-checkout/state.txt" "k"\nexec cmd_1.sh\nhalt\n' > "$F/ev/abs/event_pkg/pages/page_1/event.pal"; wr abs "$GOOD"; pg over; ir over; i=1; while [ $i -le 130 ]; do printf 'NODE | id=%s type=comment | text=c\n' $i >> "$F/ev/over/event_pkg/pages/page_1/event.ir.pdl"; i=$((i+1)); done; printf 'halt\n' > "$F/ev/over/event_pkg/pages/page_1/event.pal"; echo fixtures built: $(ls "$F/ev" | wc -l)
CASE | f0 the good event raises no flags | 0 | 0 flags | FLAG | "$S" "$F" --dir "$F/ev/good"
CASE | f1 duplicate id | 1 | dup-id | - | "$S" "$F" --dir "$F/ev/dup"
CASE | f2 unknown command type | 1 | unknown-type | - | "$S" "$F" --dir "$F/ev/unk"
CASE | f3 empty params | 1 | empty-params | - | "$S" "$F" --dir "$F/ev/empty"
CASE | f4 page without condition cannot run | 1 | no-condition | - | "$S" "$F" --dir "$F/ev/nocond"
CASE | f5 IR without a compiled pal | 1 | no-pal | - | "$S" "$F" --dir "$F/ev/nopal"
CASE | f6 pal calls a wrapper that is missing | 1 | missing-cmd | - | "$S" "$F" --dir "$F/ev/misscmd"
CASE | f7 wrapper calls a program that does not exist | 1 | dead-target | - | "$S" "$F" --dir "$F/ev/dead"
CASE | f8 absolute path outside the house | 1 | abs-path | - | "$S" "$F" --dir "$F/ev/abs"
CASE | f9 more than 128 rows | 1 | over-128 | - | "$S" "$F" --dir "$F/ev/over"
CASE | f10 a bad event does not make the good one look bad | 1 | good | - | "$S" "$F" --dir "$F/ev/good" --dir "$F/ev/dup"
CASE | f11 sources file lists many events at once | 1 | SUMMARY | - | printf 'EVENT | good | ev/good\nEVENT | dup | ev/dup\nEVENT | unk | ev/unk\n' > "$F/src.pdl"; "$S" "$F" --sources "$F/src.pdl"
CASE | f12 sources file: total flag count is exactly 2 for dup+unk+good | 1 | flags=2 | flags=3 | "$S" "$F" --sources "$F/src.pdl"
# ---- state column (from the debugger's append-only files) ---------------------------------
CASE | t0 default state is waiting | 0 | waiting | running | "$S" "$F" --dir "$F/ev/good"
CASE | t1 START without END is running | 0 | running | waiting | mkdir -p "$F/st"; printf 'START | 1 | good | on-click | x\n' > "$F/st/trace.txt"; "$S" "$F" --dir "$F/ev/good"
CASE | t2 START then END is ran | 0 | ran | running | printf 'END | 2 | good | on-click | rc=0\n' >> "$F/st/trace.txt"; "$S" "$F" --dir "$F/ev/good"
CASE | t3 a queued trigger is queued | 0 | queued | ran | printf 'QUEUED | 3 | %s | on-click\n' "$F/ev/good" > "$F/st/queue.txt"; "$S" "$F" --dir "$F/ev/good"
CASE | t4 released (cursor past it) is no longer queued | 0 | ran | queued | printf '1\n' > "$F/st/queue.cursor"; "$S" "$F" --dir "$F/ev/good"
# ---- read-only ------------------------------------------------------------------------------
CASE | r0 scanning writes nothing (checksums of every fixture file unchanged) | 0 | same | changed | a=$(find "$F" -type f | sort | xargs sha256sum | sha256sum); "$S" "$F" --dir "$F/ev/good" --dir "$F/ev/dup" --dir "$F/ev/over" >/dev/null; b=$(find "$F" -type f | sort | xargs sha256sum | sha256sum); [ "$a" = "$b" ] && echo same || echo changed
CASE | r1 usage error exits 2 | 2 | usage | - | "$S" "$F"
