<!-- blueprintz.xhtpm - STATIC TEMPLATE. The page view and debugger (design: BOOK 08-roadmap/design-docs/BLUEPRINTZ-DESIGN.md sections 12.3-12.15, editing 12.22).
     The module tag forks blueprintz_manager.+x, which writes state/ui.txt. Left: every event of the page with its trigger and state (waiting / queued / running / ran);
     a "!! flags" mark means the problem scan found something. Right: debugger buttons (Play, Pause, Step event, Step command, Fire ...), the problems for the selected
     event, and the last trace rows. Page = state/bp_sources.pdl (EVENT | name | pkg_dir). Target house = state/target.pdl (test runs point it at a scratch house). -->
<window label="BLUEPRINTZ" class="database-window" vars="state/ui.txt">
  <module src="&.hq-apps/blueprintz/+x/blueprintz_manager.+x" id="_"/>
  <page name="main">
    <sidebar>
      <text label="Events on this page (click to select)" class="quiet"/>
      <scrolllist class="from-top">
        <repeat count="${e_count}" bind="e">
          <item id="ev${e.#}" class="${e.class}" label="${e.label}" action="${e.action}"/>
        </repeat>
      </scrolllist>
    </sidebar>
    <panel id="bp_p" class="bp-panel">
      <text label="${status_line}" class="bp-title"/>
      <row class="toolbar">
        <item id="play" label="Play" action="${play_action}"/>
        <item id="stopplay" label="Stop" action="${stopplay_action}"/>
        <item id="pause" label="Pause" action="${pause_action}"/>
      </row>
      <row class="toolbar">
        <item id="resume" label="Resume" action="${resume_action}"/>
        <item id="fire" label="Fire" action="${fire_action}"/>
        <item id="stepev" label="Step ev" action="${stepev_action}"/>
      </row>
      <row class="toolbar">
        <item id="stepcmd" label="Step cmd" action="${stepcmd_action}"/>
        <item id="runend" label="Run end" action="${runend_action}"/>
        <item id="abort" label="Abort" action="${abort_action}"/>
      </row>
      <row class="toolbar">
        <item id="detach" label="Detach" action="${detach_action}"/>
        <item id="refresh" label="Refresh" action="${refresh_action}"/>
      </row>
      <row class="toolbar">
        <item id="loadgdh" label="Load game-dev-hq verbs" action="${load_gdh_action}"/>
      </row>
      <row class="toolbar">
        <item id="loadrpg" label="Load rpg-pvp-hq verbs" action="${load_rpg_action}"/>
      </row>
      <row class="toolbar">
        <item id="loadce" label="Load common events" action="${loadce_action}"/>
      </row>
      <row class="toolbar">
        <item id="bookc" label="Compile book" action="${book_action}"/>
      </row>
      <scrolllist class="from-top">
        <repeat count="${e_count}" bind="e">
          <item id="ev${e.#}" class="${e.class}" label="${e.label}" action="${e.action}"/>
        </repeat>
      </scrolllist>
    </sidebar>
    <panel id="bp_p" class="bp-panel">
      <text label="${status_line}" class="bp-title"/>
      <row class="toolbar">
        <item id="play" label="Play" action="${play_action}"/>
        <item id="stopplay" label="Stop" action="${stopplay_action}"/>
        <item id="pause" label="Pause" action="${pause_action}"/>
        <item id="resume" label="Resume" action="${resume_action}"/>
        <item id="fire" label="Fire" action="${fire_action}"/>
      </row>
      <row class="toolbar">
        <item id="stepev" label="Step ev" action="${stepev_action}"/>
        <item id="stepcmd" label="Step cmd" action="${stepcmd_action}"/>
        <item id="runend" label="Run end" action="${runend_action}"/>
        <item id="abort" label="Abort" action="${abort_action}"/>
        <item id="detach" label="Detach" action="${detach_action}"/>
        <item id="refresh" label="Refresh" action="${refresh_action}"/>
      </row>
      <row class="toolbar">
        <item id="loadgdh" label="Load game-dev-hq verbs" action="${load_gdh_action}"/>
        <item id="loadrpg" label="Load rpg-pvp-hq verbs" action="${load_rpg_action}"/>
        <item id="loadce" label="Load common events" action="${loadce_action}"/>
        <item id="bookc" label="Compile book" action="${book_action}"/>
      </row>
      <scrolllist class="from-top">
        <text label="${sel_line}" class="quiet"/>
        <text label="Pages of the selected event (click one to edit it)" class="bp-head"/>
        <repeat count="${pg_count}" bind="pg">
          <item id="pg${pg.#}" class="${pg.class}" label="${pg.label}" action="${pg.action}"/>
        </repeat>
        <item id="pgnew" class="data-item" label="+ New page (trigger on-click)" action="${pgnew_action}"/>
        <cli_io id="trigline" target_id="trigline" rows="1" class="bp-edit top" label="set trigger of this page ..." action="${trig_action}"/>
        <cli_io id="swline" target_id="swline" rows="1" class="bp-edit top" label="set switch of this page (blank = none) ..." action="${sw_action}"/>
        <cli_io id="pdelline" target_id="pdelline" rows="1" class="bp-edit top" label="delete this page: type its name (no undo) ..." action="${pdel_action}"/>
        <text label="${page_line}" class="quiet"/>
        <text label="Commands of the selected page (click one to select)" class="bp-head"/>
        <repeat count="${n_count}" bind="n">
          <item id="nd${n.#}" class="${n.class}" label="${n.label}" action="${n.action}"/>
        </repeat>
        <text label="${n_none}" class="quiet"/>
        <text label="${n_hint}" class="quiet"/>
        <cli_io id="editline" target_id="editline" rows="1" class="bp-edit top" label="edit selected ..." action="${edit_action}"/>
        <cli_io id="addline" target_id="addline" rows="1" class="bp-edit top" label="add command ..." action="${add_action}"/>
        <row class="toolbar">
          <item id="cdel" label="Delete cmd" action="${cdel_action}"/>
          <item id="undo" label="Undo" action="${undo_action}"/>
          <text label="${undo_line}" class="quiet"/>
        </row>
        <text label="Calls between the loaded events (who calls whom)" class="bp-head"/>
        <repeat count="${x_count}" bind="x">
          <text id="xr${x.#}" class="quiet" label="${x.label}"/>
        </repeat>
        <text label="${x_none}" class="quiet"/>
        <text label="Problems for the selected event" class="bp-head"/>
        <repeat count="${f_count}" bind="f">
          <text id="fl${f.#}" class="bp-flag" label="${f.label}"/>
        </repeat>
        <text label="${f_none}" class="quiet"/>
        <text label="Last debugger rows (trace)" class="bp-head"/>
        <repeat count="${t_count}" bind="t">
          <text id="tr${t.#}" class="quiet" label="${t.label}"/>
        </repeat>
        <text label="${target_line}" class="quiet"/>
      </scrolllist>
    </panel>
    <footer id="statusbar" class="pchq-footer">
      <text label="${msg}" class="quiet"/>
    </footer>
  </page>
</window>
