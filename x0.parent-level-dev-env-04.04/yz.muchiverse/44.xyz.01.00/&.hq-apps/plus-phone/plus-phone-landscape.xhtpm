<!-- plus-phone-landscape.xhtpm - the plus phone window (first slice 2026-11-15; design: BOOK 16.game/PLUS-PHONE-DESIGN-2026-11-15.md).
     Built on the house's SWATCH-GRID path, the same shape as the palette picker (&.widgits/palettes/palettes-rmmv.xhtpm): class="palettes-pal database-window", no sidebar and no side panel (owner 2026-11-15),
     every app is a SQUARE <item class="swatch"> tile. The window title and the _ ! X buttons are the house chrome (not redrawn); the one extra chrome button is @ (flip portrait <-> landscape),
     declared in the template like the picker's close button. Static: every value is a ${var} from <instance>/.hq_manager/ui.txt written by ops/phone_projector.c (renderer instance-dir hook, ${ARG3}).
     Every button runs ONE verb of ops/phone_op.c. The two layout files differ only in the window size (css); @ relaunches the window with the other one. -->
<window label="${phone_title}" class="palettes-pal phone-landscape managed">
  <module id="projector" src="&.hq-apps/plus-phone/ops/+x/phone_projector.+x"/>
  <page name="main">
    <tabbar id="toolbar" class="tab-bar">
      <tab id="tb-hq" class="tab" label="HQ v" onclick="ACTIVATE" target_id="tb-hq"/>
      <tab id="tb-book" class="tab" label="${book_label} : ${page_label} v" onclick="ACTIVATE" target_id="tb-book"/>
    </tabbar>
    <item id="hq-restart" class="dd-row dropdown-child" target_id="tb-hq" label="restart phone" action="'${PKG}/ops/+x/phone_op.+x' relaunch '${ARG3}'"/>
    <item id="hq-quit" class="dd-row dropdown-child" target_id="tb-hq" label="quit phone" action="'${PKG}/ops/+x/phone_op.+x' quit '${ARG3}'"/>
    <item id="hq-rot" class="dd-row dropdown-child" target_id="tb-hq" label="rotate" action="'${PKG}/ops/+x/phone_op.+x' flip '${ARG3}'"/>
    <item id="hq-cancel" class="dd-row dropdown-child quiet" target_id="tb-hq" label="- cancel -" action="void"/>
    <repeat count="${n_pages}" bind="pg">
      <item id="pg${pg.#}" class="dd-row dropdown-child" target_id="tb-book" label="${pg.label}" action="${pg.act}"/>
    </repeat>
    <item id="pg-cancel" class="dd-row dropdown-child quiet" target_id="tb-book" label="- cancel -" action="void"/>
    <item id="close" class="chrome-btn" label="x" onclick="CLOSE"/>
    <item id="flip" class="chrome-btn" label="@" action="'${PKG}/ops/+x/phone_op.+x' 'flip' '${ARG3}'"/>
    <item id="back" class="chrome-btn" label="<" show="${app_open}" action="'${PKG}/ops/+x/phone_op.+x' 'home' '${ARG3}'"/>
    <repeat count="${n_apps}" bind="app">
      <item id="app${app.#}" class="swatch" show="${app.show}" sprite="${app.icon}" label="${app.label}" action="'${PKG}/ops/+x/phone_op.+x' 'open' '${ARG3}' '${app.id}'"/>
    </repeat>
    <repeat count="${n_ents}" bind="ent">
      <item id="ent${ent.#}" class="swatch" show="${tiles_show}" sprite="${ent.icon}" label="${ent.label}" action="'${PKG}/ops/+x/phone_op.+x' 'entity' '${ARG3}' '${ent.id}'"/>
    </repeat>
    <text label="no apps installed" class="quiet" show="${no_apps}"/>
    <text label="${last_result}" class="quiet" show="${show_last}"/>
    ${PHONE_FOOTER}
  </page>
</window>
