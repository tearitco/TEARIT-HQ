<!-- menu.chtpm - real, generated entity context menu (meta_to_menu_chtpm.py, 2026-08-28 permanent converter). Converted 1:1 from _.monads/_.book-stack/entities/book-stack/meta.pdl's own real METHOD rows - same real mechanical rule proven on ava/asa/book-stack's own hand conversions. Regenerate by deleting this file and re-running the converter; a real hand-edit here will be lost on the next regenerate, same tradeoff every generated file in this house already has. -->
<window class="entity-menu">
  <page name="main">
    <item label="Rand" action="sh -c 'export PACKAGE_DIR=&quot;$0&quot;; H=&quot;$1&quot;; D=&quot;$HOME/Desktop/p&quot;; mkdir -p &quot;$D&quot;; W0=$(xwininfo -root -children | grep -o &quot;0x[0-9a-f]*&quot; | sort -u); bash &quot;$H/_.monads/_.book-stack/pieces/reader/event_pkg/pages/page_1/branches/bible_text/run.sh&quot;; sleep 1; N=&quot;&quot;; for w in $(xwininfo -root -children | grep -o &quot;0x[0-9a-f]*&quot; | sort -u); do echo &quot;$W0&quot; | grep -qx &quot;$w&quot; || N=&quot;$w&quot;; done; [ -n &quot;$N&quot; ] &amp;&amp; &quot;$H/&amp;.widgits/_shared-lib/ops/+x/dump_frame_png_op.+x&quot; &quot;$N&quot; &quot;$D/rand_$(date +%Y%m%d_%H%M%S).png&quot;'"/>
    <item label="Read" action="sh -c 'H=&quot;$1&quot; &amp;&amp; export PACKAGE_DIR=&quot;$0&quot; &amp;&amp; export KHTPM_WIN_X=&quot;${WIN_X}&quot; KHTPM_WIN_Y=&quot;${WIN_Y}&quot; &amp;&amp; exec &quot;$(find &quot;$H&quot; -maxdepth 1 -name &quot;101.mutaclsym🧟‍♂️️*&quot; -type d 2>/dev/null|head -1)/system/prisc+x&quot; &quot;$H/_.monads/_.book-stack/pieces/reader/event_pkg/pages/page_1/event.pal&quot;'"/>
    <item label="Dir" action="xdg-open"/>
    <item label="Inventory" action="sh -c 'H=&quot;$1&quot;; I=&quot;$H/&amp;.widgits/file-explorer/instances/inv-$(basename &quot;$(dirname &quot;$0&quot;)&quot;)-$(basename &quot;$0&quot;)&quot;; mkdir -p &quot;$0/inventory&quot; &quot;$I&quot;; printf &quot;mode=LOAD\nstart_dir=%s/inventory\n&quot; &quot;$0&quot; > &quot;$I/fe_request.txt&quot;; exec sh &quot;$H/&amp;.widgits/file-explorer/button.sh&quot; run-instance &quot;$I&quot;'"/>
    <item label="Close" action="CLOSE"/>
    <item label="Cancel" action="void"/>
    <cli_io id="cmd" target_id="cmd" label="Cli-io: " action="${HOUSE}/&amp;.widgits/entity-cli/ops/entity_cli_commit.sh"/>
  </page>
</window>
