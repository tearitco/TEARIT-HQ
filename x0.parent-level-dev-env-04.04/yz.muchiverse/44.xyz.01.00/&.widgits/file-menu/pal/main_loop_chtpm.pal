# file-menu main_loop_chtpm.pal - persistent screen-dispatch loop
# Pre-sync menu_input before first compose to initialize state
li x1, 0

li x9, 0
fm_menu_input x9
fm_compose_frame
hit_frame
read_pos x7, "pieces/display/fm_screen_changed.txt"

loop:
li x9, 0
fm_menu_input x9
read_history pieces/apps/player_app/interact_relay.txt x2, x1
beq x2, x0, no_key
fm_menu_input x2
j render_always

no_key:
read_pos x8, "pieces/display/fm_screen_changed.txt"
beq x7, x8, no_render
addi x7, x8, 0

render_always:
fm_compose_frame
hit_frame
sleep 16667
j loop

no_render:
sleep 16667
j loop
