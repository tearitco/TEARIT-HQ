# camera_presets.pdl - absolute camera presets for board_ctl camera <app> <name> (the engine's camera keys are relative and 'f' is not a reset; the state is plain kv in <session>/pieces/system/bv_state.txt)
# CAM | name | camera_mode | cam_yaw | cam_pitch | cam_pan_x | cam_pan_y | cam_pan_z | cam_z_level | current_z
# first value seen right after a launch of rpg-space (3D free-roam, looking north from the south): mode 3, yaw 180, pitch -49, pan 16,8,36, level 0, xelector level 25 gave the good bridge and space pictures of 2026-10-24
CAM | iso-south | 3 | 180 | -49 | 16 | 8 | 36 | 0 | 25
CAM | topdown   | 3 | 180 | -89 | 16 | 8 | 36 | 0 | 25
CAM | iso-low    | 3 | 180 | -30 | 16 | 8 | 36 | 0 | 25
CAM | ship-high | 3 | 180 | -49 | 16 | 8 | 46 | 0 | 25
CAM | ship-view | 3 | 180 | -40 | 16 | 8 | 52 | 0 | 25
CAM | under | 3 | 180 | 25 | 16 | 4 | 52 | 0 | 25
CAM | lowside | 3 | 180 | -12 | 16 | 4 | 56 | 0 | 25
CAM | far | 3 | 180 | -50 | 16 | 8 | 80 | 0 | 25
CAM | far-top | 3 | 180 | -88 | 16 | 20 | 40 | 0 | 25
CAM | region-iso | 3 | 180 | -45 | 8 | 4 | 20 | 0 | 25
