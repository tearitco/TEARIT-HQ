# main_module.pal - board-viewer's dedicated module.
#
# TPMOS DIAMOND loop (pchq-vs-tpmos.md APPENDIX A, plan P-5), ported
# from 101.mutaclsym...19.00/pal/game_module.pal. The old pre-diamond
# loop (one key per iteration, bv_menu_input + bv_render_3d + bv_compose
# _frame + hit_frame every 30ms) is pal/main_module_legacy.pal, kept for
# rollback.
#
# ops/+x/bv_dispatch.+x does the whole tick: drain EVERY pending key
# from interact_relay.txt, run bv_menu_input per key, then bv_render_3d
# + bv_compose_frame + frame_changed marker ONCE - and nothing at all on
# an idle tick.
#
# FOOTPRINT (owner 2026-10-25: "keep our own footprint managed"): an idle tick used to exec bv_dispatch ~25 times a second
# just to find out nothing happened. The checks below are the pal VM's own (read_pos = a file size, no process): the
# dispatch is exec'd only when the key relay holds something, the host's screen marker moved, or a Move / range is on show
# (bv_dispatch publishes that as the size of pieces/display/.bv_fast_tick). Otherwise it still runs on every 8th idle tick
# (~130 ms) so the minimize flag and the other slow triggers are served.
li x1, 0

# one unconditional render at boot so view.txt / the 3D overlay exist
# before the first key
bv_render_3d
bv_compose_frame
hit_frame

li x6, 0
li x7, 8
read_pos x3, "pieces/display/bv_screen_changed.txt"

# LOOP EXIT (owner 2026-10-26: "have loops exit as well"): every 480 passes (~8 s, 0.12 spawns/s) run loop_guard. It ends this loop (SIGTERM to the VM)
# when the engine daemon's pid file is missing or dead for 120 s + a 3 s re-check, and appends a byte to <instance>/pieces/system/stack_stop.txt so the
# piececraft loop of the same stack ends too. No arguments: this session's prisc VM delivers none to exec (prisc_exec_args.pal fails on it).
li x10, 0
li x11, 480

loop:
addi x10, x10, 1
bne x10, x11, noguard
li x10, 0
exec ./ops/+x/loop_guard.+x
noguard:
read_pos x4, "pieces/apps/player_app/interact_relay.txt"
bne x4, x0, run
read_pos x5, "pieces/display/bv_screen_changed.txt"
bne x5, x3, run
read_pos x2, "pieces/display/.bv_fast_tick"
bne x2, x0, run
addi x6, x6, 1
beq x6, x7, run
sleep 16667
j loop

run:
read_pos x3, "pieces/display/bv_screen_changed.txt"
li x6, 0
exec ./ops/+x/bv_dispatch.+x
sleep 16667
j loop
