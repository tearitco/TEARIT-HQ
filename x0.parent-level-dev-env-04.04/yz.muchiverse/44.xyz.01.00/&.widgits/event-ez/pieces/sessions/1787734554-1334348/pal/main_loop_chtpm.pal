# event-ez main_loop_chtpm.pal
# House std: compose -> interact_relay -> menu_input -> recompose.
# Uses the SAME proven pattern as event-editor's own real fix
# (2026-08-04, "Enter bug"): check interact_relay.txt FIRST,
# unconditionally, every loop iteration - NOT gated behind a screen-
# changed comparison, which can permanently starve the relay check once
# ping()/bump() keep the marker moving every render.
li x1, 0

ez_compose_frame
hit_frame
read_pos x7, "pieces/display/ez_screen_changed.txt"

loop:
li x9, 0
ez_menu_input x9
read_history pieces/apps/player_app/interact_relay.txt x2, x1
beq x2, x0, no_key
ez_menu_input x2
j render_always

no_key:
read_pos x8, "pieces/display/ez_screen_changed.txt"
beq x7, x8, no_render
addi x7, x8, 0

render_always:
ez_compose_frame
hit_frame
# 33333 us ≈ 30fps hard ceiling (was 30000 ≈ 33fps)
sleep 33333
j loop

no_render:
# Idle poll: same 30fps ceiling; no compose/hit when screen unchanged
sleep 33333
j loop
