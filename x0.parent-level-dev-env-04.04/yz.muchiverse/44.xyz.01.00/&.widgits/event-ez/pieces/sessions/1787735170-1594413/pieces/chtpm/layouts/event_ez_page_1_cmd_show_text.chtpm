<panel time_reactive="true">
    <module>system/prisc+x pal/main_loop_chtpm.pal</module>
    <interact src="pieces/apps/player_app/interact_relay.txt" />
    <text label="+==========================================+" /><br/>
    <text label="| Show Text (page 1)                      |" /><br/>
    <text label="+==========================================+" /><br/>
    <text label="Show a message box to the player when" /><br/>
    <text label="this event page runs." /><br/>
    <text label="HOW TO: Enter on field, type message," /><br/>
    <text label="Esc when done, then OK to save." /><br/>
    <cli_io id="ez_st_text" label="Message text" target_id="ez_st_text" /><br/>
    <cli_io id="ez_st_speaker" label="Speaker name (optional)" target_id="ez_st_speaker" /><br/>
    <button label="OK — Save Command" onClick="KEY:8" /><br/>
    <button label="< Back" href="pieces/chtpm/layouts/event_ez_page_1.chtpm" /><br/>
    <text label="${last_message}" /><br/>
</panel>
