<!-- palettes-rmmv.chtpm — real TPMOS-compliant category window
     (2026-08-27, TILE-SYSTEM-DESIGN.md sec.4b), same real shape as
     palettes-emojis.chtpm/palettes-elements.chtpm - static, checked
     in, never regenerated by palettes_menu.sh. Real tile ROWS are
     injected at runtime by khtpm_core_render.c's own
     dbhq_inject_palette_tiles() (fully generic, no rmmv-specific code),
     reading palettes_manager.c's own published palettes-rmmv_state.txt.
     This file previously existed but was empty - filled in now as part
     of actually making the category open a real window instead of
     failing to load. -->
<window class="database-window palettes" label="palettes: RPG Maker Tiles">
  <module src="*.monads/*.livedesk-taskbar/ops/+x/palettes_manager.+x" args="rmmv" />
  <panel class="settings-block">
    <title class="block-title" label="palettes: RPG Maker Tiles"/>
    <text class="pal-hint" label="Click a tile to place it on the desk."/>
  </panel>
</window>
