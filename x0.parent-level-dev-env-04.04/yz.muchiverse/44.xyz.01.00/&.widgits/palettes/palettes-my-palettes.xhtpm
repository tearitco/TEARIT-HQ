<!-- palettes-my-palettes.xhtpm — personal imports only (MVP). -->
<window label="palettes: My Palettes" class="palettes-pal database-window" vars="state/palettes-my-palettes_ui.txt">
  <module src="*.monads/*.livedesk-taskbar/ops/+x/palettes_manager.+x" args="my-palettes"/>
  <module src="&.widgits/palettes/ops/+x/palettes_projector.+x" id="my-palettes"/>
  <page name="main">
    <item id="close" class="chrome-btn" label="x" onclick="CLOSE"/>
    <item id="imp" class="pal-dir" label="Import…"
          action="'${HOUSE}/&.widgits/palettes/palettes_menu.sh' 'mypal-file' '${PKG}'"/>
    <repeat count="${n_dirs}" bind="d">
      <item id="mydir-${d.#}" class="pal-dir ${d.active}" label="${d.label}"
            action="'${HOUSE}/&.widgits/palettes/palettes_menu.sh' 'set-mypal-dir' '${PKG}' '${d.key}'"/>
    </repeat>
    <repeat count="${n_tilesets}" bind="s">
      <item id="myset-${s.#}" class="pal-tileset ${s.active}" label="${s.label}"
            action="'${HOUSE}/&.widgits/palettes/palettes_menu.sh' 'set-mypal-mod' '${PKG}' '${s.key}'"/>
    </repeat>
    <repeat count="${n_tiles}" bind="t">
      <item id="pt${t.#}" class="swatch" sprite="${t.sprite}" label="${t.glyph}"
            action="'${HOUSE}/&.widgits/palettes/palettes_menu.sh' 'arm-pc' '${t.sprite}' '${t.glyph}'"/>
    </repeat>
    <text label="No imports yet — Import opens File Explorer; pick a PNG/BMP then wait a tick." class="quiet" show="${empty}"/>
  </page>
</window>
