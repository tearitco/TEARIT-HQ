<!-- palettes-elements.xhtpm - the "Chemicals+Compounds" palette, now a
     PERIODIC-TABLE element picker (drag/click a tile -> stamp that
     element onto the desktop). Rendered by the shared khtpm_core_render.+x.

     class="palettes-pal database-window" -> generic <item class="swatch">
     grid layout (keyed on the class, not a g_is_* flag). The grid
     auto-fits its column count to the window width, so a wide window
     gives ~18 columns = periodic-table width.

     <module>: ops/+x/elements_palette_manager.+x - publishes
     state/palettes-elements_ui.txt: n_tiles + per-tile sym / z / name /
     color (Drude-model, chem-viz.txt sec.3). Static.

     Chrome: the <item class="chrome-btn" onclick="CLOSE"> below is laid
     into the top strip by the swatch-grid layout (same as
     palettes-rmmv.xhtpm) - the old template had none, hence "no chrome
     to exit". -->
<window label="palettes: Elements (periodic table)" class="palettes-pal database-window" vars="state/palettes-elements_ui.txt">
  <module src="&.widgits/palettes/ops/+x/elements_palette_manager.+x" id="elements"/>
  <page name="main">
    <item id="close" class="chrome-btn" label="x" onclick="CLOSE"/>
    <repeat count="${n_tiles}" bind="t">
      <item id="pt${t.#}" class="swatch" bg="${t.color}" label="${t.sym}"
            action="'${HOUSE}/&.widgits/palettes/palettes_menu.sh' 'place' '${t.sym}'"/>
    </repeat>
    <text label="Loading the periodic table..." class="quiet" show="${empty}"/>
  </page>
</window>
