<!-- palettes-doom.xhtpm — Doom (Doom). Same chooser families as
     palettes-rmmv: pal-dir = pngs_* sheet, pal-tileset = category folder. -->
<window label="palettes: Doom" class="palettes-pal database-window" vars="state/palettes-doom_ui.txt">
  <module src="_.monads/_.livedesk-taskbar/ops/+x/palettes_manager.+x" args="doom"/>
  <module src="&.widgits/palettes/ops/+x/palettes_projector.+x" id="doom"/>
  <page name="main">
    <item id="close" class="chrome-btn" label="x" onclick="CLOSE"/>
    <repeat count="${n_dirs}" bind="d">
      <item id="doomdir-${d.#}" class="pal-dir ${d.active}" label="${d.label}"
            action="'${HOUSE}/&.widgits/palettes/palettes_menu.sh' 'set-doom-dir' '${PKG}' '${d.key}'"/>
    </repeat>
    <repeat count="${n_tilesets}" bind="s">
      <item id="doommod-${s.#}" class="pal-tileset ${s.active}" label="${s.label}"
            action="'${HOUSE}/&.widgits/palettes/palettes_menu.sh' 'set-doom-mod' '${PKG}' '${s.key}'"/>
    </repeat>
    <repeat count="${n_tiles}" bind="t">
      <item id="pt${t.#}" class="swatch" sprite="${t.sprite}" label="${t.glyph}"
            action="'${HOUSE}/&.widgits/palettes/palettes_menu.sh' 'arm-doom' '${t.sprite}' '${t.glyph}'"/>
    </repeat>
    <text label="No Doom cells. freedoom1.wad was not sliced." class="quiet" show="${empty}"/>
    <text label="Grid truncated — pick a smaller category tab." class="quiet" show="${truncated}"/>
  </page>
</window>
