<!-- palettes-piececraft.xhtpm — Piececraft Blocks (Mineclonia).
     Same chooser families as palettes-rmmv: pal-dir = pack, pal-tileset = mod,
     swatch grid = 16px textures cropped to sprite.csv. -->
<window label="palettes: Piececraft Blocks" class="palettes-pal database-window" vars="state/palettes-piececraft_ui.txt">
  <module src="*.monads/*.livedesk-taskbar/ops/+x/palettes_manager.+x" args="piececraft"/>
  <module src="&.widgits/palettes/ops/+x/palettes_projector.+x" id="piececraft"/>
  <page name="main">
    <item id="close" class="chrome-btn" label="x" onclick="CLOSE"/>
    <repeat count="${n_dirs}" bind="d">
      <item id="pcpack-${d.#}" class="pal-dir ${d.active}" label="${d.label}"
            action="'${HOUSE}/&.widgits/palettes/palettes_menu.sh' 'set-pc-dir' '${PKG}' '${d.key}'"/>
    </repeat>
    <repeat count="${n_tilesets}" bind="s">
      <item id="pcmod-${s.#}" class="pal-tileset ${s.active}" label="${s.label}"
            action="'${HOUSE}/&.widgits/palettes/palettes_menu.sh' 'set-pc-mod' '${PKG}' '${s.key}'"/>
    </repeat>
    <repeat count="${n_tiles}" bind="t">
      <item id="pt${t.#}" class="swatch" sprite="${t.sprite}" label="${t.glyph}"
            action="'${HOUSE}/&.widgits/palettes/palettes_menu.sh' 'arm-pc' '${t.sprite}' '${t.glyph}'"/>
    </repeat>
    <text label="No Mineclonia textures — check MINECLONIA-ASSET-SOURCE-LOCATION.pdl img_root." class="quiet" show="${empty}"/>
    <text label="Grid truncated — pick a smaller mod tab." class="quiet" show="${truncated}"/>
  </page>
</window>
