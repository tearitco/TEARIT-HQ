# play_rpg_space_planet_map.pal - asteroids and a second ship on the planet map (design 7i) as a playthrough: same five ops as play_game_dev_hq.pal, pointed at its phase table. Read results/play_rpg_space_planet_map.txt.verdict.txt
exec ./ops/+x/playthrough_op.+x compile play/phases/rpg_space_planet_map.phases.pdl cases
exec ./ops/+x/harness_case_op.+x cases/play_rpg_space_planet_map.pdl
exec ./ops/+x/harness_verdict_op.+x cases/play_rpg_space_planet_map.pdl
exec ./ops/+x/playthrough_op.+x ledger play/phases/rpg_space_planet_map.phases.pdl cases
exec ./ops/+x/harness_bank_op.+x cases/play_rpg_space_planet_map.pdl
halt
