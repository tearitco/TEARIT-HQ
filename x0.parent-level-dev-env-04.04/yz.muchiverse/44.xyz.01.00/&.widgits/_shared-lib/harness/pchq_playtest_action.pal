# pchq_playtest_action.pal - pal harness: runs the case file, then writes the verdict. prisc's `exec` ignores exit status and output, so the ops write PASS/FAIL rows
# into results/pchq_playtest_action.txt and the verdict into results/pchq_playtest_action.txt.verdict.txt (read that file). Run:  prisc+x pchq_playtest_action.pal   (from this folder)
exec ./ops/+x/harness_case_op.+x cases/pchq_playtest_action.pdl
exec ./ops/+x/harness_verdict_op.+x cases/pchq_playtest_action.pdl
halt
