# play_rpg_dust_life.pal - the life layer in rpg-dust as a playthrough: same five ops as play_game_dev_hq.pal, pointed at its phase table. Read results/play_rpg_dust_life.txt.verdict.txt
exec ./ops/+x/playthrough_op.+x compile play/phases/rpg_dust_life.phases.pdl cases
exec ./ops/+x/harness_case_op.+x cases/play_rpg_dust_life.pdl
exec ./ops/+x/harness_verdict_op.+x cases/play_rpg_dust_life.pdl
exec ./ops/+x/playthrough_op.+x ledger play/phases/rpg_dust_life.phases.pdl cases
exec ./ops/+x/harness_bank_op.+x cases/play_rpg_dust_life.pdl
halt
