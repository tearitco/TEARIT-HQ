# play_df_hq.pal - scripted playthrough of df-hq (phase table play/phases/df_hq.phases.pdl). Read results/play_df_hq.txt.verdict.txt and play/results/play_ledger.txt
exec ./ops/+x/playthrough_op.+x compile play/phases/df_hq.phases.pdl cases
exec ./ops/+x/harness_case_op.+x cases/play_df_hq.pdl
exec ./ops/+x/harness_verdict_op.+x cases/play_df_hq.pdl
exec ./ops/+x/playthrough_op.+x ledger play/phases/df_hq.phases.pdl cases
exec ./ops/+x/harness_bank_op.+x cases/play_df_hq.pdl
halt
