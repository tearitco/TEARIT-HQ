# {{name}}-drive.pdl - from ANY editor state to a STARTED {{Title}} game with YOU as seat p1, then one Roll. UNTESTED LIVE when generated: run it once with the real window, fix the labels, then delete this line.
# Run: RELAY_DRIVE_NO_ESC=1 relay_drive <editor window pid> run @.apps/{{name}}/tests/{{name}}-drive.pdl <x window id>
# STEP fields split on a bar, so an expectation holds no bar (the ledger rows are checked by the harness case, this script checks the screen and the feed).
STEP | in | off
STEP | ensure | pm-play | tb-player
STEP | tapid | pm-play
STEP | sleep | 3000
STEP | expect | @.apps/rpg-edit-hq/state/game_ui.txt | contains | players, then START | 15
STEP | see | label:START GAME
STEP | press | label:you play
STEP | expect | @.apps/rpg-edit-hq/state/game_ui.txt | contains | you play: p1 | 5
STEP | press | label:START GAME
STEP | expect | @.apps/rpg-edit-hq/state/game_ui.txt | contains | your turn | 20
STEP | see | label:Roll
STEP | press | label:Roll
STEP | expect | @.apps/rpg-edit-hq/state/games/{{name}}/game/ledger.txt | contains | EVENT | 10
