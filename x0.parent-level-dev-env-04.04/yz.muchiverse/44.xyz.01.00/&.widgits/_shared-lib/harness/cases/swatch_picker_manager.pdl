# swatch_picker_manager: LOCKED cases for the Custom-theme routing (owner 2026-10-28). The REAL manager runs in a scratch house and is driven through the action file the renderer writes.
# A PRISM_ token must reach prism_settings_op and must NOT move the swatch phase (before this fix atoi("PRISM_...") = 0 picked swatch 0); a non-digit PICK is ignored; a token with shell characters is never run.
RESULTS | ../results/swatch_picker_manager.txt
CASE | swatch_picker_manager
SCRATCH |
COPY | _.monads/_.livedesk-taskbar/ops/swatch_picker_manager.c | mgr.c
COPY | &.widgits/_shared-lib/ops/prism_settings_op.c | ps.c
COPY | &.widgits/_shared-lib/ops/prism_op.c | po.c
RUN | gcc | -std=gnu11 | -Wall | -Wextra | -O2 | -o | $T/mgr.+x | $T/mgr.c
EXPECT_EXIT | 0 | setup.manager-compiles
MKDIR | h/&.widgits/_shared-lib/ops/+x
MKDIR | h/&.widgits/taskbar-settings
MKDIR | h/#.desktop
RUN | gcc | -std=gnu11 | -Wall | -Wextra | -Werror | -O2 | -o | $T/h/&.widgits/_shared-lib/ops/+x/prism_settings_op.+x | $T/ps.c
EXPECT_EXIT | 0 | setup.settings-op-compiles
RUN | gcc | -std=gnu11 | -Wall | -Wextra | -Werror | -O2 | -o | $T/h/&.widgits/_shared-lib/ops/+x/prism_op.+x | $T/po.c | -lm
EXPECT_EXIT | 0 | setup.prism-op-compiles
WRITE | h/&.widgits/taskbar-settings/swatches.pdl | black\p#000000\nwhite\p#ffffff\ngreen\p#22c55e\n
WRITE | drive.sh | R=$1\nH=$R/h\n$R/mgr.+x $H &\nM=$!\nsleep 1\nprintf 'seq=1\nPICK:PRISM_SHAPE_NEXT\n' > $H/#.desktop/taskbar_settings_action.txt\nsleep 1\ncat $H/#.desktop/taskbar_settings_state.txt > $R/st1.txt\nprintf 'seq=2\nPICK:abc\n' > $H/#.desktop/taskbar_settings_action.txt\nsleep 1\ncat $H/#.desktop/taskbar_settings_state.txt > $R/st2.txt\nprintf "seq=3\nPICK:PRISM_X';>$R/pwned;a='\n" > $H/#.desktop/taskbar_settings_action.txt\nsleep 1\nls $R/pwned > $R/pw.txt 2>&1\nprintf 'seq=4\nPICK:1\n' > $H/#.desktop/taskbar_settings_action.txt\nsleep 1\ncat $H/#.desktop/taskbar_settings_state.txt > $R/st3.txt\nprintf 'seq=5\nPICK:PRISM_HUE_PLUS\n' > $H/#.desktop/taskbar_settings_action.txt\nsleep 1\ncat $H/#.desktop/livedesk_prism.pdl > $R/pz.txt\nkill $M\n
RUN | sh | $T/drive.sh | $T
EXPECT_EXIT | 0 | d0.driver-ran
EXPECT_HAS | st1.txt | phase=0 | m1.prism-token-does-not-move-the-phase
EXPECT_HAS | h/#.desktop/livedesk_prism.pdl | \p shape              \p 2 | m2.prism-token-reached-prism_settings_op
EXPECT_HAS | st2.txt | phase=0 | m3.non-digit-pick-is-ignored
EXPECT_HAS | pw.txt | No such file | m4.shell-characters-are-never-run
EXPECT_HAS | st3.txt | phase=1 | m5.digit-pick-still-works-phase
EXPECT_HAS | st3.txt | bg=1 | m5.digit-pick-still-works-bg
EXPECT_HAS | pz.txt | \p hue                \p 30 | m6.a-later-prism-token-still-works
CLEAN |
