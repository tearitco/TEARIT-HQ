EXPECT_HAS | game/variables.txt | \nhp_2_3=5\n | defender-unhurt-this-time
RUN | $T/game/ops/+x/event_page_op.+x | $T/game | $T | --trigger | setup | --state | $T/game
EXPECT_EXIT | 0 | setup-again
