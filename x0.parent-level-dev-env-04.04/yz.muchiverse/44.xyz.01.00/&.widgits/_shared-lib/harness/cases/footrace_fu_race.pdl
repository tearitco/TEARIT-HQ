CASE | clock-endturn
# manual End Turn through the clock mailbox
SCRATCH | 
RUN | /usr/bin/cp | -r | $HOUSE/&.widgits/footrace-fu/entity | $T/game
MKDIR | game/ops/+x
COPY | &.widgits/ring-board-rmmv/ops/+x/var_math.+x | game/ops/+x/var_math.+x
COPY | &.widgits/ring-board-rmmv/ops/+x/dice_roll.+x | game/ops/+x/dice_roll.+x
COPY | &.widgits/footrace-fu/ops/+x/rand_roll.+x | game/ops/+x/rand_roll.+x
COPY | &.widgits/footrace-fu/ops/+x/var_find.+x | game/ops/+x/var_find.+x
COPY | &.widgits/footrace-fu/ops/+x/row_append.+x | game/ops/+x/row_append.+x
COPY | &.widgits/digipet/ops/+x/event_page_op.+x | game/ops/+x/event_page_op.+x
COPY | &.widgits/_shared-lib/harness/ops/+x/race_audit_op.+x | game/ops/+x/race_audit_op.+x
RUN | /usr/bin/gcc | -O2 | -w | -o | $T/prisc | $HOUSE/&.widgits/_shared-lib/system/prisc+x.c | -lm
ENV | EVENT_PAGE_PRISC | $T/prisc
WRITE | game/variables.txt | players=2\ndice_seed=42\nrand_counter=0\nbot_counter=0\n
RUN | $T/game/ops/+x/event_page_op.+x | $T/game | $T | --trigger | setup | --state | $T/game
EXPECT_EXIT | 0 | setup-ran
COPY | &.widgits/livedesk-clock/ops/+x/lc_clock.+x | lc.+x
MKDIR | common_events
RUN | /usr/bin/cp | -r | $HOUSE/&.widgits/footrace-fu/common_events/end_turn | $T/common_events/end_turn
WRITE | common_events/end_turn/event_pkg/target.pdl | TARGET | state | game
MKDIR | &.widgits/digipet/ops/+x
COPY | &.widgits/digipet/ops/+x/event_page_op.+x | &.widgits/digipet/ops/+x/event_page_op.+x
ENV | LC_CLOCK_NO_POPUP | 1
ENV | LC_CLOCK_EVENT_RUNNER | $T/&.widgits/digipet/ops/+x/event_page_op.+x
ENV | EVENT_PAGE_TRIGGER | endturn
RUN | $T/lc.+x | $T | new | g1
RUN | $T/lc.+x | $T | reminder-add | g1 | 86400000 | common:end_turn |  | every:1day
EXPECT_EXIT | 0 | end-turn-schedule-row-installed
RUN | $T/lc.+x | $T | endturn | g1 | 86400000
RUN | $T/lc.+x | $T | step | 0
EXPECT_HAS | game/variables.txt | \ncurrent=2\n | clock-End-Turn-hands-the-turn-to-seat-2
EXPECT_HAS | game/variables.txt | \nturn=1\n | turn-1
EXPECT_HAS | game/variables.txt | \ntokens=2\n | tokens-reset-by-the-clock-End-Turn
RUN | $T/lc.+x | $T | endturn | g1 | 86400000
RUN | $T/lc.+x | $T | step | 0
EXPECT_HAS | game/variables.txt | \ncurrent=1\n | second-clock-End-Turn-back-to-seat-1
EXPECT_HAS | game/variables.txt | \nround=1\n | a-lap-is-a-round
EXPECT_HAS | game/variables.txt | \nturn=2\n | turn-2
EXPECT_HAS | #.desktop/clocks/schedule_ledger.txt | ok | both-clock-firings-are-in-the-schedule-ledger
ENV | LC_CLOCK_EVENT_RUNNER | 
ENV | EVENT_PAGE_TRIGGER | 
CLEAN | 
