# 3 players, rule variant: exact landing + coin tie-break, mixed rosters (Mystic, Shadow Step, Blade Dancer...)
SCRATCH | 
RUN | /usr/bin/cp | -r | $HOUSE/&.widgits/footrace-fu/entity | $T/game
MKDIR | game/ops/+x
COPY | &.widgits/ring-board-rmmv/ops/+x/var_math.+x | game/ops/+x/var_math.+x
COPY | &.widgits/ring-board-rmmv/ops/+x/dice_roll.+x | game/ops/+x/dice_roll.+x
COPY | &.widgits/footrace-fu/ops/+x/rand_roll.+x | game/ops/+x/rand_roll.+x
COPY | &.widgits/footrace-fu/ops/+x/var_find.+x | game/ops/+x/var_find.+x
COPY | &.widgits/footrace-fu/ops/+x/row_append.+x | game/ops/+x/row_append.+x
COPY | &.widgits/digipet/ops/+x/event_page_op.+x | game/ops/+x/event_page_op.+x
COPY | &.widgits/_shared-lib/harness/ops/+x/race_audit_op.+x | game/ops/+x/race_audit_op.+x
RUN | /usr/bin/gcc | -O2 | -w | -o | $T/prisc | $HOUSE/&.widgits/_shared-lib/system/prisc+x.c | -lm
ENV | EVENT_PAGE_PRISC | $T/prisc
RUN | $T/game/ops/+x/var_math.+x | $T/game | set | rules.pdl:finish_rule | 1
RUN | $T/game/ops/+x/var_math.+x | $T/game | set | rules.pdl:tie_rule | 2
WRITE | game/roster.pdl | r_1_1=4\nr_1_2=5\nr_1_3=2\nr_1_4=4\nr_1_5=5\nr_2_1=1\nr_2_2=2\nr_2_3=3\nr_2_4=4\nr_2_5=5\nr_3_1=5\nr_3_2=4\nr_3_3=3\nr_3_4=4\nr_3_5=5\nr_4_1=1\nr_4_2=2\nr_4_3=3\nr_4_4=4\nr_4_5=5\n
WRITE | game/variables.txt | players=3\ndice_seed=6\nrand_counter=0\nbot_counter=0\n
RUN | $T/game/ops/+x/event_page_op.+x | $T/game | $T | --trigger | setup | --state | $T/game
EXPECT_EXIT | 0 | setup-ran
WRITE | loop.pal | li x2, 260\n_l1:\nbeq x2, x0, _d1\nexec game/ops/+x/event_page_op.+x game game --trigger autoturn --state game\nexec game/ops/+x/race_audit_op.+x audit game\naddi x2, x2, -1\nj _l1\n_d1:\nhalt\n
RUN | $T/prisc | loop.pal
EXPECT_EXIT | 0 | pal-loop-of-260-bot-actions-ran
EXPECT_LACKS | game/audit_ledger.txt | FAIL | referee-never-failed-an-action
EXPECT_HAS | game/audit_ledger.txt | \pok\p | referee-passed-actions
EXPECT_NOFILE | game/op_errors.txt | no-op-reported-an-error
EXPECT_HAS | game/switches.txt | game_over=1\n | race-reached-game-over
EXPECT_HAS | game/variables.txt | \ngame_over_reason=1\n | Finish
EXPECT_HAS | game/rand_ledger.txt | RAND\p | coin-flips-happened-ties-and-casts
CLEAN | 
CASE | race-2p-overshoot
# rule variant: overshoot wins, 12-space track, 5 tokens epic
SCRATCH | 
RUN | /usr/bin/cp | -r | $HOUSE/&.widgits/footrace-fu/entity | $T/game
MKDIR | game/ops/+x
COPY | &.widgits/ring-board-rmmv/ops/+x/var_math.+x | game/ops/+x/var_math.+x
COPY | &.widgits/ring-board-rmmv/ops/+x/dice_roll.+x | game/ops/+x/dice_roll.+x
COPY | &.widgits/footrace-fu/ops/+x/rand_roll.+x | game/ops/+x/rand_roll.+x
COPY | &.widgits/footrace-fu/ops/+x/var_find.+x | game/ops/+x/var_find.+x
COPY | &.widgits/footrace-fu/ops/+x/row_append.+x | game/ops/+x/row_append.+x
COPY | &.widgits/digipet/ops/+x/event_page_op.+x | game/ops/+x/event_page_op.+x
COPY | &.widgits/_shared-lib/harness/ops/+x/race_audit_op.+x | game/ops/+x/race_audit_op.+x
RUN | /usr/bin/gcc | -O2 | -w | -o | $T/prisc | $HOUSE/&.widgits/_shared-lib/system/prisc+x.c | -lm
ENV | EVENT_PAGE_PRISC | $T/prisc
RUN | $T/game/ops/+x/var_math.+x | $T/game | set | rules.pdl:finish_rule | 3
RUN | $T/game/ops/+x/var_math.+x | $T/game | set | rules.pdl:track_len | 12
RUN | $T/game/ops/+x/var_math.+x | $T/game | set | rules.pdl:action_tokens | 3
RUN | $T/game/ops/+x/var_math.+x | $T/game | set | rules.pdl:max_action_tokens | 3
WRITE | game/variables.txt | players=2\ndice_seed=7\nrand_counter=0\nbot_counter=0\n
RUN | $T/game/ops/+x/event_page_op.+x | $T/game | $T | --trigger | setup | --state | $T/game
EXPECT_EXIT | 0 | setup-ran
WRITE | loop.pal | li x2, 260\n_l1:\nbeq x2, x0, _d1\nexec game/ops/+x/event_page_op.+x game game --trigger autoturn --state game\nexec game/ops/+x/race_audit_op.+x audit game\naddi x2, x2, -1\nj _l1\n_d1:\nhalt\n
RUN | $T/prisc | loop.pal
EXPECT_EXIT | 0 | pal-loop-of-260-bot-actions-ran
EXPECT_LACKS | game/audit_ledger.txt | FAIL | referee-never-failed-an-action
EXPECT_HAS | game/audit_ledger.txt | \pok\p | referee-passed-actions
EXPECT_NOFILE | game/op_errors.txt | no-op-reported-an-error
EXPECT_HAS | game/switches.txt | game_over=1\n | race-reached-game-over
EXPECT_HAS | game/variables.txt | \ngame_over_reason=1\n | Finish
CLEAN | 
CASE | save-restore
# game_snapshot_op save after 20 bot actions, mutate, restore, continue = the uninterrupted race (same dice and coin positions, same winner)
SCRATCH | 
RUN | /usr/bin/cp | -r | $HOUSE/&.widgits/footrace-fu/entity | $T/game
MKDIR | game/ops/+x
COPY | &.widgits/ring-board-rmmv/ops/+x/var_math.+x | game/ops/+x/var_math.+x
COPY | &.widgits/ring-board-rmmv/ops/+x/dice_roll.+x | game/ops/+x/dice_roll.+x
COPY | &.widgits/footrace-fu/ops/+x/rand_roll.+x | game/ops/+x/rand_roll.+x
COPY | &.widgits/footrace-fu/ops/+x/var_find.+x | game/ops/+x/var_find.+x
COPY | &.widgits/footrace-fu/ops/+x/row_append.+x | game/ops/+x/row_append.+x
COPY | &.widgits/digipet/ops/+x/event_page_op.+x | game/ops/+x/event_page_op.+x
COPY | &.widgits/_shared-lib/harness/ops/+x/race_audit_op.+x | game/ops/+x/race_audit_op.+x
RUN | /usr/bin/gcc | -O2 | -w | -o | $T/prisc | $HOUSE/&.widgits/_shared-lib/system/prisc+x.c | -lm
ENV | EVENT_PAGE_PRISC | $T/prisc
WRITE | game/variables.txt | players=2\ndice_seed=3\nrand_counter=0\nbot_counter=0\n
RUN | $T/game/ops/+x/event_page_op.+x | $T/game | $T | --trigger | setup | --state | $T/game
EXPECT_EXIT | 0 | setup-ran
WRITE | loop.pal | li x2, 20\n_l1:\nbeq x2, x0, _d1\nexec game/ops/+x/event_page_op.+x game game --trigger autoturn --state game\nexec game/ops/+x/race_audit_op.+x audit game\naddi x2, x2, -1\nj _l1\n_d1:\nhalt\n
RUN | $T/prisc | loop.pal
EXPECT_EXIT | 0 | pal-loop-of-20-bot-actions-ran
EXPECT_LACKS | game/audit_ledger.txt | FAIL | referee-clean-before-the-save
RUN | /usr/bin/sha256sum | game/variables.txt | game/switches.txt | game/ledger.txt | game/dice_ledger.txt | game/rand_ledger.txt | game/audit_ledger.txt
CAPTURE | sig_at20
COPY | &.widgits/_shared-lib/ops/+x/game_snapshot_op.+x | gso
RUN | /usr/bin/grep | -h | ^dice_counter= | $T/game/variables.txt
CAPTURE | dc_saved
RUN | /usr/bin/grep | -h | ^rand_counter= | $T/game/variables.txt
CAPTURE | rc_saved
RUN | $T/gso | $T/store | $T/game | save | CP20 | --now-ms | 1000
EXPECT_EXIT | 0 | save-after-20-actions
WRITE | loop.pal | li x2, 15\n_l1:\nbeq x2, x0, _d1\nexec game/ops/+x/event_page_op.+x game game --trigger autoturn --state game\nexec game/ops/+x/race_audit_op.+x audit game\naddi x2, x2, -1\nj _l1\n_d1:\nhalt\n
RUN | $T/prisc | loop.pal
EXPECT_EXIT | 0 | pal-loop-of-15-bot-actions-ran
RUN | $T/game/ops/+x/var_math.+x | $T/game | set | hp_1_1 | 1
WRITE | game/variables.txt | players=2\ncash=999999\n
RUN | /usr/bin/sha256sum | game/variables.txt | game/switches.txt | game/ledger.txt | game/dice_ledger.txt | game/rand_ledger.txt | game/audit_ledger.txt
CAPTURE | sig_mut
EXPECT_NE | $sig_at20 | $sig_mut | the-mutation-really-changed-the-game
RUN | $T/gso | $T/store | $T/game | restore | CP20 | $T/game | --apply | --prune | --now-ms | 2000
EXPECT_EXIT | 0 | restore-applied
RUN | /usr/bin/sha256sum | game/variables.txt | game/switches.txt | game/ledger.txt | game/dice_ledger.txt | game/rand_ledger.txt | game/audit_ledger.txt
CAPTURE | sig_rest
EXPECT_EQ | $sig_at20 | $sig_rest | restore-brings-back-variables-switches-all-ledgers-dice-and-coin-exactly
RUN | /usr/bin/grep | -h | ^dice_counter= | $T/game/variables.txt
CAPTURE | dc_rest
EXPECT_EQ | $dc_saved | $dc_rest | dice-counter-restored
RUN | /usr/bin/grep | -h | ^rand_counter= | $T/game/variables.txt
CAPTURE | rc_rest
EXPECT_EQ | $rc_saved | $rc_rest | coin-counter-restored
WRITE | loop.pal | li x2, 260\n_l1:\nbeq x2, x0, _d1\nexec game/ops/+x/event_page_op.+x game game --trigger autoturn --state game\nexec game/ops/+x/race_audit_op.+x audit game\naddi x2, x2, -1\nj _l1\n_d1:\nhalt\n
RUN | $T/prisc | loop.pal
EXPECT_EXIT | 0 | pal-loop-of-260-bot-actions-ran
RUN | /usr/bin/sha256sum | game/variables.txt | game/switches.txt | game/ledger.txt | game/dice_ledger.txt | game/rand_ledger.txt | game/audit_ledger.txt
CAPTURE | sig_cont
EXPECT_EQ | $sig_cont | $sig_a | SAVE-RESTORE-CONTINUE-EQUALS-THE-UNINTERRUPTED-RACE-same-rolls-same-coins-same-winner-same-ledgers
EXPECT_LACKS | game/audit_ledger.txt | FAIL | referee-clean-across-the-restore
EXPECT_HAS | game/variables.txt | \nwinner=2\n | winner-seat-2-as-in-the-uninterrupted-race
CLEAN | 
