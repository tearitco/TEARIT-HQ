CASE | setup
# 2 players: armies, selection, tokens
SCRATCH | 
RUN | /usr/bin/cp | -r | $HOUSE/&.widgits/footrace-fu/entity | $T/game
MKDIR | game/ops/+x
COPY | &.widgits/ring-board-rmmv/ops/+x/var_math.+x | game/ops/+x/var_math.+x
COPY | &.widgits/ring-board-rmmv/ops/+x/dice_roll.+x | game/ops/+x/dice_roll.+x
