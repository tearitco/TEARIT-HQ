CASE | fairness
# ROLL-OFF FAIRNESS: 2000 seeded 1d6 vs 1d6 combats and 2000 coin flips from the real ops; tie ~16.7%, wins symmetric
SCRATCH | 
RUN | /usr/bin/cp | -r | $HOUSE/&.widgits/footrace-fu/entity | $T/game
MKDIR | game/ops/+x
COPY | &.widgits/ring-board-rmmv/ops/+x/var_math.+x | game/ops/+x/var_math.+x
COPY | &.widgits/ring-board-rmmv/ops/+x/dice_roll.+x | game/ops/+x/dice_roll.+x
COPY | &.widgits/footrace-fu/ops/+x/rand_roll.+x | game/ops/+x/rand_roll.+x
COPY | &.widgits/footrace-fu/ops/+x/var_find.+x | game/ops/+x/var_find.+x
COPY | &.widgits/footrace-fu/ops/+x/row_append.+x | game/ops/+x/row_append.+x
COPY | &.widgits/digipet/ops/+x/event_page_op.+x | game/ops/+x/event_page_op.+x
COPY | &.widgits/_shared-lib/harness/ops/+x/race_audit_op.+x | game/ops/+x/race_audit_op.+x
RUN | /usr/bin/gcc | -O2 | -w | -o | $T/prisc | $HOUSE/&.widgits/_shared-lib/system/prisc+x.c | -lm
ENV | EVENT_PAGE_PRISC | $T/prisc
WRITE | game/variables.txt | players=2\ndice_seed=42\nrand_counter=0\nbot_counter=0\n
WRITE | game/variables.txt | dice_seed=42\ndice_counter=0\nrand_counter=0\n
WRITE | loop.pal | li x2, 2000\n_l1:\nbeq x2, x0, _d1\nexec game/ops/+x/dice_roll.+x game dice_seed dice_counter\nexec game/ops/+x/rand_roll.+x game dice_seed rand_counter 2 coin\naddi x2, x2, -1\nj _l1\n_d1:\nhalt\n
RUN | $T/prisc | loop.pal
EXPECT_EXIT | 0 | 2000-roll-offs-and-2000-flips-ran
EXPECT_HAS | game/variables.txt | \ndice_counter=2000\n | 2000-dice-rolls-on-the-books
EXPECT_HAS | game/variables.txt | \nrand_counter=2000\n | 2000-coin-flips-on-the-books
RUN | $T/game/ops/+x/race_audit_op.+x | fairness | $T/game | 25 | 40
EXPECT_EXIT | 0 | FAIRNESS-tie-rate-within-2.5-points-of-16.7%-wins-symmetric-within-4-points-coin-and-die-faces-within-4-points
EXPECT_OUT | n=2000 tie= | fairness-report-counts-2000-roll-offs
RUN | $T/game/ops/+x/race_audit_op.+x | fairness | $T/game | 1 | 1
EXPECT_EXIT | 1 | an-absurdly-tight-tolerance-of-0.1-points-fails-so-the-check-can-fail
RUN | $T/game/ops/+x/race_audit_op.+x | exact
EXPECT_OUT_IS | tie=6 attacker=15 defender=15 of=36 | exact-enumeration-tie-1/6-wins-equal
CLEAN | 
