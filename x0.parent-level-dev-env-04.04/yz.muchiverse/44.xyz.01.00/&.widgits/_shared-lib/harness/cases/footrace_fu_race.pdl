# footrace_fu_race (OWN-GAMES-REFERENCE-SUITE-DESIGN.md step 3): Footrace Fu RACE MODE v0 on the neutral engine: ninjas, action tokens, combat roll-off, abilities, finish rule, last army.
# Scratch roots only: the entity is copied to $T/game, the ring-board ops (dice_roll, var_math) and the three Footrace ops beside it, event_page_op, prisc compiled into $T. Real event.pal pages, real ops.
# The independent referee is race_audit_op (state, ledger, previous snapshot). Every number here comes from rules.pdl / ninjas.pdl / abilities.pdl / track.pdl; overrides write those files.
# Pinned dice (seed 42, dice_roll d1 d2 by counter): 0:4,3 1:4,4 2:1,3 3:6,6 4:4,2 5:4,4 6:2,6 7:3,6 8:2,6 9:4,4 10:4,1. Pinned coin (rand_roll sides 2, seed 42, counter 0..): 1 2 2 1 2 1 1 1 2 2. d4 (sides 4): 3 4 4 3 2 1.
RESULTS | ../results/footrace_fu_race.txt
CASE | ops
# the three new tiny ops (and dice_roll reused as is)
SCRATCH | 
RUN | /usr/bin/cp | -r | $HOUSE/&.widgits/footrace-fu/entity | $T/game
MKDIR | game/ops/+x
COPY | &.widgits/ring-board-rmmv/ops/+x/var_math.+x | game/ops/+x/var_math.+x
COPY | &.widgits/ring-board-rmmv/ops/+x/dice_roll.+x | game/ops/+x/dice_roll.+x
COPY | &.widgits/footrace-fu/ops/+x/rand_roll.+x | game/ops/+x/rand_roll.+x
COPY | &.widgits/footrace-fu/ops/+x/var_find.+x | game/ops/+x/var_find.+x
COPY | &.widgits/footrace-fu/ops/+x/row_append.+x | game/ops/+x/row_append.+x
COPY | &.widgits/digipet/ops/+x/event_page_op.+x | game/ops/+x/event_page_op.+x
COPY | &.widgits/_shared-lib/harness/ops/+x/race_audit_op.+x | game/ops/+x/race_audit_op.+x
RUN | /usr/bin/gcc | -O2 | -w | -o | $T/prisc | $HOUSE/&.widgits/_shared-lib/system/prisc+x.c | -lm
ENV | EVENT_PAGE_PRISC | $T/prisc
WRITE | game/variables.txt | players=2\ndice_seed=42\nrand_counter=0\nbot_counter=0\n
WRITE | game/variables.txt | dice_seed=42\nrand_counter=0\ncur=2\npos_1_1=3\npos_1_2=7\npos_2_1=7\npos_2_3=9\npos_3_1=-1000\n
RUN | $T/game/ops/+x/rand_roll.+x | $T/game | 42 | 0 | 2 | coin
EXPECT_OUT_IS | 1 | rand_roll-seed42-counter0-coin-is-1
EXPECT_HAS | game/variables.txt | \ncoin=1\n | coin=1
EXPECT_HAS | game/variables.txt | \nrand_counter=1\n | rand_counter-advances-to-counter-plus-1
RUN | $T/game/ops/+x/rand_roll.+x | $T/game | dice_seed | rand_counter | 2 | coin
EXPECT_OUT_IS | 2 | rand_roll-reads-seed-and-counter-from-variables-coin-2
EXPECT_HAS | game/variables.txt | \nrand_counter=2\n | rand_counter=2
RUN | $T/game/ops/+x/rand_roll.+x | $T/game | 42 | 0 | 4 | d4
EXPECT_OUT_IS | 3 | rand_roll-d4-seed42-counter0-is-3
RUN | $T/game/ops/+x/rand_roll.+x | $T/game | 42 | 1 | 4 | d4
EXPECT_OUT_IS | 4 | rand_roll-d4-seed42-counter1-is-4
RUN | $T/game/ops/+x/rand_roll.+x | $T/game | 42 | 2 | 4 | d4
EXPECT_OUT_IS | 4 | rand_roll-d4-seed42-counter2-is-4
RUN | $T/game/ops/+x/rand_roll.+x | $T/game | 42 | 3 | 4 | d4
EXPECT_OUT_IS | 3 | rand_roll-d4-seed42-counter3-is-3
RUN | $T/game/ops/+x/rand_roll.+x | $T/game | 42 | 4 | 4 | d4
EXPECT_OUT_IS | 2 | rand_roll-d4-seed42-counter4-is-2
RUN | $T/game/ops/+x/rand_roll.+x | $T/game | 42 | 5 | 4 | d4
EXPECT_OUT_IS | 1 | rand_roll-d4-seed42-counter5-is-1
RUN | $T/game/ops/+x/rand_roll.+x | $T/game | 42 | 3 | 4 | d4
CAPTURE | d4_again
EXPECT_EQ | $d4_again | 3 | rand_roll-same-seed-same-counter-same-value-again
RUN | $T/game/ops/+x/rand_roll.+x | $T/game | 43 | 0 | 4 | d4
CAPTURE | d4_other
EXPECT_EQ | $d4_other | 1 | rand_roll-other-seed-other-value-1
RUN | $T/game/ops/+x/rand_roll.+x | $T/game | 42 | 1 | 100 | pct
EXPECT_OUT_IS | 80 | rand_roll-d100-seed42-counter1-is-80
EXPECT_HAS | game/variables.txt | \npct=80\n | pct=80-any-sides-work
RUN | $T/game/ops/+x/rand_roll.+x | $T/game | 42 | 0 | 2 | switches.txt:flip
EXPECT_HAS | game/switches.txt | flip=1\n | rand_roll-out-var-may-name-another-file
EXPECT_HAS | game/rand_ledger.txt | RAND\p42\p0\p2\p1\n | rand-ledger-row-appended-no-timestamp
RUN | $T/game/ops/+x/rand_roll.+x | $T/game | 42 | 0 | 1 | z
EXPECT_EXIT | 1 | rand_roll-one-sided-die-refused-exit-1
EXPECT_HAS | game/op_errors.txt | ERR\prand_roll\psides out of range | rand_roll-error-leaves-an-ERR-row
RUN | $T/game/ops/+x/rand_roll.+x | $T/game | 42 | 0 | 2
EXPECT_EXIT | 2 | rand_roll-usage-exit-2
RUN | $T/game/ops/+x/dice_roll.+x | $T/game | 42 | 1
EXPECT_OUT_IS | 4 4 | dice_roll-reused-unchanged-seed42-counter1
RUN | $T/game/ops/+x/var_find.+x | $T/game | pos_ | pos_{cur}_ | 7 | 0 | 0 | f
EXPECT_OUT_IS | 1 | var_find-enemy-on-space-7-skipping-my-own-seat-finds-1
EXPECT_HAS | game/variables.txt | \nf_1=1\n | var_find-first-number-of-the-name-is-the-seat
EXPECT_HAS | game/variables.txt | \nf_2=2\n | var_find-second-number-is-the-ninja
EXPECT_HAS | game/variables.txt | \nf_d=0\n | var_find-distance-0
RUN | $T/game/ops/+x/var_find.+x | $T/game | pos_ | - | 8 | 0 | 3 | g
EXPECT_OUT_IS | 3 | var_find-window-0-to-3-around-8-matches-three
EXPECT_HAS | game/variables.txt | \ng_1=1\n | var_find-nearest-tie-goes-to-the-smallest-seat
EXPECT_HAS | game/variables.txt | \ng_2=2\n | var_find-then-the-smallest-ninja
EXPECT_HAS | game/variables.txt | \ng_d=1\n | var_find-distance-1
RUN | $T/game/ops/+x/var_find.+x | $T/game | pos_ | - | 8 | 2 | 5 | h
EXPECT_OUT_IS | 1 | var_find-dmin-2-excludes-the-near-ones-leaving-only-pos_1_1-5-away
EXPECT_HAS | game/variables.txt | \nh_1=1\n | h_1=1
EXPECT_HAS | game/variables.txt | \nh_2=1\n | h_2=1
EXPECT_HAS | game/variables.txt | \nh_d=5\n | var_find-distance-5
RUN | $T/game/ops/+x/var_find.+x | $T/game | pos_ | - | 50 | 0 | 3 | none
EXPECT_OUT_IS | 0 | var_find-nothing-in-reach-is-count-0
EXPECT_EXIT | 0 | var_find-no-match-is-still-exit-0
EXPECT_HAS | game/variables.txt | \nnone_1=0\n | none_1=0
EXPECT_HAS | game/variables.txt | \nnone_d=0\n | none_d=0
RUN | $T/game/ops/+x/var_find.+x | $T/game | pos_ | - | 0 | 0 | 99 | all
EXPECT_OUT_IS | 4 | var_find-dead-ninjas-at-minus-1000-never-match-a-window
RUN | $T/game/ops/+x/var_find.+x | $T/game | pos_ | - | 0 | 0
EXPECT_EXIT | 2 | var_find-usage-exit-2
WRITE | game/variables.txt | turn=4\ncurrent=2\n
RUN | $T/game/ops/+x/row_append.+x | $T/game | l.txt | ACT | {turn} | {current} | x
EXPECT_EXIT | 0 | row_append-ok
EXPECT_FILE | game/l.txt | ACT\p4\p2\px\n | row_append-expands-vars-and-joins-with-bars
RUN | $T/game/ops/+x/row_append.+x | $T/game | l.txt | AGAIN
EXPECT_EXIT | 0 | row_append-second-row
EXPECT_FILE | game/l.txt | ACT\p4\p2\px\nAGAIN\n | row_append-only-appends
RUN | $T/game/ops/+x/row_append.+x | $T/game | ../l.txt | X
EXPECT_EXIT | 2 | row_append-path-escape-refused-exit-2
RUN | $T/game/ops/+x/row_append.+x | $T/game | l.txt
EXPECT_EXIT | 2 | row_append-usage-exit-2
RUN | $T/game/ops/+x/race_audit_op.+x | exact
EXPECT_OUT_IS | tie=6 attacker=15 defender=15 of=36 | roll-off-exact-enumeration-tie-6-of-36-wins-15-and-15
RUN | $T/game/ops/+x/race_audit_op.+x | audit
EXPECT_EXIT | 2 | race_audit_op-usage-exit-2
CLEAN | 
CASE | data
# the data files themselves: owner-pending questions are tunables with a comment, placeholders are marked, no variant is hardcoded
SCRATCH | 
RUN | /usr/bin/cp | -r | $HOUSE/&.widgits/footrace-fu | $T/ff
RUN | /usr/bin/grep | -B1 | ^finish_rule= | $T/ff/entity/rules.pdl
EXPECT_OUT | owner decision pending | rules.pdl-finish_rule-carries-owner-decision-pending
RUN | /usr/bin/grep | -B1 | ^move_costs_action= | $T/ff/entity/rules.pdl
EXPECT_OUT | owner decision pending | rules.pdl-move_costs_action-carries-owner-decision-pending
RUN | /usr/bin/grep | -B1 | ^free_moves_per_turn= | $T/ff/entity/rules.pdl
EXPECT_OUT | owner decision pending | rules.pdl-free_moves_per_turn-carries-owner-decision-pending
RUN | /usr/bin/grep | -B1 | ^tie_rule= | $T/ff/entity/rules.pdl
EXPECT_OUT | owner decision pending | rules.pdl-tie_rule-carries-owner-decision-pending
RUN | /usr/bin/grep | -B1 | ^teleport_foe_to_finish= | $T/ff/entity/rules.pdl
