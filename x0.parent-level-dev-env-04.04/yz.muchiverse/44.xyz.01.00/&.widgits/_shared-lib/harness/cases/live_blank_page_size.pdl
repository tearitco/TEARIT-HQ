# live_blank_page_size: step 0 of the tear-it co plan: the x, y AND z limits of a BLANK page in the running editor board. LIVE (real engine; LIVE_OK=1 or SKIP; tell the owner first).
# The Store page's cells.txt (and extrusion.pdl for the z series) is swapped for a generated blank page (ops/blank_page_op.c), the board is reloaded with load-map (the step that reliably redraws this board; a keyboard nudge did NOT, see the handoff index),
# then: the window is alive, the canvas is a drawn picture, and it DIFFERS from the Store page (the control: the same detector sees "no change" at the end, after the restore).
# x,y: 64, 128, 192, 256 square. z: hung depth 1, 16 (the engine's max), 17 and 255 (ignored by the engine: bv_render_3d.c keeps only 1..16), and wall extrusion default 8 and 64. Passing means "loads and draws, window survives", NOT "looks right".
# Both files are restored and hash-checked. Known hard limit from the code: a cells.txt row goes through a 16384-byte buffer, so a blank row breaks near 2700 columns (the op exits 3 past it).
RESULTS | ../results/live_blank_page_size.txt
ENV | LC_ALL | C
NEEDENV | LIVE_OK

CASE    | setup
SCRATCH |
RUN | /bin/cp | $HOUSE/@.apps/rpg-edit-hq/rpg-edit-hq-pchq/pieces/system/maps/rpg-edit-hq/store/cells.txt | $T/cells.bak
RUN | /bin/cp | $HOUSE/@.apps/rpg-edit-hq/rpg-edit-hq-pchq/pieces/system/maps/rpg-edit-hq/store/cells.marker | $T/marker.bak
RUN | /bin/cp | $HOUSE/@.apps/rpg-edit-hq/rpg-edit-hq-pchq/pieces/system/maps/rpg-edit-hq/store/extrusion.pdl | $T/extr.bak
RUN | /usr/bin/sha256sum | $HOUSE/@.apps/rpg-edit-hq/rpg-edit-hq-pchq/pieces/system/maps/rpg-edit-hq/store/cells.txt
CAPTURE | hash0
RUN | /usr/bin/sha256sum | $HOUSE/@.apps/rpg-edit-hq/rpg-edit-hq-pchq/pieces/system/maps/rpg-edit-hq/store/extrusion.pdl
CAPTURE | ehash0
RUN | $HOUSE/&.widgits/_shared-lib/ops/+x/relay_drive.+x | findwin | 1300 | 802
EXPECT_EXIT | 0 | the-editor-window-is-open
CAPTURE | win
RUN | /usr/bin/cat | $HOUSE/@.apps/rpg-edit-hq/board/module_parent.pid
CAPTURE | wpid
RUN | /usr/bin/sed | -n | s/^bv_session=//p | $HOUSE/@.apps/rpg-edit-hq/board/state/ui.txt
CAPTURE | sess
RUN | /bin/sh | $HOUSE/@.apps/piececraft-hq/ops/pchq_board_action.sh | $sess | load-map | rpg-edit-hq
SLEEP | 45000
RUN | $HOUSE/&.widgits/_shared-lib/ops/+x/relay_drive.+x | shot | $win | $T/base.png

CASE    | xy-64x64
RUN | $HOUSE/&.widgits/_shared-lib/harness/ops/+x/blank_page_op.+x | $T/cells.bak | $T/b.txt | 64 | 64
EXPECT_EXIT | 0 | blank-64-written-rows-fit-the-line-buffer
RUN | /bin/cp | $T/b.txt | $HOUSE/@.apps/rpg-edit-hq/rpg-edit-hq-pchq/pieces/system/maps/rpg-edit-hq/store/cells.txt
RUN | /usr/bin/truncate | -s | +1 | $HOUSE/@.apps/rpg-edit-hq/rpg-edit-hq-pchq/pieces/system/maps/rpg-edit-hq/store/cells.marker
RUN | /bin/sh | $HOUSE/@.apps/piececraft-hq/ops/pchq_board_action.sh | $sess | load-map | rpg-edit-hq
SLEEP | 45000
EXPECT_ALIVE | $wpid | window-alive-after-xy64
RUN | $HOUSE/&.widgits/_shared-lib/ops/+x/relay_drive.+x | shot | $win | $T/xy64.png
RUN | $HOUSE/&.widgits/_shared-lib/harness/ops/+x/img_op.+x | mean | $T/xy64.png | 208 | 105 | 1094 | 745
CAPTURE | m_xy64
EXPECT_GE | $m_xy64 | 15 | xy64-draws-a-picture-not-black
RUN | $HOUSE/&.widgits/_shared-lib/harness/ops/+x/img_op.+x | diff | $T/base.png | $T/xy64.png | 208 | 105 | 1094 | 745
CAPTURE | d_xy64
EXPECT_GE | $d_xy64 | 3000 | xy64-differs-from-the-store-page-so-the-engine-loaded-it

