RUN | $T/app/ops/+x/deskopoly_ctl.+x | tr_cancel | $T/edit/state/games/deskopoly
WAIT_HAS | edit/state/game_ui.txt | you have no open offer to cancel | 6000 | NEGATIVE-cancel-without-an-offer
RUN | $T/app/ops/+x/deskopoly_ctl.+x | tr_counter | $T/edit/state/games/deskopoly
WAIT_HAS | edit/state/game_ui.txt | no offer for you to counter | 6000 | NEGATIVE-counter-without-an-offer
EXPECT_HAS | $T/edit/state/game_ui.txt | \ntp_on=\n | and-the-screen-did-not-open
RUN | /usr/bin/grep | -c | ^ | $T/edit/state/games/deskopoly/game/ledger.txt
EXPECT_OUT_IS | 51 | and-the-ledger-is-unchanged
# --- draft commands with the screen CLOSED change nothing (a stale button line cannot send an offer) ---
RUN | $T/app/ops/+x/deskopoly_ctl.+x | tr_g19 | $T/edit/state/games/deskopoly
ENV | DESKOPOLY_CTL_REPEAT | 3
RUN | $T/app/ops/+x/deskopoly_ctl.+x | tr_gc+ | $T/edit/state/games/deskopoly
ENV | DESKOPOLY_CTL_REPEAT | 
RUN | $T/app/ops/+x/deskopoly_ctl.+x | tr_send | $T/edit/state/games/deskopoly
RUN | $T/app/ops/+x/deskopoly_ctl.+x | speed_next | $T/edit/state/games/deskopoly
WAIT_HAS | edit/state/game_ui.txt | speed: slow | 6000 | FENCE
RUN | /usr/bin/grep | -c | ^ | $T/edit/state/games/deskopoly/game/ledger.txt
EXPECT_OUT_IS | 51 | NEGATIVE-tr_send-with-the-screen-closed-appended-nothing
RUN | $T/app/ops/+x/deskopoly_ctl.+x | tr_open | $T/edit/state/games/deskopoly
WAIT_HAS | edit/state/game_ui.txt | \ntp_on=1\n | 6000 | CONTROL-opening-the-screen
EXPECT_HAS | $T/edit/state/game_ui.txt | \ntpg_n=2\ntpr_x= | the-closed-screen-draft-commands-left-no-draft-behind
RUN | $T/app/ops/+x/deskopoly_ctl.+x | tr_close | $T/edit/state/games/deskopoly
WAIT_HAS | edit/state/game_ui.txt | \ntp_on=\n | 6000 | closed-again

CASE    | card
# a Get Out card is part of an offer: it rides along in a prefilled draft and can only be taken back out
RUN | $T/app/ops/+x/deskopoly.+x | $T/app | $T/edit/state/games/deskopoly/game | offer | p2 | give | card:fund+prop:12 | get | cash:5 | as=p1
EXPECT_OUT | id=2;give=prop:12+card:fund;get=cash:5;round=1 | p1-opens-offer-2-from-the-CLI-giving-Power-and-the-fund-card
RUN | $T/app/ops/+x/deskopoly.+x | $T/app | $T/edit/state/games/deskopoly/game | ui
RUN | $T/app/ops/+x/deskopoly_ctl.+x | tr_close | $T/edit/state/games/deskopoly
WAIT_HAS | edit/state/game_ui.txt | you give: Spin Works + Lost & Found card\n | 6000 | the-popup-shows-the-card
RUN | $T/app/ops/+x/deskopoly_ctl.+x | tr_amend | $T/edit/state/games/deskopoly
WAIT_HAS | edit/state/game_ui.txt | \ntpg_3_label=Lost & Found card (press: back)\n | 6000 | the-card-is-a-row-of-the-GIVE-pane
EXPECT_HAS | $T/edit/state/game_ui.txt | \ntpg_2_label=Spin Works (press: back)\n | next-to-Power
EXPECT_HAS | $T/edit/state/game_ui.txt | \ntpr_0_label=ask $5: ask 10 more\n | and-ask-5
RUN | $T/app/ops/+x/deskopoly_ctl.+x | tr_gk1 | $T/edit/state/games/deskopoly
WAIT_HAS | edit/state/game_ui.txt | \ntpg_n=3\n | 6000 | pressing-the-card-takes-it-out
EXPECT_LACKS | $T/edit/state/game_ui.txt | fund card (press: back) | and-the-pane-no-longer-shows-it
RUN | $T/app/ops/+x/deskopoly_ctl.+x | tr_gk0 | $T/edit/state/games/deskopoly
RUN | $T/app/ops/+x/deskopoly_ctl.+x | tr_gc+ | $T/edit/state/games/deskopoly
WAIT_HAS | edit/state/game_ui.txt | \ntpg_0_label=give $10: add 10\n | 6000 | FENCE
EXPECT_HAS | $T/edit/state/game_ui.txt | \ntpg_n=3\n | NEGATIVE-the-luck-card-press-added-nothing-a-card-can-only-be-taken-out
RUN | $T/app/ops/+x/deskopoly_ctl.+x | tr_send | $T/edit/state/games/deskopoly
WAIT_HAS | edit/state/games/deskopoly/game/ledger.txt | \pamend\p2\p33\pid=2;give=prop:12+cash:10;get=cash:5;round=1;amended | 6000 | the-amendment-has-no-card-any-more
RUN | $T/app/ops/+x/deskopoly_ctl.+x | tr_cancel | $T/edit/state/games/deskopoly
WAIT_HAS | edit/state/games/deskopoly/game/ledger.txt | \pcancel\p2\p33\pcancelled | 6000 | cancel-offer-2
RUN | /usr/bin/grep | -c | ^ | $T/edit/state/games/deskopoly/game/ledger.txt
EXPECT_OUT_IS | 54 | 51-plus-offer-amend-cancel

CASE    | closes_itself
# a NEW offer needs my turn: when the turn passes, the screen goes away by itself
RUN | $T/app/ops/+x/deskopoly_ctl.+x | tr_open | $T/edit/state/games/deskopoly
WAIT_HAS | edit/state/game_ui.txt | \ntp_on=1\n | 6000 | the-screen-is-open-on-my-turn
RUN | $T/app/ops/+x/deskopoly_ctl.+x | end | $T/edit/state/games/deskopoly
WAIT_HAS | edit/state/games/deskopoly/game/ledger.txt | \pend_turn\p-\p33\pnext=p2;round=5 | 6000 | p1-ends-the-turn-with-the-screen-open
WAIT_HAS | edit/state/game_ui.txt | \ntp_on=\n | 6000 | THE-SCREEN-CLOSED-ITSELF-it-is-not-my-turn
EXPECT_LACKS | $T/edit/state/game_ui.txt | tpa_title | and-no-pane-key-is-left
EXPECT_HAS | $T/edit/state/game_ui.txt | \ncurrent=p2\n | because-p2-is-the-current-player
RUN | $T/app/ops/+x/deskopoly_ctl.+x | tr_open | $T/edit/state/games/deskopoly
RUN | $T/app/ops/+x/deskopoly_ctl.+x | speed_next | $T/edit/state/games/deskopoly
WAIT_HAS | edit/state/game_ui.txt | speed: fast | 6000 | FENCE
EXPECT_HAS | $T/edit/state/game_ui.txt | \ntp_on=\n | NEGATIVE-a-NEW-offer-screen-cannot-be-opened-on-p2s-turn

CASE    | counter
# the pets cannot make offers to the human yet: p2 (current, PRE) offers through the engine CLI exactly as a pet will
RUN | $T/app/ops/+x/deskopoly.+x | $T/app | $T/edit/state/games/deskopoly/game | offer | p1 | give | prop:21+cash:20 | get | prop:19 | as=p2
EXPECT_OUT | id=3;give=prop:21+cash:20;get=prop:19;round=1 | p2-offers-p1-Red1-plus-20-for-Orange3
RUN | $T/app/ops/+x/deskopoly.+x | $T/app | $T/edit/state/games/deskopoly/game | ui
RUN | $T/app/ops/+x/deskopoly_ctl.+x | tr_close | $T/edit/state/games/deskopoly
WAIT_HAS | edit/state/game_ui.txt | they give: Vortex Way + $20\n | 6000 | the-popup-shows-the-incoming-offer-in-words
EXPECT_HAS | $T/edit/state/game_ui.txt | Accept offer | with-Accept
EXPECT_HAS | $T/edit/state/game_ui.txt | Reject offer | Reject
EXPECT_HAS | $T/edit/state/game_ui.txt | Counter... | and-the-new-Counter-button
EXPECT_LACKS | $T/edit/state/game_ui.txt | Trade... | and-no-Trade-button-it-is-not-my-turn
RUN | $T/app/ops/+x/deskopoly_ctl.+x | tr_counter | $T/edit/state/games/deskopoly
WAIT_HAS | edit/state/game_ui.txt | \ngmt_2_text=COUNTER to p2's offer #3\n | 6000 | COUNTER-mode-says-so
EXPECT_HAS | $T/edit/state/game_ui.txt | \ntp_on=1\n | THE-SCREEN-IS-OPEN-although-it-is-p2s-turn
EXPECT_HAS | $T/edit/state/game_ui.txt | \ncurrent=p2\n | which-it-is
EXPECT_HAS | $T/edit/state/game_ui.txt | \ngmb_0_label=Send counter\n | its-send-button
EXPECT_HAS | $T/edit/state/game_ui.txt | \ntpg_2_label=Coil Plaza (press: back)\n | SWAPPED-what-they-ask-Orange3-is-in-my-GIVE
EXPECT_HAS | $T/edit/state/game_ui.txt | \ntpg_n=3\ntpr_x= | and-nothing-else-there
EXPECT_HAS | $T/edit/state/game_ui.txt | \ntpr_0_label=ask $20: ask 10 more\n | what-they-give-is-my-GET-20-cash
EXPECT_HAS | $T/edit/state/game_ui.txt | \ntpr_2_label=Vortex Way (press: back)\n | and-Red1
EXPECT_HAS | $T/edit/state/game_ui.txt | \ntpb_title=p2 B $960 holds\n | the-partner-is-the-proposer-p2
EXPECT_HAS | $T/edit/state/game_ui.txt | \ntpa_n=2\n | the-tiles-in-the-draft-left-the-inventories
EXPECT_HAS | $T/edit/state/game_ui.txt | \ntpb_n=1\n | p2s-pane-lacks-Red1
RUN | $T/app/ops/+x/deskopoly_ctl.+x | tr_partner | $T/edit/state/games/deskopoly
RUN | $T/app/ops/+x/deskopoly_ctl.+x | tr_rc+ | $T/edit/state/games/deskopoly
WAIT_HAS | edit/state/game_ui.txt | \ntpr_0_label=ask $30: ask 10 more\n | 6000 | FENCE-ask-30
EXPECT_HAS | $T/edit/state/game_ui.txt | \ntpb_title=p2 B $960 holds\n | NEGATIVE-a-partner-press-in-counter-mode-changed-nothing
RUN | $T/app/ops/+x/deskopoly_ctl.+x | tr_send | $T/edit/state/games/deskopoly
WAIT_HAS | edit/state/games/deskopoly/game/ledger.txt | \pcounter\p3\p33\pid=4;re=3;give=prop:19;get=prop:21+cash:30;round=2 | 6000 | SEND-in-counter-mode-calls-counter-with-the-offer-id-and-the-new-terms
RUN | /usr/bin/grep | -c | ^ | $T/edit/state/games/deskopoly/game/ledger.txt
EXPECT_OUT_IS | 57 | 54-plus-end_turn-plus-offer-3-plus-counter
WAIT_HAS | edit/state/game_ui.txt | \ntp_on=\n | 6000 | the-screen-closes
WAIT_HAS | edit/state/game_ui.txt | you want: Vortex Way + $30\n | 6000 | the-counter-is-now-MY-open-offer
EXPECT_LACKS | $T/edit/state/game_ui.txt | p2 OFFERS | and-their-original-offer-is-gone
# --- the offer under an open counter screen vanishes: the screen closes itself ---
RUN | $T/app/ops/+x/deskopoly.+x | $T/app | $T/edit/state/games/deskopoly/game | offer | p1 | give | cash:10 | get | - | as=p2
EXPECT_OUT | id=5;give=cash:10;get=-;round=1 | p2-offers-p1-10-cash-offer-5
RUN | $T/app/ops/+x/deskopoly.+x | $T/app | $T/edit/state/games/deskopoly/game | ui
RUN | $T/app/ops/+x/deskopoly_ctl.+x | speed_next | $T/edit/state/games/deskopoly
WAIT_HAS | edit/state/game_ui.txt | they give: $10\n | 6000 | the-new-incoming-offer-is-shown
RUN | $T/app/ops/+x/deskopoly_ctl.+x | tr_counter | $T/edit/state/games/deskopoly
WAIT_HAS | edit/state/game_ui.txt | \ngmt_2_text=COUNTER to p2's offer #5\n | 6000 | the-counter-screen-is-open-for-offer-5
EXPECT_HAS | $T/edit/state/game_ui.txt | \ntp_on=1\n | open
RUN | $T/app/ops/+x/deskopoly.+x | $T/app | $T/edit/state/games/deskopoly/game | cancel | 5 | as=p2
EXPECT_OUT | cancelled | p2-takes-offer-5-back
RUN | $T/app/ops/+x/deskopoly.+x | $T/app | $T/edit/state/games/deskopoly/game | ui
RUN | $T/app/ops/+x/deskopoly_ctl.+x | speed_next | $T/edit/state/games/deskopoly
WAIT_HAS | edit/state/game_ui.txt | \ntp_on=\n | 6000 | THE-COUNTER-SCREEN-CLOSED-ITSELF-its-offer-no-longer-exists
EXPECT_LACKS | $T/edit/state/game_ui.txt | tpa_title | and-no-pane-key-is-left
EXPECT_HAS | $T/edit/state/game_ui.txt | YOUR OFFER #4 to p2 | and-my-own-offer-4-is-still-shown-in-the-popup

CASE    | ctl_hostile
# deskopoly_ctl is the only door from a button to the action file: it takes lower-case letters, digits, _ + - and nothing else
RUN | /usr/bin/cksum | $T/edit/state/games/deskopoly/action.txt
CAPTURE | act0
RUN | $T/app/ops/+x/deskopoly_ctl.+x | tr_g1;rm | $T/edit/state/games/deskopoly
EXPECT_EXIT | 2 | NEGATIVE-a-semicolon-is-refused
RUN | $T/app/ops/+x/deskopoly_ctl.+x | TR_OPEN | $T/edit/state/games/deskopoly
EXPECT_EXIT | 2 | NEGATIVE-upper-case-is-refused
RUN | $T/app/ops/+x/deskopoly_ctl.+x | tr g1 | $T/edit/state/games/deskopoly
EXPECT_EXIT | 2 | NEGATIVE-a-space-is-refused
RUN | $T/app/ops/+x/deskopoly_ctl.+x | ../../x | $T/edit/state/games/deskopoly
EXPECT_EXIT | 2 | NEGATIVE-a-path-is-refused
RUN | $T/app/ops/+x/deskopoly_ctl.+x | tr_g1\ntr_send | $T/edit/state/games/deskopoly
EXPECT_EXIT | 2 | NEGATIVE-a-second-line-smuggled-in-with-a-newline-is-refused
RUN | $T/app/ops/+x/deskopoly_ctl.+x | | $T/edit/state/games/deskopoly
EXPECT_EXIT | 2 | NEGATIVE-an-empty-command-is-refused
RUN | $T/app/ops/+x/deskopoly_ctl.+x | tr_g1111111111111111111111111111111111111111111 | $T/edit/state/games/deskopoly
EXPECT_EXIT | 2 | NEGATIVE-a-41-character-command-is-refused
ENV | DESKOPOLY_CTL_REPEAT | 0
RUN | $T/app/ops/+x/deskopoly_ctl.+x | speed_next | $T/edit/state/games/deskopoly
ENV | DESKOPOLY_CTL_REPEAT | 
EXPECT_EXIT | 2 | NEGATIVE-a-repeat-count-of-0-is-refused
ENV | DESKOPOLY_CTL_REPEAT | 201
RUN | $T/app/ops/+x/deskopoly_ctl.+x | speed_next | $T/edit/state/games/deskopoly
ENV | DESKOPOLY_CTL_REPEAT | 
EXPECT_EXIT | 2 | NEGATIVE-a-repeat-count-of-201-is-refused
ENV | DESKOPOLY_CTL_REPEAT | 5x
RUN | $T/app/ops/+x/deskopoly_ctl.+x | speed_next | $T/edit/state/games/deskopoly
ENV | DESKOPOLY_CTL_REPEAT | 
EXPECT_EXIT | 2 | NEGATIVE-a-repeat-count-with-trailing-text-is-refused
RUN | /usr/bin/cksum | $T/edit/state/games/deskopoly/action.txt
CAPTURE | act1
EXPECT_EQ | $act0 | $act1 | NONE-of-the-ten-refused-calls-wrote-a-byte-to-the-action-file
RUN | $T/app/ops/+x/deskopoly_ctl.+x | speed_next | $T/edit/state/games/deskopoly
EXPECT_EXIT | 0 | CONTROL-a-valid-command-is-accepted
RUN | /usr/bin/cksum | $T/edit/state/games/deskopoly/action.txt
CAPTURE | act2
EXPECT_NE | $act1 | $act2 | and-it-DOES-change-the-action-file-so-the-equality-above-could-have-failed

RUN | $T/app/ops/+x/deskopoly_ctl.+x | speed_next | $T/edit/state/games/deskopoly | 412 | 87
EXPECT_EXIT | 0 | THE-WINDOW-PROTOCOL-the-renderer-appends-the-click-position-as-2-extra-arguments-to-every-button-action-and-they-must-be-ignored-not-refused-FOUND-LIVE-2026-11-08-when-a-positional-count-made-every-popup-button-dead
RUN | /usr/bin/cksum | $T/edit/state/games/deskopoly/action.txt
CAPTURE | act3
EXPECT_NE | $act2 | $act3 | and-that-call-DID-append-its-line
CASE    | owner_exit
RUN | /usr/bin/kill | $OWN
SLEEP   | 300
EXPECT_DEAD | $OWN | the-fake-owner-is-gone
SLEEP   | 1500
EXPECT_DEAD | $DRV | the-driver-ends-with-its-owner
EXPECT_EXISTS | $T/edit/state/games/deskopoly/game/ledger.txt | and-the-game-is-still-in-its-ledger
CLEAN   |
