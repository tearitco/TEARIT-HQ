# live_dsk_seat: YOU take a seat at Deskopoly inside the REAL rpg-edit-hq editor, driven like a person (relay taps resolved by id / label from the window's own text dump), then play three rounds with
# the popup buttons. LIVE: LIVE_OK=1 or SKIP. Precondition: the editor is OPEN on the deskopoly book (Book menu); the harness does not launch or close it, so the owner can WATCH it run (about 2 minutes).
# Protocol and ids: @.apps/deskopoly/nav.pdl. Scripts: @.apps/deskopoly/tests/*.pdl (STEP rows run by relay_drive). Seed 7, 3 players, p1 human: the dice are derived from the ledger, so it is the same game every time.
# SHOTS: @.apps/deskopoly/shots/ (git-ignored; wiped at the start of every run; 7 PNG from the scripts plus 2 overhead 3D frames) for presentations.
# RESTORE: play-mode flag and sides file are checked by hash; the game is sent to New game (the finished game goes to archive/, the last 3 are kept); In: is pressed back ON (the editor default).
# VACUITY GUARDS: the game is not running when we start (no ledger), p1 is shown to be the ONLY human, and each human action is checked as a ledger row by p1, not as feed text.
RESULTS | ../results/live_dsk_seat.txt
ENV | LC_ALL | C
NEEDENV | LIVE_OK
ENV | RELAY_DRIVE_NO_ESC | 1

CASE    | preflight
SCRATCH |
RUN | $HOUSE/&.widgits/_shared-lib/ops/+x/relay_drive.+x | findwin | 1300 | 802
EXPECT_EXIT | 0 | the-editor-window-is-open-and-is-the-only-one-of-its-size
CAPTURE | win
RUN | /usr/bin/cat | $HOUSE/@.apps/rpg-edit-hq/rpg-edit-hq-pchq/pieces/system/board_window.pid
CAPTURE | wpid
EXPECT_HAS | $HOUSE/@.apps/rpg-edit-hq/state/last_book.txt | book=deskopoly | the-editor-has-the-deskopoly-book-open
SNAPSHOT | live | $HOUSE/#.desktop/khtpm_play_mode.state.txt | $HOUSE/@.apps/rpg-edit-hq/board/state/sides.txt
RUN | /bin/rm | -rf | $HOUSE/@.apps/deskopoly/shots
RUN | /bin/mkdir | -p | $HOUSE/@.apps/deskopoly/shots

CASE    | start-state
# A killed session leaves the OLD feed (game_ui.txt) behind: waiting for it would pass on stale data and the commands below would go to a driver that is not running. So: delete the feed (a projection the driver regenerates), start/nudge the driver, wait for the FRESH feed, then command it. (A driver that just started ignores commands written before it started.)
RUN | /bin/rm | -f | $HOUSE/@.apps/rpg-edit-hq/state/game_ui.txt
RUN | $HOUSE/&.widgits/_shared-lib/ops/+x/relay_drive.+x | $wpid | run | $HOUSE/@.apps/deskopoly/tests/dsk-open-play.pdl | $win
RUN | $HOUSE/@.apps/deskopoly/ops/+x/deskopoly_ctl.+x | setup_reset | $HOUSE/@.apps/rpg-edit-hq/state/games/deskopoly
WAIT_HAS | $HOUSE/@.apps/rpg-edit-hq/state/game_ui.txt | gm_on=1 | 30000 | the-driver-is-up-and-publishes-a-FRESH-feed-the-stale-one-was-deleted
RUN | $HOUSE/@.apps/deskopoly/ops/+x/deskopoly_ctl.+x | new_game | $HOUSE/@.apps/rpg-edit-hq/state/games/deskopoly
RUN | $HOUSE/@.apps/deskopoly/ops/+x/deskopoly_ctl.+x | setup_reset | $HOUSE/@.apps/rpg-edit-hq/state/games/deskopoly
WAIT_HAS | $HOUSE/@.apps/rpg-edit-hq/state/game_ui.txt | players, then START | 15000 | the-setup-screen-is-showing
EXPECT_NOFILE | $HOUSE/@.apps/rpg-edit-hq/state/games/deskopoly/game/ledger.txt | VACUITY-no-game-is-running-so-everything-below-starts-from-the-setup-screen

CASE    | seat-setup
RUN | $HOUSE/&.widgits/_shared-lib/ops/+x/relay_drive.+x | $wpid | run | $HOUSE/@.apps/deskopoly/tests/dsk-seat-setup.pdl | $win
EXPECT_EXIT | 0 | THE-SETUP-SCRIPT-PASSES-all-24-steps-by-real-taps
EXPECT_OUT | ALL PASS: 24 pass, 0 fail | and-says-so
RUN | /usr/bin/grep | -c | driver=human | $HOUSE/@.apps/rpg-edit-hq/state/games/deskopoly/game/ledger.txt
EXPECT_OUT_IS | 1 | EXACTLY-ONE-SEAT-IS-HUMAN-p1
RUN | /usr/bin/grep | -c | \pp1\pjoin\p | $HOUSE/@.apps/rpg-edit-hq/state/games/deskopoly/game/ledger.txt
EXPECT_OUT_IS | 1 | and-it-is-p1

CASE    | views
# the 3D view shows the extruded players (the default camera); key 0 toggles the RPG Maker 2D view (the whole board with every walking character). The overhead 3D camera is NOT automated: see nav.pdl (camera, unresolved).
RUN | /usr/bin/sed | -n | s/^bv_session=//p | $HOUSE/@.apps/rpg-edit-hq/board/state/ui.txt
CAPTURE | sess
SLEEP   | 3000
RUN | $HOUSE/&.widgits/_shared-lib/ops/+x/relay_drive.+x | shot | $win | $HOUSE/@.apps/deskopoly/shots/00a-3d-extruded-players.png
EXPECT_EXIT | 0 | the-3D-frame-is-saved
RUN | $HOUSE/&.widgits/board-viewer/tools/+x/bv_keys.+x | $sess | 0
SLEEP   | 4000
RUN | $HOUSE/&.widgits/_shared-lib/ops/+x/relay_drive.+x | shot | $win | $HOUSE/@.apps/deskopoly/shots/00b-2d-whole-board.png
EXPECT_EXIT | 0 | the-2D-frame-is-saved
RUN | /usr/bin/cmp | -s | $HOUSE/@.apps/deskopoly/shots/00a-3d-extruded-players.png | $HOUSE/@.apps/deskopoly/shots/00b-2d-whole-board.png
EXPECT_EXIT | 1 | VACUITY-key-0-really-changed-the-picture-the-2D-and-3D-frames-differ
RUN | $HOUSE/&.widgits/board-viewer/tools/+x/bv_keys.+x | $sess | 0
SLEEP   | 3000

CASE    | three-turns
RUN | $HOUSE/&.widgits/_shared-lib/ops/+x/relay_drive.+x | $wpid | run | $HOUSE/@.apps/deskopoly/tests/dsk-seat-turns.pdl | $win
EXPECT_EXIT | 0 | THE-TURNS-SCRIPT-PASSES-all-28-steps-three-rounds-by-real-taps
EXPECT_OUT | ALL PASS: 28 pass, 0 fail | and-says-so
RUN | /usr/bin/grep | -cE | EVENT.[0-9]+.p1.(roll\pbuy\pend_turn). | $HOUSE/@.apps/rpg-edit-hq/state/games/deskopoly/game/ledger.txt
CAPTURE | p1rows
EXPECT_GE | $p1rows | 8 | THE-HUMAN-ACTED-p1-has-at-least-8-roll-buy-end_turn-rows-in-the-ledger
RUN | /usr/bin/grep | -c | \pp1\pbuy\p | $HOUSE/@.apps/rpg-edit-hq/state/games/deskopoly/game/ledger.txt
EXPECT_OUT_IS | 2 | and-bought-exactly-two-properties-Power-and-Orange3
RUN | /usr/bin/grep | -cE | EVENT.[0-9]+.p[23].(roll\pbuy\pend_turn). | $HOUSE/@.apps/rpg-edit-hq/state/games/deskopoly/game/ledger.txt
CAPTURE | petrows
EXPECT_GE | $petrows | 6 | and-the-pets-played-their-own-turns-in-between
RUN | /usr/bin/grep | -c | driver=human | $HOUSE/@.apps/rpg-edit-hq/state/games/deskopoly/game/ledger.txt
EXPECT_OUT_IS | 1 | NEGATIVE-the-pets-never-became-human-still-exactly-one-human-seat
RUN | $HOUSE/@.apps/deskopoly/ops/+x/deskopoly.+x | $HOUSE/@.apps/deskopoly | $HOUSE/@.apps/rpg-edit-hq/state/games/deskopoly/game | check
EXPECT_OUT | CHECK ok | the-engine-replays-the-whole-ledger-and-the-invariants-hold
RUN | $HOUSE/&.widgits/_shared-lib/ops/+x/relay_drive.+x | shot | $win | $HOUSE/@.apps/deskopoly/shots/08-after-three-rounds.png
EXPECT_EXIT | 0 | the-closing-frame-is-saved

CASE    | restore
RUN | $HOUSE/@.apps/deskopoly/ops/+x/deskopoly_ctl.+x | new_game | $HOUSE/@.apps/rpg-edit-hq/state/games/deskopoly
WAIT_HAS | $HOUSE/@.apps/rpg-edit-hq/state/games/deskopoly/../../game_ui.txt | players, then START | 10000 | the-game-is-archived-and-the-editor-is-back-on-the-setup-screen
EXPECT_NOFILE | $HOUSE/@.apps/rpg-edit-hq/state/games/deskopoly/game/ledger.txt | and-no-live-ledger-is-left
RUN | $HOUSE/&.widgits/_shared-lib/ops/+x/relay_drive.+x | $wpid | run | $HOUSE/@.apps/deskopoly/tests/dsk-in-on.pdl | $win
RESTORE | live | the-play-mode-flag-and-the-sides-file-are-byte-identical-to-before
CLEAN   |
