# edit_last.sh on a scratch house. No window. The demo is rpg-edit-hq page start.
RESULTS | ../results/edit_last.txt
CASE    | edit-last
SCRATCH |
COPY    | @.apps/rpg-edit-hq/ops/edit_last.sh | edit_last.sh
MKDIR   | house/@.apps/rpg-edit-hq
MKDIR   | house/@.apps/mcl-hq
MKDIR   | maps/rpg-edit-hq/start
WRITE   | house/@.apps/rpg-edit-hq/rooms.pdl | ROOM \p start \p Islands\nROOM \p bank \p Bank\n
WRITE   | house/@.apps/mcl-hq/rooms.pdl | ROOM \p city \p City\n
WRITE   | maps/rpg-edit-hq/start/map.txt | start\n

# missing row -> demo
RUN | sh | $T/edit_last.sh | resolve | $T/state/last_book.txt | --house | $T/house | --maps | $T/maps | --demo-book | rpg-edit-hq | --demo-page | start
EXPECT_EXIT | 0 | missing-exits-0
EXPECT_OUT | book=rpg-edit-hq page=start | missing-is-islands

# a real save reopens that book and page
RUN | sh | $T/edit_last.sh | save | $T/state/last_book.txt | --house | $T/house | --maps | $T/maps | mcl-hq | city
EXPECT_EXIT | 0 | save-mcl
EXPECT_FILE | state/last_book.txt | row-written
RUN | sh | $T/edit_last.sh | resolve | $T/state/last_book.txt | --house | $T/house | --maps | $T/maps | --demo-book | rpg-edit-hq | --demo-page | start
EXPECT_OUT | book=mcl-hq page=city | saved-reopens-mcl

# a page that is not a room is refused and the old row stays
RUN | sh | $T/edit_last.sh | save | $T/state/last_book.txt | --house | $T/house | --maps | $T/maps | rpg-edit-hq | nowhere
EXPECT_EXIT | 2 | bad-page-refused
RUN | sh | $T/edit_last.sh | resolve | $T/state/last_book.txt | --house | $T/house | --maps | $T/maps | --demo-book | rpg-edit-hq | --demo-page | start
EXPECT_OUT | book=mcl-hq page=city | refused-save-keeps-the-row

# a book that disappeared falls back to the demo
WRITE | house/@.apps/mcl-hq/rooms.pdl | ROOM \p other \p Other\n
RUN | sh | $T/edit_last.sh | resolve | $T/state/last_book.txt | --house | $T/house | --maps | $T/maps | --demo-book | rpg-edit-hq | --demo-page | start
EXPECT_OUT | book=rpg-edit-hq page=start | gone-book-is-islands

# a path is not a book id
RUN | sh | $T/edit_last.sh | save | $T/state/last_book.txt | --house | $T/house | --maps | $T/maps | ../rpg-edit-hq | start
EXPECT_EXIT | 2 | slash-refused

# 2026-11-17 (owner: "make sure the last book page opens"): nothing called save since 2026-11-08, so every relaunch fell back to a stale row. The launcher must save the page this editor has open BEFORE it resolves. Source checks (the launcher opens a window, so the wiring is checked in text; the save/resolve verbs above are the behaviour).
COPY | @.apps/rpg-edit-hq/board/open_board.sh | open_board.sh
RUN | /usr/bin/grep | -q | -F | edit_last.sh" save "$APP/state/last_book.txt" "$CURB" "$CURP" | open_board.sh
EXPECT_EXIT | 0 | the-launcher-saves-the-open-page
RUN | /usr/bin/grep | -q | -F | pieces/world_01/state.txt | open_board.sh
EXPECT_EXIT | 0 | it-reads-the-editors-own-persisted-page
RUN | /usr/bin/awk | /edit_last.sh" save/ { if (!s) s = NR } /edit_last.sh" resolve/ { if (!r) r = NR } END { exit !(s && r && s < r) } | open_board.sh
EXPECT_EXIT | 0 | save-comes-BEFORE-resolve
RUN | /usr/bin/awk | /edit_last.sh" save/ { if (!s) s = NR } /edit_last.sh" resolve/ { if (!r) r = NR } END { exit !(s && r && r < s) } | open_board.sh
EXPECT_EXIT | 1 | NEGATIVE-resolve-before-save-is-false

# 2026-11-17: the relaunch landed on centroid:test although resolve said live. CONFIRM_START_MAP regenerates the book on its default page AFTER a CONFIRM_SET_DESK sent in the same instant. The launcher must send START_MAP, wait for the book, then SET_DESK.
RUN | /usr/bin/awk | /CONFIRM_START_MAP/ { s = NR } /CONFIRM_SET_DESK/ { d = NR } END { exit !(s && d && s < d) } | open_board.sh
EXPECT_EXIT | 0 | start-map-is-sent-before-set-desk
RUN | /usr/bin/grep | -c | -F | CONFIRM_SET_DESK | open_board.sh
EXPECT_OUT | 1 | set-desk-is-its-own-write-not-in-the-START_MAP-line
RUN | /usr/bin/awk | /CONFIRM_START_MAP/ && /CONFIRM_SET_DESK/ { bad = 1 } END { exit bad } | open_board.sh
EXPECT_EXIT | 0 | no-single-line-sends-both-commands
RUN | /usr/bin/awk | /CONFIRM_START_MAP/ && /CONFIRM_SET_DESK/ { bad = 1 } END { exit !bad } | open_board.sh
EXPECT_EXIT | 1 | NEGATIVE-both-in-one-line-is-the-bug
