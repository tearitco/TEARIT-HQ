# civ_snes - the rules of civ-snes (decision D157, BOOK 16.game/CIV-SNES-2D-AND-3D-PLAN-2026-11-27.md): the ONE op civ_op, every verb alone, with a negative control and a sabotage per clause.
# Everything runs in a scratch folder under $T, never the live house. A pin is one of: HAND = forced by the scene (checked against the printed seed-4 world, not copied from the op), RULE = a number of rules.pdl, PIN = observed once from the op and kept to detect a later change.
# Seed 4 world (civ_op world 4), row 7 is "~~....T~~~...TT.^T~~": the civ1 settler u1 stands on grass 5,7 (HAND: the nearest grass to w/4,h/2), the warrior u2 on forest 6,7, water at 7,7; civ2 u3 on grass 15,7, u4 on 16,7.
RESULTS | ../results/civ_snes.txt
CASE | the-rules
SCRATCH
MKDIR | app/ops/+x
COPY | @.apps/civ-snes/rules.pdl | app/rules.pdl
COPY | @.apps/civ-snes/text.pdl | app/text.pdl
COPY | @.apps/civ-snes/state.pdl | app/state.pdl
RUN | gcc | -std=gnu11 | -Wall | -Wextra | -Werror | -O2 | -o | $T/app/ops/+x/civ_op.+x | $HOUSE/@.apps/civ-snes/ops/civ_op.c
EXPECT_EXIT | 0 | the op compiles with -Wall -Wextra -Werror
MKDIR | g
RUN | $T/app/ops/+x/civ_op.+x | - | world | 4 | small
EXPECT_OUT | ~~....T~~~...TT.^T~~ | HAND: row 7 of the seed-4 world
EXPECT_OUT | land=145 of 280 | PIN: land count of seed 4
CAPTURE | w4a
RUN | $T/app/ops/+x/civ_op.+x | - | world | 4 | small
CAPTURE | w4b
EXPECT_EQ | $w4a | $w4b | the same seed gives the same world (no clock, no rand)
RUN | $T/app/ops/+x/civ_op.+x | - | world | 5 | small
CAPTURE | w5
EXPECT_NE | $w4a | $w5 | CONTROL: another seed gives another world
# ---- new
RUN | $T/app/ops/+x/civ_op.+x | $T/g/ledger.txt | new | 4 | small
EXPECT_EXIT | 0 | new writes the start rows
EXPECT_HAS | $T/g/ledger.txt | UNIT\pu1\pciv1\psettler\p5\p7\n | HAND: the civ1 settler starts on the grass nearest w/4,h/2 = 5,7
EXPECT_HAS | $T/g/ledger.txt | UNIT\pu2\pciv1\pwarrior\p6\p7\n | HAND: the warrior starts east of the settler
EXPECT_HAS | $T/g/ledger.txt | UNIT\pu3\pciv2\psettler\p15\p7\n | HAND: the civ2 settler starts on the grass nearest 3w/4,h/2 = 15,7
EXPECT_HAS | $T/g/ledger.txt | UNIT\pu4\pciv2\pwarrior\p16\p7\n | HAND: the civ2 warrior starts east of its settler
EXPECT_HAS | $T/g/ledger.txt | SEAT\pciv2\pagent:basic\n | the rival is an agent seat, a ledger row
EXPECT_HAS | $T/g/ledger.txt | NEW\p4\p20\p14\p | the first row names the seed and the map
RUN | $T/app/ops/+x/civ_op.+x | $T/g/ledger.txt | new | 4 | small
EXPECT_EXIT | 4 | NEGATIVE-a-second-new-over-a-ledger-is-refused
RUN | $T/app/ops/+x/civ_op.+x | $T/g/ledger.txt | verify
EXPECT_EXIT | 0 | the fresh ledger replays
# ---- fog: HAND, two 3x3 windows around 5,7 and 6,7 = columns 4..7 x rows 6..8 = 12 tiles
RUN | $T/app/ops/+x/civ_op.+x | $T/g/ledger.txt | fog | civ1
EXPECT_OUT | seen=12 of 280 | HAND: 4 columns x 3 rows around the two civ1 units
EXPECT_OUT | seen=12 of 280 | HAND: the same for civ2 around 15,7 and 16,7
RUN | $T/app/ops/+x/civ_op.+x | $T/g/ledger.txt | map | civ1
EXPECT_OUT | .sw~ | the civ1 fog map shows its own settler and warrior on row 7
EXPECT_OUT_LACKS | z | CONTROL-the-rival-settler-glyph-is-not-drawn-in-the-human-fog
RUN | $T/app/ops/+x/civ_op.+x | $T/g/ledger.txt | map
EXPECT_OUT | zx | CONTROL: the all-seeing map does show the rival pieces z x (so the fog really hides them)
RUN | $T/app/ops/+x/civ_op.+x | $T/g/ledger.txt | legal | civ2
EXPECT_OUT | found u3 score=100 | RULE aiw_found: the rival settler may found where it stands, scored 100 (the agent lists legal moves, scores them from data)
# ---- move
RUN | $T/app/ops/+x/civ_op.+x | $T/g/ledger.txt | move | u1 | e
EXPECT_EXIT | 4 | NEGATIVE-a-tile-with-a-unit-is-refused
EXPECT_OUT | a unit is already there | and it says why
RUN | $T/app/ops/+x/civ_op.+x | $T/g/ledger.txt | move | u2 | e
EXPECT_EXIT | 4 | NEGATIVE-water-is-refused-for-a-land-unit
EXPECT_OUT | water | and it says why
RUN | $T/app/ops/+x/civ_op.+x | $T/g/ledger.txt | move | u2 | n
EXPECT_EXIT | 0 | the warrior steps north onto grass 6,6
EXPECT_OUT | MOVE\pu2\p6\p7\p6\p6\p1 | HAND: 6,6 is grass (row 6 index 6 is a dot), cost 1 (RULE cost_grass)
RUN | $T/app/ops/+x/civ_op.+x | $T/g/ledger.txt | move | u2 | n
EXPECT_OUT | MOVE\pu2\p6\p6\p6\p5\p1 | HAND: 6,5 is grass (row 5 "~~~.^..T.TT" index 6 is a dot), cost 1
RUN | $T/app/ops/+x/civ_op.+x | $T/g/ledger.txt | move | u2 | n
EXPECT_EXIT | 4 | NEGATIVE-no-moves-left-after-two-steps (RULE mp_warrior 2)
EXPECT_OUT | no moves left | and it says why
RUN | $T/app/ops/+x/civ_op.+x | $T/g/ledger.txt | move | u1 | e
EXPECT_EXIT | 0 | the settler (mp 1) may step into forest 6,7 (cost 2): the last step may overspend
EXPECT_OUT | MOVE\pu1\p5\p7\p6\p7\p2 | HAND: forest costs 2 (RULE cost_forest)
RUN | $T/app/ops/+x/civ_op.+x | $T/g/ledger.txt | move | u1 | e
EXPECT_EXIT | 4 | NEGATIVE-an-overspent-unit-has-no-moves
RUN | $T/app/ops/+x/civ_op.+x | $T/g/ledger.txt | move | u9 | e
EXPECT_EXIT | 4 | NEGATIVE-a-unit-that-does-not-exist
RUN | $T/app/ops/+x/civ_op.+x | $T/g/ledger.txt | move | u2 | up
EXPECT_EXIT | 4 | NEGATIVE-a-direction-that-does-not-exist
RUN | $T/app/ops/+x/civ_op.+x | $T/g/ledger.txt | fog | civ1
EXPECT_OUT | seen=18 of 280 | HAND: fog remembers: windows around 5,7 6,7 6,6 6,5 = row 4 x5-7, row 5 x5-7, rows 6 7 8 x4-7 = 3+3+4+4+4
# ---- found
RUN | $T/app/ops/+x/civ_op.+x | $T/g/ledger.txt | found | u2
EXPECT_EXIT | 4 | NEGATIVE-a-warrior-cannot-found
RUN | $T/app/ops/+x/civ_op.+x | $T/g/ledger.txt | found | u1
EXPECT_EXIT | 0 | the settler founds a city on forest 6,7
EXPECT_OUT | FOUND\pu1\pc1\p6\p7 | the city is c1 on the settler's tile
RUN | $T/app/ops/+x/civ_op.+x | $T/g/ledger.txt | move | u1 | w
EXPECT_EXIT | 4 | NEGATIVE-the-settler-is-gone-once-it-founded
RUN | $T/app/ops/+x/civ_op.+x | $T/g/ledger.txt | cities
EXPECT_OUT | city c1 civ1 6 7 size=1 build=warrior stock=0 | the city is a fold of the FOUND row (default_build 1 = warrior)
# ---- build
RUN | $T/app/ops/+x/civ_op.+x | $T/g/ledger.txt | build | c1 | warrior
EXPECT_EXIT | 4 | NEGATIVE-already-building-that
RUN | $T/app/ops/+x/civ_op.+x | $T/g/ledger.txt | build | c1 | pikeman
EXPECT_EXIT | 4 | NEGATIVE-an-unknown-kind
RUN | $T/app/ops/+x/civ_op.+x | $T/g/ledger.txt | build | c9 | settler
EXPECT_EXIT | 4 | NEGATIVE-a-city-that-does-not-exist
RUN | $T/app/ops/+x/civ_op.+x | $T/g/ledger.txt | build | c1 | settler
EXPECT_EXIT | 0 | the city switches to settlers
EXPECT_OUT | BUILD\pc1\psettler | a BUILD row
# ---- endturn: production, births, fresh move points
RUN | $T/app/ops/+x/civ_op.+x | $T/g/ledger.txt | endturn
EXPECT_EXIT | 0 | end turn
EXPECT_OUT | TURN\p1 ; PROD\pc1\p1\p1 ; AGENT\pciv2\pfound\pu3 ; FOUND\pu3\pc2\p15\p7 | HAND: a city on forest 6,7 (the city 6,7 has one rough neighbour, forest 5,6: 1 divided by rough_div 3 is 0, so 1 shield a turn = city_shields); the rival settler founds at once (aiw_found 100 beats any move)
RUN | $T/app/ops/+x/civ_op.+x | $T/g/ledger.txt | move | u2 | n
EXPECT_EXIT | 0 | move points came back at the turn (mp 2 again)
RUN | $T/app/ops/+x/civ_op.+x | $T/g/ledger.txt | status
EXPECT_OUT | turn=1 cities=1/1 units=1/ | one civ1 city, one civ2 city, one civ1 unit left (the settler became the city)
# ---- the rival (agent) sees only what its fog shows and does something every turn
RUN | $T/app/ops/+x/civ_op.+x | $T/g/ledger.txt | seat | civ2 | robot
EXPECT_EXIT | 4 | NEGATIVE-an-unknown-driver-is-refused
RUN | $T/app/ops/+x/civ_op.+x | $T/g/ledger.txt | seat | civ3 | human
EXPECT_EXIT | 4 | NEGATIVE-a-third-civ-is-refused
RUN | $T/app/ops/+x/civ_op.+x | $T/g/ledger.txt | seat | civ2 | human
EXPECT_EXIT | 0 | a seat swap is a ledger row
RUN | $T/app/ops/+x/civ_op.+x | $T/g/ledger.txt | endturn
EXPECT_OUT_LACKS | AGENT | CONTROL: with civ2 on a human seat the turn writes no agent row
RUN | $T/app/ops/+x/civ_op.+x | $T/g/ledger.txt | verify
EXPECT_EXIT | 0 | the whole played ledger replays
# ---- ledger integrity (a forged copy is refused with 14, the original is untouched)
RUN | cp | $T/g/ledger.txt | $T/f1.txt
RUN | sed | -i | s/MOVE\pu2\p6\p7\p6\p6\p1/MOVE\pu2\p6\p7\p6\p6\p7/ | $T/f1.txt
RUN | $T/app/ops/+x/civ_op.+x | $T/f1.txt | verify
EXPECT_EXIT | 14 | NEGATIVE-a-hand-edited-move-cost-is-refused
RUN | cp | $T/g/ledger.txt | $T/f2.txt
RUN | sed | -i | s/PROD\pc1\p1\p1/PROD\pc1\p1\p9/ | $T/f2.txt
RUN | $T/app/ops/+x/civ_op.+x | $T/f2.txt | verify
EXPECT_EXIT | 14 | NEGATIVE-a-hand-edited-production-stock-is-refused
RUN | cp | $T/g/ledger.txt | $T/f3.txt
RUN | sed | -i | 3d | $T/f3.txt
RUN | $T/app/ops/+x/civ_op.+x | $T/f3.txt | verify
EXPECT_EXIT | 14 | NEGATIVE-a-deleted-start-row-is-refused
RUN | cp | $T/g/ledger.txt | $T/f4.txt
APPEND | f4.txt | MOVE\pu2\p5\p5\p6\p5\p1\n
RUN | $T/app/ops/+x/civ_op.+x | $T/f4.txt | verify
EXPECT_EXIT | 14 | NEGATIVE-a-forged-move-appended-by-hand-is-refused (u2 is not at 5,5 any more)
RUN | cp | $T/g/ledger.txt | $T/f5.txt
APPEND | f5.txt | GIVE\pu2\pgold\p99\n
RUN | $T/app/ops/+x/civ_op.+x | $T/f5.txt | verify
EXPECT_EXIT | 14 | NEGATIVE-an-unknown-row-is-refused
RUN | cp | $T/g/ledger.txt | $T/f6.txt
APPEND | f6.txt | TURN\p9\n
RUN | $T/app/ops/+x/civ_op.+x | $T/f6.txt | verify
EXPECT_EXIT | 14 | NEGATIVE-a-turn-out-of-order-is-refused
RUN | $T/app/ops/+x/civ_op.+x | $T/f1.txt | move | u2 | n
EXPECT_EXIT | 14 | NEGATIVE-no-verb-runs-on-a-refused-ledger
SUMTREE | before | g
RUN | $T/app/ops/+x/civ_op.+x | $T/g/ledger.txt | move | u1 | n
SUMTREE | after | g
EXPECT_EQ | $before | $after | a refused verb appends nothing (the ledger folder hash is unchanged)
# rules edited after the game began: the hash in the NEW row
MKDIR | app2/ops/+x
COPY | @.apps/civ-snes/rules.pdl | app2/rules.pdl
COPY | @.apps/civ-snes/text.pdl | app2/text.pdl
RUN | cp | $T/app/ops/+x/civ_op.+x | $T/app2/ops/+x/civ_op.+x
RUN | $T/app2/ops/+x/civ_op.+x | $T/g/ledger.txt | verify
EXPECT_EXIT | 0 | CONTROL: the same rules in another folder verify the ledger
RUN | sed | -i | s/citygap \p 3/citygap \p 4/ | $T/app2/rules.pdl
RUN | $T/app2/ops/+x/civ_op.+x | $T/g/ledger.txt | verify
EXPECT_EXIT | 14 | NEGATIVE-a-changed-RULE-number-refuses-the-ledger
EXPECT_OUT | rules.pdl changed after the game began | and the refusal names the cause (the hash clause, not only the derived-row compare of the NEW row)
RUN | grep | -c | citygap . 4 | $T/app2/rules.pdl
EXPECT_OUT | 1 | the edit really changed the rules file (so the refusal is the hash)
# ---- ghost data: a file beside the ledger changes nothing; the audit finds it
RUN | $T/app/ops/+x/civ_op.+x | $T/g/ledger.txt | status
CAPTURE | st1
WRITE | g/stray.txt | the game must not read this
RUN | $T/app/ops/+x/civ_op.+x | $T/g/ledger.txt | status
CAPTURE | st2
EXPECT_EQ | $st1 | $st2 | a stray file beside the ledger changes nothing
RUN | $T/app/ops/+x/civ_op.+x | $T/g/ledger.txt | audit | $T/g | $T/app/state.pdl
EXPECT_EXIT | 4 | the audit finds the undeclared file
EXPECT_OUT | undeclared: stray.txt | and names it
RUN | rm | $T/g/stray.txt
RUN | $T/app/ops/+x/civ_op.+x | $T/g/ledger.txt | audit | $T/g | $T/app/state.pdl
EXPECT_EXIT | 0 | CONTROL: the audit of a clean state folder passes
# ---- projection: one desk for the 2D and the 3D board; deleted, it regenerates byte for byte
RUN | $T/app/ops/+x/civ_op.+x | $T/g/ledger.txt | project | civ1 | $T/d
EXPECT_EXIT | 0 | project writes the desk
EXPECT_HAS | $T/d/cells.txt | width=20\nheight=14\ntile_px=16\natlas_cols=1\natlas_tiles=10\ncells\n | the desk header
EXPECT_HAS | $T/d/extrusion.pdl | EXTRUDE \p M \p 5 | mountains stand tall in the 3D view
EXPECT_HAS | $T/d/cells.txt | 6,0 | the human city is its own tile
SUMTREE | d1 | d
RUN | rm | -r | $T/d
RUN | $T/app/ops/+x/civ_op.+x | $T/g/ledger.txt | project | civ1 | $T/d
SUMTREE | d2 | d
EXPECT_EQ | $d1 | $d2 | deleted projections regenerate identical bytes
RUN | $T/app/ops/+x/civ_op.+x | $T/g/ledger.txt | project | civ1 | $T/d
SUMTREE | d3 | d
EXPECT_NE | $d1 | $d3 | CONTROL: re-projecting WITHOUT deleting grows cells.marker (the engine reloads on a size change), so it is declared and not byte-identical
RUN | $T/app/ops/+x/civ_op.+x | $T/g/ledger.txt | project | civ1 | $T/dall
RUN | $T/app/ops/+x/civ_op.+x | $T/g/ledger.txt | project | all | $T/dall
RUN | grep | -c | block | $T/d/events.txt
EXPECT_OUT | 1 | the human sees only its own warrior piece (the settler is a city, the rival is hidden by the fog)
RUN | grep | -c | block | $T/dall/events.txt
EXPECT_OUT | 2 | CONTROL: the all-seeing projection draws both living units (civ1 warrior u2, civ2 warrior u4; the two settlers became cities)
# ================= SABOTAGE: every clause broken on purpose must turn a scene red (STANDARD-RULES-AS-OPS sections 13 to 15). Each mutant is the real source with ONE sed edit; the scene is the same command the real op answered above, and the answer must DIFFER.
# ---- the rival is deterministic, and its weights are data
MKDIR | da
MKDIR | db
RUN | $T/app/ops/+x/civ_op.+x | $T/da/ledger.txt | new | 4 | small
RUN | $T/app/ops/+x/civ_op.+x | $T/da/ledger.txt | endturn
RUN | $T/app/ops/+x/civ_op.+x | $T/da/ledger.txt | endturn
RUN | $T/app/ops/+x/civ_op.+x | $T/db/ledger.txt | new | 4 | small
RUN | $T/app/ops/+x/civ_op.+x | $T/db/ledger.txt | endturn
RUN | $T/app/ops/+x/civ_op.+x | $T/db/ledger.txt | endturn
SUMTREE | sa | da
SUMTREE | sb | db
EXPECT_EQ | $sa | $sb | the same seed and the same verbs give the same ledger bytes, rival included (no clock, no rand)
RUN | grep | -c | FOUND.u3.c1.15.7 | $T/da/ledger.txt
EXPECT_OUT | 1 | HAND: on turn 1 the rival settler founds a city where it stands, 15,7 (aiw_found 100 beats every move score)
MKDIR | w0/ops/+x
COPY | @.apps/civ-snes/rules.pdl | w0/rules.pdl
COPY | @.apps/civ-snes/text.pdl | w0/text.pdl
RUN | cp | $T/app/ops/+x/civ_op.+x | $T/w0/ops/+x/civ_op.+x
RUN | sed | -i | s/aiw_found \p 100/aiw_found \p 0/ | $T/w0/rules.pdl
RUN | grep | -c | aiw_found . 0 | $T/w0/rules.pdl
EXPECT_OUT | 1 | the edit really changed the weight
RUN | $T/w0/ops/+x/civ_op.+x | $T/w0/ledger.txt | new | 4 | small
RUN | $T/w0/ops/+x/civ_op.+x | $T/w0/ledger.txt | endturn
EXPECT_OUT_LACKS | FOUND | the weights are DATA: with aiw_found 0 the rival does not found on turn 1 (it walks instead)
EXPECT_OUT | AGENT\pciv2\pmove | and it still does something (the agent lists the legal moves and plays the best)
# ---- M1 the city gap: a settler born in the capital walks away; real founds at distance 3 and refuses at 2
MKDIR | sc1/ops/+x
COPY | @.apps/civ-snes/rules.pdl | sc1/rules.pdl
COPY | @.apps/civ-snes/text.pdl | sc1/text.pdl
RUN | sed | -i | s/cost_settler \p 5/cost_settler \p 1/ | $T/sc1/rules.pdl
RUN | sed | -i | s/default_build \p 1/default_build \p 0/ | $T/sc1/rules.pdl
RUN | sed | -i | s/mp_settler \p 1/mp_settler \p 6/ | $T/sc1/rules.pdl
RUN | cp | $T/app/ops/+x/civ_op.+x | $T/sc1/ops/+x/civ_op.+x
RUN | $T/sc1/ops/+x/civ_op.+x | $T/sc1/ledger.txt | new | 4 | small
RUN | $T/sc1/ops/+x/civ_op.+x | $T/sc1/ledger.txt | found | u1
EXPECT_OUT | FOUND\pu1\pc1\p5\p7 | the capital at 5,7
RUN | $T/sc1/ops/+x/civ_op.+x | $T/sc1/ledger.txt | endturn
EXPECT_OUT | BORN\pu5\pciv1\psettler\p5\p7 | RULE cost_settler 1 and default_build settler: a settler is born in the capital at once
RUN | $T/sc1/ops/+x/civ_op.+x | $T/sc1/ledger.txt | found | u5
EXPECT_EXIT | 4 | NEGATIVE-founding-on-the-capital-tile-is-refused-(distance-0)
RUN | $T/sc1/ops/+x/civ_op.+x | $T/sc1/ledger.txt | move | u5 | w
RUN | $T/sc1/ops/+x/civ_op.+x | $T/sc1/ledger.txt | move | u5 | w
RUN | $T/sc1/ops/+x/civ_op.+x | $T/sc1/ledger.txt | found | u5
EXPECT_EXIT | 4 | NEGATIVE-founding-at-Manhattan-distance-2-is-refused (RULE citygap 3)
RUN | $T/sc1/ops/+x/civ_op.+x | $T/sc1/ledger.txt | move | u5 | w
RUN | cp | $T/sc1/ledger.txt | $T/sc1/at3.txt
RUN | $T/sc1/ops/+x/civ_op.+x | $T/sc1/ledger.txt | found | u5
EXPECT_EXIT | 0 | at distance 3 it founds (the gap is "closer than 3", not "3 or closer")
MKDIR | m1/ops/+x
RUN | cp | $T/sc1/rules.pdl | $T/m1/rules.pdl
COPY | @.apps/civ-snes/text.pdl | m1/text.pdl
COPY | @.apps/civ-snes/ops/civ_op.c | m1/civ_op.c
RUN | sed | -i | s/ < rule("citygap")) return refuse/ <= rule("citygap")) return refuse/ | $T/m1/civ_op.c
RUN | cmp | -s | $HOUSE/@.apps/civ-snes/ops/civ_op.c | $T/m1/civ_op.c
EXPECT_EXIT | 1 | SABOTAGE m1: the mutant source differs from the real source (the sed matched)
RUN | gcc | -std=gnu11 | -w | -O2 | -o | $T/m1/ops/+x/civ_op.+x | $T/m1/civ_op.c
EXPECT_EXIT | 0 | SABOTAGE m1: the mutant compiles
RUN | cp | $T/app/ops/+x/civ_op.+x | $T/sc1/x.+x
RUN | $T/m1/ops/+x/civ_op.+x | $T/sc1/at3.txt | found | u5
EXPECT_EXIT | 4 | SABOTAGE m1 CAUGHT: with <= the same founding at distance 3 is refused (the real op: exit 0)
# ---- M2 water: the warrior walks into the sea only without the clause
MKDIR | m2/ops/+x
COPY | @.apps/civ-snes/rules.pdl | m2/rules.pdl
COPY | @.apps/civ-snes/text.pdl | m2/text.pdl
COPY | @.apps/civ-snes/ops/civ_op.c | m2/civ_op.c
RUN | sed | -i | s/if (k == WATER) return refuse("water: land units cannot enter");// | $T/m2/civ_op.c
RUN | cmp | -s | $HOUSE/@.apps/civ-snes/ops/civ_op.c | $T/m2/civ_op.c
EXPECT_EXIT | 1 | SABOTAGE m2: the mutant source differs from the real source (the sed matched)
RUN | gcc | -std=gnu11 | -w | -O2 | -o | $T/m2/ops/+x/civ_op.+x | $T/m2/civ_op.c
EXPECT_EXIT | 0 | SABOTAGE m2: the mutant compiles
RUN | $T/m2/ops/+x/civ_op.+x | $T/m2/ledger.txt | new | 4 | small
RUN | $T/m2/ops/+x/civ_op.+x | $T/m2/ledger.txt | move | u2 | e
EXPECT_EXIT | 0 | SABOTAGE m2 CAUGHT: without the water clause the warrior steps onto 7,7 (the real op: exit 4)
# ---- M3 stacking
MKDIR | m3/ops/+x
COPY | @.apps/civ-snes/rules.pdl | m3/rules.pdl
COPY | @.apps/civ-snes/text.pdl | m3/text.pdl
COPY | @.apps/civ-snes/ops/civ_op.c | m3/civ_op.c
RUN | sed | -i | s/if (unit_at(W, nx, ny)) return refuse("a unit is already there");// | $T/m3/civ_op.c
RUN | cmp | -s | $HOUSE/@.apps/civ-snes/ops/civ_op.c | $T/m3/civ_op.c
EXPECT_EXIT | 1 | SABOTAGE m3: the mutant source differs from the real source (the sed matched)
RUN | gcc | -std=gnu11 | -w | -O2 | -o | $T/m3/ops/+x/civ_op.+x | $T/m3/civ_op.c
