# civ_snes_tutorial - lesson 1 of civ-snes as a STRANGER (D157, the shape of rmmc_stranger / D146): a person who only reads what the screen says finishes it. Each step: (1) the lesson op must SAY the step (label + sentence), (2) the case does the
# thing the sentence NAMES through the verb the key maps to in keys.pdl (a stranger does not read config: the case reads the KEY WORD in the sentence, "arrow", "B", "2", "Space", and maps it to the verb by its own table below), (3) the next step must appear.
# The grade is DERIVED from the ledger (no stored progress). Not covered here: that the editor draws the three left-bar lines and that the key reaches the driver (no driver yet; the live window is the owner's and the debil editor run is NOT DONE).
RESULTS | ../results/civ_snes_tutorial.txt
CASE | a-stranger-finishes-lesson-1-from-the-words-only
SCRATCH
MKDIR | app/ops/+x
MKDIR | #.NNEST_ASSETS/rta-sources/earth-moth
RUN | sh | -c | for d in "$HOUSE/../../../#.NNEST_ASSETS" "$HOUSE/../../#.NNEST_ASSETS"; do if [ -f "$d/rta-sources/earth-moth/ETOPO5.DAT" ]; then ln -s "$d/rta-sources/earth-moth/ETOPO5.DAT" "$T/#.NNEST_ASSETS/rta-sources/earth-moth/ETOPO5.DAT"; fi; done
COPY | @.apps/civ-snes/rules.pdl | app/rules.pdl
COPY | @.apps/civ-snes/text.pdl | app/text.pdl
COPY | @.apps/civ-snes/tutorial.pdl | app/tutorial.pdl
COPY | @.apps/civ-snes/keys.pdl | app/keys.pdl
RUN | gcc | -std=gnu11 | -Wall | -Wextra | -Werror | -O2 | -o | $T/app/ops/+x/civ_op.+x | $HOUSE/@.apps/civ-snes/ops/civ_op.c
EXPECT_EXIT | 0 | the op compiles
# ---- step 1 is the SETUP (owner 2026-11-27): before any ledger exists the lesson says "Space: start"; choosing options does not pass it; only the NEW row (start) does
RUN | $T/app/ops/+x/civ_op.+x | $T/pre.txt | lesson | $T/app/tutorial.pdl | civ1
EXPECT_OUT | step=1/5 | with NO ledger the lesson is at step 1 (the setup)
EXPECT_OUT | label=1/5 Space: start | the bar names the key
EXPECT_OUT | goal=Arrows pick options. Space starts. | and the sentence names the arrows and Space (the words a stranger reads)
RUN | $T/app/ops/+x/civ_op.+x | - | setup | $T/pre_draft.txt | next
RUN | $T/app/ops/+x/civ_op.+x | - | setup | $T/pre_draft.txt | inc
EXPECT_OUT | stat_line=Map: earth | the stranger pressed Down then Right: the Map option changed
RUN | $T/app/ops/+x/civ_op.+x | $T/pre.txt | lesson | $T/app/tutorial.pdl | civ1
EXPECT_OUT | step=1/5 | CONTROL: choosing options alone does not pass the setup step (no ledger row yet)
RUN | $T/app/ops/+x/civ_op.+x | - | setup | $T/pre_draft.txt | inc
RUN | $T/app/ops/+x/civ_op.+x | - | setup | $T/pre_draft.txt | prev
RUN | $T/app/ops/+x/civ_op.+x | - | setup | $T/pre_draft.txt | dec
RUN | $T/app/ops/+x/civ_op.+x | - | setup | $T/pre_draft.txt | next
RUN | $T/app/ops/+x/civ_op.+x | $T/pre.txt | start | $T/pre_draft.txt
EXPECT_EXIT | 0 | Space = start: one NEW row
RUN | $T/app/ops/+x/civ_op.+x | $T/pre.txt | lesson | $T/app/tutorial.pdl | civ1
EXPECT_OUT | step=2/5 | after the NEW row the bar moves on to the walk step
EXPECT_OUT | label=2/5 arrows: step | the next label
RUN | $T/app/ops/+x/civ_op.+x | $T/l.txt | new | 4 | small
RUN | $T/app/ops/+x/civ_op.+x | $T/l.txt | lesson | $T/app/tutorial.pdl | civ1
EXPECT_OUT | label=2/5 arrows: step | step 1: the bar says what to do (label)
EXPECT_OUT | goal=Press an arrow to walk one step. | and the sentence names the key
RUN | $T/app/ops/+x/civ_op.+x | $T/l.txt | ui | civ1
EXPECT_OUT | next=Next: press M for a unit | the side panel's NEXT line at the very start (the settler is not selected yet)
RUN | $T/app/ops/+x/civ_op.+x | $T/l.txt | ui | civ1 | u1
EXPECT_OUT | stat_line=u1 settler  moves 1 | once u1 is picked the bar says what it is and its moves
EXPECT_OUT | next=Next: press B to found | the NEXT line for a settler on open land
# a lesson step that is not done stays put: pressing the wrong thing changes nothing (CONTROL)
RUN | $T/app/ops/+x/civ_op.+x | $T/l.txt | endturn
RUN | $T/app/ops/+x/civ_op.+x | $T/l.txt | lesson | $T/app/tutorial.pdl | civ1
EXPECT_OUT | step=2/5 | CONTROL: ending the turn first does not skip the walk step (the grade is the rows, each step its own row kind)
# the key mapping the sentences name
RUN | grep | -c | ^KEYVERB \p up *\p move *\p n$ | $T/app/keys.pdl
EXPECT_OUT | 1 | the arrow key is bound to move
RUN | grep | -c | ^KEYVERB \p b *\p found | $T/app/keys.pdl
EXPECT_OUT | 1 | B is bound to found
RUN | grep | -c | ^KEYVERB \p 2 *\p build *\p settler | $T/app/keys.pdl
EXPECT_OUT | 1 | 2 is bound to build settler
RUN | grep | -c | ^KEYVERB \p space *\p endturn | $T/app/keys.pdl
EXPECT_OUT | 1 | Space is bound to endturn
# step 1: an arrow
RUN | $T/app/ops/+x/civ_op.+x | $T/l.txt | move | u1 | n
EXPECT_EXIT | 0 | an arrow walked the settler north
RUN | $T/app/ops/+x/civ_op.+x | $T/l.txt | lesson | $T/app/tutorial.pdl | civ1
EXPECT_OUT | label=3/5 B: found city | step 2: the bar moved on
# step 2: B
RUN | $T/app/ops/+x/civ_op.+x | $T/l.txt | found | u1
EXPECT_EXIT | 0 | B founded the city
RUN | $T/app/ops/+x/civ_op.+x | $T/l.txt | lesson | $T/app/tutorial.pdl | civ1
EXPECT_OUT | label=4/5 2: make settler | step 3
# step 3: the digit 2
RUN | $T/app/ops/+x/civ_op.+x | $T/l.txt | build | c2 | settler
EXPECT_EXIT | 0 | 2 made the city build a settler
RUN | $T/app/ops/+x/civ_op.+x | $T/l.txt | lesson | $T/app/tutorial.pdl | civ1
EXPECT_OUT | label=5/5 Space: end turn | step 4
EXPECT_OUT | done=0 | and it is not finished yet
# step 4: Space
RUN | $T/app/ops/+x/civ_op.+x | $T/l.txt | endturn
RUN | $T/app/ops/+x/civ_op.+x | $T/l.txt | lesson | $T/app/tutorial.pdl | civ1
EXPECT_OUT | label=lesson done! | the bar says lesson done
EXPECT_OUT | done=1 | finished
RUN | $T/app/ops/+x/civ_op.+x | $T/l.txt | ui | civ1
EXPECT_OUT | next=Move, or Space ends turn | after the lesson the panel keeps naming the next thing (the warrior still has moves)
# NEGATIVES on the grader: a stranger who walks and ends the turn but never founds stays on step 2
RUN | $T/app/ops/+x/civ_op.+x | $T/m.txt | new | 4 | small
RUN | $T/app/ops/+x/civ_op.+x | $T/m.txt | move | u1 | n
RUN | $T/app/ops/+x/civ_op.+x | $T/m.txt | endturn
RUN | $T/app/ops/+x/civ_op.+x | $T/m.txt | lesson | $T/app/tutorial.pdl | civ1
EXPECT_OUT | step=3/5 | NEGATIVE-ending-the-turn-without-founding-does-not-pass-the-found-step-or-the-turn-step
# fit: every label and sentence fits the bar
WRITE | app/long.pdl | RULE \p label_max \p 20\nLESSON \p l \p long\nSTEP \p a \p this label is far too long for the bar \p x \p moved \p 1\n
RUN | $T/app/ops/+x/civ_op.+x | $T/l.txt | lesson | $T/app/long.pdl | civ1
EXPECT_EXIT | 4 | NEGATIVE-a-label-longer-than-the-bar-is-refused
RUN | $T/app/ops/+x/civ_op.+x | $T/l.txt | lesson | $T/app/tutorial.pdl | civ1
EXPECT_EXIT | 0 | CONTROL: the real lesson fits (labels 20, sentences 40, two bar lines)
# keys: the camera keys Y U I O P (D152) are never bound to a game verb
RUN | grep | -c | -i | ^KEYVERB \p [yuiop] *\p | $T/app/keys.pdl
EXPECT_OUT | 0 | the camera keys y u i o p are not bound to game verbs
RUN | grep | -c | -i | ^KEYVERB \p [b] *\p | $T/app/keys.pdl
EXPECT_OUT | 1 | CONTROL: the same grep finds the bound key b (so the zero above can fail)
# ---- the real grader on a scene where the TURN came BEFORE the city: the turn step must stay open
RUN | $T/app/ops/+x/civ_op.+x | $T/n.txt | new | 4 | small
RUN | $T/app/ops/+x/civ_op.+x | $T/n.txt | move | u1 | n
RUN | $T/app/ops/+x/civ_op.+x | $T/n.txt | endturn
RUN | $T/app/ops/+x/civ_op.+x | $T/n.txt | found | u1
RUN | $T/app/ops/+x/civ_op.+x | $T/n.txt | build | c2 | settler
RUN | $T/app/ops/+x/civ_op.+x | $T/n.txt | lesson | $T/app/tutorial.pdl | civ1
EXPECT_OUT | label=5/5 Space: end turn | HAND: moved, found and build are done; the only TURN row is BEFORE the FOUND row, so step 4 is still open
# ---- SABOTAGE: every TURN row counts (no anchor on the city)
MKDIR | lm1/ops/+x
COPY | @.apps/civ-snes/rules.pdl | lm1/rules.pdl
COPY | @.apps/civ-snes/text.pdl | lm1/text.pdl
COPY | @.apps/civ-snes/ops/civ_op.c | lm1/civ_op.c
RUN | sed | -i | s/\*found_at >= 0 \&\& i > \*found_at) n++/1) n++/ | $T/lm1/civ_op.c
RUN | cmp | -s | $HOUSE/@.apps/civ-snes/ops/civ_op.c | $T/lm1/civ_op.c
EXPECT_EXIT | 1 | SABOTAGE lm1: the mutant source differs from the real source (the sed matched)
RUN | gcc | -std=gnu11 | -w | -O2 | -o | $T/lm1/ops/+x/civ_op.+x | $T/lm1/civ_op.c
EXPECT_EXIT | 0 | SABOTAGE lm1: the mutant compiles
RUN | $T/lm1/ops/+x/civ_op.+x | $T/n.txt | lesson | $T/app/tutorial.pdl | civ1
EXPECT_OUT | done=1 | SABOTAGE lm1 CAUGHT: with any TURN counting, the lesson finishes without a turn after the city (the real op: step 5/5, done=0)
# ---- SABOTAGE: a step is done with zero rows
MKDIR | lm2/ops/+x
COPY | @.apps/civ-snes/rules.pdl | lm2/rules.pdl
COPY | @.apps/civ-snes/text.pdl | lm2/text.pdl
COPY | @.apps/civ-snes/ops/civ_op.c | lm2/civ_op.c
RUN | sed | -i | s/return n >= (isdigit((unsigned char)arg\[0\]) ? atoi(arg) : 1);/return n >= 0;/ | $T/lm2/civ_op.c
RUN | cmp | -s | $HOUSE/@.apps/civ-snes/ops/civ_op.c | $T/lm2/civ_op.c
EXPECT_EXIT | 1 | SABOTAGE lm2: the mutant source differs from the real source (the sed matched)
RUN | gcc | -std=gnu11 | -w | -O2 | -o | $T/lm2/ops/+x/civ_op.+x | $T/lm2/civ_op.c
EXPECT_EXIT | 0 | SABOTAGE lm2: the mutant compiles
RUN | $T/lm2/ops/+x/civ_op.+x | $T/l.txt | lesson | $T/app/tutorial.pdl | civ1
EXPECT_OUT | done=1 | SABOTAGE lm2 CAUGHT: with a grader that needs no rows the lesson is done on the final ledger (so also at the start; the real op shows step 1 on a fresh game, shown above)
RUN | $T/lm2/ops/+x/civ_op.+x | $T/f.txt | new | 4 | small
RUN | $T/lm2/ops/+x/civ_op.+x | $T/f.txt | lesson | $T/app/tutorial.pdl | civ1
EXPECT_OUT | done=1 | SABOTAGE lm2 CAUGHT at the start: a fresh game is already done (the real op: step=2/5, shown above)
# ---- SABOTAGE ls1: a grader whose "started" check is always true skips the setup step
MKDIR | ls1/ops/+x
COPY | @.apps/civ-snes/rules.pdl | ls1/rules.pdl
COPY | @.apps/civ-snes/text.pdl | ls1/text.pdl
COPY | @.apps/civ-snes/tutorial.pdl | ls1/tutorial.pdl
COPY | @.apps/civ-snes/ops/civ_op.c | ls1/civ_op.c
RUN | sed | -i | s/if (!strcmp(check, "started")) return g_n >= 1;/if (!strcmp(check, "started")) return 1;/ | $T/ls1/civ_op.c
RUN | cmp | -s | $HOUSE/@.apps/civ-snes/ops/civ_op.c | $T/ls1/civ_op.c
EXPECT_EXIT | 1 | SABOTAGE ls1: the mutant source differs (the sed matched)
RUN | gcc | -std=gnu11 | -w | -O2 | -o | $T/ls1/ops/+x/civ_op.+x | $T/ls1/civ_op.c
EXPECT_EXIT | 0 | SABOTAGE ls1: compiles
RUN | $T/ls1/ops/+x/civ_op.+x | $T/none.txt | lesson | $T/ls1/tutorial.pdl | civ1
EXPECT_OUT | step=2/5 | SABOTAGE ls1 CAUGHT: with no ledger the setup step is skipped (the real op: step=1/5, shown above)
# ================= A STRANGER GETS THROUGH THE SETUP FROM THE SCREEN'S WORDS ONLY (owner 2026-11-28): the screen says "Up/Down pick, Left/Right change, Space starts"; the stranger presses what it names, reads each option name on the screen, picks civ, size, difficulty, rivals and the earth map, presses Space, and the NEW row records exactly those choices. HYPOTHESIS written before the run: (a) every key word on the screen has a key in keys.pdl, (b) Down shows the six option names in order, (c) the picked values appear as words on the screen, (d) the NEW row carries them, (e) a screen without a key word, or a keys.pdl without the key, FAILS at that step.
RUN | grep | -c | -E | ^TEXT +[\p] +setup_next +[\p] +Up/Down.*Left/Right.*Space | $T/app/text.pdl
EXPECT_OUT | 1 | the setup sentence names Up/Down, Left/Right and Space
RUN | grep | -c | -E | ^SETUPKEY +[\p] +(up\pdown\pleft\pright\pspace) +[\p] | $T/app/keys.pdl
EXPECT_OUT | 5 | each word on the screen is a real key (up down left right space)
RUN | $T/app/ops/+x/civ_op.+x | - | setup | $T/st_draft.txt | show
EXPECT_OUT | next=Up/Down pick, Left/Right change, Space starts | the screen shows the sentence
EXPECT_OUT | stat_line=Size: | the first screen line names the option Size
RUN | $T/app/ops/+x/civ_op.+x | - | setup | $T/st_draft.txt | dec
RUN | $T/app/ops/+x/civ_op.+x | - | setup | $T/st_draft.txt | dec
EXPECT_OUT | stat_line=Size: small 20x14 | Left twice: large to medium to small, read on the screen
RUN | $T/app/ops/+x/civ_op.+x | - | setup | $T/st_draft.txt | next
EXPECT_OUT | stat_line=Map: random | Down: the screen now says Map
RUN | $T/app/ops/+x/civ_op.+x | - | setup | $T/st_draft.txt | inc
EXPECT_OUT | stat_line=Map: earth | Right: earth
RUN | $T/app/ops/+x/civ_op.+x | - | setup | $T/st_draft.txt | next
EXPECT_OUT | stat_line=Difficulty: | Down: Difficulty
RUN | $T/app/ops/+x/civ_op.+x | - | setup | $T/st_draft.txt | inc
EXPECT_OUT | stat_line=Difficulty: hard | Right: hard
RUN | $T/app/ops/+x/civ_op.+x | - | setup | $T/st_draft.txt | next
EXPECT_OUT | stat_line=Rivals: | Down: Rivals
RUN | $T/app/ops/+x/civ_op.+x | - | setup | $T/st_draft.txt | inc
EXPECT_OUT | stat_line=Rivals: 2 | Right: 2 rivals
RUN | $T/app/ops/+x/civ_op.+x | - | setup | $T/st_draft.txt | next
EXPECT_OUT | stat_line=Civ: Romans | Down: Civ (the default Romans)
RUN | $T/app/ops/+x/civ_op.+x | - | setup | $T/st_draft.txt | inc
EXPECT_OUT | stat_line=Civ: Egyptians | Right: Egyptians
RUN | $T/app/ops/+x/civ_op.+x | - | setup | $T/st_draft.txt | next
EXPECT_OUT | stat_line=Seed: | Down: Seed (the sixth and last option)
RUN | $T/app/ops/+x/civ_op.+x | $T/st.txt | start | $T/st_draft.txt
EXPECT_EXIT | 0 | Space starts the game
RUN | grep | -c | -E | ^NEW.*[\p]small[\p]hard[\p]2[\p]earth[\p] | $T/st.txt
EXPECT_OUT | 1 | the NEW row carries exactly what the stranger saw: small, hard, 2 rivals, earth
RUN | $T/app/ops/+x/civ_op.+x | $T/st.txt | lesson | $T/app/tutorial.pdl | civ1
EXPECT_OUT | step=2/5 | and the lesson moves on to the walk step
MKDIR | smut
COPY | @.apps/civ-snes/text.pdl | smut/text.pdl
COPY | @.apps/civ-snes/keys.pdl | smut/keys.pdl
RUN | sed | -i | s#, Space starts##;s#, Left/Right change## | $T/smut/text.pdl
RUN | cmp | -s | $HOUSE/@.apps/civ-snes/text.pdl | $T/smut/text.pdl
EXPECT_EXIT | 1 | SABOTAGE st1: the mutant text differs (the sed matched)
RUN | grep | -c | -E | ^TEXT +[\p] +setup_next +[\p] +Up/Down.*Left/Right.*Space | $T/smut/text.pdl
EXPECT_OUT | 0 | SABOTAGE st1 CAUGHT: a screen that does not name Space and Left/Right fails the stranger at the sentence step (the real text: 1)
RUN | sed | -i | /^SETUPKEY [\p] down /d | $T/smut/keys.pdl
RUN | cmp | -s | $HOUSE/@.apps/civ-snes/keys.pdl | $T/smut/keys.pdl
EXPECT_EXIT | 1 | SABOTAGE st2: the mutant keys differ (the sed matched)
RUN | grep | -c | -E | ^SETUPKEY +[\p] +(up\pdown\pleft\pright\pspace) +[\p] | $T/smut/keys.pdl
EXPECT_OUT | 4 | SABOTAGE st2 CAUGHT: with no key for Down the stranger cannot read the screen's word (4 of 5; the real keys: 5)
CLEAN |
