# The centroid part generator stamps a tapered island and a room. No window.
RESULTS | ../results/centroid_parts.txt
ENV | LC_ALL | C

CASE | stamp
SCRATCH |
COPY | @.apps/centroid/ops/centroid_parts_op.c | centroid_parts_op.c
COPY | @.apps/centroid/parts/centroid.parts.pdl | centroid.parts.pdl
RUN | gcc | -O2 | -o | centroid_parts_op | centroid_parts_op.c
EXPECT_EXIT | 0 | compiles
RUN | ./centroid_parts_op | stamp | cells.txt
EXPECT_EXIT | 0 | stamps
EXPECT_OUT | STAMP w=32 h=24 | says-size
EXPECT_HAS | cells.txt | width=32 | wide
EXPECT_HAS | cells.txt | 1,36, | wall-column
EXPECT_HAS | events.txt | door | door-picture
EXPECT_HAS | events.txt | roof | roof-cap
EXPECT_OUT | SPLIT ok | islands-split
EXPECT_HAS | cells.txt | height=33 | map-grows
EXPECT_HAS | cells.txt | 0,0,0 | air-between
EXPECT_HAS | cells.txt | 1,0,0 | bridge-no-body
RUN | ./centroid_parts_op | apply | door | cells.txt | centroid.parts.pdl
EXPECT_EXIT | 0 | apply-door-rebuilds
EXPECT_OUT | APPLY door | apply-door-line
EXPECT_HAS | events.txt | door | apply-door-kept
EXPECT_HAS | events.txt | window | rim-windows
RUN | ./centroid_parts_op | apply | all | cells.txt | centroid.parts.pdl
EXPECT_EXIT | 0 | apply-all
EXPECT_OUT | APPLY floor | all-runs-floor
EXPECT_OUT | APPLY wall | all-runs-wall
EXPECT_OUT | APPLY door | all-runs-door
EXPECT_OUT | APPLY roof | all-runs-roof
EXPECT_OUT | APPLY bridge | all-runs-bridge
EXPECT_HAS | centroid.parts.pdl | wood | wood-count
EXPECT_HAS | centroid.parts.pdl | stone | stone-count
RUN | ./centroid_parts_op | door | cells.txt
EXPECT_EXIT | 0 | door-opens
EXPECT_OUT | OPEN bit=1 | door-open-line
EXPECT_HAS | door.txt | bit=1 | door-open-bit
RUN | ./centroid_parts_op | door | cells.txt
EXPECT_EXIT | 0 | door-shuts
EXPECT_OUT | SHUT bit=0 | door-shut-line
RUN | ./centroid_parts_op | stamp | cells.txt | missing.pdl
EXPECT_EXIT | 1 | NEGATIVE-missing-blueprint
RUN | ./centroid_parts_op
EXPECT_EXIT | 2 | NEGATIVE-usage-without-stamp
