# quest q019 (Eden talk phrases, FREE-WORKER pilot 3): LOCKED cases. The JUDGE is ops/phrase_lint.c (deterministic); the worker may only append rows to worker/phrases.pdl.
# Sections: judge compiles; each judge rule shown able to FAIL on a tiny fixture; then the real check of the worker's file against the real original (40 rows, 12 farm words, 8 questions).
RESULTS | ../results/quest_q019_phrases.txt
CASE | q019-judge-compiles
SCRATCH |
COPY | &.widgits/quest-pilot/q019-phrases/ops/phrase_lint.c | phrase_lint.c
RUN | gcc | -std=gnu11 | -Wall | -Wextra | -Werror | -O2 | -o | $T/phrase_lint.+x | $T/phrase_lint.c
EXPECT_EXIT | 0 | judge-compiles-clean
CASE | q019-judge-good
SCRATCH |
COPY | &.widgits/quest-pilot/q019-phrases/ops/phrase_lint.c | phrase_lint.c
RUN | gcc | -std=gnu11 | -O2 | -w | -o | $T/phrase_lint.+x | $T/phrase_lint.c
WRITE | orig.pdl | # c\nPHRASE \p Hello there friend\n
WRITE | cand.pdl | # c\nPHRASE \p Hello there friend\nPHRASE \p The grain is ready today\nPHRASE \p Is the rain coming soon?\n
RUN | $T/phrase_lint.+x | $T/orig.pdl | $T/cand.pdl | 3 | 1 | 1
EXPECT_EXIT | 0 | rc-good
EXPECT_OUT | LINT\pVERDICT\pPASS | verdict-good
