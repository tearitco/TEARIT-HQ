# pet_say_clock: SCRATCH house, real folder layout. The clock daemon's own command line is used as the trigger: `rpg_edit_hq.+x <root>/common_events/common:pet_say <abs root>` (petslike_core.c event_main). Never touches the live app or node.
# NOT covered here: the lc_clock daemon actually firing it on a schedule, and "clock paused = no firing" (house clock behaviour); those are proven live separately.
RESULTS | ../results/pet_say_clock.txt
ENV | LC_ALL | C

CASE    | setup
SCRATCH |
MKDIR | house/&.widgits
MKDIR | house/#.NNEST_ASSETS/rmmv-www-img
MKDIR | house/&.hq-apps/irc-chat-hq/ops/+x
MKDIR | house/044.pal-chat-irc-scratch/ops/+x
MKDIR | house/@.apps/rpg-edit-hq/ops/+x
MKDIR | house/@.apps/rpg-edit-hq/state/clock_root/common_events
RUN | /bin/cp | $HOUSE/&.hq-apps/irc-chat-hq/ops/+x/pet_post.+x | $T/house/&.hq-apps/irc-chat-hq/ops/+x/pet_post.+x
RUN | /bin/cp | $HOUSE/044.pal-chat-irc👥️+2/ops/+x/chat_post_message.+x | $T/house/044.pal-chat-irc-scratch/ops/+x/chat_post_message.+x
RUN | /bin/cp | $HOUSE/@.apps/rpg-edit-hq/ops/+x/rpg_edit_hq.+x | $T/house/@.apps/rpg-edit-hq/ops/+x/rpg_edit_hq.+x
RUN | /bin/cp | $HOUSE/@.apps/rpg-edit-hq/ops/+x/pet_net_say.+x | $T/house/@.apps/rpg-edit-hq/ops/+x/pet_net_say.+x
RUN | /bin/cp | $HOUSE/@.apps/rpg-edit-hq/net_say.pdl | $T/house/@.apps/rpg-edit-hq/net_say.pdl
WRITE | house/@.apps/rpg-edit-hq/state/active.txt | robot\n
WRITE | house/@.apps/rpg-edit-hq/state/pet_robot.txt | room=store\nx=1\ny=1\nsteps=5\n
WRITE | house/@.apps/rpg-edit-hq/state/pet_asa.txt | room=store\nx=2\ny=2\nsteps=5\n
WRITE | house/@.apps/rpg-edit-hq/state/pet_ember.txt | room=bank\nx=3\ny=3\nsteps=5\n
WRITE | house/@.apps/rpg-edit-hq/state/pet_rex.txt | room=hotel\nx=4\ny=4\nsteps=5\n
WRITE | house/@.apps/rpg-edit-hq/state/daylight.txt | phase=dawn\n
WRITE | house/044.pal-chat-irc-scratch/pet_post.pdl | cap_n | 50\n

CASE    | first-firing
RUN | $T/house/@.apps/rpg-edit-hq/ops/+x/rpg_edit_hq.+x | $T/house/@.apps/rpg-edit-hq/state/clock_root/common_events/common:pet_say | $T/house/@.apps/rpg-edit-hq/state/clock_root
EXPECT_EXIT | 0 | the-clock-event-runs-clean
EXPECT_HAS | house/044.pal-chat-irc-scratch/rooms/pets/messages.txt | \ppet-asa\p | asa-spoke-in-the-pets-room-from-the-ROOM-row
EXPECT_HAS | house/044.pal-chat-irc-scratch/rooms/pets/messages.txt | \ppet-ember\p | ember-spoke
EXPECT_HAS | house/@.apps/rpg-edit-hq/state/net_say_turn.txt | 2 | the-round-robin-cursor-moved-by-PER_TICK
RUN | /usr/bin/awk | END { print NR } | $T/house/044.pal-chat-irc-scratch/rooms/pets/messages.txt
EXPECT_OUT_IS | 2 | exactly-PER_TICK-pets-spoke
EXPECT_LACKS | house/044.pal-chat-irc-scratch/rooms/pets/messages.txt | pet-robot | the-controlled-pet-never-speaks
EXPECT_LACKS | house/044.pal-chat-irc-scratch/rooms/pets/messages.txt | pet-rex | rex-is-not-up-yet

CASE    | second-firing-rotates
RUN | $T/house/@.apps/rpg-edit-hq/ops/+x/rpg_edit_hq.+x | $T/house/@.apps/rpg-edit-hq/state/clock_root/common_events/common:pet_say | $T/house/@.apps/rpg-edit-hq/state/clock_root
EXPECT_HAS | house/044.pal-chat-irc-scratch/rooms/pets/messages.txt | \ppet-rex\p | rex-gets-the-next-turn
RUN | /usr/bin/awk | END { print NR } | $T/house/044.pal-chat-irc-scratch/rooms/pets/messages.txt
EXPECT_OUT_IS | 4 | two-more-lines-four-in-total
EXPECT_LACKS | house/044.pal-chat-irc-scratch/rooms/pets/messages.txt | pet-robot | still-never-the-controlled-pet

CASE    | the-guard-silences-the-clock-too
WRITE | house/044.pal-chat-irc-scratch/pet_post_kill.txt | stop\n
RUN | $T/house/@.apps/rpg-edit-hq/ops/+x/rpg_edit_hq.+x | $T/house/@.apps/rpg-edit-hq/state/clock_root/common_events/common:pet_say | $T/house/@.apps/rpg-edit-hq/state/clock_root
RUN | /usr/bin/awk | END { print NR } | $T/house/044.pal-chat-irc-scratch/rooms/pets/messages.txt
EXPECT_OUT_IS | 4 | with-the-kill-switch-the-clock-firing-posts-nothing
EXPECT_HAS | house/044.pal-chat-irc-scratch/pet_post_audit.txt | DENY_KILL | and-the-guard-audited-the-refusals
RUN | /bin/rm | -f | $T/house/044.pal-chat-irc-scratch/pet_post_kill.txt

CASE    | opt-in-without-rules
RUN | /bin/rm | -f | $T/house/@.apps/rpg-edit-hq/net_say.pdl
RUN | $T/house/@.apps/rpg-edit-hq/ops/+x/rpg_edit_hq.+x | $T/house/@.apps/rpg-edit-hq/state/clock_root/common_events/common:pet_say | $T/house/@.apps/rpg-edit-hq/state/clock_root
EXPECT_EXIT | 0 | no-net_say.pdl-is-not-an-error
RUN | /usr/bin/awk | END { print NR } | $T/house/044.pal-chat-irc-scratch/rooms/pets/messages.txt
EXPECT_OUT_IS | 4 | and-nothing-is-posted-a-skin-without-the-file-is-untouched
CLEAN |
