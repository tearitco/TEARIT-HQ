# Custom-theme wiring in the settings window (owner 2026-10-28): the projector shows the stored prism variables as labels, every prism action in the template is accepted by prism_settings_op, and every prism label the template uses exists in the projector output.
RESULTS | ../results/prism_settings_wiring.txt
CASE | prism_settings_wiring
SCRATCH |
COPY | &.widgits/taskbar-settings/ops/taskbar_settings_projector.c | pj.c
COPY | &.widgits/taskbar-settings/taskbar-settings-pal.xhtpm | x.xhtpm
COPY | &.widgits/_shared-lib/ops/prism_settings_op.c | ps.c
COPY | &.widgits/_shared-lib/ops/prism_op.c | po.c
RUN | gcc | -std=gnu11 | -O2 | -o | $T/proj.+x | $T/pj.c
EXPECT_EXIT | 0 | setup.projector-compiles
RUN | gcc | -std=gnu11 | -Wall | -Wextra | -Werror | -O2 | -o | $T/ps.+x | $T/ps.c
EXPECT_EXIT | 0 | setup.settings-op-compiles
RUN | gcc | -std=gnu11 | -Wall | -Wextra | -Werror | -O2 | -o | $T/prism_op.+x | $T/po.c | -lm
EXPECT_EXIT | 0 | setup.prism-op-compiles
MKDIR | h/#.desktop
MKDIR | h/&.widgits/taskbar-settings
# L1 no prism file = the default rainbow, off
RUN | timeout | 1 | $T/proj.+x | $T/h
EXPECT_EXIT | 124 | l1.projector-ran-until-timeout
EXPECT_HAS | h/#.desktop/taskbar_settings_ui.txt | prism_shape_label=Prism shape: hexagon | l1.default-shape
EXPECT_HAS | h/#.desktop/taskbar_settings_ui.txt | prism_algo_label=Prism light: spiral | l1.default-algo
EXPECT_HAS | h/#.desktop/taskbar_settings_ui.txt | prism_hue_label=Prism hue: 0 | l1.default-hue
EXPECT_HAS | h/#.desktop/taskbar_settings_ui.txt | prism_light_label=Prism brightness: 60% | l1.default-light
EXPECT_HAS | h/#.desktop/taskbar_settings_ui.txt | prism_custom_label=Custom theme (prism): OFF (press to switch) | l1.default-off
# L2 stored values
WRITE | h/#.desktop/livedesk_prism.pdl | PRISM \p shape \p 0\nPRISM \p algo \p 3\nPRISM \p hue \p 120\nPRISM \p light \p 30\nPRISM \p custom \p 1\n
RUN | timeout | 1 | $T/proj.+x | $T/h
EXPECT_HAS | h/#.desktop/taskbar_settings_ui.txt | Prism shape: triangle | l2.triangle
EXPECT_HAS | h/#.desktop/taskbar_settings_ui.txt | Prism light: noise | l2.noise
EXPECT_HAS | h/#.desktop/taskbar_settings_ui.txt | Prism hue: 120 | l2.hue
EXPECT_HAS | h/#.desktop/taskbar_settings_ui.txt | Prism brightness: 30% | l2.light
EXPECT_HAS | h/#.desktop/taskbar_settings_ui.txt | Custom theme (prism): ON | l2.on
WRITE | h/#.desktop/livedesk_prism.pdl | PRISM \p shape \p 3\nPRISM \p algo \p 0\nPRISM \p hue \p 330\nPRISM \p light \p 100\nPRISM \p custom \p 0\n
RUN | timeout | 1 | $T/proj.+x | $T/h
EXPECT_HAS | h/#.desktop/taskbar_settings_ui.txt | Prism shape: circle | l3.circle
EXPECT_HAS | h/#.desktop/taskbar_settings_ui.txt | Prism light: radial | l3.radial
EXPECT_HAS | h/#.desktop/taskbar_settings_ui.txt | Prism brightness: 100% | l3.light-100
WRITE | h/#.desktop/livedesk_prism.pdl | PRISM \p shape \p 2\nPRISM \p algo \p 1\nPRISM \p hue \p 0\nPRISM \p light \p 0\nPRISM \p custom \p 0\n
RUN | timeout | 1 | $T/proj.+x | $T/h
EXPECT_HAS | h/#.desktop/taskbar_settings_ui.txt | Prism shape: diamond | l4.diamond
EXPECT_HAS | h/#.desktop/taskbar_settings_ui.txt | Prism light: linear | l4.linear
EXPECT_HAS | h/#.desktop/taskbar_settings_ui.txt | Prism brightness: 0% | l4.light-0
# L5 out-of-range values fall back to the default rainbow
WRITE | h/#.desktop/livedesk_prism.pdl | PRISM \p shape \p 9\nPRISM \p algo \p 7\nPRISM \p hue \p 500\nPRISM \p light \p 300\nPRISM \p custom \p 5\n
RUN | timeout | 1 | $T/proj.+x | $T/h
EXPECT_HAS | h/#.desktop/taskbar_settings_ui.txt | Prism shape: hexagon | l5.shape-fallback
EXPECT_HAS | h/#.desktop/taskbar_settings_ui.txt | Prism light: spiral | l5.algo-fallback
EXPECT_HAS | h/#.desktop/taskbar_settings_ui.txt | Prism hue: 0 | l5.hue-fallback
EXPECT_HAS | h/#.desktop/taskbar_settings_ui.txt | Prism brightness: 60% | l5.light-fallback
EXPECT_HAS | h/#.desktop/taskbar_settings_ui.txt | Custom theme (prism): ON | l5.nonzero-custom-is-on
# W wiring: the template and the projector and the op agree
WRITE | wire.sh | for t in $(grep -o 'action="PICK:PRISM_[A-Z_]*' $1/x.xhtpm \p cut -d: -f2); do $1/ps.+x $1/h $t > /dev/null && ok=$((ok+1)) \p\p bad=$((bad+1)); done\necho ok=${ok:-0} bad=${bad:-0} > $1/tok.txt\nfor k in $(grep -o 'prism_[a-z]*_label' $1/x.xhtpm \p sort -u); do grep -q "^$k=" $1/h/#.desktop/taskbar_settings_ui.txt && lo=$((lo+1)) \p\p lm=$((lm+1)); done\necho labels_ok=${lo:-0} labels_missing=${lm:-0} > $1/lab.txt\n
RUN | sh | $T/wire.sh | $T
EXPECT_EXIT | 0 | w0.script-ran
EXPECT_HAS | tok.txt | ok=9 bad=0 | w1.all-9-template-actions-are-accepted-by-the-op
EXPECT_HAS | lab.txt | labels_ok=5 labels_missing=0 | w2.all-5-template-labels-exist-in-the-projector-output
# V the live preview: the projector publishes the picture path, the template shows it with a canvas
EXPECT_HAS | h/#.desktop/taskbar_settings_ui.txt | prism_preview_png=$T/h/#.desktop/prism_preview.png | v1.projector-publishes-the-preview-png-path
EXPECT_HAS | x.xhtpm | <item id="prism-preview" class="row-prismpreview prism-preview" sprite="${prism_preview_png}"/> | v2.template-shows-it-as-a-png-sprite-item
CLEAN |
