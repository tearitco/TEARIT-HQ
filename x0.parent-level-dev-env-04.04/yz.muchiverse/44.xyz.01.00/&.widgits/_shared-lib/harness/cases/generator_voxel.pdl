# generator_voxel: voxel part recipes for characters, items and buildings (D29, owner 2026-11-05). Three threads, one op: events/gen_voxel/{chars,items,buildings}.pdl.
RESULTS | ../results/generator_voxel.txt
ENV | LC_ALL | C

CASE    | threads
SCRATCH |
RUN | $HOUSE/@.apps/generator-hq/ops/+x/generator_voxel_op.+x | check | $HOUSE/@.apps/generator-hq/events/gen_voxel/chars.pdl
EXPECT_OUT | VOXELCHECK models=1 parts=8 poses=6 | characters-thread-parses
RUN | $HOUSE/@.apps/generator-hq/ops/+x/generator_voxel_op.+x | check | $HOUSE/@.apps/generator-hq/events/gen_voxel/items.pdl
EXPECT_OUT | VOXELCHECK models=16 parts=45 poses=0 | items-thread-parses
RUN | $HOUSE/@.apps/generator-hq/ops/+x/generator_voxel_op.+x | check | $HOUSE/@.apps/generator-hq/events/gen_voxel/buildings.pdl
EXPECT_OUT | VOXELCHECK models=9 parts=45 poses=0 | buildings-thread-parses
RUN | $HOUSE/@.apps/generator-hq/ops/+x/generator_voxel_op.+x | render | $HOUSE/@.apps/generator-hq/events/gen_voxel/buildings.pdl | cottage | idle | $T/c.png
EXPECT_EXIT | 0 | cottage-renders
EXPECT_OUT | VOXEL model=cottage pose=idle views=4 voxels=2986 | cottage-voxel-count
EXPECT_FILE | c.png | cottage-strip-written
RUN | $HOUSE/@.apps/generator-hq/ops/+x/generator_voxel_op.+x | render | $HOUSE/@.apps/generator-hq/events/gen_voxel/items.pdl | sword | idle | $T/s.png
EXPECT_OUT | VOXEL model=sword pose=idle views=4 voxels=40 | sword-voxel-count

CASE    | poses
SCRATCH |
RUN | $HOUSE/@.apps/generator-hq/ops/+x/generator_voxel_op.+x | render | $HOUSE/@.apps/generator-hq/events/gen_voxel/chars.pdl | asa_vox | idle | $T/i1.png
RUN | $HOUSE/@.apps/generator-hq/ops/+x/generator_voxel_op.+x | render | $HOUSE/@.apps/generator-hq/events/gen_voxel/chars.pdl | asa_vox | idle | $T/i2.png
RUN | /usr/bin/cmp | -s | $T/i1.png | $T/i2.png
EXPECT_EXIT | 0 | the-same-recipe-gives-the-same-bytes
RUN | $HOUSE/@.apps/generator-hq/ops/+x/generator_voxel_op.+x | render | $HOUSE/@.apps/generator-hq/events/gen_voxel/chars.pdl | asa_vox | attack | $T/a.png
EXPECT_EXIT | 0 | attack-renders
RUN | /usr/bin/cmp | -s | $T/i1.png | $T/a.png
EXPECT_EXIT | 1 | NEGATIVE-the-attack-pose-changes-the-picture
RUN | $HOUSE/@.apps/generator-hq/ops/+x/generator_voxel_op.+x | sheet | $HOUSE/@.apps/generator-hq/events/gen_voxel/chars.pdl | asa_vox | $T/sheet.png
EXPECT_OUT | VOXELSHEET model=asa_vox poses=4 size=192x192 | idle-plus-three-poses

CASE    | bad-rows
SCRATCH |
WRITE | b1.pdl | MODEL \p m \p item\nPART \p m \p p \p 20 \p 0 \p 0 \p 10 \p 1 \p 1 \p #ffffff\n
RUN | $HOUSE/@.apps/generator-hq/ops/+x/generator_voxel_op.+x | check | $T/b1.pdl
EXPECT_EXIT | 2 | NEGATIVE-a-part-outside-the-24-grid-is-refused
WRITE | b2.pdl | MODEL \p m \p item\nPART \p m \p p \p 0 \p 0 \p 0 \p 1 \p 1 \p 1 \p #ffffff\nPOSE \p m \p hit \p ghost \p 1 \p 0 \p 0\n
RUN | $HOUSE/@.apps/generator-hq/ops/+x/generator_voxel_op.+x | check | $T/b2.pdl
EXPECT_EXIT | 2 | NEGATIVE-a-pose-naming-a-missing-part-is-refused
WRITE | b3.pdl | MODEL \p m \p tree\n
RUN | $HOUSE/@.apps/generator-hq/ops/+x/generator_voxel_op.+x | check | $T/b3.pdl
EXPECT_EXIT | 2 | NEGATIVE-an-unknown-kind-is-refused
RUN | $HOUSE/@.apps/generator-hq/ops/+x/generator_voxel_op.+x | render | $HOUSE/@.apps/generator-hq/events/gen_voxel/items.pdl | nothing | idle | $T/n.png
EXPECT_EXIT | 2 | NEGATIVE-an-unknown-model-is-refused

# All three threads at scale: the whole cast as voxel models, RPG Maker walk sheets and slots, icon sheets for items and buildings.
CASE    | threads-at-scale
SCRATCH |
RUN | $HOUSE/@.apps/generator-hq/ops/+x/generator_voxel_op.+x | fromcast | $HOUSE/@.apps/generator-hq/events/gen_cast/cast.pdl | $T/cv.pdl | $HOUSE/@.apps/generator-hq/events/gen_voxel/partsets.pdl
EXPECT_OUT | FROMCAST models=126 | every-cast-row-becomes-a-model
RUN | $HOUSE/@.apps/generator-hq/ops/+x/generator_voxel_op.+x | check | $T/cv.pdl
EXPECT_EXIT | 0 | the-generated-recipes-parse
RUN | $HOUSE/@.apps/generator-hq/ops/+x/generator_voxel_op.+x | walksheet | $T/cv.pdl | asa | $T/w.png
EXPECT_OUT | VOXELWALK model=asa size=144x192 frames=12 | rpg-maker-walk-layout
RUN | $HOUSE/@.apps/generator-hq/ops/+x/generator_voxel_op.+x | walksheet | $T/cv.pdl | fang | $T/w2.png
EXPECT_OUT | VOXELWALK model=fang size=144x192 | a-creature-walks-too
RUN | $HOUSE/@.apps/generator-hq/ops/+x/generator_voxel_op.+x | cast-sheets | $T/cv.pdl | $HOUSE/@.apps/generator-hq/events/gen_cast/slots.pdl | $T/s
EXPECT_OUT | VOXELSLOTS sheets=10 | ten-slot-sheets
RUN | $HOUSE/@.apps/generator-hq/ops/+x/generator_tile_op.+x | verify-root | $HOUSE/../../../#.NNEST_ASSETS/rmmv-www-img | $T/s
EXPECT_OUT | VERIFYROOT files=20 same_name_and_size=20 problems=0 | voxel-sheets-match-the-rpg-maker-names-and-sizes
RUN | $HOUSE/@.apps/generator-hq/ops/+x/generator_voxel_op.+x | icons | $HOUSE/@.apps/generator-hq/events/gen_voxel/items.pdl | item | 8 | $T/i.png
EXPECT_OUT | VOXELICONS kind=item models=16 size=384x96 | sixteen-items
RUN | $HOUSE/@.apps/generator-hq/ops/+x/generator_voxel_op.+x | icons | $HOUSE/@.apps/generator-hq/events/gen_voxel/buildings.pdl | building | 4 | $T/b.png
EXPECT_OUT | VOXELICONS kind=building models=9 size=192x144 | nine-buildings
RUN | $HOUSE/@.apps/generator-hq/ops/+x/generator_voxel_op.+x | icons | $HOUSE/@.apps/generator-hq/events/gen_voxel/items.pdl | tree | 4 | $T/n.png
EXPECT_EXIT | 2 | NEGATIVE-an-unknown-kind-has-no-icons
WRITE | bs.pdl | SLOT \p Actor1 \p ghost\n
RUN | $HOUSE/@.apps/generator-hq/ops/+x/generator_voxel_op.+x | cast-sheets | $T/cv.pdl | $T/bs.pdl | $T/bad
EXPECT_EXIT | 2 | NEGATIVE-an-unknown-model-in-a-slot-is-refused

# D30 step 1: the humanoid body is data (events/gen_voxel/partsets.pdl). The generated recipes must stay byte-identical to the pre-refactor C output.
CASE    | partsets
SCRATCH |
RUN | $HOUSE/@.apps/generator-hq/ops/+x/generator_voxel_op.+x | fromcast | $HOUSE/@.apps/generator-hq/events/gen_cast/cast.pdl | $T/a.pdl | $HOUSE/@.apps/generator-hq/events/gen_voxel/partsets.pdl
EXPECT_OUT | FROMCAST models=126 | all-126-models
RUN | /usr/bin/sha256sum | $T/a.pdl
EXPECT_OUT | 978f2188c8c228d33812090ddfc8920cf87d4d8c8c332b97525029129cd72ce8 | identical-to-the-output-of-the-old-C-shapes
RUN | $HOUSE/@.apps/generator-hq/ops/+x/generator_voxel_op.+x | fromcast | $HOUSE/@.apps/generator-hq/events/gen_cast/cast.pdl | $T/b.pdl | $HOUSE/@.apps/generator-hq/events/gen_voxel/partsets.pdl
RUN | /usr/bin/cmp | -s | $T/a.pdl | $T/b.pdl
EXPECT_EXIT | 0 | same-data-same-bytes
WRITE | c1.pdl | CAST \p t \p #8a5a3a \p short \p #4a3020 \p #3a6ea5 \p #ffd24a \p 1 \p 0\n
WRITE | p1.pdl | PS \p humanoid \p torso \p tx \p 9 \p 5 \p bw \p 5 \p 6 \p #ff0000\n
WRITE | p2.pdl | PS \p humanoid \p torso \p tx \p 9 \p 5 \p bw \p 5 \p 6 \p #00ff00\n
RUN | $HOUSE/@.apps/generator-hq/ops/+x/generator_voxel_op.+x | fromcast | $T/c1.pdl | $T/o1.pdl | $T/p1.pdl
RUN | $HOUSE/@.apps/generator-hq/ops/+x/generator_voxel_op.+x | fromcast | $T/c1.pdl | $T/o2.pdl | $T/p2.pdl
RUN | /usr/bin/cmp | -s | $T/o1.pdl | $T/o2.pdl
EXPECT_EXIT | 1 | NEGATIVE-editing-one-data-row-changes-the-output
RUN | /usr/bin/grep | -c | #ff0000 | $T/o1.pdl
EXPECT_OUT_IS | 1 | the-edited-colour-is-what-the-model-got
WRITE | pw.pdl | PS \p humanoid \p torso \p tx \p 9 \p 5 \p width \p 5 \p 6 \p #ff0000\n
RUN | $HOUSE/@.apps/generator-hq/ops/+x/generator_voxel_op.+x | fromcast | $T/c1.pdl | $T/o3.pdl | $T/pw.pdl
EXPECT_EXIT | 2 | NEGATIVE-an-unknown-variable-in-an-expression-is-refused
WRITE | pc.pdl | PS \p humanoid \p torso \p tx \p 9 \p 5 \p bw \p 5 \p 6 \p #ff0000 \p mark>1\n
RUN | $HOUSE/@.apps/generator-hq/ops/+x/generator_voxel_op.+x | fromcast | $T/c1.pdl | $T/o4.pdl | $T/pc.pdl
EXPECT_EXIT | 2 | NEGATIVE-an-unknown-condition-is-refused
WRITE | pe.pdl | # no rows here\n
RUN | $HOUSE/@.apps/generator-hq/ops/+x/generator_voxel_op.+x | fromcast | $T/c1.pdl | $T/o5.pdl | $T/pe.pdl
EXPECT_EXIT | 2 | NEGATIVE-a-file-without-PS-rows-is-refused
RUN | $HOUSE/@.apps/generator-hq/ops/+x/generator_voxel_op.+x | fromcast | $T/c1.pdl | $T/o6.pdl | $T/nothing.pdl
EXPECT_EXIT | 2 | NEGATIVE-a-missing-partsets-file-is-refused

# D30 step 2: a seed plus optional knobs, STYLE presets. Strength: knobs on the row, then preset, then the seed. Same seed and knobs = same bytes.
CASE    | seed-and-knobs
SCRATCH |
RUN | $HOUSE/@.apps/generator-hq/ops/+x/generator_voxel_op.+x | fromchars | $HOUSE/@.apps/generator-hq/events/gen_voxel/characters.pdl | $T/a.pdl | $HOUSE/@.apps/generator-hq/events/gen_voxel/partsets.pdl
EXPECT_OUT | FROMCHARS models=21 presets=4 | twenty-one-characters-four-presets
RUN | /usr/bin/sha256sum | $T/a.pdl
EXPECT_OUT | 245f01bb0efa10cd3426344c41699d9252c02610ce96138e171103b8528720e8 | pinned-output-of-the-sample-characters-file-incl-equipped
RUN | $HOUSE/@.apps/generator-hq/ops/+x/generator_voxel_op.+x | fromchars | $HOUSE/@.apps/generator-hq/events/gen_voxel/characters.pdl | $T/b.pdl | $HOUSE/@.apps/generator-hq/events/gen_voxel/partsets.pdl
RUN | /usr/bin/cmp | -s | $T/a.pdl | $T/b.pdl
EXPECT_EXIT | 0 | same-seeds-same-bytes
RUN | /usr/bin/grep | -c | try_c1 ..torso ..7 ..9 ..4 ..10 ..5 ..6 | $T/a.pdl
EXPECT_OUT_IS | 1 | the-chunky-preset-gives-a-wide-torso-and-short-legs
RUN | /usr/bin/grep | -c | try_s1 ..torso ..9 ..9 ..7 ..6 ..5 ..6 | $T/a.pdl
EXPECT_OUT_IS | 1 | the-slender-preset-gives-a-narrow-torso-and-long-legs
WRITE | s1.pdl | CHAR \p x \p 1\n
WRITE | s2.pdl | CHAR \p x \p 2\n
RUN | $HOUSE/@.apps/generator-hq/ops/+x/generator_voxel_op.+x | fromchars | $T/s1.pdl | $T/o1.pdl | $HOUSE/@.apps/generator-hq/events/gen_voxel/partsets.pdl
RUN | $HOUSE/@.apps/generator-hq/ops/+x/generator_voxel_op.+x | fromchars | $T/s2.pdl | $T/o2.pdl | $HOUSE/@.apps/generator-hq/events/gen_voxel/partsets.pdl
RUN | /usr/bin/cmp | -s | $T/o1.pdl | $T/o2.pdl
EXPECT_EXIT | 1 | NEGATIVE-two-different-seeds-give-two-different-characters
WRITE | k1.pdl | STYLE \p chunky \p build=2 legs=4 head=2\nCHAR \p o \p 5 \p preset=chunky build=0\n
RUN | $HOUSE/@.apps/generator-hq/ops/+x/generator_voxel_op.+x | fromchars | $T/k1.pdl | $T/o3.pdl | $HOUSE/@.apps/generator-hq/events/gen_voxel/partsets.pdl
RUN | /usr/bin/grep | -c | PART ..o ..torso ..9 ..9 ..4 ..6 ..5 ..6 | $T/o3.pdl
EXPECT_OUT_IS | 1 | a-knob-on-the-row-beats-the-preset
WRITE | k2.pdl | CHAR \p k \p 7 \p skin=#112233\n
RUN | $HOUSE/@.apps/generator-hq/ops/+x/generator_voxel_op.+x | fromchars | $T/k2.pdl | $T/o4.pdl | $HOUSE/@.apps/generator-hq/events/gen_voxel/partsets.pdl
RUN | /usr/bin/grep | -c | #112233 | $T/o4.pdl
EXPECT_OUT_IS | 3 | an-explicit-skin-beats-the-seed-head-and-both-hands
RUN | $HOUSE/@.apps/generator-hq/ops/+x/generator_voxel_op.+x | render | $T/a.pdl | try_c1 | idle | $T/r.png
EXPECT_OUT | VOXEL model=try_c1 pose=idle views=4 | a-seeded-model-renders
WRITE | e1.pdl | STYLE \p heroic \p build=1 legs=6 head=1 mark=1\nCHAR \p x \p 1 \p wings=2\n
RUN | $HOUSE/@.apps/generator-hq/ops/+x/generator_voxel_op.+x | fromchars | $T/e1.pdl | $T/e.pdl | $HOUSE/@.apps/generator-hq/events/gen_voxel/partsets.pdl
EXPECT_EXIT | 2 | NEGATIVE-an-unknown-knob-is-refused
WRITE | e2.pdl | CHAR \p x \p 1 \p preset=nope\n
RUN | $HOUSE/@.apps/generator-hq/ops/+x/generator_voxel_op.+x | fromchars | $T/e2.pdl | $T/e.pdl | $HOUSE/@.apps/generator-hq/events/gen_voxel/partsets.pdl
EXPECT_EXIT | 2 | NEGATIVE-an-unknown-preset-is-refused
WRITE | e3.pdl | CHAR \p x \p 1 \p skin=red\n
RUN | $HOUSE/@.apps/generator-hq/ops/+x/generator_voxel_op.+x | fromchars | $T/e3.pdl | $T/e.pdl | $HOUSE/@.apps/generator-hq/events/gen_voxel/partsets.pdl
EXPECT_EXIT | 2 | NEGATIVE-a-colour-that-is-not-rrggbb-is-refused
WRITE | e4.pdl | CHAR \p x \p 1 \p legs=9\n
RUN | $HOUSE/@.apps/generator-hq/ops/+x/generator_voxel_op.+x | fromchars | $T/e4.pdl | $T/e.pdl | $HOUSE/@.apps/generator-hq/events/gen_voxel/partsets.pdl
EXPECT_EXIT | 2 | NEGATIVE-legs-out-of-range-is-refused
WRITE | e5.pdl | CHAR \p x \p notanumber\n
RUN | $HOUSE/@.apps/generator-hq/ops/+x/generator_voxel_op.+x | fromchars | $T/e5.pdl | $T/e.pdl | $HOUSE/@.apps/generator-hq/events/gen_voxel/partsets.pdl
EXPECT_EXIT | 2 | NEGATIVE-a-seed-that-is-not-a-number-is-refused
WRITE | e6.pdl | STYLE \p a \p build=1\nSTYLE \p b \p preset=a\nCHAR \p x \p 1 \p preset=b\n
RUN | $HOUSE/@.apps/generator-hq/ops/+x/generator_voxel_op.+x | fromchars | $T/e6.pdl | $T/e.pdl | $HOUSE/@.apps/generator-hq/events/gen_voxel/partsets.pdl
EXPECT_EXIT | 2 | NEGATIVE-a-preset-inside-a-preset-is-refused
WRITE | e7.pdl | STYLE \p a \p build=1\n
RUN | $HOUSE/@.apps/generator-hq/ops/+x/generator_voxel_op.+x | fromchars | $T/e7.pdl | $T/e.pdl | $HOUSE/@.apps/generator-hq/events/gen_voxel/partsets.pdl
EXPECT_EXIT | 2 | NEGATIVE-a-file-without-CHAR-rows-is-refused

# D30 step 3: equipment. Visuals only (EQ rows in partsets.pdl); stats stay in db-hq. A weapon or shield follows its hand in every pose; one item per slot.
CASE    | equipment
SCRATCH |
RUN | $HOUSE/@.apps/generator-hq/ops/+x/generator_voxel_op.+x | check-equip | $HOUSE/@.apps/generator-hq/events/gen_voxel/partsets.pdl | $HOUSE/&.widgits/db-hq/data
EXPECT_OUT | EQCHECK items=11 linked=8 no_db_row=3 missing=0 | eight-visuals-are-linked-to-real-db-items-and-three-have-none-yet
WRITE | bad_eq.pdl | PS \p humanoid \p torso \p tx \p 9 \p lh \p bw \p 5 \p 6 \p #112233\nEQ \p ghost_helm \p head \p Ghost Helm \p dome \p hx \p 8 \p lh+10 \p hw \p 5 \p 2 \p #ffffff \p -\n
RUN | $HOUSE/@.apps/generator-hq/ops/+x/generator_voxel_op.+x | check-equip | $T/bad_eq.pdl | $HOUSE/&.widgits/db-hq/data
EXPECT_EXIT | 1 | NEGATIVE-an-item-name-that-is-not-in-the-database-fails-the-check
WRITE | e0.pdl | STYLE \p heroic \p build=1 legs=6 head=1 mark=1\nCHAR \p e \p 5 \p preset=heroic\n
WRITE | e1.pdl | STYLE \p heroic \p build=1 legs=6 head=1 mark=1\nCHAR \p e \p 5 \p preset=heroic equip=bronze_sword,wooden_shield,leather_cap\n
RUN | $HOUSE/@.apps/generator-hq/ops/+x/generator_voxel_op.+x | fromchars | $T/e0.pdl | $T/o0.pdl | $HOUSE/@.apps/generator-hq/events/gen_voxel/partsets.pdl
EXPECT_OUT | FROMCHARS models=1 | the-bare-character-was-generated
RUN | $HOUSE/@.apps/generator-hq/ops/+x/generator_voxel_op.+x | fromchars | $T/e1.pdl | $T/o1.pdl | $HOUSE/@.apps/generator-hq/events/gen_voxel/partsets.pdl
EXPECT_OUT | FROMCHARS models=1 | the-equipped-character-was-generated
RUN | /usr/bin/grep | -c | PART ..e ..bronze_sword_blade | $T/o1.pdl
EXPECT_OUT_IS | 1 | an-equipped-item-adds-its-parts
RUN | /usr/bin/grep | -c | PART ..e ..bronze_sword_blade | $T/o0.pdl
EXPECT_OUT_IS | 0 | NEGATIVE-without-the-knob-there-is-no-sword
RUN | /usr/bin/grep | -c | POSE ..e ..attack ..bronze_sword_blade ..-1 ..-6 ..2 | $T/o1.pdl
EXPECT_OUT_IS | 1 | the-sword-copies-the-hands-attack-offset
RUN | /usr/bin/grep | -c | POSE ..e ..mine ..wooden_shield_board ..2 ..-5 ..3 | $T/o1.pdl
EXPECT_OUT_IS | 1 | the-shield-follows-the-left-hand-when-mining
RUN | /usr/bin/grep | -c | POSE ..e ..attack ..leather_cap | $T/o1.pdl
EXPECT_OUT_IS | 0 | a-cap-has-no-pose-rows-it-stays-on-the-head
RUN | $HOUSE/@.apps/generator-hq/ops/+x/generator_voxel_op.+x | render | $T/o1.pdl | e | idle | $T/q1.png
RUN | $HOUSE/@.apps/generator-hq/ops/+x/generator_voxel_op.+x | render | $T/o0.pdl | e | idle | $T/q0.png
RUN | /usr/bin/cmp | -s | $T/q0.png | $T/q1.png
EXPECT_EXIT | 1 | NEGATIVE-the-equipped-picture-differs-from-the-bare-one
WRITE | f1.pdl | STYLE \p chunky \p build=2 legs=4 head=2\nCHAR \p f \p 9 \p preset=chunky equip=plate_body\n
RUN | $HOUSE/@.apps/generator-hq/ops/+x/generator_voxel_op.+x | fromchars | $T/f1.pdl | $T/of.pdl | $HOUSE/@.apps/generator-hq/events/gen_voxel/partsets.pdl
EXPECT_OUT | FROMCHARS models=1 | the-chunky-plate-character-was-generated
RUN | /usr/bin/grep | -c | PART ..f ..plate_body_plate ..6 ..8 ..4 ..12 | $T/of.pdl
EXPECT_OUT_IS | 1 | the-plate-widens-with-the-chunky-build
WRITE | f2.pdl | STYLE \p slender \p build=0 legs=7 head=0\nCHAR \p f \p 9 \p preset=slender equip=plate_body\n
RUN | $HOUSE/@.apps/generator-hq/ops/+x/generator_voxel_op.+x | fromchars | $T/f2.pdl | $T/og.pdl | $HOUSE/@.apps/generator-hq/events/gen_voxel/partsets.pdl
EXPECT_OUT | FROMCHARS models=1 | the-slender-plate-character-was-generated
RUN | /usr/bin/grep | -c | PART ..f ..plate_body_plate ..8 ..8 ..7 ..8 | $T/og.pdl
EXPECT_OUT_IS | 1 | and-narrows-with-the-slender-build-and-rides-higher-on-long-legs
WRITE | x1.pdl | CHAR \p x \p 1 \p equip=no_such_item\n
RUN | $HOUSE/@.apps/generator-hq/ops/+x/generator_voxel_op.+x | fromchars | $T/x1.pdl | $T/ox.pdl | $HOUSE/@.apps/generator-hq/events/gen_voxel/partsets.pdl
EXPECT_EXIT | 2 | NEGATIVE-an-unknown-equipment-id-is-refused
WRITE | x2.pdl | CHAR \p x \p 1 \p equip=dagger,bronze_sword\n
RUN | $HOUSE/@.apps/generator-hq/ops/+x/generator_voxel_op.+x | fromchars | $T/x2.pdl | $T/ox.pdl | $HOUSE/@.apps/generator-hq/events/gen_voxel/partsets.pdl
EXPECT_EXIT | 2 | NEGATIVE-two-items-for-the-weapon-slot-are-refused
WRITE | bad_slot.pdl | PS \p humanoid \p torso \p tx \p 9 \p lh \p bw \p 5 \p 6 \p #112233\nEQ \p x \p feet \p - \p boot \p hx \p 8 \p lh \p hw \p 5 \p 2 \p #ffffff \p -\n
RUN | $HOUSE/@.apps/generator-hq/ops/+x/generator_voxel_op.+x | check-equip | $T/bad_slot.pdl | $HOUSE/&.widgits/db-hq/data
EXPECT_EXIT | 2 | NEGATIVE-a-slot-that-is-not-a-house-equipment-type-is-refused

# D30 step 4: the 2D finishing options (face rows, a bevel pixel pass). The quality gate against the flat cast op FAILED (see interim/try/2026-11-05-quality-gate); these options are kept and pinned, the flat op stays as the 2D finisher.
CASE    | finish
SCRATCH |
WRITE | fa.pdl | STYLE \p s \p build=1\nCHAR \p f \p 3 \p preset=s face=1\n
WRITE | fb.pdl | STYLE \p s \p build=1\nCHAR \p f \p 3 \p preset=s\n
RUN | $HOUSE/@.apps/generator-hq/ops/+x/generator_voxel_op.+x | fromchars | $T/fa.pdl | $T/oa.pdl | $HOUSE/@.apps/generator-hq/events/gen_voxel/partsets.pdl
EXPECT_OUT | FROMCHARS models=1 | the-face-character-was-generated
RUN | $HOUSE/@.apps/generator-hq/ops/+x/generator_voxel_op.+x | fromchars | $T/fb.pdl | $T/ob.pdl | $HOUSE/@.apps/generator-hq/events/gen_voxel/partsets.pdl
EXPECT_OUT | FROMCHARS models=1 | the-plain-character-was-generated
RUN | /usr/bin/grep | -c | PART ..f ..mouth | $T/oa.pdl
EXPECT_OUT_IS | 1 | face-equals-1-adds-a-mouth
RUN | /usr/bin/grep | -c | PART ..f ..mouth | $T/ob.pdl
EXPECT_OUT_IS | 0 | NEGATIVE-the-default-has-no-mouth
RUN | $HOUSE/@.apps/generator-hq/ops/+x/generator_voxel_op.+x | fromcast | $HOUSE/@.apps/generator-hq/events/gen_cast/cast.pdl | $T/cf.pdl | $HOUSE/@.apps/generator-hq/events/gen_voxel/partsets.pdl | face
EXPECT_OUT | FROMCAST models=126 | the-face-flag-on-fromcast
RUN | /usr/bin/grep | -c | mouth | $T/cf.pdl
EXPECT_OUT_IS | 101 | 101-cast-characters-get-a-mouth-masked-ones-do-not
RUN | $HOUSE/@.apps/generator-hq/ops/+x/generator_voxel_op.+x | render | $T/cf.pdl | asa | idle | $T/p0.png
EXPECT_OUT | opaque=2732 | plain-render-pixel-count
RUN | $HOUSE/@.apps/generator-hq/ops/+x/generator_voxel_op.+x | render | $T/cf.pdl | asa | idle | $T/p1.png | pixel
EXPECT_OUT | opaque=2642 | the-bevel-takes-corner-pixels-off
RUN | /usr/bin/cmp | -s | $T/p0.png | $T/p1.png
EXPECT_EXIT | 1 | NEGATIVE-the-pixel-pass-changes-the-picture

# D31: newly drawn things (round primitives CYL and ELL, props, objsheet in the layout of Outside_B). Acceptance rule: low correlation with the original AND a person read it.
CASE    | new-art-outside-b
SCRATCH |
RUN | $HOUSE/@.apps/generator-hq/ops/+x/generator_voxel_op.+x | check | $HOUSE/@.apps/generator-hq/events/gen_voxel/props.pdl
EXPECT_OUT | VOXELCHECK models=25 parts=199 poses=0 | twenty-five-props
RUN | $HOUSE/@.apps/generator-hq/ops/+x/generator_voxel_op.+x | render | $HOUSE/@.apps/generator-hq/events/gen_voxel/props.pdl | barrel | idle | $T/b.png
EXPECT_OUT | voxels=2851 | the-barrel-is-a-pinned-cylinder-stack
RUN | $HOUSE/@.apps/generator-hq/ops/+x/generator_voxel_op.+x | render | $HOUSE/@.apps/generator-hq/events/gen_voxel/props.pdl | pine | idle | $T/p.png
EXPECT_OUT | voxels=1294 | the-pine-is-pinned
RUN | $HOUSE/@.apps/generator-hq/ops/+x/generator_voxel_op.+x | icons | $HOUSE/@.apps/generator-hq/events/gen_voxel/props.pdl | prop | 8 | $T/i.png
EXPECT_OUT | VOXELICONS kind=prop models=25 size=384x192 | an-icon-sheet-of-props
RUN | $HOUSE/@.apps/generator-hq/ops/+x/generator_voxel_op.+x | objsheet | $T/s1.png | $HOUSE/@.apps/generator-hq/events/gen_objects/outside_b.pdl | $HOUSE/@.apps/generator-hq/events/gen_voxel/props.pdl
EXPECT_OUT | OBJSHEET size=768x768 cells=25 | the-catalog-places-25-things
RUN | /usr/bin/sha256sum | $T/s1.png
EXPECT_OUT | fd310476c29c757e7edfa73690762bcd02b1469cc2d9050a34fa62638ada0e0b | the-sheet-is-pinned
RUN | $HOUSE/@.apps/generator-hq/ops/+x/generator_voxel_op.+x | objsheet | $T/s2.png | $HOUSE/@.apps/generator-hq/events/gen_objects/outside_b.pdl | $HOUSE/@.apps/generator-hq/events/gen_voxel/props.pdl
RUN | /usr/bin/cmp | -s | $T/s1.png | $T/s2.png
EXPECT_EXIT | 0 | same-recipes-same-sheet
RUN | $HOUSE/@.apps/generator-hq/ops/+x/generator_tile_op.+x | verify-root | $HOUSE/../../../#.NNEST_ASSETS/rmmv-www-img | $T/none
EXPECT_EXIT | 3 | NEGATIVE-control-an-empty-root-is-refused
RUN | $HOUSE/@.apps/generator-hq/ops/+x/generator_tile_op.+x | compare-png | $HOUSE/../../../#.NNEST_ASSETS/rmmv-www-img/tilesets/Outside_B.png | $T/s1.png
EXPECT_OUT | luminance_correlation=0.164 overlap_pct=5.0 | THE-GATE-the-new-sheet-is-a-different-drawing-not-a-repaint
RUN | $HOUSE/@.apps/generator-hq/ops/+x/generator_tile_op.+x | compare-png | $HOUSE/../../../#.NNEST_ASSETS/rmmv-www-img/tilesets/Outside_B.png | $HOUSE/../../../#.NNEST_ASSETS/generator-hq/good/tilesets/Outside_B.png
EXPECT_OUT | luminance_correlation=0.903 | CONTRAST-the-old-recolour-is-the-same-drawing
WRITE | cb1.pdl | SHEET \p S \p 768 \p 768\nCELL \p 0 \p 0 \p 1 \p 1 \p ghost \p no_such_model\n
RUN | $HOUSE/@.apps/generator-hq/ops/+x/generator_voxel_op.+x | objsheet | $T/x1.png | $T/cb1.pdl | $HOUSE/@.apps/generator-hq/events/gen_voxel/props.pdl
EXPECT_EXIT | 2 | NEGATIVE-a-cell-with-an-unknown-model-is-refused
WRITE | cb2.pdl | SHEET \p S \p 768 \p 768\nCELL \p 20 \p 0 \p 1 \p 1 \p barrel \p barrel\n
RUN | $HOUSE/@.apps/generator-hq/ops/+x/generator_voxel_op.+x | objsheet | $T/x2.png | $T/cb2.pdl | $HOUSE/@.apps/generator-hq/events/gen_voxel/props.pdl
EXPECT_EXIT | 2 | NEGATIVE-a-cell-outside-the-sheet-is-refused
WRITE | cb3.pdl | CELL \p 0 \p 0 \p 1 \p 1 \p barrel \p barrel\n
RUN | $HOUSE/@.apps/generator-hq/ops/+x/generator_voxel_op.+x | objsheet | $T/x3.png | $T/cb3.pdl | $HOUSE/@.apps/generator-hq/events/gen_voxel/props.pdl
EXPECT_EXIT | 2 | NEGATIVE-a-cell-before-the-SHEET-row-is-refused
WRITE | rb1.pdl | MODEL \p m \p prop\nCYL \p m \p c \p 2 \p 12 \p 0 \p 5 \p 3 \p #ffffff\n
RUN | $HOUSE/@.apps/generator-hq/ops/+x/generator_voxel_op.+x | check | $T/rb1.pdl
EXPECT_EXIT | 2 | NEGATIVE-a-cylinder-that-leaves-the-grid-is-refused
WRITE | rb2.pdl | MODEL \p m \p prop\nELL \p m \p e \p 12 \p 12 \p 6 \p 0 \p 3 \p 3 \p #ffffff\n
RUN | $HOUSE/@.apps/generator-hq/ops/+x/generator_voxel_op.+x | check | $T/rb2.pdl
EXPECT_EXIT | 2 | NEGATIVE-an-ellipsoid-with-radius-0-is-refused

# D32: the look of the new art is tuned by Concept Bank weights (spokes prop_<name> pointing at the masters look_warm and look_worn). Weight 0.0 = the recipe as drawn.
CASE    | concept-bank
SCRATCH |
RUN | $HOUSE/@.apps/generator-hq/ops/+x/generator_voxel_op.+x | objsheet | $T/neutral.png | $HOUSE/@.apps/generator-hq/events/gen_objects/outside_b.pdl | $HOUSE/@.apps/generator-hq/events/gen_voxel/props.pdl | bank=$HOUSE/&.widgits/concept-bank
EXPECT_OUT | OBJSHEET size=768x768 cells=25 | the-real-bank-is-read
RUN | /usr/bin/sha256sum | $T/neutral.png
EXPECT_OUT | fd310476c29c757e7edfa73690762bcd02b1469cc2d9050a34fa62638ada0e0b | neutral-weights-reproduce-the-pinned-sheet-byte-for-byte
MKDIR | bankA/data/spokes
MKDIR | bankB/data/spokes
MKDIR | bankC/data/spokes
MKDIR | bankD/data/spokes
WRITE | bankA/data/spokes/prop_barrel.pdl | NODE \p prop_barrel\nKIND \p spoke\nN_SLOTS \p 8\nSLOT \p 0 \p POINTS_TO=look_warm \p WEIGHT=0.90\nSLOT \p 1 \p POINTS_TO=look_worn \p WEIGHT=0.00\nGRADE \p 0\n
WRITE | bankB/data/spokes/prop_barrel.pdl | NODE \p prop_barrel\nKIND \p spoke\nN_SLOTS \p 8\nSLOT \p 0 \p POINTS_TO=look_warm \p WEIGHT=-0.90\nSLOT \p 1 \p POINTS_TO=look_worn \p WEIGHT=0.00\nGRADE \p 0\n
WRITE | bankC/data/spokes/prop_barrel.pdl | NODE \p prop_barrel\nKIND \p spoke\nN_SLOTS \p 8\nSLOT \p 0 \p POINTS_TO=look_warm \p WEIGHT=0.00\nSLOT \p 1 \p POINTS_TO=look_worn \p WEIGHT=0.80\nGRADE \p 0\n
WRITE | bankD/data/spokes/prop_barrel.pdl | NODE \p prop_barrel\nKIND \p spoke\nN_SLOTS \p 8\nSLOT \p 0 \p POINTS_TO=look_warm \p WEIGHT=2.00\nSLOT \p 1 \p POINTS_TO=look_worn \p WEIGHT=0.00\nGRADE \p 0\n
RUN | $HOUSE/@.apps/generator-hq/ops/+x/generator_voxel_op.+x | render | $HOUSE/@.apps/generator-hq/events/gen_voxel/props.pdl | barrel | idle | $T/rA.png | bank=$T/bankA
EXPECT_OUT | VOXEL model=barrel pose=idle views=4 voxels=2851 | bank-A-renders-with-the-same-voxel-count
RUN | $HOUSE/@.apps/generator-hq/ops/+x/generator_voxel_op.+x | render | $HOUSE/@.apps/generator-hq/events/gen_voxel/props.pdl | barrel | idle | $T/rB.png | bank=$T/bankB
EXPECT_OUT | VOXEL model=barrel pose=idle views=4 voxels=2851 | bank-B-renders-with-the-same-voxel-count
RUN | $HOUSE/@.apps/generator-hq/ops/+x/generator_voxel_op.+x | render | $HOUSE/@.apps/generator-hq/events/gen_voxel/props.pdl | barrel | idle | $T/rC.png | bank=$T/bankC
EXPECT_OUT | VOXEL model=barrel pose=idle views=4 voxels=2851 | bank-C-renders-with-the-same-voxel-count
RUN | $HOUSE/@.apps/generator-hq/ops/+x/generator_voxel_op.+x | render | $HOUSE/@.apps/generator-hq/events/gen_voxel/props.pdl | barrel | idle | $T/r0.png
RUN | /usr/bin/cmp | -s | $T/r0.png | $T/rA.png
EXPECT_EXIT | 1 | warm-0.9-changes-the-picture
RUN | /usr/bin/cmp | -s | $T/rA.png | $T/rB.png
EXPECT_EXIT | 1 | warm-plus-and-warm-minus-differ
RUN | /usr/bin/cmp | -s | $T/r0.png | $T/rC.png
EXPECT_EXIT | 1 | worn-0.8-changes-the-picture
RUN | $HOUSE/@.apps/generator-hq/ops/+x/generator_voxel_op.+x | render | $HOUSE/@.apps/generator-hq/events/gen_voxel/props.pdl | barrel | idle | $T/rA2.png | bank=$T/bankA
RUN | /usr/bin/cmp | -s | $T/rA.png | $T/rA2.png
EXPECT_EXIT | 0 | same-weights-same-bytes
RUN | $HOUSE/@.apps/generator-hq/ops/+x/generator_voxel_op.+x | render | $HOUSE/@.apps/generator-hq/events/gen_voxel/props.pdl | barrel | idle | $T/rD.png | bank=$T/bankD
EXPECT_EXIT | 2 | NEGATIVE-a-weight-outside-minus-1-to-1-is-refused
MKDIR | bankE/data/spokes
RUN | $HOUSE/@.apps/generator-hq/ops/+x/generator_voxel_op.+x | render | $HOUSE/@.apps/generator-hq/events/gen_voxel/props.pdl | barrel | idle | $T/rE.png | bank=$T/bankE
RUN | /usr/bin/cmp | -s | $T/r0.png | $T/rE.png
EXPECT_EXIT | 0 | a-missing-spoke-falls-back-to-the-recipe-as-drawn
WRITE | ed1.txt | EDIT \p id=t1 \p type=spoke_weight_delta \p target=prop_barrel \p slot=look_warm \p delta=0.1 \p reason="a little warmer" \p proposer=owner \p status=candidate\n
RUN | $HOUSE/&.widgits/concept-bank/ops/+x/concept_edit_validate.+x | $HOUSE/&.widgits/concept-bank | $T/ed1.txt
EXPECT_EXIT | 0 | the-house-validator-passes-a-bounded-hand-edit
WRITE | ed2.txt | EDIT \p id=t2 \p type=spoke_weight_delta \p target=prop_barrel \p slot=look_warm \p delta=0.5 \p reason="far too warm" \p proposer=owner \p status=candidate\n
RUN | $HOUSE/&.widgits/concept-bank/ops/+x/concept_edit_validate.+x | $HOUSE/&.widgits/concept-bank | $T/ed2.txt
EXPECT_EXIT | 1 | NEGATIVE-an-edit-bigger-than-0.2-is-rejected
WRITE | ed3.txt | EDIT \p id=t3 \p type=spoke_weight_delta \p target=prop_ghost \p slot=look_warm \p delta=0.1 \p reason="no such thing" \p proposer=owner \p status=candidate\n
RUN | $HOUSE/&.widgits/concept-bank/ops/+x/concept_edit_validate.+x | $HOUSE/&.widgits/concept-bank | $T/ed3.txt
EXPECT_EXIT | 1 | NEGATIVE-an-edit-to-a-thing-that-is-not-in-the-bank-is-rejected
WRITE | ed4.txt | EDIT \p id=t4 \p type=spoke_weight_delta \p target=prop_barrel \p slot=look_round \p delta=0.1 \p reason="no such master" \p proposer=owner \p status=candidate\n
RUN | $HOUSE/&.widgits/concept-bank/ops/+x/concept_edit_validate.+x | $HOUSE/&.widgits/concept-bank | $T/ed4.txt
EXPECT_EXIT | 1 | NEGATIVE-an-edit-pointing-at-a-master-the-thing-does-not-use-is-rejected
