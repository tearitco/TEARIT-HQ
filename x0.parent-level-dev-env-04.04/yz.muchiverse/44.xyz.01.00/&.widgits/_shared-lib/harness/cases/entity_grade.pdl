# entity_grade: LOCKED cases. Source under test: &.widgits/concept-bank/ops/entity_grade.c
RESULTS | ../results/entity_grade.txt
CASE | entity-grade
SCRATCH |
COPY | &.widgits/concept-bank/ops/entity_grade.c | entity_grade.c
COPY | ^.hai-horn/curriculum.pdl | curriculum.pdl
COPY | ^.hai-horn/skillbook.pdl | skillbook.pdl
RUN | gcc | -std=gnu11 | -Wall | -Wextra | -Werror | -O2 | -o | $T/eg.+x | $T/entity_grade.c
EXPECT_EXIT | 0 | compiles-clean
MKDIR | e1
MKDIR | e2
MKDIR | e3
MKDIR | e4
MKDIR | pt
MKDIR | pt/a
MKDIR | pt/b
RUN | $T/eg.+x | use | $T/e1 | $T/skillbook.pdl | observe
EXPECT_EXIT | 0 | observe
EXPECT_OUT_IS | USED observe mp=6->5 exp=0->1 level=1 | out-observe
RUN | $T/eg.+x | use | $T/e1 | $T/skillbook.pdl | describe
EXPECT_EXIT | 0 | describe
EXPECT_OUT_IS | USED describe mp=5->2 exp=1->3 level=1 | out-describe
RUN | $T/eg.+x | use | $T/e1 | $T/skillbook.pdl | describe
EXPECT_EXIT | 4 | describe-no-mp
EXPECT_OUT_IS | REFUSED describe costs 3 MP (this entity has 2) | out-describe-no-mp
RUN | $T/eg.+x | use | $T/e1 | $T/skillbook.pdl | propose_edit
EXPECT_EXIT | 4 | grade-too-low
EXPECT_OUT_IS | REFUSED propose_edit needs grade elementary_hs (this entity: preschool) | out-grade-too-low
RUN | $T/eg.+x | use | $T/e1 | $T/skillbook.pdl | nonesuch
EXPECT_EXIT | 3 | unknown-skill
EXPECT_OUT_IS | UNKNOWN_SKILL nonesuch | out-unknown-skill
RUN | $T/eg.+x | rest | $T/e1 | $T/skillbook.pdl
EXPECT_EXIT | 0 | rest
EXPECT_OUT_IS | RESTED level=1 mp=6/6 | out-rest
WRITE | e2/variables.txt | rpg_level=1\nrpg_exp=9\nrpg_mp=6\nrpg_mp_max=6\nkeep=7\n
RUN | $T/eg.+x | use | $T/e2 | $T/skillbook.pdl | describe
EXPECT_EXIT | 0 | level-up
EXPECT_OUT_IS | USED describe mp=6->3 exp=9->11 level=2 LEVEL_UP | out-level-up
EXPECT_HAS | e2/variables.txt | rpg_mp_max=8\n | mp-max-raised
EXPECT_HAS | e2/variables.txt | rpg_mp=5\n | mp-gains-the-increase
EXPECT_HAS | e2/variables.txt | keep=7\n | other-variables-kept
RUN | $T/eg.+x | use | $T/e2 | $T/skillbook.pdl | propose_edit
EXPECT_EXIT | 4 | level-gate-after-levelup-but-grade-low
EXPECT_OUT_IS | REFUSED propose_edit needs grade elementary_hs (this entity: preschool) | out-level-gate-after-levelup-but-grade-low
