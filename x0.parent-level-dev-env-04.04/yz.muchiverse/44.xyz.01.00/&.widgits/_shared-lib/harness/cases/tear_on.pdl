EXPECT_HAS | editor/state/game_ui.txt | gmb_0_label=[Care] | the-first-button-is-the-care-tab
EXPECT_HAS | editor/state/game_ui.txt | gmb_5_label=Hatch a pet | the-care-tab-starts-with-hatch
EXPECT_HAS | editor/state/game_ui.txt | Redraw board | the-care-tab-has-the-redraw-board-button
EXPECT_HAS | editor/state/game_ui.txt | side_pal=\n | the-palettes-bar-is-hidden-while-the-game-runs
EXPECT_HAS | editor/state/game_ui.txt | side_left=1 | the-pets-bar-is-shown
EXPECT_HAS | editor/state/game_ui.txt | n_party=5 | the-bar-lists-every-pet-the-driver-acts-for
EXPECT_HAS | editor/state/game_ui.txt | party_0_label=> rex | the-selected-pet-is-marked-in-the-party
EXPECT_HAS | editor/state/game_ui.txt | party_4_id=tear_kai | the-party-has-one-row-per-pet-with-its-own-id
EXPECT_HAS | editor/state/game_ui.txt | gm_pop=1 | the-popup-layout-shows-the-popup
EXPECT_HAS | editor/state/game_ui.txt | gmbar_on=\n | and-not-the-bottom-bar
RUN | $T/house/@.apps/tear-on/ops/+x/tear_on_ctl.+x | lay_next | $T/house/@.apps/tear-on/play
WAIT_HAS | editor/state/game_ui.txt | gmbar_on=1 | 12000 | the-layout-button-switches-to-the-bottom-bar
EXPECT_HAS | editor/state/game_ui.txt | gm_pop=0 | the-popup-is-hidden-in-bar-layout
EXPECT_HAS | editor/state/game_ui.txt | gm_on=1 | the-feed-still-says-gm_on-1-so-the-daemon-sees-a-live-game
EXPECT_HAS | editor/state/game_ui.txt | gmbar_0_label=Tab: Care > | the-bar-starts-with-the-tab-cycle-button
EXPECT_HAS | editor/state/game_ui.txt | gmbar_title=TEAR-IT Ranch | the-bar-title-names-the-game
EXPECT_HAS | editor/state/game_ui.txt | gmbar_min_act= | the-bar-has-a-minimize-action
EXPECT_HAS | editor/state/game_ui.txt | gm_nb=0 | the-popup-list-is-empty-in-bar-layout
RUN | $T/house/@.apps/tear-on/ops/+x/tear_on_ctl.+x | tab_next | $T/house/@.apps/tear-on/play
WAIT_HAS | editor/state/game_ui.txt | gmbar_0_label=Tab: Train > | 12000 | the-tab-button-cycles-the-tab
EXPECT_HAS | editor/state/game_ui.txt | gmbar_1_label=Sprint | and-shows-that-tabs-buttons
