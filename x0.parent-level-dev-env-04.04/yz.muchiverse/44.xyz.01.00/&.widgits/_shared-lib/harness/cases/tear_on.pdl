# tear_on.pdl - the tear-on book (TEAR-IT Ranch and Arena as a book in the rpg-edit board, opened from the network menu), 2026-11-24.
# Scratch "house" tree under $T: the chain op, the launcher op, the atlas and a chain; the live house and the live editor are never touched.
CASE    | project-draws-both-pages-from-the-chain
SCRATCH |
MKDIR   | house/@.apps/tear-on/atlas
MKDIR   | house/@.apps/tear-on/ledger
MKDIR   | house/&.hq-apps/tear-offline/ops/+x
MKDIR   | house/&.hq-apps/tear-on/ops/+x
COPY    | &.hq-apps/tear-offline/ops/+x/tear_chain_op.+x | house/&.hq-apps/tear-offline/ops/+x/tear_chain_op.+x
COPY    | &.hq-apps/tear-on/ops/+x/tear_on_op.+x | house/&.hq-apps/tear-on/ops/+x/tear_on_op.+x
COPY    | @.apps/tear-on/atlas/cells.rgba | house/@.apps/tear-on/atlas/cells.rgba
COPY    | &.widgits/_shared-lib/harness/fixtures/tear_offline_arena_chain.txt | house/@.apps/tear-on/ledger/web_chain.txt
RUN | $T/house/&.hq-apps/tear-on/ops/+x/tear_on_op.+x | project | $T/house
EXPECT_EXIT | 0 | the-projection-ran
EXPECT_OUT | tear-on: pages projected | it-says-the-pages-were-projected
EXPECT_HAS | house/@.apps/tear-on/tear-on-pchq/pieces/system/maps/tear-on/ranch/cells.txt | width=14 | the-ranch-page-is-14-wide
EXPECT_HAS | house/@.apps/tear-on/tear-on-pchq/pieces/system/maps/tear-on/ranch/cells.txt | 33,0,2 | the-gym-tile-is-on-the-ranch
EXPECT_HAS | house/@.apps/tear-on/tear-on-pchq/pieces/system/maps/tear-on/ranch/events.txt | 7 5 120 90 220 People1 0 2 1 R | rex-stands-where-the-chain-put-him
EXPECT_HAS | house/@.apps/tear-on/tear-on-pchq/pieces/system/maps/tear-on/ranch/events.txt | 6 3 60 130 230 People1 1 2 1 K | kai-is-on-the-ranch-in-his-element-colour
EXPECT_HAS | house/@.apps/tear-on/tear-on-pchq/pieces/system/maps/tear-on/arena/cells.txt | height=24 | the-arena-page-is-24-high
EXPECT_HAS | house/@.apps/tear-on/tear-on-pchq/pieces/system/maps/tear-on/arena/events.txt | 21 4 150 150 150 People1 5 2 1 * | a-default-fighter-is-drawn-grey-with-a-star
EXPECT_HAS | house/@.apps/tear-on/tear-on-pchq/pieces/system/maps/tear-on/arena/events.txt | 4 4 250 230 120 People1 4 2 1 M | mina-is-on-the-arena-floor
EXPECT_HAS | house/@.apps/tear-on/tear-on-pchq/pieces/system/maps/tear-on/arena/extrusion.pdl | desk_id            \p arena | the-page-file-names-its-desk
RUN | $T/house/&.hq-apps/tear-offline/ops/+x/tear_chain_op.+x | verify | $T/house/@.apps/tear-on/ledger/web_chain.txt
EXPECT_OUT | OK height=58 | projecting-never-changes-the-chain
CLEAN   |
CASE    | demo-and-do-are-rows-and-refuse-by-name
SCRATCH |
MKDIR   | house/@.apps/tear-on/atlas
MKDIR   | house/&.hq-apps/tear-offline/ops/+x
MKDIR   | house/&.hq-apps/tear-on/ops/+x
COPY    | &.hq-apps/tear-offline/ops/+x/tear_chain_op.+x | house/&.hq-apps/tear-offline/ops/+x/tear_chain_op.+x
COPY    | &.hq-apps/tear-on/ops/+x/tear_on_op.+x | house/&.hq-apps/tear-on/ops/+x/tear_on_op.+x
COPY    | @.apps/tear-on/atlas/cells.rgba | house/@.apps/tear-on/atlas/cells.rgba
RUN | $T/house/&.hq-apps/tear-on/ops/+x/tear_on_op.+x | demo | $T/house
EXPECT_EXIT | 0 | the-demo-seeded-an-empty-chain
EXPECT_HAS | house/@.apps/tear-on/ledger/web_chain.txt | ARENA\parena1\pffa\pyou\p | the-demo-arena-is-a-row-in-the-chain
EXPECT_HAS | house/@.apps/tear-on/tear-on-pchq/pieces/system/maps/tear-on/arena/events.txt | * | the-demo-arena-has-a-default-fighter-drawn
RUN | $T/house/&.hq-apps/tear-on/ops/+x/tear_on_op.+x | demo | $T/house
EXPECT_OUT | the chain already has rows | NEGATIVE-the-demo-never-seeds-a-chain-that-has-rows
RUN | $T/house/&.hq-apps/tear-on/ops/+x/tear_on_op.+x | do | $T/house | WOPT\prex\pcap\p30\pyou\p99
EXPECT_EXIT | 0 | a-wallet-option-is-one-row
EXPECT_HAS | house/@.apps/tear-on/ledger/web_chain.txt | WOPT\prex\pcap\p30\pyou\p99 | the-option-row-is-in-the-chain
RUN | $T/house/&.hq-apps/tear-on/ops/+x/tear_on_op.+x | do | $T/house | BUYITEM\prex\pcharm\pyou\p99
EXPECT_EXIT | 1 | the-cap-refuses-a-bigger-spend
EXPECT_OUT | cap: rex may spend at most 30 coins at a time | the-reason-is-named
CLEAN   |
CASE    | book-launcher-and-menu-are-data-and-no-shell
SCRATCH |
COPY    | @.apps/tear-on/game.pdl | game.pdl
COPY    | @.apps/tear-on/rooms.pdl | rooms.pdl
COPY    | @.apps/tear-on/verbs.pdl | verbs.pdl
COPY    | @.apps/tear-on/tear-on-pchq/pieces/system/maps/tear-on/game.pdl | pchq_game.pdl
COPY    | &.hq-apps/tear-on/open_tear_on.sh | shim.sh
COPY    | #.desktop/livedesk_taskbar.pdl | taskbar.pdl
COPY    | #.desktop/livedesk_launchers.pdl | launchers.pdl
EXPECT_HAS | pchq_game.pdl | desk_1_id          \p ranch | the-first-page-is-the-ranch
EXPECT_HAS | pchq_game.pdl | desk_2_id          \p arena | the-second-page-is-the-arena
EXPECT_HAS | rooms.pdl | ROOM \p ranch | the-editor-resolves-the-ranch-page
EXPECT_HAS | rooms.pdl | ROOM \p arena | the-editor-resolves-the-arena-page
EXPECT_HAS | verbs.pdl | VERB \p WOPT | the-wallet-option-verb-is-in-the-manifest
EXPECT_HAS | shim.sh | tear_on_op.+x" --open | the-shim-only-calls-the-C-op
EXPECT_LACKS | shim.sh | case  | NEGATIVE-the-shim-has-no-logic
EXPECT_HAS | taskbar.pdl | network_menu_9_label  \p tear-off\n | the-old-window-is-renamed-tear-off
EXPECT_HAS | taskbar.pdl | network_menu_9_cmd    \p livedesk:open-network:tearoffline\n | the-old-window-keeps-its-command
EXPECT_HAS | taskbar.pdl | network_menu_10_cmd   \p livedesk:open-network:tearon\n | the-network-menu-has-a-tear-on-cell
EXPECT_HAS | launchers.pdl | launcher_network_tearon \p &.hq-apps/tear-on/open_tear_on.sh | the-launcher-row-points-at-the-shim
CLEAN   |
CASE    | driver-plays-the-book-like-the-editor-does
SCRATCH |
MKDIR   | house/@.apps/tear-on/atlas
MKDIR   | house/@.apps/tear-on/ops/+x
MKDIR   | house/&.hq-apps/tear-offline/ops/+x
MKDIR   | house/&.hq-apps/tear-on/ops/+x
MKDIR   | editor/state/world
MKDIR   | editor/rpg-edit-hq-pchq/pieces/world_01
MKDIR   | editor/rpg-edit-hq-pchq/pieces/system/widget_cmds
WRITE   | editor/rpg-edit-hq-pchq/pieces/world_01/state.txt | map_id=tear-on\ndesk_id=arena\n
COPY    | &.hq-apps/tear-offline/ops/+x/tear_chain_op.+x | house/&.hq-apps/tear-offline/ops/+x/tear_chain_op.+x
COPY    | &.hq-apps/tear-on/ops/+x/tear_on_op.+x | house/&.hq-apps/tear-on/ops/+x/tear_on_op.+x
COPY    | @.apps/tear-on/ops/+x/tear_on_driver.+x | house/@.apps/tear-on/ops/+x/tear_on_driver.+x
COPY    | @.apps/tear-on/ops/+x/tear_on_ctl.+x | house/@.apps/tear-on/ops/+x/tear_on_ctl.+x
COPY    | @.apps/tear-on/atlas/cells.rgba | house/@.apps/tear-on/atlas/cells.rgba
WRITE   | editor/state/world/switches.txt | running=1\nint=1\n
RUN | $T/house/&.hq-apps/tear-on/ops/+x/tear_on_op.+x | demo | $T/house
EXPECT_EXIT | 0 | the-demo-chain-is-seeded-by-rows
ENV     | TEAR_ON_REFRESH_WAIT | 1
SPAWN   | drv | $T/house/@.apps/tear-on/ops/+x/tear_on_driver.+x | $T/house | $T/house/@.apps/tear-on | $T/editor
WAIT_HAS | editor/state/game_ui.txt | gm_on=1 | 8000 | the-driver-publishes-the-game-bar-feed
EXPECT_HAS | editor/state/game_ui.txt | gm_title=TEAR-IT Ranch  -  you | the-bar-is-titled
EXPECT_HAS | editor/state/game_ui.txt | rex the Cosmic | the-bar-shows-the-selected-pet
EXPECT_HAS | editor/state/game_ui.txt | gmb_0_label=[Care] | the-first-button-is-the-care-tab
EXPECT_HAS | editor/state/game_ui.txt | gmb_5_label=Hatch a pet | the-care-tab-starts-with-hatch
EXPECT_HAS | editor/state/game_ui.txt | Refresh board (slow) | the-care-tab-has-the-refresh-board-button
EXPECT_HAS | editor/state/game_ui.txt | tear_on_ctl.+x' tab_arena | a-button-action-runs-the-ctl-program
RUN | $T/house/@.apps/tear-on/ops/+x/tear_on_ctl.+x | tab_arena | $T/house/@.apps/tear-on/play
WAIT_HAS | editor/state/game_ui.txt | gmb_5_label=Open a 1v1 | 12000 | the-arena-tab-shows-the-arena-buttons
EXPECT_HAS | editor/state/game_ui.txt | fighters: | the-arena-tab-lists-the-fighters
EXPECT_LACKS | editor/state/game_ui.txt | Hatch a pet | NEGATIVE-the-arena-tab-hides-the-care-buttons
RUN | $T/house/@.apps/tear-on/ops/+x/tear_on_ctl.+x | tab_care | $T/house/@.apps/tear-on/play
WAIT_HAS | editor/state/game_ui.txt | gmb_5_label=Hatch a pet | 12000 | the-care-tab-is-back
RUN | $T/house/@.apps/tear-on/ops/+x/tear_on_ctl.+x | hatch | $T/house/@.apps/tear-on/play
WAIT_HAS | editor/state/game_ui.txt | hatched | 12000 | the-hatch-button-hatched-a-pet
EXPECT_HAS | house/@.apps/tear-on/ledger/web_chain.txt | PET\pmochi1\p | the-hatch-is-a-row-in-the-chain
EXPECT_HAS | editor/rpg-edit-hq-pchq/pieces/system/widget_cmds/inbox.txt | CONFIRM_SET_DESK:ranch | after-a-hatch-the-driver-asks-the-board-to-reload-the-ranch-page
RUN | $T/house/@.apps/tear-on/ops/+x/tear_on_ctl.+x | faucet | $T/house/@.apps/tear-on/play
WAIT_HAS | editor/state/game_ui.txt | the pet claimed 1000 from the faucet | 12000 | the-faucet-button-paid-the-new-pet
EXPECT_HAS | editor/state/game_ui.txt | 1000 coins | the-bar-shows-the-pets-coins
RUN | $T/house/@.apps/tear-on/ops/+x/tear_on_ctl.+x | wo_cap | $T/house/@.apps/tear-on/play | 10 | 20
WAIT_HAS | editor/state/game_ui.txt | wallet cap is now 10 | 12000 | the-wallet-cap-button-set-a-cap-(extra-click-arguments-are-ignored)
EXPECT_HAS | house/@.apps/tear-on/ledger/web_chain.txt | WOPT\pmochi1\pcap\p10\pyou\p | the-cap-is-a-WOPT-row
RUN | $T/house/@.apps/tear-on/ops/+x/tear_on_ctl.+x | feed_meat | $T/house/@.apps/tear-on/play
WAIT_HAS | editor/state/game_ui.txt | cap: mochi1 may spend at most 10 coins at a time | 12000 | the-bar-shows-the-rules-refusal-by-name
RUN | $T/house/@.apps/tear-on/ops/+x/tear_on_ctl.+x | wo_sale | $T/house/@.apps/tear-on/play
WAIT_HAS | editor/state/game_ui.txt | the pet is locked from sale | 12000 | the-sale-lock-button-locks-the-pet
WRITE   | editor/rpg-edit-hq-pchq/pieces/world_01/state.txt | map_id=tear-on\ndesk_id=ranch\n
RUN | $T/house/@.apps/tear-on/ops/+x/tear_on_ctl.+x | arena_fight | $T/house/@.apps/tear-on/play
WAIT_HAS | editor/state/game_ui.txt | the fight is over | 15000 | the-fight-button-ran-the-demo-arena-fight
EXPECT_HAS | editor/state/game_ui.txt | winners | the-bar-shows-the-winners
EXPECT_HAS | house/@.apps/tear-on/ledger/web_chain.txt | FIGHT\parena1\pyou\p | the-fight-is-a-row-in-the-chain
EXPECT_HAS | editor/rpg-edit-hq-pchq/pieces/system/widget_cmds/inbox.txt | CONFIRM_SET_DESK:arena | after-a-fight-the-driver-asks-the-board-to-reload-the-arena-page
RUN | $T/house/@.apps/tear-on/ops/+x/tear_on_ctl.+x | arena_join | $T/house/@.apps/tear-on/play
WAIT_HAS | editor/state/game_ui.txt | that arena is closed | 12000 | NEGATIVE-joining-a-finished-arena-is-refused
RUN | $T/house/@.apps/tear-on/ops/+x/tear_on_ctl.+x | FEED | $T/house/@.apps/tear-on/play
EXPECT_EXIT | 2 | NEGATIVE-a-command-word-must-be-lower-case
WRITE   | editor/rpg-edit-hq-pchq/pieces/world_01/state.txt | map_id=tear-on\ndesk_id=ranch\n
RUN | $T/house/@.apps/tear-on/ops/+x/tear_on_ctl.+x | refresh | $T/house/@.apps/tear-on/play
WAIT_HAS | editor/state/game_ui.txt | board redrawn from the chain | 25000 | the-refresh-button-switches-the-board-away-and-back-and-says-so
WRITE   | editor/rpg-edit-hq-pchq/pieces/world_01/state.txt | map_id=hai-pal\ndesk_id=home\n
RUN | $T/house/@.apps/tear-on/ops/+x/tear_on_ctl.+x | feed_bread | $T/house/@.apps/tear-on/play
WAIT_HAS | editor/state/game_ui.txt | fed bread | 12000 | the-feed-button-fed-the-pet
EXPECT_LACKS | editor/rpg-edit-hq-pchq/pieces/system/widget_cmds/inbox.txt | CONFIRM_SET_DESK:home | NEGATIVE-nothing-is-sent-to-the-board-while-the-editor-is-on-another-book
RUN | $T/house/@.apps/tear-on/ops/+x/tear_on_ctl.+x | refresh | $T/house/@.apps/tear-on/play
WAIT_HAS | editor/state/game_ui.txt | open the tear-on book first | 12000 | NEGATIVE-refresh-is-refused-while-the-editor-is-on-another-book
RUN | $T/house/@.apps/tear-on/ops/+x/tear_on_ctl.+x | close | $T/house/@.apps/tear-on/play
WAIT_HAS | editor/state/world/switches.txt | running=0 | 12000 | the-close-button-stops-the-game-(running-0)
WAIT_HAS | editor/state/game_ui.txt | gm_on=\n | 12000 | the-bar-disappears-when-the-driver-ends
CLEAN   |
