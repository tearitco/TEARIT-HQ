# --- TRAP LABELS, on a fixture page.pdl written here (so these checks do not depend on the stand-in names): labels that start with or contain filler / number / command words, that nest ("Gold" in "Golden Row" in
# "Golden Ratio Row"), end in a digit, carry a literal \n, are redefined (the LAST row of a key wins), are emptied (empty text = no label), come from a KIND row, or equal another tile's id. ---
CASE    | labels_fixture
COPYDIR | @.apps/deskopoly | app2 | deskopoly-pchq,state,shots,tests
WRITE   | app2/rulesets/classic/page.pdl | LABELS | on\nLABEL | chance | Luck\nLABEL | chest | Lost & Found\nLABEL | Start | Home Base\nLABEL | Brown1 | Cash Cow\nLABEL | Brown2 | The Hub\nLABEL | Sky1 | Row Row\nLABEL | Sky2 | Hall Pass\nLABEL | Sky3 | Lane Works\nLABEL | Pink1 | Tile Works\nLABEL | Pink2 | Fifty Five\nLABEL | Pink3 | Golden Row\nLABEL | Orange1 | Golden Ratio Row\nLABEL | Orange2 | Gold\nLABEL | Orange3 | Two\\nLines\nLABEL | Red1 | Old Pier\nLABEL | Red1 | New Pier\nLABEL | Red2 | \nLABEL | street | Avenue\nLABEL | Line1 | Train One\nLABEL | rail | Choo Choo\nLABEL | Power | Pipe\nLABEL | Water | Navy1\nLABEL | Yellow1 | Gold Rush\nLABEL | Navy1 | Hub Row\nLABEL | Navy2 | Tower 7\n
RUN | /usr/bin/grep | -c | Brown1 \p Cash Cow | $T/app2/rulesets/classic/page.pdl
EXPECT_OUT | 1 | VACUITY-the-fixture-page-was-written
# labels that start with a filler word are names when the whole label is typed
RUN | $HOUSE/@.apps/deskopoly/ops/+x/deskopoly_chat.+x | --parse | $T/app2 | offer p2 give Cash Cow get 100
EXPECT_OUT_IS | ok offer p2 give prop:1 get cash:100\nunderstood: offer p2: you give Brown1, you get 100 cash | FILLER-WORD-FIRST-Cash-Cow-is-Brown1
RUN | $HOUSE/@.apps/deskopoly/ops/+x/deskopoly_chat.+x | --parse | $T/app2 | offer p2 give The Hub and 5 get cash cow
EXPECT_OUT_IS | ok offer p2 give prop:3+cash:5 get prop:1\nunderstood: offer p2: you give Brown2 + 5 cash, you get Brown1 | FILLER-WORD-FIRST-The-Hub-is-Brown2-and-then-the-filler-cash-is-still-filler
RUN | $HOUSE/@.apps/deskopoly/ops/+x/deskopoly_chat.+x | --parse | $T/app2 | offer p2 give 100 cash and Cash Cow
EXPECT_OUT_IS | ok offer p2 give prop:1+cash:100\nunderstood: offer p2: you give Brown1 + 100 cash, you get nothing | POSITIVE-CONTROL-100-cash-is-still-100-dollars-beside-a-label-that-starts-with-cash
RUN | $HOUSE/@.apps/deskopoly/ops/+x/deskopoly_chat.+x | --parse | $T/app2 | offer p2 give cash
EXPECT_OUT_IS | refused: "give" needs something after it: tiles, a number for cash, a luck/fund card, or "nothing" | a-lone-filler-word-is-still-filler-not-a-label-word
RUN | $HOUSE/@.apps/deskopoly/ops/+x/deskopoly_chat.+x | --parse | $T/app2 | offer p2 give cash 100 get the
EXPECT_OUT_IS | refused: "get" needs something after it: tiles, a number for cash, a luck/fund card, or "nothing" | a-lone-the-is-filler
RUN | $HOUSE/@.apps/deskopoly/ops/+x/deskopoly_chat.+x | --parse | $T/app2 | offer p2 give Tile Works get 5
EXPECT_OUT_IS | ok offer p2 give prop:11 get cash:5\nunderstood: offer p2: you give Pink1, you get 5 cash | the-label-Tile-Works-beats-the-filler-word-tile
RUN | $HOUSE/@.apps/deskopoly/ops/+x/deskopoly_chat.+x | --parse | $T/app2 | offer p2 give tile 11 and tile 13 get 5
EXPECT_OUT_IS | ok offer p2 give prop:11+prop:13 get cash:5\nunderstood: offer p2: you give Pink1 + Pink2, you get 5 cash | POSITIVE-CONTROL-tile-N-still-means-tile-N
# labels made of words that sound like numbers, directions or place words
RUN | $HOUSE/@.apps/deskopoly/ops/+x/deskopoly_chat.+x | --parse | $T/app2 | offer p2 give Row Row get Hall Pass
EXPECT_OUT_IS | ok offer p2 give prop:6 get prop:8\nunderstood: offer p2: you give Sky1, you get Sky2 | ROW-ROW-and-HALL-PASS-are-names
RUN | $HOUSE/@.apps/deskopoly/ops/+x/deskopoly_chat.+x | --parse | $T/app2 | offer p2 give Lane Works and Fifty Five get 50
EXPECT_OUT_IS | ok offer p2 give prop:9+prop:13 get cash:50\nunderstood: offer p2: you give Sky3 + Pink2, you get 50 cash | LANE-WORKS-and-FIFTY-FIVE-are-names-and-the-number-after-them-is-cash
RUN | $HOUSE/@.apps/deskopoly/ops/+x/deskopoly_chat.+x | --parse | $T/app2 | offer p2 give Hall get 5
EXPECT_OUT_IS | ok offer p2 give prop:8 get cash:5\nunderstood: offer p2: you give Sky2, you get 5 cash | the-FIRST-word-of-a-label-is-a-unique-prefix-Hall-is-Hall-Pass
RUN | $HOUSE/@.apps/deskopoly/ops/+x/deskopoly_chat.+x | --parse | $T/app2 | offer p2 give Pass get 5
EXPECT_OUT_IS | refused: unknown name "pass" (tile ids like Navy2, Line1, Water; a tile name as written on the board; or a tile number) | the-second-word-of-a-label-alone-is-not-a-name-even-when-it-is-a-command-word
RUN | $HOUSE/@.apps/deskopoly/ops/+x/deskopoly_chat.+x | --parse | $T/app2 | offer p2 give Works get 5
EXPECT_OUT_IS | refused: unknown name "works" (tile ids like Navy2, Line1, Water; a tile name as written on the board; or a tile number) | WORKS-alone-is-unknown-it-is-the-end-of-Lane-Works-and-Tile-Works
RUN | $HOUSE/@.apps/deskopoly/ops/+x/deskopoly_chat.+x | --parse | $T/app2 | offer p2 give Row get 5
EXPECT_OUT_IS | ok offer p2 give prop:6 get cash:5\nunderstood: offer p2: you give Sky1, you get 5 cash | ROW-alone-is-Row-Row-by-its-first-word-while-WORKS-and-PASS-alone-(second-words)-are-unknown
RUN | $HOUSE/@.apps/deskopoly/ops/+x/deskopoly_chat.+x | --parse | $T/app2 | offer p2 give Tower 7 7
EXPECT_OUT_IS | ok offer p2 give prop:39+cash:7\nunderstood: offer p2: you give Navy2 + 7 cash, you get nothing | a-label-ending-in-a-digit-Tower-7-and-then-a-number-is-cash
RUN | $HOUSE/@.apps/deskopoly/ops/+x/deskopoly_chat.+x | --parse | $T/app2 | offer p2 give Tower get 5
EXPECT_OUT_IS | ok offer p2 give prop:39 get cash:5\nunderstood: offer p2: you give Navy2, you get 5 cash | the-first-word-Tower-is-a-unique-prefix
# nesting: Gold < Golden Row < Golden Ratio Row (longest whole label first, never a swallow)
RUN | $HOUSE/@.apps/deskopoly/ops/+x/deskopoly_chat.+x | --parse | $T/app2 | offer p2 give Gold get Golden Row
EXPECT_OUT_IS | ok offer p2 give prop:18 get prop:14\nunderstood: offer p2: you give Orange2, you get Pink3 | NESTED-Gold-is-the-whole-label-of-Orange2-not-a-prefix-of-the-two-Golden-labels
RUN | $HOUSE/@.apps/deskopoly/ops/+x/deskopoly_chat.+x | --parse | $T/app2 | offer p2 give Golden Ratio Row get Golden Row
EXPECT_OUT_IS | ok offer p2 give prop:16 get prop:14\nunderstood: offer p2: you give Orange1, you get Pink3 | NESTED-Golden-Ratio-Row-is-Orange1-and-Golden-Row-is-Pink3
RUN | $HOUSE/@.apps/deskopoly/ops/+x/deskopoly_chat.+x | --parse | $T/app2 | offer p2 give Golden Row Golden Ratio Row Gold get 5
EXPECT_OUT_IS | ok offer p2 give prop:14+prop:16+prop:18 get cash:5\nunderstood: offer p2: you give Pink3 + Orange1 + Orange2, you get 5 cash | NESTED-all-three-in-one-side-each-its-own-tile
RUN | $HOUSE/@.apps/deskopoly/ops/+x/deskopoly_chat.+x | --parse | $T/app2 | offer p2 give Gold Rush get 5
EXPECT_OUT_IS | ok offer p2 give prop:26 get cash:5\nunderstood: offer p2: you give Yellow1, you get 5 cash | LONGEST-FIRST-Gold-Rush-is-Yellow1-and-does-not-become-Gold-plus-the-unknown-word-rush
RUN | $HOUSE/@.apps/deskopoly/ops/+x/deskopoly_chat.+x | --parse | $T/app2 | offer p2 give Gold Rush Gold get 5
EXPECT_OUT_IS | ok offer p2 give prop:18+prop:26 get cash:5\nunderstood: offer p2: you give Orange2 + Yellow1, you get 5 cash | LONGEST-FIRST-Gold-Rush-then-Gold-two-tiles
RUN | $HOUSE/@.apps/deskopoly/ops/+x/deskopoly_chat.+x | --parse | $T/app2 | offer p2 give Golden get 5
EXPECT_OUT_IS | refused: ambiguous name "golden": could be Pink3 (Golden Row) (14), Orange1 (Golden Ratio Row) (16) | NESTED-Golden-alone-is-the-two-longer-labels-and-lists-both
RUN | $HOUSE/@.apps/deskopoly/ops/+x/deskopoly_chat.+x | --parse | $T/app2 | offer p2 give Golden R get 5
EXPECT_OUT_IS | refused: ambiguous name "golden r": could be Pink3 (Golden Row) (14), Orange1 (Golden Ratio Row) (16) | NESTED-Golden-R-is-a-prefix-of-both-second-words
RUN | $HOUSE/@.apps/deskopoly/ops/+x/deskopoly_chat.+x | --parse | $T/app2 | offer p2 give Golden Ra get 5
EXPECT_OUT_IS | ok offer p2 give prop:16 get cash:5\nunderstood: offer p2: you give Orange1, you get 5 cash | NESTED-Golden-Ra-is-only-a-prefix-of-Ratio
# a literal \n in the page.pdl text is a word break (the same reading the board's `page` gives it)
RUN | $HOUSE/@.apps/deskopoly/ops/+x/deskopoly_chat.+x | --parse | $T/app2 | offer p2 give Two Lines get 5
EXPECT_OUT_IS | ok offer p2 give prop:19 get cash:5\nunderstood: offer p2: you give Orange3, you get 5 cash | BACKSLASH-N-in-the-label-is-a-space-Two-Lines-is-Orange3
# the LAST row of a key wins; empty text = no label; a kind row names the tiles that have no row of their own, an own row beats it
RUN | $HOUSE/@.apps/deskopoly/ops/+x/deskopoly_chat.+x | --parse | $T/app2 | offer p2 give New Pier get 5
EXPECT_OUT_IS | ok offer p2 give prop:21 get cash:5\nunderstood: offer p2: you give Red1, you get 5 cash | LAST-ROW-WINS-the-second-Red1-row-New-Pier
RUN | $HOUSE/@.apps/deskopoly/ops/+x/deskopoly_chat.+x | --parse | $T/app2 | offer p2 give Old Pier get 5
EXPECT_OUT_IS | refused: unknown name "old" (tile ids like Navy2, Line1, Water; a tile name as written on the board; or a tile number) | LAST-ROW-WINS-the-replaced-name-Old-Pier-is-gone
RUN | $HOUSE/@.apps/deskopoly/ops/+x/deskopoly_chat.+x | --parse | $T/app2 | offer p2 give Avenue get 5
EXPECT_OUT_IS | refused: ambiguous name "avenue": could be Red3 (Avenue) (24), Yellow2 (Avenue) (27), Yellow3 (Avenue) (29), Green1 (Avenue) (31), Green2 (Avenue) (32), Green3 (Avenue) (34) | KIND-ROW-street-Avenue-names-the-six-streets-without-a-row-of-their-own-and-NOT-Red2-(empty-row)-or-Red1-(own-row)
RUN | $HOUSE/@.apps/deskopoly/ops/+x/deskopoly_chat.+x | --parse | $T/app2 | offer p2 give Red 2 get 5
EXPECT_OUT_IS | ok offer p2 give prop:23 get cash:5\nunderstood: offer p2: you give Red2, you get 5 cash | EMPTY-TEXT-row-no-label-but-the-id-Red-2-still-names-the-tile
RUN | $HOUSE/@.apps/deskopoly/ops/+x/deskopoly_chat.+x | --parse | $T/app2 | offer p2 give Train One get Choo
EXPECT_OUT_IS | refused: ambiguous name "choo": could be Line2 (Choo Choo) (15), Line3 (Choo Choo) (25), Line4 (Choo Choo) (35) | OWN-ROW-beats-KIND-ROW-Line1-is-Train-One-so-Choo-Choo-lists-only-Line2-3-4
RUN | $HOUSE/@.apps/deskopoly/ops/+x/deskopoly_chat.+x | --parse | $T/app2 | offer p2 give Train One get 5
EXPECT_OUT_IS | ok offer p2 give prop:5 get cash:5\nunderstood: offer p2: you give Line1, you get 5 cash | OWN-ROW-Train-One-is-Line1
# an id beats a label that equals it (Water is labelled Navy1 here; Navy1 is also the id of tile 37)
RUN | $HOUSE/@.apps/deskopoly/ops/+x/deskopoly_chat.+x | --parse | $T/app2 | offer p2 give Navy1 get 5
EXPECT_OUT_IS | ok offer p2 give prop:37 get cash:5\nunderstood: offer p2: you give Navy1, you get 5 cash | ID-WINS-Navy1-is-tile-37-though-Water-wears-that-label
RUN | $HOUSE/@.apps/deskopoly/ops/+x/deskopoly_chat.+x | --parse | $T/app2 | offer p2 give Water get 5
EXPECT_OUT_IS | ok offer p2 give prop:28 get cash:5\nunderstood: offer p2: you give Water, you get 5 cash | and-Water-is-still-reachable-by-its-id
# deck labels and non-property labels
RUN | $HOUSE/@.apps/deskopoly/ops/+x/deskopoly_chat.+x | --parse | $T/app2 | offer p2 give Home Base get 5
EXPECT_OUT_IS | refused: Start (tile 0) is a go tile, not a property | a-label-of-a-corner-is-recognised-and-refused-like-its-id
RUN | $HOUSE/@.apps/deskopoly/ops/+x/deskopoly_chat.+x | --parse | $T/app2 | offer p2 give Lost get Found
EXPECT_OUT_IS | refused: unknown name "lost" (tile ids like Navy2, Line1, Water; a tile name as written on the board; or a tile number) | DECK-label-Lost-and-Found-is-no-tile-in-the-fixture-either
RUN | $HOUSE/@.apps/deskopoly/ops/+x/deskopoly_chat.+x | --parse | $T/app2 | offer p2 give Luck get 5
EXPECT_OUT_IS | ok offer p2 give card:luck get cash:5\nunderstood: offer p2: you give luck card, you get 5 cash | DECK-label-Luck-is-the-luck-card
# tile verbs with trap labels
RUN | $HOUSE/@.apps/deskopoly/ops/+x/deskopoly_chat.+x | --parse | $T/app2 | mortgage Cash Cow
EXPECT_OUT_IS | ok mortgage 1\nunderstood: mortgage Brown1 (tile 1) | VERB-mortgage-a-label-that-starts-with-the-filler-cash
RUN | $HOUSE/@.apps/deskopoly/ops/+x/deskopoly_chat.+x | --parse | $T/app2 | mortgage tile 5
EXPECT_OUT_IS | ok mortgage 5\nunderstood: mortgage Line1 (tile 5) | VERB-POSITIVE-CONTROL-tile-5-is-tile-5
RUN | $HOUSE/@.apps/deskopoly/ops/+x/deskopoly_chat.+x | --parse | $T/app2 | mortgage Tile Works
EXPECT_OUT_IS | ok mortgage 11\nunderstood: mortgage Pink1 (tile 11) | VERB-mortgage-Tile-Works
RUN | $HOUSE/@.apps/deskopoly/ops/+x/deskopoly_chat.+x | --parse | $T/app2 | build Tower 7
EXPECT_OUT_IS | ok build 39\nunderstood: build Navy2 (tile 39) | VERB-build-Tower-7
RUN | $HOUSE/@.apps/deskopoly/ops/+x/deskopoly_chat.+x | --parse | $T/app2 | build Avenue
EXPECT_OUT_IS | refused: ambiguous name "avenue": could be Red3 (Avenue) (24), Yellow2 (Avenue) (27), Yellow3 (Avenue) (29), Green1 (Avenue) (31), Green2 (Avenue) (32), Green3 (Avenue) (34) | VERB-build-Avenue-ambiguous
RUN | $HOUSE/@.apps/deskopoly/ops/+x/deskopoly_chat.+x | --parse | $T/app2 | build Pipe
EXPECT_OUT_IS | refused: Power (tile 12) is a util tile, not a street (only streets take houses) | VERB-build-a-utility-label
RUN | $HOUSE/@.apps/deskopoly/ops/+x/deskopoly_chat.+x | --parse | $T/app2 | sell Row Row Sky 1
EXPECT_OUT_IS | ok sell 6\nunderstood: sell Sky1 (tile 6) | VERB-sell-label-and-id-of-the-same-tile

# --- ids only, EXACTLY as before: no LABEL rows at all, an empty page.pdl, and no page.pdl at all (the old pins of `refusals`, in the old wording) ---
CASE    | labels_absent
COPYDIR | @.apps/deskopoly | app3 | deskopoly-pchq,state,shots,tests
WRITE   | app3/rulesets/classic/page.pdl | LABELS | on\n# no LABEL rows\n
COPYDIR | @.apps/deskopoly | app4 | deskopoly-pchq,state,shots,tests,page.pdl
EXPECT_NOFILE | $T/app4/rulesets/classic/page.pdl | VACUITY-app4-has-no-page.pdl-at-all
EXPECT_EXISTS | $T/app3/rulesets/classic/page.pdl | VACUITY-app3-has-a-page.pdl-with-no-LABEL-rows
RUN | $HOUSE/@.apps/deskopoly/ops/+x/deskopoly_chat.+x | --parse | $T/app3 | offer p3 give Navy get Pink 1
EXPECT_OUT_IS | refused: ambiguous name "navy": could be Navy1 (37), Navy2 (39) | NO-LABEL-ROWS-the-candidate-list-is-the-old-one-id-and-number
RUN | $HOUSE/@.apps/deskopoly/ops/+x/deskopoly_chat.+x | --parse | $T/app4 | offer p3 give Navy get Pink 1
EXPECT_OUT_IS | refused: ambiguous name "navy": could be Navy1 (37), Navy2 (39) | NO-PAGE-PDL-the-same-old-list
RUN | $HOUSE/@.apps/deskopoly/ops/+x/deskopoly_chat.+x | --parse | $T/app3 | offer p3 give Zork
EXPECT_OUT_IS | refused: unknown name "zork" (tile ids like Navy2, Line1, Water; or a tile number) | NO-LABEL-ROWS-the-old-unknown-name-wording
RUN | $HOUSE/@.apps/deskopoly/ops/+x/deskopoly_chat.+x | --parse | $T/app4 | offer p3 give Zork
EXPECT_OUT_IS | refused: unknown name "zork" (tile ids like Navy2, Line1, Water; or a tile number) | NO-PAGE-PDL-the-old-unknown-name-wording
RUN | $HOUSE/@.apps/deskopoly/ops/+x/deskopoly_chat.+x | --parse | $T/app3 | offer p3 give Coil Plaza
EXPECT_OUT_IS | refused: unknown name "coil" (tile ids like Navy2, Line1, Water; or a tile number) | NO-LABEL-ROWS-a-label-name-means-nothing-without-the-rows
RUN | $HOUSE/@.apps/deskopoly/ops/+x/deskopoly_chat.+x | --parse | $T/app4 | offer p3 give Navy 2 and 100 get Pink 1
EXPECT_OUT_IS | ok offer p3 give prop:39+cash:100 get prop:11\nunderstood: offer p3: you give Navy2 + 100 cash, you get Pink1 | NO-PAGE-PDL-ids-and-prefixes-work-as-before
RUN | $HOUSE/@.apps/deskopoly/ops/+x/deskopoly_chat.+x | --parse | $T/app3 | offer p2 give wat get Line1 25
EXPECT_OUT_IS | ok offer p2 give prop:28 get prop:5+cash:25\nunderstood: offer p2: you give Water, you get Line1 + 25 cash | NO-LABEL-ROWS-the-unique-id-prefix-and-name-then-cash
RUN | $HOUSE/@.apps/deskopoly/ops/+x/deskopoly_chat.+x | --parse | $T/app4 | build Red 2
EXPECT_OUT_IS | ok build 23\nunderstood: build Red2 (tile 23) | NO-PAGE-PDL-a-tile-verb
RUN | $HOUSE/@.apps/deskopoly/ops/+x/deskopoly_chat.+x | --parse | $T/app4 | build Red
EXPECT_OUT_IS | refused: ambiguous name "red": could be Red1 (21), Red2 (23), Red3 (24) | NO-PAGE-PDL-ambiguous-in-a-tile-verb-old-list

# --- THE LEDGER IS THE SAME BYTES whether a tile is typed by id or by its on-screen label (prefix 300: p1 to act in PRE with 41 cash; p2 owns Power = `Spin Works`). Direct engine verbs (d7, ids) vs chat (c7, labels). ---
CASE    | labels_equivalence
MKDIR   | d7
MKDIR   | c7
RUN | /usr/bin/cp | $T/m/ledger.txt | $T/d7/ledger.txt
RUN | /usr/bin/sed | -i | 301,$d | $T/d7/ledger.txt
RUN | /usr/bin/cp | $T/d7/ledger.txt | $T/c7/ledger.txt
RUN | $HOUSE/@.apps/deskopoly/ops/+x/deskopoly.+x | $T/app | $T/d7 | offer | p2 | give | cash:20 | get | prop:12 | as=p1
EXPECT_OUT | p1 offer: id=1;give=cash:20;get=prop:12;round=1 | DIRECT-offer-with-the-tile-number
RUN | $HOUSE/@.apps/deskopoly/ops/+x/deskopoly_chat.+x | $T/app | $T/c7 | as=p1 | offer p2 give 20 get Spin Works
EXPECT_OUT | ok offer p2 give cash:20 get prop:12 | CHAT-the-label-is-sent-as-the-tile-number-prop-12
EXPECT_OUT | p1 offer: id=1;give=cash:20;get=prop:12;round=1 | CHAT-the-engine-answer-is-the-direct-answer
RUN | $HOUSE/@.apps/deskopoly/ops/+x/deskopoly.+x | $T/app | $T/d7 | accept | 1 | as=p2
RUN | $HOUSE/@.apps/deskopoly/ops/+x/deskopoly_chat.+x | $T/app | $T/c7 | as=p2 | accept 1
EXPECT_OUT | p2 accept: done;give=cash:20;get=prop:12;interest-0;interest-0 | CHAT-accept
RUN | $HOUSE/@.apps/deskopoly/ops/+x/deskopoly.+x | $T/app | $T/d7 | offer | p3 | give | prop:12 | get | cash:5 | as=p1
RUN | $HOUSE/@.apps/deskopoly/ops/+x/deskopoly_chat.+x | $T/app | $T/c7 | as=p1 | offer p3 give spin works get 5
EXPECT_OUT | ok offer p3 give prop:12 get cash:5 | CHAT-a-lower-case-label-after-the-earlier-trade-is-sent-as-the-id
RUN | /usr/bin/cmp | $T/d7/ledger.txt | $T/c7/ledger.txt
EXPECT_EXIT | 0 | LABEL-AND-ID-LEDGERS-ARE-BYTE-IDENTICAL-same-rows-for-offer-and-accept
RUN | /usr/bin/grep | -c | ^ | $T/c7/ledger.txt
EXPECT_OUT | 303 | VACUITY-the-chat-game-really-gained-the-rows-300-plus-offer-accept-and-the-last-offer
RUN | /usr/bin/grep | -c | ^ | $T/m/ledger.txt
EXPECT_OUT | 831 | and-the-source-ledger-was-not-touched
# mortgage / unmortgage / build / sell by label on the other prefixes
MKDIR   | d8
MKDIR   | c8
RUN | /usr/bin/cp | $T/m/ledger.txt | $T/d8/ledger.txt
RUN | /usr/bin/sed | -i | 301,$d | $T/d8/ledger.txt
RUN | /usr/bin/cp | $T/d8/ledger.txt | $T/c8/ledger.txt
RUN | $HOUSE/@.apps/deskopoly/ops/+x/deskopoly.+x | $T/app | $T/d8 | unmortgage | 1 | as=p1
RUN | $HOUSE/@.apps/deskopoly/ops/+x/deskopoly_chat.+x | $T/app | $T/c8 | as=p1 | unmortgage Seed Lane
EXPECT_OUT | p1 unmortgage: lifted;pay=33 | CHAT-unmortgage-by-label
RUN | $HOUSE/@.apps/deskopoly/ops/+x/deskopoly.+x | $T/app | $T/d8 | mortgage | 1 | as=p1
RUN | $HOUSE/@.apps/deskopoly/ops/+x/deskopoly_chat.+x | $T/app | $T/c8 | as=p1 | MORTGAGE seed lane
EXPECT_OUT | p1 mortgage: mortgaged;get=30 | CHAT-mortgage-by-label-in-capitals
RUN | /usr/bin/cmp | $T/d8/ledger.txt | $T/c8/ledger.txt
EXPECT_EXIT | 0 | mortgage-by-label-ledgers-byte-identical
MKDIR   | d9
MKDIR   | c9
RUN | /usr/bin/cp | $T/m/ledger.txt | $T/d9/ledger.txt
RUN | /usr/bin/sed | -i | 83,$d | $T/d9/ledger.txt
RUN | /usr/bin/cp | $T/d9/ledger.txt | $T/c9/ledger.txt
RUN | $HOUSE/@.apps/deskopoly/ops/+x/deskopoly.+x | $T/app | $T/d9 | build | 1 | as=p1
RUN | $HOUSE/@.apps/deskopoly/ops/+x/deskopoly_chat.+x | $T/app | $T/c9 | as=p1 | build Seed Lane
EXPECT_OUT | p1 build: houses=1;cost=50 | CHAT-build-by-label
RUN | $HOUSE/@.apps/deskopoly/ops/+x/deskopoly.+x | $T/app | $T/d9 | sell | 1 | as=p1
RUN | $HOUSE/@.apps/deskopoly/ops/+x/deskopoly_chat.+x | $T/app | $T/c9 | as=p1 | sell Seed Lane
EXPECT_OUT | p1 sell: houses=0;get=25 | CHAT-sell-by-label
RUN | /usr/bin/cmp | $T/d9/ledger.txt | $T/c9/ledger.txt
EXPECT_EXIT | 0 | build-sell-by-label-ledgers-byte-identical
# an offer the ENGINE refuses is refused identically: the headline line at prefix 300 (p1 has 41 cash)
MKDIR   | d10
MKDIR   | c10
RUN | /usr/bin/cp | $T/m/ledger.txt | $T/d10/ledger.txt
RUN | /usr/bin/sed | -i | 301,$d | $T/d10/ledger.txt
RUN | /usr/bin/cp | $T/d10/ledger.txt | $T/c10/ledger.txt
RUN | $HOUSE/@.apps/deskopoly/ops/+x/deskopoly.+x | $T/app | $T/d10 | offer | p2 | give | cash:100 | get | prop:19 | as=p1
EXPECT_OUT | refused: p1 does not have 100 cash | DIRECT-the-engine-says-p1-cannot-pay-100
RUN | $HOUSE/@.apps/deskopoly/ops/+x/deskopoly_chat.+x | $T/app | $T/c10 | as=p1 | offer p2 give 100 get Coil Plaza
EXPECT_OUT | ok offer p2 give cash:100 get prop:19 | CHAT-the-headline-line-is-sent-as-the-id-form
EXPECT_OUT | refused: p1 does not have 100 cash | CHAT-the-engine-says-the-very-same-thing
EXPECT_EXIT | 2 | exit-2
RUN | /usr/bin/cmp | $T/d10/ledger.txt | $T/c10/ledger.txt
EXPECT_EXIT | 0 | and-neither-ledger-changed
# a refused or unknown LABEL appends NOTHING; a good one does (positive control)
MKDIR   | s2
RUN | /usr/bin/cp | $T/m/ledger.txt | $T/s2/ledger.txt
RUN | /usr/bin/sed | -i | 301,$d | $T/s2/ledger.txt
RUN | /usr/bin/cp | $T/s2/ledger.txt | $T/s2_before.txt
RUN | $HOUSE/@.apps/deskopoly/ops/+x/deskopoly_chat.+x | $T/app | $T/s2 | as=p1 | offer p2 give 20 get Zork Plaza
EXPECT_OUT | refused: unknown name "zork" | UNKNOWN-label-in-mode-b
RUN | $HOUSE/@.apps/deskopoly/ops/+x/deskopoly_chat.+x | $T/app | $T/s2 | as=p1 | offer p2 give 20 get Coil
EXPECT_OUT | refused: ambiguous name "coil": could be Orange1 (Coil Street) (16), Orange2 (Coil Square) (18), Orange3 (Coil Plaza) (19) | AMBIGUOUS-label-in-mode-b-lists-id-label-number
RUN | $HOUSE/@.apps/deskopoly/ops/+x/deskopoly_chat.+x | $T/app | $T/s2 | as=p1 | offer p2 give 20 get Helix Cell
EXPECT_OUT | refused: Jail (tile 10) is a jail tile, not a property | corner-label-in-mode-b
RUN | /usr/bin/cmp | $T/s2/ledger.txt | $T/s2_before.txt
EXPECT_EXIT | 0 | THREE-REFUSED-LABELS-LEFT-THE-LEDGER-BYTE-IDENTICAL
RUN | $HOUSE/@.apps/deskopoly/ops/+x/deskopoly_chat.+x | $T/app | $T/s2 | as=p1 | offer p2 give 20 get Spin Works
EXPECT_OUT | p1 offer: id=1;give=cash:20;get=prop:12;round=1 | POSITIVE-CONTROL-a-good-label-appends-a-row
RUN | /usr/bin/cmp | $T/s2/ledger.txt | $T/s2_before.txt
EXPECT_EXIT | 1 | and-the-cmp-check-CAN-fail-the-ledger-now-differs
