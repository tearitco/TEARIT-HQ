RUN | $HOUSE/@.apps/deskopoly/ops/+x/deskopoly.+x | $T/app | $T/c1 | check
EXPECT_OUT | CHECK ok | the-engine-check-passes
# negative control: a DIFFERENT negotiation gives a different ledger, so the cmp above could have failed
RUN | $HOUSE/@.apps/deskopoly/ops/+x/deskopoly_chat.+x | $T/app | $T/d1 | as=p1 | roll
RUN | /usr/bin/cmp | -s | $T/d1/ledger.txt | $T/c1/ledger.txt
EXPECT_EXIT | 1 | NEGATIVE-CONTROL-one-extra-row-in-one-game-and-cmp-says-they-differ

