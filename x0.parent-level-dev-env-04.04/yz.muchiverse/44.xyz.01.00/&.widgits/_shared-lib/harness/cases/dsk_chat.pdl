RUN | $HOUSE/@.apps/deskopoly/ops/+x/deskopoly_chat.+x | $T/app | $T/c1 | as=p2 | counter 1 give fund card get 20
EXPECT_OUT | p2 counter: id=2;re=1;give=card:fund;get=cash:20;round=2 | CHAT-2-counter
