CASE    | equivalence-compare
EXPECT_EQ | $sig_endturn | $sig_timer | manual-End-Turn-and-timer-ticks-give-the-same-entity-rows
EXPECT_EQ | $sig_endturn | $sig_advance | End-Turn-and-one-12-day-advance-give-the-same-entity-rows
EXPECT_EQ | $led_endturn | $led_timer | manual-and-timer-give-the-same-schedule-ledger-rows
EXPECT_EQ | $led_endturn | $led_advance | manual-and-advance-give-the-same-schedule-ledger-rows
EXPECT_NE | $sig_endturn | | signature-is-not-empty
CASE    | fast-forward-30
SCRATCH |
COPY    | &.widgits/livedesk-clock/ops/+x/lc_clock.+x | lc.+x
COPY    | &.widgits/_shared-lib/ops/+x/game_snapshot_op.+x | gso
MKDIR   | &.widgits/digipet/ops/+x
COPY    | &.widgits/digipet/ops/+x/event_page_op.+x | &.widgits/digipet/ops/+x/event_page_op.+x
MKDIR   | common_events
RUN | /usr/bin/cp | -r | $HOUSE/&.widgits/digipet/entity | $T/pet
RUN | /usr/bin/cp | -r | $HOUSE/&.widgits/digipet/common_events/day_tick | $T/common_events/day_tick
WRITE   | common_events/day_tick/event_pkg/target.pdl | TARGET | state | pet
RUN | /usr/bin/gcc | -O2 | -w | -o | $T/prisc | $HOUSE/&.widgits/_shared-lib/system/prisc+x.c | -lm
ENV | EVENT_PAGE_PRISC | $T/prisc
ENV | EVENT_PAGE_TRIGGER | parallel
ENV | LC_CLOCK_NO_POPUP | 1
ENV | LC_CLOCK_EVENT_RUNNER | $T/&.widgits/digipet/ops/+x/event_page_op.+x
RUN | $T/lc.+x | $T | new | g1
RUN | $T/lc.+x | $T | reminder-add | g1 | 86400000 | common:day_tick |  | every:1day
RUN | $T/lc.+x | $T | cmd | g1 | advance | 30d
RUN | $T/lc.+x | $T | step | 0
RUN | $T/lc.+x | $T | sched-count | r1 | ok
EXPECT_OUT_IS | 30 | 30-day-fast-forward-ledgers-exactly-30-ok-ticks
RUN | $T/lc.+x | $T | sched-count | r1
EXPECT_OUT_IS | 30 | no-collapsed-or-extra-rows
EXPECT_HAS | pet/variables.txt | days=30\n | days-30
EXPECT_HAS | pet/variables.txt | hunger=30\n | hunger-30
EXPECT_HAS | pet/actor_1_stats.txt | hp=1\n | hp-floored-at-1-after-30-days
EXPECT_HAS | pet/actor_states.txt | state_1:1=1\n | Hungry-after-30-days
RUN | /usr/bin/grep | -c | EVENTPAGE.day_tick.parallel.page_1 | $T/pet/event_page_ledger.txt
EXPECT_OUT_IS | 30 | page_1-ran-exactly-30-times
RUN | $T/lc.+x | $T | step | 0
RUN | $T/lc.+x | $T | step | 3600000
RUN | $T/lc.+x | $T | sched-count | r1
EXPECT_OUT_IS | 30 | stepping-again-applies-no-tick-twice
EXPECT_HAS | pet/variables.txt | days=30\n | days-still-30
CLEAN |
CASE    | player-path-save-load
SCRATCH |
COPY    | &.widgits/livedesk-clock/ops/+x/lc_clock.+x | lc.+x
COPY    | &.widgits/_shared-lib/ops/+x/game_snapshot_op.+x | gso
MKDIR   | &.widgits/digipet/ops/+x
COPY    | &.widgits/digipet/ops/+x/event_page_op.+x | &.widgits/digipet/ops/+x/event_page_op.+x
MKDIR   | common_events
RUN | /usr/bin/cp | -r | $HOUSE/&.widgits/digipet/entity | $T/pet
RUN | /usr/bin/cp | -r | $HOUSE/&.widgits/digipet/common_events/day_tick | $T/common_events/day_tick
WRITE   | common_events/day_tick/event_pkg/target.pdl | TARGET | state | pet
RUN | /usr/bin/gcc | -O2 | -w | -o | $T/prisc | $HOUSE/&.widgits/_shared-lib/system/prisc+x.c | -lm
ENV | EVENT_PAGE_PRISC | $T/prisc
ENV | EVENT_PAGE_TRIGGER | parallel
ENV | LC_CLOCK_NO_POPUP | 1
ENV | LC_CLOCK_EVENT_RUNNER | $T/&.widgits/digipet/ops/+x/event_page_op.+x
RUN | $T/lc.+x | $T | new | g1
RUN | $T/lc.+x | $T | reminder-add | g1 | 86400000 | common:day_tick |  | every:1day
RUN | $T/lc.+x | $T | ticker | g1 | off
RUN | $T/lc.+x | $T | cmd | g1 | rate | x86400
RUN | $T/lc.+x | $T | step | 0
RUN | $T/lc.+x | $T | step | 5000
RUN | $T/lc.+x | $T | list
EXPECT_OUT | g1\puser\px86400\p0\p0\p | game-off-clock-not-running-epoch-0
EXPECT_OUT_IS | g1\puser\px86400\p0\p0\p0 | game-off-clock-row-exact
RUN | $T/lc.+x | $T | sched-count | r1
EXPECT_OUT_IS | 0 | no-tick-while-the-game-is-off
RUN | $T/lc.+x | $T | ticker | g1 | on
RUN | $T/lc.+x | $T | step | 3000
RUN | $T/lc.+x | $T | sched-count | r1
EXPECT_HAS | pet/variables.txt | hunger=3\n | play-on-clock-running-3-days-3-ticks
EXPECT_OUT_IS | 3 | three-ledger-rows
RUN | /bin/sh | -c | exec "$1/&.widgits/digipet/ops/+x/event_page_op.+x" "$0" "$1" --trigger feed | $T/pet | $T
EXPECT_HAS | pet/variables.txt | hunger=0\n | act-Feed-via-the-menu-METHOD-hunger-3-minus-3
EXPECT_HAS | pet/items.txt | item_apple=1\n | act-Feed-used-an-apple
RUN | $T/lc.+x | $T | step | 2000
EXPECT_HAS | pet/variables.txt | days=5\n | two-more-days-days-5
EXPECT_HAS | pet/variables.txt | hunger=2\n | hunger-2
RUN | /usr/bin/cat | pet/variables.txt | pet/actor_1_stats.txt | pet/actor_states.txt | pet/switches.txt | pet/items.txt
CAPTURE | sig_saved
RUN | $T/lc.+x | $T | list
CAPTURE | clock_saved
RUN | $T/lc.+x | $T | sched-count | r1
CAPTURE | cursor_saved
RUN | $T/gso | $T/store | $T/pet | save | CP1 | --extra | $T/#.desktop/clocks/g1.pdl | --extra | $T/#.desktop/clocks/reminders.pdl | --extra | $T/#.desktop/clocks/schedule_ledger.txt | --now-ms | 1000
EXPECT_EXIT | 0 | save-with-clock-state-reminders-and-schedule-ledger
RUN | $T/lc.+x | $T | step | 4000
WRITE   | sw_on.pal | li x15, 7\nli x12, 1\necall "pet/switches.txt" "death_enabled"\nhalt\n
RUN | $T/prisc | $T/sw_on.pal
WRITE   | pet/items.txt | item_apple=9\n
RUN | $T/lc.+x | $T | step | 3000
EXPECT_HAS | pet/variables.txt | days=12\n | mutate-clock-ran-7-more-days
EXPECT_HAS | pet/actor_1_stats.txt | hp=10\n | mutate-hp-still-10
EXPECT_HAS | pet/switches.txt | death_enabled=1\n | mutate-switch-flipped
RUN | /usr/bin/cat | pet/variables.txt | pet/actor_1_stats.txt | pet/actor_states.txt | pet/switches.txt | pet/items.txt
CAPTURE | sig_mutated
EXPECT_NE | $sig_saved | $sig_mutated | mutation-really-changed-the-entity-rows
RUN | $T/lc.+x | $T | sched-count | r1
EXPECT_OUT_IS | 12 | before-load-12-ledger-rows
RUN | $T/gso | $T/store | $T/pet | restore | CP1 | $T/pet | --apply | --prune | --extra-dir | $T/#.desktop/clocks | --now-ms | 2000
EXPECT_EXIT | 0 | load-restore-applied
RUN | /usr/bin/cat | pet/variables.txt | pet/actor_1_stats.txt | pet/actor_states.txt | pet/switches.txt | pet/items.txt
CAPTURE | sig_restored
EXPECT_EQ | $sig_saved | $sig_restored | variables-states-switches-items-restored-exactly
RUN | $T/lc.+x | $T | list
CAPTURE | clock_restored
EXPECT_EQ | $clock_saved | $clock_restored | clock-epoch-tick-and-rate-restored-exactly
RUN | $T/lc.+x | $T | sched-count | r1
CAPTURE | cursor_restored
EXPECT_EQ | $cursor_saved | $cursor_restored | schedule-ledger-cursor-restored-exactly
EXPECT_EQ | 5 | $cursor_restored | ledger-has-exactly-the-5-saved-ticks
RUN | $T/lc.+x | $T | step | 0
RUN | $T/lc.+x | $T | step | 1
RUN | $T/lc.+x | $T | sched-count | r1
EXPECT_OUT_IS | 5 | stepping-after-load-applies-no-already-ledgered-tick
EXPECT_HAS | pet/variables.txt | days=5\n | days-not-re-applied-after-load
EXPECT_HAS | pet/variables.txt | hunger=2\n | hunger-not-re-applied-after-load
RUN | $T/lc.+x | $T | step | 1000
RUN | $T/lc.+x | $T | sched-count | r1
EXPECT_OUT_IS | 6 | one-more-game-day-after-load-applies-exactly-one-tick
EXPECT_HAS | pet/variables.txt | days=6\n | day-6-applied-once
EXPECT_HAS | pet/variables.txt | hunger=3\n | hunger-3-after-day-6
RUN | /usr/bin/grep | -c | SCHED.r1.432000000. | $T/#.desktop/clocks/schedule_ledger.txt
EXPECT_OUT_IS | 1 | day-5-is-in-the-ledger-once
RUN | /usr/bin/grep | -c | SCHED.r1.518400000. | $T/#.desktop/clocks/schedule_ledger.txt
EXPECT_OUT_IS | 1 | day-6-fired-exactly-once-after-the-load
CLEAN |
