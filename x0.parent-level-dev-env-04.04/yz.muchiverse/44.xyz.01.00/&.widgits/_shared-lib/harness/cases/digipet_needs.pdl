MKDIR   | common_events
RUN | /usr/bin/cp | -r | $HOUSE/&.widgits/digipet/entity | $T/pet
RUN | /usr/bin/cp | -r | $HOUSE/&.widgits/digipet/common_events/day_tick | $T/common_events/day_tick
WRITE   | common_events/day_tick/event_pkg/target.pdl | TARGET | state | pet
RUN | /usr/bin/gcc | -O2 | -w | -o | $T/prisc | $HOUSE/&.widgits/_shared-lib/system/prisc+x.c | -lm
ENV | EVENT_PAGE_PRISC | $T/prisc
ENV | EVENT_PAGE_TRIGGER | parallel
ENV | LC_CLOCK_NO_POPUP | 1
