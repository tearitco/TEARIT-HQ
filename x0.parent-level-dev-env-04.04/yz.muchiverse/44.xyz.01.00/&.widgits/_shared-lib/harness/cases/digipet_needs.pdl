# digipet_needs (RPGMAKER-PRIMITIVES-FOR-EVERYTHING-DESIGN.md section 4): the first NEEDS loop as RPG Maker-style events on the house clock, scratch roots only.
# Real lc_clock (schedule row repeat=every:1day event=common:day_tick, manual End Turn via the endturn mailbox, timer via rate x86400), the real event.pal pages run through the real
# prisc (compiled from the house source into $T) by event_page_op (the LC_CLOCK_EVENT_RUNNER: play_event.sh cannot run these pages, see digipet README), real METHOD strings from meta.pdl.
RESULTS | ../results/digipet_needs.txt
CASE    | ticks-endturn
SCRATCH |
COPY    | &.widgits/livedesk-clock/ops/+x/lc_clock.+x | lc.+x
COPY    | &.widgits/_shared-lib/ops/+x/game_snapshot_op.+x | gso
MKDIR   | &.widgits/digipet/ops/+x
COPY    | &.widgits/digipet/ops/+x/event_page_op.+x | &.widgits/digipet/ops/+x/event_page_op.+x
MKDIR   | common_events
RUN | /usr/bin/cp | -r | $HOUSE/&.widgits/digipet/entity | $T/pet
RUN | /usr/bin/cp | -r | $HOUSE/&.widgits/digipet/common_events/day_tick | $T/common_events/day_tick
WRITE   | common_events/day_tick/event_pkg/target.pdl | TARGET | state | pet
RUN | /usr/bin/gcc | -O2 | -w | -o | $T/prisc | $HOUSE/&.widgits/_shared-lib/system/prisc+x.c | -lm
ENV | EVENT_PAGE_PRISC | $T/prisc
ENV | EVENT_PAGE_TRIGGER | parallel
ENV | LC_CLOCK_NO_POPUP | 1
ENV | LC_CLOCK_EVENT_RUNNER | $T/&.widgits/digipet/ops/+x/event_page_op.+x
RUN | $T/lc.+x | $T | new | g1
RUN | $T/lc.+x | $T | reminder-add | g1 | 86400000 | common:day_tick |  | every:1day
EXPECT_EXIT | 0 | schedule-row-installed
RUN | $T/lc.+x | $T | reminders
EXPECT_OUT | common:day_tick | schedule-row-points-at-common-day_tick
EXPECT_OUT | every:1day | schedule-row-repeats-every-1day
EXPECT_HAS | pet/variables.txt | hunger=0\n | initial-hunger-0
RUN | $T/lc.+x | $T | endturn | g1 | 86400000
RUN | $T/lc.+x | $T | step | 0
EXPECT_HAS | pet/variables.txt | hunger=1\n | hunger-rises-one-per-day-day1
EXPECT_HAS | pet/variables.txt | days=1\n | days-counter-day1
EXPECT_HAS | pet/actor_states.txt | state_1:1=0\n | not-hungry-below-T1-day1
RUN | $T/lc.+x | $T | endturn | g1 | 86400000
RUN | $T/lc.+x | $T | step | 0
EXPECT_HAS | pet/variables.txt | hunger=2\n | hunger-rises-one-per-day-day2
EXPECT_HAS | pet/variables.txt | days=2\n | days-counter-day2
EXPECT_HAS | pet/actor_states.txt | state_1:1=0\n | not-hungry-below-T1-day2
RUN | $T/lc.+x | $T | endturn | g1 | 86400000
RUN | $T/lc.+x | $T | step | 0
EXPECT_HAS | pet/variables.txt | hunger=3\n | hunger-rises-one-per-day-day3
EXPECT_HAS | pet/variables.txt | days=3\n | days-counter-day3
EXPECT_HAS | pet/actor_states.txt | state_1:1=0\n | not-hungry-below-T1-day3
RUN | $T/lc.+x | $T | endturn | g1 | 86400000
RUN | $T/lc.+x | $T | step | 0
EXPECT_HAS | pet/variables.txt | hunger=4\n | hunger-rises-one-per-day-day4
EXPECT_HAS | pet/variables.txt | days=4\n | days-counter-day4
EXPECT_HAS | pet/actor_states.txt | state_1:1=0\n | not-hungry-below-T1-day4
RUN | $T/lc.+x | $T | endturn | g1 | 86400000
RUN | $T/lc.+x | $T | step | 0
EXPECT_HAS | pet/variables.txt | hunger=5\n | hunger-5-at-T1
EXPECT_HAS | pet/actor_states.txt | state_1:1=1\n | Hungry-state-set-at-T1-day5
RUN | $T/lc.+x | $T | endturn | g1 | 86400000
RUN | $T/lc.+x | $T | step | 0
EXPECT_HAS | pet/actor_1_stats.txt | hp=10\n | no-hp-loss-below-T2-day6
RUN | $T/lc.+x | $T | endturn | g1 | 86400000
RUN | $T/lc.+x | $T | step | 0
EXPECT_HAS | pet/actor_1_stats.txt | hp=10\n | no-hp-loss-below-T2-day7
RUN | $T/lc.+x | $T | endturn | g1 | 86400000
RUN | $T/lc.+x | $T | step | 0
EXPECT_HAS | pet/actor_1_stats.txt | hp=10\n | no-hp-loss-below-T2-day8
RUN | $T/lc.+x | $T | endturn | g1 | 86400000
RUN | $T/lc.+x | $T | step | 0
EXPECT_HAS | pet/actor_1_stats.txt | hp=10\n | no-hp-loss-below-T2-day9
RUN | $T/lc.+x | $T | endturn | g1 | 86400000
RUN | $T/lc.+x | $T | step | 0
EXPECT_HAS | pet/variables.txt | hunger=10\n | hunger-10-at-T2
EXPECT_HAS | pet/actor_1_stats.txt | hp=8\n | hp-loss-starts-at-T2-day10
RUN | $T/lc.+x | $T | endturn | g1 | 86400000
RUN | $T/lc.+x | $T | step | 0
EXPECT_HAS | pet/actor_1_stats.txt | hp=6\n | hp-6-day11
RUN | $T/lc.+x | $T | endturn | g1 | 86400000
RUN | $T/lc.+x | $T | step | 0
EXPECT_HAS | pet/actor_1_stats.txt | hp=4\n | hp-4-day12
RUN | $T/lc.+x | $T | endturn | g1 | 86400000
RUN | $T/lc.+x | $T | step | 0
EXPECT_HAS | pet/actor_1_stats.txt | hp=2\n | hp-2-day13
RUN | $T/lc.+x | $T | endturn | g1 | 86400000
RUN | $T/lc.+x | $T | step | 0
EXPECT_HAS | pet/actor_1_stats.txt | hp=1\n | hp-floors-at-1-day14-death-off
RUN | $T/lc.+x | $T | endturn | g1 | 86400000
RUN | $T/lc.+x | $T | step | 0
EXPECT_HAS | pet/actor_1_stats.txt | hp=1\n | hp-stays-1-day15
EXPECT_HAS | pet/switches.txt | dead=0\n | not-dead-while-death-off
RUN | $T/lc.+x | $T | sched-count | r1 | ok
EXPECT_OUT_IS | 15 | 15-ticks-ledgered-ok
RUN | /usr/bin/grep | -c | EVENTPAGE.day_tick.parallel.page_1 | $T/pet/event_page_ledger.txt
EXPECT_OUT_IS | 15 | page_1-ran-exactly-15-times
CLEAN |
CASE    | death-on-changes-the-floor
SCRATCH |
COPY    | &.widgits/livedesk-clock/ops/+x/lc_clock.+x | lc.+x
COPY    | &.widgits/_shared-lib/ops/+x/game_snapshot_op.+x | gso
MKDIR   | &.widgits/digipet/ops/+x
COPY    | &.widgits/digipet/ops/+x/event_page_op.+x | &.widgits/digipet/ops/+x/event_page_op.+x
MKDIR   | common_events
RUN | /usr/bin/cp | -r | $HOUSE/&.widgits/digipet/entity | $T/pet
RUN | /usr/bin/cp | -r | $HOUSE/&.widgits/digipet/common_events/day_tick | $T/common_events/day_tick
