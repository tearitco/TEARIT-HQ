RUN | $T/lc.+x | $T | new | g1
RUN | $T/lc.+x | $T | reminder-add | g1 | 86400000 | common:day_tick |  | every:1day
COPY    | #.ref/menu/event_commands.registry.pdl | registry.pdl
EXPECT_HAS | registry.pdl | COMMAND change_variable | registry-has-the-new-change_variable-row
EXPECT_HAS | pet/meta.pdl | METHOD       \p Feed | menu-has-a-Feed-row
EXPECT_HAS | pet/meta.pdl | METHOD       \p Status | menu-has-a-Status-row
EXPECT_HAS | pet/meta.pdl | sh -c 'exec "$1/&.widgits/digipet/ops/+x/event_page_op.+x" "$0" "$1" --trigger feed' | Feed-METHOD-string-is-the-one-run-below
EXPECT_HAS | pet/meta.pdl | sh -c 'exec "$1/&.widgits/digipet/ops/+x/event_page_op.+x" "$0" "$1" --trigger status' | Status-METHOD-string-is-the-one-run-below
WRITE   | pet/variables.txt | hunger=7\ncoins=15\ndays=0\nlast_feed=1\nfed_total=0\n
WRITE   | pet/items.txt | item_apple=0\n
WRITE   | pet/actor_states.txt | state_1:1=1\n
RUN | /bin/sh | -c | exec "$1/&.widgits/digipet/ops/+x/event_page_op.+x" "$0" "$1" --trigger feed | $T/pet | $T
EXPECT_EXIT | 0 | feed-no-food-with-coins-runs
EXPECT_HAS | pet/variables.txt | coins=5\n | feed-bought-an-apple-for-10-coins
EXPECT_HAS | pet/variables.txt | last_feed=2\n | feed-result-2-means-bought
EXPECT_HAS | pet/variables.txt | hunger=4\n | feed-lowered-hunger-by-nutrition-3
EXPECT_HAS | pet/items.txt | item_apple=0\n | bought-apple-was-eaten-pantry-empty-again
EXPECT_HAS | pet/variables.txt | fed_total=1\n | fed_total-1
EXPECT_HAS | pet/actor_states.txt | state_1:1=0\n | Hungry-cleared-because-hunger-4-is-below-T1
RUN | /bin/sh | -c | exec "$1/&.widgits/digipet/ops/+x/event_page_op.+x" "$0" "$1" --trigger feed | $T/pet | $T
EXPECT_HAS | pet/variables.txt | last_feed=0\n | feed-refused-no-food-and-coins-5-below-price-10
EXPECT_HAS | pet/variables.txt | coins=5\n | refusal-spends-no-coins
EXPECT_HAS | pet/variables.txt | hunger=4\n | refusal-leaves-hunger
WRITE   | pet/items.txt | item_apple=2\n
WRITE   | pet/variables.txt | hunger=7\ncoins=5\ndays=0\nlast_feed=1\nfed_total=0\n
RUN | /bin/sh | -c | exec "$1/&.widgits/digipet/ops/+x/event_page_op.+x" "$0" "$1" --trigger feed | $T/pet | $T
EXPECT_HAS | pet/items.txt | item_apple=1\n | feed-consumed-one-apple-from-the-pantry
EXPECT_HAS | pet/variables.txt | hunger=4\n | feed-with-food-lowers-hunger-by-3
EXPECT_HAS | pet/variables.txt | coins=5\n | eating-from-the-pantry-spends-no-coins
EXPECT_HAS | pet/variables.txt | last_feed=1\n | feed-result-1-means-ate
WRITE   | pet/variables.txt | hunger=2\ncoins=5\ndays=0\nlast_feed=1\nfed_total=0\n
RUN | /bin/sh | -c | exec "$1/&.widgits/digipet/ops/+x/event_page_op.+x" "$0" "$1" --trigger feed | $T/pet | $T
EXPECT_HAS | pet/variables.txt | hunger=0\n | hunger-floors-at-0
EXPECT_HAS | pet/items.txt | item_apple=0\n | second-apple-consumed
WRITE   | pet/variables.txt | hunger=6\ncoins=20\ndays=0\nlast_feed=1\nfed_total=0\n
WRITE   | pet/items.txt | item_apple=1\n
WRITE   | pet/actor_states.txt | state_1:1=1\n
RUN | /bin/sh | -c | exec "$1/&.widgits/digipet/ops/+x/event_page_op.+x" "$0" "$1" --trigger feed | $T/pet | $T
EXPECT_HAS | pet/variables.txt | hunger=3\n | hunger-3-after-feed
EXPECT_HAS | pet/actor_states.txt | state_1:1=0\n | Hungry-cleared-once-hunger-is-below-T1
RUN | /bin/sh | -c | exec "$1/&.widgits/digipet/ops/+x/event_page_op.+x" "$0" "$1" --trigger status | $T/pet | $T
EXPECT_EXIT | 0 | status-runs
EXPECT_HAS | pet/status.txt | hunger\n3\ncoins\n20\napples\n0\nhp\n10\nhungry\n0\ndays\n0\n | status-lists-hunger-coins-apples-hp-hungry-days
CLEAN |
