# csv_call: LOCKED cases. Source under test: &.widgits/concept-bank/ops/csv_lab.c (verbs call, quota). Doubles: fixtures/csv_lab/stub_groq.c, stub_mac.c.
RESULTS | ../results/csv_call.txt
CASE | csv-call
SCRATCH |
COPY | &.widgits/concept-bank/ops/csv_lab.c | csv_lab.c
COPY | &.widgits/_shared-lib/harness/fixtures/csv_lab/stub_groq.c | stub_groq.c
COPY | &.widgits/_shared-lib/harness/fixtures/csv_lab/stub_mac.c | stub_mac.c
RUN | gcc | -std=gnu11 | -Wall | -Wextra | -Werror | -Wno-format-truncation | -O2 | -o | $T/cl.+x | $T/csv_lab.c
EXPECT_EXIT | 0 | compiles-clean
RUN | gcc | -std=gnu11 | -Wall | -Wextra | -Werror | -O2 | -o | $T/stub_groq | $T/stub_groq.c
EXPECT_EXIT | 0 | stub-groq-builds
RUN | gcc | -std=gnu11 | -Wall | -Wextra | -Werror | -O2 | -o | $T/stub_mac | $T/stub_mac.c
EXPECT_EXIT | 0 | stub-mac-builds
MKDIR | work
MKDIR | keys
MKDIR | #.desktop
WRITE | keys/raw_groq.txt | SECRETKEYVALUE\n
WRITE | #.desktop/ai_backend.pdl | # test config\ngemma_lan_url=http://127.0.0.1:18441\ngemma_lan_model=x\n
# ---- quota ledger and pacing (pure arithmetic on the ledger)
WRITE | q.txt | REQ\p5\pgroq\pm\p100\p100\p0\p0\nREQ\p1000000\pgroq\pm\p3000\p2000\p0\p0\nREQ\p1000010\pmac\pm\p9000\p9000\p0\p0\nREQ\p1000020\pgroq\pm\p100\p100\p1\p3\n
RUN | $T/cl.+x | quota | $T/q.txt | 1000030 | 3000
EXPECT_EXIT | 0 | quota-not-blocked
EXPECT_OUT_IS | used_today=2 limit=1000 tokens_last_min=5200 tpm=7000 wait_s=31 blocked=0 | quota-counts-groq-today-only-and-waits-for-the-window
RUN | $T/cl.+x | quota | $T/q.txt | 1000030 | 1000
EXPECT_OUT_IS | used_today=2 limit=1000 tokens_last_min=5200 tpm=7000 wait_s=0 blocked=0 | quota-no-wait-when-it-fits
RUN | $T/cl.+x | quota | $T/q.txt | 1000100 | 3000
EXPECT_OUT_IS | used_today=2 limit=1000 tokens_last_min=0 tpm=7000 wait_s=0 blocked=0 | quota-window-slides
RUN | $T/cl.+x | quota | $T/q.txt | 1000030 | 3000 | --day-limit | 2
EXPECT_EXIT | 3 | quota-day-limit-reached-exit-3
EXPECT_OUT | blocked=1 | quota-day-limit-reported
RUN | $T/cl.+x | quota | $T/nosuch.txt | 1000030 | 500
EXPECT_OUT_IS | used_today=0 limit=1000 tokens_last_min=0 tpm=7000 wait_s=0 blocked=0 | quota-empty-ledger
# ---- Groq through the stub backend (same contract as horn_chat_backend)
WRITE | p.txt | Translate.\n\nINPUT (N\tEnglish\tcontext):\n1\tWater\tliquid\n2\tFire\t\n
ENV | CSV_LAB_GROQ_BACKEND | $T/stub_groq
ENV | CSV_LAB_WORK | $T/work
ENV | CSV_LAB_NO_SLEEP | 1
ENV | CSV_STUB_COUNT | $T/count.txt
RUN | $T/cl.+x | call | groq | $T/p.txt | $T/r.txt | --key-dir | $T/keys | --ledger | $T/led.txt
EXPECT_EXIT | 0 | groq-call-ok
EXPECT_OUT_IS | tokens_in=100 tokens_out=50 estimated=0 | groq-reports-real-usage-from-the-raw-response
EXPECT_FILE | r.txt | 1\t水\tshuǐ\n2\t火\thuǒ\n | groq-reply-saved
EXPECT_HAS | led.txt | \pgroq\popenai/gpt-oss-120b\p100\p50\p0\p0 | groq-request-ledgered
RUN | $T/cl.+x | call | groq | $T/p.txt | $T/r2.txt | --key-dir | $T/keys | --ledger | $T/led.txt | --model | openai/gpt-oss-20b
EXPECT_HAS | led.txt | \pgroq\popenai/gpt-oss-20b\p | model-flag-recorded
ENV | CSV_STUB_MODE | leak
RUN | $T/cl.+x | call | groq | $T/p.txt | $T/r3.txt | --key-dir | $T/keys | --ledger | $T/led.txt
EXPECT_OUT_LACKS | SECRETKEYVALUE | key-never-in-stdout
EXPECT_LACKS | led.txt | SECRETKEYVALUE | key-never-in-ledger
EXPECT_LACKS | r3.txt | SECRETKEYVALUE | key-never-in-reply
ENV | CSV_STUB_MODE | quota
RUN | $T/cl.+x | call | groq | $T/p.txt | $T/r4.txt | --key-dir | $T/keys | --ledger | $T/led.txt
EXPECT_EXIT | 3 | provider-rate-limit-exit-3
EXPECT_NOFILE | r4.txt | no-reply-file-on-quota
EXPECT_HAS | led.txt | \p0\p0\p1\p3\n | failed-request-still-counted-with-rc
ENV | CSV_STUB_MODE | fail
RUN | $T/cl.+x | call | groq | $T/p.txt | $T/r5.txt | --key-dir | $T/keys
EXPECT_EXIT | 4 | provider-failure-exit-4
ENV | CSV_STUB_MODE | sleep
RUN | $T/cl.+x | call | groq | $T/p.txt | $T/r6.txt | --key-dir | $T/keys | --timeout | 1
EXPECT_EXIT | 6 | hung-backend-killed-by-watchdog-exit-6
ENV | CSV_STUB_MODE |
WRITE | count.txt |
RUN | $T/cl.+x | call | groq | $T/p.txt | $T/r7.txt | --key-dir | $T/keys | --ledger | $T/led.txt | --day-limit | 3
EXPECT_EXIT | 3 | day-limit-blocks-the-call
EXPECT_FILE | count.txt |  | backend-not-even-started-when-blocked
ENV | CSV_LAB_GROQ_BACKEND | $T/no-such-backend
RUN | $T/cl.+x | call | groq | $T/p.txt | $T/r8.txt | --key-dir | $T/keys
EXPECT_EXIT | 4 | missing-backend-exit-4
RUN | $T/cl.+x | call | cloud | $T/p.txt | $T/r9.txt
EXPECT_EXIT | 2 | unknown-provider
RUN | $T/cl.+x | call | groq | $T/nosuch.txt | $T/r9.txt
EXPECT_EXIT | 2 | missing-prompt
# ---- Mac Ollama through a loopback stub (port 18441, never 11434)
WRITE | sp.txt | Rate.\n\nROWS (N\tEnglish\tChinese\tpinyin):\n1\tWater\t水\tshuǐ\n2\tFire\t坏BAD\thuǒ\n
SPAWN | mac_ok | $T/stub_mac | 18441 | ok
SPAWN | mac_500 | $T/stub_mac | 18442 | http500
SPAWN | mac_slow | $T/stub_mac | 18443 | slow
SPAWN | mac_empty | $T/stub_mac | 18444 | empty
SLEEP | 400
RUN | $T/cl.+x | call | mac | $T/sp.txt | $T/mr.txt | --root | $T | --ledger | $T/led.txt
EXPECT_EXIT | 0 | mac-url-read-from-ai_backend.pdl
EXPECT_OUT_IS | tokens_in=111 tokens_out=22 estimated=0 | mac-reports-ollama-eval-counts
EXPECT_FILE | mr.txt | 1\t5\tfine\n2\t2\twrong sense\n | mac-reply-unescaped
EXPECT_HAS | led.txt | \pmac\pqwen2.5-coder:7b\p111\p22\p0\p0 | mac-request-ledgered-with-default-model
ENV | CSV_LAB_MAC_URL | http://127.0.0.1:18442
RUN | $T/cl.+x | call | mac | $T/sp.txt | $T/mr2.txt | --root | $T
EXPECT_EXIT | 4 | http-500-exit-4
ENV | CSV_LAB_MAC_URL | http://127.0.0.1:18443
RUN | $T/cl.+x | call | mac | $T/sp.txt | $T/mr3.txt | --root | $T | --timeout | 2
EXPECT_EXIT | 6 | slow-model-times-out-exit-6
ENV | CSV_LAB_MAC_URL | http://127.0.0.1:18444
RUN | $T/cl.+x | call | mac | $T/sp.txt | $T/mr4.txt | --root | $T
EXPECT_EXIT | 5 | empty-reply-exit-5
ENV | CSV_LAB_MAC_URL | http://127.0.0.1:18499
RUN | $T/cl.+x | call | mac | $T/sp.txt | $T/mr5.txt | --root | $T
EXPECT_EXIT | 6 | nothing-listening-exit-6-fast
# ---- the Mac-only rule: local Ollama (11434) and any other host are refused before a socket is opened
ENV | CSV_LAB_MAC_URL | http://127.0.0.1:11434
RUN | $T/cl.+x | call | mac | $T/sp.txt | $T/mr6.txt | --root | $T
EXPECT_EXIT | 4 | localhost-11434-refused
EXPECT_OUT | call_failed rc=4 | refusal-reported
ENV | CSV_LAB_MAC_URL | http://localhost:11434
RUN | $T/cl.+x | call | mac | $T/sp.txt | $T/mr7.txt | --root | $T
EXPECT_EXIT | 4 | localhost-name-11434-refused
ENV | CSV_LAB_MAC_URL | http://93.184.216.34:80
RUN | $T/cl.+x | call | mac | $T/sp.txt | $T/mr8.txt | --root | $T
EXPECT_EXIT | 4 | other-host-refused
ENV | CSV_LAB_MAC_URL |
WRITE | #.desktop/ai_backend.pdl | gemma_lan_url=http://127.0.0.1:11434\n
RUN | $T/cl.+x | call | mac | $T/sp.txt | $T/mr9.txt | --root | $T
EXPECT_EXIT | 4 | pdl-pointing-at-11434-also-refused
# MUTANT: if the 11434 rule were wired to a different number the stub port would be refused: proves the rule is live code
ENV | CSV_LAB_MAC_URL | http://127.0.0.1:18441
RUN | cp | $T/csv_lab.c | $T/m1.c
RUN | sed | -i | s@return port != 11434;@return port != 18441;@ | $T/m1.c
RUN | gcc | -std=gnu11 | -w | -O2 | -o | $T/m1.+x | $T/m1.c
RUN | $T/m1.+x | call | mac | $T/sp.txt | $T/mm1.txt | --root | $T
EXPECT_EXIT | 4 | mutant-port-rule-moved-to-the-stub-port-is-detected
RUN | $T/cl.+x | call | mac | $T/sp.txt | $T/mm2.txt | --root | $T
EXPECT_EXIT | 0 | unmutated-binary-reaches-the-stub
CLEAN |
