CASE | the-use-key-fires-the-held-gun-through-the-pages
SCRATCH
INCLUDE | ../fixtures/rmmc_house.pdl
MKDIR | h/@.apps/rmmc/play/world
ENV | MUCHI_TARGET_ENT | $T/h/@.apps/rmmc/play/world
ENV | GAME_ARG | 140 100
RUN | /bin/bash | $HOUSE/&.widgits/events-hq/ops/play_event.sh | $T/h/@.apps/rmmc/events/spawn | $T/h | ui
ENV | GAME_ARG | e
RUN | /bin/bash | $HOUSE/&.widgits/events-hq/ops/play_event.sh | $T/h/@.apps/rmmc/events/face | $T/h | ui
ENV | GAME_ARG |
RUN | /bin/bash | $HOUSE/&.widgits/events-hq/ops/play_event.sh | $T/h/@.apps/rmmc/events/place | $T/h | ui
EXPECT_HAS | led.txt | PLACE \p asa \p dirt \p 141 \p 6 \p 100 | a dirt block on the column east of her, at her own level (141,6,100)
RUN | $T/h/@.apps/vox/ops/+x/vox_op.+x | give | $T/h/@.apps/rmmc/vox | $T/led.txt | asa | pistol22 | 1 | test
RUN | $T/h/@.apps/vox/ops/+x/vox_op.+x | give | $T/h/@.apps/rmmc/vox | $T/led.txt | asa | bullets | 6 | test
WRITE | h/@.apps/rmmc/play/pick.txt | pickaxe_not_picked\n
WRITE | h/@.apps/rmmc/play/pick.txt | pistol22\n
RUN | /bin/bash | $HOUSE/&.widgits/events-hq/ops/play_event.sh | $T/h/@.apps/rmmc/events/mine | $T/h | ui
EXPECT_HAS | h/@.apps/rmmc/play/result.txt | ok | the use key (the mine page) with the .22 picked is accepted
EXPECT_HAS | led.txt | SHOT \p asa \p pistol22 \p bullets \p 1 \p e \p hit dirt 1/2 | it FIRED the gun along her facing (east): a SHOT row with the outcome words the bar shows
EXPECT_LACKS | led.txt | DAMAGE \p asa | and it did not swing a tool
RUN | /bin/bash | $HOUSE/&.widgits/events-hq/ops/play_event.sh | $T/h/@.apps/rmmc/events/mine | $T/h | ui
EXPECT_HAS | led.txt | MINE \p asa \p 141 \p 6 \p 100 \p dirt | the second shot breaks the block in front
RUN | $T/h/@.apps/vox/ops/+x/vox_op.+x | bag | $T/h/@.apps/rmmc/vox | $T/led.txt | asa
EXPECT_OUT | bullets:4 | two bullets spent
ENV | GAME_ARG | pistol22 e
RUN | /bin/bash | $HOUSE/&.widgits/events-hq/ops/play_event.sh | $T/h/@.apps/rmmc/events/shoot | $T/h | ui
EXPECT_HAS | h/@.apps/rmmc/play/result.txt | ok | the shoot PAGE (a harness or an AI beat calls it) fires the named weapon
EXPECT_HAS | led.txt | SHOT \p asa \p pistol22 \p bullets \p 1 \p e \p missed | a SHOT row (nothing in front now: missed)
ENV | GAME_ARG | knife e
RUN | /bin/bash | $HOUSE/&.widgits/events-hq/ops/play_event.sh | $T/h/@.apps/rmmc/events/shoot | $T/h | ui
EXPECT_HAS | h/@.apps/rmmc/play/result.txt | refused | NEGATIVE: a knife is not a weapon
EXPECT_HAS | h/@.apps/rmmc/play/result.txt | [exit 16] | with exit 16
ENV | GAME_ARG |
RUN | $T/h/@.apps/vox/ops/+x/vox_op.+x | verify | $T/h/@.apps/rmmc/vox | $T/led.txt
EXPECT_OUT | verified | the ledger the pages wrote verifies
WRITE | h/@.apps/rmmc/play/pick.txt | pick\n
RUN | /bin/bash | $HOUSE/&.widgits/events-hq/ops/play_event.sh | $T/h/@.apps/rmmc/events/place | $T/h | ui
WRITE | h/@.apps/rmmc/play/pick.txt | pistol22\n
RUN | /bin/bash | $HOUSE/&.widgits/events-hq/ops/play_event.sh | $T/h/@.apps/rmmc/events/place | $T/h | ui
EXPECT_HAS | h/@.apps/rmmc/play/result.txt | refused | NEGATIVE: a gun is not a block: placing it is refused
RUN | $T/h/@.apps/vox/ops/+x/vox_op.+x | give | $T/h/@.apps/rmmc/vox | $T/led.txt | asa | pickx | 1 | test
WRITE | h/@.apps/rmmc/play/pick.txt | pick\n
RUN | /bin/bash | $HOUSE/&.widgits/events-hq/ops/play_event.sh | $T/h/@.apps/rmmc/events/mine | $T/h | ui
EXPECT_HAS | led.txt | DAMAGE \p asa \p pick | CONTROL: with a pickaxe picked the same key still swings the tool (the old behaviour is unchanged)
CLEAN |
