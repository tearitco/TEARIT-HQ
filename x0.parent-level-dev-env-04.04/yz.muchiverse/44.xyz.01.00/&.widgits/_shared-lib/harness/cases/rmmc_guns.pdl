EXPECT_OUT_LACKS | verified | SABOTAGE 9 (a row kind unknown to replay) is caught
RUN | cp | $HOUSE/@.apps/vox/ops/vox_op.c | $T/m/m10.c
RUN | sed | -i | s#int prog = s_dmg(x, y, z) + dmg;#int prog = dmg;# | $T/m/m10.c
