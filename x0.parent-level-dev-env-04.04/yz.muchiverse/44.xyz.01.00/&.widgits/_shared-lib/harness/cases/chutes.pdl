CASE    | cs_page_tokens
# the figures: events.txt rows from the REPLAYED ledger (one row per player), positions worked out by hand from the serpentine rule; the page is a projection (the ledger hash does not change, the audit stays clean, `noevents` leaves events.txt alone)
RUN | $T/pb/gc.+x | $T/pg/chutes | $T/pgs | new | 7
RUN | $T/pb/gc.+x | $T/pg/chutes | $T/pgs | join | A
RUN | $T/pb/gc.+x | $T/pg/chutes | $T/pgs | join | B
RUN | $T/pb/gc.+x | $T/pg/chutes | $T/pgs | join | C
RUN | $T/pb/gc.+x | $T/pg/chutes | $T/pgs | join | D
RUN | $T/pb/gc.+x | $T/pg/chutes | $T/pgs | start
RUN | $T/pb/gc.+x | $T/pg/chutes | $T/pgs | ledger_hash
CAPTURE | pl_h0
RUN | $T/pb/gc.+x | $T/pg/chutes | $T/pgs | page | $T/d1 | $T/pg/chutes/chutes-pchq/pieces/system/maps/chutes/board/cells.rgba
