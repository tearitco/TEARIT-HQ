RUN | $HOUSE/&.widgits/_shared-lib/ops/+x/game_core.+x | $HOUSE/@.apps/chutes | $T/c_fs | join | B
RUN | $HOUSE/&.widgits/_shared-lib/ops/+x/game_core.+x | $T/c_fra | $T/c_fr | join | A
RUN | $HOUSE/&.widgits/_shared-lib/ops/+x/game_core.+x | $T/c_fra | $T/c_fr | join | B
RUN | $HOUSE/&.widgits/_shared-lib/ops/+x/game_core.+x | $T/c_fba | $T/c_fb | join | A
RUN | $HOUSE/&.widgits/_shared-lib/ops/+x/game_core.+x | $T/c_fba | $T/c_fb | join | B
RUN | $HOUSE/&.widgits/_shared-lib/ops/+x/game_core.+x | $HOUSE/@.apps/chutes | $T/c_fs | start
RUN | $HOUSE/&.widgits/_shared-lib/ops/+x/game_core.+x | $T/c_fra | $T/c_fr | start
RUN | $HOUSE/&.widgits/_shared-lib/ops/+x/game_core.+x | $T/c_fba | $T/c_fb | start
RUN | $HOUSE/&.widgits/_shared-lib/ops/+x/game_core.+x | $HOUSE/@.apps/chutes | $T/c_fs | autoplay
