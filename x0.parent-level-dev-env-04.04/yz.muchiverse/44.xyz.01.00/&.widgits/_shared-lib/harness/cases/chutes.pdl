CASE    | cs_theory
# 1. the op against a board solved BY HAND: 4 squares, a spinner of 1 or 2 (probability 1/2 each), a chute 3 -> 1, finish at 4 or more. E2 = 1 + E1/2 ; E1 = 1 + E2/2 + E1/2 -> E1 = 2 + E2 ; so E2 = 4, E1 = 6, E0 = 1 + (E1 + E2)/2 = 6. The same numbers are in the data-hq fixture chutes_markov.csv.
WRITE   | c_tiny_board.pdl | TRACK | length | 4\nJUMP | 3 | 1 | chute\n
WRITE   | c_tiny_rules.pdl | RULE | finish | reach\n
RUN | $HOUSE/&.widgits/_shared-lib/harness/ops/+x/track_theory_op.+x | table | $T/c_tiny_board.pdl | $T/c_tiny_rules.pdl | --faces | 2
EXPECT_OUT | 0,6.000000 | HAND-SOLVED-E0-is-6
EXPECT_OUT | 1,6.000000 | HAND-SOLVED-E1-is-6
EXPECT_OUT | 2,4.000000 | HAND-SOLVED-E2-is-4
EXPECT_OUT_LACKS | 3, | and-square-3-(a-chute-foot-nobody-rests-on)-has-no-row
EXPECT_HAS | $HOUSE/&.hq-apps/data-hq/fixtures/chutes_markov.csv | 0,0,0.5,0.5,0,6 | the-data-studio-fixture-says-the-same-E0
EXPECT_HAS | $HOUSE/&.hq-apps/data-hq/fixtures/chutes_markov.csv | 2,0,0.5,0,0.5,4 | and-E2
RUN | $HOUSE/&.widgits/_shared-lib/harness/ops/+x/track_theory_op.+x | metric | $T/c_tiny_board.pdl | $T/c_tiny_rules.pdl | mean_turns | --faces | 2
EXPECT_OUT_IS | 6.000000 | the-distribution-route-(sum-t-f(t))-agrees-with-the-linear-solve-route-on-the-tiny-board
WRITE   | c_tiny_board2.pdl | TRACK | length | 4\nJUMP | 3 | 1 | chute\nJUMP | 2 | 4 | ladder\n
RUN | $HOUSE/&.widgits/_shared-lib/harness/ops/+x/track_theory_op.+x | metric | $T/c_tiny_board2.pdl | $T/c_tiny_rules.pdl | mean_turns | --faces | 2
EXPECT_EXIT | 0 | MUTANT-a-ladder-2-4-added
EXPECT_OUT_IS | 2.000000 | and-the-hand-solved-answer-moves-to-2-(E1-=-1-+-E1/2-so-E1-=-2,-E0-=-1-+-E1/2-=-2)-so-a-wrong-board-is-detected
