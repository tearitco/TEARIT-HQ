RUN | $HOUSE/&.widgits/_shared-lib/ops/+x/game_core.+x | $T/c_fra | $T/c_fr | autoplay
CAPTURE | v6
RUN | $HOUSE/&.widgits/_shared-lib/ops/+x/game_core.+x | $T/c_fba | $T/c_fb | autoplay
CAPTURE | v7
EXPECT_NE | $v5 | $v6 | the-same-seed-gives-a-DIFFERENT-game-under-reach-than-under-exact_stay
EXPECT_NE | $v5 | $v7 | and-under-bounce
RUN | grep | -c | -E | to=(10[1-9]\p1[1-9][0-9]) | $T/c_fs/ledger.txt
EXPECT_OUT_IS | 0 | exact_stay-no-roll-ever-ends-past-square-100
