# ======================================================================================================================================================================
# THE CHUTES AND LADDERS CHECKS (plan CHUTES-LADDERS-AND-SNAKE-GAME-PLANS-2026-11-09 sections 4-11: cs_data cs_finish cs_play cs_seats cs_theory cs_talk cs_export)
# GC = the shared engine, TT = track_theory_op (the exact theory and an independent copy of the dice), A = the app. All three paths are written out because the case op only expands $T and $HOUSE.
# ======================================================================================================================================================================

CASE    | cs_data
RUN | $HOUSE/&.widgits/_shared-lib/harness/ops/+x/track_theory_op.+x | sanity | $HOUSE/@.apps/chutes/rulesets/default/board.pdl
EXPECT_EXIT | 0 | the-shipped-jump-table-passes-the-sanity-check
EXPECT_OUT_IS | SANITY ok jumps=19 ladders=9 chutes=10 | 19-jumps-9-ladders-10-chutes-(OUR-data-from-memory)-every-jump-lands-inside-1..100-no-chain-no-loop
EXPECT_HAS | $HOUSE/@.apps/chutes/rulesets/default/board.pdl | TRACK \p length \p 100 | 100-squares
EXPECT_HAS | $HOUSE/@.apps/chutes/rulesets/default/board.pdl | FROM MEMORY OF THE COMMON US BOARD | the-file-says-in-capitals-that-the-table-is-from-memory
EXPECT_HAS | $HOUSE/@.apps/chutes/rulesets/default/board.pdl | NOT BEEN CHECKED AGAINST AN OFFICIAL BOARD | and-that-it-is-unchecked
EXPECT_HAS | $HOUSE/@.apps/chutes/rulesets/default/board.pdl | BOARD \p path   \p serpentine | the-page-geometry-is-data-too
RUN | cp | -r | $HOUSE/@.apps/chutes | $T/c_bad
RUN | sed | -i | s/^\(JUMP \p 1  \p \)38 /\1101/ | $T/c_bad/rulesets/default/board.pdl
RUN | cmp | $HOUSE/@.apps/chutes/rulesets/default/board.pdl | $T/c_bad/rulesets/default/board.pdl
EXPECT_EXIT | 1 | vacuity-the-bad-board-copy-really-differs
RUN | $HOUSE/&.widgits/_shared-lib/harness/ops/+x/track_theory_op.+x | sanity | $T/c_bad/rulesets/default/board.pdl
EXPECT_EXIT | 1 | NEGATIVE-a-ladder-landing-on-101-fails-the-sanity-check
EXPECT_OUT | lands outside 1..100 | and-says-why
RUN | $HOUSE/&.widgits/_shared-lib/ops/+x/game_core.+x | $T/c_bad | $T/c_bad_g | new | 7
EXPECT_EXIT | 2 | NEGATIVE-the-engine-refuses-the-same-board-too
EXPECT_OUT | outside the track | at-the-config
RUN | cp | $HOUSE/@.apps/chutes/rulesets/default/board.pdl | $T/c_b2.pdl
APPEND  | c_b2.pdl | JUMP | 38 | 50 | ladder | X1\n
RUN | $HOUSE/&.widgits/_shared-lib/harness/ops/+x/track_theory_op.+x | sanity | $T/c_b2.pdl
EXPECT_EXIT | 1 | NEGATIVE-a-jump-starting-where-the-ladder-1-38-ends-is-a-chain
EXPECT_OUT | chain | and-says-chain
RUN | cp | $HOUSE/@.apps/chutes/rulesets/default/board.pdl | $T/c_b3.pdl
APPEND  | c_b3.pdl | JUMP | 4 | 20 | ladder | X2\n
RUN | $HOUSE/&.widgits/_shared-lib/harness/ops/+x/track_theory_op.+x | sanity | $T/c_b3.pdl
EXPECT_EXIT | 1 | NEGATIVE-two-jumps-from-square-4
EXPECT_OUT | foot of two jumps | and-says-so
RUN | cp | $HOUSE/@.apps/chutes/rulesets/default/board.pdl | $T/c_b4.pdl
APPEND  | c_b4.pdl | JUMP | 12 | 12 | ladder | X3\n
RUN | $HOUSE/&.widgits/_shared-lib/harness/ops/+x/track_theory_op.+x | sanity | $T/c_b4.pdl
EXPECT_EXIT | 1 | NEGATIVE-a-jump-to-itself
RUN | cp | $HOUSE/@.apps/chutes/rulesets/default/board.pdl | $T/c_b5.pdl
APPEND  | c_b5.pdl | JUMP | 30 | 25 | ladder | X4\n
RUN | $HOUSE/&.widgits/_shared-lib/harness/ops/+x/track_theory_op.+x | sanity | $T/c_b5.pdl
EXPECT_EXIT | 1 | NEGATIVE-a-ladder-that-goes-down
RUN | cp | $HOUSE/@.apps/chutes/rulesets/default/board.pdl | $T/c_b6.pdl
APPEND  | c_b6.pdl | JUMP | 70 | 100 | ladder | X5\nJUMP | 100 | 3 | chute | X6\n
RUN | $HOUSE/&.widgits/_shared-lib/harness/ops/+x/track_theory_op.+x | sanity | $T/c_b6.pdl
EXPECT_EXIT | 1 | NEGATIVE-a-jump-FROM-square-100-(and-a-chain-into-it)
RUN | $HOUSE/&.widgits/_shared-lib/harness/ops/+x/track_theory_op.+x | sanity | $HOUSE/@.apps/chutes/rulesets/default/board.pdl
EXPECT_EXIT | 0 | and-the-real-board-still-passes-after-all-those-copies-were-refused

CASE    | cs_finish
RUN | $HOUSE/&.widgits/_shared-lib/harness/ops/+x/track_theory_op.+x | metric | $HOUSE/@.apps/chutes/rulesets/default/board.pdl | $HOUSE/@.apps/chutes/rulesets/default/rules.pdl | mean_turns | --finish | reach
CAPTURE | v1
RUN | $HOUSE/&.widgits/_shared-lib/harness/ops/+x/track_theory_op.+x | metric | $HOUSE/@.apps/chutes/rulesets/default/board.pdl | $HOUSE/@.apps/chutes/rulesets/default/rules.pdl | mean_turns | --finish | exact_stay
CAPTURE | v2
RUN | $HOUSE/&.widgits/_shared-lib/harness/ops/+x/track_theory_op.+x | metric | $HOUSE/@.apps/chutes/rulesets/default/board.pdl | $HOUSE/@.apps/chutes/rulesets/default/rules.pdl | mean_turns | --finish | bounce
CAPTURE | v3
EXPECT_EQ | $v1 | 35.834938 | theory-reach-35.8349-turns-for-one-player-(OBSERVED)
EXPECT_EQ | $v2 | 39.225122 | theory-exact_stay-39.2251-turns-(the-memory-figure-was-about-39)
EXPECT_EQ | $v3 | 43.324597 | theory-bounce-43.3246-turns
EXPECT_GE | $v2 | $v1 | exact-finish-games-are-longer-than-reach
EXPECT_GE | $v3 | $v2 | and-bounce-longer-still
CALC    | v4 | $v2 | - | $v1
EXPECT_GE | $v4 | 3 | vacuity-the-finish-rule-is-worth-over-3-turns-so-the-comparison-above-is-not-noise
MKDIR   | c_fs
MKDIR   | c_fr
MKDIR   | c_fb
