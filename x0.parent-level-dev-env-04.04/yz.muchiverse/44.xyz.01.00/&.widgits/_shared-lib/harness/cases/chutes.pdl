CASE    | cs_page_drift
# THE DRIFT CHECK (decision D67): game_core.c carries a COPY of deskopoly.c's label baker. label_drift_op #includes deskopoly.c and prints the same lines for the same inputs; any change to either side that changes a table or a mask shows here.
RUN | $T/pb/gc.+x | $T/pg/chutes | $T/pgs | fontsum
CAPTURE | f_gc
RUN | $T/pb/drift.+x | fontsum
CAPTURE | f_dsk
EXPECT_EQ | $f_gc | $f_dsk | THE-5x7-AND-3x5-FONT-TABLES-AND-THE-FIVE-TIERS-ARE-BYTE-IDENTICAL-to-deskopoly.c's
RUN | $T/pb/gc.+x | $T/pg/chutes | $T/pgs | labelmask | 72 | 100
CAPTURE | f_gc
RUN | $T/pb/drift.+x | labelmask | 72 | 100
CAPTURE | f_dsk
EXPECT_EQ | $f_gc | $f_dsk | the-mask-of-100-equals-Teropoly's
RUN | $T/pb/gc.+x | $T/pg/chutes | $T/pgs | labelmask | 72 | 7
CAPTURE | f_gc
RUN | $T/pb/drift.+x | labelmask | 72 | 7
CAPTURE | f_dsk
EXPECT_EQ | $f_gc | $f_dsk | the-mask-of-7-(one-big-glyph)
RUN | $T/pb/gc.+x | $T/pg/chutes | $T/pgs | labelmask | 72 | Lost & Found
CAPTURE | f_gc
RUN | $T/pb/drift.+x | labelmask | 72 | Lost & Found
CAPTURE | f_dsk
EXPECT_EQ | $f_gc | $f_dsk | the-mask-of-a-wrapped-two-word-name
RUN | $T/pb/gc.+x | $T/pg/chutes | $T/pgs | labelmask | 72 | Golden Ratio Way
CAPTURE | f_gc
RUN | $T/pb/drift.+x | labelmask | 72 | Golden Ratio Way
CAPTURE | f_dsk
EXPECT_EQ | $f_gc | $f_dsk | the-mask-of-a-three-word-name-(a-smaller-font-tier)
RUN | $T/pb/gc.+x | $T/pg/chutes | $T/pgs | labelmask | 72 | A name that is far too long to fit in three lines of any big font so the smallest tier wraps it
CAPTURE | f_gc
RUN | $T/pb/drift.+x | labelmask | 72 | A name that is far too long to fit in three lines of any big font so the smallest tier wraps it
CAPTURE | f_dsk
EXPECT_EQ | $f_gc | $f_dsk | the-mask-of-a-long-text-(the-3x5-tiers-and-the-last-resort-paths)
RUN | $T/pb/gc.+x | $T/pg/chutes | $T/pgs | labelmask | 48 | ^38
CAPTURE | f_gc
RUN | $T/pb/drift.+x | labelmask | 48 | ^38
CAPTURE | f_dsk
EXPECT_EQ | $f_gc | $f_dsk | the-mask-of-a-jump-label-on-a-2-cell-block
RUN | $T/pb/gc.+x | $T/pg/chutes | $T/pgs | labelmask | 72 | 100
EXPECT_OUT | glyph=432 outline=350 | PIN:-"100"-in-a-72-px-block-is-432-glyph-pixels-and-350-outline-pixels-(both-sides-agree-above,-this-pins-the-number)
RUN | cp | $HOUSE/&.widgits/_shared-lib/ops/game_core.c | $T/pb/gc_font.c
RUN | sed | -i | s/{0,0,0x5F,0,0}/{0,0,0x5E,0,0}/ | $T/pb/gc_font.c
RUN | gcc | -std=gnu11 | -Wno-format-truncation | -Wno-misleading-indentation | -O2 | -o | $T/pb/gc_font.+x | $T/pb/gc_font.c
EXPECT_EXIT | 0 | the-copy-with-ONE-font-byte-changed-compiles
RUN | $T/pb/gc_font.+x | $T/pg/chutes | $T/pgs | fontsum
CAPTURE | f_gc
EXPECT_NE | $f_gc | $f_dsk | MUTANT-one-changed-font-byte-is-DETECTED-by-the-checksum
RUN | $T/pb/gc_font.+x | $T/pg/chutes | $T/pgs | labelmask | 72 | !
CAPTURE | f_gc
RUN | $T/pb/drift.+x | labelmask | 72 | !
CAPTURE | f_dsk
EXPECT_NE | $f_gc | $f_dsk | and-by-the-mask-of-the-glyph-it-changed

CASE    | cs_driver
# the REAL driver (what the editor's Play starts) in a SCRATCH editor (a fake owner, a fake switches.txt): the live editor is never touched. A human seat p1, three pets.
MKDIR   | c_edit/state/world
MKDIR   | c_edit/c_edit-pchq/pieces/world_01
WRITE   | c_edit/c_edit-pchq/pieces/world_01/state.txt | name=World 01\nmap_id=chutes\ndesk_id=board\n
WRITE   | c_edit/state/world/switches.txt | running=0\n
SPAWN   | OWNC | /usr/bin/sleep | 600
ENV     | GAME_OWNER_PID | $OWNC
SPAWN   | DRVC | $T/pb/gc.+x | driver | $HOUSE | $T/pg/chutes | $T/c_edit
WAIT_HAS | c_edit/state/game_ui.txt | gm_title=Chutes and Ladders | 8000 | the-feed-is-published-with-the-game's-title
WAIT_HAS | c_edit/state/game_ui.txt | 4 players | 4000 | the-setup-screen-starts-with-a-full-table-(--players-4)
RUN | $T/pb/gc.+x | ctl | human_next | $T/c_edit/state/games/chutes
RUN | $T/pb/gc.+x | ctl | start | $T/c_edit/state/games/chutes
WAIT_HAS | c_edit/state/games/chutes/game/ledger.txt | bank\pstart | 8000 | START-writes-the-start-row
WAIT_HAS | c_edit/c_edit-pchq/pieces/world_01/state.txt | desk_id=play | 8000 | THE-EDITOR-WORLD-IS-POINTED-AT-THE-GENERATED-play-DESK-when-the-game-starts
EXPECT_HAS | c_edit/c_edit-pchq/pieces/world_01/state.txt | map_id=chutes | and-the-rest-of-the-world-file-is-kept
EXPECT_HAS | pg/chutes/chutes-pchq/pieces/system/maps/chutes/play/cells.txt | height=33 | the-play-desk-has-the-30x33-page
EXPECT_EXISTS | pg/chutes/chutes-pchq/pieces/system/maps/chutes/play/map.png | and-the-2D-picture-map.png-(made-by-raw_to-png)
EXPECT_HAS | pg/chutes/chutes-pchq/pieces/system/maps/chutes/play/events.txt | 4 31 220 60 60 People1 0 2 1 A | the-four-figures-wait-in-the-start-strip-(A-first)
RUN | grep | -c | ^ | $T/pg/chutes/chutes-pchq/pieces/system/maps/chutes/play/events.txt
EXPECT_OUT_IS | 4 | exactly-four-figure-rows
RUN | stat | -c | %s | $T/pg/chutes/chutes-pchq/pieces/system/maps/chutes/play/cells.marker
EXPECT_OUT_IS | 1 | the-page-was-made-ONCE-(the-marker-has-one-byte)
WRITE   | c_edit/state/world/switches.txt | running=1\n
WAIT_HAS | c_edit/state/game_ui.txt | gmb_0_label=Roll | 8000 | AT-THE-HUMAN'S-TURN-THE-ROLL-BUTTON-IS-OFFERED
SLEEP   | 1500
RUN | grep | -c | -F | \proll\p | $T/c_edit/state/games/chutes/game/ledger.txt
EXPECT_OUT_IS | 0 | and-the-clock-WAITS-for-the-human:-no-roll-row-without-the-press
RUN | $T/pb/gc.+x | ctl | roll | $T/c_edit/state/games/chutes
WAIT_HAS | c_edit/state/games/chutes/game/ledger.txt | p1\proll\p | 8000 | THE-PRESS-IS-A-ROLL-ROW-BY-p1
WAIT_HAS | c_edit/state/games/chutes/game/ledger.txt | p4\proll\p | 8000 | then-the-three-pets-roll-on-their-own-clock
WAIT_HAS | pg/chutes/chutes-pchq/pieces/system/maps/chutes/play/events.txt | 6 18 220 60 60 People1 0 2 1 A | 8000 | AFTER-THE-HUMAN'S-ROLL-A'S-FIGURE-STANDS-ON-SQUARE-38-(seed-7:-1-then-the-ladder)-in-the-play-desk's-events.txt
EXPECT_HAS | pg/chutes/chutes-pchq/pieces/system/maps/chutes/play/events.txt | 18 24 230 200 50 People1 3 2 1 D | and-the-pets'-figures-moved-too-(D-on-14)
EXPECT_LACKS | pg/chutes/chutes-pchq/pieces/system/maps/chutes/play/events.txt | 4 31 220 60 60 People1 0 2 1 A | and-A-is-no-longer-in-the-start-strip
RUN | stat | -c | %s | $T/pg/chutes/chutes-pchq/pieces/system/maps/chutes/play/cells.marker
EXPECT_OUT_IS | 1 | FIVE-MOVES-LATER-the-page-was-NOT-rebuilt-(marker-still-1-byte:-the-figures-are-events-rows,-no-process-and-no-page-per-move)
WAIT_HAS | c_edit/state/game_ui.txt | rolled | 8000 | THE-FEED-CARRIES-A-TABLE-TALK-SENTENCE
WRITE   | c_edit/state/world/switches.txt | running=0\n
SLEEP   | 700
RUN | grep | -c | ^ | $T/c_edit/state/games/chutes/game/ledger.txt
CAPTURE | v1
SLEEP   | 1500
RUN | grep | -c | ^ | $T/c_edit/state/games/chutes/game/ledger.txt
EXPECT_OUT_IS | $v1 | PAUSE-WRITES-NOTHING-the-ledger-does-not-grow-with-running=0
RUN | $T/pb/gc.+x | $T/pg/chutes | $T/c_edit/state/games/chutes/game | replay
EXPECT_OUT | REPLAY events= | THE-LIVE-LEDGER-WRITTEN-BY-THE-DRIVER-REPLAYS
RUN | $T/pb/gc.+x | $T/pg/chutes | $T/c_edit/state/games/chutes/game | audit
EXPECT_OUT | AUDIT ok | and-the-audit-is-clean
RUN | $T/pb/gc.+x | ctl | new_game | $T/c_edit/state/games/chutes
WAIT_HAS | c_edit/c_edit-pchq/pieces/world_01/state.txt | desk_id=board | 8000 | NEW-GAME-points-the-editor-world-back-at-the-authored-board-desk
RUN | $T/pb/gc.+x | ctl | start | $T/c_edit/state/games/chutes
WAIT_HAS | c_edit/c_edit-pchq/pieces/world_01/state.txt | desk_id=play | 8000 | and-START-points-it-at-the-play-desk-again
RUN | /usr/bin/kill | $OWNC
SLEEP   | 300
EXPECT_DEAD | $OWNC | the-fake-owner-is-gone-and-reaped
SLEEP   | 1500
EXPECT_DEAD | $DRVC | the-driver-ends-with-its-owner
WAIT_HAS | c_edit/c_edit-pchq/pieces/world_01/state.txt | desk_id=board | 3000 | AND-THE-WORLD-IS-BACK-AT-THE-BOARD-DESK-when-the-driver-ends
ENV     | GAME_OWNER_PID |
CLEAN   |
