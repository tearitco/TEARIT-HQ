# ---------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
# THE BOARD PAGE (2026-11-09, decision D67): the generic `page` / `preview` / `squarecell` / `labelmask` / `fontsum` verbs of game_core and rulesets/default/page.pdl. Everything is built from SOURCE into $T/pb (so the case tests the source, not an old binary),
# on a scratch COPY of the app. The page is read back by page_probe_op (its own serpentine arithmetic and its own page.pdl / board.pdl reader; it calls only `labelmask` of the engine for the text pixels) and the baker is compared with deskopoly.c's own by label_drift_op.
# Pixel colours of the labels are changed to magenta / cyan in the scratch copy so no atlas pixel can be mistaken for ink. NOT covered here: the look of the picture (open the PNGs of the commit message) and the live editor window.
CASE    | cs_page_build
MKDIR   | pb
RUN | gcc | -std=gnu11 | -Wall | -Wextra | -Wno-format-truncation | -Wno-misleading-indentation | -O2 | -o | $T/pb/gc.+x | $HOUSE/&.widgits/_shared-lib/ops/game_core.c
EXPECT_EXIT | 0 | game_core-with-the-page-verbs-compiles-from-source
EXPECT_OUT_LACKS | warning | and-without-a-warning
RUN | gcc | -std=gnu11 | -Wno-format-truncation | -Wno-misleading-indentation | -O2 | -DGC_MUT_PAGE_FLIP | -o | $T/pb/gc_flip.+x | $HOUSE/&.widgits/_shared-lib/ops/game_core.c
EXPECT_EXIT | 0 | the-mutant-with-the-serpentine-direction-swapped-compiles
RUN | gcc | -std=gnu11 | -Wall | -Wextra | -O2 | -o | $T/pb/probe.+x | $HOUSE/&.widgits/_shared-lib/harness/ops/page_probe_op.c
EXPECT_EXIT | 0 | page_probe_op-compiles-from-source
EXPECT_OUT_LACKS | warning | and-without-a-warning
RUN | gcc | -std=gnu11 | -O2 | -w | -o | $T/pb/drift.+x | $HOUSE/&.widgits/_shared-lib/harness/ops/label_drift_op.c
EXPECT_EXIT | 0 | label_drift_op-(it-includes-deskopoly.c-itself)-compiles
COPYDIR | @.apps/chutes | pg/chutes
RUN | sed | -i | s/ffffff/ff00ff/ | $T/pg/chutes/rulesets/default/page.pdl
RUN | sed | -i | s/000000/00ffff/ | $T/pg/chutes/rulesets/default/page.pdl
EXPECT_HAS | pg/chutes/rulesets/default/page.pdl | LABELCOLOR \p text        \p ff00ff | the-scratch-copy-has-the-magenta-text-colour
MKDIR   | pgs
MKDIR   | d1
MKDIR   | d2
MKDIR   | d3
MKDIR   | d4

CASE    | cs_page_squares
# where a square is: worked out BY HAND from the rule "square 1 bottom-left, row 1 runs left to right, row 2 right to left, ..." (block = column from the left, row from the TOP of the 10 x 10 board)
RUN | $T/pb/gc.+x | $T/pg/chutes | $T/pgs | squarecell | 1
EXPECT_OUT | SQUARE 1 block=0,9 | 1-is-bottom-left
RUN | $T/pb/gc.+x | $T/pg/chutes | $T/pgs | squarecell | 10
EXPECT_OUT | SQUARE 10 block=9,9 | 10-is-bottom-RIGHT
RUN | $T/pb/gc.+x | $T/pg/chutes | $T/pgs | squarecell | 11
EXPECT_OUT | SQUARE 11 block=9,8 | 11-is-directly-ABOVE-10
RUN | $T/pb/gc.+x | $T/pg/chutes | $T/pgs | squarecell | 20
EXPECT_OUT | SQUARE 20 block=0,8 | 20-is-at-the-LEFT-end-of-row-2
RUN | $T/pb/gc.+x | $T/pg/chutes | $T/pgs | squarecell | 21
EXPECT_OUT | SQUARE 21 block=0,7 | 21-is-above-20
RUN | $T/pb/gc.+x | $T/pg/chutes | $T/pgs | squarecell | 45
EXPECT_OUT | SQUARE 45 block=4,5 | row-5-runs-left-to-right
RUN | $T/pb/gc.+x | $T/pg/chutes | $T/pgs | squarecell | 50
EXPECT_OUT | SQUARE 50 block=9,5 | 50-ends-row-5-on-the-right
RUN | $T/pb/gc.+x | $T/pg/chutes | $T/pgs | squarecell | 55
EXPECT_OUT | SQUARE 55 block=5,4 | row-6-runs-right-to-left
RUN | $T/pb/gc.+x | $T/pg/chutes | $T/pgs | squarecell | 91
EXPECT_OUT | SQUARE 91 block=9,0 | 91-is-top-right
RUN | $T/pb/gc.+x | $T/pg/chutes | $T/pgs | squarecell | 100
EXPECT_OUT | SQUARE 100 block=0,0 | 100-is-top-LEFT
RUN | $T/pb/gc.+x | $T/pg/chutes | $T/pgs | squarecell | 101
EXPECT_EXIT | 2 | NEGATIVE-square-101-is-not-on-a-100-square-track
RUN | $T/pb/gc.+x | $T/pg/chutes | $T/pgs | squarecell | 0
EXPECT_EXIT | 2 | NEGATIVE-square-0-is-the-start-strip-not-a-board-square
RUN | $T/pb/gc_flip.+x | $T/pg/chutes | $T/pgs | squarecell | 11
EXPECT_OUT | SQUARE 11 block=0,8 | MUTANT-with-the-direction-swapped-puts-11-at-the-LEFT-(so-the-pins-above-can-fail)
RUN | $T/pb/gc_flip.+x | $T/pg/chutes | $T/pgs | squarecell | 1
EXPECT_OUT | SQUARE 1 block=9,9 | and-1-at-the-bottom-RIGHT
COPYDIR | @.apps/chutes | pg/rows
RUN | sed | -i | s/path   \p serpentine/path   \p rows/ | $T/pg/rows/rulesets/default/board.pdl
RUN | $T/pb/gc.+x | $T/pg/rows | $T/pgs | squarecell | 11
EXPECT_OUT | SQUARE 11 block=0,8 | a-plain-`rows`-board-starts-every-row-at-the-left-(11-above-1)
RUN | $T/pb/gc.+x | $T/pg/rows | $T/pgs | squarecell | 100
EXPECT_OUT | SQUARE 100 block=9,0 | and-100-is-top-RIGHT-there
RUN | sed | -i | s/rows   \p 10/rows   \p 9/ | $T/pg/rows/rulesets/default/board.pdl
RUN | $T/pb/gc.+x | $T/pg/rows | $T/pgs | squarecell | 1
EXPECT_EXIT | 2 | NEGATIVE-cols-x-rows-9x10-not-equal-to-the-track-length-is-refused
EXPECT_OUT | must equal the TRACK length | with-the-reason

