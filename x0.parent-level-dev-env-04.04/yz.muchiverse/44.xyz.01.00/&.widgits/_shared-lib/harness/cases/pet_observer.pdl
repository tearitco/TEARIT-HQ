# pet_observer: scratch chat node under $T (never the live one); the manager's --dump hook prints what the window shows.
RESULTS | ../results/pet_observer.txt
ENV | LC_ALL | C
ENV | TZ | UTC

CASE    | rooms-and-lines
SCRATCH |
MKDIR | rooms/lobby
MKDIR | rooms/den
WRITE | rooms/lobby/messages.txt | MSG\p1\plobby\ppet-rex\p1700000000\phello from rex\nMSG\p2\plobby\pjb\p1700000060\phi rex\n
WRITE | rooms/den/messages.txt | MSG\p3\pden\ppet-ember\p1700000120\pquiet here\n
WRITE | pet_post_audit.txt | 1700000000\pSENT\ppet-rex\plobby\phello\n1700000001\pDENY-RATE\ppet-rex\plobby\pspam\n1700000002\pHELD\ppet-ember\pden\pwait\n
RUN | $HOUSE/&.hq-apps/pet-observer-hq/ops/+x/pet_observer_manager.+x | --dump | $T | lobby
EXPECT_EXIT | 0 | dump-runs
EXPECT_OUT | rooms=2 room=lobby msgs=2 aud=3 | two-rooms-two-lobby-lines-three-audit-rows
EXPECT_OUT | msg-pet\p22:13  pet-rex | pet-lines-are-coloured-as-pets
EXPECT_OUT | msg-human\p22:14  jb | human-lines-are-coloured-as-human
EXPECT_OUT | aud-deny\p | refusals-are-shown-red
EXPECT_OUT | aud-held\p | held-lines-are-shown
EXPECT_OUT | 1 pet posts sent, 1 refused, 1 held | guard-counts-are-right
EXPECT_OUT | Kill switch: off | kill-switch-off-by-default
EXPECT_OUT_LACKS | hello from rex, den | the-den-room-line-is-not-in-the-lobby

CASE    | kill-switch-and-room-switch
WRITE | pet_post_kill.txt | stop\n
RUN | $HOUSE/&.hq-apps/pet-observer-hq/ops/+x/pet_observer_manager.+x | --dump | $T | den
EXPECT_OUT | room=den msgs=1 | switching-room-shows-the-den
EXPECT_OUT | Kill switch: ON | kill-file-shows-as-ON
EXPECT_OUT | quiet here | den-line-shown
CLEAN |
