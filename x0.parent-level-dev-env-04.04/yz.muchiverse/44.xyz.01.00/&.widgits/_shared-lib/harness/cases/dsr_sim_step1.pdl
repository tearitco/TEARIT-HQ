SUMTREE | dry | hR/dsr_game
EXPECT_EQ | $at19 | $dry | restore-dry-run-changes-nothing
RUN | $T/gso | $T/store | $T/hR/dsr_game | restore | CP12 | $T/hR/dsr_game | --apply | --prune | --extra-dir | $T/hR/#.desktop/clocks | --now-ms | 3000
EXPECT_EXIT | 0 | restore-applied
SUMTREE | restored | hR/dsr_game
