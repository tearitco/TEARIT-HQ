MKDIR   | h1/common_events/dsr_day_tick/event_pkg
COPY    | &.widgits/dsr-sim/common_events/dsr_day_tick/event_pkg/target.pdl | h1/common_events/dsr_day_tick/event_pkg/target.pdl
COPY    | &.widgits/dsr-sim/scenario.pdl | h1/scenario.pdl
RUN | $T/gen | $T/h1/scenario.pdl | $T/h1/dsr_game
RUN | $T/lc.+x | $T/h1 | new | g1
RUN | $T/lc.+x | $T/h1 | reminder-add | g1 | 86400000 | common:dsr_day_tick |  | every:1day
RUN | $T/q | $T/h1/dsr_game | money
CAPTURE | total0
RUN | $T/lc.+x | $T/h1 | reminders
EXPECT_OUT | common:dsr_day_tick | schedule-row-points-at-common-dsr_day_tick
EXPECT_OUT | every:1day | schedule-row-repeats-every-1day
RUN | $T/lc.+x | $T/h1 | cmd | g1 | advance | 30d
RUN | $T/lc.+x | $T/h1 | step | 0
RUN | $T/lc.+x | $T/h1 | sched-count | r1
EXPECT_OUT_IS | 30 | fast-forward-30-days-fires-exactly-30-schedule-rows
EXPECT_NOFILE | h1/#.desktop/clocks/schedule_flags.txt | no-caught-up-collapse-flag-30-is-under-the-cap
RUN | $T/q | $T/h1/dsr_game | get | dsr_world | day
