RUN | $T/lc.+x | $T/hR | reminder-add | g1 | 86400000 | common:dsr_day_tick |  | every:1day
RUN | $T/lc.+x | $T/hU | cmd | g1 | advance | 30d
RUN | $T/lc.+x | $T/hU | step | 0
SUMTREE | uninterrupted | hU/dsr_game
RUN | $T/lc.+x | $T/hR | cmd | g1 | advance | 12d
