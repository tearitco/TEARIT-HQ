RUN | $T/gen | $T/h5/scenario.pdl | $T/h5/dsr_game
EXPECT_EXIT | 2 | hotel-refused-until-its-step-is-built
EXPECT_NOFILE | h5/dsr_game/pals/dsrtest_castle_a/variables.txt | refusal-happens-before-any-entity-is-written
MKDIR   | h6/common_events/dsr_day_tick/event_pkg
COPY    | &.widgits/dsr-sim/common_events/dsr_day_tick/event_pkg/target.pdl | h6/common_events/dsr_day_tick/event_pkg/target.pdl
COPY    | &.widgits/dsr-sim/scenario.pdl | h6/scenario.pdl
APPEND  | h6/scenario.pdl | TUNE | bank_reserves_c | 150000\n
RUN | $T/gen | $T/h6/scenario.pdl | $T/h6/dsr_game
EXPECT_HAS | h6/dsr_game/pals/dsrtest_store_a1/variables.txt | loan_balance=0\n | bank-under-2x-reserves-refuses-the-loan-WSR-bank_loan_op-rule
EXPECT_HAS | h6/dsr_game/pals/dsrtest_store_a1/variables.txt | cash=500000\n | no-loan-so-no-extra-cash
CLEAN |
CASE    | econ-30-days-jump
SCRATCH |
COPY    | &.widgits/livedesk-clock/ops/+x/lc_clock.+x | lc.+x
COPY    | &.widgits/_shared-lib/ops/+x/game_snapshot_op.+x | gso
