# dsr_sim_step1 (DSR-SIMULATION-DESIGN.md sections 5 step 1, 8, 8b, 9, 10): scenario generator + a deterministic 30-day headless economy run as the `common:dsr_day_tick`
# common event on the house clock (real lc_clock `repeat=every:1day`, catch-up, `step`). State = RPG Maker variables (variables.txt key=int) per entity, append-only
# dsr_history.txt per entity, WSR price/payroll/interest/pop formulas inside ops/dsr_day_tick.c. Scratch roots only (/tmp/hc_*): each case builds mini houses $T/<h>/
# (clock files, scenario, dsr_game). Authored once from a script (the 30-day step-by-step block is 60 repeated rows); it is plain data now, edit by hand.
RESULTS | ../results/dsr_sim_step1.txt
CASE    | gen-default-is-the-dsrtest-set
SCRATCH |
COPY    | &.widgits/livedesk-clock/ops/+x/lc_clock.+x | lc.+x
COPY    | &.widgits/_shared-lib/ops/+x/game_snapshot_op.+x | gso
COPY    | &.widgits/dsr-sim/ops/+x/dsr_scenario_gen.+x | gen
COPY    | &.widgits/dsr-sim/ops/+x/dsr_day_tick.+x | dsr_day_tick.+x
COPY    | &.widgits/dsr-sim/ops/+x/dsr_sim_query_op.+x | q
ENV     | LC_CLOCK_NO_POPUP | 1
ENV     | LC_CLOCK_EVENT_RUNNER | $T/dsr_day_tick.+x
MKDIR   | h1/common_events/dsr_day_tick/event_pkg
COPY    | &.widgits/dsr-sim/common_events/dsr_day_tick/event_pkg/target.pdl | h1/common_events/dsr_day_tick/event_pkg/target.pdl
COPY    | &.widgits/dsr-sim/scenario.pdl | h1/scenario.pdl
RUN | $T/gen | $T/h1/scenario.pdl | $T/h1/dsr_game
EXPECT_EXIT | 0 | gen-ok
RUN | /usr/bin/ls | $T/h1/dsr_game/pals
EXPECT_OUT_IS | dsrtest_bank_a1\ndsrtest_bank_a2\ndsrtest_bank_b1\ndsrtest_bank_b2\ndsrtest_castle_a\ndsrtest_castle_b\ndsrtest_population_a\ndsrtest_population_b\ndsrtest_store_a1\ndsrtest_store_a2\ndsrtest_store_a3\ndsrtest_store_a4\ndsrtest_store_b1\ndsrtest_store_b2\ndsrtest_store_b3\ndsrtest_store_b4 | exactly-the-16-dsrtest-entities-2-castles-4-banks-8-stores-2-pops
RUN | $T/q | $T/h1/dsr_game | positions
EXPECT_OUT | dsrtest_castle_a 800 80 | position-dsrtest_castle_a-matches-the-live-desk
EXPECT_OUT | dsrtest_bank_a1 880 80 | position-dsrtest_bank_a1-matches-the-live-desk
EXPECT_OUT | dsrtest_bank_a2 960 80 | position-dsrtest_bank_a2-matches-the-live-desk
EXPECT_OUT | dsrtest_store_a1 1040 80 | position-dsrtest_store_a1-matches-the-live-desk
EXPECT_OUT | dsrtest_store_a2 800 240 | position-dsrtest_store_a2-matches-the-live-desk
EXPECT_OUT | dsrtest_store_a3 880 240 | position-dsrtest_store_a3-matches-the-live-desk
EXPECT_OUT | dsrtest_store_a4 960 240 | position-dsrtest_store_a4-matches-the-live-desk
EXPECT_OUT | dsrtest_population_a 1120 240 | position-dsrtest_population_a-matches-the-live-desk
EXPECT_OUT | dsrtest_castle_b 1600 80 | position-dsrtest_castle_b-matches-the-live-desk
EXPECT_OUT | dsrtest_bank_b1 1680 80 | position-dsrtest_bank_b1-matches-the-live-desk
EXPECT_OUT | dsrtest_bank_b2 1760 80 | position-dsrtest_bank_b2-matches-the-live-desk
EXPECT_OUT | dsrtest_store_b1 1840 80 | position-dsrtest_store_b1-matches-the-live-desk
EXPECT_OUT | dsrtest_store_b2 1600 240 | position-dsrtest_store_b2-matches-the-live-desk
EXPECT_OUT | dsrtest_store_b3 1680 240 | position-dsrtest_store_b3-matches-the-live-desk
EXPECT_OUT | dsrtest_store_b4 1760 240 | position-dsrtest_store_b4-matches-the-live-desk
EXPECT_OUT | dsrtest_population_b 1840 240 | position-dsrtest_population_b-matches-the-live-desk
RUN | $T/q | $T/h1/dsr_game | nodupcells
EXPECT_OUT_IS | ok | no-two-entities-share-a-cell
RUN | /usr/bin/grep | -c | ^DESK | $T/h1/dsr_game/sessions/s1/desks/dsr-test.pdl
EXPECT_OUT_IS | 16 | desk-file-has-16-rows
EXPECT_HAS | h1/dsr_game/sessions/s1/desks/dsr-test.pdl | DESK \p dsrtest_castle_a \p pals/dsrtest_castle_a \p 800 \p 80 \p 10 \p 1 \p 🏰 \p 144 | desk-row-shape-like-the-live-desk
EXPECT_FILE | h1/dsr_game/pals/dsrtest_store_a1/pal.pdl | PAL \p name \p dsrtest_store_a1\nPAL \p glyph \p 🏪\n | pal-pdl-shape-no-hash
EXPECT_LACKS | h1/dsr_game/pals/dsrtest_store_a1/pal.pdl | PAL \p hash | no-frozen-hash-identity
EXPECT_NOFILE | h1/dsr_game/pals/dsrtest_store_a1/entity_uid.txt | no-entity-uid-minted-on-first-spawn
EXPECT_HAS | h1/dsr_game/pals/dsrtest_store_a1/meta.pdl | META         \p piece_id           \p dsrtest_store_a1 | meta-piece-id-row
EXPECT_FILE | h1/dsr_game/pals/dsrtest_store_a1/instance_id.txt | DT4\n | instance-id-DT4-like-the-live-copy
EXPECT_FILE | h1/dsr_game/pals/dsrtest_population_b/instance_id.txt | DT16\n | instance-id-DT16-like-the-live-copy
EXPECT_FILE | h1/dsr_game/pals/dsrtest_store_a4/glyph.txt | 🏫 | store-4-glyph-like-the-live-desk
EXPECT_HAS | h1/dsr_game/pals/dsrtest_store_a1/variables.txt | cash=600000\n | initial-dsrtest_store_a1-cash=600000
EXPECT_HAS | h1/dsr_game/pals/dsrtest_store_a1/variables.txt | shares=1000\n | initial-dsrtest_store_a1-shares=1000
EXPECT_HAS | h1/dsr_game/pals/dsrtest_store_a1/variables.txt | stock=50\n | initial-dsrtest_store_a1-stock=50
EXPECT_HAS | h1/dsr_game/pals/dsrtest_store_a1/variables.txt | loan_balance=100000\n | initial-dsrtest_store_a1-loan_balance=100000
EXPECT_HAS | h1/dsr_game/pals/dsrtest_store_a2/variables.txt | loan_bank=2\n | initial-dsrtest_store_a2-loan_bank=2
EXPECT_HAS | h1/dsr_game/pals/dsrtest_store_a1/variables.txt | good_id=1\n | initial-dsrtest_store_a1-good_id=1
EXPECT_HAS | h1/dsr_game/pals/dsrtest_store_a4/variables.txt | good_id=4\n | initial-dsrtest_store_a4-good_id=4
EXPECT_HAS | h1/dsr_game/pals/dsrtest_bank_a1/variables.txt | reserves=1800000\n | initial-dsrtest_bank_a1-reserves=1800000
EXPECT_HAS | h1/dsr_game/pals/dsrtest_bank_a1/variables.txt | loans_out=200000\n | initial-dsrtest_bank_a1-loans_out=200000
EXPECT_HAS | h1/dsr_game/pals/dsrtest_bank_a1/variables.txt | rate=2000\n | initial-dsrtest_bank_a1-rate=2000
EXPECT_HAS | h1/dsr_game/pals/dsrtest_castle_a/variables.txt | treasury=100000\n | initial-dsrtest_castle_a-treasury=100000
EXPECT_HAS | h1/dsr_game/pals/dsrtest_castle_a/variables.txt | tax_rate=10\n | initial-dsrtest_castle_a-tax_rate=10
EXPECT_HAS | h1/dsr_game/pals/dsrtest_population_a/variables.txt | count=1000\n | initial-dsrtest_population_a-count=1000
EXPECT_HAS | h1/dsr_game/pals/dsrtest_population_a/variables.txt | cash=1000000\n | initial-dsrtest_population_a-cash=1000000
EXPECT_HAS | h1/dsr_game/pals/dsrtest_population_b/variables.txt | unemployment=1000\n | initial-dsrtest_population_b-unemployment=1000
EXPECT_FILE | h1/dsr_game/dsr_world/variables.txt | day=0\nseed=1789\ncivs=2\nsink=0\n | world-state-day0-seed-civs-sink
EXPECT_HAS | h1/dsr_game/dsr_world/world_ledger.txt | SETUP\pcivs\p2\nSETUP\pseed\p1789\n | ledger-starts-with-the-SETUP-rows
EXPECT_HAS | h1/dsr_game/dsr_world/world_ledger.txt | START\p0\p14200000\p0\p800000\p800000\n | ledger-START-row-total-sink-loans
RUN | $T/q | $T/h1/dsr_game | rows
EXPECT_OUT_IS | min=0 max=0 entities=16 | no-history-rows-before-day-1
RUN | $T/q | $T/h1/dsr_game | total
EXPECT_OUT_IS | total=14200000 sink=0 loans_out=800000 loans_owed=800000 day=0 | independent-total-equals-the-START-row
RUN | $T/gen | $T/h1/scenario.pdl | $T/h1/dsr_game
EXPECT_EXIT | 2 | gen-refuses-to-overwrite-an-existing-game
RUN | $T/gen | $T/h1/scenario.pdl | $T/h2/dsr_game | --seed | 7
EXPECT_HAS | h2/dsr_game/dsr_world/variables.txt | seed=7\n | seed-flag-overrides-the-SETUP-seed
EXPECT_HAS | h2/dsr_game/dsr_world/world_ledger.txt | SETUP\peffective_seed\p7\n | effective-seed-is-ledgered
CLEAN |
CASE    | gen-variants
SCRATCH |
COPY    | &.widgits/livedesk-clock/ops/+x/lc_clock.+x | lc.+x
COPY    | &.widgits/_shared-lib/ops/+x/game_snapshot_op.+x | gso
COPY    | &.widgits/dsr-sim/ops/+x/dsr_scenario_gen.+x | gen
COPY    | &.widgits/dsr-sim/ops/+x/dsr_day_tick.+x | dsr_day_tick.+x
COPY    | &.widgits/dsr-sim/ops/+x/dsr_sim_query_op.+x | q
ENV     | LC_CLOCK_NO_POPUP | 1
ENV     | LC_CLOCK_EVENT_RUNNER | $T/dsr_day_tick.+x
MKDIR   | h1/common_events/dsr_day_tick/event_pkg
COPY    | &.widgits/dsr-sim/common_events/dsr_day_tick/event_pkg/target.pdl | h1/common_events/dsr_day_tick/event_pkg/target.pdl
COPY    | &.widgits/dsr-sim/scenario.pdl | h1/scenario.pdl
APPEND  | h1/scenario.pdl | SETUP | civ.a.free | castle=1,bank=1,store=2\n
RUN | $T/gen | $T/h1/scenario.pdl | $T/h1/dsr_game
EXPECT_EXIT | 0 | gen-civ-A-smaller-ok
RUN | /usr/bin/ls | $T/h1/dsr_game/pals
EXPECT_OUT_IS | dsrtest_bank_a1\ndsrtest_bank_b1\ndsrtest_bank_b2\ndsrtest_castle_a\ndsrtest_castle_b\ndsrtest_population_a\ndsrtest_population_b\ndsrtest_store_a1\ndsrtest_store_a2\ndsrtest_store_b1\ndsrtest_store_b2\ndsrtest_store_b3\ndsrtest_store_b4 | civ-A-free-list-changes-only-civ-A-the-B-block-is-intact
EXPECT_HAS | h1/dsr_game/pals/dsrtest_store_b4/variables.txt | cash=600000\n | civ-B-store-4-unchanged-and-still-loaned
EXPECT_HAS | h1/dsr_game/pals/dsrtest_bank_a1/variables.txt | loans_out=200000\n | one-bank-lends-to-both-A-stores
EXPECT_HAS | h1/dsr_game/pals/dsrtest_bank_a1/variables.txt | reserves=1800000\n | reserves-drop-by-both-loans
RUN | $T/q | $T/h1/dsr_game | nodupcells
EXPECT_OUT_IS | ok | no-overlap-in-the-variant
MKDIR   | h2/common_events/dsr_day_tick/event_pkg
COPY    | &.widgits/dsr-sim/common_events/dsr_day_tick/event_pkg/target.pdl | h2/common_events/dsr_day_tick/event_pkg/target.pdl
COPY    | &.widgits/dsr-sim/scenario.pdl | h2/scenario.pdl
