RUN | $T/lc.+x | $T/hU | new | g1
RUN | $T/lc.+x | $T/hU | reminder-add | g1 | 86400000 | common:dsr_day_tick |  | every:1day
MKDIR   | hR/common_events/dsr_day_tick/event_pkg
COPY    | &.widgits/dsr-sim/common_events/dsr_day_tick/event_pkg/target.pdl | hR/common_events/dsr_day_tick/event_pkg/target.pdl
COPY    | &.widgits/dsr-sim/scenario.pdl | hR/scenario.pdl
