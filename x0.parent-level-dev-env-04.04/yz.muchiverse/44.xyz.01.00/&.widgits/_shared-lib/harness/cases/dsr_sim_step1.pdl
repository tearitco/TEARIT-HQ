SCRATCH |
COPY    | &.widgits/livedesk-clock/ops/+x/lc_clock.+x | lc.+x
COPY    | &.widgits/_shared-lib/ops/+x/game_snapshot_op.+x | gso
COPY    | &.widgits/dsr-sim/ops/+x/dsr_scenario_gen.+x | gen
COPY    | &.widgits/dsr-sim/ops/+x/dsr_day_tick.+x | dsr_day_tick.+x
COPY    | &.widgits/dsr-sim/ops/+x/dsr_sim_query_op.+x | q
ENV     | LC_CLOCK_NO_POPUP | 1
ENV     | LC_CLOCK_EVENT_RUNNER | $T/dsr_day_tick.+x
MKDIR   | h1/common_events/dsr_day_tick/event_pkg
COPY    | &.widgits/dsr-sim/common_events/dsr_day_tick/event_pkg/target.pdl | h1/common_events/dsr_day_tick/event_pkg/target.pdl
COPY    | &.widgits/dsr-sim/scenario.pdl | h1/scenario.pdl
APPEND  | h1/scenario.pdl | TUNE | bank_rate_ppm | 2000000\n
APPEND  | h1/scenario.pdl | TUNE | store_cash_c | 1\n
RUN | $T/gen | $T/h1/scenario.pdl | $T/h1/dsr_game
RUN | $T/lc.+x | $T/h1 | new | g1
RUN | $T/lc.+x | $T/h1 | reminder-add | g1 | 86400000 | common:dsr_day_tick |  | every:1day
RUN | $T/lc.+x | $T/h1 | cmd | g1 | advance | 3d
RUN | $T/lc.+x | $T/h1 | step | 0
RUN | $T/q | $T/h1/dsr_game | debtbalanced
EXPECT_OUT_IS | ok | compounded-interest-grows-bank-loans-out-and-store-balance-together
RUN | $T/q | $T/h1/dsr_game | above | dsrtest_store_a1 | loan_balance | 100000
EXPECT_OUT_IS | ok | unpaid-interest-compounds-onto-the-balance-WSR-loan-times-1-plus-rate
RUN | $T/q | $T/h1/dsr_game | ledgerconst | 2
EXPECT_OUT_IS | ok rows=3 | cash-conserved-while-debt-compounds
CLEAN |
