EXPECT_HAS | h4/dsr_game/pals/dsrtest_population_b/variables.txt | count=1000\ncash=1000000\n | civ-b-pool-untouched
MKDIR   | h5/common_events/dsr_day_tick/event_pkg
COPY    | &.widgits/dsr-sim/common_events/dsr_day_tick/event_pkg/target.pdl | h5/common_events/dsr_day_tick/event_pkg/target.pdl
