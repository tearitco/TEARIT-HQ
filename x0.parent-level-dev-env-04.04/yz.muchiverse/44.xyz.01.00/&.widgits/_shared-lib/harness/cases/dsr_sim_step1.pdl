EXPECT_OUT_IS | 12 | restored-world-day-is-12
RUN | $T/q | $T/hR/dsr_game | rows
EXPECT_OUT_IS | min=12 max=12 entities=16 | restored-history-has-12-rows-everywhere
RUN | $T/lc.+x | $T/hR | sched-count | r1
EXPECT_OUT_IS | 12 | restored-schedule-ledger-has-12-rows
RUN | $T/lc.+x | $T/hR | step | 0
RUN | $T/q | $T/hR/dsr_game | get | dsr_world | day
EXPECT_OUT_IS | 12 | stepping-after-the-restore-applies-no-tick-twice
