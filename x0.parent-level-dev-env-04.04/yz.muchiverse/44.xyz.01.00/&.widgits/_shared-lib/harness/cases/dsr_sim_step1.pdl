RUN | $T/lc.+x | $T/hR | step | 0
RUN | $T/q | $T/hR/dsr_game | get | dsr_world | day
EXPECT_OUT_IS | 30 | continued-to-day-30
RUN | $T/lc.+x | $T/hR | sched-count | r1
EXPECT_OUT_IS | 30 | schedule-ledger-30-after-the-continue
SUMTREE | continued | hR/dsr_game
EXPECT_EQ | $uninterrupted | $continued | save-restore-then-continue-equals-the-uninterrupted-30-day-run-byte-for-byte
RUN | $T/q | $T/hR/dsr_game | ledgerconst | 2
EXPECT_OUT_IS | ok rows=30 | ledger-total-const-across-the-restore
