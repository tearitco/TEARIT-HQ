CASE    | trip-moves-the-body
RUN | $T/rk | $T/trip.pdl
EXPECT_OUT | TELEPORTED 1 SCORE 0 FROM 1,1 TO 4,1 HERO 1052,312 VX 0 VY 0 LEVEL ....../.t..t./....../###### | HAND-COMPUTED-center-in-(1,1)-sender-tile-0-to-tile-1-(4,1):-x-4*256+128-100=1052-y-2*256-200=312
EXPECT_EXIT | 0 | the-op-runs
RUN | $T/rk | $T/small.pdl
EXPECT_OUT | TELEPORTED 1 SCORE 0 FROM 1,1 TO 4,1 HERO 1102,412 VX 0 VY 0 LEVEL ....../.t..t./....../###### | HAND-COMPUTED-a-100-box-lands-centered:-x-1024+128-50=1102-y-512-100=412
RUN | $T/rk | $T/tripvel.pdl
EXPECT_OUT | TELEPORTED 1 SCORE 0 FROM 1,1 TO 4,1 HERO 1052,312 VX 33 VY 0 LEVEL ....../.t..t./....../###### | HAND-COMPUTED-vy-is-zeroed-(-77-to-0)-and-vx-is-kept-(33)

CASE    | trigger-is-the-center-cell
RUN | $T/rk | $T/overlap.pdl
EXPECT_OUT | TELEPORTED 0 SCORE 0 FROM - TO - HERO 100,300 VX 0 VY 0 LEVEL ....../.t..t./....../###### | HAND-COMPUTED-the-box-100..299-overlaps-tile-column-1-but-its-center-x-200-is-column-0:-no-trip-(an-overlap-rule-would-trip)
RUN | $T/rk | $T/cx256.pdl
EXPECT_OUT | TELEPORTED 1 SCORE 0 FROM 1,1 TO 4,1 HERO 1052,312 | HAND-COMPUTED-x-156-plus-100-is-center-256-which-is-column-1
RUN | $T/rk | $T/cx255.pdl
EXPECT_OUT | TELEPORTED 0 SCORE 0 FROM - TO - HERO 155,300 | HAND-COMPUTED-center-255-is-column-0
RUN | $T/rk | $T/cy256.pdl
EXPECT_OUT | TELEPORTED 1 SCORE 0 FROM 1,1 TO 4,1 HERO 1052,312 | HAND-COMPUTED-y-156-plus-100-is-center-256-which-is-row-1
RUN | $T/rk | $T/cy255.pdl
EXPECT_OUT | TELEPORTED 0 SCORE 0 FROM - TO - HERO 300,155 | HAND-COMPUTED-center-y-255-is-row-0

CASE    | an-exit-sends-nothing
RUN | $T/rk | $T/onexit.pdl
EXPECT_OUT | TELEPORTED 0 SCORE 0 FROM - TO - HERO 1052,312 VX 0 VY 0 LEVEL ....../.t..t./....../###### | HAND-COMPUTED-the-center-(1152,412)-is-the-exit-(4,1):-tile-1-is-odd-so-no-bounce-and-no-loop

