RUN | $T/rk | $T/norule.pdl
EXPECT_EXIT | 2 | NEGATIVE-a-scene-without-RULE-teleport_fee-is-refused
EXPECT_OUT | the number is data, there is no default | and-the-op-says-why
RUN | $T/rk | $T/notile.pdl
EXPECT_EXIT | 2 | NEGATIVE-a-scene-without-TILE-teleport-is-refused
RUN | $T/rk | $T/badrule.pdl
EXPECT_EXIT | 2 | NEGATIVE-an-unknown-RULE-key-is-refused

CASE    | event-page
RUN | grep | -c | ^COMMAND rule_teleport$ | $HOUSE/#.ref/menu/event_commands.registry.pdl
EXPECT_OUT_IS | 1 | the-registry-has-exactly-one-COMMAND-rule_teleport-row
EXPECT_HAS | $HOUSE/@.apps/teario/events/tm_teleport/event_pkg/pages/page_1/event.ir.pdl | type=rule_teleport | the-page-command-is-the-registered-type
EXPECT_HAS | $HOUSE/@.apps/teario/events/tm_teleport/event_pkg/pages/page_1/condition.pdl | COND \p trigger \p ui | the-page-has-a-trigger
