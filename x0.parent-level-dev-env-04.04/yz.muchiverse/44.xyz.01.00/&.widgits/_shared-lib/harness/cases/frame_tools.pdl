# frame_tools: LOCKED cases for raw_to_png and frame_stats. Sources: &.widgits/_shared-lib/ops/raw_to_png.c and frame_stats.c compiled -Wall -Wextra -Werror from source into the scratch.
# Fixture pictures are generated by a small independent Python oracle that also computes the expected numbers (dominant colour share, colour bins, luminance mean / stddev, neighbour edge), not by the C program. The case that motivated frame_stats:
# `brown_with_text.png` = a flat brown canvas with a white debug-text block in a corner: 96 percent one colour, so the whole picture only reads `sparse`; looking at the middle (--inset 25) reads `blank`.
RESULTS | ../results/frame_tools.txt
SCRATCH |
COPY | &.widgits/_shared-lib/harness/fixtures/frames/flat_brown.png | flat_brown.png
COPY | &.widgits/_shared-lib/harness/fixtures/frames/half.png | half.png
COPY | &.widgits/_shared-lib/harness/fixtures/frames/half_rgba.png | half_rgba.png
COPY | &.widgits/_shared-lib/harness/fixtures/frames/stars.png | stars.png
COPY | &.widgits/_shared-lib/harness/fixtures/frames/dark.png | dark.png
COPY | &.widgits/_shared-lib/harness/fixtures/frames/noise.png | noise.png
COPY | &.widgits/_shared-lib/harness/fixtures/frames/brown_with_text.png | brown_with_text.png
COPY | &.widgits/_shared-lib/harness/fixtures/frames/not_a_png.png | not_a_png.png
COPY | &.widgits/_shared-lib/harness/fixtures/frames/tiny.raw | tiny.raw
CASE | build
RUN | gcc | -std=gnu11 | -Wall | -Wextra | -Werror | -O2 | -o | $T/fs.+x | $HOUSE/&.widgits/_shared-lib/ops/frame_stats.c | -lpng | -lm
EXPECT_EXIT | 0 | frame_stats-compiles-clean-with-werror
RUN | gcc | -std=gnu11 | -Wall | -Wextra | -Werror | -O2 | -o | $T/rp.+x | $HOUSE/&.widgits/_shared-lib/ops/raw_to_png.c | -lpng
EXPECT_EXIT | 0 | raw_to_png-compiles-clean-with-werror

CASE | flat
RUN | $T/fs.+x | $T/flat_brown.png
EXPECT_EXIT | 1 | flat-exit-1
EXPECT_OUT | dominant_pct=100.00 | flat-dominant_pct
EXPECT_OUT | dominant_rgb=56,40,24 | flat-dominant_rgb
EXPECT_OUT | colors=1 | flat-colors
EXPECT_OUT | mean_lum=42.25 | flat-mean_lum
EXPECT_OUT | lum_stddev=0.00 | flat-lum_stddev
EXPECT_OUT | edge=0.000 | flat-edge
EXPECT_OUT | verdict=blank | flat-verdict-blank
EXPECT_OUT | size=40x30 | size
EXPECT_OUT | pixels=1200 | pixel-count

CASE | half
RUN | $T/fs.+x | $T/half.png
EXPECT_EXIT | 0 | half-exit-0
EXPECT_OUT | dominant_pct=50.00 | half-dominant_pct
EXPECT_OUT | dominant_rgb=40,40,40 | half-dominant_rgb
EXPECT_OUT | colors=2 | half-colors
EXPECT_OUT | mean_lum=120.00 | half-mean_lum
EXPECT_OUT | lum_stddev=80.00 | half-lum_stddev
EXPECT_OUT | edge=2.060 | half-edge
EXPECT_OUT | verdict=ok | half-verdict-ok
EXPECT_OUT | dominant_rgb=40,40,40 | a-tie-goes-to-the-lowest-colour-bin

CASE | stars
RUN | $T/fs.+x | $T/stars.png
EXPECT_EXIT | 0 | stars-exit-0
EXPECT_OUT | dominant_pct=95.00 | stars-dominant_pct
EXPECT_OUT | dominant_rgb=8,8,8 | stars-dominant_rgb
EXPECT_OUT | colors=2 | stars-colors
EXPECT_OUT | mean_lum=22.00 | stars-mean_lum
EXPECT_OUT | lum_stddev=52.31 | stars-lum_stddev
EXPECT_OUT | edge=24.000 | stars-edge
EXPECT_OUT | verdict=sparse | stars-verdict-sparse

CASE | dark
RUN | $T/fs.+x | $T/dark.png
EXPECT_EXIT | 1 | dark-exit-1
EXPECT_OUT | dominant_pct=80.00 | dark-dominant_pct
EXPECT_OUT | dominant_rgb=8,8,8 | dark-dominant_rgb
EXPECT_OUT | colors=2 | dark-colors
EXPECT_OUT | mean_lum=5.60 | dark-mean_lum
EXPECT_OUT | lum_stddev=7.20 | dark-lum_stddev
EXPECT_OUT | edge=3.316 | dark-edge
EXPECT_OUT | verdict=dark | dark-verdict-dark

CASE | noise
RUN | $T/fs.+x | $T/noise.png
EXPECT_EXIT | 0 | noise-exit-0
EXPECT_OUT | dominant_pct=0.15 | noise-dominant_pct
EXPECT_OUT | dominant_rgb=72,24,168 | noise-dominant_rgb
EXPECT_OUT | colors=9 | noise-colors
EXPECT_OUT | mean_lum=128.16 | noise-mean_lum
EXPECT_OUT | lum_stddev=55.89 | noise-lum_stddev
EXPECT_OUT | edge=63.854 | noise-edge
EXPECT_OUT | verdict=ok | noise-verdict-ok

CASE | noise_rect
RUN | $T/fs.+x | $T/noise.png | --rect | 10,10,30,20
EXPECT_EXIT | 0 | noise_rect-exit-0
EXPECT_OUT | dominant_pct=0.50 | noise_rect-dominant_pct
EXPECT_OUT | dominant_rgb=24,40,56 | noise_rect-dominant_rgb
EXPECT_OUT | colors=559 | noise_rect-colors
EXPECT_OUT | mean_lum=129.46 | noise_rect-mean_lum
EXPECT_OUT | lum_stddev=55.98 | noise_rect-lum_stddev
EXPECT_OUT | edge=63.264 | noise_rect-edge
EXPECT_OUT | verdict=ok | noise_rect-verdict-ok
EXPECT_OUT | pixels=600 | the-rectangle-has-600-pixels

CASE | alpha_ignored
RUN | $T/fs.+x | $T/half_rgba.png
EXPECT_EXIT | 0 | alpha_ignored-exit-0
EXPECT_OUT | dominant_pct=50.00 | alpha_ignored-dominant_pct
EXPECT_OUT | dominant_rgb=40,40,40 | alpha_ignored-dominant_rgb
EXPECT_OUT | colors=2 | alpha_ignored-colors
EXPECT_OUT | mean_lum=120.00 | alpha_ignored-mean_lum
EXPECT_OUT | lum_stddev=80.00 | alpha_ignored-lum_stddev
EXPECT_OUT | edge=2.060 | alpha_ignored-edge
EXPECT_OUT | verdict=ok | alpha_ignored-verdict-ok

CASE | text_corner_whole
RUN | $T/fs.+x | $T/brown_with_text.png
EXPECT_EXIT | 0 | text_corner_whole-exit-0
EXPECT_OUT | dominant_pct=96.00 | text_corner_whole-dominant_pct
EXPECT_OUT | dominant_rgb=56,40,24 | text_corner_whole-dominant_rgb
EXPECT_OUT | colors=2 | text_corner_whole-colors
EXPECT_OUT | mean_lum=50.76 | text_corner_whole-mean_lum
EXPECT_OUT | lum_stddev=41.69 | text_corner_whole-lum_stddev
EXPECT_OUT | edge=0.430 | text_corner_whole-edge
EXPECT_OUT | verdict=sparse | text_corner_whole-verdict-sparse
EXPECT_OUT | dominant_pct=96.00 | the-text-block-is-4-percent

CASE | text_corner_middle
RUN | $T/fs.+x | $T/brown_with_text.png | --inset | 25
EXPECT_EXIT | 1 | text_corner_middle-exit-1
EXPECT_OUT | dominant_pct=100.00 | text_corner_middle-dominant_pct
EXPECT_OUT | dominant_rgb=56,40,24 | text_corner_middle-dominant_rgb
EXPECT_OUT | colors=1 | text_corner_middle-colors
EXPECT_OUT | mean_lum=42.25 | text_corner_middle-mean_lum
EXPECT_OUT | lum_stddev=0.00 | text_corner_middle-lum_stddev
EXPECT_OUT | edge=0.000 | text_corner_middle-edge
EXPECT_OUT | verdict=blank | text_corner_middle-verdict-blank
EXPECT_OUT | pixels=2500 | the-middle-50-by-50

CASE | thresholds
RUN | $T/fs.+x | $T/brown_with_text.png | --flat | 95
EXPECT_EXIT | 1 | a-lower-flat-limit-flags-it
EXPECT_OUT | verdict=flat | flat
RUN | $T/fs.+x | $T/brown_with_text.png | --blank | 96
EXPECT_EXIT | 1 | a-lower-blank-limit-too
EXPECT_OUT | verdict=blank | blank
RUN | $T/fs.+x | $T/dark.png | --dark | 1
EXPECT_EXIT | 0 | a-lower-dark-limit-passes-the-dark-picture
EXPECT_OUT | verdict=sparse | and-it-is-then-only-sparse

CASE | inset-edge
RUN | $T/fs.+x | $T/brown_with_text.png | --inset | 45
EXPECT_EXIT | 1 | inset-45-leaves-10-by-10-all-brown
EXPECT_OUT | pixels=100 | ten-by-ten
EXPECT_OUT | verdict=blank | blank
RUN | $T/fs.+x | $T/brown_with_text.png | --rect | 30,30,40,40
EXPECT_EXIT | 1 | a-rectangle-away-from-the-text
EXPECT_OUT | verdict=blank | blank

CASE | frame_stats-errors
RUN | $T/fs.+x | $T/not_a_png.png
EXPECT_EXIT | 2 | not-a-png
RUN | $T/fs.+x | $T/nothere.png
EXPECT_EXIT | 2 | missing
RUN | $T/fs.+x | $T/half.png | --rect | 0,0,99,99
EXPECT_EXIT | 2 | a-rectangle-outside-the-picture
RUN | $T/fs.+x | $T/half.png | --inset | 46
EXPECT_EXIT | 2 | inset-over-45
RUN | $T/fs.+x | $T/half.png | --bogus
EXPECT_EXIT | 2 | unknown-option
RUN | $T/fs.+x
EXPECT_EXIT | 2 | no-arguments

CASE | raw_to_png
RUN | $T/rp.+x | $T/tiny.raw | $T/tiny.png | --size | 4x2
EXPECT_EXIT | 0 | converts-with-an-explicit-size
EXPECT_OUT | wrote | says-so
EXPECT_OUT | 4x2 | with-the-size
EXPECT_EXISTS | tiny.png | the-png-exists
RUN | $T/fs.+x | $T/tiny.png
EXPECT_EXIT | 0 | the-converted-picture-is-readable
EXPECT_OUT | pixels=8 | eight-pixels
EXPECT_OUT | colors=5 | red-green-blue-white-black
EXPECT_OUT | mean_lum=63.75 | red-green-blue-white-over-8-is-510-over-8
EXPECT_OUT | dominant_pct=50.00 | four-black-pixels
EXPECT_OUT | verdict=ok | ok
RUN | $T/fs.+x | $T/tiny.png | --rect | 0,1,4,1
EXPECT_EXIT | 1 | the-second-row-is-all-black
EXPECT_OUT | verdict=blank | so-the-top-row-is-written-first
RUN | $T/fs.+x | $T/tiny.png | --rect | 0,0,4,1
EXPECT_EXIT | 0 | the-first-row-is-the-four-colours
EXPECT_OUT | colors=4 | four-colours
EXPECT_OUT | dominant_pct=25.00 | each-a-quarter
EXPECT_OUT | dominant_rgb=8,8,248 | the-tie-goes-to-the-lowest-bin-which-is-blue

CASE | raw_to_png-receipt
WRITE | r1.txt | overlay_w=4\noverlay_h=2\nother=7\n
RUN | $T/rp.+x | $T/tiny.raw | $T/viaR1.png | --receipt | $T/r1.txt
EXPECT_EXIT | 0 | the-engine-receipt-form
EXPECT_EXISTS | viaR1.png | written
WRITE | r2.txt | w=4\nh=2\n
RUN | $T/rp.+x | $T/tiny.raw | $T/viaR2.png | --receipt | $T/r2.txt
EXPECT_EXIT | 0 | the-plain-w-h-form
WRITE | r3.txt | nothing=here\n
RUN | $T/rp.+x | $T/tiny.raw | $T/viaR3.png | --receipt | $T/r3.txt
EXPECT_EXIT | 2 | a-receipt-without-a-size-is-refused
EXPECT_NOFILE | viaR3.png | and-writes-nothing

CASE | raw_to_png-refusals
RUN | $T/rp.+x | $T/tiny.raw | $T/bad.png | --size | 3x3
EXPECT_EXIT | 2 | a-wrong-length-is-refused
EXPECT_NOFILE | bad.png | and-nothing-is-written
RUN | $T/rp.+x | $T/tiny.raw | $T/bad2.png | --size | 0x4
EXPECT_EXIT | 2 | a-zero-size
RUN | $T/rp.+x | $T/nothere.raw | $T/bad3.png | --size | 4x2
EXPECT_EXIT | 1 | an-unreadable-input
RUN | $T/rp.+x | $T/tiny.raw | $T/bad4.png
EXPECT_EXIT | 2 | no-size-given
RUN | $T/rp.+x | $T/tiny.raw | $T/bad5.png | --size | fourbytwo
EXPECT_EXIT | 2 | an-unparsable-size
CLEAN |
