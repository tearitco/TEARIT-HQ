RUN | $T/bc.+x | $T/orphan_folder/h/@.apps/g/g-pchq | --house | $T/orphan_folder/h
EXPECT_EXIT | 1 | orphan_folder-exit-1
EXPECT_OUT | FAIL B4 no_orphans: 1 map folder(s) are not in game.pdl, the first is `attic` | attic-is-not-a-desk

CASE | page_option
MKDIR | page_option/h/pals/castle
MKDIR | page_option/h/pals/asa
MKDIR | page_option/h/@.apps/g/pieces/hero_01
MKDIR | page_option/h/@.apps/g/pieces/xelector_01
MKDIR | page_option/h/@.apps/g/pieces/display
MKDIR | page_option/h/@.apps/g/g-pchq/pieces/display
MKDIR | page_option/h/sessions/s1/desks
WRITE | page_option/h/sessions/s1/desks/office.pdl | DESK \p castle \p pals/castle \p 80 \p 80 \p 1 \p 1 \p c \p 50\nDESK \p asa \p pals/asa \p 160 \p 0 \p 2 \p 0 \p a \p 39\nDESK \p hero_01 \p @.apps/g/pieces/hero_01 \p 160 \p 160 \p 2 \p 2 \p . \p 0\nDESK \p xelector_01 \p @.apps/g/pieces/xelector_01 \p 160 \p 160 \p 2 \p 2 \p hero_01 \p 20\nDESK \p camera_01 \p @.apps/g/pieces/display \p 80 \p 0 \p 1 \p 0 \p m=2,y=180,p=6,z=-3,h=0 \p 0\n
MKDIR | page_option/h/sessions/s1
WRITE | page_option/h/sessions/s1/session.pdl | STATE \p name \p b1\nSTATE \p active_desk \p office\n
WRITE | page_option/h/@.apps/g/g-pchq/pieces/display/open_book_page.txt | source=board\n
MKDIR | page_option/h/@.apps/g/g-pchq/pieces/system/maps/g
WRITE | page_option/h/@.apps/g/g-pchq/pieces/system/maps/g/game.pdl | GAME \p type \p board-game\nGAME \p n_desks \p 3\nGAME \p desk_1_id \p bridge\nGAME \p desk_2_id \p quarters\nGAME \p desk_3_id \p hold\n
MKDIR | page_option/h/@.apps/g/g-pchq/pieces/system/maps/g/bridge
WRITE | page_option/h/@.apps/g/g-pchq/pieces/system/maps/g/bridge/map.txt | ....\n
MKDIR | page_option/h/@.apps/g/g-pchq/pieces/system/maps/g/quarters
WRITE | page_option/h/@.apps/g/g-pchq/pieces/system/maps/g/quarters/map.txt | ....\n
MKDIR | page_option/h/@.apps/g/g-pchq/pieces/system/maps/g/hold
WRITE | page_option/h/@.apps/g/g-pchq/pieces/system/maps/g/hold/map.txt | ....\n
RUN | $T/bc.+x | $T/page_option/h/@.apps/g/g-pchq | --house | $T/page_option/h | --page | $T/page_option/h/sessions/s1/desks/office.pdl
EXPECT_EXIT | 0 | the-forced-page-is-checked-as-if-bound
EXPECT_OUT | PASS A2 source_desk: --page given | note-instead-of-the-board-failure
EXPECT_OUT | checks=14 pass=14 fail=0 skip=0 info=0 | and-every-check-passes

CASE | usage
RUN | $T/bc.+x
EXPECT_EXIT | 2 | no-arguments
RUN | $T/bc.+x | $T/nothere
EXPECT_EXIT | 2 | a-missing-folder
RUN | $T/bc.+x | $T/ok/h/@.apps/g/g-pchq | --bogus
EXPECT_EXIT | 2 | an-unknown-option
RUN | $T/bc.+x | $T/ok/h/@.apps/g/g-pchq
EXPECT_EXIT | 2 | no-house-found-above-a-scratch-folder-without-widgits
CLEAN |
