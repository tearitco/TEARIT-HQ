MKDIR | private_file/h/@.apps/g/g-pchq/pieces/system/maps/g/bridge
WRITE | private_file/h/@.apps/g/g-pchq/pieces/system/maps/g/bridge/map.txt | ....\n
MKDIR | private_file/h/@.apps/g/g-pchq/pieces/system/maps/g/quarters
WRITE | private_file/h/@.apps/g/g-pchq/pieces/system/maps/g/quarters/map.txt | ....\n
MKDIR | private_file/h/@.apps/g/g-pchq/pieces/system/maps/g/hold
WRITE | private_file/h/@.apps/g/g-pchq/pieces/system/maps/g/hold/map.txt | ....\n
WRITE | private_file/h/@.apps/g/g-pchq/pieces/hero_01/state.txt | pos_x=1\n
RUN | $T/bc.+x | $T/private_file/h/@.apps/g/g-pchq | --house | $T/private_file/h
EXPECT_EXIT | 0 | private_file-exit-0
EXPECT_OUT | INFO C1 private position file present: pieces/hero_01/state.txt | private-file-reported-as-info
EXPECT_OUT | checks=14 pass=14 fail=0 skip=0 info=1 | info-is-not-a-check
EXPECT_OUT | conformant=yes | still-conformant

