# book_check: LOCKED cases. Source: &.widgits/_shared-lib/ops/book_check.c compiled -Wall -Wextra -Werror from source into the scratch. Each case builds a tiny house (pal folders, a livedesk session with a page file, a pc-hq folder with its open_book_page.txt and a maps/<game> book) with ONE deliberate fault.
# Expected check lines and totals are worked out BY HAND from the rules in the op's header (14 checks: A1..A10 page file, B1..B4 map book; INFO lines are not checks). Bars are written \p in this file.
RESULTS | ../results/book_check.txt
SCRATCH |
CASE | build
RUN | gcc | -std=gnu11 | -Wall | -Wextra | -Werror | -O2 | -o | $T/bc.+x | $HOUSE/&.widgits/_shared-lib/ops/book_check.c
EXPECT_EXIT | 0 | compiles-clean-with-werror

CASE | ok
MKDIR | ok/h/pals/castle
MKDIR | ok/h/pals/asa
MKDIR | ok/h/@.apps/g/pieces/hero_01
MKDIR | ok/h/@.apps/g/pieces/xelector_01
MKDIR | ok/h/@.apps/g/pieces/display
MKDIR | ok/h/@.apps/g/g-pchq/pieces/display
MKDIR | ok/h/sessions/s1/desks
WRITE | ok/h/sessions/s1/desks/office.pdl | DESK \p castle \p pals/castle \p 80 \p 80 \p 1 \p 1 \p c \p 50\nDESK \p asa \p pals/asa \p 160 \p 0 \p 2 \p 0 \p a \p 39\nDESK \p hero_01 \p @.apps/g/pieces/hero_01 \p 160 \p 160 \p 2 \p 2 \p . \p 0\nDESK \p xelector_01 \p @.apps/g/pieces/xelector_01 \p 160 \p 160 \p 2 \p 2 \p hero_01 \p 20\nDESK \p camera_01 \p @.apps/g/pieces/display \p 80 \p 0 \p 1 \p 0 \p m=2,y=180,p=6,z=-3,h=0 \p 0\n
MKDIR | ok/h/sessions/s1
WRITE | ok/h/sessions/s1/session.pdl | STATE \p name \p b1\nSTATE \p active_desk \p office\n
WRITE | ok/h/@.apps/g/g-pchq/pieces/display/open_book_page.txt | source=desk\npdl=sessions/s1/desks/office.pdl\n
MKDIR | ok/h/@.apps/g/g-pchq/pieces/system/maps/g
WRITE | ok/h/@.apps/g/g-pchq/pieces/system/maps/g/game.pdl | GAME \p type \p board-game\nGAME \p n_desks \p 3\nGAME \p desk_1_id \p bridge\nGAME \p desk_2_id \p quarters\nGAME \p desk_3_id \p hold\n
MKDIR | ok/h/@.apps/g/g-pchq/pieces/system/maps/g/bridge
WRITE | ok/h/@.apps/g/g-pchq/pieces/system/maps/g/bridge/map.txt | ....\n
MKDIR | ok/h/@.apps/g/g-pchq/pieces/system/maps/g/quarters
WRITE | ok/h/@.apps/g/g-pchq/pieces/system/maps/g/quarters/map.txt | ....\n
MKDIR | ok/h/@.apps/g/g-pchq/pieces/system/maps/g/hold
WRITE | ok/h/@.apps/g/g-pchq/pieces/system/maps/g/hold/map.txt | ....\n
RUN | $T/bc.+x | $T/ok/h/@.apps/g/g-pchq | --house | $T/ok/h
EXPECT_EXIT | 0 | ok-exit-0
EXPECT_OUT | PASS A4 page_rows: 5 entity rows, all well formed | five-rows
EXPECT_OUT | PASS A7 camera_row: camera_01 carries mode=2 yaw=180 pitch=6 pan_z=-3 height=0 | packed-camera-read
EXPECT_OUT | PASS A10 session: book `b1`, open page `office` exists | session-resolved
EXPECT_OUT | PASS B2 desk_ids: n_desks=3 | three-desks
EXPECT_OUT | checks=14 pass=14 fail=0 skip=0 info=0 | fourteen-of-fourteen
EXPECT_OUT | conformant=yes | conformant

