CASE    | exporter-games
# a ledger game goes through ITS OWN exporter into the capped cache; the private warning shows; a tampered ledger is refused by the engine replay and the window says so instead of drawing
RUN | $M | act | toggle | c7fa8afb | $T/h/&.hq-apps/data-hq | $T/h
EXPECT_HAS | $T/h/&.hq-apps/data-hq/state/data_hq_ui.txt | label=[x] G/pets | the-pets-game-is-ticked
EXPECT_HAS | $T/h/&.hq-apps/data-hq/state/data_hq_ui.txt | show_dash=1 | its-exporter-tables-made-panels-and-a-chart
EXPECT_LACKS | $T/h/&.hq-apps/data-hq/state/data_hq_ui.txt | PRIVATE data selected | a-pets-only-game-is-public-no-private-warning
EXPECT_EXISTS | $T/h/&.hq-apps/data-hq/state/out/c7fa8afb/export/rounds.csv | the-export-landed-in-the-cache-not-in-the-game-folder
EXPECT_NOFILE | $T/h/games/pets/rounds.csv | NEGATIVE-nothing-was-written-into-the-game-folder
RUN | $M | act | toggle | baf9139e | $T/h/&.hq-apps/data-hq | $T/h
EXPECT_HAS | $T/h/&.hq-apps/data-hq/state/data_hq_ui.txt | PRIVATE data selected: it stays on this machine | the-human-game-brings-the-private-warning
RUN | $M | act | clear | $T/h/&.hq-apps/data-hq | $T/h
RUN | $M | act | toggle | 50e932fc | $T/h/&.hq-apps/data-hq | $T/h
EXPECT_HAS | $T/h/&.hq-apps/data-hq/state/data_hq_ui.txt | exporter failed | NEGATIVE-the-tampered-ledger-is-refused-by-the-engine-replay-and-shown
EXPECT_HAS | $T/h/&.hq-apps/data-hq/state/data_hq_ui.txt | show_dash= | and-nothing-is-drawn-from-it
EXPECT_HAS | $T/h/&.hq-apps/data-hq/state/data_hq_ui.txt | r_0_cls=ds-warn | the-reason-is-a-warning-row
RUN | $M | act | clear | $T/h/&.hq-apps/data-hq | $T/h

CASE    | read-only
# the studio only reads: the three game folders hash the same after every click above; a ledger edited on purpose changes the hash (so the check can fail)
SUMTREE | GAMES1 | h/games
EXPECT_EQ | $GAMES0 | $GAMES1 | the-game-folders-are-byte-identical-after-all-the-clicks
RUN | /bin/sh | -c | echo EXTRA >> "$0" | $T/h/games/human/ledger.txt
SUMTREE | GAMES2 | h/games
EXPECT_NE | $GAMES1 | $GAMES2 | NEGATIVE-an-edit-to-a-ledger-changes-the-hash-so-the-check-above-can-fail
RUN | /bin/sh | -c | sed -i '$d' "$0" | $T/h/games/human/ledger.txt
SUMTREE | GAMES3 | h/games
EXPECT_EQ | $GAMES1 | $GAMES3 | the-edit-was-undone

CASE    | cache-cap
# cache_dirs is 2: with 3 datasets used one after another (cleared in between) the OLDEST unselected folder goes, the selected one stays
RUN | $M | act | toggle | 2121ff21 | $T/h/&.hq-apps/data-hq | $T/h
RUN | $M | act | clear | $T/h/&.hq-apps/data-hq | $T/h
RUN | $M | act | toggle | 72532d83 | $T/h/&.hq-apps/data-hq | $T/h
RUN | $M | act | clear | $T/h/&.hq-apps/data-hq | $T/h
RUN | $M | act | toggle | e66899ab | $T/h/&.hq-apps/data-hq | $T/h
EXPECT_EXISTS | $T/h/&.hq-apps/data-hq/state/out/e66899ab/mark | the-selected-dataset-folder-stays
EXPECT_NOFILE | $T/h/&.hq-apps/data-hq/state/out/2121ff21/mark | the-oldest-unselected-folder-was-evicted
RUN | find | $T/h/&.hq-apps/data-hq/state/out | -mindepth | 1 | -maxdepth | 1 | -type | d
EXPECT_OUT_LACKS | 2121ff21 | NEGATIVE-the-evicted-one-is-not-listed
RUN | $M | act | clear | $T/h/&.hq-apps/data-hq | $T/h

CASE    | corrupt-registry
# a registry row the data layer refuses stops the listing (fail closed: nothing is listed as public by default) and the window says why
MKDIR   | pkg3
RUN | cp | $T/h/&.hq-apps/data-hq/studio.pdl | $T/pkg3/studio.pdl
WRITE   | pkg3/datasets.pdl | DATASET \p a \p b \p c \p maybe \p -\n
RUN | ln | -s | $SRC/ops | $T/pkg3/ops
RUN | $M | --once | $T/h | $T/pkg3
EXPECT_HAS | $T/pkg3/state/data_hq_ui.txt | n_ds=0 | NEGATIVE-nothing-is-listed-from-a-refused-registry
EXPECT_HAS | $T/pkg3/state/data_hq_ui.txt | SCAN REFUSED | the-status-says-the-scan-was-refused
EXPECT_HAS | $T/pkg3/state/data_hq_ui.txt | class of a must be public or private | with-the-reason
EXPECT_LACKS | $T/h/&.hq-apps/data-hq/state/data_hq_ui.txt | SCAN REFUSED | the-good-registry-shows-no-refusal

CASE    | daemon
# the module: builds the vars file, wakes on a new folder in a dataset root (no relaunch), costs nothing idle, exits with its owner. The owner here is a throwaway sh that starts it and waits.
SPAWN   | OWN | /bin/sh | -c | "$0" "$1" "$2" & echo $! > "$3"; wait | $M | $T/h | $T/h/&.hq-apps/data-hq | $T/dpid
SLEEP   | 1500
RUN | cat | $T/dpid
CAPTURE | D
EXPECT_ALIVE | $D | the-module-is-running-and-blocked-on-inotify
EXPECT_HAS | $T/h/&.hq-apps/data-hq/state/data_hq_ui.txt | n_ds=12 | it-built-the-vars-file-at-start
MKDIR   | h/games/newgame
RUN | cp | $HOUSE/&.widgits/_shared-lib/harness/fixtures/dsk_talk_ledger.txt | $T/h/games/newgame/ledger.txt
WAIT_HAS | h/&.hq-apps/data-hq/state/data_hq_ui.txt | label=[ ] G/newgame  68 rows  PRIVATE | 4000 | a-newly-archived-game-appears-in-the-sidebar-without-a-relaunch
EXPECT_HAS | $T/h/&.hq-apps/data-hq/state/data_hq_ui.txt | n_ds=13 | and-the-row-count-went-from-12-to-13
SLEEP   | 5000
# idle: nothing is happening now (the 0.7 s and 4 s rescans are over). 4 s of the module itself, with its children and wakeups counted (CPU pitfalls 26)
RUN | $PC | $D | 4 | 1000
EXPECT_OUT | children_max=0 | the-idle-module-has-no-children
EXPECT_OUT | wakeups_per_s=0. | the-idle-module-wakes-less-than-once-a-second
EXPECT_OUT | cpu_pct=0.0 | and-uses-no-cpu
# POSITIVE CONTROL: the same probe on the same process sees the wakeups and the work when a folder appears during the window (a null needs a probe that can see)
SPAWN   | WR | /bin/sh | -c | sleep 1; mkdir "$0"; cp "$1" "$0/ledger.txt" | $T/h/games/newgame2 | $HOUSE/&.widgits/_shared-lib/harness/fixtures/dsk_talk_ledger.txt
RUN | $PC | $D | 4 | 1000
EXPECT_OUT_LACKS | wakeups_per_s=0.0 | POSITIVE-CONTROL-the-probe-sees-the-wakeups-of-a-real-event
EXPECT_HAS | $T/h/&.hq-apps/data-hq/state/data_hq_ui.txt | G/newgame2 | and-the-second-new-game-is-listed-too
# the owner dies (SIGKILL: no chance to clean up): the module ends by itself
RUN | kill | -9 | $OWN
SLEEP   | 1500
EXPECT_DEAD | $D | the-module-exits-when-its-owner-is-gone
CLEAN   |
