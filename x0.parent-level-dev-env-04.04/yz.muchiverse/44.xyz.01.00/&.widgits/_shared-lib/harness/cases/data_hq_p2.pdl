# data_hq_p2: data-hq PHASE P2, the Data Studio window's BACKEND and wiring (BOOK 08-roadmap/design-docs/DATA-HQ-DATA-STUDIO-PLAN-2026-11-09.md sections 4 and 8; &.hq-apps/data-hq/ops/data_hq_manager.c, data-hq.xhtpm, studio.pdl).
# OFFLINE parts only: the manager runs against a SCRATCH house ($T/h) with the pets-only and human Teropoly games made by the engine (never the owner's archive), a tampered ledger, and the fixtures. The window itself is proved by the driven script
# &.hq-apps/data-hq/tests/data-hq-drive.pdl (relay_drive STEP format, run in a nested X server against a scratch house; PNGs and numbers in the plan section 14 and the compendium entry), not here.
# Every number below was OBSERVED in a scratch run on 2026-11-09 before it was written. A check that cannot fail is not a check: the families end in NEGATIVE rows and MUTANTS (a manager built without the private label; a ledger edited under the studio).
RESULTS | ../results/data_hq_p2.txt
ENV | LC_ALL | C
RUN | echo | $HOUSE/&.hq-apps/data-hq/ops/+x/data_hq_manager.+x
CAPTURE | M
RUN | echo | $HOUSE/&.hq-apps/data-hq/ops/+x/data_op.+x
CAPTURE | DOP
RUN | echo | $HOUSE/&.hq-apps/data-hq/ops/+x/chart_op.+x
CAPTURE | C
RUN | echo | $HOUSE/@.apps/deskopoly/ops/+x/deskopoly.+x
CAPTURE | ENG
RUN | echo | $HOUSE/&.widgits/_shared-lib/harness/ops/+x/proc_cost_op.+x
CAPTURE | PC
RUN | echo | $HOUSE/&.hq-apps/data-hq
CAPTURE | SRC

CASE    | wiring
# the window is the generic renderer's tags and the vars file: a canvas fed by ${canvas_raw}, shown only in dashboard mode, the module, the honest notice; zero renderer C (the shared renderer is not in this commit)
EXPECT_HAS | $SRC/data-hq.xhtpm | <canvas id="screen" class="ds-canvas" sprite="${canvas_raw}" show="${show_dash}"/> | the-canvas-is-the-generic-picture-route
EXPECT_HAS | $SRC/data-hq.xhtpm | <module src="&.hq-apps/data-hq/ops/+x/data_hq_manager.+x"/> | one-module-the-manager
EXPECT_HAS | $SRC/data-hq.xhtpm | vars="state/data_hq_ui.txt" | the-vars-file
EXPECT_HAS | $SRC/data-hq.xhtpm | label="${notice}" | the-first-screen-notice-is-a-row-of-the-window
EXPECT_HAS | $SRC/data-hq.xhtpm | act mode table | the-table-mode-button-runs-the-act-verb
EXPECT_LACKS | $SRC/data-hq.xhtpm | .sh' | NEGATIVE-no-click-runs-a-shell-script
EXPECT_HAS | $SRC/open_data_hq.sh | kh_spawn.sh | the-launcher-starts-the-window-through-the-registry-funnel
EXPECT_LACKS | $SRC/open_data_hq.sh | setsid nohup | NEGATIVE-no-bare-setsid-nohup-spawn-site
EXPECT_HAS | $SRC/toy.pdl | open_data_hq.sh | the-toys-menu-row
EXPECT_HAS | $SRC/toy.pdl | Data Studio | titled-Data-Studio
EXPECT_HAS | $HOUSE/#.desktop/livedesk_taskbar.pdl | db_menu_4_cmd         \p livedesk:open-data-hq | the-db-menu-row-4-is-data-hq
EXPECT_HAS | $HOUSE/#.desktop/livedesk_taskbar.pdl | db_menu_5_label       \p Cancel | and-Cancel-moved-to-5
EXPECT_HAS | $HOUSE/_.monads/_.livedesk-taskbar/ops/khtpm_taskbar_manager.c | strcmp(m->command, "livedesk:open-data-hq") == 0 | the-taskbar-has-the-launch-branch
EXPECT_HAS | $SRC/.gitignore | state/ | the-runtime-state-is-not-tracked
RUN | grep | -c | data_hq_manager | $HOUSE/&.widgits/_shared-lib/harness/ops/build_harness_ops.sh
EXPECT_OUT_IS | 2 | the-manager-is-built-by-the-harness-build-list-one-line-and-its-comment

CASE    | setup
SCRATCH |
MKDIR   | h/&.hq-apps/data-hq
MKDIR   | h/#.desktop
COPYDIR | @.apps/deskopoly | h/@.apps/deskopoly | state,deskopoly-pchq
COPYDIR | &.hq-apps/data-hq/fixtures | h/&.hq-apps/data-hq/fixtures
RUN | ln | -s | $SRC/ops | $T/h/&.hq-apps/data-hq/ops
WRITE   | h/&.hq-apps/data-hq/datasets.pdl | DATASET \p fixtures \p &.hq-apps/data-hq/fixtures \p fixture \p public \p - \p fixtures made by hand\n
WRITE   | h/&.hq-apps/data-hq/studio.pdl | GROUP \p games \p GAMES\nGROUP \p fixtures \p FIXTURES\nROOT \p games \p games \p @.apps/deskopoly \p G\nROOT \p fixtures \p &.hq-apps/data-hq/fixtures \p - \p fx\nSET \p canvas_w \p 600\nSET \p canvas_h \p 360\nSET \p table_rows \p 6\nSET \p table_cols \p 3\nSET \p max_selected \p 2\nSET \p cache_dirs \p 2\n
# a pets-only game (public by its own ledger), a human game (private), a tampered copy of the pets game (the exporter must refuse it)
MKDIR   | games/pets
MKDIR   | games/human
MKDIR   | games/bad
RUN | $ENG | $T/h/@.apps/deskopoly | $T/games/pets | lobby | classic
RUN | $ENG | $T/h/@.apps/deskopoly | $T/games/pets | join | A | pet
RUN | $ENG | $T/h/@.apps/deskopoly | $T/games/pets | join | B | pet
RUN | $ENG | $T/h/@.apps/deskopoly | $T/games/pets | start | 5
RUN | $ENG | $T/h/@.apps/deskopoly | $T/games/pets | autoplay
EXPECT_OUT | AUTOPLAY events= | the-pets-game-was-played-through
RUN | cp | $T/games/pets/ledger.txt | $T/games/bad/ledger.txt
RUN | cp | $HOUSE/&.widgits/_shared-lib/harness/fixtures/dsk_talk_ledger.txt | $T/games/human/ledger.txt
RUN | sed | -i | s/rent-\([0-9]*\)/rent-9\1/ | $T/games/bad/ledger.txt
RUN | cmp | -s | $T/games/pets/ledger.txt | $T/games/bad/ledger.txt
EXPECT_EXIT | 1 | the-tamper-really-changed-the-bad-ledger
RUN | mv | $T/games | $T/h/games
SUMTREE | GAMES0 | h/games
RUN | $M | --once | $T/h | $T/h/&.hq-apps/data-hq
EXPECT_EXIT | 0 | the-manager-builds-the-window-vars-once
EXPECT_EXISTS | $T/h/&.hq-apps/data-hq/state/data_hq_ui.txt | the-vars-file-exists
EXPECT_EXISTS | $T/h/&.hq-apps/data-hq/state/scan.txt | the-scan-is-saved-so-a-click-does-not-walk-the-disk

CASE    | sidebar
# the sidebar: 2 group headers + 3 games + 7 fixtures = 12 rows; every row labelled with its class
EXPECT_HAS | $T/h/&.hq-apps/data-hq/state/data_hq_ui.txt | n_ds=12 | 2-headers-3-games-7-fixtures
EXPECT_HAS | $T/h/&.hq-apps/data-hq/state/data_hq_ui.txt | label=GAMES  (3) | the-games-header-counts-3
EXPECT_HAS | $T/h/&.hq-apps/data-hq/state/data_hq_ui.txt | label=FIXTURES  (7) | the-fixtures-header-counts-7
EXPECT_HAS | $T/h/&.hq-apps/data-hq/state/data_hq_ui.txt | label=[ ] G/human  68 rows  PRIVATE | a-human-game-is-labelled-PRIVATE
EXPECT_HAS | $T/h/&.hq-apps/data-hq/state/data_hq_ui.txt | label=[ ] G/pets  | the-pets-game-row-exists
EXPECT_HAS | $T/h/&.hq-apps/data-hq/state/data_hq_ui.txt | label=[ ] fx/weather.tsv  4 rows  public | a-fixture-is-public-by-the-registry
RUN | grep | -c | ^d_[0-9]*_label=.*PRIVATE | $T/h/&.hq-apps/data-hq/state/data_hq_ui.txt
EXPECT_OUT_IS | 1 | exactly-one-row-is-PRIVATE-the-human-game-the-pets-games-are-public-by-their-ledgers
EXPECT_HAS | $T/h/&.hq-apps/data-hq/state/data_hq_ui.txt | d_1_cls=ds-pub | a-public-row-has-the-public-colour-class
EXPECT_HAS | $T/h/&.hq-apps/data-hq/state/data_hq_ui.txt | notice=SQL + declarative cells + C stats; no Python/R/JS cells; notebooks come later. | the-first-screen-honesty-notice
EXPECT_HAS | $T/h/&.hq-apps/data-hq/state/data_hq_ui.txt | status=no dataset selected  \p  0 selected | nothing-selected-at-start
EXPECT_HAS | $T/h/&.hq-apps/data-hq/state/data_hq_ui.txt | show_text=1 | the-text-area-shows-the-hint-until-something-is-selected
EXPECT_HAS | $T/h/&.hq-apps/data-hq/state/data_hq_ui.txt | show_dash= | and-the-canvas-is-hidden
# MUTANT: a manager built WITHOUT the private label (the label code says public for everything) must lose the PRIVATE row
MKDIR   | m
RUN | cp | $SRC/ops/data_hq_manager.c | $T/m/mut.c
RUN | sed | -i | s/pub ? "public" : "PRIVATE"/"public"/ | $T/m/mut.c
RUN | cmp | -s | $SRC/ops/data_hq_manager.c | $T/m/mut.c
EXPECT_EXIT | 1 | mutant-the-label-edit-really-landed
RUN | gcc | -std=gnu11 | -w | -O1 | -o | $T/m/mut.+x | $T/m/mut.c
EXPECT_EXIT | 0 | the-mutant-compiles
MKDIR   | pkg2
RUN | cp | $T/h/&.hq-apps/data-hq/studio.pdl | $T/h/&.hq-apps/data-hq/datasets.pdl | $T/pkg2
RUN | ln | -s | $SRC/ops | $T/pkg2/ops
RUN | $T/m/mut.+x | --once | $T/h | $T/pkg2
RUN | grep | -c | ^d_[0-9]*_label=.*PRIVATE | $T/pkg2/state/data_hq_ui.txt
EXPECT_OUT_IS | 0 | NEGATIVE-the-mutant-without-the-private-label-shows-no-PRIVATE-row-so-the-check-above-can-fail

CASE    | select-and-chart
# toggling a PUBLIC fixture with a line-per-group panel: the canvas shows exactly what chart_op makes at the canvas size, and only when something changed
RUN | grep | -o | d_[0-9]*_act=toggle [0-9a-f]* | $T/h/&.hq-apps/data-hq/state/data_hq_ui.txt
EXPECT_OUT | toggle | the-toggle-actions-carry-a-stable-key
RUN | $M | act | toggle | 2121ff21 | $T/h/&.hq-apps/data-hq | $T/h
EXPECT_EXIT | 0 | the-click-process-exits-0
EXPECT_HAS | $T/h/&.hq-apps/data-hq/state/data_hq_ui.txt | label=[x] fx/weather.tsv  4 rows  public | the-row-shows-the-tick
EXPECT_HAS | $T/h/&.hq-apps/data-hq/state/data_hq_ui.txt | status=panel 1/3  temp_c by date per city  (fx/weather.tsv)  \p  1 selected | panel-1-of-3-the-grouped-line-comes-first
EXPECT_HAS | $T/h/&.hq-apps/data-hq/state/data_hq_ui.txt | show_dash=1 | the-canvas-is-shown
EXPECT_HAS | $T/h/&.hq-apps/data-hq/state/data_hq_ui.txt | show_text= | and-the-text-area-hidden
EXPECT_LACKS | $T/h/&.hq-apps/data-hq/state/data_hq_ui.txt | PRIVATE data selected | a-public-selection-carries-no-private-warning
RUN | stat | -c | %s | $T/h/&.hq-apps/data-hq/state/out/view.raw
EXPECT_OUT_IS | 864000 | the-raw-is-600x360x4-bytes-the-canvas-box-size-from-studio.pdl
EXPECT_HAS | $T/h/&.hq-apps/data-hq/state/out/view.receipt.txt | frame_w=600 | the-receipt-says-600-wide
EXPECT_HAS | $T/h/&.hq-apps/data-hq/state/out/view.receipt.txt | frame_h=360 | and-360-high
RUN | $C | $T/h/&.hq-apps/data-hq/state/out/2121ff21/dash/dash.pdl | $T/h/&.hq-apps/data-hq/fixtures/weather.tsv | $T/direct.raw | --id | weather_line_temp_c | --size | 600x360
EXPECT_EXIT | 0 | chart_op-makes-the-same-panel-itself
RUN | cmp | $T/direct.raw | $T/h/&.hq-apps/data-hq/state/out/view.raw
EXPECT_EXIT | 0 | the-window-picture-is-byte-identical-to-chart_op-at-that-size
RUN | od | -An | -tx1 | -N | 4 | $T/h/&.hq-apps/data-hq/state/out/view.raw
EXPECT_OUT | ff ff ff ff | the-top-left-pixel-is-the-white-ground
# the same chart again: nothing is redrawn (inode and mtime of view.raw do not move) for a noop, a mode round trip and a refresh that found nothing new
RUN | stat | -c | %i-%y | $T/h/&.hq-apps/data-hq/state/out/view.raw
CAPTURE | ID0
RUN | $M | act | noop | $T/h/&.hq-apps/data-hq | $T/h
RUN | $M | act | mode | table | $T/h/&.hq-apps/data-hq | $T/h
RUN | $M | act | mode | dashboard | $T/h/&.hq-apps/data-hq | $T/h
RUN | $M | act | refresh | $T/h/&.hq-apps/data-hq | $T/h
RUN | stat | -c | %i-%y | $T/h/&.hq-apps/data-hq/state/out/view.raw
CAPTURE | ID1
EXPECT_EQ | $ID0 | $ID1 | a-noop-a-mode-round-trip-and-a-refresh-do-not-remake-the-picture
# next: a different panel, a different picture, and it wraps
RUN | cp | $T/h/&.hq-apps/data-hq/state/out/view.raw | $T/p1.raw
RUN | $M | act | next | $T/h/&.hq-apps/data-hq | $T/h
EXPECT_HAS | $T/h/&.hq-apps/data-hq/state/data_hq_ui.txt | status=panel 2/3  rain_mm by date per city | next-is-panel-2
RUN | cmp | -s | $T/p1.raw | $T/h/&.hq-apps/data-hq/state/out/view.raw
EXPECT_EXIT | 1 | the-second-panel-is-a-different-picture
RUN | $M | act | next | $T/h/&.hq-apps/data-hq | $T/h
RUN | $M | act | next | $T/h/&.hq-apps/data-hq | $T/h
RUN | $M | act | next | $T/h/&.hq-apps/data-hq | $T/h
EXPECT_HAS | $T/h/&.hq-apps/data-hq/state/data_hq_ui.txt | status=panel 2/3 | three-nexts-from-3-wrap-to-1-then-2
RUN | $M | act | prev | $T/h/&.hq-apps/data-hq | $T/h
RUN | $M | act | prev | $T/h/&.hq-apps/data-hq | $T/h
EXPECT_HAS | $T/h/&.hq-apps/data-hq/state/data_hq_ui.txt | status=panel 3/3 | prev-wraps-from-1-to-3

CASE    | table
RUN | $M | act | toggle | 2121ff21 | $T/h/&.hq-apps/data-hq | $T/h
RUN | $M | act | toggle | 72532d83 | $T/h/&.hq-apps/data-hq | $T/h
EXPECT_HAS | $T/h/&.hq-apps/data-hq/state/data_hq_ui.txt | 1 selected | snake-selected-alone
RUN | $M | act | mode | table | $T/h/&.hq-apps/data-hq | $T/h
EXPECT_HAS | $T/h/&.hq-apps/data-hq/state/data_hq_ui.txt | title=table 1/1: snake_runs.csv of fx/snake_runs.csv   rows 1-6 of 10   columns 1-3 of 3 | the-title-says-which-table-rows-and-columns
EXPECT_HAS | $T/h/&.hq-apps/data-hq/state/data_hq_ui.txt | n_rows=7 | a-header-row-and-6-data-rows
EXPECT_HAS | $T/h/&.hq-apps/data-hq/state/data_hq_ui.txt | r_0_text=row    \p tick \p direction \p score | the-header-row-is-the-fixture-header
EXPECT_HAS | $T/h/&.hq-apps/data-hq/state/data_hq_ui.txt | r_1_text=1      \p 0    \p U         \p 0 | row-1-is-the-first-fixture-row-tick-0-U-0
EXPECT_HAS | $T/h/&.hq-apps/data-hq/state/data_hq_ui.txt | r_0_cls=ds-th | the-header-has-its-own-class
EXPECT_HAS | $T/h/&.hq-apps/data-hq/state/data_hq_ui.txt | show_text=1 | the-canvas-gives-way-to-the-text-rows
# the table says what the file says: row 6 of the page equals the sixth data row of the fixture (read with data_op show, a different reader path)
RUN | $DOP | show | $T/h/&.hq-apps/data-hq/fixtures/snake_runs.csv | --head | 6
EXPECT_OUT | 0 \p U \p 0 | the-reader-sees-the-same-first-row
RUN | $M | act | pgdn | $T/h/&.hq-apps/data-hq | $T/h
EXPECT_HAS | $T/h/&.hq-apps/data-hq/state/data_hq_ui.txt | rows 7-10 of 10 | the-second-page-is-rows-7-to-10
EXPECT_HAS | $T/h/&.hq-apps/data-hq/state/data_hq_ui.txt | n_rows=5 | 4-data-rows-and-the-header
RUN | $M | act | pgdn | $T/h/&.hq-apps/data-hq | $T/h
EXPECT_HAS | $T/h/&.hq-apps/data-hq/state/data_hq_ui.txt | rows 7-10 of 10 | NEGATIVE-paging-past-the-end-stays-on-the-last-page
RUN | $M | act | pgup | $T/h/&.hq-apps/data-hq | $T/h
RUN | $M | act | pgup | $T/h/&.hq-apps/data-hq | $T/h
EXPECT_HAS | $T/h/&.hq-apps/data-hq/state/data_hq_ui.txt | rows 1-6 of 10 | NEGATIVE-paging-before-the-start-stays-on-the-first-page
RUN | $M | act | colr | $T/h/&.hq-apps/data-hq | $T/h
RUN | $M | act | colr | $T/h/&.hq-apps/data-hq | $T/h
EXPECT_HAS | $T/h/&.hq-apps/data-hq/state/data_hq_ui.txt | columns 1-3 of 3 | NEGATIVE-3-columns-fit-in-one-column-page-so-cols-right-does-nothing

CASE    | selection-rules
# max_selected is 2 in this studio.pdl
RUN | $M | act | mode | dashboard | $T/h/&.hq-apps/data-hq | $T/h
RUN | $M | act | toggle | 16df8767 | $T/h/&.hq-apps/data-hq | $T/h
EXPECT_HAS | $T/h/&.hq-apps/data-hq/state/data_hq_ui.txt | 2 selected | two-selected
RUN | $M | act | toggle | edbb336b | $T/h/&.hq-apps/data-hq | $T/h
EXPECT_HAS | $T/h/&.hq-apps/data-hq/state/data_hq_ui.txt | at most 2 datasets at a time | a-third-is-refused-with-the-reason
EXPECT_HAS | $T/h/&.hq-apps/data-hq/state/data_hq_ui.txt | label=[ ] fx/scores.pdl | and-the-refused-row-is-not-ticked
RUN | $M | act | toggle | 00000000 | $T/h/&.hq-apps/data-hq | $T/h
EXPECT_HAS | $T/h/&.hq-apps/data-hq/state/data_hq_ui.txt | that dataset is gone: press Refresh | NEGATIVE-an-unknown-key-is-refused
