# rta_pages (2026-11-22, D103; recipe: standard BOOK 02-architecture/STANDARD-RULES-AS-OPS-FOUNDATION-DESIGN-2026-11-18.md section 12): the living-entity rules of Robot Trap Auto
# (rta_life_op) are on event pages: registry COMMAND rows rta_enter/rta_exit/rta_eat/rta_drive, four pages under @.apps/rta/events (seeded by bp_edit_op), the RULE rows in @.apps/rta/rules.pdl.
# Nothing here touches the live ledger: a scratch house under $T holds copies of the pages and freshly built ops; the wrappers resolve $D to that house (they walk up to the folder holding xyzfs).
RESULTS | ../results/rta_pages.txt
ENV | LC_ALL | C

CASE    | setup
SCRATCH |
MKDIR | h/xyzfs
MKDIR | h/#.desktop
MKDIR | h/@.apps/rta/ops/+x
COPYDIR | @.apps/rta/events | h/@.apps/rta/events
COPY | @.apps/rta/rules.pdl | h/@.apps/rta/rules.pdl
COPY | @.apps/rta/road.grid | h/@.apps/rta/road.grid
RUN | gcc | -std=gnu11 | -Wall | -Wextra | -O2 | -o | $T/h/@.apps/rta/ops/+x/rta_life_op.+x | $HOUSE/@.apps/rta/ops/rta_life_op.c
EXPECT_EXIT | 0 | life-op-compiles-into-the-scratch-house
RUN | gcc | -std=gnu11 | -Wall | -Wextra | -O2 | -o | $T/h/@.apps/rta/ops/+x/rta_momentum_op.+x | $HOUSE/@.apps/rta/ops/rta_momentum_op.c
EXPECT_EXIT | 0 | momentum-op-compiles-into-the-scratch-house
# a second ledger set for "the op alone" (same four PART rows as the page house)
MKDIR | alone
WRITE | sabotaged_registry.pdl | COMMAND rta_enter\n  PARAMS entity,car\nEND\n
WRITE | norules.pdl | RULE \p hunger_start \p 80\n
RUN | $T/h/@.apps/rta/ops/+x/rta_life_op.+x | part | $HOUSE/@.apps/rta/rules.pdl | $T/h/#.desktop/rta_life_ledger.txt | car | engine | gas | ok | 0
RUN | $T/h/@.apps/rta/ops/+x/rta_life_op.+x | part | $HOUSE/@.apps/rta/rules.pdl | $T/h/#.desktop/rta_life_ledger.txt | car | tank | gas | ok | 3
RUN | $T/h/@.apps/rta/ops/+x/rta_life_op.+x | part | $HOUSE/@.apps/rta/rules.pdl | $T/h/#.desktop/rta_life_ledger.txt | car | tires | gas | ok | 0
RUN | $T/h/@.apps/rta/ops/+x/rta_life_op.+x | part | $HOUSE/@.apps/rta/rules.pdl | $T/h/#.desktop/rta_life_ledger.txt | car | steering | gas | ok | 0
RUN | $T/h/@.apps/rta/ops/+x/rta_life_op.+x | part | $HOUSE/@.apps/rta/rules.pdl | $T/alone/l.txt | car | engine | gas | ok | 0
RUN | $T/h/@.apps/rta/ops/+x/rta_life_op.+x | part | $HOUSE/@.apps/rta/rules.pdl | $T/alone/l.txt | car | tank | gas | ok | 3
RUN | $T/h/@.apps/rta/ops/+x/rta_life_op.+x | part | $HOUSE/@.apps/rta/rules.pdl | $T/alone/l.txt | car | tires | gas | ok | 0
RUN | $T/h/@.apps/rta/ops/+x/rta_life_op.+x | part | $HOUSE/@.apps/rta/rules.pdl | $T/alone/l.txt | car | steering | gas | ok | 0

CASE    | registry
# one COMMAND row per verb in the house registry; a sabotaged copy that lacks a row gives 0 (the grep is able to fail)
RUN | grep | -c | ^COMMAND rta_enter$ | $HOUSE/#.ref/menu/event_commands.registry.pdl
EXPECT_OUT_IS | 1 | exactly-one-COMMAND-rta_enter-row
RUN | grep | -c | ^COMMAND rta_exit$ | $HOUSE/#.ref/menu/event_commands.registry.pdl
EXPECT_OUT_IS | 1 | exactly-one-COMMAND-rta_exit-row
RUN | grep | -c | ^COMMAND rta_eat$ | $HOUSE/#.ref/menu/event_commands.registry.pdl
EXPECT_OUT_IS | 1 | exactly-one-COMMAND-rta_eat-row
RUN | grep | -c | ^COMMAND rta_drive$ | $HOUSE/#.ref/menu/event_commands.registry.pdl
EXPECT_OUT_IS | 1 | exactly-one-COMMAND-rta_drive-row
RUN | grep | -c | ^COMMAND rta_eat$ | $T/sabotaged_registry.pdl
EXPECT_OUT_IS | 0 | NEGATIVE-a-registry-copy-without-the-row-gives-0
RUN | grep | -c | -F | rta_life_op.+x" drive "$D/@.apps/rta/rules.pdl" | $HOUSE/#.ref/menu/event_commands.registry.pdl
EXPECT_OUT_IS | 1 | the-drive-template-runs-the-life-op-with-the-RULE-file
RUN | grep | -c | -F | rta_life_op.+x" eat "$D/@.apps/rta/rules.pdl" "$D/#.desktop/rta_life_ledger.txt" '{entity}' | $HOUSE/#.ref/menu/event_commands.registry.pdl
EXPECT_OUT_IS | 1 | the-eat-template-writes-the-runtime-ledger-under-#.desktop
RUN | grep | -c | -F | rta_life_op.+x" enter "$D/@.apps/rta/rules.pdl" "$D/#.desktop/rta_life_ledger.txt" '{entity}' '{car}' | $HOUSE/#.ref/menu/event_commands.registry.pdl
EXPECT_OUT_IS | 1 | the-enter-template-is-exactly-op-rules-ledger-entity-car
RUN | grep | -c | -F | rta_life_op.+x" exit "$D/@.apps/rta/rules.pdl" "$D/#.desktop/rta_life_ledger.txt" '{entity}' '{car}' | $HOUSE/#.ref/menu/event_commands.registry.pdl
EXPECT_OUT_IS | 1 | the-exit-template-is-exactly-op-rules-ledger-entity-car
RUN | grep | -c | -F | '{entity}' '{car}' "$D/@.apps/rta/ops/+x/rta_momentum_op.+x" "$D/@.apps/rta/road.grid" "$D/#.desktop/rta_mom_ledger.txt" "$D/#.desktop/rta_mom_events.txt" | $HOUSE/#.ref/menu/event_commands.registry.pdl
EXPECT_OUT_IS | 1 | the-drive-template-passes-entity-car-momentum-op-grid-and-the-two-runtime-files

RUN | grep | -c | ^COMMAND rta_sleep$ | $HOUSE/#.ref/menu/event_commands.registry.pdl
EXPECT_OUT_IS | 1 | exactly-one-COMMAND-rta_sleep-row
RUN | grep | -c | ^COMMAND rta_part$ | $HOUSE/#.ref/menu/event_commands.registry.pdl
EXPECT_OUT_IS | 1 | exactly-one-COMMAND-rta_part-row
RUN | grep | -c | ^COMMAND rta_sleep$ | $T/sabotaged_registry.pdl
EXPECT_OUT_IS | 0 | NEGATIVE-a-registry-copy-without-the-sleep-row-gives-0
RUN | grep | -c | -F | rta_life_op.+x" sleep "$D/@.apps/rta/rules.pdl" "$D/#.desktop/rta_life_ledger.txt" '{entity}' '{turns}' | $HOUSE/#.ref/menu/event_commands.registry.pdl
EXPECT_OUT_IS | 1 | the-sleep-template-is-exactly-op-rules-ledger-entity-turns
RUN | grep | -c | -F | rta_life_op.+x" part "$D/@.apps/rta/rules.pdl" "$D/#.desktop/rta_life_ledger.txt" '{car}' '{slot}' '{kind}' '{state}' | $HOUSE/#.ref/menu/event_commands.registry.pdl
EXPECT_OUT_IS | 1 | the-part-template-is-exactly-op-rules-ledger-car-slot-kind-state
RUN | grep | -c | -F | PARAMS entity,turns | $HOUSE/#.ref/menu/event_commands.registry.pdl
EXPECT_OUT_IS | 1 | the-sleep-block-declares-its-two-parameters
RUN | grep | -c | -F | PARAMS car,slot,kind,state | $HOUSE/#.ref/menu/event_commands.registry.pdl
EXPECT_OUT_IS | 1 | the-part-block-declares-four-parameters-(the-registry-limit)-with-n-folded-into-state

CASE    | data-and-ignore
# the numbers are RULE rows in a file; the runtime ledgers are git-ignored (never committed), a neighbour file is not
EXPECT_HAS | h/@.apps/rta/rules.pdl | RULE \p hunger_start \p 80 | the-rules-file-has-hunger_start-80
EXPECT_HAS | h/@.apps/rta/rules.pdl | RULE \p eat_amount \p 30 | eat_amount-30
EXPECT_HAS | h/@.apps/rta/rules.pdl | RULE \p fuel_per_cell \p 1 | fuel_per_cell-1
EXPECT_HAS | h/@.apps/rta/rules.pdl | RULE \p drive_speed \p 1 | drive_speed-1
EXPECT_HAS | h/@.apps/rta/rules.pdl | RULE \p sleep_max_turns \p 8 | sleep_max_turns-8
EXPECT_HAS | h/@.apps/rta/rules.pdl | RULE \p hunger_per_turn \p 2 | hunger_per_turn-2
EXPECT_HAS | h/@.apps/rta/rules.pdl | RULE \p hunger_max \p 100 | hunger_max-100
RUN | git | -C | $HOUSE | check-ignore | -q | #.desktop/rta_life_ledger.txt
EXPECT_EXIT | 0 | the-life-ledger-is-git-ignored
RUN | git | -C | $HOUSE | check-ignore | -q | #.desktop/rta_mom_ledger.txt
EXPECT_EXIT | 0 | the-road-ledger-is-git-ignored
RUN | git | -C | $HOUSE | check-ignore | -q | #.desktop/rta_mom_events.txt
EXPECT_EXIT | 0 | the-road-events-file-is-git-ignored
RUN | git | -C | $HOUSE | check-ignore | -q | #.desktop/rta_not_ignored.txt
EXPECT_EXIT | 1 | NEGATIVE-a-neighbour-name-is-not-ignored-(the-check-can-fail)
RUN | $T/h/@.apps/rta/ops/+x/rta_life_op.+x | eat | $T/norules.pdl | $T/alone/n.txt | joe
EXPECT_EXIT | 9 | NEGATIVE-a-rules-file-without-eat_amount-refuses-(no-number-in-C)

CASE    | pages
# each page: the command type, its parameters, the trigger (seeded by the real events-hq manager through bp_edit_op)
EXPECT_HAS | h/@.apps/rta/events/rta_enter/event_pkg/pages/page_1/event.ir.pdl | type=rta_enter \p entity=joe | the-enter-page-command-is-the-registered-type
EXPECT_HAS | h/@.apps/rta/events/rta_exit/event_pkg/pages/page_1/event.ir.pdl | type=rta_exit \p entity=joe | the-exit-page-command-is-the-registered-type
EXPECT_HAS | h/@.apps/rta/events/rta_eat/event_pkg/pages/page_1/event.ir.pdl | type=rta_eat \p entity=joe | the-eat-page-command-is-the-registered-type
EXPECT_HAS | h/@.apps/rta/events/rta_drive/event_pkg/pages/page_1/event.ir.pdl | type=rta_drive \p entity=joe | the-drive-page-command-is-the-registered-type
EXPECT_HAS | h/@.apps/rta/events/rta_enter/event_pkg/pages/page_1/condition.pdl | COND \p trigger \p ui | the-enter-page-has-a-ui-trigger
EXPECT_HAS | h/@.apps/rta/events/rta_exit/event_pkg/pages/page_1/condition.pdl | COND \p trigger \p ui | the-exit-page-has-a-ui-trigger
EXPECT_HAS | h/@.apps/rta/events/rta_eat/event_pkg/pages/page_1/condition.pdl | COND \p trigger \p ui | the-eat-page-has-a-ui-trigger
EXPECT_HAS | h/@.apps/rta/events/rta_drive/event_pkg/pages/page_1/condition.pdl | COND \p trigger \p ui | the-drive-page-has-a-ui-trigger
EXPECT_LACKS | h/@.apps/rta/events/rta_eat/event_pkg/pages/page_1/event.ir.pdl | type=rta_drive | NEGATIVE-the-eat-page-is-not-the-drive-command
EXPECT_HAS | h/@.apps/rta/events/rta_sleep/event_pkg/pages/page_1/event.ir.pdl | type=rta_sleep \p entity=joe\pturns=3 | the-sleep-page-command-is-the-registered-type-with-entity-and-turns
EXPECT_HAS | h/@.apps/rta/events/rta_part/event_pkg/pages/page_1/event.ir.pdl | type=rta_part \p car=car\pslot=tank\pkind=gas\pstate=ok:3 | the-part-page-command-is-the-registered-type-with-four-parameters
EXPECT_HAS | h/@.apps/rta/events/rta_sleep/event_pkg/pages/page_1/condition.pdl | COND \p trigger \p ui | the-sleep-page-has-a-ui-trigger
EXPECT_HAS | h/@.apps/rta/events/rta_part/event_pkg/pages/page_1/condition.pdl | COND \p trigger \p ui | the-part-page-has-a-ui-trigger
EXPECT_LACKS | h/@.apps/rta/events/rta_sleep/event_pkg/pages/page_1/event.ir.pdl | type=rta_part | NEGATIVE-the-sleep-page-is-not-the-part-command
RUN | grep | -c | -F | rta_enter | $HOUSE/&.hq-apps/blueprintz/books.pdl
EXPECT_OUT_IS | 0 | no-event-name-leaks-into-books.pdl
RUN | grep | -c | -F | BOOK \p rta \p events \p @.apps/rta/events | $HOUSE/&.hq-apps/blueprintz/books.pdl
EXPECT_OUT_IS | 1 | blueprintz-lists-the-rta-book

CASE    | wrapper-equals-op
# the compiled wrappers (cmd_1.sh) run the op on the scratch house; the same verbs by the op alone on other scratch paths print the same lines
RUN | $T/h/@.apps/rta/ops/+x/rta_life_op.+x | drive | $T/h/@.apps/rta/rules.pdl | $T/h/#.desktop/rta_life_ledger.txt | joe | car | $T/h/@.apps/rta/ops/+x/rta_momentum_op.+x | $T/h/@.apps/rta/road.grid | $T/h/#.desktop/rta_mom_ledger.txt | $T/h/#.desktop/rta_mom_events.txt
EXPECT_EXIT | 10 | NEGATIVE-drive-before-entering-refuses-10-(op-alone)
RUN | sh | $T/h/@.apps/rta/events/rta_drive/event_pkg/pages/page_1/cmd_1.sh
EXPECT_EXIT | 10 | the-drive-page-propagates-10-outside-the-car
EXPECT_NOFILE | h/#.desktop/rta_mom_ledger.txt | the-refusal-never-ran-the-road-step
EXPECT_LACKS | h/#.desktop/rta_life_ledger.txt | DRIVE | the-refusal-wrote-no-DRIVE-row
RUN | sh | $T/h/@.apps/rta/events/rta_enter/event_pkg/pages/page_1/cmd_1.sh
EXPECT_EXIT | 0 | the-enter-page-runs
EXPECT_HAS | h/#.desktop/rta_life_ledger.txt | ENTER \p joe \p car | the-enter-page-wrote-the-ENTER-row-in-the-scratch-ledger
RUN | sh | $T/h/@.apps/rta/events/rta_enter/event_pkg/pages/page_1/cmd_1.sh
EXPECT_EXIT | 12 | the-enter-page-propagates-12-when-already-in
RUN | $T/h/@.apps/rta/ops/+x/rta_life_op.+x | enter | $T/h/@.apps/rta/rules.pdl | $T/alone/l.txt | joe | car
EXPECT_EXIT | 0 | op-alone-enter
RUN | sh | $T/h/@.apps/rta/events/rta_drive/event_pkg/pages/page_1/cmd_1.sh
EXPECT_EXIT | 0 | the-drive-page-drives-one-road-cell
CAPTURE | page_drive
EXPECT_EQ | $page_drive | x=1 y=0 fuel=2 | HAND-COMPUTED-one-cell-east-and-one-fuel-of-three-used
RUN | $T/h/@.apps/rta/ops/+x/rta_life_op.+x | drive | $T/h/@.apps/rta/rules.pdl | $T/alone/l.txt | joe | car | $T/h/@.apps/rta/ops/+x/rta_momentum_op.+x | $T/h/@.apps/rta/road.grid | $T/alone/m.txt | $T/alone/e.txt
CAPTURE | alone_drive
EXPECT_EQ | $page_drive | $alone_drive | the-page-prints-the-SAME-line-as-the-op-alone
EXPECT_HAS | h/#.desktop/rta_mom_ledger.txt | MOM \p 1 \p 0 \p 1 | the-road-ledger-of-the-scratch-house-moved-the-car
RUN | sh | $T/h/@.apps/rta/events/rta_exit/event_pkg/pages/page_1/cmd_1.sh
EXPECT_EXIT | 0 | the-exit-page-runs
EXPECT_HAS | h/#.desktop/rta_life_ledger.txt | EXIT \p joe \p car | the-exit-page-wrote-the-EXIT-row-for-joe-and-car
RUN | sh | $T/h/@.apps/rta/events/rta_exit/event_pkg/pages/page_1/cmd_1.sh
EXPECT_EXIT | 12 | the-exit-page-propagates-12-when-not-in-the-car
RUN | $T/h/@.apps/rta/ops/+x/rta_life_op.+x | exit | $T/h/@.apps/rta/rules.pdl | $T/alone/l.txt | joe | car
RUN | sh | $T/h/@.apps/rta/events/rta_drive/event_pkg/pages/page_1/cmd_1.sh
EXPECT_EXIT | 10 | the-drive-page-propagates-10-again-after-exit
RUN | sh | $T/h/@.apps/rta/events/rta_eat/event_pkg/pages/page_1/cmd_1.sh
EXPECT_EXIT | 0 | the-eat-page-runs
CAPTURE | page_eat
EXPECT_EQ | $page_eat | hunger=50 | HAND-COMPUTED-80-minus-30
RUN | $T/h/@.apps/rta/ops/+x/rta_life_op.+x | eat | $T/h/@.apps/rta/rules.pdl | $T/alone/l.txt | joe
CAPTURE | alone_eat
EXPECT_EQ | $page_eat | $alone_eat | the-eat-page-prints-the-SAME-line-as-the-op-alone
RUN | $T/h/@.apps/rta/ops/+x/rta_life_op.+x | status | $T/h/@.apps/rta/rules.pdl | $T/h/#.desktop/rta_life_ledger.txt | joe | car
CAPTURE | page_status
RUN | $T/h/@.apps/rta/ops/+x/rta_life_op.+x | status | $T/h/@.apps/rta/rules.pdl | $T/alone/l.txt | joe | car
CAPTURE | alone_status
EXPECT_EQ | $page_status | $alone_status | the-scratch-house-ledger-and-the-op-alone-ledger-end-in-the-same-state
EXPECT_EQ | $page_status | in_car=0 hunger=50 fuel=2 turn=4 | HAND-COMPUTED-four-accepted-turns-enter-drive-exit-eat-the-refusals-wrote-none
# ---- D108: rta_sleep and rta_part pages (the ledger here: joe out of the car, hunger 50, turn 4)
RUN | sh | $T/h/@.apps/rta/events/rta_sleep/event_pkg/pages/page_1/cmd_1.sh
EXPECT_EXIT | 0 | the-sleep-page-runs
CAPTURE | page_sleep
EXPECT_EQ | $page_sleep | slept=3 hunger=56 turn=7 | HAND-COMPUTED-50-plus-3-times-2-and-turn-4-plus-3
RUN | $T/h/@.apps/rta/ops/+x/rta_life_op.+x | sleep | $T/h/@.apps/rta/rules.pdl | $T/alone/l.txt | joe | 3
CAPTURE | alone_sleep
EXPECT_EQ | $page_sleep | $alone_sleep | the-sleep-page-prints-the-SAME-line-as-the-op-alone
EXPECT_HAS | h/#.desktop/rta_life_ledger.txt | SLEEP \p joe \p 3 \p 56 | the-sleep-page-wrote-the-SLEEP-row
EXPECT_HAS | h/#.desktop/rta_life_ledger.txt | TURN \p 7 \p sleep | the-sleep-page-wrote-ONE-TURN-row-with-the-new-cumulative-count
RUN | sh | $T/h/@.apps/rta/events/rta_enter/event_pkg/pages/page_1/cmd_1.sh
RUN | sh | $T/h/@.apps/rta/events/rta_sleep/event_pkg/pages/page_1/cmd_1.sh
EXPECT_EXIT | 15 | the-sleep-page-propagates-15-in-the-car
RUN | grep | -c | SLEEP | $T/h/#.desktop/rta_life_ledger.txt
EXPECT_OUT_IS | 1 | the-in-car-refusal-wrote-no-second-SLEEP-row
RUN | sh | $T/h/@.apps/rta/events/rta_exit/event_pkg/pages/page_1/cmd_1.sh
WRITE | h/@.apps/rta/rules.pdl | RULE \p hunger_start \p 80\nRULE \p sleep_max_turns \p 2\nRULE \p hunger_per_turn \p 2\nRULE \p hunger_max \p 100\n
RUN | sh | $T/h/@.apps/rta/events/rta_sleep/event_pkg/pages/page_1/cmd_1.sh
EXPECT_EXIT | 16 | the-sleep-page-propagates-16-when-the-RULE-bound-is-2-(the-bound-is-data)
RUN | sh | $T/h/@.apps/rta/events/rta_part/event_pkg/pages/page_1/cmd_1.sh
EXPECT_EXIT | 0 | the-part-page-runs
CAPTURE | page_part
EXPECT_EQ | $page_part | ok | the-part-page-prints-ok
RUN | $T/h/@.apps/rta/ops/+x/rta_life_op.+x | part | $T/h/@.apps/rta/rules.pdl | $T/alone/l.txt | car | tank | gas | ok:3
CAPTURE | alone_part
EXPECT_EQ | $page_part | $alone_part | the-part-page-prints-the-SAME-line-as-the-op-alone
RUN | grep | -c | -F | PART \p car \p tank \p gas \p ok \p 3 | $T/h/#.desktop/rta_life_ledger.txt
EXPECT_OUT_IS | 2 | the-part-page-appended-a-second-tank-row-(the-seed-row-and-the-page-row)
WRITE | h/@.apps/rta/rules.pdl | RULE \p hunger_start \p 80\n
RUN | sh | $T/h/@.apps/rta/events/rta_eat/event_pkg/pages/page_1/cmd_1.sh
EXPECT_EXIT | 9 | the-eat-page-propagates-9-when-the-rules-file-lacks-eat_amount-(no-number-in-C)
CLEAN |
