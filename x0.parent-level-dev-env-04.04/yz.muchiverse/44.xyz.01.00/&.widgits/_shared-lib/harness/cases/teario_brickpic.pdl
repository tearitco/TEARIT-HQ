# teario_brickpic (2026-11-22; decision D107): a broken brick must leave the 2D PICTURE. The 2D renderer blits the desk map.png (the 3D engine reads cells.txt); the brick-break path used to rewrite only cells.txt, so 2D drew the brick to the end of the game (seen live, photographed). The REAL game_core driver (built from source) runs in a scratch house on a level with a brick at (4,4) over the START cell; a human seat jumps (key 32 in the editor relay); the ledger gets the brick row and map.png must CHANGE and equal a fresh preview of the new cells.txt. NEGATIVE: the same source built with -DGC_MUT_NO_PICTURE (the old behaviour) leaves map.png byte for byte the same, so the check FAILS on it.
RESULTS | ../results/teario_brickpic.txt
ENV | LC_ALL | C

CASE    | bp_real
SCRATCH |
RUN | gcc | -std=gnu11 | -O2 | -w | -o | $T/gc | $HOUSE/&.widgits/_shared-lib/ops/game_core.c | -lm
COPYDIR | @.apps/teario | house/@.apps/teario
COPYDIR | @.apps/teario-play | house/@.apps/teario-play
RUN | rm | -rf | $T/house/@.apps/teario-play/state | $T/house/@.apps/teario-play/board
RUN | sed | -i | s/meadow\.pdl/blocks.pdl/ | $T/house/@.apps/teario-play/rulesets/default/board.pdl
WRITE | house/@.apps/teario/levels/blocks.pdl | # level.pdl - scratch\nMETA  \p name \p Blocks\nMETA  \p size \p 16 x 8\nSTART \p 4 \p 6\nGOAL  \p 14 \p 6\nROW   \p 0 \p ................\nROW   \p 1 \p ................\nROW   \p 2 \p ................\nROW   \p 3 \p ................\nROW   \p 4 \p ....B...........\nROW   \p 5 \p ................\nROW   \p 6 \p ......o.........\nROW   \p 7 \p ################
MKDIR   | house/@.apps/teario-play/state/games/teario-play/game
MKDIR   | house/@.apps/teario-play/state/world
COPY    | &.widgits/_shared-lib/ops/+x/raw_to_png.+x | house/&.widgits/_shared-lib/ops/+x/raw_to_png.+x
RUN | $T/gc | $T/house/@.apps/teario-play | $T/house/@.apps/teario-play/state/games/teario-play/game | new | 7
RUN | $T/gc | $T/house/@.apps/teario-play | $T/house/@.apps/teario-play/state/games/teario-play/game | join | H | human
RUN | $T/gc | $T/house/@.apps/teario-play | $T/house/@.apps/teario-play/state/games/teario-play/game | start
EXPECT_EXIT | 0 | a-started-game-with-a-human-seat-on-the-brick-level
SPAWN   | DRV | $T/gc | driver | $T/house | $T/house/@.apps/teario-play | $T/house/@.apps/teario-play
WAIT_HAS | house/@.apps/teario-play/state/game_ui.txt | RUNNING | 15000 | VACUITY-the-driver-runs
WAIT_HAS | house/@.apps/teario-play/teario-play-pchq/pieces/system/maps/teario-play/play/cells.txt | cells | 10000 | VACUITY-the-driver-drew-the-desk
SLEEP   | 2000
EXPECT_EXISTS | house/@.apps/teario-play/teario-play-pchq/pieces/system/maps/teario-play/play/map.png | VACUITY-the-2D-picture-exists-before-the-break
RUN | cp | $T/house/@.apps/teario-play/teario-play-pchq/pieces/system/maps/teario-play/play/map.png | $T/before.png
WRITE   | house/@.apps/teario-play/state/interact_relay.txt | 32\n
WAIT_HAS | house/@.apps/teario-play/state/games/teario-play/game/ledger.txt | brick\pp1\p4,4 | 15000 | THE-BRICK-BROKE-(ledger-row)
SLEEP   | 2500
RUN | /usr/bin/kill | $DRV
SLEEP   | 1500
RUN | cmp | -s | $T/before.png | $T/house/@.apps/teario-play/teario-play-pchq/pieces/system/maps/teario-play/play/map.png
EXPECT_EXIT | 1 | THE-2D-PICTURE-CHANGED-after-the-brick-broke-(the-brick-is-gone-from-map.png)
CLEAN   |

CASE    | bp_mutant_old_behaviour
SCRATCH |
RUN | gcc | -std=gnu11 | -O2 | -w | -DGC_MUT_NO_PICTURE | -o | $T/gc | $HOUSE/&.widgits/_shared-lib/ops/game_core.c | -lm
COPYDIR | @.apps/teario | house/@.apps/teario
COPYDIR | @.apps/teario-play | house/@.apps/teario-play
RUN | rm | -rf | $T/house/@.apps/teario-play/state | $T/house/@.apps/teario-play/board
RUN | sed | -i | s/meadow\.pdl/blocks.pdl/ | $T/house/@.apps/teario-play/rulesets/default/board.pdl
WRITE | house/@.apps/teario/levels/blocks.pdl | # level.pdl - scratch\nMETA  \p name \p Blocks\nMETA  \p size \p 16 x 8\nSTART \p 4 \p 6\nGOAL  \p 14 \p 6\nROW   \p 0 \p ................\nROW   \p 1 \p ................\nROW   \p 2 \p ................\nROW   \p 3 \p ................\nROW   \p 4 \p ....B...........\nROW   \p 5 \p ................\nROW   \p 6 \p ......o.........\nROW   \p 7 \p ################
MKDIR   | house/@.apps/teario-play/state/games/teario-play/game
MKDIR   | house/@.apps/teario-play/state/world
COPY    | &.widgits/_shared-lib/ops/+x/raw_to_png.+x | house/&.widgits/_shared-lib/ops/+x/raw_to_png.+x
RUN | $T/gc | $T/house/@.apps/teario-play | $T/house/@.apps/teario-play/state/games/teario-play/game | new | 7
RUN | $T/gc | $T/house/@.apps/teario-play | $T/house/@.apps/teario-play/state/games/teario-play/game | join | H | human
RUN | $T/gc | $T/house/@.apps/teario-play | $T/house/@.apps/teario-play/state/games/teario-play/game | start
EXPECT_EXIT | 0 | a-started-game-with-a-human-seat-on-the-brick-level
SPAWN   | DRV | $T/gc | driver | $T/house | $T/house/@.apps/teario-play | $T/house/@.apps/teario-play
WAIT_HAS | house/@.apps/teario-play/state/game_ui.txt | RUNNING | 15000 | VACUITY-the-driver-runs
WAIT_HAS | house/@.apps/teario-play/teario-play-pchq/pieces/system/maps/teario-play/play/cells.txt | cells | 10000 | VACUITY-the-driver-drew-the-desk
SLEEP   | 2000
EXPECT_EXISTS | house/@.apps/teario-play/teario-play-pchq/pieces/system/maps/teario-play/play/map.png | VACUITY-the-2D-picture-exists-before-the-break
RUN | cp | $T/house/@.apps/teario-play/teario-play-pchq/pieces/system/maps/teario-play/play/map.png | $T/before.png
WRITE   | house/@.apps/teario-play/state/interact_relay.txt | 32\n
WAIT_HAS | house/@.apps/teario-play/state/games/teario-play/game/ledger.txt | brick\pp1\p4,4 | 15000 | THE-BRICK-BROKE-(ledger-row)
SLEEP   | 2500
RUN | /usr/bin/kill | $DRV
SLEEP   | 1500
RUN | cmp | -s | $T/before.png | $T/house/@.apps/teario-play/teario-play-pchq/pieces/system/maps/teario-play/play/map.png
EXPECT_EXIT | 0 | MUTANT-the-old-behaviour-leaves-the-2D-picture-byte-for-byte-the-same-(this-is-the-bug)
CLEAN   |

