# teario_stampimg (2026-11-22; owner SAID: "stamp bank should show example of stamp, like palettes"). The stamp bank of Teario-Make shows a PICTURE per stamp; this case proves the picture is the PLACED RESULT, not a second drawing:
# the verb `stampimg <id> <out> <atlas>` paints the stamp into a scratch level with the same doc_paint the Place button runs, projects it with the same scene + preview + events.txt and crops the picture (sprite.csv, 64x64).
# Here, for each of the six stamps in rulesets/default/stamps.pdl: (1) the scratch level the picture was made from is, byte for byte (level.pdl), the level made by the ordinary verbs blank + paint; (2) its cells.txt equals the `scene` of that independent level;
# (3) the picture is deterministic (second run, same bytes) and distinct per stamp; NEGATIVES: a different tool gives a different level, a non-scratch state folder is refused, an unknown stamp is refused. Scratch only.
RESULTS | ../results/teario_stampimg.txt
ENV | LC_ALL | C

CASE    | setup
SCRATCH |
COPYDIR | @.apps/teario-make | tm/teario-make
MKDIR   | pic
MKDIR   | indd
RUN | /bin/true
EXPECT_EXIT | 0 | scratch-ready

CASE    | stamp-ground
RUN | $HOUSE/&.widgits/_shared-lib/ops/+x/game_core.+x | $T/tm/teario-make | $T/stampimg/ground/game | stampimg | ground | $T/pic/ground | $HOUSE/@.apps/teario-make/teario-make-pchq/pieces/system/maps/teario-make/board/cells.rgba
EXPECT_EXIT | 0 | the-picture-of-ground-is-made
EXPECT_OUT | STAMPIMG ground | and-says-so
EXPECT_EXISTS | $T/pic/ground/sprite.csv | the-sprite-csv-exists
RUN | $HOUSE/&.widgits/_shared-lib/ops/+x/game_core.+x | $T/tm/teario-make | $T/stampimg/ground/game | export
RUN | $HOUSE/&.widgits/_shared-lib/ops/+x/hash_op.+x | sha256 | --file | $T/stampimg/ground/game/level.pdl
CAPTURE | pl_ground
RUN | $HOUSE/&.widgits/_shared-lib/ops/+x/game_core.+x | $T/tm/teario-make | $T/ind/ground | new | 1
RUN | $HOUSE/&.widgits/_shared-lib/ops/+x/game_core.+x | $T/tm/teario-make | $T/ind/ground | blank | 8 | 4
RUN | $HOUSE/&.widgits/_shared-lib/ops/+x/game_core.+x | $T/tm/teario-make | $T/ind/ground | paint | ground | 3 | 2
EXPECT_EXIT | 0 | the-ordinary-paint-verb-places-ground
RUN | $HOUSE/&.widgits/_shared-lib/ops/+x/game_core.+x | $T/tm/teario-make | $T/ind/ground | export
RUN | $HOUSE/&.widgits/_shared-lib/ops/+x/hash_op.+x | sha256 | --file | $T/ind/ground/level.pdl
CAPTURE | ip_ground
EXPECT_EQ | $pl_ground | $ip_ground | the-level-behind-the-picture-IS-the-level-the-paint-verb-makes-(level.pdl-sha256)
MKDIR | indd/ground
RUN | $HOUSE/&.widgits/_shared-lib/ops/+x/game_core.+x | $T/tm/teario-make | $T/ind/ground | scene | $T/indd/ground | $HOUSE/@.apps/teario-make/teario-make-pchq/pieces/system/maps/teario-make/board/cells.rgba
RUN | $HOUSE/&.widgits/_shared-lib/ops/+x/hash_op.+x | sha256 | --file | $T/indd/ground/cells.txt
CAPTURE | ic
RUN | $HOUSE/&.widgits/_shared-lib/ops/+x/hash_op.+x | sha256 | --file | $T/stampimg/ground/game/desk/cells.txt
CAPTURE | pc
EXPECT_EQ | $pc | $ic | and-the-land-it-drew-is-the-scene-of-that-level
RUN | $HOUSE/&.widgits/_shared-lib/ops/+x/hash_op.+x | sha256 | --file | $T/pic/ground/sprite.csv
CAPTURE | a
RUN | $HOUSE/&.widgits/_shared-lib/ops/+x/game_core.+x | $T/tm/teario-make | $T/stampimg/ground/game | stampimg | ground | $T/pic2_ground | $HOUSE/@.apps/teario-make/teario-make-pchq/pieces/system/maps/teario-make/board/cells.rgba
RUN | $HOUSE/&.widgits/_shared-lib/ops/+x/hash_op.+x | sha256 | --file | $T/pic2_ground/sprite.csv
CAPTURE | b
EXPECT_EQ | $a | $b | the-picture-is-deterministic-(same-bytes-on-a-second-run)

