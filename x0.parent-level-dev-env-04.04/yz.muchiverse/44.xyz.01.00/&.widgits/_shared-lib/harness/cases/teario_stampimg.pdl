RUN | $HOUSE/&.widgits/_shared-lib/ops/+x/hash_op.+x | sha256 | --file | $T/pic/erase/sprite.csv
CAPTURE | a
RUN | $HOUSE/&.widgits/_shared-lib/ops/+x/game_core.+x | $T/tm/teario-make | $T/stampimg/erase/game | stampimg | erase | $T/pic2_erase | $HOUSE/@.apps/teario-make/teario-make-pchq/pieces/system/maps/teario-make/board/cells.rgba
