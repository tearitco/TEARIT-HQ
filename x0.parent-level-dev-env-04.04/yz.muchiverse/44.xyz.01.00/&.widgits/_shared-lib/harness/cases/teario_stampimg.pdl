CASE    | negatives
# a picture that did not depend on the stamp would make these fail: every stamp has its own picture, and the level of one tool is not the level of another
RUN | $HOUSE/&.widgits/_shared-lib/ops/+x/hash_op.+x | sha256 | --file | $T/pic/ground/sprite.csv
CAPTURE | n_ground
RUN | $HOUSE/&.widgits/_shared-lib/ops/+x/hash_op.+x | sha256 | --file | $T/pic/erase/sprite.csv
CAPTURE | n_erase
RUN | $HOUSE/&.widgits/_shared-lib/ops/+x/hash_op.+x | sha256 | --file | $T/pic/enemy/sprite.csv
CAPTURE | n_enemy
RUN | $HOUSE/&.widgits/_shared-lib/ops/+x/hash_op.+x | sha256 | --file | $T/pic/power/sprite.csv
CAPTURE | n_power
RUN | $HOUSE/&.widgits/_shared-lib/ops/+x/hash_op.+x | sha256 | --file | $T/pic/start/sprite.csv
CAPTURE | n_start
RUN | $HOUSE/&.widgits/_shared-lib/ops/+x/hash_op.+x | sha256 | --file | $T/pic/goal/sprite.csv
CAPTURE | n_goal
EXPECT_NE | $n_ground | $n_erase | NEGATIVE-ground-and-erase-pictures-differ
EXPECT_NE | $n_enemy | $n_power | NEGATIVE-enemy-and-power-pictures-differ
EXPECT_NE | $n_start | $n_goal | NEGATIVE-start-and-goal-pictures-differ
EXPECT_NE | $n_ground | $n_enemy | NEGATIVE-ground-and-enemy-pictures-differ
EXPECT_NE | $pl_enemy | $ip_power | NEGATIVE-the-level-of-an-enemy-stamp-is-not-the-level-of-a-power-up-stamp
EXPECT_NE | $pl_ground | $ip_erase | NEGATIVE-a-picture-from-different-data-fails-the-level-comparison
RUN | $HOUSE/&.widgits/_shared-lib/ops/+x/game_core.+x | $T/tm/teario-make | $T/notscratch | stampimg | ground | $T/pic_x | $HOUSE/@.apps/teario-make/teario-make-pchq/pieces/system/maps/teario-make/board/cells.rgba
EXPECT_EXIT | 2 | NEGATIVE-a-state-folder-that-is-not-a-scratch-one-is-refused
EXPECT_NOFILE | $T/pic_x/sprite.csv | and-writes-no-picture
RUN | $HOUSE/&.widgits/_shared-lib/ops/+x/game_core.+x | $T/tm/teario-make | $T/stampimg/nope/game | stampimg | nope | $T/pic_n | $HOUSE/@.apps/teario-make/teario-make-pchq/pieces/system/maps/teario-make/board/cells.rgba
EXPECT_EXIT | 2 | NEGATIVE-an-unknown-stamp-has-no-picture

CASE    | the-window-shows-the-picture
EXPECT_HAS | $HOUSE/@.apps/teario-make/board/pchq-board.xhtpm | sprite="${stamp.sprite}" | the-bank-row-binds-the-picture
EXPECT_HAS | $HOUSE/@.apps/teario-make/board/pchq-board.xhtpm | sprite-inline sprite-big | and-draws-it-as-a-sprite-row

CASE    | no-stray-figures
# the coordinator's finding 2026-11-22: every picture carried the scratch level's start hero (a red dot, rgb 220,60,60). Only what the stamp itself adds may show: hero pixels only in the START picture, none elsewhere; goal flag colour (255,210,60) only in goal; enemy (190,70,210) only in enemy; power (90,200,255) only in power.
RUN | grep | -c | 220,60,60,255 | $T/pic/ground/sprite.csv
CAPTURE | h_ground
EXPECT_EQ | $h_ground | 0 | ground-picture-has-no-start-hero-dot
RUN | grep | -c | 220,60,60,255 | $T/pic/erase/sprite.csv
CAPTURE | h_erase
EXPECT_EQ | $h_erase | 0 | erase-picture-has-no-start-hero-dot
RUN | grep | -c | 220,60,60,255 | $T/pic/enemy/sprite.csv
CAPTURE | h_enemy
EXPECT_EQ | $h_enemy | 0 | enemy-picture-has-no-start-hero-dot
RUN | grep | -c | 220,60,60,255 | $T/pic/power/sprite.csv
CAPTURE | h_power
EXPECT_EQ | $h_power | 0 | power-picture-has-no-start-hero-dot
RUN | grep | -c | 220,60,60,255 | $T/pic/goal/sprite.csv
CAPTURE | h_goal
EXPECT_EQ | $h_goal | 0 | goal-picture-has-no-start-hero-dot
RUN | grep | -c | 220,60,60,255 | $T/pic/start/sprite.csv
CAPTURE | h_start
EXPECT_NE | $h_start | 0 | NEGATIVE-CONTROL-the-start-picture-DOES-have-the-hero-dot-(so-the-count-can-fail)
RUN | grep | -c | 255,210,60,255 | $T/pic/ground/sprite.csv
CAPTURE | f_ground
EXPECT_EQ | $f_ground | 0 | ground-picture-has-no-goal-flag
RUN | grep | -c | 255,210,60,255 | $T/pic/goal/sprite.csv
CAPTURE | f_goal
EXPECT_NE | $f_goal | 0 | NEGATIVE-CONTROL-the-goal-picture-has-the-flag
