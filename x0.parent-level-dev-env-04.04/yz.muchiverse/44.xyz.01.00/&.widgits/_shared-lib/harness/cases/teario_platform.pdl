RUN | $HOUSE/&.widgits/_shared-lib/ops/+x/game_core.+x | $T/tpl/mead | $T/m4 | input | p1 | fire | 90
RUN | $HOUSE/&.widgits/_shared-lib/ops/+x/game_core.+x | $T/tpl/mead | $T/m4 | input | p1 | jump | 200
RUN | $HOUSE/&.widgits/_shared-lib/ops/+x/game_core.+x | $T/tpl/mead | $T/m4 | input | p1 | right | 230
RUN | $HOUSE/&.widgits/_shared-lib/ops/+x/game_core.+x | $T/tpl/mead | $T/m4 | advance | 400
EXPECT_OUT | tick 241 | OBSERVED-the-level-is-cleared-at-tick-241
RUN | $HOUSE/&.widgits/_shared-lib/ops/+x/game_core.+x | $T/tpl/mead | $T/m4 | status
EXPECT_OUT | score=250 stomps=1 kills=1 hits=0 armed=1 enemies=0 | OBSERVED-250-=-pick-up-50-+-fireball-kill-100-+-stomp-100-and-no-enemy-left
