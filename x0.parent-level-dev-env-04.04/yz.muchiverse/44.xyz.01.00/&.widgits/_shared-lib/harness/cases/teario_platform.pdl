CASE    | tpl_stomp_numbers_are_data
# the three stomp numbers are RULE rows (rules.pdl), part of the rules hash. A copy with stomp_score 250 is a different game: it refuses the Meadow run recorded under 100, and the SAME inputs end with the pick-up 50 + the fireball kill 100 + a stomp 250 = 400 (the original run is 50 + 100 + 100 = 250)
COPYDIR | @.apps/teario-play | tpl/mead250
RUN | sed | -i | s/^RULE \p stomp_score .*/RULE \p stomp_score \p 250/ | $T/tpl/mead250/rulesets/default/rules.pdl
RUN | grep | -c | stomp_score \p 250 | $T/tpl/mead250/rulesets/default/rules.pdl
EXPECT_OUT_IS | 1 | vacuity-the-copy-really-has-stomp_score-250
