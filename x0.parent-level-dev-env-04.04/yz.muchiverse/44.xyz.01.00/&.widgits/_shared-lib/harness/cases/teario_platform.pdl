EXPECT_OUT | CLEAR level=97d185088521224b;run=5117a05370f07798;ticks=241 | the-proof-line-of-the-full-Meadow-clear-pinned
RUN | $HOUSE/&.widgits/_shared-lib/ops/+x/game_core.+x | $T/tpl/mead | $T/m4 | replay
EXPECT_OUT | REPLAY events=12 | the-12-rows-replay-(inputs-only)
RUN | cp | -r | $T/m4 | $T/m5
RUN | sed | -i | s/\pinput\pfire\p/\pinput\pstay\p/ | $T/m5/ledger.txt
RUN | cmp | $T/m4/ledger.txt | $T/m5/ledger.txt
EXPECT_EXIT | 1 | vacuity-the-edit-changed-the-file
RUN | $HOUSE/&.widgits/_shared-lib/ops/+x/game_core.+x | $T/tpl/mead | $T/m5 | verify_clear
EXPECT_EXIT | 1 | NEGATIVE-a-run-with-the-fire-removed-is-NOT-a-clear-(the-hash-no-longer-reproduces)

CASE    | tpl_level_rows
RUN | grep | -c | ^ENEMY | $T/tpl/teario/levels/meadow.pdl
EXPECT_OUT_IS | 2 | the-level-file-has-2-ENEMY-rows
RUN | grep | -c | ^POWER | $T/tpl/teario/levels/meadow.pdl
EXPECT_OUT_IS | 1 | and-1-POWER-row
RUN | cp | -r | $T/tpl/teario | $T/tpl/teario_bad
RUN | cp | -r | $T/tpl/mead | $T/tpl/mead_bad
RUN | sed | -i | s#\.\./teario/#../teario_bad/# | $T/tpl/mead_bad/rulesets/default/board.pdl
RUN | sed | -i | s/^ENEMY \p 13 \p 10/ENEMY \p 2 \p 11/ | $T/tpl/teario_bad/levels/meadow.pdl
RUN | cmp | $T/tpl/teario/levels/meadow.pdl | $T/tpl/teario_bad/levels/meadow.pdl
EXPECT_EXIT | 1 | vacuity-the-bad-level-differs
MKDIR   | mb
RUN | $HOUSE/&.widgits/_shared-lib/ops/+x/game_core.+x | $T/tpl/mead_bad | $T/mb | new | 7
EXPECT_EXIT | 2 | NEGATIVE-an-enemy-inside-solid-ground-(row-11)-is-refused-when-a-game-is-made
EXPECT_OUT | ENEMY 1 is outside the level or inside a solid tile | and-the-engine-says-why

CASE    | tpl_patrol_speed_is_data
# the patrol speed is a RULE row (rules.pdl patrol_speed 10), so it is in the rules hash: a copy with speed 5 is a DIFFERENT game; the Meadow run recorded under speed 10 is refused by it, and the enemies move differently
COPYDIR | @.apps/teario-play | tpl/mead5
RUN | sed | -i | s/^RULE \p patrol_speed \p 10/RULE \p patrol_speed \p 5/ | $T/tpl/mead5/rulesets/default/rules.pdl
RUN | grep | -c | patrol_speed \p 5 | $T/tpl/mead5/rulesets/default/rules.pdl
EXPECT_OUT_IS | 1 | vacuity-the-copy-really-has-speed-5
RUN | $HOUSE/&.widgits/_shared-lib/ops/+x/game_core.+x | $T/tpl/mead5 | $T/m4 | replay
EXPECT_EXIT | 1 | NEGATIVE-the-run-recorded-under-speed-10-is-refused-by-the-speed-5-game-(the-rules-hash-differs)
EXPECT_OUT | the rules say ruleset=default | and-the-refusal-names-the-rules-mismatch
MKDIR   | m6
RUN | $HOUSE/&.widgits/_shared-lib/ops/+x/game_core.+x | $T/tpl/mead5 | $T/m6 | new | 7
RUN | $HOUSE/&.widgits/_shared-lib/ops/+x/game_core.+x | $T/tpl/mead5 | $T/m6 | join | H | human
RUN | $HOUSE/&.widgits/_shared-lib/ops/+x/game_core.+x | $T/tpl/mead5 | $T/m6 | start
RUN | $HOUSE/&.widgits/_shared-lib/ops/+x/game_core.+x | $T/tpl/mead5 | $T/m6 | advance | 40
RUN | $HOUSE/&.widgits/_shared-lib/ops/+x/game_core.+x | $T/tpl/mead5 | $T/m6 | status
EXPECT_OUT | ENEMY e1 | the-speed-5-game-runs-and-has-its-enemies

CASE    | tpl_fireball_numbers_are_data
# the four fireball numbers are RULE rows (rules.pdl), part of the rules hash: a copy with fireball_speed 28 is a different game, refuses the Meadow run recorded under 56, and its shot is really slower: the demo fires on tick 90 (the hero faces left) from x 4240; on tick 95 the shot is at 4240 - 5 x 56 = 3960 (speed 56) or 4240 - 5 x 28 = 4100 (speed 28)
COPYDIR | @.apps/teario-play | tpl/mead28
RUN | sed | -i | s/^RULE \p fireball_speed \p 56/RULE \p fireball_speed \p 28/ | $T/tpl/mead28/rulesets/default/rules.pdl
RUN | grep | -c | fireball_speed \p 28 | $T/tpl/mead28/rulesets/default/rules.pdl
EXPECT_OUT_IS | 1 | vacuity-the-copy-really-has-speed-28
RUN | $HOUSE/&.widgits/_shared-lib/ops/+x/game_core.+x | $T/tpl/mead28 | $T/m4 | replay
EXPECT_EXIT | 1 | NEGATIVE-the-run-recorded-under-fireball-speed-56-is-refused-by-the-speed-28-game
EXPECT_OUT | the rules say ruleset=default | and-the-refusal-names-the-rules-mismatch
