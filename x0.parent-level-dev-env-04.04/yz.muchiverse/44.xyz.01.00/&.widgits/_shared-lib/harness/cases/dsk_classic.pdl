WRITE   | x/stray.txt | the winner is p1
RUN | $HOUSE/@.apps/deskopoly/ops/+x/deskopoly.+x | $T/app | $T/x | audit
EXPECT_EXIT | 1 | NEGATIVE-a-stray-file-is-a-ghost
