CASE    | tie
SCRATCH |
COPYDIR | @.apps/deskopoly | app | ops,deskopoly-pchq,state
MKDIR   | t
RUN | $HOUSE/@.apps/deskopoly/ops/+x/deskopoly.+x | $T/app | $T/t | lobby | classic
RUN | $HOUSE/@.apps/deskopoly/ops/+x/deskopoly.+x | $T/app | $T/t | join | A | human
RUN | $HOUSE/@.apps/deskopoly/ops/+x/deskopoly.+x | $T/app | $T/t | join | B | pet
RUN | $HOUSE/@.apps/deskopoly/ops/+x/deskopoly.+x | $T/app | $T/t | start | 4
RUN | $HOUSE/@.apps/deskopoly/ops/+x/deskopoly.+x | $T/app | $T/t | order
EXPECT_OUT | p1 threw 4,3 total=7 | seed-4-first-throw
RUN | $HOUSE/@.apps/deskopoly/ops/+x/deskopoly.+x | $T/app | $T/t | order
EXPECT_OUT_LACKS | first | a-tie-decides-nothing
RUN | $HOUSE/@.apps/deskopoly/ops/+x/deskopoly.+x | $T/app | $T/t | order
EXPECT_OUT | p1 threw 2,1 total=3 | the-tied-players-throw-again-with-fresh-dice
RUN | $HOUSE/@.apps/deskopoly/ops/+x/deskopoly.+x | $T/app | $T/t | order
EXPECT_OUT | first p2 | the-higher-re-throw-moves-first
RUN | $HOUSE/@.apps/deskopoly/ops/+x/deskopoly.+x | $T/app | $T/t | ledger_hash
EXPECT_OUT | rows=9 | nine-rows-in-the-tie-game

CASE    | tamper
SCRATCH |
COPYDIR | @.apps/deskopoly | app | ops,deskopoly-pchq,state
MKDIR   | x
RUN | $HOUSE/@.apps/deskopoly/ops/+x/deskopoly.+x | $T/app | $T/x | lobby | classic
RUN | $HOUSE/@.apps/deskopoly/ops/+x/deskopoly.+x | $T/app | $T/x | join | A | human
RUN | $HOUSE/@.apps/deskopoly/ops/+x/deskopoly.+x | $T/app | $T/x | join | B | pet
RUN | $HOUSE/@.apps/deskopoly/ops/+x/deskopoly.+x | $T/app | $T/x | start | 4
RUN | $HOUSE/@.apps/deskopoly/ops/+x/deskopoly.+x | $T/app | $T/x | order
RUN | $HOUSE/@.apps/deskopoly/ops/+x/deskopoly.+x | $T/app | $T/x | order
RUN | $HOUSE/@.apps/deskopoly/ops/+x/deskopoly.+x | $T/app | $T/x | order
RUN | $HOUSE/@.apps/deskopoly/ops/+x/deskopoly.+x | $T/app | $T/x | order
RUN | $HOUSE/@.apps/deskopoly/ops/+x/deskopoly.+x | $T/app | $T/x | replay
EXPECT_EXIT | 0 | the-untouched-ledger-replays
COPY    | @.apps/deskopoly/rulesets/classic/rules.pdl | app/rulesets/classic/rules.pdl
RUN | /usr/bin/sed | -i | s/start_cash    \p 1500/start_cash    \p 1600/ | $T/app/rulesets/classic/rules.pdl
RUN | $HOUSE/@.apps/deskopoly/ops/+x/deskopoly.+x | $T/app | $T/x | replay
EXPECT_EXIT | 1 | NEGATIVE-editing-the-rules-after-the-game-began-is-refused
EXPECT_OUT | the rules changed since the game began | NEGATIVE-the-refusal-names-the-rules-change
COPY    | @.apps/deskopoly/rulesets/classic/rules.pdl | app/rulesets/classic/rules.pdl
RUN | /usr/bin/cp | $T/x/ledger.txt | $T/x/good.keep
RUN | /usr/bin/sed | -i | s/\porder\p4,3\p/\porder\p4,4\p/ | $T/x/ledger.txt
RUN | $HOUSE/@.apps/deskopoly/ops/+x/deskopoly.+x | $T/app | $T/x | replay
EXPECT_EXIT | 1 | NEGATIVE-a-lucky-die-written-into-the-ledger-is-refused
EXPECT_OUT | does not match the seeded dice | NEGATIVE-the-dice-refusal-says-so
