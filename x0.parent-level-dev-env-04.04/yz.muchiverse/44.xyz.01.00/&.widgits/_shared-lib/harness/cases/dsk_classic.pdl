RUN | $HOUSE/@.apps/deskopoly/ops/+x/deskopoly.+x | $T/app | $T/x | replay
EXPECT_EXIT | 1 | NEGATIVE-a-changed-result-is-refused
RUN | /usr/bin/cp | $T/x/good.keep | $T/x/ledger.txt
RUN | /usr/bin/sed | -i | 3d | $T/x/ledger.txt
RUN | $HOUSE/@.apps/deskopoly/ops/+x/deskopoly.+x | $T/app | $T/x | replay
EXPECT_EXIT | 1 | NEGATIVE-a-deleted-middle-row-is-refused
RUN | /usr/bin/cp | $T/x/good.keep | $T/x/ledger.txt
RUN | /usr/bin/sed | -i | 1d | $T/x/ledger.txt
