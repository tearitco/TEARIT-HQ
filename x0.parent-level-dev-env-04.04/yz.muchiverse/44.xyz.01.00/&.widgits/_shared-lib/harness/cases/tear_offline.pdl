RUN | $T/pkg/ops/+x/tear_item_op.+x | AJOIN | $T/pkg | $T/house
WAIT_HAS | pkg/tear_ui.txt | result=joined | 8000 | my-pet-joined-and-paid-the-fee
EXPECT_HAS | pkg/tear_ui.txt | fighters: rex | the-fighter-list-names-my-pet
RUN | $T/pkg/ops/+x/tear_item_op.+x | AFILL | $T/pkg | $T/house
WAIT_HAS | pkg/tear_ui.txt | result=default fighters stepped in | 8000 | the-fill-button-added-a-default-fighter
EXPECT_HAS | pkg/tear_ui.txt | fighters: rex,ai-1 | the-default-fighter-is-named-ai-1
EXPECT_HAS | pkg/tear_ui.txt | n_agrid=8 | the-arena-floor-has-eight-rows
RUN | $T/pkg/ops/+x/tear_item_op.+x | AFIGHT | $T/pkg | $T/house
WAIT_HAS | pkg/tear_ui.txt | result=the fight is over | 8000 | the-fight-button-ran-the-fight
EXPECT_HAS | pkg/tear_ui.txt | winners: | the-window-shows-the-winners
EXPECT_HAS | pkg/tear_ui.txt | finished | the-arena-is-finished
EXPECT_HAS | pkg/data/web_chain.txt | ARENA\parena1\p1v1\palice\p | the-arena-is-a-row-in-the-chain-file
EXPECT_HAS | pkg/data/web_chain.txt | FIGHT\parena1\palice\p | the-fight-is-a-row-in-the-chain-file
RUN | $T/pkg/ops/+x/tear_item_op.+x | AFIGHT | $T/pkg | $T/house
WAIT_HAS | pkg/tear_ui.txt | that arena is closed | 8000 | NEGATIVE-a-second-fight-in-a-finished-arena-is-refused
CLEAN   |
CASE    | layout-has-the-arena-tab-and-no-shell
SCRATCH |
COPY    | &.hq-apps/tear-offline/tear-offline.xhtpm | l.xhtpm
EXPECT_HAS | l.xhtpm | 'TAB arena' | the-sidebar-has-an-Arena-tab
EXPECT_HAS | l.xhtpm | 'AFIGHT' | the-layout-has-the-fight-button
EXPECT_HAS | l.xhtpm | show="${tab_arena}" | the-arena-widgets-show-only-on-the-arena-tab
EXPECT_LACKS | l.xhtpm | .sh' | NEGATIVE-no-action-calls-a-shell-script
CLEAN   |
