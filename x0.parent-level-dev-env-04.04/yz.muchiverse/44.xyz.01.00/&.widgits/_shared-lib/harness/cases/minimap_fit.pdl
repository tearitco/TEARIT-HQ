# A 504-wide page must not be drawn as a 256 board, and a camera at cell 400 must not sit on the right edge.
RESULTS | ../results/minimap_fit.txt
ENV | LC_ALL | C
CASE | fit
SCRATCH |
RUN | /usr/bin/gcc | -std=gnu11 | -O2 | -o | $T/minimap_fit_op | $HOUSE/&.widgits/board-viewer/ops/minimap_fit_op.c
EXPECT_EXIT | 0 | the-fit-compiles
RUN | $T/minimap_fit_op | box | 16 | 16 | 8 | 160
EXPECT_EXIT | 0 | a-small-desk-still-uses-cells
EXPECT_OUT | box 128 128 8 | a-16-desk-is-128-px
RUN | $T/minimap_fit_op | box | 504 | 364 | 8 | 160
EXPECT_EXIT | 0 | the-live-page-fits
EXPECT_OUT | box 160 115 0 | the-504-page-is-160-px-not-504-and-not-256
RUN | $T/minimap_fit_op | dot | 400 | 0 | 504 | 160 | 0
EXPECT_EXIT | 0 | the-eye-on-the-page
EXPECT_OUT | dot 126 0 | cell-400-is-inside-not-the-right-edge
RUN | $T/minimap_fit_op | dot | 8 | 0 | 504 | 160 | 0
EXPECT_OUT | dot 2 0 | cell-8-stays-near-the-left
RUN | $T/minimap_fit_op | dot | 600 | 0 | 504 | 160 | 0
EXPECT_OUT | dot 159 1 | NEGATIVE-only-an-eye-past-the-page-is-clamped
COPY | &.widgits/board-viewer/ops/bv_render_3d.c | bv_render_3d.c
RUN | /usr/bin/grep | -q | -F | bv_minimap_box | bv_render_3d.c
EXPECT_EXIT | 0 | the-renderer-calls-the-fit
RUN | /usr/bin/grep | -q | -F | g_mk.w <= MAX_BOARD_DIM | bv_render_3d.c
EXPECT_EXIT | 1 | NEGATIVE-the-256-gate-is-gone
RUN | $T/minimap_fit_op | box | 504 | 364 | 8 | 200
EXPECT_OUT | box 200 144 0 | mode-0-corner-is-200-px-not-one-pixel-per-cell
COPY | &.widgits/board-viewer/ops/bv_render_2d.c | bv_render_2d.c
RUN | /usr/bin/grep | -q | -F | bv_minimap_box | bv_render_2d.c
EXPECT_EXIT | 0 | mode-0-uses-the-same-fit
RUN | /usr/bin/grep | -q | -F | if (sc < 1.0f) sc = 1.0f | bv_render_2d.c
EXPECT_EXIT | 1 | NEGATIVE-mode-0-no-longer-floors-at-one-pixel-per-cell
RUN | /usr/bin/grep | -q | -F | p2d_cells_minimap | bv_render_2d.c
EXPECT_EXIT | 0 | mode-0-without-map-png-still-draws-the-page
RUN | /usr/bin/grep | -q | -F | p2d_atlas_main | bv_render_2d.c
EXPECT_EXIT | 0 | mode-0-blits-the-rpg-maker-atlas
COPY | &.widgits/board-viewer/ops/bv_menu_input.c | bv_menu_input.c
RUN | /usr/bin/grep | -q | -F | view_2d_style | bv_menu_input.c
EXPECT_EXIT | 0 | backslash-in-2d-still-reaches-the-style-switch
# tile colours (same scratch, same compiled op)
# 2026-11-16 (owner: "why dont i see snow on mini map?" on ark-age and live): a cell paints the average colour of its atlas tile, not three flat colours. Real atlases, real helper.
RUN | $T/minimap_fit_op | tileavg | $HOUSE/@.apps/centroid/centroid-pchq/pieces/system/maps/centroid/ark-age/cells.rgba | 16 | 24 | 6
EXPECT_OUT | tileavg 235 211 166 | ark-age-slot-6-is-SAND-(owner-2026-11-17)
RUN | $T/minimap_fit_op | tileavg | $HOUSE/@.apps/centroid/centroid-pchq/pieces/system/maps/centroid/live/cells.rgba | 16 | 24 | 6
EXPECT_OUT | tileavg 255 255 255 | live-active-sheet-slot-6-is-SNOW
RUN | $T/minimap_fit_op | tileavg | $HOUSE/@.apps/centroid/centroid-pchq/pieces/system/maps/centroid/live/cells-rmmv.rgba | 16 | 24 | 6
EXPECT_OUT | tileavg 255 255 255 | live-rmmv-sheet-keeps-the-snow-(backslash-swap)
RUN | $T/minimap_fit_op | tileavg | $HOUSE/@.apps/centroid/centroid-pchq/pieces/system/maps/centroid/live/cells-gen.rgba | 16 | 24 | 6
EXPECT_OUT | tileavg 255 255 255 | live-gen-sheet-keeps-the-snow-(backslash-swap)
RUN | $T/minimap_fit_op | tileavg | $HOUSE/@.apps/centroid/centroid-pchq/pieces/system/maps/centroid/ark-age/cells-rmmv.rgba | 16 | 24 | 6
EXPECT_OUT | tileavg 235 211 166 | ark-age-rmmv-sheet-is-sand
RUN | $T/minimap_fit_op | tileavg | $HOUSE/@.apps/centroid/centroid-pchq/pieces/system/maps/centroid/ark-age/cells-gen.rgba | 16 | 24 | 6
EXPECT_OUT | tileavg 166 211 235 | ark-age-gen-sheet-is-sand-(red-blue-swapped)
RUN | $T/minimap_fit_op | tileavg | $HOUSE/@.apps/centroid/centroid-pchq/pieces/system/maps/centroid/ark-age/cells.rgba | 16 | 24 | 6
EXPECT_OUT_LACKS | 255 255 255 | NEGATIVE-ark-age-slot-6-is-not-snow-any-more
RUN | $T/minimap_fit_op | tileavg | $HOUSE/@.apps/centroid/centroid-pchq/pieces/system/maps/centroid/ark-age/cells.rgba | 16 | 24 | 1
EXPECT_OUT | tileavg 125 194 60 | grass-slot-1-is-green
EXPECT_OUT_LACKS | 255 255 255 | NEGATIVE-grass-is-not-white
RUN | $T/minimap_fit_op | tileavg | $HOUSE/@.apps/centroid/centroid-pchq/pieces/system/maps/centroid/ark-age/cells.rgba | 16 | 24 | 2
EXPECT_OUT | tileavg 144 94 49 | dirt-slot-2-is-brown
RUN | $T/minimap_fit_op | tileavg | $HOUSE/@.apps/centroid/centroid-pchq/pieces/system/maps/centroid/ark-age/cells.rgba | 16 | 24 | 43
EXPECT_OUT | tileavg none | an-off-atlas-slot-keeps-the-old-flat-colour-(none)
RUN | $T/minimap_fit_op | tileavg | $HOUSE/@.apps/centroid/centroid-pchq/pieces/system/maps/centroid/ark-age/cells.rgba | 16 | 24 | 0
EXPECT_OUT | tileavg none | slot-0-is-no-tile
# DATA DECISION (owner 2026-11-17): sand on ark-age, snow on live; slot 6 is the snow-band tile on both pages. The sheets are asserted above.
COPY | &.widgits/board-viewer/ops/bv_render_3d.c | bv_render_3d.c
RUN | /usr/bin/grep | -q | -F | bv_minimap_tile_avg | bv_render_3d.c
EXPECT_EXIT | 0 | the-corner-map-asks-for-the-tile-colour
RUN | /usr/bin/grep | -q | -F | s_mm_has[wl ? wl : fl] | bv_render_3d.c
EXPECT_EXIT | 0 | the-tile-colour-is-used-before-the-flat-fallback
# the click's HUD-only repaint must size the corner map by the painted page, like the full frame (2026-11-16: after a click the map turned square and cropped to the page top-left). Source checks prove the wiring; the behaviour was proven by a scratch-session before/after run (CENTROID-TEST-AND-LIVE).
RUN | /usr/bin/grep | -q | -F | bv_mm_page_dims(maker_ground) | bv_render_3d.c
EXPECT_EXIT | 0 | the-full-frame-sizes-the-map-by-the-page
RUN | /usr/bin/grep | -q | -F | bv_mm_page_dims(g_mm_maker) | bv_render_3d.c
EXPECT_EXIT | 0 | the-click-repaint-sizes-the-map-by-the-page-too
# world_01/state.txt is rewritten by other processes: every engine reader of map_id/desk_id goes through bv_world_ids (last good copy, a bad read is trusted only after 100 ms), never a bare read_kv_str (2026-11-16, "minimap glitches for 1 frame"). Source checks prove the wiring; the behaviour was proven by a scratch-session run with desk_id blanked for one frame (whole frame byte-identical, CENTROID-TEST-AND-LIVE).
RUN | /usr/bin/grep | -q | -F | static void bv_world_ids | bv_render_3d.c
EXPECT_EXIT | 0 | the-hardened-reader-exists
RUN | /usr/bin/grep | -q | -F | bv_world_ids(wpath, map_id, sizeof(map_id), desk_id, sizeof(desk_id)) | bv_render_3d.c
EXPECT_EXIT | 0 | the-maker-loader-uses-it
RUN | /usr/bin/grep | -q | -F | bv_world_ids(world_state_path_sky | bv_render_3d.c
EXPECT_EXIT | 0 | the-sky-reader-uses-it
RUN | /usr/bin/grep | -q | -F | read_kv_str(wpath, "desk_id" | bv_render_3d.c
EXPECT_EXIT | 1 | NEGATIVE-the-maker-loader-has-no-bare-desk_id-read
RUN | /usr/bin/grep | -q | -F | read_kv_str(world_state_path_sky, "desk_id" | bv_render_3d.c
EXPECT_EXIT | 1 | NEGATIVE-the-sky-reader-has-no-bare-desk_id-read
RUN | /usr/bin/grep | -q | -F | read_kv_str(worldp, "desk_id" | bv_render_3d.c
EXPECT_EXIT | 1 | NEGATIVE-the-hud-label-has-no-bare-desk_id-read
# minimap click-to-move (2026-11-17, owner: "when i click on mini map, it moves my cam / xelector there on big map"): the cell under a click on the corner map. Pure maths first (the inverse of how bv_draw_minimap paints), then the wiring in the engine and the menu input.
RUN | $T/minimap_fit_op | cell | 100 | 50 | 100 | 50 | 160 | 116 | 0 | 0 | 0 | 504 | 364 | 504 | 364
EXPECT_OUT | cell 0 0 | the-box-corner-is-page-cell-0-0
RUN | $T/minimap_fit_op | cell | 259 | 165 | 100 | 50 | 160 | 116 | 0 | 0 | 0 | 504 | 364 | 504 | 364
EXPECT_OUT | cell 500 360 | the-far-corner-pixel-is-past-column-255-(the-old-cap)
RUN | $T/minimap_fit_op | cell | 99 | 50 | 100 | 50 | 160 | 116 | 0 | 0 | 0 | 504 | 364 | 504 | 364
EXPECT_OUT | cell none | NEGATIVE-one-pixel-left-of-the-box-is-no-hit
RUN | $T/minimap_fit_op | cell | 100 | 166 | 100 | 50 | 160 | 116 | 0 | 0 | 0 | 504 | 364 | 504 | 364
EXPECT_OUT | cell none | NEGATIVE-one-pixel-below-the-box-is-no-hit
RUN | $T/minimap_fit_op | cell | 200 | 200 | 100 | 100 | 128 | 128 | 8 | 0 | 0 | 16 | 16 | 16 | 16
EXPECT_OUT | cell 12 12 | a-16-desk-at-8-px-per-cell
RUN | $T/minimap_fit_op | cell | 100 | 100 | 100 | 100 | 160 | 160 | 8 | -4 | -4 | 24 | 24 | 16 | 16
EXPECT_OUT | cell none | NEGATIVE-the-margin-is-outside-the-page
RUN | $T/minimap_fit_op | cell | 140 | 140 | 100 | 100 | 160 | 160 | 8 | -4 | -4 | 24 | 24 | 16 | 16
EXPECT_OUT | cell 1 1 | inside-the-margin-window-the-cell-is-offset
RUN | $T/minimap_fit_op | cell | 108 | 108 | 100 | 100 | 192 | 192 | 8 | 250 | 100 | 24 | 24 | 504 | 364
EXPECT_OUT | cell 251 101 | a-follow-window-starts-at-its-own-origin
RUN | $T/minimap_fit_op | cell | 180 | 108 | 100 | 100 | 192 | 192 | 8 | 496 | 100 | 24 | 24 | 504 | 364
EXPECT_OUT | cell none | NEGATIVE-a-follow-window-hanging-past-the-page-edge
RUN | /usr/bin/grep | -q | -F | bv_minimap_cell(mpx | bv_render_3d.c
EXPECT_EXIT | 0 | the-ray-click-asks-the-minimap-first
RUN | /usr/bin/grep | -q | -F | g_mm_hit.valid = 1 | bv_render_3d.c
EXPECT_EXIT | 0 | the-drawn-box-is-recorded-for-the-click
RUN | /usr/bin/grep | -q | -F | hx >= lim_x | bv_render_3d.c
EXPECT_EXIT | 0 | the-xelector-limit-is-the-page
RUN | /usr/bin/grep | -q | -F | hy >= MAX_BOARD_DIM) return; | bv_render_3d.c
EXPECT_EXIT | 1 | NEGATIVE-the-silent-256-cap-is-gone
COPY | &.widgits/board-viewer/ops/bv_menu_input.c | bv_menu_input.c
RUN | /usr/bin/grep | -c | -F | bv_page_lims(focused_project_root | bv_menu_input.c
EXPECT_OUT | 2 | both-arrow-paths-use-the-page-size
# possession and the free camera on a corner-map click (2026-11-17; owner: "depends on desired game mode, keep flexible"; free camera modes also recentre). Behaviour was proven in a scratch session (ignore keeps possession, release lets go and moves, a de_possessible piece cannot be released, mode 3 moves its base); here the wiring.
COPY | &.widgits/board-viewer/ops/bv_piece_flag.h | bv_piece_flag.h
RUN | /usr/bin/grep | -q | -F | minimap_click_possessed | bv_render_3d.c
EXPECT_EXIT | 0 | the-possession-policy-is-a-page-setting
RUN | /usr/bin/grep | -q | -F | piece_pdl_flag(focus, poss, "de_possessible", 0) | bv_render_3d.c
EXPECT_EXIT | 0 | release-honours-the-de_possessible-lock
RUN | /usr/bin/grep | -q | -F | if (poss[0] && strcmp(poss, "none") != 0) return; | bv_render_3d.c
EXPECT_EXIT | 1 | NEGATIVE-possession-no-longer-blocks-every-click-unconditionally
RUN | /usr/bin/grep | -q | -F | bv_set_kv_int(sp, "cam_base_x", hx) | bv_render_3d.c
EXPECT_EXIT | 0 | mode-3-moves-its-base-on-a-minimap-click
RUN | /usr/bin/grep | -c | -F | bv_piece_flag.h | bv_render_3d.c
EXPECT_OUT | 1 | the-engine-includes-the-shared-flag-header
RUN | /usr/bin/grep | -c | -F | bv_piece_flag.h | bv_menu_input.c
EXPECT_OUT | 1 | the-menu-input-includes-the-same-header
RUN | /usr/bin/grep | -c | -F | static int piece_pdl_flag( | bv_menu_input.c
EXPECT_OUT | 0 | NEGATIVE-no-private-copy-of-the-flag-reader-is-left
# first frame at the window's own size (2026-11-17, owner: "first frame of the hud started with font 2 big out of frame"): the engine waited for nothing and drew frame 1 from the shared size file of another window. Behaviour proven in a scratch run (no frame without the session size file, then exactly the file's size; the old engine stayed at the foreign size); here the wiring.
RUN | /usr/bin/awk | /bv_wait_session_size\(project_root/ { w = NR } /^    render_one_frame\(\);/ { if (!r) r = NR } END { exit !(w && r && w < r) } | bv_render_3d.c
EXPECT_EXIT | 0 | the-wait-comes-BEFORE-the-first-frame
RUN | /usr/bin/awk | /bv_wait_session_size\(project_root/ { w = NR } /^    render_one_frame\(\);/ { if (!r) r = NR } END { exit !(w && r && r < w) } | bv_render_3d.c
EXPECT_EXIT | 1 | NEGATIVE-a-wait-after-the-first-frame-is-false
RUN | /usr/bin/grep | -q | -F | vsig.sz = -2; vsig.mt = -2; | bv_render_3d.c
EXPECT_EXIT | 0 | the-loop-switches-to-the-session-size-file-when-it-appears
# 2D mode 0 corner-map click (2026-11-17): before this a click on the 2D corner map picked the scene cell lying under the map. Proven in a scratch run (old build never moves; new: top-left 0,0, bottom-right 501,361 on the 504 x 364 page, outside the box nothing, possessed ignored by default, release row honoured, de_possessible kept); here the wiring.
COPY | &.widgits/board-viewer/ops/bv_render_2d.c | bv_render_2d.c
RUN | /usr/bin/grep | -c | -F | p2d_mm_record( | bv_render_2d.c
EXPECT_OUT | 3 | both-2d-corner-maps-record-their-box-plus-the-definition
RUN | /usr/bin/grep | -q | -F | bv_minimap_cell(px, py, g_mm2d.x | bv_render_2d.c
EXPECT_EXIT | 0 | the-2d-click-uses-the-shared-cell-maths
RUN | /usr/bin/grep | -q | -F | piece_pdl_flag(focused_root, poss, "de_possessible", 0) | bv_render_2d.c
EXPECT_EXIT | 0 | the-2d-release-honours-the-lock
RUN | /usr/bin/awk | /if \(mm_in\) \{/ { m = NR } /else if \(scx >= 0 && scy >= 0 && scx < cols/ { f = NR } END { exit !(m && f && m < f) } | bv_render_2d.c
EXPECT_EXIT | 0 | the-minimap-branch-comes-before-the-floor-branch
RUN | /usr/bin/awk | /if \(mm_in\) \{/ { m = NR } /else if \(scx >= 0 && scy >= 0 && scx < cols/ { f = NR } END { exit !(m && f && f < m) } | bv_render_2d.c
EXPECT_EXIT | 1 | NEGATIVE-floor-branch-first-is-false
RUN | /usr/bin/grep | -c | -F | hud_pdl_str(vp, "minimap_click_possessed" | bv_render_3d.c
EXPECT_OUT | 2 | the-3d-setting-is-read-as-a-house-pipe-row-book-then-system
RUN | /usr/bin/grep | -c | -F | read_kv_str(vp, "minimap_click_possessed" | bv_render_3d.c
EXPECT_OUT | 0 | NEGATIVE-no-key-equals-value-reader-for-the-setting-is-left
CLEAN |
