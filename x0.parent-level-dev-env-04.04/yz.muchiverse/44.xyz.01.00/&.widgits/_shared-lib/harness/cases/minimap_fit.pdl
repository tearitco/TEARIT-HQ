# A 504-wide page must not be drawn as a 256 board, and a camera at cell 400 must not sit on the right edge.
RESULTS | ../results/minimap_fit.txt
ENV | LC_ALL | C
CASE | fit
SCRATCH |
RUN | /usr/bin/gcc | -std=gnu11 | -O2 | -o | $T/minimap_fit_op | $HOUSE/&.widgits/board-viewer/ops/minimap_fit_op.c
EXPECT_EXIT | 0 | the-fit-compiles
RUN | $T/minimap_fit_op | box | 16 | 16 | 8 | 160
EXPECT_EXIT | 0 | a-small-desk-still-uses-cells
EXPECT_OUT | box 128 128 8 | a-16-desk-is-128-px
RUN | $T/minimap_fit_op | box | 504 | 364 | 8 | 160
EXPECT_EXIT | 0 | the-live-page-fits
EXPECT_OUT | box 160 115 0 | the-504-page-is-160-px-not-504-and-not-256
RUN | $T/minimap_fit_op | dot | 400 | 0 | 504 | 160 | 0
EXPECT_EXIT | 0 | the-eye-on-the-page
EXPECT_OUT | dot 126 0 | cell-400-is-inside-not-the-right-edge
RUN | $T/minimap_fit_op | dot | 8 | 0 | 504 | 160 | 0
EXPECT_OUT | dot 2 0 | cell-8-stays-near-the-left
RUN | $T/minimap_fit_op | dot | 600 | 0 | 504 | 160 | 0
EXPECT_OUT | dot 159 1 | NEGATIVE-only-an-eye-past-the-page-is-clamped
COPY | &.widgits/board-viewer/ops/bv_render_3d.c | bv_render_3d.c
RUN | /usr/bin/grep | -q | -F | bv_minimap_box | bv_render_3d.c
EXPECT_EXIT | 0 | the-renderer-calls-the-fit
RUN | /usr/bin/grep | -q | -F | g_mk.w <= MAX_BOARD_DIM | bv_render_3d.c
EXPECT_EXIT | 1 | NEGATIVE-the-256-gate-is-gone
RUN | $T/minimap_fit_op | box | 504 | 364 | 8 | 200
EXPECT_OUT | box 200 144 0 | mode-0-corner-is-200-px-not-one-pixel-per-cell
COPY | &.widgits/board-viewer/ops/bv_render_2d.c | bv_render_2d.c
RUN | /usr/bin/grep | -q | -F | bv_minimap_box | bv_render_2d.c
EXPECT_EXIT | 0 | mode-0-uses-the-same-fit
RUN | /usr/bin/grep | -q | -F | if (sc < 1.0f) sc = 1.0f | bv_render_2d.c
EXPECT_EXIT | 1 | NEGATIVE-mode-0-no-longer-floors-at-one-pixel-per-cell
RUN | /usr/bin/grep | -q | -F | p2d_cells_minimap | bv_render_2d.c
EXPECT_EXIT | 0 | mode-0-without-map-png-still-draws-the-page
RUN | /usr/bin/grep | -q | -F | p2d_atlas_main | bv_render_2d.c
EXPECT_EXIT | 0 | mode-0-blits-the-rpg-maker-atlas
COPY | &.widgits/board-viewer/ops/bv_menu_input.c | bv_menu_input.c
RUN | /usr/bin/grep | -q | -F | view_2d_style | bv_menu_input.c
EXPECT_EXIT | 0 | backslash-in-2d-still-reaches-the-style-switch
# tile colours (same scratch, same compiled op)
# 2026-11-16 (owner: "why dont i see snow on mini map?" on ark-age and live): a cell paints the average colour of its atlas tile, not three flat colours. Real atlases, real helper.
RUN | $T/minimap_fit_op | tileavg | $HOUSE/@.apps/centroid/centroid-pchq/pieces/system/maps/centroid/ark-age/cells.rgba | 16 | 24 | 6
EXPECT_OUT | tileavg 255 255 255 | ark-age-snow-slot-6-is-white
RUN | $T/minimap_fit_op | tileavg | $HOUSE/@.apps/centroid/centroid-pchq/pieces/system/maps/centroid/ark-age/cells.rgba | 16 | 24 | 1
EXPECT_OUT | tileavg 125 194 60 | grass-slot-1-is-green
EXPECT_OUT_LACKS | 255 255 255 | NEGATIVE-grass-is-not-white
RUN | $T/minimap_fit_op | tileavg | $HOUSE/@.apps/centroid/centroid-pchq/pieces/system/maps/centroid/ark-age/cells.rgba | 16 | 24 | 2
EXPECT_OUT | tileavg 144 94 49 | dirt-slot-2-is-brown
RUN | $T/minimap_fit_op | tileavg | $HOUSE/@.apps/centroid/centroid-pchq/pieces/system/maps/centroid/ark-age/cells.rgba | 16 | 24 | 43
EXPECT_OUT | tileavg none | an-off-atlas-slot-keeps-the-old-flat-colour-(none)
RUN | $T/minimap_fit_op | tileavg | $HOUSE/@.apps/centroid/centroid-pchq/pieces/system/maps/centroid/ark-age/cells.rgba | 16 | 24 | 0
EXPECT_OUT | tileavg none | slot-0-is-no-tile
# NOTE (data, not asserted): live/cells.rgba slot 6 is TAN (235,211,166), the 2026-11-06 rmmv sheet; only ark-age's active sheet has the white snow tile, so the live snow band is sand-coloured on the minimap AND in 3D.
COPY | &.widgits/board-viewer/ops/bv_render_3d.c | bv_render_3d.c
RUN | /usr/bin/grep | -q | -F | bv_minimap_tile_avg | bv_render_3d.c
EXPECT_EXIT | 0 | the-corner-map-asks-for-the-tile-colour
RUN | /usr/bin/grep | -q | -F | s_mm_has[wl ? wl : fl] | bv_render_3d.c
EXPECT_EXIT | 0 | the-tile-colour-is-used-before-the-flat-fallback
CLEAN |
