# needs_clock: SCRATCH house, real folder layout. The trigger is the clock daemon's own command line (`rpg_edit_hq.+x <root>/common_events/common:needs_tick <abs root>`, petslike_core.c event_main). Never touches the live app or the lab book.
# NOT covered: the lc_clock daemon firing the AT row on schedule (shown live for pet_say, not for needs_tick).
RESULTS | ../results/needs_clock.txt
ENV | LC_ALL | C

CASE    | setup
SCRATCH |
MKDIR | house/&.widgits
MKDIR | house/#.NNEST_ASSETS/rmmv-www-img
MKDIR | house/@.apps/rpg-edit-hq/ops/+x
MKDIR | house/@.apps/rpg-edit-hq/state/clock_root/common_events
MKDIR | house/@.apps/rpg-edit-hq/books/lab
MKDIR | house/@.apps/rpg-edit-hq/books/open
RUN | /bin/cp | $HOUSE/@.apps/rpg-edit-hq/ops/+x/rpg_edit_hq.+x | $T/house/@.apps/rpg-edit-hq/ops/+x/rpg_edit_hq.+x
RUN | /bin/cp | $HOUSE/@.apps/rpg-edit-hq/ops/+x/survivor_op.+x | $T/house/@.apps/rpg-edit-hq/ops/+x/survivor_op.+x
RUN | /bin/cp | $HOUSE/@.apps/rpg-edit-hq/ops/+x/item_ledger_op.+x | $T/house/@.apps/rpg-edit-hq/ops/+x/item_ledger_op.+x
RUN | /bin/cp | $HOUSE/@.apps/rpg-edit-hq/books/ledger-lab/needs.pdl | $T/house/@.apps/rpg-edit-hq/books/lab/needs.pdl
RUN | /bin/cp | $HOUSE/@.apps/rpg-edit-hq/books/ledger-lab/needs.pdl | $T/house/@.apps/rpg-edit-hq/books/open/needs.pdl
WRITE | house/@.apps/rpg-edit-hq/books/lab/QUARANTINE | q\n
RUN | /bin/cp | $HOUSE/@.apps/rpg-edit-hq/survivor_clock.pdl | $T/shipped.pdl
EXPECT_HAS | shipped.pdl | ENABLED \p 0 | the-shipped-file-has-the-owner-switch-OFF

CASE    | off-by-default-and-opt-in
RUN | $T/house/@.apps/rpg-edit-hq/ops/+x/rpg_edit_hq.+x | $T/house/@.apps/rpg-edit-hq/state/clock_root/common_events/common:needs_tick | $T/house/@.apps/rpg-edit-hq/state/clock_root
EXPECT_EXIT | 0 | no-config-file-is-not-an-error
EXPECT_NOFILE | house/@.apps/rpg-edit-hq/books/lab/state/needs.txt | NEGATIVE-opt-in-no-survivor_clock.pdl-means-nothing-changes
WRITE | house/@.apps/rpg-edit-hq/survivor_clock.pdl | ENABLED \p 0\nBOOK \p books/lab\nMINUTES \p 60\nACTORS \p hero,scout\n
RUN | $T/house/@.apps/rpg-edit-hq/ops/+x/rpg_edit_hq.+x | $T/house/@.apps/rpg-edit-hq/state/clock_root/common_events/common:needs_tick | $T/house/@.apps/rpg-edit-hq/state/clock_root
EXPECT_EXIT | 0 | the-clock-fires-clean-when-disabled
EXPECT_NOFILE | house/@.apps/rpg-edit-hq/books/lab/state/needs.txt | NEGATIVE-ENABLED-0-the-clock-fires-and-no-need-moves

CASE    | enabled-needs-follow-the-clock
WRITE | house/@.apps/rpg-edit-hq/survivor_clock.pdl | ENABLED \p 1\nBOOK \p books/lab\nMINUTES \p 60\nACTORS \p hero,scout\n
RUN | $T/house/@.apps/rpg-edit-hq/ops/+x/rpg_edit_hq.+x | $T/house/@.apps/rpg-edit-hq/state/clock_root/common_events/common:needs_tick | $T/house/@.apps/rpg-edit-hq/state/clock_root
EXPECT_HAS | house/@.apps/rpg-edit-hq/books/lab/state/needs.txt | hero\p10\p15\p5 | hero-needs-rose-by-60-minutes-of-rates
EXPECT_HAS | house/@.apps/rpg-edit-hq/books/lab/state/needs.txt | scout\p10\p15\p5 | and-scout-too
RUN | $T/house/@.apps/rpg-edit-hq/ops/+x/rpg_edit_hq.+x | $T/house/@.apps/rpg-edit-hq/state/clock_root/common_events/common:needs_tick | $T/house/@.apps/rpg-edit-hq/state/clock_root
EXPECT_HAS | house/@.apps/rpg-edit-hq/books/lab/state/needs.txt | hero\p20\p30\p10 | a-second-firing-adds-another-60-minutes
RUN | /usr/bin/awk | END { print NR } | $T/house/@.apps/rpg-edit-hq/books/lab/state/needs.txt
EXPECT_OUT_IS | 2 | exactly-the-two-listed-actors-have-rows

CASE    | quarantine-and-bad-values
WRITE | house/@.apps/rpg-edit-hq/survivor_clock.pdl | ENABLED \p 1\nBOOK \p books/open\nMINUTES \p 60\nACTORS \p hero\n
RUN | $T/house/@.apps/rpg-edit-hq/ops/+x/rpg_edit_hq.+x | $T/house/@.apps/rpg-edit-hq/state/clock_root/common_events/common:needs_tick | $T/house/@.apps/rpg-edit-hq/state/clock_root
EXPECT_EXIT | 0 | a-book-without-QUARANTINE-does-not-crash-the-clock
EXPECT_NOFILE | house/@.apps/rpg-edit-hq/books/open/state/needs.txt | NEGATIVE-survivor_op-refuses-a-folder-without-QUARANTINE-so-nothing-is-written
WRITE | house/@.apps/rpg-edit-hq/survivor_clock.pdl | ENABLED \p 1\nBOOK \p books/lab\nMINUTES \p 0\nACTORS \p hero\n
RUN | $T/house/@.apps/rpg-edit-hq/ops/+x/rpg_edit_hq.+x | $T/house/@.apps/rpg-edit-hq/state/clock_root/common_events/common:needs_tick | $T/house/@.apps/rpg-edit-hq/state/clock_root
EXPECT_HAS | house/@.apps/rpg-edit-hq/books/lab/state/needs.txt | hero\p20\p30\p10 | MINUTES-0-is-ignored-hero-is-unchanged
WRITE | house/@.apps/rpg-edit-hq/survivor_clock.pdl | ENABLED \p 1\nBOOK \p books/lab\nMINUTES \p 60\nACTORS \p \n
RUN | $T/house/@.apps/rpg-edit-hq/ops/+x/rpg_edit_hq.+x | $T/house/@.apps/rpg-edit-hq/state/clock_root/common_events/common:needs_tick | $T/house/@.apps/rpg-edit-hq/state/clock_root
EXPECT_HAS | house/@.apps/rpg-edit-hq/books/lab/state/needs.txt | hero\p20\p30\p10 | an-empty-actor-list-changes-nothing
CASE    | ten-minute-ticks-lose-nothing
WRITE | house/@.apps/rpg-edit-hq/survivor_clock.pdl | ENABLED \p 1\nBOOK \p books/lab\nMINUTES \p 10\nACTORS \p newbie\n
RUN | $T/house/@.apps/rpg-edit-hq/ops/+x/rpg_edit_hq.+x | $T/house/@.apps/rpg-edit-hq/state/clock_root/common_events/common:needs_tick | $T/house/@.apps/rpg-edit-hq/state/clock_root
RUN | $T/house/@.apps/rpg-edit-hq/ops/+x/rpg_edit_hq.+x | $T/house/@.apps/rpg-edit-hq/state/clock_root/common_events/common:needs_tick | $T/house/@.apps/rpg-edit-hq/state/clock_root
RUN | $T/house/@.apps/rpg-edit-hq/ops/+x/rpg_edit_hq.+x | $T/house/@.apps/rpg-edit-hq/state/clock_root/common_events/common:needs_tick | $T/house/@.apps/rpg-edit-hq/state/clock_root
RUN | $T/house/@.apps/rpg-edit-hq/ops/+x/rpg_edit_hq.+x | $T/house/@.apps/rpg-edit-hq/state/clock_root/common_events/common:needs_tick | $T/house/@.apps/rpg-edit-hq/state/clock_root
RUN | $T/house/@.apps/rpg-edit-hq/ops/+x/rpg_edit_hq.+x | $T/house/@.apps/rpg-edit-hq/state/clock_root/common_events/common:needs_tick | $T/house/@.apps/rpg-edit-hq/state/clock_root
RUN | $T/house/@.apps/rpg-edit-hq/ops/+x/rpg_edit_hq.+x | $T/house/@.apps/rpg-edit-hq/state/clock_root/common_events/common:needs_tick | $T/house/@.apps/rpg-edit-hq/state/clock_root
EXPECT_HAS | house/@.apps/rpg-edit-hq/books/lab/state/needs.txt | newbie\p10\p15\p5 | six-10-minute-firings-equal-one-60-minute-tick-nothing-lost-to-rounding
RUN | $T/house/@.apps/rpg-edit-hq/ops/+x/rpg_edit_hq.+x | $T/house/@.apps/rpg-edit-hq/state/clock_root/common_events/common:needs_tick | $T/house/@.apps/rpg-edit-hq/state/clock_root
EXPECT_HAS | house/@.apps/rpg-edit-hq/books/lab/state/needs.txt | newbie\p11\p17\p5 | the-seventh-firing-adds-one-hunger-and-two-thirst-the-fatigue-remainder-is-still-carried

CLEAN |
