# keyword check (not exact): the pet reacts to words (LEX), and vosk writes "i'm" for "i am"
# whole mic path, one phrase
ENV | LC_CLOCK_BIN | /nonexistent
COPY | &.widgits/_shared-lib/harness/fixtures/pet_stt/fake_rec | bin/rec
ENV | PATH | $T/bin:/usr/bin:/bin
ENV | FAKE_REC_WAV | $T/wav/s0_what.wav
ENV | PET_SHARED | $T/state
RUN | /bin/sh | $HOUSE/@.apps/pet-trainer/ops/pet_event.sh | start
RUN | /bin/sh | $HOUSE/@.apps/pet-trainer/ops/pet_listen.sh
EXPECT_EXIT | 0 | listen-exit-0
EXPECT_HAS | state/stt/last.txt | what is that | listen-text
EXPECT_HAS | state/recording.txt | 0 | listen-recording-off
WAIT_HAS | state/pets/a13/chat.txt | YOU: what is that | 8000 | listen-chat-line
