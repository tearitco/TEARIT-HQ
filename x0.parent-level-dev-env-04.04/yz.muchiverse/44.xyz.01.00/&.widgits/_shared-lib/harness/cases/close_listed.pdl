# close_listed.sh + close_on_restart.pdl (the hotbar/board close-on-restart rule) on a SCRATCH house with throwaway python sleepers; no real window or process is touched.
# A sleeper's command line carries a path argument, which is what the real windows' command lines carry. Replaces $.crypts/test_close_listed.sh.
RESULTS | ../results/close_listed.txt
CASE    | close-listed
SCRATCH |
MKDIR   | house
MKDIR   | other
COPY    | $.crypts/close_listed.sh | crypts/close_listed.sh
COPY    | $.crypts/close_on_restart.pdl | crypts/close_on_restart.pdl

SPAWN | A | python3 | -c | import time; time.sleep(300) | $T/house/@.apps/hotbar-hq/hotbar-desk.xhtpm
SPAWN | B | python3 | -c | import time; time.sleep(300) | $T/house/@.apps/hotbar-hq/ops/+x/hotbar_manager.+x
SPAWN | C | python3 | -c | import time; time.sleep(300) | $T/other/@.apps/hotbar-hq/hotbar-desk.xhtpm
SPAWN | D | python3 | -c | import time; time.sleep(300) | $T/house/@.apps/something-else/window.xhtpm
SLEEP | 500

# A,B listed and inside the house -> close; C is a listed substring but ANOTHER house -> survive; D is inside the house but NOT listed -> survive
RUN | sh | $T/crypts/close_listed.sh | $T/house | --dry-run
EXPECT_OUT        | TERM $A ( | dry-run-lists-A
EXPECT_OUT        | TERM $B ( | dry-run-lists-B
EXPECT_OUT_LACKS  | TERM $C ( | dry-run-does-not-list-another-house
EXPECT_OUT_LACKS  | TERM $D ( | dry-run-does-not-list-an-unlisted-process
EXPECT_ALIVE | $A | dry-run-kills-nothing-A
EXPECT_ALIVE | $B | dry-run-kills-nothing-B
RUN | sh | $T/crypts/close_listed.sh | $T/house
SLEEP | 1500
EXPECT_DEAD  | $A | listed-window-closed
EXPECT_DEAD  | $B | listed-manager-closed
EXPECT_ALIVE | $C | other-house-untouched
EXPECT_ALIVE | $D | unlisted-process-untouched

# the caller must survive even if its own command line matches: run the closer from a shell whose command line holds a listed substring
RUN | sh | -c | sh "$0" "$1" >/dev/null 2>&1; echo alive | $T/crypts/close_listed.sh | $T/house/@.apps/hotbar-hq/hotbar-desk.xhtpm
EXPECT_OUT | alive | caller-survives-its-own-match
RUN | sh | $T/crypts/close_listed.sh | /nonexistent
EXPECT_EXIT | 0 | bad-house-is-harmless

# --relaunch (the taskbar $.restart): a row that was running is relaunched, one that was not is left alone, a dry run relaunches nothing
WRITE | list.pdl | CLOSE \p rl-running \p $T/house/@.apps/relaunch-me/win.xhtpm \p touch "$T/relaunched-running"\nCLOSE \p rl-notrunning \p $T/house/@.apps/not-running/win.xhtpm \p touch "$T/relaunched-notrunning"\nCLOSE \p rl-nocmd \p $T/house/@.apps/no-command/win.xhtpm\n
SPAWN | E | python3 | -c | import time; time.sleep(300) | $T/house/@.apps/relaunch-me/win.xhtpm
SPAWN | F | python3 | -c | import time; time.sleep(300) | $T/house/@.apps/no-command/win.xhtpm
SLEEP | 400
ENV | CLOSE_LIST | $T/list.pdl
RUN | sh | $T/crypts/close_listed.sh | $T/house | --dry-run | --relaunch
SLEEP | 500
EXPECT_NOFILE | relaunched-running | dry-run-relaunches-nothing
EXPECT_ALIVE  | $E | dry-run-kills-nothing-E
RUN | sh | $T/crypts/close_listed.sh | $T/house | --relaunch
SLEEP | 2000
EXPECT_DEAD   | $E | relaunch-run-closes-E
EXPECT_DEAD   | $F | relaunch-run-closes-F
EXPECT_EXISTS | relaunched-running | running-row-is-relaunched
EXPECT_NOFILE | relaunched-notrunning | not-running-row-is-not-resurrected
RUN | rm | -f | $T/relaunched-running
RUN | sh | $T/crypts/close_listed.sh | $T/house
EXPECT_NOFILE | relaunched-running | no-relaunch-without-the-flag
CLEAN |
