# plug_loader (2026-11-14, D78): `harness_menu_op load <house> <book>` = the ON plugs of a book in load order (a plug after every ON plug it REQUIRES), a CYCLE or a COLLISION (two ON plugs declaring the same COMMAND, or installing a
# clock reminder at the same hour) reported and exit 2; plugs that are OFF are not examined; the projection <app>/state/plugs_active.txt is regenerated byte for byte (no ghost data). And `pick plug:<name>` REFUSES to switch a plug ON when the
# loader finds a problem that names it (nothing changes, no log row), while switching OFF and a clean switch ON still work. SCRATCH house, the REAL op; one book per scenario; every refusal has a passing CONTROL.
RESULTS | ../results/plug_loader.txt
ENV | LC_ALL | C

CASE    | setup
SCRATCH |
MKDIR | h/&.widgits/_shared-lib/ops/+x
MKDIR | h/#.desktop
RUN | /bin/cp | $HOUSE/&.widgits/_shared-lib/ops/+x/harness_menu_op.+x | $T/h/&.widgits/_shared-lib/ops/+x/harness_menu_op.+x

CASE    | load-order-and-the-projection
MKDIR | h/@.apps/o1/plugs
WRITE   | h/@.apps/o1/plugs/aaa.plug.pdl | PLUG \p name \p aaa\nPLUG \p version \p 2\nENABLED \p 1\nAFFECTS \p view\nREQUIRES \p zzz\n
WRITE   | h/@.apps/o1/plugs/zzz.plug.pdl | PLUG \p name \p zzz\nENABLED \p 1\n
WRITE   | h/@.apps/o1/plugs/mid.plug.pdl | PLUG \p name \p mid\nENABLED \p 0\nPARAM \p bad \p x \p int\n
RUN | $T/h/&.widgits/_shared-lib/ops/+x/harness_menu_op.+x | load | $T/h | o1
EXPECT_EXIT | 0 | a-clean-book-loads
EXPECT_OUT | LOAD active=2 problems=0 | two-plugs-are-on-the-off-one-with-a-bad-row-is-not-examined
EXPECT_HAS | h/@.apps/o1/state/plugs_active.txt | ORDER \p 1 \p zzz | the-required-plug-loads-first-although-its-name-sorts-last
EXPECT_HAS | h/@.apps/o1/state/plugs_active.txt | ORDER \p 2 \p aaa \p 2 \p view | then-the-plug-that-requires-it-with-its-version-and-affects
EXPECT_LACKS | h/@.apps/o1/state/plugs_active.txt | mid | NEGATIVE-an-off-plug-is-not-in-the-load-order
RUN | /bin/cp | $T/h/@.apps/o1/state/plugs_active.txt | $T/first.txt
RUN | /bin/rm | -f | $T/h/@.apps/o1/state/plugs_active.txt
RUN | $T/h/&.widgits/_shared-lib/ops/+x/harness_menu_op.+x | load | $T/h | o1
RUN | /usr/bin/cmp | $T/first.txt | $T/h/@.apps/o1/state/plugs_active.txt
EXPECT_EXIT | 0 | the-deleted-projection-is-regenerated-byte-for-byte

CASE    | cycles-and-collisions
MKDIR | h/@.apps/y1/plugs
WRITE   | h/@.apps/y1/plugs/a.plug.pdl | PLUG \p name \p a\nENABLED \p 1\nREQUIRES \p b\n
WRITE   | h/@.apps/y1/plugs/b.plug.pdl | PLUG \p name \p b\nENABLED \p 1\nREQUIRES \p a\n
RUN | $T/h/&.widgits/_shared-lib/ops/+x/harness_menu_op.+x | load | $T/h | y1
EXPECT_EXIT | 2 | NEGATIVE-two-plugs-that-require-each-other-cannot-load
EXPECT_OUT | CYCLE: plugs that require each other cannot load: a, b | and-the-cycle-is-named
MKDIR | h/@.apps/y2/plugs
WRITE   | h/@.apps/y2/plugs/a.plug.pdl | PLUG \p name \p a\nENABLED \p 1\nCOMMAND \p go \p some_verb\n
WRITE   | h/@.apps/y2/plugs/b.plug.pdl | PLUG \p name \p b\nENABLED \p 1\nCOMMAND \p go \p other_verb\n
RUN | $T/h/&.widgits/_shared-lib/ops/+x/harness_menu_op.+x | load | $T/h | y2
EXPECT_OUT | COLLISION: COMMAND go is declared by both a and b | NEGATIVE-the-same-command-name-in-two-on-plugs-collides
WRITE   | h/@.apps/y2/plugs/b.plug.pdl | PLUG \p name \p b\nENABLED \p 0\nCOMMAND \p go \p other_verb\n
RUN | $T/h/&.widgits/_shared-lib/ops/+x/harness_menu_op.+x | load | $T/h | y2
EXPECT_EXIT | 0 | CONTROL-with-the-other-one-off-it-loads
MKDIR | h/@.apps/y3/plugs
WRITE   | h/@.apps/y3/plugs/a.plug.pdl | PLUG \p name \p a\nENABLED \p 1\nPHASE \p dawn \p 6 \p 1,1,1 \p 1,1,1 \p Sky\n
WRITE   | h/@.apps/y3/plugs/b.plug.pdl | PLUG \p name \p b\nENABLED \p 1\nPHASE \p early \p 6 \p 1,1,1 \p 1,1,1 \p Sky\n
RUN | $T/h/&.widgits/_shared-lib/ops/+x/harness_menu_op.+x | load | $T/h | y3
EXPECT_OUT | COLLISION: a and b both install a clock reminder at hour 6 | NEGATIVE-two-plugs-with-a-reminder-at-the-same-hour-collide
WRITE   | h/@.apps/y3/plugs/b.plug.pdl | PLUG \p name \p b\nENABLED \p 1\nPHASE \p early \p 7 \p 1,1,1 \p 1,1,1 \p Sky\n
RUN | $T/h/&.widgits/_shared-lib/ops/+x/harness_menu_op.+x | load | $T/h | y3
EXPECT_EXIT | 0 | CONTROL-at-different-hours-it-loads
MKDIR | h/@.apps/y4/plugs
WRITE   | h/@.apps/y4/plugs/a.plug.pdl | PLUG \p name \p a\nENABLED \p 1\nCOMMAND \p go \p v\nCOMMAND \p go \p w\nCOMMAND \p bad-name! \p v\n
RUN | $T/h/&.widgits/_shared-lib/ops/+x/harness_menu_op.+x | load | $T/h | y4
EXPECT_OUT | COMMAND go: declared twice | NEGATIVE-a-command-declared-twice-in-one-plug-is-a-problem
EXPECT_OUT | COMMAND needs name | and-a-bad-command-name

CASE    | switching-on-is-refused-when-it-would-collide
MKDIR | h/@.apps/s1/plugs
WRITE   | h/@.apps/s1/plugs/aa.plug.pdl | PLUG \p name \p aa\nENABLED \p 0\nCONFLICTS \p bb\n
WRITE   | h/@.apps/s1/plugs/bb.plug.pdl | PLUG \p name \p bb\nENABLED \p 1\n
WRITE   | h/@.apps/s1/plugs/cc.plug.pdl | PLUG \p name \p cc\nENABLED \p 0\nREQUIRES \p dd\n
WRITE   | h/@.apps/s1/plugs/dd.plug.pdl | PLUG \p name \p dd\nENABLED \p 0\n
WRITE   | h/@.apps/s1/plugs/ee.plug.pdl | PLUG \p name \p ee\nENABLED \p 0\n
RUN | $T/h/&.widgits/_shared-lib/ops/+x/harness_menu_op.+x | pick | $T/h | s1 | start | plug:aa
EXPECT_EXIT | 1 | NEGATIVE-aa-conflicts-with-bb-which-is-on-so-it-is-refused
EXPECT_OUT | REFUSED plug aa: plug aa: is ON and CONFLICTS with bb which is also ON | with-the-reason
EXPECT_HAS | h/@.apps/s1/plugs/aa.plug.pdl | ENABLED \p 0 | and-the-file-is-unchanged
RUN | /usr/bin/test | -e | $T/h/@.apps/s1/state/plug_log.txt
EXPECT_EXIT | 1 | and-no-log-row-was-written
RUN | $T/h/&.widgits/_shared-lib/ops/+x/harness_menu_op.+x | pick | $T/h | s1 | start | plug:cc
EXPECT_EXIT | 1 | NEGATIVE-cc-requires-dd-which-is-off-so-it-is-refused
EXPECT_OUT | REQUIRES dd which is OFF | with-the-reason
RUN | $T/h/&.widgits/_shared-lib/ops/+x/harness_menu_op.+x | pick | $T/h | s1 | start | plug:ee
EXPECT_EXIT | 0 | CONTROL-a-clean-switch-on-works
EXPECT_HAS | h/@.apps/s1/plugs/ee.plug.pdl | ENABLED \p 1 | and-the-file-changed
RUN | $T/h/&.widgits/_shared-lib/ops/+x/harness_menu_op.+x | pick | $T/h | s1 | start | plug:bb
EXPECT_EXIT | 0 | switching-off-is-always-allowed
EXPECT_HAS | h/@.apps/s1/plugs/bb.plug.pdl | ENABLED \p 0 | and-it-is-off
RUN | $T/h/&.widgits/_shared-lib/ops/+x/harness_menu_op.+x | pick | $T/h | s1 | start | plug:aa
EXPECT_EXIT | 0 | CONTROL-with-bb-off-aa-switches-on

CASE    | the-real-books-load-clean
RUN | $HOUSE/&.widgits/_shared-lib/ops/+x/harness_menu_op.+x | load | $HOUSE | rpg-edit-hq
EXPECT_EXIT | 0 | CONTROL-the-shipped-day-night-loads
RUN | $HOUSE/&.widgits/_shared-lib/ops/+x/harness_menu_op.+x | load | $HOUSE | nonesuchbook
EXPECT_EXIT | 0 | a-book-with-no-plugs-loads-nothing
EXPECT_OUT | LOAD active=0 problems=0 | with-zero-active

CASE    | cleanup
CLEAN |
