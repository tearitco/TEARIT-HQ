# generator_restyle: the restyle verb recolours sliced RPG Maker cells (D27) without touching the shape. Real cells from palettes/sprites/rmmv.
RESULTS | ../results/generator_restyle.txt
ENV | LC_ALL | C

CASE    | restyle
SCRATCH |
COPY | @.apps/generator-hq/events/gen_restyle/tearit-green.pdl | green.pdl
COPY | @.apps/generator-hq/events/gen_restyle/tearit-stone.pdl | stone.pdl
RUN | $HOUSE/@.apps/generator-hq/ops/+x/generator_tile_op.+x | restyle | $T/green.pdl | $T/a | $HOUSE/&.widgits/palettes/sprites/rmmv/Outside_a2/001/sprite.csv | $HOUSE/&.widgits/palettes/sprites/rmmv/Outside_b/165/sprite.csv
EXPECT_EXIT | 0 | two-cells-restyled
EXPECT_OUT | RESTYLE Outside_a2_001 48x48 opaque=2304 changed=2304 outline=0 | a-ground-tile-has-no-outline-so-tiles-still-meet
EXPECT_OUT | RESTYLE Outside_b_165 48x48 opaque=1773 changed=1773 outline=120 | the-boulder-gets-an-outline-on-its-transparent-edge
EXPECT_FILE | a/Outside_b_165/sprite.csv | boulder-csv
EXPECT_FILE | a/Outside_b_165/tile.png | boulder-png
RUN | /usr/bin/cmp | -s | $T/a/Outside_b_165/sprite.csv | $HOUSE/&.widgits/palettes/sprites/rmmv/Outside_b/165/sprite.csv
EXPECT_EXIT | 1 | NEGATIVE-restyled-is-not-the-original
RUN | /usr/bin/awk | -F, | NR==FNR{a[FNR]=$4;next} a[FNR]!=$4{b++} END{exit b>0} | $HOUSE/&.widgits/palettes/sprites/rmmv/Outside_b/165/sprite.csv | $T/a/Outside_b_165/sprite.csv
EXPECT_EXIT | 0 | alpha-is-identical-pixel-for-pixel
RUN | /usr/bin/awk | -F, | NR==FNR{a[FNR]=$4;next} a[FNR]!=$4{b++} END{exit b>0} | $HOUSE/&.widgits/palettes/sprites/rmmv/Outside_b/100/sprite.csv | $T/a/Outside_b_165/sprite.csv
EXPECT_EXIT | 1 | NEGATIVE-the-alpha-check-can-fail-on-a-different-shape
RUN | $HOUSE/@.apps/generator-hq/ops/+x/generator_tile_op.+x | restyle | $T/green.pdl | $T/b | $HOUSE/&.widgits/palettes/sprites/rmmv/Outside_b/165/sprite.csv
RUN | /usr/bin/cmp | -s | $T/a/Outside_b_165/sprite.csv | $T/b/Outside_b_165/sprite.csv
EXPECT_EXIT | 0 | same-style-same-bytes
RUN | $HOUSE/@.apps/generator-hq/ops/+x/generator_tile_op.+x | restyle | $T/stone.pdl | $T/c | $HOUSE/&.widgits/palettes/sprites/rmmv/Outside_b/165/sprite.csv
RUN | /usr/bin/cmp | -s | $T/a/Outside_b_165/sprite.csv | $T/c/Outside_b_165/sprite.csv
EXPECT_EXIT | 1 | NEGATIVE-another-style-gives-other-bytes
WRITE | bad.pdl | GEN \p ramp \p #123456\nGEN \p accent_per256 \p 0\n
RUN | $HOUSE/@.apps/generator-hq/ops/+x/generator_tile_op.+x | restyle | $T/bad.pdl | $T/d | $HOUSE/&.widgits/palettes/sprites/rmmv/Outside_a2/001/sprite.csv
EXPECT_EXIT | 3 | NEGATIVE-a-one-colour-ramp-is-refused
RUN | $HOUSE/@.apps/generator-hq/ops/+x/generator_tile_op.+x | restyle | $T/green.pdl | $T/e | $T/no-such-cell.csv
EXPECT_EXIT | 2 | NEGATIVE-a-missing-cell-is-refused
RUN | $HOUSE/@.apps/generator-hq/ops/+x/generator_tile_op.+x | restyle | $T/green.pdl | $T/f | $HOUSE/&.widgits/palettes/sprites/rmmv/Outside_b/001/sprite.csv
EXPECT_EXIT | 0 | a-blank-cell-is-skipped-not-an-error

# A whole RPG Maker sheet in #.NNEST_ASSETS gives real 96x144 blocks; the same 48-shape table runs on real pixels.
CASE    | real-block
SCRATCH |
COPY | @.apps/generator-hq/events/gen_restyle/tearit-sand.pdl | sand.pdl
RUN | $HOUSE/@.apps/generator-hq/ops/+x/generator_tile_op.+x | shapes | $T/s | $HOUSE/../../../#.NNEST_ASSETS/rmmv-www-img/tilesets/Outside_A2.png | 1
EXPECT_EXIT | 0 | real-block-shapes-written
EXPECT_OUT | SHAPES floor=48 block=Outside_A2.png#1 | the-line-names-the-real-block
EXPECT_OUT | quad=ok | every-quadrant-matches-the-source-block
RUN | $HOUSE/@.apps/generator-hq/ops/+x/generator_tile_op.+x | shapes | $T/p | $HOUSE/../../../#.NNEST_ASSETS/rmmv-www-img/tilesets/Outside_A2.png | 99
EXPECT_EXIT | 2 | NEGATIVE-a-block-outside-the-sheet-is-refused
RUN | $HOUSE/@.apps/generator-hq/ops/+x/generator_tile_op.+x | shapes | $T/q | $T/no-such-sheet.png | 0
EXPECT_EXIT | 2 | NEGATIVE-a-missing-sheet-is-refused
RUN | $HOUSE/@.apps/generator-hq/ops/+x/generator_tile_op.+x | shapes | $T/s0 | $HOUSE/../../../#.NNEST_ASSETS/rmmv-www-img/tilesets/Outside_A2.png | 0
RUN | /usr/bin/cmp | -s | $T/s/s20/sprite.csv | $T/s0/s20/sprite.csv
EXPECT_EXIT | 1 | NEGATIVE-two-different-blocks-give-different-shapes
RUN | $HOUSE/@.apps/generator-hq/ops/+x/generator_tile_op.+x | restyle | $T/sand.pdl | $T/r | $T/s/s20/sprite.csv | $T/s/s21/sprite.csv | $T/s/s22/sprite.csv | $T/s/s23/sprite.csv
EXPECT_EXIT | 0 | real-edge-shapes-restyle
RUN | $HOUSE/@.apps/generator-hq/ops/+x/generator_tile_op.+x | contact | $T/c.png | 2 | $T/r/s_s20/sprite.csv | $T/r/s_s21/sprite.csv | $T/r/s_s22/sprite.csv | $T/r/s_s23/sprite.csv
EXPECT_EXIT | 0 | contact-sheet-written
EXPECT_OUT | CONTACT | the-contact-line
EXPECT_OUT | cells=4 cols=2 size=96x96 | four-cells-in-two-columns
RUN | $HOUSE/@.apps/generator-hq/ops/+x/generator_tile_op.+x | contact | $T/d.png | 2 | $T/r/s_s20/sprite.csv | $T/no-such-cell.csv
EXPECT_EXIT | 2 | NEGATIVE-a-missing-cell-stops-the-contact-sheet

# One command restyles every block the map lists (blocks.pdl), in memory: no original pixel is written.
CASE    | sheet
SCRATCH |
COPY | @.apps/generator-hq/events/gen_restyle/blocks.pdl | blocks.pdl
COPY | @.apps/generator-hq/events/gen_restyle/tearit-green.pdl | tearit-green.pdl
COPY | @.apps/generator-hq/events/gen_restyle/tearit-sand.pdl | tearit-sand.pdl
COPY | @.apps/generator-hq/events/gen_restyle/tearit-stone.pdl | tearit-stone.pdl
RUN | $HOUSE/@.apps/generator-hq/ops/+x/generator_tile_op.+x | sheet | $T/blocks.pdl | $HOUSE/../../../#.NNEST_ASSETS/rmmv-www-img/tilesets/Outside_A2.png | $T/o
EXPECT_EXIT | 0 | whole-sheet-restyled
EXPECT_OUT | SHEET Outside_A2 blocks=32 shapes=1536 rc=0 | thirty-two-blocks-of-48-shapes
EXPECT_FILE | o/tearit-sand/Outside_A2_b01_s20/sprite.csv | sand-block-lands-in-the-sand-style
EXPECT_FILE | o/tearit-stone/Outside_A2_b10_s47/sprite.csv | stone-block-lands-in-the-stone-style
EXPECT_FILE | o/tearit-green/Outside_A2_b20_s00/sprite.csv | green-block-lands-in-the-green-style
RUN | $HOUSE/@.apps/generator-hq/ops/+x/generator_tile_op.+x | shapes | $T/raw | $HOUSE/../../../#.NNEST_ASSETS/rmmv-www-img/tilesets/Outside_A2.png | 1
RUN | /usr/bin/cmp | -s | $T/raw/s20/sprite.csv | $T/o/tearit-sand/Outside_A2_b01_s20/sprite.csv
EXPECT_EXIT | 1 | NEGATIVE-the-written-shape-is-not-the-original-pixels
RUN | /usr/bin/awk | -F, | NR==FNR{a[FNR]=$4;next} a[FNR]!=$4{b++} END{exit b>0} | $T/raw/s20/sprite.csv | $T/o/tearit-sand/Outside_A2_b01_s20/sprite.csv
EXPECT_EXIT | 0 | alpha-identical-in-the-whole-sheet-path
RUN | $HOUSE/@.apps/generator-hq/ops/+x/generator_tile_op.+x | sheet | $T/blocks.pdl | $HOUSE/../../../#.NNEST_ASSETS/rmmv-www-img/tilesets/Outside_B.png | $T/p
EXPECT_EXIT | 3 | NEGATIVE-a-sheet-with-no-map-row-is-refused
WRITE | badmap.pdl | BLOCK \p Outside_A2 \p 0 \p no-such-style\n
RUN | $HOUSE/@.apps/generator-hq/ops/+x/generator_tile_op.+x | sheet | $T/badmap.pdl | $HOUSE/../../../#.NNEST_ASSETS/rmmv-www-img/tilesets/Outside_A2.png | $T/q
EXPECT_EXIT | 3 | NEGATIVE-a-missing-style-file-is-refused
WRITE | farmap.pdl | BLOCK \p Outside_A2 \p 99 \p tearit-green\n
COPY | @.apps/generator-hq/events/gen_restyle/tearit-green.pdl | tearit-green.pdl
RUN | $HOUSE/@.apps/generator-hq/ops/+x/generator_tile_op.+x | sheet | $T/farmap.pdl | $HOUSE/../../../#.NNEST_ASSETS/rmmv-www-img/tilesets/Outside_A2.png | $T/r
EXPECT_EXIT | 2 | NEGATIVE-a-block-outside-the-sheet-is-refused

# Seams: shapes cut from one block must map one source colour to one output colour, or neighbouring tiles will not meet.
CASE    | seams
SCRATCH |
WRITE | seam.pdl | GEN \p ramp \p #000000,#404040,#808080,#c0c0c0,#ffffff\nGEN \p accent_per256 \p 0\nGEN \p outline \p 0\n
WRITE | map.pdl | BLOCK \p Outside_A2 \p 1 \p seam\n
RUN | $HOUSE/@.apps/generator-hq/ops/+x/generator_tile_op.+x | sheet | $T/map.pdl | $HOUSE/../../../#.NNEST_ASSETS/rmmv-www-img/tilesets/Outside_A2.png | $T/o
EXPECT_EXIT | 0 | seam-style-block-written
RUN | $HOUSE/@.apps/generator-hq/ops/+x/generator_tile_op.+x | shapes | $T/raw | $HOUSE/../../../#.NNEST_ASSETS/rmmv-www-img/tilesets/Outside_A2.png | 1
RUN | /usr/bin/awk | -F, | FNR==1{fi++} fi<=6{raw[fi,FNR]=$1","$2","$3; next} {k=fi-6; m=raw[k,FNR]; o=$1","$2","$3; if((m in map)&&map[m]!=o)bad++; map[m]=o} END{exit bad>0} | $T/raw/s00/sprite.csv | $T/raw/s05/sprite.csv | $T/raw/s20/sprite.csv | $T/raw/s30/sprite.csv | $T/raw/s40/sprite.csv | $T/raw/s47/sprite.csv | $T/o/seam/Outside_A2_b01_s00/sprite.csv | $T/o/seam/Outside_A2_b01_s05/sprite.csv | $T/o/seam/Outside_A2_b01_s20/sprite.csv | $T/o/seam/Outside_A2_b01_s30/sprite.csv | $T/o/seam/Outside_A2_b01_s40/sprite.csv | $T/o/seam/Outside_A2_b01_s47/sprite.csv
EXPECT_EXIT | 0 | same-source-colour-gives-same-output-colour-across-shapes
RUN | $HOUSE/@.apps/generator-hq/ops/+x/generator_tile_op.+x | restyle | $T/seam.pdl | $T/old | $T/raw/s00/sprite.csv | $T/raw/s05/sprite.csv | $T/raw/s20/sprite.csv | $T/raw/s30/sprite.csv | $T/raw/s40/sprite.csv | $T/raw/s47/sprite.csv
RUN | /usr/bin/awk | -F, | FNR==1{fi++} fi<=6{raw[fi,FNR]=$1","$2","$3; next} {k=fi-6; m=raw[k,FNR]; o=$1","$2","$3; if((m in map)&&map[m]!=o)bad++; map[m]=o} END{exit bad>0} | $T/raw/s00/sprite.csv | $T/raw/s05/sprite.csv | $T/raw/s20/sprite.csv | $T/raw/s30/sprite.csv | $T/raw/s40/sprite.csv | $T/raw/s47/sprite.csv | $T/old/raw_s00/sprite.csv | $T/old/raw_s05/sprite.csv | $T/old/raw_s20/sprite.csv | $T/old/raw_s30/sprite.csv | $T/old/raw_s40/sprite.csv | $T/old/raw_s47/sprite.csv
EXPECT_EXIT | 1 | NEGATIVE-per-cell-normalising-breaks-the-seam-check
