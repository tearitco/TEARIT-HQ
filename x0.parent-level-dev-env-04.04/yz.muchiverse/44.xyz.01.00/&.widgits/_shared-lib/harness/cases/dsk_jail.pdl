EXPECT_OUT | phase=pre current=p1 round=49 pending=-1 debt=0 doubles=2 | owed-a-third-roll-with-doubles-2-recorded

CASE    | debt
SCRATCH |
COPYDIR | @.apps/deskopoly | app | ops,deskopoly-pchq,state
COPYDIR | @.apps/deskopoly/rulesets/classic | app/rulesets/tiny
RUN | /usr/bin/sed | -i | s/start_cash    \p 1500/start_cash    \p 70/ | $T/app/rulesets/tiny/rules.pdl
RUN | /usr/bin/sed | -i | s/pass_go       \p 200/pass_go       \p 0/ | $T/app/rulesets/tiny/rules.pdl
RUN | /usr/bin/sed | -i | s/\p LevyA    \p tax      \p -1 \p 200/\p LevyA    \p tax      \p -1 \p 1  / | $T/app/rulesets/tiny/board.pdl
RUN | /usr/bin/sed | -i | s/\p LevyB    \p tax      \p -1 \p 100/\p LevyB    \p tax      \p -1 \p 1  / | $T/app/rulesets/tiny/board.pdl
MKDIR   | m
MKDIR   | p
RUN | $HOUSE/@.apps/deskopoly/ops/+x/deskopoly.+x | $T/app | $T/m | lobby | tiny
RUN | $HOUSE/@.apps/deskopoly/ops/+x/deskopoly.+x | $T/app | $T/m | join | A | pet
RUN | $HOUSE/@.apps/deskopoly/ops/+x/deskopoly.+x | $T/app | $T/m | join | B | pet
RUN | $HOUSE/@.apps/deskopoly/ops/+x/deskopoly.+x | $T/app | $T/m | start | 25
RUN | $HOUSE/@.apps/deskopoly/ops/+x/deskopoly.+x | $T/app | $T/m | autoplay
EXPECT_OUT | AUTOPLAY events=108 rounds=16 over=1 winner=p1 | the-tiny-seed-25-game-ends-in-a-bankruptcy-after-a-card-debt
RUN | /usr/bin/cp | $T/m/ledger.txt | $T/p/ledger.txt
RUN | /usr/bin/sed | -i | 107,$d | $T/p/ledger.txt
RUN | $HOUSE/@.apps/deskopoly/ops/+x/deskopoly.+x | $T/app | $T/p | status
EXPECT_OUT | phase=debt current=p2 round=15 pending=-1 debt=50 doubles=1 | a-pay-every-player-card-the-player-cannot-cover-opens-a-debt-to-the-first-other-player
RUN | $HOUSE/@.apps/deskopoly/ops/+x/deskopoly.+x | $T/app | $T/p | roll
EXPECT_EXIT | 2 | NEGATIVE-no-roll-while-in-debt-even-with-a-double-owed
RUN | $HOUSE/@.apps/deskopoly/ops/+x/deskopoly.+x | $T/app | $T/p | end_turn
EXPECT_EXIT | 2 | NEGATIVE-no-end-turn-while-in-debt
RUN | $HOUSE/@.apps/deskopoly/ops/+x/deskopoly.+x | $T/app | $T/p | bankrupt
EXPECT_OUT | out;cash=10;props=1;cards=0 | bankrupt-to-the-creditor-hands-over-cash-and-the-tile
EXPECT_OUT | over: winner=p1 | and-the-game-ends-with-the-over-row
RUN | $HOUSE/@.apps/deskopoly/ops/+x/deskopoly.+x | $T/app | $T/p | bankrupt
EXPECT_EXIT | 2 | NEGATIVE-bankrupt-twice-is-refused

