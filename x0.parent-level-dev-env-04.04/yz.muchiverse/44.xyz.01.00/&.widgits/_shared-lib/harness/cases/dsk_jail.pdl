CASE    | tamper
SCRATCH |
COPYDIR | @.apps/deskopoly | app | ops,deskopoly-pchq,state
MKDIR   | m
RUN | $HOUSE/@.apps/deskopoly/ops/+x/deskopoly.+x | $T/app | $T/m | lobby | classic
RUN | $HOUSE/@.apps/deskopoly/ops/+x/deskopoly.+x | $T/app | $T/m | join | A | pet
RUN | $HOUSE/@.apps/deskopoly/ops/+x/deskopoly.+x | $T/app | $T/m | join | B | pet
RUN | $HOUSE/@.apps/deskopoly/ops/+x/deskopoly.+x | $T/app | $T/m | join | C | pet
RUN | $HOUSE/@.apps/deskopoly/ops/+x/deskopoly.+x | $T/app | $T/m | start | 7
RUN | $HOUSE/@.apps/deskopoly/ops/+x/deskopoly.+x | $T/app | $T/m | autoplay
RUN | /usr/bin/cp | $T/m/ledger.txt | $T/m/good.keep
RUN | /usr/bin/sed | -i | s/\pjail_roll\p2,2\p14\pfree/\pjail_roll\p3,3\p14\pfree/ | $T/m/ledger.txt
RUN | /usr/bin/cmp | -s | $T/m/good.keep | $T/m/ledger.txt
EXPECT_EXIT | 1 | the-tamper-changed-the-ledger
RUN | $HOUSE/@.apps/deskopoly/ops/+x/deskopoly.+x | $T/app | $T/m | replay
EXPECT_EXIT | 1 | NEGATIVE-a-lucky-jail-roll-is-refused
EXPECT_OUT | does not match the seeded dice | NEGATIVE-says-so
RUN | /usr/bin/cp | $T/m/good.keep | $T/m/ledger.txt
RUN | /usr/bin/sed | -i | s/\pjail3$/\pto=10;visit/ | $T/m/ledger.txt
RUN | /usr/bin/cmp | -s | $T/m/good.keep | $T/m/ledger.txt
EXPECT_EXIT | 1 | the-tamper-changed-the-ledger-2
RUN | $HOUSE/@.apps/deskopoly/ops/+x/deskopoly.+x | $T/app | $T/m | replay
EXPECT_EXIT | 1 | NEGATIVE-hiding-the-third-double-is-refused
RUN | /usr/bin/cp | $T/m/good.keep | $T/m/ledger.txt
RUN | /usr/bin/sed | -i | s/forced-fine-50/paid-50/ | $T/m/ledger.txt
RUN | /usr/bin/cmp | -s | $T/m/good.keep | $T/m/ledger.txt
EXPECT_EXIT | 1 | the-tamper-changed-the-ledger-3
RUN | $HOUSE/@.apps/deskopoly/ops/+x/deskopoly.+x | $T/app | $T/m | replay
EXPECT_EXIT | 1 | NEGATIVE-renaming-the-forced-fine-is-refused
