# mcl_touch_page - the mcl-hq touch page city/ev/20 (step onto 8,4) has a real effect, proved by playing the page itself in a scratch house.
# The page is CONTENT (a trigger and an expected result); this case is the RUNNER and the JUDGE (see PAL-VS-EVENTS.md). It is played with event_page_op
# (the same page-picking rules, trigger player-touch) and the effect is read from the game's own state files. Scratch only: nothing live is named.
# The page is played from a committed copy (fixtures/mcl_touch_page/ev20) because the live book folder mcl-hq-pchq/ is gitignored runtime data;
# the last check fails if the live page (when this house has the book) differs from the fixture.
RESULTS | ../results/mcl_touch_page.txt
CASE | mcl-touch-page
SCRATCH |
MKDIR | xyzfs
COPYDIR | @.apps/mcl-hq | @.apps/mcl-hq | state,board,audit,+x,saves,mcl-hq-pchq,.hq_manager,events
MKDIR | @.apps/mcl-hq/ops/+x
MKDIR | @.apps/mcl-hq/state
MKDIR | #.NNEST_ASSETS/rmmv-www-img
COPYDIR | &.widgits/_shared-lib | &.widgits/_shared-lib | harness,ops,system,tests,vendor-into.sh,+x
COPY | &.widgits/livedesk-clock/ops/+x/lc_clock.+x | &.widgits/livedesk-clock/ops/+x/lc_clock.+x
COPY | &.widgits/db-hq/data/system.pdl | &.widgits/db-hq/data/system.pdl
COPY | &.widgits/db-hq/data/actors.pdl | &.widgits/db-hq/data/actors.pdl
COPYDIR | &.widgits/_shared-lib/harness/fixtures/mcl_touch_page/ev20 | ev20 |
RUN | nice | -n | 15 | gcc | -std=gnu11 | -O0 | -w | -I | $T/@.apps/mcl-hq/ops | -o | $T/@.apps/mcl-hq/ops/+x/mcl_hq.+x | $T/@.apps/mcl-hq/ops/mcl_hq.c | -lm
EXPECT_EXIT | 0 | setup.build-game
RUN | cp | /usr/bin/tail | $T/khtpm_core_render
SPAWN | viewer | $T/khtpm_core_render | -f | /dev/null | mcl-hq.xhtpm
EXPECT_ALIVE | $viewer | setup.viewer-alive
WRITE | @.apps/mcl-hq/state/flag_int.txt | 1
WRITE | @.apps/mcl-hq/state/flag_running.txt | 1
WRITE | @.apps/mcl-hq/state/active.txt | rex\n
WRITE | @.apps/mcl-hq/state/pet_rex.txt | room=city\nx=8\ny=4\ndir=2\nsteps=1\ntx=-1\nty=-1\n
# a character is standing on 8,4 and no help has been shown yet
EXPECT_NOFILE | @.apps/mcl-hq/state/help_step.txt | before.no-help-step
PLAY_PAGE | ev20 | player-touch |
EXPECT_EXIT | 0 | touch-1.page-ran
EXPECT_HAS | @.apps/mcl-hq/state/help_step.txt | 1 | touch-1.help-step-advanced
EXPECT_HAS | @.apps/mcl-hq/state/note.txt | 1/6 Pick who acts | touch-1.note-shows-line-1
PLAY_PAGE | ev20 | player-touch |
EXPECT_EXIT | 0 | touch-2.page-ran-again
EXPECT_HAS | @.apps/mcl-hq/state/help_step.txt | 2 | touch-2.help-step-advanced-again
EXPECT_HAS | @.apps/mcl-hq/state/note.txt | 2/6 INT on | touch-2.note-shows-line-2
# a different trigger must not run the page (and must not move the state)
PLAY_PAGE | ev20 | on-click |
EXPECT_EXIT | 1 | other-trigger.page-does-not-run
EXPECT_HAS | @.apps/mcl-hq/state/help_step.txt | 2 | other-trigger.state-unchanged
RUN | sh | -c | if [ -d $HOUSE/@.apps/mcl-hq/mcl-hq-pchq/pieces/system/maps/mcl-hq/city/ev/20 ]; then cmp $HOUSE/@.apps/mcl-hq/mcl-hq-pchq/pieces/system/maps/mcl-hq/city/ev/20/event.ir.pdl $T/ev20/event.ir.pdl && cmp $HOUSE/@.apps/mcl-hq/mcl-hq-pchq/pieces/system/maps/mcl-hq/city/ev/20/event_pkg/pages/page_1/event.pal $T/ev20/event_pkg/pages/page_1/event.pal && cmp $HOUSE/@.apps/mcl-hq/mcl-hq-pchq/pieces/system/maps/mcl-hq/city/ev/20/event_pkg/pages/page_1/cmd_1.sh $T/ev20/event_pkg/pages/page_1/cmd_1.sh && cmp $HOUSE/@.apps/mcl-hq/mcl-hq-pchq/pieces/system/maps/mcl-hq/city/ev/20/event_pkg/pages/page_1/condition.pdl $T/ev20/event_pkg/pages/page_1/condition.pdl; fi
EXPECT_EXIT | 0 | drift.live-page-equals-fixture
CLEAN |

