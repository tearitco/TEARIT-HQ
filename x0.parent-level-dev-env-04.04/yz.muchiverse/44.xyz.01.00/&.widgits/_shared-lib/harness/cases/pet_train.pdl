# pet_train - a TRAINING SESSION for all six pets, run through the real verbs on the LIVE pet state (the pets are the learners; their reward ledger obs_feedback_log.txt feeds the concept bank's entity_grade report card).
# Each pet is taught phrases for the furniture/room verbs, asked to do them, and rewarded ('good'); then one day_tick grades them. PET_TRAIN=1 lets a stopped pet learn. Run it after every pet feature lands: prisc+x pet_train.pal
# Lessons: add a row to the LESSONS list in this header's generator (phrase, verb, item) or copy a block below. Results: results/pet_train.txt (+ .verdict.txt). It touches the pet-trainer app's state/ only (never committed).
# Lesson sets: 2 (rooms and furniture: bed, sofa, chimney, living room, bedroom, roof) and 3 (town: build a house, a store, a farm; set 4: study - read a book, learn something - refused without wood/coins, which is part of what they learn).
RESULTS | ../results/pet_train.txt
CASE    | pet-train
SCRATCH |
RUN | /bin/ln | -s | $HOUSE/@.apps/pet-trainer/state | $T/live
ENV | PET_TRAIN | 1
ENV | PET_SHARED | $HOUSE/@.apps/pet-trainer/state

ENV | PET_DIR | $HOUSE/@.apps/pet-trainer/state/pets/a13
RUN | /bin/sh | $HOUSE/@.apps/pet-trainer/ops/pet_event.sh | chat_input | x | y | teach get on the bed = climb bed
RUN | /bin/sh | $HOUSE/@.apps/pet-trainer/ops/pet_event.sh | chat_input | x | y | get on the bed
RUN | /bin/sh | $HOUSE/@.apps/pet-trainer/ops/pet_event.sh | chat_input | x | y | good
RUN | /bin/sh | $HOUSE/@.apps/pet-trainer/ops/pet_event.sh | chat_input | x | y | teach climb the sofa = climb sofa
RUN | /bin/sh | $HOUSE/@.apps/pet-trainer/ops/pet_event.sh | chat_input | x | y | climb the sofa
RUN | /bin/sh | $HOUSE/@.apps/pet-trainer/ops/pet_event.sh | chat_input | x | y | good
RUN | /bin/sh | $HOUSE/@.apps/pet-trainer/ops/pet_event.sh | chat_input | x | y | teach sit on the chimney = climb chimney
RUN | /bin/sh | $HOUSE/@.apps/pet-trainer/ops/pet_event.sh | chat_input | x | y | sit on the chimney
RUN | /bin/sh | $HOUSE/@.apps/pet-trainer/ops/pet_event.sh | chat_input | x | y | good
RUN | /bin/sh | $HOUSE/@.apps/pet-trainer/ops/pet_event.sh | chat_input | x | y | teach go to the living room = go living
RUN | /bin/sh | $HOUSE/@.apps/pet-trainer/ops/pet_event.sh | chat_input | x | y | go to the living room
RUN | /bin/sh | $HOUSE/@.apps/pet-trainer/ops/pet_event.sh | chat_input | x | y | good
RUN | /bin/sh | $HOUSE/@.apps/pet-trainer/ops/pet_event.sh | chat_input | x | y | teach go to the bedroom = go bedroom
RUN | /bin/sh | $HOUSE/@.apps/pet-trainer/ops/pet_event.sh | chat_input | x | y | go to the bedroom
RUN | /bin/sh | $HOUSE/@.apps/pet-trainer/ops/pet_event.sh | chat_input | x | y | good
RUN | /bin/sh | $HOUSE/@.apps/pet-trainer/ops/pet_event.sh | chat_input | x | y | teach go up to the roof = go roof
RUN | /bin/sh | $HOUSE/@.apps/pet-trainer/ops/pet_event.sh | chat_input | x | y | go up to the roof
RUN | /bin/sh | $HOUSE/@.apps/pet-trainer/ops/pet_event.sh | chat_input | x | y | good
RUN | /bin/sh | $HOUSE/@.apps/pet-trainer/ops/pet_event.sh | chat_input | x | y | teach build a house = build house
RUN | /bin/sh | $HOUSE/@.apps/pet-trainer/ops/pet_event.sh | chat_input | x | y | build a house
RUN | /bin/sh | $HOUSE/@.apps/pet-trainer/ops/pet_event.sh | chat_input | x | y | good
RUN | /bin/sh | $HOUSE/@.apps/pet-trainer/ops/pet_event.sh | chat_input | x | y | teach build a store = build store
RUN | /bin/sh | $HOUSE/@.apps/pet-trainer/ops/pet_event.sh | chat_input | x | y | build a store
RUN | /bin/sh | $HOUSE/@.apps/pet-trainer/ops/pet_event.sh | chat_input | x | y | good
RUN | /bin/sh | $HOUSE/@.apps/pet-trainer/ops/pet_event.sh | chat_input | x | y | teach plant a farm = build farm
RUN | /bin/sh | $HOUSE/@.apps/pet-trainer/ops/pet_event.sh | chat_input | x | y | plant a farm
RUN | /bin/sh | $HOUSE/@.apps/pet-trainer/ops/pet_event.sh | chat_input | x | y | good
RUN | /bin/sh | $HOUSE/@.apps/pet-trainer/ops/pet_event.sh | chat_input | x | y | teach read a book = study
RUN | /bin/sh | $HOUSE/@.apps/pet-trainer/ops/pet_event.sh | chat_input | x | y | read a book
RUN | /bin/sh | $HOUSE/@.apps/pet-trainer/ops/pet_event.sh | chat_input | x | y | good
RUN | /bin/sh | $HOUSE/@.apps/pet-trainer/ops/pet_event.sh | chat_input | x | y | teach learn something = study
RUN | /bin/sh | $HOUSE/@.apps/pet-trainer/ops/pet_event.sh | chat_input | x | y | learn something
RUN | /bin/sh | $HOUSE/@.apps/pet-trainer/ops/pet_event.sh | chat_input | x | y | good
RUN | /bin/sh | $HOUSE/@.apps/pet-trainer/ops/pet_event.sh | day_tick
EXPECT_HAS | live/pets/a13/lexicon.pdl | get on the bed | a13-learned-bed
EXPECT_HAS | live/pets/a13/lexicon.pdl | climb the sofa | a13-learned-sofa
EXPECT_HAS | live/pets/a13/lexicon.pdl | sit on the chimney | a13-learned-chimney
EXPECT_HAS | live/pets/a13/lexicon.pdl | go to the living room | a13-learned-living
EXPECT_HAS | live/pets/a13/lexicon.pdl | go to the bedroom | a13-learned-bedroom
EXPECT_HAS | live/pets/a13/lexicon.pdl | go up to the roof | a13-learned-roof
EXPECT_HAS | live/pets/a13/obs_feedback_log.txt | concept=climb | a13-rewarded-climb
EXPECT_HAS | live/pets/a13/obs_feedback_log.txt | concept=go | a13-rewarded-go
EXPECT_HAS | live/pets/a13/lexicon.pdl | read a book | a13-learned-read
RUN | /bin/sh | -c | grep -q concept=study $HOUSE/@.apps/pet-trainer/state/pets/a13/obs_feedback_log.txt && echo yes
EXPECT_OUT_IS | yes | a13-rewarded-study
EXPECT_HAS | live/pets/a13/lexicon.pdl | build a house | a13-learned-house
EXPECT_HAS | live/pets/a13/lexicon.pdl | build a store | a13-learned-store
EXPECT_HAS | live/pets/a13/lexicon.pdl | plant a farm | a13-learned-farm
EXPECT_HAS | live/pets/a13/obs_feedback_log.txt | concept=build | a13-rewarded-build

