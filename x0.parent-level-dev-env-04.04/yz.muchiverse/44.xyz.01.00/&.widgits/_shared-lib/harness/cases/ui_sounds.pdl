RUN | $T/usr.+x | $T/f6.pdl | $T/x6
EXPECT_EXIT | 1 | seed-letters
EXPECT_OUT | not an unsigned 64-bit | seed-letters-message
WRITE | f7.pdl | SEED \p world \p 5\nTHEME \p t \p T \p n\nSOUND \p t \p a \p blip \p wave=sine f0=440 dur=0.1 vol=0.25 \p n\n
RUN | $T/usr.+x | $T/f7.pdl | $T/x7
EXPECT_EXIT | 1 | seed-wrong-key
EXPECT_OUT | SEED row must be | seed-wrong-key-message
WRITE | f8.pdl | SEED \p ui \p 1\nSOUND \p t \p a \p blip \p wave=sine f0=440 dur=0.1 vol=0.25 \p n\n
RUN | $T/usr.+x | $T/f8.pdl | $T/x8
EXPECT_EXIT | 1 | no-theme
EXPECT_OUT | no THEME rows | no-theme-message
