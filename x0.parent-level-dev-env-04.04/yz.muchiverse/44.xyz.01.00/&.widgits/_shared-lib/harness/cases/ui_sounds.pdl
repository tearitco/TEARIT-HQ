# ui_sounds: LOCKED cases for U1 of BOOK 19.audio/UI-SOUNDS-AND-STARTUP-DESIGN.md. Source under test: &.widgits/ui-sounds/ops/ui_sound_render.c; data under test: &.widgits/ui-sounds/ui_sounds.pdl. Every refusal is a NEGATIVE test: the renderer must exit 1 with the right message and write nothing it should not. Not tested here (cannot fail): the duration check, because the renderer always writes the requested length; the DC check, because no waveform the renderer makes has DC. HEARING is not tested: nobody has listened. KNOWN GAP (found by mutation 2026-10-23): the peak > 0.7 branch of the renderer is subsumed by the rms ceiling for every sound the current kinds can make (crest factor at most about 2.5), so removing it is not caught; it stays as a safety net for future kinds.
RESULTS | ../results/ui_sounds.txt
CASE | ui-sounds
SCRATCH |
COPY | &.widgits/ui-sounds/ops/ui_sound_render.c | ui_sound_render.c
MKDIR | sys
COPY | &.widgits/_shared-lib/audio_dsp.c | sys/audio_dsp.c
COPY | &.widgits/ui-sounds/ui_sounds.pdl | ui_sounds.pdl
RUN | gcc | -std=gnu11 | -Wall | -Wextra | -Werror | -O2 | -isystem | $T/sys | -o | $T/usr.+x | $T/ui_sound_render.c | -lm
EXPECT_EXIT | 0 | compiles-clean
RUN | $T/usr.+x | $T/ui_sounds.pdl | $T/a
EXPECT_EXIT | 0 | real-file-renders
EXPECT_OUT | rendered=18 themes=2 cues=9 | real-file-summary
EXPECT_OUT_LACKS | FAIL | real-file-no-fail
EXPECT_EXISTS | a/soft/nav_move.wav | exists-soft-nav_move
EXPECT_EXISTS | a/soft/activate.wav | exists-soft-activate
EXPECT_EXISTS | a/soft/focus_win.wav | exists-soft-focus_win
EXPECT_EXISTS | a/soft/open_win.wav | exists-soft-open_win
EXPECT_EXISTS | a/soft/close_win.wav | exists-soft-close_win
EXPECT_EXISTS | a/soft/refused.wav | exists-soft-refused
EXPECT_EXISTS | a/soft/toggle_on.wav | exists-soft-toggle_on
EXPECT_EXISTS | a/soft/toggle_off.wav | exists-soft-toggle_off
EXPECT_EXISTS | a/soft/startup.wav | exists-soft-startup
EXPECT_EXISTS | a/retro/nav_move.wav | exists-retro-nav_move
EXPECT_EXISTS | a/retro/activate.wav | exists-retro-activate
EXPECT_EXISTS | a/retro/focus_win.wav | exists-retro-focus_win
EXPECT_EXISTS | a/retro/open_win.wav | exists-retro-open_win
EXPECT_EXISTS | a/retro/close_win.wav | exists-retro-close_win
EXPECT_EXISTS | a/retro/refused.wav | exists-retro-refused
EXPECT_EXISTS | a/retro/toggle_on.wav | exists-retro-toggle_on
EXPECT_EXISTS | a/retro/toggle_off.wav | exists-retro-toggle_off
EXPECT_EXISTS | a/retro/startup.wav | exists-retro-startup
RUN | $T/usr.+x | $T/ui_sounds.pdl | $T/b
EXPECT_EXIT | 0 | second-render-exit
SUMTREE | ha | a
SUMTREE | hb | b
EXPECT_EQ | $ha | $hb | same-file-same-seed-same-bytes
WRITE | seed2.pdl | SEED \p ui \p 20261024\nTHEME \p t \p T \p n\nSOUND \p t \p a \p blip \p wave=noise dur=0.1 vol=0.3 \p n\nCUE \p e \p a \p 50 \p ui\n
WRITE | seed1.pdl | SEED \p ui \p 20261023\nTHEME \p t \p T \p n\nSOUND \p t \p a \p blip \p wave=noise dur=0.1 vol=0.3 \p n\nCUE \p e \p a \p 50 \p ui\n
RUN | $T/usr.+x | $T/seed1.pdl | $T/n1
RUN | $T/usr.+x | $T/seed2.pdl | $T/n2
SUMTREE | h1 | n1
SUMTREE | h2 | n2
EXPECT_NE | $h1 | $h2 | other-seed-other-noise-bytes
RUN | $T/usr.+x | $T/seed1.pdl | $T/n1b
SUMTREE | h1b | n1b
EXPECT_EQ | $h1 | $h1b | noise-same-seed-twice-same-bytes
WRITE | f1.pdl | SEED \p ui \p 1\nTHEME \p t \p T \p n\nSOUND \p t \p a \p blip \p wave=sine f0=440 dur=0.1 vol=0.25 \p n\nCUE \p e \p a \p 50 \p ui\n
RUN | $T/usr.+x | $T/f1.pdl | $T/x1
EXPECT_EXIT | 0 | minimal-ok
EXPECT_OUT | rendered=1 themes=1 cues=1 | minimal-ok-message
WRITE | f2.pdl | SEED \p ui \p 1\nTHEME \p t \p T \p n\nSOUND \p t \p a \p notes \p tempo=120 seq=C5:1,R:1,F#4:0.5,Bb3:1 wave=triangle vol=0.3 attack=0.01 decay=0.2 \p n\nCUE \p e \p a \p 50 \p ui\n
RUN | $T/usr.+x | $T/f2.pdl | $T/x2
EXPECT_EXIT | 0 | notes-with-rest-ok
EXPECT_OUT | rendered=1 | notes-with-rest-ok-message
WRITE | f3.pdl | SEED \p ui \p 1\nTHEME \p t \p T \p n\nSOUND \p t \p a \p blip \p wave=noise dur=0.1 vol=0.3 \p n\nCUE \p e \p a \p 50 \p ui\n
RUN | $T/usr.+x | $T/f3.pdl | $T/x3
EXPECT_EXIT | 0 | noise-needs-no-f0
EXPECT_OUT | rendered=1 | noise-needs-no-f0-message
WRITE | f4.pdl | THEME \p t \p T \p n\nSOUND \p t \p a \p blip \p wave=sine f0=440 dur=0.1 vol=0.25 \p n\n
RUN | $T/usr.+x | $T/f4.pdl | $T/x4
EXPECT_EXIT | 1 | no-seed
EXPECT_OUT | no SEED row | no-seed-message
WRITE | f5.pdl | SEED \p ui \p 1\nTHEME \p t \p T \p n\nSEED \p ui \p 2\nSOUND \p t \p a \p blip \p wave=sine f0=440 dur=0.1 vol=0.25 \p n\n
RUN | $T/usr.+x | $T/f5.pdl | $T/x5
EXPECT_EXIT | 1 | two-seeds
EXPECT_OUT | more than one SEED | two-seeds-message
