# D34 step 4 (v0/v1): the buttons of the palette-studio window (palette_studio_ui_op). Every run uses state=<scratch>, so the live window state is never touched.
CASE    | window
SCRATCH |
RUN | $HOUSE/@.apps/generator-hq/ops/+x/palette_studio_ui_op.+x | init | state=$T/st
RUN | /usr/bin/stat | -c | %s | $T/st/studio_preview.raw
EXPECT_OUT | 1769472 | the-preview-is-768x576-rgba
RUN | /usr/bin/grep | template_id | $T/st/palettes-studio_ui.txt
EXPECT_OUT | template_id=outside_b | init-starts-on-the-first-template
RUN | $HOUSE/@.apps/generator-hq/ops/+x/palette_studio_ui_op.+x | nudge | warm | 0.05 | state=$T/st
RUN | /usr/bin/grep | kb_0_val | $T/st/palettes-studio_ui.txt
EXPECT_OUT | kb_0_val=+5% | a-nudge-moves-the-knob
