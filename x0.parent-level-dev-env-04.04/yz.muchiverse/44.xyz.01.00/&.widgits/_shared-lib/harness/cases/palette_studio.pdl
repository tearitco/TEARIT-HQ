EXPECT_EXIT | 0 | REGRESSION-the-renderer-appends-two-arguments-to-every-action
RUN | /usr/bin/grep | kb_0_val | $T/st/palettes-studio_ui.txt
EXPECT_OUT | kb_0_val=+10% | and-the-nudge-still-lands
RUN | /usr/bin/cp | $T/st/studio_preview.raw | $T/before.raw
