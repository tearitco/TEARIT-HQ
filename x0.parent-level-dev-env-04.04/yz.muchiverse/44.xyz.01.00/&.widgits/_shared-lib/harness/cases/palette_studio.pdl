RUN | $HOUSE/@.apps/generator-hq/ops/+x/palette_studio_op.+x | render | $HOUSE/@.apps/generator-hq/events/gen_studio/templates.pdl | outside_a2 | $T/gk.png | concepts=$T/user | concept=cozy:0.5
RUN | $HOUSE/@.apps/generator-hq/ops/+x/palette_studio_op.+x | render | $HOUSE/@.apps/generator-hq/events/gen_studio/templates.pdl | outside_a2 | $T/gw.png | knob=warm:0.2500 | knob=wet:0.1000 | knob=wear:0.1050
RUN | /usr/bin/cmp | -s | $T/gk.png | $T/gw.png
