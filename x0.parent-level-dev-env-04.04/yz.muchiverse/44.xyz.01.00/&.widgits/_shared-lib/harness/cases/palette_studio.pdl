MKDIR | lo
MKDIR | hi
WRITE | lo/concept_b.pdl | NODE \p concept_b\nKIND \p master\nVALUE \p 0.00\nSLOT \p 0 \p POINTS_TO=look_warm \p WEIGHT=0.60\n
