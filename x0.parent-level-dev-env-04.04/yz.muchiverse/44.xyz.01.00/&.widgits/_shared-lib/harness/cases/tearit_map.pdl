# Seeded tearit map. Same seed matches. A bridge turned into water fails check.
RESULTS | ../results/tearit_map.txt
CASE | map
SCRATCH
RUN | gcc | -std=gnu11 | -Wall | -Wextra | -O2 | -o | $T/tearit_map_op.+x | $HOUSE/@.apps/tearit-map/ops/tearit_map_op.c
EXPECT_EXIT | 0 | map op compiles
RUN | $T/tearit_map_op.+x | gen | 1 | 16 | 16 | $T/a.txt
EXPECT_EXIT | 0 | seed 1 writes
EXPECT_OUT | bridge=1 | a bridge cell exists
EXPECT_OUT | starts=2 | two starts
RUN | $T/tearit_map_op.+x | gen | 1 | 16 | 16 | $T/b.txt
EXPECT_EXIT | 0 | seed 1 again
RUN | cmp | -s | $T/a.txt | $T/b.txt
EXPECT_EXIT | 0 | same seed same bytes
RUN | $T/tearit_map_op.+x | gen | 2 | 16 | 16 | $T/c.txt
EXPECT_EXIT | 0 | seed 2 writes
RUN | cmp | -s | $T/a.txt | $T/c.txt
EXPECT_EXIT | 1 | a different seed differs
RUN | $T/tearit_map_op.+x | check | $T/a.txt
EXPECT_EXIT | 0 | seed 1 passes check
EXPECT_OUT | ok | check says ok
RUN | $T/tearit_map_op.+x | sabotage | $T/a.txt | $T/bad.txt
EXPECT_EXIT | 0 | bridge cell becomes water
RUN | $T/tearit_map_op.+x | check | $T/bad.txt
EXPECT_EXIT | 4 | water on the bridge fails
RUN | $T/tearit_map_op.+x | picture | $T/a.txt | $T/a.ppm
EXPECT_EXIT | 0 | ppm writes
EXPECT_OUT | picture= | picture path printed
RUN | $T/tearit_map_op.+x | desk | $T/a.txt | $T/d1
EXPECT_EXIT | 0 | desk writes
EXPECT_OUT | marker=1 | a new desk marker starts at 1
RUN | $T/tearit_map_op.+x | desk | $T/a.txt | $T/d2
EXPECT_EXIT | 0 | second desk
RUN | cmp | -s | $T/d1/cells.txt | $T/d2/cells.txt
EXPECT_EXIT | 0 | cells match
RUN | cmp | -s | $T/d1/cells.rgba | $T/d2/cells.rgba
EXPECT_EXIT | 0 | atlas matches
RUN | cmp | -s | $T/d1/map.txt | $T/d2/map.txt
EXPECT_EXIT | 0 | glyphs match
RUN | cmp | -s | $T/d1/events.txt | $T/d2/events.txt
EXPECT_EXIT | 0 | events match
RUN | rm | -f | $T/d1/cells.txt | $T/d1/cells.rgba | $T/d1/map.txt | $T/d1/events.txt | $T/d1/map.ppm
EXPECT_EXIT | 0 | pictures deleted
RUN | $T/tearit_map_op.+x | desk | $T/a.txt | $T/d1
EXPECT_EXIT | 0 | desk rebuilt
EXPECT_OUT | marker=2 | marker grew
RUN | cmp | -s | $T/d1/cells.txt | $T/d2/cells.txt
EXPECT_EXIT | 0 | rebuilt cells match
RUN | $T/tearit_map_op.+x | move | $T/a.txt | $T/walk.txt | land
EXPECT_EXIT | 0 | one land step
EXPECT_OUT | move= | a move row was printed
RUN | cp | $T/walk.txt | $T/walk.keep
EXPECT_EXIT | 0 | ledger saved
RUN | $T/tearit_map_op.+x | move | $T/a.txt | $T/walk.txt | water
EXPECT_EXIT | 4 | water is refused
RUN | cmp | -s | $T/walk.txt | $T/walk.keep
EXPECT_EXIT | 0 | a refused step writes nothing
RUN | rm | -f | $T/walk2.txt
EXPECT_EXIT | 0 | second ledger cleared
RUN | $T/tearit_map_op.+x | move | $T/a.txt | $T/walk2.txt | land
EXPECT_EXIT | 0 | replay step
RUN | cmp | -s | $T/walk.txt | $T/walk2.txt
EXPECT_EXIT | 0 | same steps same ledger
RUN | $T/tearit_map_op.+x | dig | $T/a.txt | $T/walk.txt
EXPECT_EXIT | 4 | dig away from the mineral writes nothing
RUN | $T/tearit_map_op.+x | approach | $T/a.txt | $T/ore.txt
EXPECT_EXIT | 0 | walk to the mineral
EXPECT_OUT | approach=1 | path was found
RUN | $T/tearit_map_op.+x | dig | $T/a.txt | $T/ore.txt
EXPECT_EXIT | 0 | dig the mineral cell
EXPECT_OUT | dug= | a DIG row
RUN | $T/tearit_map_op.+x | dig | $T/a.txt | $T/ore.txt
EXPECT_EXIT | 4 | a second dig is refused
RUN | $T/tearit_map_op.+x | desk | $T/a.txt | $T/ore-before
EXPECT_EXIT | 0 | desk before dig
RUN | $T/tearit_map_op.+x | desk | $T/a.txt | $T/ore-after | $T/ore.txt
EXPECT_EXIT | 0 | desk after dig
RUN | cmp | -s | $T/ore-before/cells.txt | $T/ore-after/cells.txt
EXPECT_EXIT | 1 | the dug cell changes the picture
RUN | $T/tearit_map_op.+x | found | $T/a.txt | $T/city.txt
EXPECT_EXIT | 0 | a city on the start cell
EXPECT_OUT | found= | the city row
RUN | $T/tearit_map_op.+x | found | $T/a.txt | $T/city.txt
EXPECT_EXIT | 4 | a second city on that cell is refused
RUN | $T/tearit_map_op.+x | found | $T/a.txt | $T/city2.txt
EXPECT_EXIT | 0 | replay the city
RUN | cmp | -s | $T/city.txt | $T/city2.txt
EXPECT_EXIT | 0 | same city row
RUN | $T/tearit_map_op.+x | sleep | $T/a.txt | $T/body.txt
EXPECT_EXIT | 4 | sleep at a full ration writes nothing
RUN | $T/tearit_map_op.+x | eat | $T/a.txt | $T/body.txt
EXPECT_EXIT | 0 | one meal
EXPECT_OUT | ration=2 | one ration was spent
RUN | cp | $T/body.txt | $T/body.keep
EXPECT_EXIT | 0 | ledger saved
RUN | $T/tearit_map_op.+x | eat | $T/a.txt | $T/body.txt
EXPECT_EXIT | 0 | second meal
RUN | $T/tearit_map_op.+x | eat | $T/a.txt | $T/body.txt
EXPECT_EXIT | 0 | third meal
EXPECT_OUT | ration=0 | the pack is empty
RUN | cp | $T/body.txt | $T/body.empty
EXPECT_EXIT | 0 | empty ledger saved
RUN | $T/tearit_map_op.+x | eat | $T/a.txt | $T/body.txt
EXPECT_EXIT | 4 | a fourth meal is refused
RUN | cmp | -s | $T/body.txt | $T/body.empty
EXPECT_EXIT | 0 | a refused meal writes nothing
RUN | $T/tearit_map_op.+x | sleep | $T/a.txt | $T/body.txt
EXPECT_EXIT | 0 | sleep restores one
EXPECT_OUT | ration=1 | one ration came back
RUN | $T/tearit_map_op.+x | desk | $T/a.txt | $T/body-desk | $T/body.txt
EXPECT_EXIT | 0 | desk shows the body
RUN | $T/tearit_map_op.+x | desk | $T/a.txt | $T/body-full
EXPECT_EXIT | 0 | desk at a full ration
RUN | cmp | -s | $T/body-desk/events.txt | $T/body-full/events.txt
EXPECT_EXIT | 1 | a spent ration changes the pawn
RUN | $T/tearit_map_op.+x | gen | 1 | 32 | 32 | $T/wide.txt
EXPECT_EXIT | 0 | a 32 map writes
RUN | $T/tearit_map_op.+x | check | $T/wide.txt
EXPECT_EXIT | 0 | the 32 map passes check
RUN | rm | -f | $T/ag.txt | $T/ag2.txt
EXPECT_EXIT | 0 | agent ledgers cleared
RUN | $T/tearit_map_op.+x | agent | $T/a.txt | $T/ag.txt
EXPECT_EXIT | 0 | one agent step
EXPECT_OUT | agent= | the step was printed
RUN | $T/tearit_map_op.+x | agent | $T/a.txt | $T/ag2.txt
EXPECT_EXIT | 0 | the same step again
RUN | cmp | -s | $T/ag.txt | $T/ag2.txt
EXPECT_EXIT | 0 | no model, same step
RUN | $T/tearit_map_op.+x | desk | $T/a.txt | $T/ag-before
EXPECT_EXIT | 0 | desk before the agent
RUN | $T/tearit_map_op.+x | desk | $T/a.txt | $T/ag-after | $T/ag.txt
EXPECT_EXIT | 0 | desk after the agent
RUN | cmp | -s | $T/ag-before/events.txt | $T/ag-after/events.txt
EXPECT_EXIT | 1 | the agent line moves
RUN | $T/tearit_map_op.+x | desk | $T/a.txt | $T/fog0
EXPECT_EXIT | 0 | fog covers an unwalked map
EXPECT_OUT | fog= | a fog count is printed
RUN | rm | -f | $T/fog-walk.txt
EXPECT_EXIT | 0 | fog ledger cleared
RUN | $T/tearit_map_op.+x | move | $T/a.txt | $T/fog-walk.txt | land
EXPECT_EXIT | 0 | one step opens fog
RUN | $T/tearit_map_op.+x | desk | $T/a.txt | $T/fog1 | $T/fog-walk.txt
EXPECT_EXIT | 0 | desk after one step
RUN | cmp | -s | $T/fog0/map.txt | $T/fog1/map.txt
EXPECT_EXIT | 1 | the step reveals cells
RUN | cp | $T/fog1/map.txt | $T/fog1.keep
EXPECT_EXIT | 0 | fog glyph saved
RUN | rm | -f | $T/fog1/map.txt
EXPECT_EXIT | 0 | fog projection deleted
RUN | $T/tearit_map_op.+x | desk | $T/a.txt | $T/fog1 | $T/fog-walk.txt
EXPECT_EXIT | 0 | fog rebuilt
RUN | cmp | -s | $T/fog1/map.txt | $T/fog1.keep
EXPECT_EXIT | 0 | the same fog comes back
RUN | rm | -f | $T/step.txt
EXPECT_EXIT | 0 | step ledger cleared
RUN | $T/tearit_map_op.+x | step | $T/a.txt | $T/step.txt | n
EXPECT_EXIT | 4 | north off the map is refused
RUN | test | ! | -s | $T/step.txt
EXPECT_EXIT | 0 | a refused step writes nothing
RUN | $T/tearit_map_op.+x | step | $T/a.txt | $T/step.txt | e
EXPECT_EXIT | 0 | east is a chosen step
EXPECT_OUT | step=5,0 | seed 1 east leaves the start
RUN | $T/tearit_map_op.+x | gen | 1 | 64 | 64 | $T/wide64.txt
EXPECT_EXIT | 0 | a 64 map writes
RUN | $T/tearit_map_op.+x | check | $T/wide64.txt
EXPECT_EXIT | 0 | the 64 map passes check
RUN | rm | -f | $T/pl.txt
EXPECT_EXIT | 0 | place ledger cleared
RUN | $T/tearit_map_op.+x | place | $T/a.txt | $T/pl.txt
EXPECT_EXIT | 4 | place before a dig is refused
RUN | $T/tearit_map_op.+x | approach | $T/a.txt | $T/pl.txt
EXPECT_EXIT | 0 | walk to the mineral for a place
RUN | $T/tearit_map_op.+x | dig | $T/a.txt | $T/pl.txt
EXPECT_EXIT | 0 | dig before place
RUN | $T/tearit_map_op.+x | place | $T/a.txt | $T/pl.txt
EXPECT_EXIT | 0 | place on the dug cell
EXPECT_OUT | placed= | the place row was printed
RUN | cp | $T/pl.txt | $T/pl.keep
EXPECT_EXIT | 0 | place ledger saved
RUN | $T/tearit_map_op.+x | place | $T/a.txt | $T/pl.txt
EXPECT_EXIT | 4 | a second place is refused
RUN | cmp | -s | $T/pl.txt | $T/pl.keep
EXPECT_EXIT | 0 | a refused place writes nothing
RUN | $T/tearit_map_op.+x | desk | $T/a.txt | $T/pl-desk | $T/pl.txt
EXPECT_EXIT | 0 | desk of the placed cell
RUN | cp | $T/pl-desk/map.txt | $T/pl-map.keep
EXPECT_EXIT | 0 | glyph file saved
RUN | rm | -f | $T/pl-desk/cells.txt | $T/pl-desk/cells.rgba | $T/pl-desk/map.txt
EXPECT_EXIT | 0 | projection deleted
RUN | $T/tearit_map_op.+x | desk | $T/a.txt | $T/pl-desk | $T/pl.txt
EXPECT_EXIT | 0 | desk rebuilt from the ledger
RUN | cmp | -s | $T/pl-desk/map.txt | $T/pl-map.keep
EXPECT_EXIT | 0 | the placed glyph survives a rebuild
