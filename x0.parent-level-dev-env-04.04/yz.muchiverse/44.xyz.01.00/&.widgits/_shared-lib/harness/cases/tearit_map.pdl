# Seeded tearit map. Same seed matches. A bridge turned into water fails check.
RESULTS | ../results/tearit_map.txt
CASE | map
SCRATCH
RUN | gcc | -std=gnu11 | -Wall | -Wextra | -O2 | -o | $T/tearit_map_op.+x | $HOUSE/@.apps/tearit-map/ops/tearit_map_op.c
EXPECT_EXIT | 0 | map op compiles
RUN | $T/tearit_map_op.+x | gen | 1 | 16 | 16 | $T/a.txt
EXPECT_EXIT | 0 | seed 1 writes
EXPECT_OUT | bridge=1 | a bridge cell exists
EXPECT_OUT | starts=2 | two starts
RUN | $T/tearit_map_op.+x | gen | 1 | 16 | 16 | $T/b.txt
EXPECT_EXIT | 0 | seed 1 again
RUN | cmp | -s | $T/a.txt | $T/b.txt
EXPECT_EXIT | 0 | same seed same bytes
RUN | $T/tearit_map_op.+x | gen | 2 | 16 | 16 | $T/c.txt
EXPECT_EXIT | 0 | seed 2 writes
RUN | cmp | -s | $T/a.txt | $T/c.txt
EXPECT_EXIT | 1 | a different seed differs
RUN | $T/tearit_map_op.+x | check | $T/a.txt
EXPECT_EXIT | 0 | seed 1 passes check
EXPECT_OUT | ok | check says ok
RUN | $T/tearit_map_op.+x | sabotage | $T/a.txt | $T/bad.txt
EXPECT_EXIT | 0 | bridge cell becomes water
RUN | $T/tearit_map_op.+x | check | $T/bad.txt
EXPECT_EXIT | 4 | water on the bridge fails
RUN | $T/tearit_map_op.+x | picture | $T/a.txt | $T/a.ppm
EXPECT_EXIT | 0 | ppm writes
EXPECT_OUT | picture= | picture path printed
RUN | $T/tearit_map_op.+x | desk | $T/a.txt | $T/d1
EXPECT_EXIT | 0 | desk writes
EXPECT_OUT | marker=1 | a new desk marker starts at 1
RUN | $T/tearit_map_op.+x | desk | $T/a.txt | $T/d2
EXPECT_EXIT | 0 | second desk
RUN | cmp | -s | $T/d1/cells.txt | $T/d2/cells.txt
EXPECT_EXIT | 0 | cells match
RUN | cmp | -s | $T/d1/cells.rgba | $T/d2/cells.rgba
EXPECT_EXIT | 0 | atlas matches
RUN | cmp | -s | $T/d1/map.txt | $T/d2/map.txt
EXPECT_EXIT | 0 | glyphs match
RUN | cmp | -s | $T/d1/events.txt | $T/d2/events.txt
EXPECT_EXIT | 0 | events match
RUN | rm | -f | $T/d1/cells.txt | $T/d1/cells.rgba | $T/d1/map.txt | $T/d1/events.txt | $T/d1/map.ppm
EXPECT_EXIT | 0 | pictures deleted
RUN | $T/tearit_map_op.+x | desk | $T/a.txt | $T/d1
EXPECT_EXIT | 0 | desk rebuilt
EXPECT_OUT | marker=2 | marker grew
RUN | cmp | -s | $T/d1/cells.txt | $T/d2/cells.txt
EXPECT_EXIT | 0 | rebuilt cells match
RUN | $T/tearit_map_op.+x | move | $T/a.txt | $T/walk.txt | land
EXPECT_EXIT | 0 | one land step
EXPECT_OUT | move= | a move row was printed
RUN | cp | $T/walk.txt | $T/walk.keep
EXPECT_EXIT | 0 | ledger saved
RUN | $T/tearit_map_op.+x | move | $T/a.txt | $T/walk.txt | water
EXPECT_EXIT | 4 | water is refused
RUN | cmp | -s | $T/walk.txt | $T/walk.keep
EXPECT_EXIT | 0 | a refused step writes nothing
RUN | rm | -f | $T/walk2.txt
EXPECT_EXIT | 0 | second ledger cleared
RUN | $T/tearit_map_op.+x | move | $T/a.txt | $T/walk2.txt | land
EXPECT_EXIT | 0 | replay step
RUN | cmp | -s | $T/walk.txt | $T/walk2.txt
EXPECT_EXIT | 0 | same steps same ledger
RUN | $T/tearit_map_op.+x | dig | $T/a.txt | $T/walk.txt
EXPECT_EXIT | 4 | dig away from the mineral writes nothing
RUN | $T/tearit_map_op.+x | approach | $T/a.txt | $T/ore.txt
EXPECT_EXIT | 0 | walk to the mineral
EXPECT_OUT | approach=1 | path was found
RUN | $T/tearit_map_op.+x | dig | $T/a.txt | $T/ore.txt
EXPECT_EXIT | 0 | dig the mineral cell
EXPECT_OUT | dug= | a DIG row
RUN | $T/tearit_map_op.+x | dig | $T/a.txt | $T/ore.txt
EXPECT_EXIT | 4 | a second dig is refused
RUN | $T/tearit_map_op.+x | desk | $T/a.txt | $T/ore-before
EXPECT_EXIT | 0 | desk before dig
RUN | $T/tearit_map_op.+x | desk | $T/a.txt | $T/ore-after | $T/ore.txt
EXPECT_EXIT | 0 | desk after dig
RUN | cmp | -s | $T/ore-before/cells.txt | $T/ore-after/cells.txt
EXPECT_EXIT | 1 | the dug cell changes the picture
