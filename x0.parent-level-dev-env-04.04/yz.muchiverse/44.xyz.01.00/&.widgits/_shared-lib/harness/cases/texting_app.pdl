RUN | /bin/rm | -f | $T/h/&.hq-apps/plus-phone/texting.pdl

CASE    | the-package
RUN | /bin/cp | $HOUSE/&.hq-apps/plus-phone/ops/+x/app_check.+x | $T/h/&.hq-apps/app_check.+x
RUN | $T/h/&.hq-apps/app_check.+x | $T/h/&.hq-apps/plus-phone/apps/texting
EXPECT_OUT | CHECK-OK texting | the-package-passes-app_check

CASE    | the-module-ends-with-its-window
RUN | /bin/sh | -c | KHTPM_ARG3="$1" "$2" "$3" "$4" >/dev/null 2>&1 & sleep 1; pgrep -f "texting_op[.]\+x $3 " >/dev/null && echo MODULE-ALIVE; sleep 1; exit 0 | sh | $T/h/&.hq-apps/plus-phone/instances/1 | $T/h/&.hq-apps/plus-phone/apps/texting/ops/+x/texting_op.+x | $T/h | $T/h/&.hq-apps/plus-phone/apps/texting
EXPECT_OUT | MODULE-ALIVE | CONTROL-while-its-window-lives-the-module-runs
SLEEP | 2500
RUN | /usr/bin/pgrep | -f | texting_op[.]\+x $T/h 
EXPECT_EXIT | 1 | the-module-is-GONE-after-its-window-ended-(not-adopted-and-left-running)
