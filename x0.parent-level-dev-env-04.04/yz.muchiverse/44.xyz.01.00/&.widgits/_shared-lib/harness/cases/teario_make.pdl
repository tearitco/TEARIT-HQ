# teario_make (Teario-Make): the MAKE shell of the Teario foundation (plan TEARIO-MAKE-PLAY-LEVEL-EDITOR-AND-PLATFORMER-PLAN-2026-11-09 sections 1.2, 3.5 and 5.1): an editor-kind game on the shared engine game_core with doc_format level.
# The level is a DOCUMENT of rows (name start goal r00..r11) built by EDIT rows (add / set / del) in a ledger; `export` writes level.pdl = the SAME text Teario-Play reads, byte for byte (sha256 compared to the shared fixture);
# `publish` is REFUSED without a verified clear: a `clear` row made by replaying a Teario-Play run ledger (verify_clear) whose LEVEL HASH is that of THIS version of the level. No physics, no UI beyond the generated bars.
# Every number was OBSERVED in a scratch run on 2026-11-09. Scratch only: nothing here touches a live folder.
RESULTS | ../results/teario_make.txt
ENV | LC_ALL | C

CASE    | tm_level
SCRATCH |
COPYDIR | @.apps/teario | tm/teario
COPYDIR | @.apps/teario-play | tm/teario-play
RUN | sed | -i | s/^MODE .*/MODE  \p walk/ | $T/tm/teario-play/rulesets/default/board.pdl
RUN | sed | -i | s/meadow\.pdl/first-steps.pdl/ | $T/tm/teario-play/rulesets/default/board.pdl
COPYDIR | @.apps/teario-make | tm/teario-make
MKDIR   | tm_g
RUN | $HOUSE/&.widgits/_shared-lib/ops/+x/game_core.+x | $T/tm/teario-make | $T/tm_g | new | 7
EXPECT_OUT | new game seed=7 kind=editor | the-document-opens
RUN | $HOUSE/&.widgits/_shared-lib/ops/+x/game_core.+x | $T/tm/teario-make | $T/tm_g | export
EXPECT_NOFILE | $T/tm_g/level.pdl | an-EMPTY-document-has-no-level-file
RUN | $HOUSE/&.widgits/_shared-lib/ops/+x/game_core.+x | $T/tm/teario-make | $T/tm_g | clear | $T/tm/teario-play | $T/tm_g
EXPECT_EXIT | 2 | NEGATIVE-clear-needs-a-Play-run-(this-folder-is-not-one)
RUN | $HOUSE/&.widgits/_shared-lib/ops/+x/game_core.+x | $T/tm/teario-make | $T/tm_g | publish
EXPECT_EXIT | 2 | NEGATIVE-publish-of-an-empty-document-is-refused-(no-name-start-goal)
EXPECT_OUT | has no row name | and-says-which-row-is-missing
RUN | $HOUSE/&.widgits/_shared-lib/ops/+x/game_core.+x | $T/tm/teario-make | $T/tm_g | add | name | First Steps
RUN | $HOUSE/&.widgits/_shared-lib/ops/+x/game_core.+x | $T/tm/teario-make | $T/tm_g | add | start | 2 10
RUN | $HOUSE/&.widgits/_shared-lib/ops/+x/game_core.+x | $T/tm/teario-make | $T/tm_g | add | goal | 17 10
RUN | $HOUSE/&.widgits/_shared-lib/ops/+x/game_core.+x | $T/tm/teario-make | $T/tm_g | add | r00 | ....................
RUN | $HOUSE/&.widgits/_shared-lib/ops/+x/game_core.+x | $T/tm/teario-make | $T/tm_g | add | r01 | ....................
RUN | $HOUSE/&.widgits/_shared-lib/ops/+x/game_core.+x | $T/tm/teario-make | $T/tm_g | add | r02 | ....................
RUN | $HOUSE/&.widgits/_shared-lib/ops/+x/game_core.+x | $T/tm/teario-make | $T/tm_g | add | r03 | ....................
RUN | $HOUSE/&.widgits/_shared-lib/ops/+x/game_core.+x | $T/tm/teario-make | $T/tm_g | add | r04 | ....................
RUN | $HOUSE/&.widgits/_shared-lib/ops/+x/game_core.+x | $T/tm/teario-make | $T/tm_g | add | r05 | ....................
RUN | $HOUSE/&.widgits/_shared-lib/ops/+x/game_core.+x | $T/tm/teario-make | $T/tm_g | add | r06 | ....................
RUN | $HOUSE/&.widgits/_shared-lib/ops/+x/game_core.+x | $T/tm/teario-make | $T/tm_g | add | r07 | ....................
RUN | $HOUSE/&.widgits/_shared-lib/ops/+x/game_core.+x | $T/tm/teario-make | $T/tm_g | add | r08 | ......####..........
RUN | $HOUSE/&.widgits/_shared-lib/ops/+x/game_core.+x | $T/tm/teario-make | $T/tm_g | add | r09 | ....................
RUN | $HOUSE/&.widgits/_shared-lib/ops/+x/game_core.+x | $T/tm/teario-make | $T/tm_g | add | r10 | ....................
RUN | $HOUSE/&.widgits/_shared-lib/ops/+x/game_core.+x | $T/tm/teario-make | $T/tm_g | add | r11 | ##########..########
RUN | $HOUSE/&.widgits/_shared-lib/ops/+x/game_core.+x | $T/tm/teario-make | $T/tm_g | status
EXPECT_OUT | doc_rows=15 | the-document-has-15-rows-(name-start-goal-and-12-tile-rows)
RUN | $HOUSE/&.widgits/_shared-lib/ops/+x/game_core.+x | $T/tm/teario-make | $T/tm_g | export
EXPECT_OUT | wrote doc.txt (15 rows) | the-document-exports
EXPECT_EXISTS | $T/tm_g/level.pdl | and-a-level-file-is-a-projection-of-it
RUN | $HOUSE/&.widgits/_shared-lib/ops/+x/hash_op.+x | sha256 | --file | $T/tm_g/level.pdl
CAPTURE | q1
RUN | $HOUSE/&.widgits/_shared-lib/ops/+x/hash_op.+x | sha256 | --file | $T/tm/teario/levels/first-steps.pdl
CAPTURE | q2
EXPECT_EQ | $q1 | $q2 | ONE-LEVEL-FORMAT-the-level-Make-exports-from-its-ledger-has-the-SAME-sha256-as-the-hand-written-fixture-Play-reads
EXPECT_EQ | $q1 | 97c779e1762ef3e4ad8141245cd4300adb7aa9bc6543f48c8ebf7272f2226234 | and-it-is-the-pinned-identity
RUN | cmp | $T/tm_g/level.pdl | $T/tm/teario/levels/first-steps.pdl
EXPECT_EXIT | 0 | byte-for-byte
RUN | cp | $T/tm_g/level.pdl | $T/tm_g/level.keep
RUN | rm | $T/tm_g/level.pdl
RUN | $HOUSE/&.widgits/_shared-lib/ops/+x/game_core.+x | $T/tm/teario-make | $T/tm_g | export
RUN | cmp | $T/tm_g/level.pdl | $T/tm_g/level.keep
EXPECT_EXIT | 0 | a-deleted-level-file-regenerates-byte-for-byte-(it-is-a-PROJECTION)
RUN | rm | $T/tm_g/level.keep
RUN | $HOUSE/&.widgits/_shared-lib/ops/+x/game_core.+x | $T/tm/teario-make | $T/tm_g | ui
RUN | $HOUSE/&.widgits/_shared-lib/ops/+x/game_core.+x | $T/tm/teario-make | $T/tm_g | audit
EXPECT_OUT | AUDIT ok files=4 declared=5 | the-audit-passes-with-ledger-ui-doc-and-level
WRITE   | tm_g/stray.txt | nobody declared me
RUN | $HOUSE/&.widgits/_shared-lib/ops/+x/game_core.+x | $T/tm/teario-make | $T/tm_g | audit
EXPECT_EXIT | 1 | NEGATIVE-a-stray-file-fails-the-audit
RUN | rm | $T/tm_g/stray.txt

