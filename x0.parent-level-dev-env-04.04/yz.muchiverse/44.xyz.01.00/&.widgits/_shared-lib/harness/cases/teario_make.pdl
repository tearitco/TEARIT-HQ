CASE    | tm_publish_needs_a_verified_clear
# the Play runs: a WIN of the fixture level (15 ticks), an UNFINISHED run, and a win of ANOTHER level (start moved to column 3, 14 ticks)
MKDIR   | tm_pw
MKDIR   | tm_po
MKDIR   | tm_pl
RUN | $HOUSE/&.widgits/_shared-lib/ops/+x/game_core.+x | $T/tm/teario-play | $T/tm_pw | new | 7
RUN | $HOUSE/&.widgits/_shared-lib/ops/+x/game_core.+x | $T/tm/teario-play | $T/tm_pw | join | H | human
RUN | $HOUSE/&.widgits/_shared-lib/ops/+x/game_core.+x | $T/tm/teario-play | $T/tm_pw | start
RUN | $HOUSE/&.widgits/_shared-lib/ops/+x/game_core.+x | $T/tm/teario-play | $T/tm_pw | input | p1 | right
RUN | $HOUSE/&.widgits/_shared-lib/ops/+x/game_core.+x | $T/tm/teario-play | $T/tm_pw | advance | 30
RUN | $HOUSE/&.widgits/_shared-lib/ops/+x/game_core.+x | $T/tm/teario-play | $T/tm_po | new | 7
RUN | $HOUSE/&.widgits/_shared-lib/ops/+x/game_core.+x | $T/tm/teario-play | $T/tm_po | join | H | human
RUN | $HOUSE/&.widgits/_shared-lib/ops/+x/game_core.+x | $T/tm/teario-play | $T/tm_po | start
RUN | $HOUSE/&.widgits/_shared-lib/ops/+x/game_core.+x | $T/tm/teario-play | $T/tm_po | input | p1 | right
RUN | $HOUSE/&.widgits/_shared-lib/ops/+x/game_core.+x | $T/tm/teario-play | $T/tm_po | advance | 5
RUN | cp | -r | $T/tm/teario | $T/tm/teario_other
RUN | cp | -r | $T/tm/teario-play | $T/tm/play_other
RUN | sed | -i | s#\.\./teario/#../teario_other/# | $T/tm/play_other/rulesets/default/board.pdl
RUN | sed | -i | s/^START \p 2 \p 10/START \p 3 \p 10/ | $T/tm/teario_other/levels/first-steps.pdl
RUN | cmp | $T/tm/teario/levels/first-steps.pdl | $T/tm/teario_other/levels/first-steps.pdl
EXPECT_EXIT | 1 | vacuity-the-other-level-differs
RUN | $HOUSE/&.widgits/_shared-lib/ops/+x/game_core.+x | $T/tm/play_other | $T/tm_pl | new | 7
RUN | $HOUSE/&.widgits/_shared-lib/ops/+x/game_core.+x | $T/tm/play_other | $T/tm_pl | join | H | human
RUN | $HOUSE/&.widgits/_shared-lib/ops/+x/game_core.+x | $T/tm/play_other | $T/tm_pl | start
RUN | $HOUSE/&.widgits/_shared-lib/ops/+x/game_core.+x | $T/tm/play_other | $T/tm_pl | input | p1 | right
RUN | $HOUSE/&.widgits/_shared-lib/ops/+x/game_core.+x | $T/tm/play_other | $T/tm_pl | advance | 30
RUN | $HOUSE/&.widgits/_shared-lib/ops/+x/game_core.+x | $T/tm/play_other | $T/tm_pl | verify_clear
EXPECT_OUT | ticks=14 | the-other-level-is-won-in-14-ticks-(a-clear-of-ANOTHER-level)
RUN | $HOUSE/&.widgits/_shared-lib/ops/+x/game_core.+x | $T/tm/teario-play | $T/tm_pw | verify_clear
EXPECT_OUT | CLEAR level=c33747c5fc30580b | the-fixture-level-hash-is-c33747c5fc30580b
RUN | $HOUSE/&.widgits/_shared-lib/ops/+x/game_core.+x | $T/tm/teario-make | $T/tm_g | publish
EXPECT_EXIT | 2 | NEGATIVE-PUBLISH-IS-REFUSED-WITHOUT-A-VERIFIED-CLEAR-REPLAY-ROW
EXPECT_OUT | no verified clear | and-says-so
RUN | $HOUSE/&.widgits/_shared-lib/ops/+x/game_core.+x | $T/tm/teario-make | $T/tm_g | clear | $T/tm/teario-play | $T/tm_po
EXPECT_EXIT | 2 | NEGATIVE-an-UNFINISHED-run-is-not-a-clear
EXPECT_OUT | not at the goal yet | and-says-why
RUN | $HOUSE/&.widgits/_shared-lib/ops/+x/game_core.+x | $T/tm/teario-make | $T/tm_g | clear | $T/tm/play_other | $T/tm_pl
EXPECT_EXIT | 2 | NEGATIVE-a-clear-of-ANOTHER-level-is-refused
EXPECT_OUT | the proof is for another level | and-says-so
RUN | $HOUSE/&.widgits/_shared-lib/ops/+x/game_core.+x | $T/tm/teario-make | $T/tm_g | clear | $T/tm/teario-play | $T/tm_nothing
EXPECT_EXIT | 2 | NEGATIVE-a-clear-from-a-folder-with-no-run
RUN | $HOUSE/&.widgits/_shared-lib/ops/+x/game_core.+x | $T/tm/teario-make | $T/tm_g | publish
EXPECT_EXIT | 2 | NEGATIVE-still-no-publish-after-the-three-refused-clears
RUN | $HOUSE/&.widgits/_shared-lib/ops/+x/game_core.+x | $T/tm/teario-make | $T/tm_g | ledger_hash
CAPTURE | q3
RUN | $HOUSE/&.widgits/_shared-lib/ops/+x/game_core.+x | $T/tm/teario-make | $T/tm_g | clear | $T/tm/teario-play | $T/tm_pw
EXPECT_EXIT | 0 | the-clear-of-THIS-level-is-recorded
EXPECT_OUT_IS | clear recorded: level=c33747c5fc30580b;run=3f4f5e9c18426e83;ticks=15 | with-level-run-and-ticks
RUN | $HOUSE/&.widgits/_shared-lib/ops/+x/game_core.+x | $T/tm/teario-make | $T/tm_g | ledger_hash
CAPTURE | q4
EXPECT_NE | $q3 | $q4 | vacuity-the-clear-DID-append-a-row-(the-refusals-before-appended-nothing)
RUN | $HOUSE/&.widgits/_shared-lib/ops/+x/game_core.+x | $T/tm/teario-make | $T/tm_g | publish
EXPECT_EXIT | 0 | PUBLISH-IS-ACCEPTED-AFTER-THE-VERIFIED-CLEAR
EXPECT_OUT | published doc=090de069773bcc19 rows=15 | with-the-doc-hash
RUN | grep | -c | -F | \pclear\p | $T/tm_g/ledger.txt
EXPECT_OUT_IS | 1 | exactly-one-clear-row
EXPECT_HAS | $T/tm_g/ledger.txt | EVENT\p17\pauthor\ppublish\p-\p15\pdoc=090de069773bcc19;level=c33747c5fc30580b;clear=3f4f5e9c18426e83 | the-publish-row-records-the-doc-hash-the-LEVEL-hash-and-the-clear-run-hash
RUN | $HOUSE/&.widgits/_shared-lib/ops/+x/game_core.+x | $T/tm/teario-make | $T/tm_g | check
EXPECT_OUT | CHECK ok | checks
RUN | $HOUSE/&.widgits/_shared-lib/ops/+x/game_core.+x | $T/tm/teario-make | $T/tm_g | replay
CAPTURE | q5
# editing the level AFTER the clear: the clear no longer proves it
RUN | $HOUSE/&.widgits/_shared-lib/ops/+x/game_core.+x | $T/tm/teario-make | $T/tm_g | set | start | 3 10
RUN | $HOUSE/&.widgits/_shared-lib/ops/+x/game_core.+x | $T/tm/teario-make | $T/tm_g | publish
EXPECT_EXIT | 2 | NEGATIVE-a-level-edited-AFTER-its-clear-cannot-be-published
EXPECT_OUT | another version of the level | and-says-so
RUN | $HOUSE/&.widgits/_shared-lib/ops/+x/game_core.+x | $T/tm/teario-make | $T/tm_g | clear | $T/tm/teario-play | $T/tm_pw
EXPECT_EXIT | 2 | NEGATIVE-the-OLD-run-is-no-proof-for-the-edited-level-(its-level-hash-differs)
RUN | $HOUSE/&.widgits/_shared-lib/ops/+x/game_core.+x | $T/tm/teario-make | $T/tm_g | clear | $T/tm/play_other | $T/tm_pl
EXPECT_EXIT | 0 | but-a-run-won-on-the-EDITED-level-IS-(the-other-level-is-exactly-the-edited-one)
RUN | $HOUSE/&.widgits/_shared-lib/ops/+x/game_core.+x | $T/tm/teario-make | $T/tm_g | publish
EXPECT_EXIT | 0 | and-then-the-edited-level-publishes
RUN | $HOUSE/&.widgits/_shared-lib/ops/+x/game_core.+x | $T/tm/teario-make | $T/tm_g | check
EXPECT_OUT | CHECK ok | still-checks
RUN | $HOUSE/&.widgits/_shared-lib/ops/+x/game_core.+x | $T/tm/teario-make | $T/tm_g | replay
EXPECT_EXIT | 0 | and-replays

