# dust_seed: LOCKED cases for rpg-dust R1. Source under test: @.apps/rpg-dust/ops/dust_seed.c. Expected values were taken from the first run of the op and pinned; mix(0) is the published splitmix64 anchor, so the hash is checked against an outside value, the rest against itself across runs. Same command twice must give the same bytes; a different seed, key, order or coordinate must give different bytes.
RESULTS | ../results/dust_seed.txt
CASE | dust-seed
SCRATCH |
COPY | @.apps/rpg-dust/ops/dust_seed.c | dust_seed.c
RUN | gcc | -std=gnu11 | -Wall | -Wextra | -Werror | -O2 | -o | $T/ds.+x | $T/dust_seed.c
EXPECT_EXIT | 0 | compiles-clean
RUN | $T/ds.+x | mix | 0
EXPECT_EXIT | 0 | splitmix64-anchor-exit
EXPECT_OUT_IS | e220a8397b1dcdaf | splitmix64-anchor
RUN | $T/ds.+x | mix | 1
EXPECT_EXIT | 0 | mix-1-exit
EXPECT_OUT_IS | 910a2dec89025cc1 | mix-1
RUN | $T/ds.+x | mix | 18446744073709551615
EXPECT_EXIT | 0 | mix-max-exit
EXPECT_OUT_IS | e4d971771b652c20 | mix-max
