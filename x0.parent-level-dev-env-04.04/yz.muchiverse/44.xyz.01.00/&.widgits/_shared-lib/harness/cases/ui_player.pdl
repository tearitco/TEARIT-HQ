WRITE | live.cues | 99999999990 1 activate\n
WRITE | live.set | sound_volume=33\n
SPAWN | pl | $T/usp.+x | --pdl | $T/ui_sounds.pdl | --sounds | $T/snd | --settings | $T/live.set | --cues | $T/live.cues | --dry-run | $T/live.log
SLEEP | 250
EXPECT_ALIVE | $pl | live-player-running
APPEND | live.cues | 99999999999 7 nav_move\n
WAIT_HAS | live.log | played nav_move theme=soft vol=33 | 1500 | live-new-cue-played-with-live-settings
EXPECT_LACKS | live.log | played activate | old-cue-not-replayed-at-start
APPEND | live.set | sound_enabled=0\n
APPEND | live.cues | 99999999998 7 refused\n
WAIT_HAS | live.log | skip muted refused | 1500 | live-mute-takes-effect-without-restart
WRITE | trunc.cues | \n
WRITE | trunc.set | \n
