# ui_player: LOCKED cases for U2 of BOOK 19.audio/UI-SOUNDS-AND-STARTUP-DESIGN.md. Source under test: &.widgits/ui-sounds/ops/ui_sound_player.c (--dry-run: decisions only, no sound server, so nothing is heard). Each drain case writes a cue file and a settings file, runs the player once over it and compares the WHOLE log. Live cases spawn the player and append cues. NOT tested: real playback (nobody has listened), the first-cue delay of a suspended sink.
RESULTS | ../results/ui_player.txt
CASE | ui-player
SCRATCH |
MKDIR | sys
COPY | &.widgits/ui-sounds/ops/ui_sound_render.c | ui_sound_render.c
COPY | &.widgits/ui-sounds/ops/ui_sound_player.c | ui_sound_player.c
COPY | &.widgits/_shared-lib/audio_dsp.c | sys/audio_dsp.c
COPY | &.widgits/ui-sounds/ui_sounds.pdl | ui_sounds.pdl
RUN | gcc | -std=gnu11 | -Wall | -Wextra | -Werror | -O2 | -isystem | $T/sys | -o | $T/usr.+x | $T/ui_sound_render.c | -lm
EXPECT_EXIT | 0 | render-compiles
RUN | gcc | -std=gnu11 | -Wall | -Wextra | -Werror | -O2 | -isystem | $T/sys | -o | $T/usp.+x | $T/ui_sound_player.c | -lpulse-simple | -lpulse | -lm
EXPECT_EXIT | 0 | player-compiles
RUN | $T/usr.+x | $T/ui_sounds.pdl | $T/snd
EXPECT_EXIT | 0 | sounds-rendered
WRITE | c1.cues | 1000 1 nav_move\n
RUN | $T/usp.+x | --pdl | $T/ui_sounds.pdl | --sounds | $T/snd | --settings | $T/none.set | --cues | $T/c1.cues | --dry-run | $T/c1.log | --drain
EXPECT_EXIT | 0 | default-settings-play-exit
EXPECT_FILE | c1.log | played nav_move theme=soft vol=40 latency_ms=0\n | default-settings-play
WRITE | c2.cues | 1000 1 nav_move\n1000 1 startup\n
WRITE | c2.set | sound_enabled=0\n
RUN | $T/usp.+x | --pdl | $T/ui_sounds.pdl | --sounds | $T/snd | --settings | $T/c2.set | --cues | $T/c2.cues | --dry-run | $T/c2.log | --drain
EXPECT_EXIT | 0 | muted-everything-exit
EXPECT_FILE | c2.log | skip muted nav_move\nskip muted startup\n | muted-everything
WRITE | c3.cues | 1000 1 activate\n1000 1 startup\n
WRITE | c3.set | sound_ui=0\n
RUN | $T/usp.+x | --pdl | $T/ui_sounds.pdl | --sounds | $T/snd | --settings | $T/c3.set | --cues | $T/c3.cues | --dry-run | $T/c3.log | --drain
EXPECT_EXIT | 0 | ui-off-startup-still-plays-exit
EXPECT_FILE | c3.log | skip ui_off activate\nplayed startup theme=soft vol=40 latency_ms=0\n | ui-off-startup-still-plays
WRITE | c4.cues | 1000 1 activate\n1000 1 startup\n
WRITE | c4.set | sound_startup=0\n
RUN | $T/usp.+x | --pdl | $T/ui_sounds.pdl | --sounds | $T/snd | --settings | $T/c4.set | --cues | $T/c4.cues | --dry-run | $T/c4.log | --drain
EXPECT_EXIT | 0 | startup-off-ui-still-plays-exit
EXPECT_FILE | c4.log | played activate theme=soft vol=40 latency_ms=0\nskip startup_off startup\n | startup-off-ui-still-plays
WRITE | c5.cues | 1000 1 nav_move\n
WRITE | c5.set | \n
