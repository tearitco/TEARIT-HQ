# quest q002 weighted_pick: LOCKED cases (worker may not edit). Expected values come from an independent Python reference of the spec.
RESULTS | ../results/quest_q002_weighted_pick.txt
CASE | quest-q002-wp
SCRATCH |
COPY | &.widgits/quest-pilot/q002-weighted-pick/worker/weighted_pick.c | wp.c
RUN | gcc | -std=gnu11 | -Wall | -Wextra | -Werror | -O2 | -o | $T/wp.+x | $T/wp.c
EXPECT_EXIT | 0 | compiles-clean
