RUN | $T/lc.+x | $T | cmd | g1 | advance | 30d
RUN | $T/lc.+x | $T | step | 0
RUN | $T/lc.+x | $T | sched-count | r1
EXPECT_OUT_IS | 30 | 30-day-fast-forward-fires-exactly-30-ticks
RUN | /usr/bin/grep | -c | ^DAY | $T/game/conductor/eden_history.txt
