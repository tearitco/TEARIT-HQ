MKDIR   | game/conductor/ops/+x
COPY    | &.widgits/eden/ops/+x/eden_op.+x | game/conductor/ops/+x/eden_op.+x
MKDIR   | common_events
RUN | /usr/bin/cp | -r | $HOUSE/&.widgits/eden/common_events/eden_day_tick | $T/common_events/eden_day_tick
RUN | /usr/bin/gcc | -O2 | -w | -o | $T/prisc | $HOUSE/&.widgits/_shared-lib/system/prisc+x.c | -lm
ENV | EVENT_PAGE_PRISC | $T/prisc
ENV | EVENT_PAGE_TRIGGER | parallel
ENV | LC_CLOCK_NO_POPUP | 1
ENV | LC_CLOCK_EVENT_RUNNER | $T/&.widgits/digipet/ops/+x/event_page_op.+x
MKDIR   | h2
COPY    | &.widgits/livedesk-clock/ops/+x/lc_clock.+x | h2/lc.+x
MKDIR   | h2/common_events
RUN | /usr/bin/cp | -r | $HOUSE/&.widgits/eden/common_events/eden_day_tick | $T/h2/common_events/eden_day_tick
WRITE   | h2/common_events/eden_day_tick/event_pkg/target.pdl | TARGET | state | ../game2/conductor
MKDIR   | game2
RUN | /usr/bin/cp | -r | $T/game/conductor | $T/game2/conductor
WRITE   | game2/conductor/wiring.pdl | WIRING | lc_clock | ../../h2/lc.+x\nWIRING | house | ../../h2\nWIRING | clock | g1\nWIRING | first_ms | 86400000\nWIRING | repeat | every:1day\nWIRING | start_rate | x86400\nWIRING | participants | ../participants\nWIRING | template | participant_template\nWIRING | tree | ..\nWIRING | control_ledger | ../../eden_control_game2.txt
RUN | /bin/sh | -c | exec "$1/&.widgits/digipet/ops/+x/event_page_op.+x" "$0" "$1" --trigger setup | $T/game/conductor | $T
RUN | $T/game2/conductor/ops/+x/eden_op.+x | $T/game2/conductor | setup
RUN | $T/lc.+x | $T | cmd | g1 | advance | 8d
RUN | $T/lc.+x | $T | step | 0
EXPECT_HAS | game/conductor/variables.txt | day=8\n | clock-run-to-day-8
RUN | $T/game/conductor/ops/+x/eden_op.+x | $T/game/conductor | digest
CAPTURE | d_save
RUN | /bin/sh | -c | exec "$1/&.widgits/digipet/ops/+x/event_page_op.+x" "$0" "$1" --trigger save1 | $T/game/conductor | $T
EXPECT_EXIT | 0 | Save-1-row-fires-the-save-page
EXPECT_EXISTS | store/checkpoints/slot1/manifest.txt | the-checkpoint-slot1-exists
EXPECT_HAS | eden_control.txt | SAVE\pslot1 | control-ledger-has-a-SAVE-row
RUN | $T/gso | $T/store | $T/game | list
EXPECT_OUT | slot1 | game_snapshot_op-lists-slot1
RUN | $T/lc.+x | $T | cmd | g1 | advance | 4d
RUN | $T/lc.+x | $T | step | 0
RUN | $T/game/conductor/ops/+x/eden_op.+x | $T/game/conductor | add
RUN | $T/game/conductor/ops/+x/eden_op.+x | $T/game/conductor | act | asa | rest
EXPECT_HAS | game/conductor/variables.txt | day=12\n | mutated-to-day-12
EXPECT_HAS | game/participants/eli/pal.pdl | eli | a-third-participant-exists-before-the-load
RUN | $T/game/conductor/ops/+x/eden_op.+x | $T/game/conductor | digest
CAPTURE | d_mut
EXPECT_NE | $d_save | $d_mut | the-state-really-changed
RUN | /bin/sh | -c | exec "$1/&.widgits/digipet/ops/+x/event_page_op.+x" "$0" "$1" --trigger load1 | $T/game/conductor | $T
EXPECT_EXIT | 0 | Load-1-row-fires-the-load-page
RUN | $T/game/conductor/ops/+x/eden_op.+x | $T/game/conductor | digest
CAPTURE | d_load
EXPECT_EQ | $d_save | $d_load | load-restores-the-exact-saved-state-trees-equal
EXPECT_NOFILE | game/participants/eli/pal.pdl | participants-added-after-the-save-are-pruned
EXPECT_HAS | game/conductor/variables.txt | day=8\n | day-8-again
RUN | $T/lc.+x | $T | sched-count | r1
EXPECT_OUT_IS | 8 | clock-ledger-restored-8-rows
RUN | $T/lc.+x | $T | step | 0
RUN | $T/lc.+x | $T | step | 3600000
RUN | $T/lc.+x | $T | sched-count | r1
EXPECT_OUT_IS | 8 | stepping-after-load-refires-nothing
EXPECT_HAS | game/conductor/variables.txt | day=8\n | no-tick-double-applied
RUN | /usr/bin/grep | -c | ^DAY | $T/game/conductor/eden_history.txt
EXPECT_OUT_IS | 8 | 8-DAY-rows-after-load
RUN | $T/lc.+x | $T | cmd | g1 | advance | 12d
RUN | $T/lc.+x | $T | step | 0
RUN | $T/lc.+x | $T | sched-count | r1
EXPECT_OUT_IS | 20 | continued-to-20-ticks
RUN | /usr/bin/grep | -c | ^DAY | $T/game/conductor/eden_history.txt
EXPECT_OUT_IS | 20 | exactly-20-DAY-rows-no-duplicates
RUN | $T/game2/conductor/ops/+x/eden_op.+x | $T/game2/conductor | daytick
RUN | $T/game2/conductor/ops/+x/eden_op.+x | $T/game2/conductor | daytick
