EXPECT_HAS | game/participants/asa/acts_menu.pdl | Act: rest | generated-menu-has-an-Act-rest-row
EXPECT_LACKS | game/participants/asa/acts_menu.pdl | Act: eat | generated-menu-has-no-eat-row-while-not-hungry
RUN | /bin/sh | -c | exec "$0/../../conductor/ops/+x/eden_op.+x" "$0/../../conductor" act asa plant | $T/game/participants/asa
EXPECT_EXIT | 0 | menu-row-command-runs-by-sh-c
EXPECT_HAS | game/participants/asa/variables.txt | plot_1_state=1\n | menu-row-planted-plot-1
EXPECT_HAS | game/participants/asa/items.txt | item_seed=4\n | menu-row-spent-a-seed
