# eden_conductor (GAME-CONDUCTOR-ENTITY-AND-EDEN-DESIGN.md section 7): the Eden conductor v0 on scratch roots only. Real eden_op, real lc_clock (schedule row
# common:eden_day_tick, repeat=every:1day), real event pages through event_page_op with a prisc compiled into scratch, real game_snapshot_op, real METHOD strings from meta.pdl.
# Participants asa and ava are SCRATCH entities spawned from the template: nothing here names a live desk or xyzfs/users.
RESULTS | ../results/eden_conductor.txt

CASE    | toy-format
SCRATCH |
COPY    | &.widgits/eden/ops/+x/eden_op.+x | eden_op.+x
COPY    | &.widgits/eden/toy.pdl | toy.pdl
COPY    | &.widgits/eden/conductor/button.sh | button.sh
COPY    | @.apps/csv-hq/toy.pdl | csvtoy.pdl
RUN | $T/eden_op.+x | $T | toyread | $T/toy.pdl | title
EXPECT_OUT_IS | Eden | taskbar-reads-title-Eden
RUN | $T/eden_op.+x | $T | toyread | $T/toy.pdl | launch
EXPECT_OUT_IS | conductor/button.sh | taskbar-reads-launch-conductor-button-sh
EXPECT_EXISTS | button.sh | launch-target-exists-under-the-toy-dir
RUN | $T/eden_op.+x | $T | toyread | $T/csvtoy.pdl | title
EXPECT_OUT_IS | csv-hq | reader-agrees-on-an-existing-real-toy
RUN | $T/eden_op.+x | $T | toyread | $T/csvtoy.pdl | launch
EXPECT_OUT_IS | button.sh | reader-agrees-on-an-existing-real-toy-launch
EXPECT_HAS | toy.pdl | SECTION | rows-use-the-SECTION-tag-like-every-real-toy
WRITE   | meta_form.pdl | META | title | Eden\nMETA | launch | conductor/button.sh
RUN | $T/eden_op.+x | $T | toyread | $T/meta_form.pdl | title
EXPECT_EXIT | 1 | GAP-META-tagged-rows-are-skipped-by-the-taskbar-so-toy-pdl-must-use-SECTION
CLEAN   |

CASE    | meta-rows
SCRATCH |
COPY    | &.widgits/eden/conductor/meta.pdl | meta.pdl
COPY    | &.widgits/eden/conductor/glyph.txt | glyph.txt
EXPECT_HAS | meta.pdl | \p Setup | meta-row-setup
EXPECT_HAS | meta.pdl | --trigger setup'| meta-row-fires-trigger-setup
EXPECT_HAS | meta.pdl | \p Start | meta-row-start
EXPECT_HAS | meta.pdl | --trigger start'| meta-row-fires-trigger-start
EXPECT_HAS | meta.pdl | \p Pause | meta-row-pause
EXPECT_HAS | meta.pdl | --trigger pause'| meta-row-fires-trigger-pause
EXPECT_HAS | meta.pdl | \p Resume | meta-row-resume
EXPECT_HAS | meta.pdl | --trigger resume'| meta-row-fires-trigger-resume
EXPECT_HAS | meta.pdl | \p Save 1 | meta-row-save1
EXPECT_HAS | meta.pdl | --trigger save1'| meta-row-fires-trigger-save1
EXPECT_HAS | meta.pdl | \p Load 1 | meta-row-load1
EXPECT_HAS | meta.pdl | --trigger load1'| meta-row-fires-trigger-load1
EXPECT_HAS | meta.pdl | \p Status | meta-row-status
EXPECT_HAS | meta.pdl | --trigger status'| meta-row-fires-trigger-status
EXPECT_HAS | meta.pdl | \p Add participant | meta-row-add
EXPECT_HAS | meta.pdl | --trigger add'| meta-row-fires-trigger-add
EXPECT_HAS | meta.pdl | \p Remove participant | meta-row-remove
EXPECT_HAS | meta.pdl | --trigger remove'| meta-row-fires-trigger-remove
EXPECT_HAS | meta.pdl | \p Reset | meta-row-reset
EXPECT_HAS | meta.pdl | --trigger reset'| meta-row-fires-trigger-reset
EXPECT_HAS | glyph.txt | 🔘 | conductor-glyph
CLEAN   |

CASE    | setup-idempotent-reset
SCRATCH |
COPY    | &.widgits/livedesk-clock/ops/+x/lc_clock.+x | lc.+x
COPY    | &.widgits/_shared-lib/ops/+x/game_snapshot_op.+x | gso
MKDIR   | &.widgits/digipet/ops/+x
COPY    | &.widgits/digipet/ops/+x/event_page_op.+x | &.widgits/digipet/ops/+x/event_page_op.+x
MKDIR   | game
RUN | /usr/bin/cp | -r | $HOUSE/&.widgits/eden/conductor | $T/game/conductor
MKDIR   | game/conductor/ops/+x
COPY    | &.widgits/eden/ops/+x/eden_op.+x | game/conductor/ops/+x/eden_op.+x
MKDIR   | common_events
RUN | /usr/bin/cp | -r | $HOUSE/&.widgits/eden/common_events/eden_day_tick | $T/common_events/eden_day_tick
WRITE   | game/conductor/wiring.pdl | WIRING | participants | ../participants\nWIRING | template | participant_template\nWIRING | tree | ..\nWIRING | control_ledger | ../../eden_control.txt
EXPECT_NOFILE | game/participants/asa/pal.pdl | no-entities-before-setup
RUN | $T/game/conductor/ops/+x/eden_op.+x | $T/game/conductor | setup
EXPECT_EXIT | 0 | setup-ok
EXPECT_HAS | game/participants/asa/pal.pdl | PAL \p name \p asa | asa-spawned-from-the-template
EXPECT_HAS | game/participants/ava/pal.pdl | PAL \p name \p ava | ava-spawned-from-the-template
EXPECT_HAS | game/participants/asa/instance_id.txt | ED1 | asa-fresh-identity-ED1
EXPECT_HAS | game/participants/ava/instance_id.txt | ED2 | ava-fresh-identity-ED2
EXPECT_LACKS | game/participants/asa/pal.pdl | hash | no-copied-PAL-hash
EXPECT_NOFILE | game/participants/asa/entity_uid.txt | no-copied-entity-uid
EXPECT_HAS | game/participants/asa/items.txt | item_seed=5\n | asa-seed-x5
EXPECT_HAS | game/participants/asa/items.txt | item_jug=1\n | asa-jug
EXPECT_HAS | game/participants/asa/items.txt | item_hoe=1\n | asa-hoe
EXPECT_HAS | game/participants/asa/items.txt | item_apple=2\n | asa-own-apples-untouched-by-grants
EXPECT_HAS | game/participants/ava/items.txt | item_seed=5\n | ava-seed-x5
EXPECT_HAS | game/participants/asa/actor_skills.txt | skill_1:plant=1\n | asa-skill-plant
EXPECT_HAS | game/participants/asa/actor_skills.txt | skill_1:trade=1\n | asa-skill-trade
EXPECT_HAS | game/participants/asa/actor_1_stats.txt | hp=20\n | asa-hp-20
EXPECT_HAS | game/participants/asa/actor_1_stats.txt | mhp=20\n | asa-mhp-20
RUN | /usr/bin/grep | -c | ^GRANT | $T/game/conductor/grants.txt
EXPECT_OUT_IS | 28 | 28-GRANT-rows-2-entities-x-14-kit-entries
RUN | $T/game/conductor/ops/+x/eden_op.+x | $T/game/conductor | digest
CAPTURE | d1
RUN | $T/game/conductor/ops/+x/eden_op.+x | $T/game/conductor | setup
EXPECT_EXIT | 0 | second-setup-ok
RUN | $T/game/conductor/ops/+x/eden_op.+x | $T/game/conductor | digest
CAPTURE | d2
EXPECT_EQ | $d1 | $d2 | second-setup-changes-nothing-grants-once
RUN | /usr/bin/grep | -c | ^GRANT | $T/game/conductor/grants.txt
EXPECT_OUT_IS | 28 | still-28-GRANT-rows
RUN | $T/game/conductor/ops/+x/eden_op.+x | $T/game/conductor | reset
EXPECT_EXIT | 0 | reset-ok
EXPECT_HAS | game/participants/asa/items.txt | item_seed=0\n | reset-takes-back-the-seeds
EXPECT_HAS | game/participants/asa/items.txt | item_jug=0\n | reset-takes-back-the-jug
EXPECT_HAS | game/participants/asa/items.txt | item_apple=2\n | reset-leaves-the-own-apples
EXPECT_HAS | game/participants/asa/actor_skills.txt | skill_1:plant=0\n | reset-takes-back-the-skill
EXPECT_HAS | game/participants/asa/actor_1_stats.txt | hp=10\n | reset-restores-hp-10
EXPECT_HAS | game/participants/asa/actor_1_stats.txt | mhp=10\n | reset-restores-mhp-10
EXPECT_FILE | game/participants/asa/own/notes.txt | asa keeps this note. The game never writes here.\n | own-data-file-untouched
RUN | /usr/bin/grep | -c | ^REVOKE | $T/game/conductor/grants.txt
EXPECT_OUT_IS | 28 | 28-REVOKE-rows-exactly-the-grants
EXPECT_HAS | game/conductor/variables.txt | setup_done=0\n | reset-clears-setup-done
RUN | $T/game/conductor/ops/+x/eden_op.+x | $T/game/conductor | setup
EXPECT_HAS | game/participants/asa/items.txt | item_seed=5\n | setup-after-reset-grants-again
RUN | /usr/bin/grep | -c | ^GRANT | $T/game/conductor/grants.txt
EXPECT_OUT_IS | 56 | 56-GRANT-rows-after-the-second-setup
RUN | $T/game/conductor/ops/+x/eden_op.+x | $T/game/conductor | daytick
RUN | $T/game/conductor/ops/+x/eden_op.+x | $T/game/conductor | daytick
RUN | $T/game/conductor/ops/+x/eden_op.+x | $T/game/conductor | daytick
RUN | $T/game/conductor/ops/+x/eden_op.+x | $T/game/conductor | reset
EXPECT_HAS | game/participants/asa/items.txt | item_seed=0\n | reset-after-play-seeds-0
EXPECT_LACKS | game/participants/asa/items.txt | =-1 | reset-after-play-no-negative-items
RUN | $T/game/conductor/ops/+x/eden_op.+x | $T/game/conductor | audit
EXPECT_OUT | AUDIT\pok=1 | audit-ok-after-reset-after-play
EXPECT_FILE | game/participants/ava/own/notes.txt | ava keeps this note. The game never writes here.\n | ava-own-data-untouched
CLEAN   |

