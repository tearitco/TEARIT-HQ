# taskbar_harness_menu: the top taskbar's "harness" cell (cell 11, 2026-11-07, replaced the inert "plugins" cell) is wired end to end by DATA and ONE op (decisions D51 and D52): the strip label, the global rows in
# #.desktop/harness_menu.pdl (read by harness_menu_op, NOT by livedesk_taskbar.pdl any more), and the manager's cell-11 dispatch, list builder and run verb. WIRING ONLY: the click itself needs the live taskbar rebuilt and
# relaunched (not done by this case). The op's own behaviour is proved by the case harness_menu.
# NOTE: each case has SCRATCH because the runner silently DROPS an EXPECT_HAS/EXPECT_LACKS row when there is no scratch dir (harness_case_op.c line 283, found 2026-11-07), and big files go through RUN grep + EXPECT_EXIT (16 KB read limit).
RESULTS | ../results/taskbar_harness_menu.txt
ENV | LC_ALL | C

CASE    | strip
SCRATCH |
EXPECT_HAS | $HOUSE/_.monads/_.livedesk-taskbar/khtpm_strip_header.xhtpm | id="strip-cell-11" label="tools" | the-top-strip-cell-11-says-tools-the-id-stays-harness
RUN | /usr/bin/grep | -c | label="plugins" | $HOUSE/_.monads/_.livedesk-taskbar/khtpm_strip_header.xhtpm
EXPECT_EXIT | 1 | NEGATIVE-the-old-plugins-label-is-gone

CASE    | one_authority
SCRATCH |
RUN | /usr/bin/grep | -c | harness_menu_ | $HOUSE/#.desktop/livedesk_taskbar.pdl
EXPECT_EXIT | 1 | NEGATIVE-the-old-harness-rows-are-gone-from-livedesk_taskbar-so-there-is-one-list-not-two
RUN | /usr/bin/grep | -c | ^HARNESS | $HOUSE/#.desktop/harness_menu.pdl
EXPECT_OUT | 8 | the-global-file-has-the-eight-rows-since-2026-11-11
RUN | $HOUSE/&.widgits/_shared-lib/ops/+x/harness_menu_op.+x | list | $HOUSE | - | - | $T/rows.txt
EXPECT_EXIT | 0 | the-op-lists-the-real-global-rows
EXPECT_HAS | rows.txt | run all | and-the-run-all-row-is-one-of-them
EXPECT_LACKS | rows.txt | deskopoly | NEGATIVE-other-games-stay-out-of-the-global-list-by-design-2026-11-11

CASE    | manager
SCRATCH |
# the manager source is thousands of lines and EXPECT_HAS reads only the first 16 KB, so these use grep -qF and the exit code
RUN | /usr/bin/grep | -qF | strcmp(cid, "harness") == 0 \p\p which == 11 | $HOUSE/_.monads/_.livedesk-taskbar/ops/khtpm_taskbar_manager.c
EXPECT_EXIT | 0 | cell-11-opens-the-harness-menu
RUN | /usr/bin/grep | -qF | "livedesk:run-harness:", 21 | $HOUSE/_.monads/_.livedesk-taskbar/ops/khtpm_taskbar_manager.c
EXPECT_EXIT | 0 | the-run-verb-is-dispatched
RUN | /usr/bin/grep | -qF | harness_menu_op.+x | $HOUSE/_.monads/_.livedesk-taskbar/ops/khtpm_taskbar_manager.c
EXPECT_EXIT | 0 | and-it-goes-through-the-one-op
RUN | /usr/bin/grep | -qF | cpu_gate.+x\" \"%s\" run harness- | $HOUSE/_.monads/_.livedesk-taskbar/ops/khtpm_taskbar_manager.c
EXPECT_EXIT | 1 | NEGATIVE-the-manager-no-longer-builds-its-own-cpu_gate-shell-string
RUN | /usr/bin/grep | -qF | livedesk_build_prefixed_menu(house_root, menu, max, "harness") | $HOUSE/_.monads/_.livedesk-taskbar/ops/khtpm_taskbar_manager.c
EXPECT_EXIT | 1 | NEGATIVE-and-no-longer-reads-harness-rows-from-livedesk_taskbar-pdl
RUN | /usr/bin/grep | -qF | cell-11-nonexistent-zz | $HOUSE/_.monads/_.livedesk-taskbar/ops/khtpm_taskbar_manager.c
EXPECT_EXIT | 1 | NEGATIVE-a-string-that-is-not-there-is-not-found

CASE    | cancel_and_name
SCRATCH |
# seen live 2026-11-07: the generic notes-<cell> row is inserted ONE SLOT ABOVE the trailing row of every cell menu, so a menu with no trailing cancel row got notes-hq above its last real row, and cell 11 had no name in the fallback table
RUN | /usr/bin/grep | -qF | snprintf(menu[count].label, sizeof(menu[count].label), "cancel"); menu[count].command[0] = '\0'; | $HOUSE/_.monads/_.livedesk-taskbar/ops/khtpm_taskbar_manager.c
EXPECT_EXIT | 0 | the-harness-list-ends-with-a-cancel-row
RUN | /usr/bin/grep | -qF | case 11: nm = "harness"; | $HOUSE/_.monads/_.livedesk-taskbar/ops/khtpm_taskbar_manager.c
EXPECT_EXIT | 0 | cell-11-has-its-own-name-so-the-notes-row-says-notes-harness
RUN | /usr/bin/grep | -qF | case 11: nm = "plugins"; | $HOUSE/_.monads/_.livedesk-taskbar/ops/khtpm_taskbar_manager.c
EXPECT_EXIT | 1 | NEGATIVE-the-old-plugins-name-is-not-there

CASE    | tools-cell-mirrors-the-editor-tab
SCRATCH |
# 2026-11-14 (D74): the top Tools cell lists for the OPEN BOOK AND PAGE like the editor tab (plug rows and page tools show), and its pick path passes them and accepts a plug id. WIRING ONLY (a click needs the relaunched desktop).
RUN | /usr/bin/grep | -qF | ktb_open_book_page(house_root, ob | $HOUSE/_.monads/_.livedesk-taskbar/ops/khtpm_taskbar_manager.c
EXPECT_EXIT | 0 | the-list-is-built-for-the-open-book-and-page
RUN | /usr/bin/grep | -qF | ob[0] ? ob : "-", op2[0] ? op2 : "-", rows | $HOUSE/_.monads/_.livedesk-taskbar/ops/khtpm_taskbar_manager.c
EXPECT_EXIT | 0 | and-passes-them-to-the-list-op
RUN | /usr/bin/grep | -qF | ktb_open_book_page(s->house_root, pb | $HOUSE/_.monads/_.livedesk-taskbar/ops/khtpm_taskbar_manager.c
EXPECT_EXIT | 0 | the-pick-passes-the-same-book-and-page
RUN | /usr/bin/grep | -qF | *p == ':' | $HOUSE/_.monads/_.livedesk-taskbar/ops/khtpm_taskbar_manager.c
EXPECT_EXIT | 0 | the-pick-accepts-a-plug-id-with-its-colon
RUN | /usr/bin/grep | -cF | "list", house_root, "-", "-", rows | $HOUSE/_.monads/_.livedesk-taskbar/ops/khtpm_taskbar_manager.c
EXPECT_OUT | 0 | NEGATIVE-the-old-call-with-no-book-and-no-page-is-gone
RUN | /usr/bin/grep | -cF | pick \"%s\" - - | $HOUSE/_.monads/_.livedesk-taskbar/ops/khtpm_taskbar_manager.c
EXPECT_OUT | 0 | NEGATIVE-the-old-pick-with-no-book-and-no-page-is-gone
RUN | /usr/bin/grep | -qF | livedesk_current_session_name(house_root, b, sizeof(b)) | $HOUSE/_.monads/_.livedesk-taskbar/ops/khtpm_taskbar_manager.c
EXPECT_EXIT | 0 | the-book-is-the-one-the-bar-shows-not-the-editors
RUN | /usr/bin/grep | -c | board_window.pid | $HOUSE/_.monads/_.livedesk-taskbar/ops/khtpm_taskbar_manager.c
EXPECT_OUT | 0 | NEGATIVE-the-editor-board-state-is-no-longer-read

CASE    | cancel-row-with-zero-rows-and-restart-chime
SCRATCH |
# 2026-11-14 owner: (1) a book with nothing listed had NO cancel row (the manager added it only when count > 0), so no notes row either; (2) a restart from the HQ dropdown played no music: the relaunch row started the player with `run` (no chime), only `boot` plays it.
RUN | /usr/bin/grep | -qF | if (count < max) { snprintf(menu[count].label, sizeof(menu[count].label), "cancel"); | $HOUSE/_.monads/_.livedesk-taskbar/ops/khtpm_taskbar_manager.c
EXPECT_EXIT | 0 | cancel-is-added-even-with-zero-rows
RUN | /usr/bin/grep | -cF | if (count > 0 && count < max) | $HOUSE/_.monads/_.livedesk-taskbar/ops/khtpm_taskbar_manager.c
EXPECT_OUT | 0 | NEGATIVE-the-old-only-when-rows-exist-condition-is-gone
RUN | /usr/bin/grep | -qF | start_player.sh' boot | $HOUSE/$.crypts/close_on_restart.pdl
EXPECT_EXIT | 0 | the-restart-relaunch-of-the-sound-player-uses-boot-so-it-chimes
RUN | /usr/bin/grep | -qF | start_player.sh' run | $HOUSE/$.crypts/close_on_restart.pdl
EXPECT_EXIT | 1 | NEGATIVE-the-silent-run-mode-is-not-used-for-the-restart-relaunch
