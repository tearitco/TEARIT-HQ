# taskbar_harness_menu: the top taskbar's "harness" cell (cell 11, 2026-11-07, replaced the inert "plugins" cell) is wired end to end by DATA and ONE op (decisions D51 and D52): the strip label, the global rows in
# #.desktop/harness_menu.pdl (read by harness_menu_op, NOT by livedesk_taskbar.pdl any more), and the manager's cell-11 dispatch, list builder and run verb. WIRING ONLY: the click itself needs the live taskbar rebuilt and
# relaunched (not done by this case). The op's own behaviour is proved by the case harness_menu.
# NOTE: each case has SCRATCH because the runner silently DROPS an EXPECT_HAS/EXPECT_LACKS row when there is no scratch dir (harness_case_op.c line 283, found 2026-11-07), and big files go through RUN grep + EXPECT_EXIT (16 KB read limit).
RESULTS | ../results/taskbar_harness_menu.txt
ENV | LC_ALL | C

CASE    | strip
SCRATCH |
EXPECT_HAS | $HOUSE/_.monads/_.livedesk-taskbar/khtpm_strip_header.xhtpm | id="strip-cell-11" label="harness" | the-top-strip-cell-11-says-harness
RUN | /usr/bin/grep | -c | label="plugins" | $HOUSE/_.monads/_.livedesk-taskbar/khtpm_strip_header.xhtpm
EXPECT_EXIT | 1 | NEGATIVE-the-old-plugins-label-is-gone

CASE    | one_authority
SCRATCH |
RUN | /usr/bin/grep | -c | harness_menu_ | $HOUSE/#.desktop/livedesk_taskbar.pdl
EXPECT_EXIT | 1 | NEGATIVE-the-old-harness-rows-are-gone-from-livedesk_taskbar-so-there-is-one-list-not-two
RUN | /usr/bin/grep | -c | ^HARNESS | $HOUSE/#.desktop/harness_menu.pdl
EXPECT_OUT | 6 | the-global-file-has-the-six-rows
RUN | $HOUSE/&.widgits/_shared-lib/ops/+x/harness_menu_op.+x | list | $HOUSE | - | - | $T/rows.txt
EXPECT_EXIT | 0 | the-op-lists-the-real-global-rows
EXPECT_HAS | rows.txt | deskopoly | and-deskopoly-is-one-of-them

CASE    | manager
SCRATCH |
# the manager source is thousands of lines and EXPECT_HAS reads only the first 16 KB, so these use grep -qF and the exit code
RUN | /usr/bin/grep | -qF | strcmp(cid, "harness") == 0 \p\p which == 11 | $HOUSE/_.monads/_.livedesk-taskbar/ops/khtpm_taskbar_manager.c
EXPECT_EXIT | 0 | cell-11-opens-the-harness-menu
RUN | /usr/bin/grep | -qF | "livedesk:run-harness:", 21 | $HOUSE/_.monads/_.livedesk-taskbar/ops/khtpm_taskbar_manager.c
EXPECT_EXIT | 0 | the-run-verb-is-dispatched
RUN | /usr/bin/grep | -qF | harness_menu_op.+x | $HOUSE/_.monads/_.livedesk-taskbar/ops/khtpm_taskbar_manager.c
EXPECT_EXIT | 0 | and-it-goes-through-the-one-op
RUN | /usr/bin/grep | -qF | cpu_gate.+x\" \"%s\" run harness- | $HOUSE/_.monads/_.livedesk-taskbar/ops/khtpm_taskbar_manager.c
EXPECT_EXIT | 1 | NEGATIVE-the-manager-no-longer-builds-its-own-cpu_gate-shell-string
RUN | /usr/bin/grep | -qF | livedesk_build_prefixed_menu(house_root, menu, max, "harness") | $HOUSE/_.monads/_.livedesk-taskbar/ops/khtpm_taskbar_manager.c
EXPECT_EXIT | 1 | NEGATIVE-and-no-longer-reads-harness-rows-from-livedesk_taskbar-pdl
RUN | /usr/bin/grep | -qF | cell-11-nonexistent-zz | $HOUSE/_.monads/_.livedesk-taskbar/ops/khtpm_taskbar_manager.c
EXPECT_EXIT | 1 | NEGATIVE-a-string-that-is-not-there-is-not-found
