# deskopoly: a property board whose WHOLE state is an append-only ledger (pass 1, 2026-11-07; BOOK 08-roadmap/design-docs/HANDOFF-NOV-7 section 10).
# Every number pinned below was OBSERVED in a scratch run on 2026-11-07 before it was written here (seed 7 default rules; seed 2 harsh rules). Scratch only: nothing here touches the live house.
# CASE names are the phase names the BRAIN rows in @.apps/deskopoly/verbs.pdl cite (brain_lint --phases checks that against this very file).
RESULTS | ../results/deskopoly.txt
ENV | LC_ALL | C

CASE    | rules
SCRATCH |
MKDIR   | g
RUN | $HOUSE/@.apps/deskopoly/ops/+x/deskopoly.+x | $HOUSE/@.apps/deskopoly | $T/g | new | 7
EXPECT_OUT | new game seed=7,players=4 | a-game-starts-and-records-its-seed
RUN | $HOUSE/@.apps/deskopoly/ops/+x/deskopoly.+x | $HOUSE/@.apps/deskopoly | $T/g | roll
EXPECT_OUT | p1 rolled | the-first-player-rolls
RUN | $HOUSE/@.apps/deskopoly/ops/+x/deskopoly.+x | $HOUSE/@.apps/deskopoly | $T/g | roll
EXPECT_EXIT | 2 | NEGATIVE-a-second-roll-in-one-turn-is-refused
RUN | $HOUSE/@.apps/deskopoly/ops/+x/deskopoly.+x | $HOUSE/@.apps/deskopoly | $T/g | status
EXPECT_OUT | STATE round=0 current=p1 rolled=1 | state-is-derived-from-the-ledger
RUN | $HOUSE/@.apps/deskopoly/ops/+x/deskopoly.+x | $HOUSE/@.apps/deskopoly | $T/g | check
EXPECT_OUT | CHECK ok events=2 sum=6000 | money-is-conserved-after-one-roll

CASE    | autoplay
SCRATCH |
MKDIR   | a
MKDIR   | b
MKDIR   | e
MKDIR   | bank
RUN | $HOUSE/@.apps/deskopoly/ops/+x/deskopoly.+x | $HOUSE/@.apps/deskopoly | $T/a | new | 7
RUN | $HOUSE/@.apps/deskopoly/ops/+x/deskopoly.+x | $HOUSE/@.apps/deskopoly | $T/a | autoplay
EXPECT_OUT | AUTOPLAY events=334 rounds=40 over=1 winner=fenn | four-styles-play-a-whole-game
RUN | $HOUSE/@.apps/deskopoly/ops/+x/deskopoly.+x | $HOUSE/@.apps/deskopoly | $T/a | check
EXPECT_OUT | CHECK ok events=334 sum=6000 | money-is-conserved-over-the-whole-game
RUN | $HOUSE/@.apps/deskopoly/ops/+x/deskopoly.+x | $HOUSE/@.apps/deskopoly | $T/a | replay
EXPECT_OUT | REPLAY events=334 hash=128baad3c4609438 | replaying-the-ledger-reproduces-the-pinned-state-hash
RUN | $HOUSE/@.apps/deskopoly/ops/+x/deskopoly.+x | $HOUSE/@.apps/deskopoly | $T/a | roll
EXPECT_EXIT | 2 | NEGATIVE-nothing-can-be-played-after-the-game-is-over
RUN | $HOUSE/@.apps/deskopoly/ops/+x/deskopoly.+x | $HOUSE/@.apps/deskopoly | $T/b | new | 7
RUN | $HOUSE/@.apps/deskopoly/ops/+x/deskopoly.+x | $HOUSE/@.apps/deskopoly | $T/b | autoplay
RUN | cmp | $T/a/ledger.txt | $T/b/ledger.txt
EXPECT_EXIT | 0 | the-same-seed-gives-the-identical-ledger
RUN | $HOUSE/@.apps/deskopoly/ops/+x/deskopoly.+x | $HOUSE/@.apps/deskopoly | $T/e | new | 8
RUN | $HOUSE/@.apps/deskopoly/ops/+x/deskopoly.+x | $HOUSE/@.apps/deskopoly | $T/e | autoplay
RUN | cmp | $T/a/ledger.txt | $T/e/ledger.txt
EXPECT_EXIT | 1 | NEGATIVE-a-different-seed-gives-a-different-ledger-so-the-compare-can-fail
# the pets' decisions go through the same DEC grammar the decision bank already digests (dec_op): 12 buys + 1 skip, hand arithmetic (12+1)/(12+0+2) and (1+1)/(1+0+2)
RUN | $HOUSE/&.widgits/_shared-lib/ops/+x/dec_op.+x | bank | $T/a/decisions.txt | $T/bank | deskopoly
EXPECT_OUT | rows=13 | the-bank-digests-the-games-decision-rows
RUN | $HOUSE/&.widgits/_shared-lib/ops/+x/dec_op.+x | weight | $T/bank | deskopoly | buy
EXPECT_OUT | 0.9286 | buy-weight-equals-the-hand-count
RUN | $HOUSE/&.widgits/_shared-lib/ops/+x/dec_op.+x | weight | $T/bank | deskopoly | skip
EXPECT_OUT | 0.6667 | skip-weight-equals-the-hand-count

CASE    | replay
SCRATCH |
MKDIR   | a
MKDIR   | c
MKDIR   | t
RUN | $HOUSE/@.apps/deskopoly/ops/+x/deskopoly.+x | $HOUSE/@.apps/deskopoly | $T/a | new | 7
RUN | $HOUSE/@.apps/deskopoly/ops/+x/deskopoly.+x | $HOUSE/@.apps/deskopoly | $T/a | autoplay
RUN | cp | $T/a/ledger.txt | $T/c/ledger.txt
RUN | sed | -i | s/rent-\([0-9]*\)/rent-9\1/ | $T/c/ledger.txt
RUN | $HOUSE/@.apps/deskopoly/ops/+x/deskopoly.+x | $HOUSE/@.apps/deskopoly | $T/c | replay
EXPECT_EXIT | 1 | NEGATIVE-a-hand-edited-rent-is-caught-by-replay
EXPECT_OUT | recorded result | the-message-names-the-recorded-and-the-replayed-result
WRITE | t/ledger.txt | EVENT|0|bank|new|-|0|seed=7,players=4\nEVENT|0|p1|roll|9,9|0|start\n
RUN | $HOUSE/@.apps/deskopoly/ops/+x/deskopoly.+x | $HOUSE/@.apps/deskopoly | $T/t | replay
EXPECT_EXIT | 1 | NEGATIVE-dice-that-are-not-the-seeded-dice-are-caught
EXPECT_OUT | does not match the seeded dice | the-message-says-why

CASE    | refusals
SCRATCH |
MKDIR   | d
RUN | $HOUSE/@.apps/deskopoly/ops/+x/deskopoly.+x | $HOUSE/@.apps/deskopoly | $T/d | status
EXPECT_EXIT | 2 | NEGATIVE-no-game-yet-is-refused
RUN | $HOUSE/@.apps/deskopoly/ops/+x/deskopoly.+x | $HOUSE/@.apps/deskopoly | $T/d | new | 3
RUN | $HOUSE/@.apps/deskopoly/ops/+x/deskopoly.+x | $HOUSE/@.apps/deskopoly | $T/d | buy
EXPECT_EXIT | 2 | NEGATIVE-buy-before-a-roll-is-refused
RUN | $HOUSE/@.apps/deskopoly/ops/+x/deskopoly.+x | $HOUSE/@.apps/deskopoly | $T/d | end_turn
EXPECT_EXIT | 2 | NEGATIVE-ending-a-turn-that-was-never-rolled-is-refused
RUN | $HOUSE/@.apps/deskopoly/ops/+x/deskopoly.+x | $HOUSE/@.apps/deskopoly | $T/d | new | 3
EXPECT_EXIT | 2 | NEGATIVE-a-second-new-over-an-existing-ledger-is-refused
RUN | $HOUSE/@.apps/deskopoly/ops/+x/deskopoly.+x | $HOUSE/@.apps/deskopoly | $T/nodir | status
EXPECT_EXIT | 2 | NEGATIVE-a-missing-state-folder-is-refused

# harsh rules (150 cash, 60 rounds) so a pet can try to buy what it cannot afford and a player can go bankrupt; seed 2 observed: 2 blocked buys, 1 bankruptcy, sum 600
CASE    | harsh
SCRATCH |
MKDIR   | app
MKDIR   | g
COPY    | @.apps/deskopoly/rulesets/mini/board.pdl | app/board.pdl
COPY    | @.apps/deskopoly/verbs.pdl | app/verbs.pdl
WRITE   | app/rules.pdl | RULE | start_cash | 150\nRULE | pass_go | 200\nRULE | rounds | 60\nRULE | seed | 7\nPLAYER | p1 | rex | bold | 0\nPLAYER | p2 | fenn | cautious | 300\nPLAYER | p3 | gus | coin | 50\nPLAYER | p4 | wren | cautious | 600\n
RUN | $HOUSE/@.apps/deskopoly/ops/+x/deskopoly.+x | $T/app | $T/g | new | 2
RUN | $HOUSE/@.apps/deskopoly/ops/+x/deskopoly.+x | $T/app | $T/g | autoplay
EXPECT_OUT | AUTOPLAY events=421 rounds=60 over=1 winner=wren | a-poor-game-still-ends
RUN | $HOUSE/@.apps/deskopoly/ops/+x/deskopoly.+x | $T/app | $T/g | check
EXPECT_OUT | CHECK ok events=421 sum=600 | money-is-conserved-through-a-bankruptcy
EXPECT_HAS | g/ledger.txt | bankrupt | a-player-went-out-in-this-game
EXPECT_HAS | g/decisions.txt | blocked | a-purchase-the-pet-could-not-afford-was-refused-and-logged-blocked

CASE    | mechanics
SCRATCH |
MKDIR   | a
MKDIR   | app
RUN | $HOUSE/@.apps/deskopoly/ops/+x/deskopoly.+x | $HOUSE/@.apps/deskopoly | $T/a | new | 7
RUN | $HOUSE/@.apps/deskopoly/ops/+x/deskopoly.+x | $HOUSE/@.apps/deskopoly | $T/a | autoplay
RUN | $HOUSE/@.apps/deskopoly/ops/+x/deskopoly.+x | $HOUSE/@.apps/deskopoly | $T/a | mechanics
EXPECT_OUT | MECHANICS\pdeskopoly\ptiles=16\pplayers=4 | the-projection-counts-the-board-and-players-from-the-data-files
EXPECT_OUT | FLOW \p roll | the-data-flow-rows-are-projected
EXPECT_OUT | BRAIN \p buy | the-brain-rows-are-projected
EXPECT_OUT | STATE\pover\p1 | the-hard-state-is-in-the-projection
EXPECT_OUT_LACKS | GAP\p | every-verb-has-a-flow-row
EXPECT_HAS | a/mechanics.txt | STATE\pbank\p-9080 | the-projection-file-is-written-and-carries-the-bank
WRITE   | app/board.pdl | TILE | 0 | Start | go | 0 | 0 | -1\nTILE | 1 | A | prop | 10 | 1 | 0\nTILE | 2 | B | prop | 10 | 1 | 0\nTILE | 3 | C | rest | 0 | 0 | -1\n
WRITE   | app/rules.pdl | RULE | start_cash | 100\nPLAYER | p1 | a | bold | 0\nPLAYER | p2 | b | bold | 0\n
WRITE   | app/verbs.pdl | VERB | roll | no | ui | - | roll the dice\nVERB | ghost | no | ui | - | a mechanic nobody described\nFLOW | roll | state/ledger.txt | state/ledger.txt\n
RUN | $HOUSE/@.apps/deskopoly/ops/+x/deskopoly.+x | $T/app | $T/a | mechanics
EXPECT_OUT | GAP\pghost\pno FLOW row | NEGATIVE-a-verb-without-a-flow-row-is-named-as-a-gap
EXPECT_OUT_LACKS | GAP\proll | a-described-verb-is-not-a-gap

CASE    | lint
SCRATCH |
RUN | $HOUSE/&.widgits/_shared-lib/ops/+x/brain_lint.+x | $HOUSE/@.apps/deskopoly/verbs.pdl | --phases | $HOUSE/&.widgits/_shared-lib/harness/cases/deskopoly.pdl
EXPECT_OUT | brain_rows=4 fail=0 | the-real-manifest-passes-and-its-phases-are-cases-in-this-file
WRITE   | v1.pdl | VERB | roll | no | ui | - | x\nBRAIN | k1 | rolls | rules | ok | | made-up verb\n
RUN | $HOUSE/&.widgits/_shared-lib/ops/+x/brain_lint.+x | $T/v1.pdl
EXPECT_EXIT | 1 | NEGATIVE-a-made-up-verb-fails
EXPECT_OUT | B3 | and-it-is-named-B3
WRITE   | v2.pdl | VERB | roll | no | ui | - | x\nBRAIN | k1 | roll | rules | ok | | one\nBRAIN | k1 | roll | rules | ok | | two\n
RUN | $HOUSE/&.widgits/_shared-lib/ops/+x/brain_lint.+x | $T/v2.pdl
EXPECT_OUT | B2 | NEGATIVE-a-duplicate-dec-key-fails
WRITE   | v3.pdl | VERB | roll | no | ui | - | x\nBRAIN | k1 | roll | rules | | | no ok outcome\n
RUN | $HOUSE/&.widgits/_shared-lib/ops/+x/brain_lint.+x | $T/v3.pdl
EXPECT_OUT | B5 | NEGATIVE-an-empty-ok-list-fails
WRITE   | v4.pdl | VERB | roll | no | ui | - | x\nBRAIN | k1 | roll | rules | ok,blocked | blocked | overlap\n
RUN | $HOUSE/&.widgits/_shared-lib/ops/+x/brain_lint.+x | $T/v4.pdl
EXPECT_OUT | B6 | NEGATIVE-an-outcome-both-ok-and-bad-fails
WRITE   | v5.pdl | VERB | roll | no | ui | - | x\nBRAIN | k1 | roll | no_such_case | ok | | phase that judges nothing\n
RUN | $HOUSE/&.widgits/_shared-lib/ops/+x/brain_lint.+x | $T/v5.pdl | --phases | $HOUSE/&.widgits/_shared-lib/harness/cases/deskopoly.pdl
EXPECT_OUT | B4 | NEGATIVE-a-phase-that-is-no-case-fails
RUN | $HOUSE/&.widgits/_shared-lib/ops/+x/brain_lint.+x | $T/v5.pdl
EXPECT_OUT | brain_rows=1 fail=0 | without-a-phases-file-phase-names-are-not-checked
RUN | $HOUSE/&.widgits/_shared-lib/ops/+x/brain_lint.+x | $T/nofile.pdl
EXPECT_EXIT | 2 | NEGATIVE-an-unreadable-file-is-a-usage-error

# the game is a BOOK the editor can resolve, the same shape as @.apps/centroid (rooms.pdl + <book>-pchq/.../game.pdl); uses the existing edit_open.sh like centroid_book does. The page is not DRAWN yet.
CASE    | book
SCRATCH |
COPY    | @.apps/rpg-edit-hq/ops/edit_open.sh | edit_open.sh
MKDIR   | house/@.apps/deskopoly/deskopoly-pchq/pieces/system/maps/deskopoly
COPY    | @.apps/deskopoly/deskopoly-pchq/pieces/system/maps/deskopoly/game.pdl | house/@.apps/deskopoly/deskopoly-pchq/pieces/system/maps/deskopoly/game.pdl
RUN | sh | $T/edit_open.sh | $T/house | deskopoly | board
EXPECT_EXIT | 0 | the-editor-resolves-deskopoly-board
EXPECT_OUT | book=deskopoly page=board event=none pages=1 events=0 | open-says-one-page
RUN | sh | $T/edit_open.sh | $T/house | deskopoly | nowhere
EXPECT_EXIT | 2 | NEGATIVE-a-page-that-is-not-a-desk-is-refused
RUN | sh | $T/edit_open.sh | $T/house | nobook | board
EXPECT_EXIT | 2 | NEGATIVE-a-book-with-no-game-pdl-is-refused
RUN | grep | -c | ^ROOM | $HOUSE/@.apps/deskopoly/rooms.pdl
EXPECT_OUT_IS | 1 | rooms-pdl-lists-the-same-one-page-as-game-pdl

# the board DRAWN as an editor page: a projection of board.pdl + page.pdl + the replayed ledger. Observed 2026-11-07: a 15x15 page (5x5 ring of 3x3 blocks); after the seed-7 game 12 tiles are owned, and the
# centre cell of tile 1 (row 2 of the cells, column 5) holds p4's marker 33 (checked against `status`: rex 2, fenn 7, gus 1, wren 2 props, the same counts the picture shows).
CASE    | page
SCRATCH |
MKDIR   | empty
MKDIR   | g
MKDIR   | d0
MKDIR   | d7
MKDIR   | badapp
MKDIR   | dbad
RUN | $HOUSE/@.apps/deskopoly/ops/+x/deskopoly.+x | $HOUSE/@.apps/deskopoly | $T/empty | page | $T/d0 | $HOUSE/@.apps/centroid/centroid-pchq/pieces/system/maps/centroid/test/cells.rgba
EXPECT_OUT | 15x15 tiles=16 owned=0 | a-fresh-board-is-a-15x15-page-with-nothing-owned
EXPECT_HAS | d0/cells.txt | width=15 | the-header-says-width-15
EXPECT_HAS | d0/cells.txt | atlas_tiles=43 | the-header-comes-from-page-pdl
RUN | awk | NR==9{print $5} | $T/d0/cells.txt
EXPECT_OUT_IS | 32,0,2 | an-unowned-tile-keeps-its-group-floor-in-the-centre
RUN | grep | -c | , | $T/d0/cells.txt
EXPECT_OUT_IS | 15 | fifteen-cell-rows-plus-no-header-line-has-a-comma
RUN | $HOUSE/@.apps/deskopoly/ops/+x/deskopoly.+x | $HOUSE/@.apps/deskopoly | $T/g | new | 7
RUN | $HOUSE/@.apps/deskopoly/ops/+x/deskopoly.+x | $HOUSE/@.apps/deskopoly | $T/g | autoplay
RUN | $HOUSE/@.apps/deskopoly/ops/+x/deskopoly.+x | $HOUSE/@.apps/deskopoly | $T/g | page | $T/d7 | $HOUSE/@.apps/centroid/centroid-pchq/pieces/system/maps/centroid/test/cells.rgba
EXPECT_OUT | 15x15 tiles=16 owned=12 | after-the-game-twelve-tiles-show-an-owner
RUN | awk | NR==9{print $5} | $T/d7/cells.txt
EXPECT_OUT_IS | 33,0,2 | the-hard-state-shows-on-the-page-tile-1-carries-p4s-marker
RUN | $HOUSE/@.apps/deskopoly/ops/+x/deskopoly.+x | $HOUSE/@.apps/deskopoly | $T/g | page | $T/d7
RUN | cp | $T/d7/cells.txt | $T/d7/cells.again
RUN | $HOUSE/@.apps/deskopoly/ops/+x/deskopoly.+x | $HOUSE/@.apps/deskopoly | $T/g | page | $T/d7
RUN | cmp | $T/d7/cells.txt | $T/d7/cells.again
EXPECT_EXIT | 0 | drawing-the-page-twice-gives-the-same-file
RUN | cmp | $T/d7/cells.txt | $T/d0/cells.txt
EXPECT_EXIT | 1 | NEGATIVE-the-played-page-differs-from-the-fresh-one-so-the-compare-can-fail
RUN | $HOUSE/@.apps/deskopoly/ops/+x/deskopoly.+x | $HOUSE/@.apps/deskopoly | $T/g | preview | $T/d7 | $T/d7.raw
EXPECT_OUT | PREVIEW 360x360 | the-flat-preview-is-15-cells-of-24-pixels
RUN | stat | -c | %s | $T/d7.raw
EXPECT_OUT_IS | 518400 | the-raw-file-is-exactly-360-x-360-x-4-bytes
RUN | $HOUSE/@.apps/deskopoly/ops/+x/deskopoly.+x | $HOUSE/@.apps/deskopoly | $T/g | preview | $T/dbad | $T/x.raw
EXPECT_EXIT | 2 | NEGATIVE-a-folder-with-no-page-is-refused
# a board that is not a ring (5 tiles) and a page.pdl that names a tile outside the atlas are both refused
COPY    | @.apps/deskopoly/rulesets/mini/rules.pdl | badapp/rules.pdl
COPY    | @.apps/deskopoly/verbs.pdl | badapp/verbs.pdl
COPY    | @.apps/deskopoly/page.pdl | badapp/page.pdl
WRITE   | badapp/board.pdl | TILE | 0 | Start | go | 0 | 0 | -1\nTILE | 1 | A | prop | 10 | 1 | 0\nTILE | 2 | B | prop | 10 | 1 | 0\nTILE | 3 | C | prop | 10 | 1 | 0\nTILE | 4 | D | rest | 0 | 0 | -1\n
RUN | $HOUSE/@.apps/deskopoly/ops/+x/deskopoly.+x | $T/badapp | $T/dbad | page | $T/dbad
EXPECT_EXIT | 2 | NEGATIVE-a-board-that-is-not-a-ring-is-refused
EXPECT_OUT | ring needs tiles | and-it-says-why
COPY    | @.apps/deskopoly/rulesets/mini/board.pdl | badapp/board.pdl
WRITE   | badapp/page.pdl | HEADER | atlas_tiles | 43\nTILEMAP | go | 99\n
RUN | $HOUSE/@.apps/deskopoly/ops/+x/deskopoly.+x | $T/badapp | $T/dbad | page | $T/dbad
EXPECT_EXIT | 2 | NEGATIVE-a-tile-outside-the-atlas-is-refused

# SEATS (A1/A2 of PROPOSAL-PLAY-MODE-SEATS-AND-GAME-SIDEBARS): who drives a seat is a ledger row, `tick` does one step, a human seat makes it wait, and a human who issues the verbs a pet would issue makes the SAME game.
# Observed 2026-11-07, seed 7: the all-pet game is 334 rows, hash 61ac51a395a63e0d; the human game is 336 rows (two seat rows), and 334 rows with the same hash once the seat rows are left out.
CASE    | seats
SCRATCH |
MKDIR   | x
MKDIR   | y
MKDIR   | z
MKDIR   | w
MKDIR   | app
MKDIR   | t
RUN | $HOUSE/@.apps/deskopoly/ops/+x/deskopoly.+x | $HOUSE/@.apps/deskopoly | $T/x | new | 7
RUN | $HOUSE/@.apps/deskopoly/ops/+x/deskopoly.+x | $HOUSE/@.apps/deskopoly | $T/x | autoplay
RUN | $HOUSE/@.apps/deskopoly/ops/+x/deskopoly.+x | $HOUSE/@.apps/deskopoly | $T/x | ledger_hash
EXPECT_OUT | LEDGER rows=334 hash=61ac51a395a63e0d | the-all-pet-game-is-334-rows-with-the-pinned-hash
RUN | $HOUSE/@.apps/deskopoly/ops/+x/deskopoly.+x | $HOUSE/@.apps/deskopoly | $T/y | new | 7
RUN | $HOUSE/@.apps/deskopoly/ops/+x/deskopoly.+x | $HOUSE/@.apps/deskopoly | $T/y | seat | p1 | human
EXPECT_OUT | seat p1 human | a-seat-is-handed-to-a-human
RUN | $HOUSE/@.apps/deskopoly/ops/+x/deskopoly.+x | $HOUSE/@.apps/deskopoly | $T/y | seat | p1 | human
EXPECT_EXIT | 2 | NEGATIVE-handing-a-seat-to-who-already-has-it-is-refused
RUN | $HOUSE/@.apps/deskopoly/ops/+x/deskopoly.+x | $HOUSE/@.apps/deskopoly | $T/y | seat | p9 | human
EXPECT_EXIT | 2 | NEGATIVE-a-seat-that-does-not-exist-is-refused
RUN | $HOUSE/@.apps/deskopoly/ops/+x/deskopoly.+x | $HOUSE/@.apps/deskopoly | $T/y | seat | p1 | robot
EXPECT_EXIT | 2 | NEGATIVE-a-driver-that-is-neither-human-nor-pet-is-refused
RUN | $HOUSE/@.apps/deskopoly/ops/+x/deskopoly.+x | $HOUSE/@.apps/deskopoly | $T/y | autoplay
EXPECT_OUT | AUTOPLAY waiting events=2 waiting p1 rex human | autoplay-stops-when-a-human-is-up
RUN | $HOUSE/@.apps/deskopoly/ops/+x/deskopoly.+x | $HOUSE/@.apps/deskopoly | $T/y | tick
EXPECT_OUT | TICK waiting p1 rex human | a-human-seat-makes-tick-wait
RUN | $HOUSE/@.apps/deskopoly/ops/+x/deskopoly.+x | $HOUSE/@.apps/deskopoly | $T/y | ui
EXPECT_HAS | y/ui.txt | human_turn=1\nshow_roll=1\nshow_buy=\nshow_skip=\nshow_end=\n | before-the-roll-only-Roll-is-offered
RUN | $HOUSE/@.apps/deskopoly/ops/+x/deskopoly.+x | $HOUSE/@.apps/deskopoly | $T/y | end_turn
EXPECT_EXIT | 2 | NEGATIVE-ending-before-the-roll-is-refused
RUN | $HOUSE/@.apps/deskopoly/ops/+x/deskopoly.+x | $HOUSE/@.apps/deskopoly | $T/y | roll
EXPECT_OUT | p1 rolled 1,1 -> tile 2: for-sale | the-human-rolls-the-seeded-dice
RUN | $HOUSE/@.apps/deskopoly/ops/+x/deskopoly.+x | $HOUSE/@.apps/deskopoly | $T/y | ui
EXPECT_HAS | y/ui.txt | show_roll=\nshow_buy=1\nshow_skip=1\nshow_end=\n | with-a-tile-for-sale-Buy-and-Skip-are-offered
EXPECT_HAS | y/ui.txt | pending_tile=Block 2\npending_price=60\n | the-feed-names-the-tile-and-its-price
RUN | $HOUSE/@.apps/deskopoly/ops/+x/deskopoly.+x | $HOUSE/@.apps/deskopoly | $T/y | end_turn
EXPECT_EXIT | 2 | NEGATIVE-ending-with-a-tile-undecided-is-refused
RUN | $HOUSE/@.apps/deskopoly/ops/+x/deskopoly.+x | $HOUSE/@.apps/deskopoly | $T/y | buy
EXPECT_OUT | p1 buy: bought-60 | the-human-buys
RUN | $HOUSE/@.apps/deskopoly/ops/+x/deskopoly.+x | $HOUSE/@.apps/deskopoly | $T/y | ui
EXPECT_HAS | y/ui.txt | show_roll=\nshow_buy=\nshow_skip=\nshow_end=1\n | after-the-decision-only-End-is-offered
RUN | $HOUSE/@.apps/deskopoly/ops/+x/deskopoly.+x | $HOUSE/@.apps/deskopoly | $T/y | end_turn
EXPECT_OUT | p1 end_turn: next=p2 round=0 | the-human-ends-the-turn
RUN | $HOUSE/@.apps/deskopoly/ops/+x/deskopoly.+x | $HOUSE/@.apps/deskopoly | $T/y | seat | p1 | pet
RUN | $HOUSE/@.apps/deskopoly/ops/+x/deskopoly.+x | $HOUSE/@.apps/deskopoly | $T/y | autoplay
EXPECT_OUT | AUTOPLAY events=336 rounds=40 over=1 winner=fenn | handed-back-the-pets-finish-the-same-game
RUN | $HOUSE/@.apps/deskopoly/ops/+x/deskopoly.+x | $HOUSE/@.apps/deskopoly | $T/y | ledger_hash | seat
EXPECT_OUT | LEDGER rows=334 hash=61ac51a395a63e0d without=seat | THE-SAME-MOVES-as-the-all-pet-game-once-the-seat-rows-are-left-out
RUN | $HOUSE/@.apps/deskopoly/ops/+x/deskopoly.+x | $HOUSE/@.apps/deskopoly | $T/y | ledger_hash
EXPECT_OUT | LEDGER rows=336 hash=9baa915d6d0846a9 | NEGATIVE-with-the-seat-rows-the-hash-differs-so-the-comparison-can-fail
RUN | $HOUSE/@.apps/deskopoly/ops/+x/deskopoly.+x | $HOUSE/@.apps/deskopoly | $T/y | check
EXPECT_OUT | CHECK ok events=336 sum=6000 | money-is-conserved-with-a-human-in-the-game
EXPECT_HAS | y/decisions.txt | rex\pforsale\pbuy\p2\pok | the-humans-choice-is-a-decision-row-in-the-same-grammar-as-a-pets
RUN | $HOUSE/@.apps/deskopoly/ops/+x/deskopoly.+x | $HOUSE/@.apps/deskopoly | $T/y | seat | p2 | human
EXPECT_EXIT | 2 | NEGATIVE-no-seat-changes-after-the-game-is-over
# another seed makes another game, so the pinned hash is not a constant that every game gives
RUN | $HOUSE/@.apps/deskopoly/ops/+x/deskopoly.+x | $HOUSE/@.apps/deskopoly | $T/w | new | 8
RUN | $HOUSE/@.apps/deskopoly/ops/+x/deskopoly.+x | $HOUSE/@.apps/deskopoly | $T/w | autoplay
RUN | $HOUSE/@.apps/deskopoly/ops/+x/deskopoly.+x | $HOUSE/@.apps/deskopoly | $T/w | ledger_hash
EXPECT_OUT_LACKS | 61ac51a395a63e0d | NEGATIVE-seed-8-does-not-give-the-seed-7-hash
# a human who cannot pay: the buy is refused, logged as a blocked decision, and appends NOTHING to the game ledger
COPY    | @.apps/deskopoly/rulesets/mini/board.pdl | app/board.pdl
COPY    | @.apps/deskopoly/verbs.pdl | app/verbs.pdl
WRITE   | app/rules.pdl | RULE | start_cash | 20\nRULE | pass_go | 200\nRULE | rounds | 40\nRULE | seed | 7\nPLAYER | p1 | rex | bold | 0\nPLAYER | p2 | fenn | cautious | 300\nPLAYER | p3 | gus | coin | 50\nPLAYER | p4 | wren | cautious | 600\n
RUN | $HOUSE/@.apps/deskopoly/ops/+x/deskopoly.+x | $T/app | $T/z | new | 7
RUN | $HOUSE/@.apps/deskopoly/ops/+x/deskopoly.+x | $T/app | $T/z | seat | p1 | human
RUN | $HOUSE/@.apps/deskopoly/ops/+x/deskopoly.+x | $T/app | $T/z | roll
RUN | $HOUSE/@.apps/deskopoly/ops/+x/deskopoly.+x | $T/app | $T/z | buy
EXPECT_EXIT | 2 | NEGATIVE-a-human-cannot-buy-what-the-cash-does-not-cover
EXPECT_OUT | not enough cash | and-it-says-why
EXPECT_HAS | z/decisions.txt | rex\pforsale\pbuy\p2\pblocked | the-attempt-is-a-blocked-decision-row
EXPECT_LACKS | z/ledger.txt | \pbuy\p | the-refused-move-is-not-in-the-game-ledger
# a ledger with a seat row for a player that does not exist is refused by replay
WRITE   | t/ledger.txt | EVENT|0|bank|new|-|0|seed=7,players=4\nEVENT|0|bank|seat|p9|0|human\n
RUN | $HOUSE/@.apps/deskopoly/ops/+x/deskopoly.+x | $HOUSE/@.apps/deskopoly | $T/t | replay
EXPECT_EXIT | 1 | NEGATIVE-a-seat-row-for-a-player-that-does-not-exist-is-refused-on-replay
EXPECT_OUT | a bad seat row | and-it-says-so

# NO GHOST DATA (owner 2026-11-07; AGENTS.md "No ghost data"): the ledger is the only authority for game state; every other file is a projection that can be deleted and regenerated byte for byte.
CASE    | ghost
SCRATCH |
MKDIR   | g
MKDIR   | d
RUN | $HOUSE/@.apps/deskopoly/ops/+x/deskopoly.+x | $HOUSE/@.apps/deskopoly | $T/g | new | 7
RUN | $HOUSE/@.apps/deskopoly/ops/+x/deskopoly.+x | $HOUSE/@.apps/deskopoly | $T/g | autoplay
RUN | $HOUSE/@.apps/deskopoly/ops/+x/deskopoly.+x | $HOUSE/@.apps/deskopoly | $T/g | ui
RUN | $HOUSE/@.apps/deskopoly/ops/+x/deskopoly.+x | $HOUSE/@.apps/deskopoly | $T/g | mechanics
RUN | $HOUSE/@.apps/deskopoly/ops/+x/deskopoly.+x | $HOUSE/@.apps/deskopoly | $T/g | page | $T/d | $HOUSE/@.apps/centroid/centroid-pchq/pieces/system/maps/centroid/test/cells.rgba
RUN | $HOUSE/@.apps/deskopoly/ops/+x/deskopoly.+x | $HOUSE/@.apps/deskopoly | $T/g | audit
EXPECT_OUT_IS | AUDIT ok files=4 declared=4 | the-state-folder-holds-only-what-state-pdl-declares-two-ledgers-and-two-projections
RUN | $HOUSE/@.apps/deskopoly/ops/+x/deskopoly.+x | $HOUSE/@.apps/deskopoly | $T/g | replay
CAPTURE | replay1
RUN | $HOUSE/@.apps/deskopoly/ops/+x/deskopoly.+x | $HOUSE/@.apps/deskopoly | $T/g | ledger_hash
CAPTURE | ledger1
# files beside the ledger change nothing: the game has no second channel for state
WRITE   | g/cash.txt | p1=999999\n
WRITE   | g/state.txt | current=p4\nover=1\n
WRITE   | g/pet_rex.txt | room=elsewhere\nx=0\ny=0\n
RUN | $HOUSE/@.apps/deskopoly/ops/+x/deskopoly.+x | $HOUSE/@.apps/deskopoly | $T/g | replay
CAPTURE | replay2
EXPECT_EQ | $replay1 | $replay2 | invented-state-files-change-nothing-the-ledger-alone-decides
RUN | $HOUSE/@.apps/deskopoly/ops/+x/deskopoly.+x | $HOUSE/@.apps/deskopoly | $T/g | audit
EXPECT_EXIT | 1 | NEGATIVE-invented-state-files-are-GHOSTS-and-the-audit-fails
EXPECT_OUT | GHOST cash.txt | and-it-names-the-cash-file
EXPECT_OUT | GHOST pet_rex.txt | and-the-pet-file
RUN | rm | -f | $T/g/cash.txt | $T/g/state.txt | $T/g/pet_rex.txt
# every projection can be deleted and regenerated byte for byte
RUN | sha256sum | $T/g/ui.txt | $T/g/mechanics.txt | $T/d/cells.txt | $T/d/map.txt
CAPTURE | sums1
RUN | rm | -f | $T/g/ui.txt | $T/g/mechanics.txt | $T/d/cells.txt | $T/d/map.txt
RUN | $HOUSE/@.apps/deskopoly/ops/+x/deskopoly.+x | $HOUSE/@.apps/deskopoly | $T/g | ui
RUN | $HOUSE/@.apps/deskopoly/ops/+x/deskopoly.+x | $HOUSE/@.apps/deskopoly | $T/g | mechanics
RUN | $HOUSE/@.apps/deskopoly/ops/+x/deskopoly.+x | $HOUSE/@.apps/deskopoly | $T/g | page | $T/d
RUN | sha256sum | $T/g/ui.txt | $T/g/mechanics.txt | $T/d/cells.txt | $T/d/map.txt
CAPTURE | sums2
EXPECT_EQ | $sums1 | $sums2 | deleted-projections-regenerate-identical-bytes
RUN | $HOUSE/@.apps/deskopoly/ops/+x/deskopoly.+x | $HOUSE/@.apps/deskopoly | $T/g | ledger_hash
CAPTURE | ledger2
EXPECT_EQ | $ledger1 | $ledger2 | regenerating-projections-never-touches-the-ledger
# a projection that is wrong stays wrong only until the next regeneration: edit one, regenerate, it is back
WRITE   | g/ui.txt | current=p4\nshow_roll=1\n
RUN | $HOUSE/@.apps/deskopoly/ops/+x/deskopoly.+x | $HOUSE/@.apps/deskopoly | $T/g | ui
RUN | sha256sum | $T/g/ui.txt | $T/g/mechanics.txt | $T/d/cells.txt | $T/d/map.txt
CAPTURE | sums3
EXPECT_EQ | $sums1 | $sums3 | a-hand-edited-projection-is-overwritten-from-the-ledger
RUN | $HOUSE/@.apps/deskopoly/ops/+x/deskopoly.+x | $HOUSE/@.apps/deskopoly | $T/g | audit
EXPECT_OUT_IS | AUDIT ok files=4 declared=4 | once-the-invented-files-are-removed-the-audit-is-clean-again
# a bad state.pdl is refused: an unknown kind, and a projection whose regenerating verb does not exist
MKDIR   | app
COPY    | @.apps/deskopoly/rulesets/mini/board.pdl | app/board.pdl
COPY    | @.apps/deskopoly/rulesets/mini/rules.pdl | app/rules.pdl
COPY    | @.apps/deskopoly/verbs.pdl | app/verbs.pdl
WRITE   | app/state.pdl | FILE | ledger.txt | LEDGER | x | -\nFILE | ui.txt | MAYBE | x | ui\n
RUN | $HOUSE/@.apps/deskopoly/ops/+x/deskopoly.+x | $T/app | $T/g | audit
EXPECT_EXIT | 2 | NEGATIVE-a-file-kind-that-is-not-ledger-projection-config-or-preference-is-refused
WRITE   | app/state.pdl | FILE | ledger.txt | LEDGER | x | -\nFILE | ui.txt | PROJECTION | x | no_such_verb\n
RUN | $HOUSE/@.apps/deskopoly/ops/+x/deskopoly.+x | $T/app | $T/g | audit
EXPECT_EXIT | 2 | NEGATIVE-a-projection-nobody-can-regenerate-is-refused
EXPECT_OUT | not a VERB | and-it-says-why
