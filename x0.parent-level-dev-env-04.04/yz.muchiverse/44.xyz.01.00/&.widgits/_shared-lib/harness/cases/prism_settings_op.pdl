# prism_settings_op: LOCKED cases (settings > theme > Custom, owner 2026-10-28). Expectations come from the rules in the op header.
RESULTS | ../results/prism_settings_op.txt
CASE | prism_settings_op
SCRATCH |
COPY | &.widgits/_shared-lib/ops/prism_settings_op.c | ps.c
COPY | &.widgits/_shared-lib/ops/prism_op.c | po.c
RUN | gcc | -std=gnu11 | -Wall | -Wextra | -Werror | -O2 | -o | $T/ps.+x | $T/ps.c
EXPECT_EXIT | 0 | setup.settings-op-compiles-clean
RUN | gcc | -std=gnu11 | -Wall | -Wextra | -Werror | -O2 | -o | $T/prism_op.+x | $T/po.c | -lm
EXPECT_EXIT | 0 | setup.prism-op-compiles-clean
MKDIR | nop
RUN | gcc | -std=gnu11 | -O2 | -o | $T/nop/ps.+x | $T/ps.c
EXPECT_EXIT | 0 | setup.copy-without-prism_op
MKDIR | h/#.desktop
# S1 no file = the default rainbow; SHOW writes no settings file but renders
RUN | $T/ps.+x | $T/h | PRISM_SHOW
EXPECT_EXIT | 0 | s1.exit-0
EXPECT_OUT | shape=1 algo=2 hue=0 light=60 custom=0 | s1.defaults
EXPECT_NOFILE | h/#.desktop/livedesk_prism.pdl | s1.show-writes-no-settings
EXPECT_EXISTS | h/#.desktop/prism_theme.png | s1.png-rendered
EXPECT_EXISTS | h/#.desktop/prism_theme.rgba | s1.rgba-rendered
# S2 each variable steps and is saved
RUN | $T/ps.+x | $T/h | PRISM_SHAPE_NEXT
EXPECT_OUT | shape=2 algo=2 hue=0 light=60 custom=0 | s2.shape-next
EXPECT_HAS | h/#.desktop/livedesk_prism.pdl | \p shape              \p 2 | s2.saved-in-the-file
RUN | $T/ps.+x | $T/h | PRISM_ALGO_NEXT
EXPECT_OUT | shape=2 algo=3 | s2.algo-next
RUN | $T/ps.+x | $T/h | PRISM_HUE_PLUS
EXPECT_OUT | algo=3 hue=30 | s2.hue-plus-30
RUN | $T/ps.+x | $T/h | PRISM_LIGHT_PLUS
EXPECT_OUT | hue=30 light=70 | s2.light-plus-10
RUN | $T/ps.+x | $T/h | PRISM_SHAPE_PREV
EXPECT_OUT | shape=1 algo=3 | s2.shape-prev
RUN | $T/ps.+x | $T/h | PRISM_ALGO_PREV
EXPECT_OUT | shape=1 algo=2 | s2.algo-prev
RUN | $T/ps.+x | $T/h | PRISM_HUE_MINUS
EXPECT_OUT | hue=0 light=70 | s2.hue-minus
RUN | $T/ps.+x | $T/h | PRISM_LIGHT_MINUS
EXPECT_OUT | hue=0 light=60 | s2.light-minus
# S3 wrap and clamp edges
WRITE | h/#.desktop/livedesk_prism.pdl | PRISM \p shape \p 3\nPRISM \p algo \p 3\nPRISM \p hue \p 330\nPRISM \p light \p 100\nPRISM \p custom \p 0\n
RUN | $T/ps.+x | $T/h | PRISM_SHAPE_NEXT
EXPECT_OUT | shape=0 | s3.shape-wraps-3-to-0
RUN | $T/ps.+x | $T/h | PRISM_ALGO_NEXT
EXPECT_OUT | algo=0 | s3.algo-wraps-3-to-0
RUN | $T/ps.+x | $T/h | PRISM_HUE_PLUS
EXPECT_OUT | hue=0 | s3.hue-wraps-330-to-0
RUN | $T/ps.+x | $T/h | PRISM_LIGHT_PLUS
EXPECT_OUT | light=100 | s3.light-clamps-at-100
RUN | $T/ps.+x | $T/h | PRISM_SHAPE_PREV
EXPECT_OUT | shape=3 | s3.shape-wraps-0-to-3
RUN | $T/ps.+x | $T/h | PRISM_ALGO_PREV
EXPECT_OUT | algo=3 | s3.algo-wraps-0-to-3
RUN | $T/ps.+x | $T/h | PRISM_HUE_MINUS
EXPECT_OUT | hue=330 | s3.hue-wraps-0-to-330
WRITE | h/#.desktop/livedesk_prism.pdl | PRISM \p shape \p 1\nPRISM \p algo \p 2\nPRISM \p hue \p 0\nPRISM \p light \p 5\nPRISM \p custom \p 0\n
RUN | $T/ps.+x | $T/h | PRISM_LIGHT_MINUS
EXPECT_OUT | light=0 | s3.light-clamps-at-0
WRITE | h/#.desktop/livedesk_prism.pdl | PRISM \p shape \p 1\nPRISM \p algo \p 2\nPRISM \p hue \p 0\nPRISM \p light \p 95\nPRISM \p custom \p 0\n
RUN | $T/ps.+x | $T/h | PRISM_LIGHT_PLUS
EXPECT_OUT | light=100 | s3.light-95-plus-clamps
# S4 toggle and reset
RUN | $T/ps.+x | $T/h | PRISM_TOGGLE
EXPECT_OUT | custom=1 | s4.toggle-on
RUN | $T/ps.+x | $T/h | PRISM_TOGGLE
EXPECT_OUT | custom=0 | s4.toggle-off
WRITE | h/#.desktop/livedesk_prism.pdl | PRISM \p shape \p 3\nPRISM \p algo \p 0\nPRISM \p hue \p 90\nPRISM \p light \p 10\nPRISM \p custom \p 1\n
RUN | $T/ps.+x | $T/h | PRISM_RESET
EXPECT_OUT | shape=1 algo=2 hue=0 light=60 custom=1 | s4.reset-keeps-custom
# S5 a corrupt file means the defaults; an unknown token changes nothing
WRITE | h/#.desktop/livedesk_prism.pdl | PRISM \p shape \p 9\nPRISM \p algo \p 2\nPRISM \p hue \p 500\nPRISM \p light \p 60\nPRISM \p custom \p 0\n
RUN | $T/ps.+x | $T/h | PRISM_SHOW
EXPECT_OUT | shape=1 algo=2 hue=0 light=60 custom=0 | s5.out-of-range-values-fall-back
WRITE | h/#.desktop/livedesk_prism.pdl | PRISM \p shape \p 2\nPRISM \p algo \p 1\nPRISM \p hue \p 60\nPRISM \p light \p 30\nPRISM \p custom \p 1\n
RUN | $T/ps.+x | $T/h | PRISM_NOPE
EXPECT_EXIT | 2 | s5.unknown-token-exit-2
RUN | $T/ps.+x | $T/h | PRISM_SHOW
EXPECT_OUT | shape=2 algo=1 hue=60 light=30 custom=1 | s5.unknown-token-changed-nothing
RUN | $T/ps.+x | $T/nohouse | PRISM_SHOW
EXPECT_EXIT | 2 | s5.missing-house-exit-2
RUN | $T/ps.+x
EXPECT_EXIT | 2 | s5.no-args-exit-2
# S6 the picture follows the variables
RUN | sh | -c | sha256sum $T/h/#.desktop/prism_theme.rgba > $T/a.txt
RUN | $T/ps.+x | $T/h | PRISM_HUE_PLUS
RUN | sh | -c | sha256sum $T/h/#.desktop/prism_theme.rgba > $T/b.txt
RUN | sh | -c | cmp -s $T/a.txt $T/b.txt; echo cmp=$? > $T/r1.txt
EXPECT_HAS | r1.txt | cmp=1 | s6.hue-step-changes-the-picture
RUN | $T/ps.+x | $T/h | PRISM_SHOW
RUN | sh | -c | sha256sum $T/h/#.desktop/prism_theme.rgba > $T/c.txt
RUN | sh | -c | cmp -s $T/b.txt $T/c.txt; echo cmp=$? > $T/r2.txt
EXPECT_HAS | r2.txt | cmp=0 | s6.same-variables-same-picture
# S7 no sibling renderer: exit 1
RUN | $T/nop/ps.+x | $T/h | PRISM_SHOW
EXPECT_EXIT | 1 | s7.no-prism_op-exit-1
CLEAN |
