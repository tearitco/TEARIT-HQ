CASE    | pane
# the feed: ui publishes logt_0..7 (the newest first) next to the unchanged raw log_0..7
RUN | $HOUSE/@.apps/deskopoly/ops/+x/deskopoly.+x | $T/app | $T/l | ui
EXPECT_OUT | phase=pre current=p1 human_turn=1 | ui-of-the-68-row-game-p1-is-to-act
RUN | /usr/bin/grep | ^logt_ | $T/l/ui.txt
EXPECT_OUT_IS | logt_0=B rejected A's offer #5\nlogt_1=A offered B: Golden Row for $900 (offer #5)\nlogt_2=A is up (round 6)\nlogt_3=C bought Phi Row for $120\nlogt_4=C rolled 5: Phi Row (for sale)\nlogt_5=C is up (round 5)\nlogt_6=B bought Helix Row for $140\nlogt_7=B rolled 10: Helix Row (for sale) | THE-EIGHT-PANE-ROWS-newest-first
RUN | /usr/bin/grep | ^log_ | $T/l/ui.txt
EXPECT_OUT_IS | log_0=r6 p2 reject rejected\nlog_1=r6 p1 offer id=5;give=prop:26;get=cash:900;round=1\nlog_2=r6 p3 end_turn next=p1;round=6\nlog_3=r5 p3 buy bought-120\nlog_4=r5 p3 roll to=9;for-sale\nlog_5=r5 p2 end_turn next=p3;round=5\nlog_6=r5 p2 buy bought-140\nlog_7=r5 p2 roll to=13;for-sale | THE-RAW-ROWS-ARE-UNCHANGED-additive-keys-only
RUN | /usr/bin/grep | -c | -E | ^logt_.*(to=\pid=\pgive=\pget=\pcard=\pbought-\p;) | $T/l/ui.txt
EXPECT_OUT_IS | 0 | no-raw-token-in-any-pane-row
RUN | /usr/bin/grep | -c | -E | ^log_.*(to=\pid=\pgive=\pget=\pcard=\pbought-\p;) | $T/l/ui.txt
CAPTURE | rawpane
EXPECT_GE | $rawpane | 6 | POSITIVE-CONTROL-the-same-grep-on-the-raw-rows-matches-so-the-zero-above-CAN-fail
RUN | $HOUSE/@.apps/deskopoly/ops/+x/deskopoly.+x | $T/app | $T/l | ledger_hash
CAPTURE | hash_after
EXPECT_EQ | $hash_before | $hash_after | the-ledger-hash-is-the-same-after-talk-and-ui
RUN | $HOUSE/@.apps/deskopoly/ops/+x/deskopoly.+x | $T/app | $T/l | replay
EXPECT_OUT | REPLAY events=68 | and-the-ledger-still-replays
RUN | $HOUSE/@.apps/deskopoly/ops/+x/deskopoly.+x | $T/app | $T/l | audit
EXPECT_EXIT | 0 | and-the-state-folder-passes-the-ghost-data-audit-no-new-file

CASE    | driver
# the REAL driver turns the engine's logt_ rows into the chat pane rows gml_* (title gm_chat_title)
MKDIR   | h/&.widgits/_shared-lib/ops/+x
COPY    | &.widgits/_shared-lib/ops/+x/raw_to_png.+x | h/&.widgits/_shared-lib/ops/+x/raw_to_png.+x
COPYDIR | @.apps/deskopoly | app_x | state,shots
MKDIR   | app_x/deskopoly-pchq/pieces/system/maps/deskopoly/play
MKDIR   | edit/state/world
MKDIR   | edit/edit-pchq/pieces/world_01
MKDIR   | edit/state/games/deskopoly/game
WRITE   | edit/state/world/switches.txt | running=0\n
WRITE   | edit/edit-pchq/pieces/world_01/state.txt | map_id=deskopoly\ndesk_id=board\n
COPY    | &.widgits/_shared-lib/harness/fixtures/dsk_talk_ledger.txt | edit/state/games/deskopoly/game/ledger.txt
SPAWN   | OWN | /usr/bin/sleep | 600
ENV     | GAME_OWNER_PID | $OWN
SPAWN   | DRV | $T/app_x/ops/+x/deskopoly_driver.+x | $T/h | $T/app_x | $T/edit
WAIT_HAS | edit/state/game_ui.txt | a game was in progress | 8000 | the-driver-continues-the-game-from-the-ledger
EXPECT_HAS | $T/edit/state/game_ui.txt | \ngm_chat_title=TEROPOLY table talk\n | the-pane-is-the-table-talk
EXPECT_HAS | $T/edit/state/game_ui.txt | \ngml_0_text=B rolled 10: Helix Row (for sale)\ngml_1_text=B bought Helix Row for $140\ngml_2_text=C is up (round 5)\ngml_3_text=C rolled 5: Phi Row (for sale)\ngml_4_text=C bought Phi Row for $120\ngml_5_text=A is up (round 6)\ngml_6_text=A offered B: Golden Row for $900 (offer #5)\ngml_7_text=B rejected A's offer #5\n | THE-PANE-ROWS-are-the-8-sentences-oldest-first-newest-last
RUN | /usr/bin/grep | ^gml_ | $T/edit/state/game_ui.txt
EXPECT_OUT_LACKS | offer id= | no-raw-offer-text-in-the-pane-rows
EXPECT_OUT_LACKS | bought- | and-no-bought--token
EXPECT_OUT_LACKS | to=13 | and-no-to=-token
EXPECT_OUT_LACKS | card= | and-no-card=-token
RUN | /usr/bin/grep | -c | gml_ | $T/edit/state/game_ui.txt
EXPECT_OUT_IS | 8 | exactly-8-pane-rows
EXPECT_HAS | $T/edit/state/games/deskopoly/game/ui.txt | log_0=r6 p2 reject rejected\n | CONTROL-the-engine-feed-still-carries-the-raw-log_-text-so-the-LACKS-above-can-fail-on-the-feed-if-the-driver-showed-it
CASE    | driver_end
RUN | /usr/bin/kill | $OWN
SLEEP   | 300
EXPECT_DEAD | $OWN | the-fake-owner-is-gone
SLEEP   | 1500
EXPECT_DEAD | $DRV | the-driver-ends-with-its-owner
CLEAN   |
