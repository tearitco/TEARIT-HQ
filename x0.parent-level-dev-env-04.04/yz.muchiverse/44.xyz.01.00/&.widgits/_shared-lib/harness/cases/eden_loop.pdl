EXPECT_HAS | game/conductor/eden_history.txt | TALK\p0\pasa\pava\ppath=phrase | no-binary-so-the-phrase-table-answers-and-the-path-is-logged
MKDIR   | tomom
RUN | /usr/bin/cp | -r | $HOUSE/#.Z.HUMAN_LLM/3.stage.llm.tomom@qroq.fame]921🐋️/curriculum | $T/tomom/curriculum
COPY    | #.Z.HUMAN_LLM/3.stage.llm.tomom@qroq.fame]921🐋️/curriculum_bank.txt | tomom/curriculum_bank.txt
