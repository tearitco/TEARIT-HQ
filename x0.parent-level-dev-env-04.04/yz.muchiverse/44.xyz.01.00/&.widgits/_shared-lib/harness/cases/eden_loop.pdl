CASE    | thirty-days-seed19
SCRATCH |
COPY    | &.widgits/livedesk-clock/ops/+x/lc_clock.+x | lc.+x
COPY    | &.widgits/_shared-lib/ops/+x/game_snapshot_op.+x | gso
MKDIR   | game
RUN | /usr/bin/cp | -r | $HOUSE/&.widgits/eden/conductor | $T/game/conductor
MKDIR   | game/conductor/ops/+x
COPY    | &.widgits/eden/ops/+x/eden_op.+x | game/conductor/ops/+x/eden_op.+x
WRITE   | game/conductor/wiring.pdl | WIRING \p participants \p ../participants\nWIRING \p template \p participant_template\nWIRING \p tree \p ..\nWIRING \p control_ledger \p ../../eden_control.txt\nWIRING \p snapshot \p ../../gso\nWIRING \p store \p ../../store\nWIRING \p house \p ../..
APPEND  | game/conductor/game.pdl | SETUP \p seed \p 19\n
RUN | $T/game/conductor/ops/+x/eden_op.+x | $T/game/conductor | begin
RUN | $T/game/conductor/ops/+x/eden_op.+x | $T/game/conductor | days | 30
EXPECT_EXIT | 0 | 30-days-ok
RUN | /usr/bin/grep | -c | ^DAY | $T/game/conductor/eden_history.txt
EXPECT_OUT_IS | 30 | 30-DAY-rows
RUN | /usr/bin/grep | -c | ^NEED | $T/game/conductor/eden_history.txt
EXPECT_OUT_IS | 60 | hunger-ticks-2-participants-x-30-days
EXPECT_HAS | game/conductor/eden_history.txt | \prain | weather-rain-occurred
EXPECT_HAS | game/conductor/eden_history.txt | \pclear | weather-clear-occurred
EXPECT_HAS | game/conductor/eden_history.txt | \peat\pitem= | hunger-made-them-eat
EXPECT_HAS | game/conductor/eden_history.txt | HOUSE\p | house-wear-ticks
EXPECT_HAS | game/conductor/eden_history.txt | GROW\p | garden-plots-grew
EXPECT_HAS | game/conductor/eden_history.txt | \pcollect\pplot= | garden-harvested
EXPECT_HAS | game/conductor/eden_history.txt | LAY\p | eggs-were-laid
EXPECT_HAS | game/conductor/eden_history.txt | \pfeed\panimal= | a-chicken-was-fed
EXPECT_HAS | game/conductor/eden_history.txt | FIND\p | a-dig-found-something
EXPECT_HAS | game/conductor/eden_history.txt | \pgold\pdepth= | a-dig-found-GOLD
EXPECT_HAS | game/conductor/eden_history.txt | \psilver\pdepth= | a-dig-found-SILVER
EXPECT_HAS | game/conductor/eden_history.txt | ITEM\p | item-ledger-rows
EXPECT_HAS | game/conductor/eden_history.txt | \pgold\p1\pdig | gold-entered-the-inventory-ledger-with-reason-dig
EXPECT_HAS | game/conductor/eden_history.txt | \psilver\p1\pdig | silver-entered-the-inventory-ledger-with-reason-dig
EXPECT_HAS | game/conductor/eden_history.txt | take=coin | an-item-was-SOLD-for-coin
EXPECT_HAS | game/conductor/eden_history.txt | TALK\p | somebody-talked
EXPECT_HAS | game/conductor/eden_history.txt | path=phrase | talk-path-logged-phrase-fallback-no-tomom-binary-wired
RUN | $T/game/conductor/ops/+x/eden_op.+x | $T/game/conductor | total | gold
EXPECT_OUT_IS | 1 | 1-gold-in-the-inventories
RUN | $T/game/conductor/ops/+x/eden_op.+x | $T/game/conductor | total | silver
EXPECT_OUT_IS | 1 | 1-silver-in-the-inventories
RUN | $T/game/conductor/ops/+x/eden_op.+x | $T/game/conductor | total | coin
EXPECT_OUT_IS | 10 | coin-total-is-still-10-after-the-sale-conserved
RUN | $T/game/conductor/ops/+x/eden_op.+x | $T/game/conductor | audit
EXPECT_OUT | AUDIT\pok=1 | audit-ok-item-sums-from-the-ledger-no-negative-trades-zero-sum-hunger-and-hp-in-bounds
RUN | /usr/bin/grep | -rq | -e | =- | $T/game/participants | $T/game/world
EXPECT_EXIT | 1 | no-negative-value-in-any-participant-or-world-file
RUN | $T/game/conductor/ops/+x/eden_op.+x | $T/game/conductor | count
EXPECT_OUT | total=9 | still-9-entities-nothing-spawned-or-lost-during-play
RUN | /usr/bin/grep | -c | ^ITEM.*\ptrade | $T/game/conductor/eden_history.txt
CAPTURE | v0
EXPECT_NE | $v0 | 0 | trades-happened
