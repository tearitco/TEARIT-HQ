EXPECT_EXIT | 0 | talk-through-tomom
EXPECT_HAS | game/conductor/eden_history.txt | path=tomom | tomom-answered-and-the-path-is-logged
EXPECT_HAS | game/conductor/eden_history.txt | TALK\p0\pasa\pava\ppath=tomom\pprompt= | TALK-row-has-speaker-listener-path-prompt
EXPECT_HAS | tomom/ask_log.txt | ASK \p asa:0 \p  | ask-logged-in-the-scratch-copy-in-the-tomom-hq-format
EXPECT_HAS | tomom/ask_log.txt | target= | ask-log-names-its-target
EXPECT_HAS | game/participants/ava/phone.txt | MSG\p0\pIN\pasa\p | line-in-the-listeners-phone-inbox
EXPECT_HAS | game/participants/asa/phone.txt | MSG\p0\pOUT\pava\p | line-in-the-speakers-outbox
EXPECT_HAS | game/participants/ava/phone.txt | shining cosmos | fixed-seed-7-answer-is-the-known-tomom-hq-one
RUN | /bin/sh | -c | grep -c '^MSG.IN.asa.shining' "$0" | $T/game/participants/ava/phone.txt
APPEND  | game/conductor/wiring.pdl | WIRING \p tomom_bin \p ../../tomom/does_not_exist\n
RUN | $T/game/conductor/ops/+x/eden_op.+x | $T/game/conductor | act | ava | talk
EXPECT_EXIT | 0 | talk-with-a-missing-binary
EXPECT_HAS | game/conductor/eden_history.txt | TALK\p0\pava\pasa\ppath=phrase | missing-binary-falls-back-to-the-phrase-table
APPEND  | game/conductor/wiring.pdl | WIRING \p tomom_bin \p /bin/false\n
RUN | $T/game/conductor/ops/+x/eden_op.+x | $T/game/conductor | act | ava | talk
EXPECT_EXIT | 0 | talk-with-a-binary-that-answers-nothing
RUN | /usr/bin/grep | -c | TALK.0.ava.asa.path=phrase | $T/game/conductor/eden_history.txt
EXPECT_OUT_IS | 2 | a-failing-binary-also-falls-back-both-ava-lines-are-phrase
CLEAN   |

