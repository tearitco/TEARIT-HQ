EXPECT_HAS | game/conductor/variables.txt | running=0\n | Stop-clears-running-in-the-conductor
RUN | $T/lc.+x | $T | cmd | g1 | advance | 3d
RUN | $T/lc.+x | $T | step | 0
RUN | $T/game/conductor/ops/+x/eden_op.+x | $T/game/conductor | count
EXPECT_OUT | total=0 | a-paused-then-advanced-clock-spawned-nothing
CLEAN   |

CASE    | slots-1-10-cursor-toolbar
SCRATCH |
COPY    | &.widgits/livedesk-clock/ops/+x/lc_clock.+x | lc.+x
COPY    | &.widgits/_shared-lib/ops/+x/game_snapshot_op.+x | gso
MKDIR   | game
RUN | /usr/bin/cp | -r | $HOUSE/&.widgits/eden/conductor | $T/game/conductor
MKDIR   | game/conductor/ops/+x
COPY    | &.widgits/eden/ops/+x/eden_op.+x | game/conductor/ops/+x/eden_op.+x
WRITE   | game/conductor/wiring.pdl | WIRING \p participants \p ../participants\nWIRING \p template \p participant_template\nWIRING \p tree \p ..\nWIRING \p control_ledger \p ../../eden_control.txt\nWIRING \p snapshot \p ../../gso\nWIRING \p store \p ../../store\nWIRING \p house \p ../..
APPEND  | game/conductor/game.pdl | SETUP \p seed \p 19\n
RUN | $T/game/conductor/ops/+x/eden_op.+x | $T/game/conductor | begin
RUN | $T/game/conductor/ops/+x/eden_op.+x | $T/game/conductor | days | 3
RUN | $T/game/conductor/ops/+x/eden_op.+x | $T/game/conductor | digest
CAPTURE | v0
RUN | $T/game/conductor/ops/+x/eden_op.+x | $T/game/conductor | save | 1
EXPECT_EXIT | 0 | Save-1
RUN | $T/game/conductor/ops/+x/eden_op.+x | $T/game/conductor | days | 2
RUN | $T/game/conductor/ops/+x/eden_op.+x | $T/game/conductor | save | 10
EXPECT_EXIT | 0 | Save-10
RUN | $T/game/conductor/ops/+x/eden_op.+x | $T/game/conductor | digest
CAPTURE | v1
RUN | $T/game/conductor/ops/+x/eden_op.+x | $T/game/conductor | days | 4
RUN | $T/game/conductor/ops/+x/eden_op.+x | $T/game/conductor | load | 10
EXPECT_EXIT | 0 | Load-10
RUN | $T/game/conductor/ops/+x/eden_op.+x | $T/game/conductor | digest
CAPTURE | v2
EXPECT_EQ | $v1 | $v2 | slot-10-round-trip-restores-day-5-exactly
RUN | $T/game/conductor/ops/+x/eden_op.+x | $T/game/conductor | load | 1
EXPECT_EXIT | 0 | Load-1
RUN | $T/game/conductor/ops/+x/eden_op.+x | $T/game/conductor | digest
CAPTURE | v3
EXPECT_EQ | $v0 | $v3 | slot-1-round-trip-restores-day-3-exactly
EXPECT_HAS | game/conductor/variables.txt | day=3\n | day-3
RUN | $T/game/conductor/ops/+x/eden_op.+x | $T/game/conductor | load | 10
RUN | $T/game/conductor/ops/+x/eden_op.+x | $T/game/conductor | digest
CAPTURE | v4
EXPECT_EQ | $v1 | $v4 | and-back-to-slot-10
EXPECT_HAS | slots.pdl | SLOT \p 10 \p id=slot10 \p rev=1 \p day=5 \p label=Day 5 | index-row-for-slot-10
EXPECT_HAS | slots.pdl | SLOT \p 1 \p id=slot1 \p rev=1 \p day=3 \p label=Day 3 | index-row-for-slot-1
RUN | $T/game/conductor/ops/+x/eden_op.+x | $T/game/conductor | slots
EXPECT_OUT | slot 10 \p slot10 \p 5 \p Day 5 | slots-lists-slot-10-with-its-day-label
EXPECT_OUT | slot 1 \p slot1 \p 3 \p Day 3 | slots-lists-slot-1
RUN | $T/game/conductor/ops/+x/eden_op.+x | $T/game/conductor | save | 0
EXPECT_EXIT | 1 | Save-0-refused
RUN | $T/game/conductor/ops/+x/eden_op.+x | $T/game/conductor | load | 0
EXPECT_EXIT | 1 | Load-0-refused
RUN | $T/game/conductor/ops/+x/eden_op.+x | $T/game/conductor | save | 11
EXPECT_EXIT | 1 | Save-11-refused
RUN | $T/game/conductor/ops/+x/eden_op.+x | $T/game/conductor | load | 11
EXPECT_EXIT | 1 | Load-11-refused
RUN | $T/game/conductor/ops/+x/eden_op.+x | $T/game/conductor | save | abc
EXPECT_EXIT | 1 | Save-abc-refused
RUN | $T/game/conductor/ops/+x/eden_op.+x | $T/game/conductor | load | abc
EXPECT_EXIT | 1 | Load-abc-refused
RUN | $T/game/conductor/ops/+x/eden_op.+x | $T/game/conductor | save | -1
EXPECT_EXIT | 1 | Save--1-refused
RUN | $T/game/conductor/ops/+x/eden_op.+x | $T/game/conductor | load | -1
EXPECT_EXIT | 1 | Load--1-refused
RUN | $T/game/conductor/ops/+x/eden_op.+x | $T/game/conductor | save | 1000
EXPECT_EXIT | 1 | Save-1000-refused
RUN | $T/game/conductor/ops/+x/eden_op.+x | $T/game/conductor | load | 1000
EXPECT_EXIT | 1 | Load-1000-refused
EXPECT_HAS | game/conductor/op_errors.txt | slot must be a number 1..10 | refusal-names-the-range
EXPECT_NOFILE | store/checkpoints/slot0/manifest.txt | nothing-saved-as-slot0
EXPECT_NOFILE | store/checkpoints/slot11/manifest.txt | nothing-saved-as-slot11
SUMTREE | v5 | game/world
SUMTREE | v6 | game/participants
RUN | $T/game/conductor/ops/+x/eden_op.+x | $T/game/conductor | load | 55
EXPECT_EXIT | 1 | Load-of-an-empty-slot-refused-and-changes-nothing
SUMTREE | v7 | game/world
SUMTREE | v8 | game/participants
EXPECT_EQ | $v5 | $v7 | a-refused-load-leaves-the-world-alone
EXPECT_EQ | $v6 | $v8 | a-refused-load-leaves-the-participants-alone
RUN | $T/game/conductor/ops/+x/eden_op.+x | $T/game/conductor | save | 1
EXPECT_EXIT | 1 | Save-1-again-refused-a-used-slot-is-not-overwritten
EXPECT_HAS | game/conductor/op_errors.txt | save slot1 failed | game_snapshot_op-refused-the-used-id
RUN | $T/game/conductor/ops/+x/eden_op.+x | $T/game/conductor | days | 2
RUN | $T/game/conductor/ops/+x/eden_op.+x | $T/game/conductor | resave | 1
EXPECT_EXIT | 0 | Resave-1-adds-revision-2
EXPECT_HAS | slots.pdl | SLOT \p 1 \p id=slot1_r2 \p rev=2 \p day=7 \p label=Day 7 | index-has-revision-2-at-day-7
EXPECT_EXISTS | store/checkpoints/slot1/manifest.txt | the-old-revision-is-kept
EXPECT_EXISTS | store/checkpoints/slot1_r2/manifest.txt | the-new-revision-exists
RUN | $T/game/conductor/ops/+x/eden_op.+x | $T/game/conductor | days | 3
RUN | $T/game/conductor/ops/+x/eden_op.+x | $T/game/conductor | load | 1
EXPECT_EXIT | 0 | Load-1-takes-the-newest-revision
EXPECT_HAS | game/conductor/variables.txt | day=7\n | load-1-gave-day-7-not-day-3
RUN | $T/game/conductor/ops/+x/eden_op.+x | $T/game/conductor | slot
EXPECT_OUT_IS | 1 | cursor-starts-at-1
RUN | $T/game/conductor/ops/+x/eden_op.+x | $T/game/conductor | slot | next
EXPECT_OUT_IS | 2 | cursor-next-2
RUN | $T/game/conductor/ops/+x/eden_op.+x | $T/game/conductor | slot | prev
RUN | $T/game/conductor/ops/+x/eden_op.+x | $T/game/conductor | slot | prev
EXPECT_OUT_IS | 10 | cursor-prev-wraps-1-to-10
RUN | $T/game/conductor/ops/+x/eden_op.+x | $T/game/conductor | slot | +10
EXPECT_OUT_IS | 10 | cursor-+10-stays-10-at-10
RUN | $T/game/conductor/ops/+x/eden_op.+x | $T/game/conductor | slot | 7
EXPECT_OUT_IS | 7 | cursor-set-to-7
RUN | $T/game/conductor/ops/+x/eden_op.+x | $T/game/conductor | slot | 0
EXPECT_EXIT | 1 | cursor-0-refused
RUN | $T/game/conductor/ops/+x/eden_op.+x | $T/game/conductor | slot
EXPECT_OUT_IS | 7 | cursor-unchanged-by-the-refusal
EXPECT_HAS | slot.txt | 7 | slot.txt-holds-the-number
RUN | $T/game/conductor/ops/+x/eden_op.+x | $T/game/conductor | days | 1
RUN | $T/game/conductor/ops/+x/eden_op.+x | $T/game/conductor | save-slot
EXPECT_EXIT | 0 | Save-slot-uses-the-cursor-7
EXPECT_EXISTS | store/checkpoints/slot7/manifest.txt | cursor-save-made-slot7
RUN | $T/game/conductor/ops/+x/eden_op.+x | $T/game/conductor | days | 2
RUN | $T/game/conductor/ops/+x/eden_op.+x | $T/game/conductor | load-slot
EXPECT_EXIT | 0 | Load-slot-uses-the-cursor-7
EXPECT_HAS | game/conductor/variables.txt | day=8\n | Load-slot-restored-day-8
RUN | $T/game/conductor/ops/+x/eden_op.+x | $T/game/conductor | resave-slot
EXPECT_EXIT | 0 | Resave-slot-uses-the-cursor-7
EXPECT_HAS | slots.pdl | id=slot7_r2 | cursor-resave-made-revision-2-of-7
COPY    | &.widgits/eden/toolbar_slots.pdl | toolbar_slots.pdl
RUN | $T/game/conductor/ops/+x/eden_op.+x | $T/game/conductor | toyread | $T/toolbar_slots.pdl | eden_menu_3_cmd
CAPTURE | v9
EXPECT_EQ | $v9 | cd . && game/conductor/ops/+x/eden_op.+x . save 2 | the-row-read-by-the-taskbar-reader-is-the-Save-2-command
RUN | /bin/sh | -c | eval "$(printf '%s' "$0" \p sed "s# [.]# $1#g")" | $v9 | $T
EXPECT_EXISTS | store/checkpoints/slot2/manifest.txt | the-toolbar-Save-2-row-saved-slot-2-from-a-bare-sh-c
RUN | $T/game/conductor/ops/+x/eden_op.+x | $T/game/conductor | toyread | $T/toolbar_slots.pdl | eden_menu_21_cmd
CAPTURE | v10
RUN | $T/game/conductor/ops/+x/eden_op.+x | $T/game/conductor | days | 2
RUN | /bin/sh | -c | eval "$(printf '%s' "$0" \p sed "s# [.]# $1#g")" | $v10 | $T
EXPECT_HAS | game/conductor/variables.txt | day=5\n | the-toolbar-Load-10-row-loaded-slot-10-day-5
CLEAN   |

CASE    | determinism-by-seed
SCRATCH |
COPY    | &.widgits/livedesk-clock/ops/+x/lc_clock.+x | lc.+x
COPY    | &.widgits/_shared-lib/ops/+x/game_snapshot_op.+x | gso
MKDIR   | game
RUN | /usr/bin/cp | -r | $HOUSE/&.widgits/eden/conductor | $T/game/conductor
MKDIR   | game/conductor/ops/+x
COPY    | &.widgits/eden/ops/+x/eden_op.+x | game/conductor/ops/+x/eden_op.+x
WRITE   | game/conductor/wiring.pdl | WIRING \p participants \p ../participants\nWIRING \p template \p participant_template\nWIRING \p tree \p ..\nWIRING \p control_ledger \p ../../eden_control.txt\nWIRING \p snapshot \p ../../gso\nWIRING \p store \p ../../store\nWIRING \p house \p ../..
APPEND  | game/conductor/game.pdl | SETUP \p seed \p 19\n
MKDIR   | g2
RUN | /usr/bin/cp | -r | $HOUSE/&.widgits/eden/conductor | $T/g2/conductor
MKDIR   | g2/conductor/ops/+x
COPY    | &.widgits/eden/ops/+x/eden_op.+x | g2/conductor/ops/+x/eden_op.+x
WRITE   | g2/conductor/wiring.pdl | WIRING \p participants \p ../participants\nWIRING \p template \p participant_template\nWIRING \p tree \p ..\nWIRING \p control_ledger \p ../../eden_control.txt\nWIRING \p snapshot \p ../../gso\nWIRING \p store \p ../../store\nWIRING \p house \p ../..
APPEND  | g2/conductor/game.pdl | SETUP \p seed \p 19\n
MKDIR   | g3
RUN | /usr/bin/cp | -r | $HOUSE/&.widgits/eden/conductor | $T/g3/conductor
MKDIR   | g3/conductor/ops/+x
COPY    | &.widgits/eden/ops/+x/eden_op.+x | g3/conductor/ops/+x/eden_op.+x
WRITE   | g3/conductor/wiring.pdl | WIRING \p participants \p ../participants\nWIRING \p template \p participant_template\nWIRING \p tree \p ..\nWIRING \p control_ledger \p ../../eden_control.txt\nWIRING \p snapshot \p ../../gso\nWIRING \p store \p ../../store\nWIRING \p house \p ../..
APPEND  | g3/conductor/game.pdl | SETUP \p seed \p 20\n
RUN | $T/game/conductor/ops/+x/eden_op.+x | $T/game/conductor | begin
RUN | $T/game/conductor/ops/+x/eden_op.+x | $T/game/conductor | days | 30
RUN | $T/g2/conductor/ops/+x/eden_op.+x | $T/g2/conductor | begin
RUN | $T/g2/conductor/ops/+x/eden_op.+x | $T/g2/conductor | days | 30
RUN | $T/g3/conductor/ops/+x/eden_op.+x | $T/g3/conductor | begin
RUN | $T/g3/conductor/ops/+x/eden_op.+x | $T/g3/conductor | days | 30
RUN | $T/game/conductor/ops/+x/eden_op.+x | $T/game/conductor | digest
CAPTURE | v0
RUN | $T/g2/conductor/ops/+x/eden_op.+x | $T/g2/conductor | digest
CAPTURE | v1
RUN | $T/g3/conductor/ops/+x/eden_op.+x | $T/g3/conductor | digest
CAPTURE | v2
EXPECT_EQ | $v0 | $v1 | same-seed-same-tree-byte-for-byte
EXPECT_NE | $v0 | $v2 | a-different-seed-gives-a-different-tree
RUN | /bin/cmp | $T/game/conductor/eden_history.txt | $T/g2/conductor/eden_history.txt
EXPECT_EXIT | 0 | histories-identical
RUN | /bin/cmp | $T/game/world/chicken_1/variables.txt | $T/g2/world/chicken_1/variables.txt
EXPECT_EXIT | 0 | world-entity-files-identical
RUN | /bin/cmp | -s | $T/game/conductor/eden_history.txt | $T/g3/conductor/eden_history.txt
EXPECT_EXIT | 1 | seed-20-history-differs
RUN | $T/g3/conductor/ops/+x/eden_op.+x | $T/g3/conductor | audit
EXPECT_OUT | AUDIT\pok=1 | seed-20-also-passes-the-audit
CLEAN   |
