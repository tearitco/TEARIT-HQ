RUN | /usr/bin/sed | -i | s/srand(time(NULL))/srand(7)/ | $T/tomom/cs7.c
RUN | /usr/bin/gcc | -O2 | -w | -o | $T/tomom/chatbot_seed7 | $T/tomom/cs7.c | -lm
EXPECT_EXIT | 0 | chatbot_seed7-built-in-the-scratch-copy-only
