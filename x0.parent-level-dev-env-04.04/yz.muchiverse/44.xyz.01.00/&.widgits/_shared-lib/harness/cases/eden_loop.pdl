EXPECT_HAS | eden/conductor/meta.pdl | \p Load slot... | menu-row-Load-slot
EXPECT_HAS | eden/conductor/meta.pdl | \p Resave slot... | menu-row-Resave-slot
EXPECT_HAS | eden/conductor/meta.pdl | \p Slot next  | menu-row-Slot-next
EXPECT_HAS | eden/conductor/meta.pdl | eden_op.+x" "$0" save-slot' | Save-slot-calls-the-op-directly
EXPECT_HAS | eden/conductor/meta.pdl | \p Start  | v0-Start-row-kept
EXPECT_HAS | eden/conductor/meta.pdl | --trigger save3' | v0-Save-3-row-kept
EXPECT_EXISTS | eden/conductor/event_pkg/pages/page_15/event.pal | page-15-begin
EXPECT_EXISTS | eden/conductor/event_pkg/pages/page_16/event.pal | page-16-stop
EXPECT_HAS | eden/conductor/event_pkg/pages/page_15/event.pal | eden_op.+x . begin | page-15-runs-begin
EXPECT_HAS | eden/conductor/event_pkg/pages/page_16/event.pal | eden_op.+x . stop | page-16-runs-stop
EXPECT_NOFILE | eden/conductor/world_templates/house/entity_uid.txt | templates-carry-no-uid
EXPECT_LACKS | eden/conductor/world_templates/house/pal.pdl | hash | house-template-has-no-PAL-hash
EXPECT_LACKS | eden/conductor/world_templates/chicken/pal.pdl | hash | chicken-template-has-no-PAL-hash
EXPECT_LACKS | eden/conductor/world_templates/plant/pal.pdl | hash | plant-template-has-no-PAL-hash
