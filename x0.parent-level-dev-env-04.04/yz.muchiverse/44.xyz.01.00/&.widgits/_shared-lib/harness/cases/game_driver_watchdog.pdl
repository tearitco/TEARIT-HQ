# game_driver_watchdog (2026-11-08, owner: "make sure they never disappear again"). The sidebars, players bar and 3D players come from the open book's driver feed. After a session reset or relaunch the Player tab said "playing" with NO driver: no feed, no side menus, no pieces.
# The resident core (petslike_core.c daemon loop, built into rpg_edit_hq) now restarts the driver: while the running switch is on and the open book has a `GAME | driver` row, a feed without gm_on=1 for two checks 5 s apart starts it again.
# SCRATCH house only (the RPG Maker sheets are a read-only symlink to the real ones: without them the core exits at start, and the "nothing restarted" scenarios would pass vacuously, hence the alive checks). The "driver" is /usr/bin/cp copying a seed file, so we can SEE that the core started it. Three scenarios: restart when missing, leave a live feed alone (no fork storm), Stop disables it.
RESULTS | ../results/game_driver_watchdog.txt
ENV     | LC_ALL | C
CASE    | missing-driver-is-restarted
SCRATCH |
MKDIR   | house/&.widgits/_shared-lib/ops/+x
RUN     | /bin/ln | -s | $HOUSE/../../../#.NNEST_ASSETS | $T/house/#.NNEST_ASSETS
COPYDIR | @.apps/rpg-edit-hq | house/@.apps/rpg-edit-hq | state
MKDIR   | house/@.apps/rpg-edit-hq/state/world
MKDIR   | house/@.apps/fakegame
WRITE   | house/seed.txt | the-driver-ran\n
WRITE   | house/@.apps/fakegame/game.pdl | GAME | driver | /usr/bin/cp {house}/seed.txt {editor}/state/driver_ran.txt\n
WRITE   | house/@.apps/rpg-edit-hq/state/last_book.txt | book=fakegame\n
WRITE   | house/@.apps/rpg-edit-hq/state/world/switches.txt | running=1\n
EXPECT_NOFILE | house/@.apps/rpg-edit-hq/state/driver_ran.txt | VACUITY-no-driver-has-run-yet
SPAWN   | CORE | $T/house/@.apps/rpg-edit-hq/ops/+x/rpg_edit_hq.+x | $T/house | $T/house/@.apps/rpg-edit-hq
WAIT_HAS | house/@.apps/rpg-edit-hq/state/driver_ran.txt | the-driver-ran | 25000 | THE-WATCHDOG-STARTED-THE-MISSING-DRIVER-within-25-s-with-no-Play-press
EXPECT_ALIVE | $CORE | the-core-daemon-is-still-running
RUN     | /usr/bin/kill | $CORE
SLEEP   | 1500
EXPECT_DEAD | $CORE | the-core-daemon-stopped-by-pid
CLEAN   |
CASE    | live-feed-is-left-alone
SCRATCH |
MKDIR   | house/&.widgits/_shared-lib/ops/+x
RUN     | /bin/ln | -s | $HOUSE/../../../#.NNEST_ASSETS | $T/house/#.NNEST_ASSETS
COPYDIR | @.apps/rpg-edit-hq | house/@.apps/rpg-edit-hq | state
MKDIR   | house/@.apps/rpg-edit-hq/state/world
MKDIR   | house/@.apps/fakegame
WRITE   | house/seed.txt | the-driver-ran\n
WRITE   | house/@.apps/fakegame/game.pdl | GAME | driver | /usr/bin/cp {house}/seed.txt {editor}/state/driver_ran.txt\n
WRITE   | house/@.apps/rpg-edit-hq/state/last_book.txt | book=fakegame\n
WRITE   | house/@.apps/rpg-edit-hq/state/world/switches.txt | running=1\n
WRITE   | house/@.apps/rpg-edit-hq/state/game_ui.txt | gm_on=1\ngm_pid=1\n
SPAWN   | CORE2 | $T/house/@.apps/rpg-edit-hq/ops/+x/rpg_edit_hq.+x | $T/house | $T/house/@.apps/rpg-edit-hq
SLEEP   | 16000
EXPECT_NOFILE | house/@.apps/rpg-edit-hq/state/driver_ran.txt | A-LIVE-FEED-MEANS-NO-RESTART-no-fork-per-check-while-a-driver-publishes-gm_on-1
EXPECT_ALIVE | $CORE2 | VACUITY-the-core-daemon-was-alive-the-whole-time-so-no-restart-is-a-real-result
RUN     | /usr/bin/kill | $CORE2
SLEEP   | 1500
EXPECT_DEAD | $CORE2 | the-core-daemon-stopped-by-pid
CLEAN   |
CASE    | stale-feed-after-a-crash-is-restarted-at-launch
SCRATCH |
MKDIR   | house/&.widgits/_shared-lib/ops/+x
RUN     | /bin/ln | -s | $HOUSE/../../../#.NNEST_ASSETS | $T/house/#.NNEST_ASSETS
COPYDIR | @.apps/rpg-edit-hq | house/@.apps/rpg-edit-hq | state
MKDIR   | house/@.apps/rpg-edit-hq/state/world
MKDIR   | house/@.apps/fakegame
WRITE   | house/seed.txt | the-driver-ran\n
WRITE   | house/@.apps/fakegame/game.pdl | GAME | driver | /usr/bin/cp {house}/seed.txt {editor}/state/driver_ran.txt\n
WRITE   | house/@.apps/rpg-edit-hq/state/last_book.txt | book=fakegame\n
WRITE   | house/@.apps/rpg-edit-hq/state/world/switches.txt | running=1\n
# the feed the DEAD driver left behind: it still says gm_on=1 (2026-11-09: after a reboot this fooled the guard for 45 minutes: no 3D players, stale bars)
WRITE   | house/@.apps/rpg-edit-hq/state/game_ui.txt | gm_on=1\ngm_pid=2000000000\n
EXPECT_NOFILE | house/@.apps/rpg-edit-hq/state/driver_ran.txt | VACUITY-no-driver-has-run-yet
SPAWN   | CORE4 | $T/house/@.apps/rpg-edit-hq/ops/+x/rpg_edit_hq.+x | $T/house | $T/house/@.apps/rpg-edit-hq
WAIT_HAS | house/@.apps/rpg-edit-hq/state/driver_ran.txt | the-driver-ran | 12000 | A-DEAD-DRIVER-PID-IN-A-GM_ON-1-FEED-RESTARTS-THE-DRIVER-at-launch-without-waiting-for-two-checks
EXPECT_ALIVE | $CORE4 | the-core-daemon-is-still-running
RUN     | /usr/bin/kill | $CORE4
SLEEP   | 1500
EXPECT_DEAD | $CORE4 | the-core-daemon-stopped-by-pid
CLEAN   |
CASE    | legacy-feed-without-a-pid-is-restarted-once-at-launch
SCRATCH |
MKDIR   | house/&.widgits/_shared-lib/ops/+x
RUN     | /bin/ln | -s | $HOUSE/../../../#.NNEST_ASSETS | $T/house/#.NNEST_ASSETS
COPYDIR | @.apps/rpg-edit-hq | house/@.apps/rpg-edit-hq | state
MKDIR   | house/@.apps/rpg-edit-hq/state/world
MKDIR   | house/@.apps/fakegame
WRITE   | house/seed.txt | the-driver-ran\n
WRITE   | house/@.apps/fakegame/game.pdl | GAME | driver | /usr/bin/cp {house}/seed.txt {editor}/state/driver_ran.txt\n
WRITE   | house/@.apps/rpg-edit-hq/state/last_book.txt | book=fakegame\n
WRITE   | house/@.apps/rpg-edit-hq/state/world/switches.txt | running=1\n
WRITE   | house/@.apps/rpg-edit-hq/state/game_ui.txt | gm_on=1\n
SPAWN   | CORE5 | $T/house/@.apps/rpg-edit-hq/ops/+x/rpg_edit_hq.+x | $T/house | $T/house/@.apps/rpg-edit-hq
WAIT_HAS | house/@.apps/rpg-edit-hq/state/driver_ran.txt | the-driver-ran | 12000 | A-PRE-PID-FEED-CANNOT-PROVE-A-LIVE-DRIVER-so-one-start-attempt-at-launch-(a-real-driver-refuses-by-flock)
RUN     | /usr/bin/kill | $CORE5
SLEEP   | 1500
EXPECT_DEAD | $CORE5 | the-core-daemon-stopped-by-pid
CLEAN   |
CASE    | the-driver-pid-dies-mid-session
SCRATCH |
MKDIR   | house/&.widgits/_shared-lib/ops/+x
RUN     | /bin/ln | -s | $HOUSE/../../../#.NNEST_ASSETS | $T/house/#.NNEST_ASSETS
COPYDIR | @.apps/rpg-edit-hq | house/@.apps/rpg-edit-hq | state
MKDIR   | house/@.apps/rpg-edit-hq/state/world
MKDIR   | house/@.apps/fakegame
WRITE   | house/seed.txt | the-driver-ran\n
WRITE   | house/@.apps/fakegame/game.pdl | GAME | driver | /usr/bin/cp {house}/seed.txt {editor}/state/driver_ran.txt\n
WRITE   | house/@.apps/rpg-edit-hq/state/last_book.txt | book=fakegame\n
WRITE   | house/@.apps/rpg-edit-hq/state/world/switches.txt | running=1\n
WRITE   | house/@.apps/rpg-edit-hq/state/game_ui.txt | gm_on=1\ngm_pid=1\n
SPAWN   | CORE6 | $T/house/@.apps/rpg-edit-hq/ops/+x/rpg_edit_hq.+x | $T/house | $T/house/@.apps/rpg-edit-hq
SLEEP   | 9000
EXPECT_NOFILE | house/@.apps/rpg-edit-hq/state/driver_ran.txt | A-LIVE-PID-MEANS-NO-RESTART
WRITE   | house/@.apps/rpg-edit-hq/state/game_ui.txt | gm_on=1\ngm_pid=2000000000\n
WAIT_HAS | house/@.apps/rpg-edit-hq/state/driver_ran.txt | the-driver-ran | 12000 | THE-DRIVER-PID-VANISHED-(killed-while-the-editor-stays-up)-AND-THE-FEED-STILL-SAYS-gm_on-1-SO-THE-GUARD-RESTARTS-IT
EXPECT_ALIVE | $CORE6 | VACUITY-the-core-daemon-was-alive-the-whole-time
RUN     | /usr/bin/kill | $CORE6
SLEEP   | 1500
EXPECT_DEAD | $CORE6 | the-core-daemon-stopped-by-pid
CLEAN   |
CASE    | stop-disables-it
SCRATCH |
MKDIR   | house/&.widgits/_shared-lib/ops/+x
RUN     | /bin/ln | -s | $HOUSE/../../../#.NNEST_ASSETS | $T/house/#.NNEST_ASSETS
COPYDIR | @.apps/rpg-edit-hq | house/@.apps/rpg-edit-hq | state
MKDIR   | house/@.apps/rpg-edit-hq/state/world
MKDIR   | house/@.apps/fakegame
WRITE   | house/seed.txt | the-driver-ran\n
WRITE   | house/@.apps/fakegame/game.pdl | GAME | driver | /usr/bin/cp {house}/seed.txt {editor}/state/driver_ran.txt\n
WRITE   | house/@.apps/rpg-edit-hq/state/last_book.txt | book=fakegame\n
WRITE   | house/@.apps/rpg-edit-hq/state/world/switches.txt | running=0\n
SPAWN   | CORE3 | $T/house/@.apps/rpg-edit-hq/ops/+x/rpg_edit_hq.+x | $T/house | $T/house/@.apps/rpg-edit-hq
SLEEP   | 16000
EXPECT_NOFILE | house/@.apps/rpg-edit-hq/state/driver_ran.txt | STOP-DISABLES-THE-WATCHDOG-running-0-means-the-owner-froze-the-game-nothing-is-restarted
EXPECT_ALIVE | $CORE3 | VACUITY-the-core-daemon-was-alive-the-whole-time-so-no-restart-is-a-real-result
RUN     | /usr/bin/kill | $CORE3
SLEEP   | 1500
EXPECT_DEAD | $CORE3 | the-core-daemon-stopped-by-pid
CLEAN   |
