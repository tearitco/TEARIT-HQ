# nb_media (2026-11-08): port of tests/nb_media_test.sh (shell) to pal + case data (the owner allows no new .sh; AGENTS.md). Drives ONE page through nb_js_worker with the nb_probe op, no window. The probe is a DATA file (&.widgits/_shared-lib/harness/fixtures/nb_probes/media.css); a new probe is a new .js plus its expected lines.
# ANCHORING: the console capture echoes the probe's own SOURCE, so every token is anchored to a line start with a leading newline (the echo begins with '>'); an unanchored token would match the echo and report a pass or a failure the run did not have.
# NEEDS the real worker binary (ops/+x/nb_js_worker.+x). That binary needs wasm3 to build, which is not in the repo (audit 2026-11-08 P1-5): on a stale binary this case FAILS loudly, which is the truth.
RESULTS | ../results/nb_media.txt
ENV     | LC_ALL | C
# G2.5: @media switches at the breakpoint, both sides: at 700 and 767 the .narrow branch is visible and .wide is display:none with w=0; at 768 and 900 the reverse. The worker lays out at the requested innerWidth.
CASE    | width-700
SCRATCH |
COPY    | &.hq-apps/network/ops/+x/nb_probe.+x | np.+x
WRITE   | dom.txt | N\p#document\p\p\p0\p\p0\p\nD\nN\phtml\p\p\p0\p\p0\p\nU\n
COPY    | &.widgits/_shared-lib/harness/fixtures/nb_probes/media_page.js | page.js
COPY    | &.widgits/_shared-lib/harness/fixtures/nb_probes/media.css | style.css
COPY    | &.widgits/_shared-lib/harness/fixtures/nb_probes/media_probe.js | probe.js
RUN | $T/np.+x | --worker | $HOUSE/&.hq-apps/network/ops/+x/nb_js_worker.+x | --page | $T/page.js | --dom | $T/dom.txt | --css | $T/style.css | --width | 700 | --href | https://example.invalid/ | --title | media:fixture | --probe | $T/probe.js | --console | $T/console.txt | --load-timeout | 30 | --eval-timeout | 30
EXPECT_EXIT | 0 | the-probe-completed
EXPECT_HAS | console.txt | \n=>MEDIA width=700  | the-worker-laid-out-at-innerWidth-700
EXPECT_HAS | console.txt | wide:disp=none,w=0, | at-700-the-wide-branch-is-display-none-and-collapses-to-w-0
EXPECT_LACKS | console.txt | narrow:disp=none | at-700-the-narrow-branch-is-NOT-display-none
EXPECT_LACKS | console.txt | narrow:disp=block,w=0, | at-700-the-narrow-branch-has-width-above-0
CLEAN   |
CASE    | width-767
SCRATCH |
COPY    | &.hq-apps/network/ops/+x/nb_probe.+x | np.+x
WRITE   | dom.txt | N\p#document\p\p\p0\p\p0\p\nD\nN\phtml\p\p\p0\p\p0\p\nU\n
COPY    | &.widgits/_shared-lib/harness/fixtures/nb_probes/media_page.js | page.js
COPY    | &.widgits/_shared-lib/harness/fixtures/nb_probes/media.css | style.css
COPY    | &.widgits/_shared-lib/harness/fixtures/nb_probes/media_probe.js | probe.js
RUN | $T/np.+x | --worker | $HOUSE/&.hq-apps/network/ops/+x/nb_js_worker.+x | --page | $T/page.js | --dom | $T/dom.txt | --css | $T/style.css | --width | 767 | --href | https://example.invalid/ | --title | media:fixture | --probe | $T/probe.js | --console | $T/console.txt | --load-timeout | 30 | --eval-timeout | 30
EXPECT_EXIT | 0 | the-probe-completed
EXPECT_HAS | console.txt | \n=>MEDIA width=767  | the-worker-laid-out-at-innerWidth-767
EXPECT_HAS | console.txt | wide:disp=none,w=0, | at-767-the-wide-branch-is-display-none-and-collapses-to-w-0
EXPECT_LACKS | console.txt | narrow:disp=none | at-767-the-narrow-branch-is-NOT-display-none
EXPECT_LACKS | console.txt | narrow:disp=block,w=0, | at-767-the-narrow-branch-has-width-above-0
CLEAN   |
