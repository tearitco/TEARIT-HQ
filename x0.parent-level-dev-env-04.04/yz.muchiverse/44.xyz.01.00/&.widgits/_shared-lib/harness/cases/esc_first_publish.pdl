# esc_first_publish: Esc backs out ONE level, innermost first (owner 2026-11-05). While something is possessed the daemon publishes <app>/board/state/esc_first.txt (the engine's release key, 57); the window then sends that instead of Esc (live_esc_first.pal) so In: stays on. No file when nothing is possessed or when the possessed piece is locked (piece.pdl de_possessible | 1).
# The publish runs in follow_pchq, which an Enter that chooses a character calls: Enter on Harold's cell (7,7) drives it. possessed_id is written by hand (the engine does that live). Same scratch-daemon method as possess_enter_daemon.pal.
RESULTS | ../results/esc_first_publish.txt
ENV | LC_ALL | C

INCLUDE | ../fixtures/editor_house.pdl

MKDIR | house/@.apps/rpg-edit-hq/board/state
MKDIR | sess/pieces/keyboard
WRITE | sess/pieces/keyboard/history.txt | KEY_PRESSED: 65\n
WRITE | house/@.apps/rpg-edit-hq/board/state/ui.txt | bv_session=$T/sess\n
WRITE | house/@.apps/rpg-edit-hq/rpg-edit-hq-pchq/pieces/xelector_01/state.txt | entity_type=xelector\npos_x=5\npos_y=5\npos_z=0\npossessed_id=none\n
WRITE | house/@.apps/rpg-edit-hq/state/active.txt | asa\n
WRITE | house/@.apps/rpg-edit-hq/state/flag_ctl.txt | pet\n
MKDIR | house/@.apps/rpg-edit-hq/state/world
WRITE | house/@.apps/rpg-edit-hq/state/world/switches.txt | int=1\nrunning=0\n
# a stand-in board window: the daemon only publishes while a khtpm_core_render of the editor board exists (viewer_kinds scans /proc cmdlines at start), so a sleeping process carrying that cmdline makes its own 400 ms update run (the Enter trigger no longer works: Enter on Harold now possesses him, D1)
SPAWN | V | /bin/sh | -c | sleep 300 | khtpm_core_render | $T/house/@.apps/rpg-edit-hq/board/pchq-board.xhtpm
SPAWN | D | $T/house/@.apps/rpg-edit-hq/ops/+x/rpg_edit_hq.+x | $T/house | $T/house/@.apps/rpg-edit-hq
SLEEP | 1500
MKDIR | house/@.apps/rpg-edit-hq/rpg-edit-hq-pchq/pieces/hero_01
WRITE | house/@.apps/rpg-edit-hq/rpg-edit-hq-pchq/pieces/hero_01/state.txt | entity_type=hero\npos_x=7\npos_y=7\n

CASE    | possessed-publishes-the-release-key
WRITE | house/@.apps/rpg-edit-hq/rpg-edit-hq-pchq/pieces/xelector_01/state.txt | entity_type=xelector\npos_x=7\npos_y=7\npos_z=0\npossessed_id=hero_01\n
WAIT_HAS | house/@.apps/rpg-edit-hq/board/state/esc_first.txt | 57 | 4000 | the-release-key-is-published-while-possessed

CASE    | a-pet-possessed-by-id-publishes-it-too
WRITE | house/@.apps/rpg-edit-hq/rpg-edit-hq-pchq/pieces/xelector_01/state.txt | entity_type=xelector\npos_x=7\npos_y=7\npos_z=0\npossessed_id=none\n
SLEEP | 1500
EXPECT_NOFILE | house/@.apps/rpg-edit-hq/board/state/esc_first.txt | free-xelector-leaves-no-file
WRITE | house/@.apps/rpg-edit-hq/rpg-edit-hq-pchq/pieces/xelector_01/state.txt | entity_type=xelector\npos_x=7\npos_y=7\npos_z=0\npossessed_id=ember\n
WAIT_HAS | house/@.apps/rpg-edit-hq/board/state/esc_first.txt | 57 | 4000 | D1-an-id-with-no-piece-file-is-published-like-any-other

CASE    | NEGATIVE-a-locked-piece-removes-it
WRITE | house/@.apps/rpg-edit-hq/rpg-edit-hq-pchq/pieces/xelector_01/state.txt | entity_type=xelector\npos_x=7\npos_y=7\npos_z=0\npossessed_id=hero_01\n
WAIT_HAS | house/@.apps/rpg-edit-hq/board/state/esc_first.txt | 57 | 4000 | present-before-the-lock
WRITE | house/@.apps/rpg-edit-hq/rpg-edit-hq-pchq/pieces/hero_01/piece.pdl | SECTION | de_possessible | 1\n
SLEEP | 1500
EXPECT_NOFILE | house/@.apps/rpg-edit-hq/board/state/esc_first.txt | a-locked-hero-keeps-the-old-Esc-so-Esc-leaves-In

CASE    | unlocking-publishes-it-again
WRITE | house/@.apps/rpg-edit-hq/rpg-edit-hq-pchq/pieces/hero_01/piece.pdl | SECTION | de_possessible | 0\n
WAIT_HAS | house/@.apps/rpg-edit-hq/board/state/esc_first.txt | 57 | 4000 | back-after-the-unlock

CASE    | NEGATIVE-nothing-possessed-removes-it
WRITE | house/@.apps/rpg-edit-hq/rpg-edit-hq-pchq/pieces/xelector_01/state.txt | entity_type=xelector\npos_x=7\npos_y=7\npos_z=0\npossessed_id=none\n
SLEEP | 1500
EXPECT_NOFILE | house/@.apps/rpg-edit-hq/board/state/esc_first.txt | possessed-id-none-leaves-no-file

CLEAN |
