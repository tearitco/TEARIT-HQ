# ring_board_core (RING-BOARD-AS-RMMV-EVENTS-DESIGN.md section 3-5; the neutral ring-board engine): a 40-tile ring board game made only of RPG Maker-style event pages + five tiny compiled ops.
# Scratch roots only: the entity is copied to $T/game, the ops (and the digipet event_page_op) beside it, prisc is compiled into $T. Real event.pal pages, real ops, real lc_clock, real game_snapshot_op.
# The independent referee is ring_audit_op (re-derives money, positions, owners and every turn step from the ledgers). Games are driven by a pal loop (prisc `exec` of the Bot pages + the referee), no shell loop.
# Tunable overrides for the full games (data only, rules.pdl): small cash and GO so a seeded game reaches a bankruptcy within tens of turns instead of hundreds (each turn costs ~0.3 s of prisc start-ups).
RESULTS | ../results/ring_board_core.txt
CASE | ops
SCRATCH | 
RUN | /usr/bin/cp | -r | $HOUSE/&.widgits/ring-board-rmmv/entity | $T/game
MKDIR | game/ops/+x
COPY | &.widgits/ring-board-rmmv/ops/+x/var_math.+x | game/ops/+x/var_math.+x
COPY | &.widgits/ring-board-rmmv/ops/+x/dice_roll.+x | game/ops/+x/dice_roll.+x
COPY | &.widgits/ring-board-rmmv/ops/+x/var_sweep.+x | game/ops/+x/var_sweep.+x
COPY | &.widgits/ring-board-rmmv/ops/+x/tile_lookup.+x | game/ops/+x/tile_lookup.+x
COPY | &.widgits/ring-board-rmmv/ops/+x/cash_transfer.+x | game/ops/+x/cash_transfer.+x
COPY | &.widgits/digipet/ops/+x/event_page_op.+x | game/ops/+x/event_page_op.+x
COPY | &.widgits/_shared-lib/harness/ops/+x/ring_audit_op.+x | game/ops/+x/ring_audit_op.+x
RUN | /usr/bin/gcc | -O2 | -w | -o | $T/prisc | $HOUSE/&.widgits/_shared-lib/system/prisc+x.c | -lm
ENV | EVENT_PAGE_PRISC | $T/prisc
WRITE | game/variables.txt | turn=3\ncurrent=2\ncash_2=100\n
RUN | $T/game/ops/+x/dice_roll.+x | $T/game | 42 | 0
EXPECT_OUT_IS | 4 3 | dice-seed42-counter0-is-4-3
RUN | $T/game/ops/+x/dice_roll.+x | $T/game | 42 | 1
EXPECT_OUT_IS | 4 4 | dice-seed42-counter1-is-4-4
RUN | $T/game/ops/+x/dice_roll.+x | $T/game | 42 | 2
EXPECT_OUT_IS | 1 3 | dice-seed42-counter2-is-1-3
RUN | $T/game/ops/+x/dice_roll.+x | $T/game | 42 | 3
EXPECT_OUT_IS | 6 6 | dice-seed42-counter3-is-6-6
EXPECT_HAS | game/variables.txt | \ndice_counter=4\n | dice-counter-advances-to-counter-plus-1
EXPECT_HAS | game/variables.txt | \nroll=12\n | roll-is-dice1-plus-dice2
RUN | $T/game/ops/+x/dice_roll.+x | $T/game | 42 | 0
CAPTURE | again
EXPECT_EQ | $again | 4 3 | same-seed-same-counter-same-dice-again
RUN | $T/game/ops/+x/dice_roll.+x | $T/game | 43 | 0
CAPTURE | other
EXPECT_NE | $other | 4 3 | different-seed-different-dice
EXPECT_HAS | game/dice_ledger.txt | DICE\p42\p0\p4\p3\n | dice-ledger-row-appended
EXPECT_HAS | game/dice_ledger.txt | DICE\p43\p0\p | dice-ledger-keeps-every-roll-append-only
RUN | $T/game/ops/+x/dice_roll.+x | $T/game | @dice_seed | @dice_counter
EXPECT_EXIT | 0 | dice-seed-and-counter-read-from-variables
RUN | $T/game/ops/+x/dice_roll.+x | $T/game | 42
EXPECT_EXIT | 2 | dice-usage-error-exit-2
RUN | $T/game/ops/+x/var_math.+x | $T/game | add | cash_2 | cash_2 | 50
EXPECT_OUT_IS | 150 | var_math-add-prints-the-value
EXPECT_HAS | game/variables.txt | \ncash_2=150\n | cash_2=150
RUN | $T/game/ops/+x/var_math.+x | $T/game | sub | cash_2 | cash_2 | 200
EXPECT_HAS | game/variables.txt | \ncash_2=-50\n | var_math-sub-goes-negative-without-clamping
RUN | $T/game/ops/+x/var_math.+x | $T/game | mul | m | 6 | 7
EXPECT_HAS | game/variables.txt | \nm=42\n | m=42
RUN | $T/game/ops/+x/var_math.+x | $T/game | mod | m1 | -3 | 40
EXPECT_HAS | game/variables.txt | \nm1=37\n | var_math-mod-is-never-negative
RUN | $T/game/ops/+x/var_math.+x | $T/game | mod | m2 | 47 | 40
EXPECT_HAS | game/variables.txt | \nm2=7\n | m2=7
RUN | $T/game/ops/+x/var_math.+x | $T/game | set | pos_{current} | 7
EXPECT_HAS | game/variables.txt | \npos_2=7\n | var_math-name-template-{current}-resolves-to-the-current-player
RUN | $T/game/ops/+x/var_math.+x | $T/game | ge | c1 | turn | 3
EXPECT_HAS | game/variables.txt | \nc1=1\n | var_math-ge-true
RUN | $T/game/ops/+x/var_math.+x | $T/game | gt | c2 | turn | 3
EXPECT_HAS | game/variables.txt | \nc2=0\n | var_math-gt-false
RUN | $T/game/ops/+x/var_math.+x | $T/game | lt | c3 | 2 | turn
EXPECT_HAS | game/variables.txt | \nc3=1\n | c3=1
RUN | $T/game/ops/+x/var_math.+x | $T/game | le | c4 | 3 | turn
EXPECT_HAS | game/variables.txt | \nc4=1\n | c4=1
RUN | $T/game/ops/+x/var_math.+x | $T/game | eq | c5 | turn | 3
EXPECT_HAS | game/variables.txt | \nc5=1\n | c5=1
RUN | $T/game/ops/+x/var_math.+x | $T/game | ne | c6 | turn | 3
EXPECT_HAS | game/variables.txt | \nc6=0\n | c6=0
RUN | $T/game/ops/+x/var_math.+x | $T/game | add | t | rules.pdl:go_pay | rules.pdl:jail_fee
EXPECT_HAS | game/variables.txt | \nt=250\n | var_math-reads-another-file-file:key
RUN | $T/game/ops/+x/var_math.+x | $T/game | set | switches.txt:game_over | 1
EXPECT_HAS | game/switches.txt | game_over=1\n | var_math-writes-a-switch-file-target
RUN | $T/game/ops/+x/var_math.+x | $T/game | mod | z | 5 | 0
EXPECT_EXIT | 1 | var_math-mod-by-zero-refused-exit-1
EXPECT_LACKS | game/variables.txt | \nz= | mod-by-zero-writes-nothing
RUN | $T/game/ops/+x/var_math.+x | $T/game | pow | z | 5 | 2
EXPECT_EXIT | 1 | var_math-unknown-op-refused
EXPECT_HAS | game/op_errors.txt | ERR\pvar_math\pbad op\p | errors-leave-an-ERR-row-because-a-pal-exec-hides-exit-codes
RUN | $T/game/ops/+x/var_math.+x | $T/game | add | z | 5
EXPECT_EXIT | 1 | var_math-missing-second-operand-refused
RUN | $T/game/ops/+x/var_math.+x | $T/game | set
EXPECT_EXIT | 2 | var_math-usage-exit-2
CLEAN | 
CASE | cash_transfer
SCRATCH | 
RUN | /usr/bin/cp | -r | $HOUSE/&.widgits/ring-board-rmmv/entity | $T/game
MKDIR | game/ops/+x
COPY | &.widgits/ring-board-rmmv/ops/+x/var_math.+x | game/ops/+x/var_math.+x
COPY | &.widgits/ring-board-rmmv/ops/+x/dice_roll.+x | game/ops/+x/dice_roll.+x
COPY | &.widgits/ring-board-rmmv/ops/+x/var_sweep.+x | game/ops/+x/var_sweep.+x
COPY | &.widgits/ring-board-rmmv/ops/+x/tile_lookup.+x | game/ops/+x/tile_lookup.+x
COPY | &.widgits/ring-board-rmmv/ops/+x/cash_transfer.+x | game/ops/+x/cash_transfer.+x
COPY | &.widgits/digipet/ops/+x/event_page_op.+x | game/ops/+x/event_page_op.+x
COPY | &.widgits/_shared-lib/harness/ops/+x/ring_audit_op.+x | game/ops/+x/ring_audit_op.+x
RUN | /usr/bin/gcc | -O2 | -w | -o | $T/prisc | $HOUSE/&.widgits/_shared-lib/system/prisc+x.c | -lm
ENV | EVENT_PAGE_PRISC | $T/prisc
WRITE | game/variables.txt | turn=3\ncash_1=100\ncash_2=50\ncash_bank=1000\n
RUN | $T/game/ops/+x/cash_transfer.+x | $T/game | 1 | 2 | 30 | pay
EXPECT_OUT_IS | ok | transfer-ok
EXPECT_EXIT | 0 | ok-exit-0
EXPECT_HAS | game/variables.txt | \ncash_1=70\n | cash_1=70
EXPECT_HAS | game/variables.txt | \ncash_2=80\n | cash_2=80
EXPECT_HAS | game/variables.txt | \nxfer_result=1\n | xfer_result=1
EXPECT_HAS | game/variables.txt | \nxfer_moved=30\n | xfer_moved=30
EXPECT_HAS | game/cash_ledger.txt | XFER\p3\p1\p2\p30\p30\pok\ppay\n | ledger-row-ok
RUN | $T/game/ops/+x/cash_transfer.+x | $T/game | 1 | 2 | 500 | rent
EXPECT_OUT_IS | bankrupt | overdraft-is-bankrupt
EXPECT_EXIT | 1 | bankrupt-exit-1
EXPECT_HAS | game/variables.txt | \ncash_1=0\n | bankrupt-payer-pays-all-it-has-balance-0
EXPECT_HAS | game/variables.txt | \ncash_2=150\n | creditor-gets-exactly-what-existed
EXPECT_HAS | game/variables.txt | \nxfer_result=2\n | xfer_result=2
EXPECT_HAS | game/variables.txt | \nxfer_moved=70\n | xfer_moved=70
EXPECT_HAS | game/cash_ledger.txt | XFER\p3\p1\p2\p500\p70\pbankrupt\prent\n | ledger-row-bankrupt
RUN | $T/game/ops/+x/cash_transfer.+x | $T/game | 2 | bank | 500 | buy | strict
EXPECT_OUT_IS | refused | strict-overdraft-is-refused-not-bankrupt
EXPECT_EXIT | 3 | refused-exit-3
EXPECT_HAS | game/variables.txt | \ncash_2=150\n | refused-moves-nothing
EXPECT_HAS | game/variables.txt | \nxfer_result=3\n | xfer_result=3
RUN | $T/game/ops/+x/cash_transfer.+x | $T/game | 2 | 2 | 5 | x
EXPECT_OUT_IS | refused | same-account-refused
RUN | $T/game/ops/+x/cash_transfer.+x | $T/game | 2 | bank | -5 | x
EXPECT_OUT_IS | refused | negative-amount-refused
RUN | $T/game/ops/+x/cash_transfer.+x | $T/game | bank | 2 | 5000 | x
EXPECT_OUT_IS | refused | bank-short-of-cash-refused-the-bank-cannot-go-bankrupt
EXPECT_HAS | game/variables.txt | \ncash_bank=1000\n | cash_bank=1000
RUN | $T/game/ops/+x/cash_transfer.+x | $T/game | mint | 2 | 5 | x
EXPECT_OUT_IS | refused | mint-without-reason-setup-refused
EXPECT_HAS | game/variables.txt | \ncash_2=150\n | no-money-created
RUN | $T/game/ops/+x/cash_transfer.+x | $T/game | 2 | mint | 5 | setup
EXPECT_OUT_IS | refused | nothing-pays-into-mint
RUN | $T/game/ops/+x/cash_transfer.+x | $T/game | mint | bank | 100 | setup
EXPECT_OUT_IS | ok | mint-with-reason-setup-is-the-only-way-to-create-money
EXPECT_HAS | game/variables.txt | \ncash_bank=1100\n | cash_bank=1100
RUN | $T/game/ops/+x/cash_transfer.+x | $T/game | bank | {current} | 10 | go
EXPECT_EXIT | 3 | template-account-resolving-to-0-is-the-bank-so-bank-to-bank-is-refused
RUN | $T/game/ops/+x/cash_transfer.+x | $T/game | 2 | bank | rules.pdl:jail_fee | jail
EXPECT_OUT_IS | ok | amount-read-from-rules.pdl
EXPECT_HAS | game/variables.txt | \ncash_2=100\n | cash_2=100
RUN | $T/game/ops/+x/cash_transfer.+x | $T/game | 1
EXPECT_EXIT | 2 | cash_transfer-usage-exit-2
CLEAN | 
