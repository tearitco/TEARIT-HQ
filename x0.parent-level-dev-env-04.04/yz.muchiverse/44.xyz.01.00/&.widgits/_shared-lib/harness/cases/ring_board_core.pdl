WRITE | game/variables.txt | players=2\ndice_seed=42\ndice_counter=0\nturn=3\ncurrent=1\nphase=0\njail_1=1\nalive_1=1\nalive_2=1\npos_1=10\ncash_1=1000\ncash_bank=97000\n
