CASE | save-restore
SCRATCH | 
RUN | /usr/bin/cp | -r | $HOUSE/&.widgits/ring-board-rmmv/entity | $T/game
MKDIR | game/ops/+x
COPY | &.widgits/ring-board-rmmv/ops/+x/var_math.+x | game/ops/+x/var_math.+x
COPY | &.widgits/ring-board-rmmv/ops/+x/dice_roll.+x | game/ops/+x/dice_roll.+x
COPY | &.widgits/ring-board-rmmv/ops/+x/var_sweep.+x | game/ops/+x/var_sweep.+x
COPY | &.widgits/ring-board-rmmv/ops/+x/tile_lookup.+x | game/ops/+x/tile_lookup.+x
COPY | &.widgits/ring-board-rmmv/ops/+x/cash_transfer.+x | game/ops/+x/cash_transfer.+x
COPY | &.widgits/digipet/ops/+x/event_page_op.+x | game/ops/+x/event_page_op.+x
COPY | &.widgits/_shared-lib/harness/ops/+x/ring_audit_op.+x | game/ops/+x/ring_audit_op.+x
RUN | /usr/bin/gcc | -O2 | -w | -o | $T/prisc | $HOUSE/&.widgits/_shared-lib/system/prisc+x.c | -lm
ENV | EVENT_PAGE_PRISC | $T/prisc
WRITE | game/rules.pdl | start_cash=300\nbank_start=100000\ngo_pay=40\njail_fee=50\njail_turns=1\njail_pos=10\nboard_size=40\ntax_income=150\ntax_luxury=100\nturn_cap=300\npolicy_reserve=0\npolicy_jail_reserve=300\n
WRITE | game/variables.txt | players=2\ndice_seed=8\n
RUN | $T/game/ops/+x/event_page_op.+x | $T/game | $T | --trigger | setup | --state | $T/game
EXPECT_EXIT | 0 | setup-ran
WRITE | loop.pal | li x2, 12\n_l1:\nbeq x2, x0, _d1\nexec game/ops/+x/event_page_op.+x game game --trigger autoturn --state game\nexec game/ops/+x/ring_audit_op.+x game\naddi x2, x2, -1\nj _l1\n_d1:\nhalt\n
RUN | $T/prisc | loop.pal
EXPECT_EXIT | 0 | game-loop-12-turns-ran
EXPECT_HAS | game/variables.txt | \nturn=12\n | at-turn-12
RUN | /usr/bin/sha256sum | game/variables.txt | game/switches.txt | game/cash_ledger.txt | game/dice_ledger.txt | game/audit_ledger.txt
CAPTURE | sig_at12
COPY | &.widgits/_shared-lib/ops/+x/game_snapshot_op.+x | gso
RUN | /usr/bin/grep | -h | ^dice_counter= | $T/game/variables.txt
CAPTURE | ctr_saved
RUN | $T/gso | $T/store | $T/game | save | CP12 | --now-ms | 1000
EXPECT_EXIT | 0 | save-at-turn-12
WRITE | loop.pal | li x2, 6\n_l1:\nbeq x2, x0, _d1\nexec game/ops/+x/event_page_op.+x game game --trigger autoturn --state game\nexec game/ops/+x/ring_audit_op.+x game\naddi x2, x2, -1\nj _l1\n_d1:\nhalt\n
RUN | $T/prisc | loop.pal
EXPECT_EXIT | 0 | game-loop-6-turns-ran
EXPECT_HAS | game/variables.txt | \nturn=18\n | played-on-to-turn-18
WRITE | game/variables.txt | players=2\ncash_1=999999\n
RUN | /usr/bin/sha256sum | game/variables.txt | game/switches.txt | game/cash_ledger.txt | game/dice_ledger.txt | game/audit_ledger.txt
CAPTURE | sig_mutated
EXPECT_NE | $sig_at12 | $sig_mutated | the-mutation-really-changed-the-game
RUN | $T/gso | $T/store | $T/game | restore | CP12 | $T/game | --apply | --prune | --now-ms | 2000
EXPECT_EXIT | 0 | restore-applied
RUN | /usr/bin/sha256sum | game/variables.txt | game/switches.txt | game/cash_ledger.txt | game/dice_ledger.txt | game/audit_ledger.txt
CAPTURE | sig_restored
EXPECT_EQ | $sig_at12 | $sig_restored | restore-brings-back-variables-owners-switches-dice-counter-and-all-ledgers-exactly
RUN | /usr/bin/grep | -h | ^dice_counter= | $T/game/variables.txt
CAPTURE | ctr_restored
EXPECT_EQ | $ctr_saved | $ctr_restored | dice-counter-restored-to-the-saved-position
WRITE | loop.pal | li x2, 48\n_l1:\nbeq x2, x0, _d1\nexec game/ops/+x/event_page_op.+x game game --trigger autoturn --state game\nexec game/ops/+x/ring_audit_op.+x game\naddi x2, x2, -1\nj _l1\n_d1:\nhalt\n
RUN | $T/prisc | loop.pal
EXPECT_EXIT | 0 | game-loop-48-turns-ran
RUN | /usr/bin/sha256sum | game/variables.txt | game/switches.txt | game/cash_ledger.txt | game/dice_ledger.txt | game/audit_ledger.txt
CAPTURE | sig_cont
EXPECT_EQ | $sig_cont | $sig_a | SAVE-RESTORE-CONTINUE-EQUALS-THE-UNINTERRUPTED-GAME-same-next-rolls-same-winner-same-ledgers
EXPECT_LACKS | game/audit_ledger.txt | FAIL | referee-clean-across-the-restore
EXPECT_HAS | game/switches.txt | game_over=1\n | switch-game_over=1
EXPECT_HAS | game/variables.txt | \nwinner=1\n | winner=1
CLEAN | 
CASE | player-path
SCRATCH | 
RUN | /usr/bin/cp | -r | $HOUSE/&.widgits/ring-board-rmmv/entity | $T/game
MKDIR | game/ops/+x
COPY | &.widgits/ring-board-rmmv/ops/+x/var_math.+x | game/ops/+x/var_math.+x
COPY | &.widgits/ring-board-rmmv/ops/+x/dice_roll.+x | game/ops/+x/dice_roll.+x
COPY | &.widgits/ring-board-rmmv/ops/+x/var_sweep.+x | game/ops/+x/var_sweep.+x
COPY | &.widgits/ring-board-rmmv/ops/+x/tile_lookup.+x | game/ops/+x/tile_lookup.+x
COPY | &.widgits/ring-board-rmmv/ops/+x/cash_transfer.+x | game/ops/+x/cash_transfer.+x
COPY | &.widgits/digipet/ops/+x/event_page_op.+x | game/ops/+x/event_page_op.+x
COPY | &.widgits/_shared-lib/harness/ops/+x/ring_audit_op.+x | game/ops/+x/ring_audit_op.+x
RUN | /usr/bin/gcc | -O2 | -w | -o | $T/prisc | $HOUSE/&.widgits/_shared-lib/system/prisc+x.c | -lm
ENV | EVENT_PAGE_PRISC | $T/prisc
WRITE | game/variables.txt | players=2\ndice_seed=42\n
MKDIR | &.widgits/digipet/ops/+x
COPY | &.widgits/digipet/ops/+x/event_page_op.+x | &.widgits/digipet/ops/+x/event_page_op.+x
RUN | /usr/bin/grep | -F | -c | -e | METHOD       \p New Game             \p sh -c | $HOUSE/&.widgits/ring-board-rmmv/entity/meta.pdl
EXPECT_OUT_IS | 1 | menu-row-setup-exists-in-meta.pdl
