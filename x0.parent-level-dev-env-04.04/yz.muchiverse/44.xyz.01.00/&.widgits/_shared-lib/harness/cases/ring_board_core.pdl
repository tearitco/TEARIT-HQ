EXPECT_OUT_IS | 1 | menu-row-setup-fires-trigger-setup
RUN | /usr/bin/grep | -F | -c | -e | METHOD       \p Roll                 \p sh -c | $HOUSE/&.widgits/ring-board-rmmv/entity/meta.pdl
EXPECT_OUT_IS | 1 | menu-row-roll-exists-in-meta.pdl
RUN | /usr/bin/grep | -F | -c | -e | --trigger roll' | $HOUSE/&.widgits/ring-board-rmmv/entity/meta.pdl
EXPECT_OUT_IS | 1 | menu-row-roll-fires-trigger-roll
RUN | /usr/bin/grep | -F | -c | -e | METHOD       \p Buy                  \p sh -c | $HOUSE/&.widgits/ring-board-rmmv/entity/meta.pdl
EXPECT_OUT_IS | 1 | menu-row-buy-exists-in-meta.pdl
RUN | /usr/bin/grep | -F | -c | -e | --trigger buy' | $HOUSE/&.widgits/ring-board-rmmv/entity/meta.pdl
EXPECT_OUT_IS | 1 | menu-row-buy-fires-trigger-buy
