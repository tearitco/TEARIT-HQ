EXPECT_HAS | game/variables.txt | \nalive_2=1\n | alive_2=1
EXPECT_HAS | game/variables.txt | \ncash_1=1500\n | cash_1=1500
RUN | /bin/sh | -c | exec "$1/&.widgits/digipet/ops/+x/event_page_op.+x" "$0" "$1" --trigger roll | $T/game | $T
