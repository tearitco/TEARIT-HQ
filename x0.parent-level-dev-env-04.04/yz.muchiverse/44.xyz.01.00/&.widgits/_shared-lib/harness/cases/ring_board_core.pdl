RUN | /usr/bin/cp | -r | $HOUSE/&.widgits/ring-board-rmmv/common_events/end_turn | $T/common_events/end_turn
WRITE | common_events/end_turn/event_pkg/target.pdl | TARGET | state | game
WRITE | game/variables.txt | players=2\ndice_seed=42\nturn=5\ncurrent=1\nphase=2\nalive_1=1\nalive_2=1\n
ENV | LC_CLOCK_NO_POPUP | 1
ENV | LC_CLOCK_EVENT_RUNNER | $T/&.widgits/digipet/ops/+x/event_page_op.+x
ENV | EVENT_PAGE_TRIGGER | endturn
RUN | $T/lc.+x | $T | new | g1
RUN | $T/lc.+x | $T | reminder-add | g1 | 86400000 | common:end_turn |  | every:1day
EXPECT_EXIT | 0 | end-turn-schedule-row-installed
RUN | $T/lc.+x | $T | endturn | g1 | 86400000
RUN | $T/lc.+x | $T | step | 0
EXPECT_HAS | game/variables.txt | \ncurrent=2\n | clock-End-Turn-after-the-player-finished-hands-the-turn-over
EXPECT_HAS | game/variables.txt | \nturn=6\n | turn=6
EXPECT_HAS | game/variables.txt | \nphase=0\n | phase=0
RUN | $T/lc.+x | $T | endturn | g1 | 86400000
RUN | $T/lc.+x | $T | step | 0
EXPECT_HAS | game/variables.txt | \ncurrent=2\n | clock-End-Turn-before-the-player-acted-is-refused-by-the-pages
EXPECT_HAS | game/variables.txt | \nturn=6\n | turn=6
EXPECT_HAS | #.desktop/clocks/schedule_ledger.txt | ok | both-clock-firings-are-in-the-schedule-ledger
