CASE | game-2p-seed8
SCRATCH | 
RUN | /usr/bin/cp | -r | $HOUSE/&.widgits/ring-board-rmmv/entity | $T/game
MKDIR | game/ops/+x
COPY | &.widgits/ring-board-rmmv/ops/+x/var_math.+x | game/ops/+x/var_math.+x
COPY | &.widgits/ring-board-rmmv/ops/+x/dice_roll.+x | game/ops/+x/dice_roll.+x
COPY | &.widgits/ring-board-rmmv/ops/+x/var_sweep.+x | game/ops/+x/var_sweep.+x
COPY | &.widgits/ring-board-rmmv/ops/+x/tile_lookup.+x | game/ops/+x/tile_lookup.+x
COPY | &.widgits/ring-board-rmmv/ops/+x/cash_transfer.+x | game/ops/+x/cash_transfer.+x
COPY | &.widgits/digipet/ops/+x/event_page_op.+x | game/ops/+x/event_page_op.+x
COPY | &.widgits/_shared-lib/harness/ops/+x/ring_audit_op.+x | game/ops/+x/ring_audit_op.+x
RUN | /usr/bin/gcc | -O2 | -w | -o | $T/prisc | $HOUSE/&.widgits/_shared-lib/system/prisc+x.c | -lm
ENV | EVENT_PAGE_PRISC | $T/prisc
WRITE | game/rules.pdl | start_cash=300\nbank_start=100000\ngo_pay=40\njail_fee=50\njail_turns=1\njail_pos=10\nboard_size=40\ntax_income=150\ntax_luxury=100\nturn_cap=300\npolicy_reserve=0\npolicy_jail_reserve=300\n
WRITE | game/variables.txt | players=2\ndice_seed=8\n
RUN | $T/game/ops/+x/event_page_op.+x | $T/game | $T | --trigger | setup | --state | $T/game
EXPECT_EXIT | 0 | setup-ran
WRITE | loop.pal | li x2, 60\n_l1:\nbeq x2, x0, _d1\nexec game/ops/+x/event_page_op.+x game game --trigger autoturn --state game\nexec game/ops/+x/ring_audit_op.+x game\naddi x2, x2, -1\nj _l1\n_d1:\nhalt\n
RUN | $T/prisc | loop.pal
EXPECT_EXIT | 0 | game-loop-60-turns-ran
RUN | /usr/bin/sha256sum | game/variables.txt | game/switches.txt | game/cash_ledger.txt | game/dice_ledger.txt | game/audit_ledger.txt
CAPTURE | sig_a
EXPECT_LACKS | game/audit_ledger.txt | FAIL | referee-never-failed-a-turn
EXPECT_HAS | game/audit_ledger.txt | \pok\p | referee-passed-turns
EXPECT_NOFILE | game/op_errors.txt | no-op-reported-an-error
EXPECT_HAS | game/switches.txt | game_over=1\n | game-reached-game-over
EXPECT_HAS | game/variables.txt | \ngame_over_reason=1\n | game-over-by-last-player-standing
EXPECT_HAS | game/cash_ledger.txt | \pbankrupt\p | a-bankruptcy-happened
EXPECT_HAS | game/cash_ledger.txt | \pok\pgo\n | GO-was-paid
EXPECT_HAS | game/cash_ledger.txt | \pok\pbuy\n | properties-were-bought
EXPECT_HAS | game/variables.txt | \nwinner=1\n | seed-8-winner-is-player-1
EXPECT_HAS | game/variables.txt | \nturn=26\n | seed-8-ends-on-turn-26
CLEAN | 
