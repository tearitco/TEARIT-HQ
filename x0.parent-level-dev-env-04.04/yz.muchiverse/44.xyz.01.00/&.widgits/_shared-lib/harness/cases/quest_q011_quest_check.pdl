# quest q011 quest_check: LOCKED cases (the worker may not edit this file). Binary under test: &.widgits/quest-pilot/ops/+x/quest_check.+x (built by ops/build_quest_check.sh)
# Every scenario builds a scratch git repo under $T: repo r/ (main) holds the packet q/ and src/; w/ is a worktree on branch work. quest_check q=r/q w=w ref=main.
RESULTS | ../results/quest_q011_quest_check.txt
CASE | q011-quest-check
# ---- scenario: valid
SCRATCH |
COPY | &.widgits/quest-pilot/ops/+x/quest_check.+x | qc.+x
WRITE | r/q/harness/h1.txt | H1\n
WRITE | r/q/harness/sub/h2.txt | H2\n
WRITE | r/q/LOCK.sha256 | 63f9e4fbad57e95a92472f992662742e21b25e91a648d7353117427babab2c0d  h1.txt\n7fef2fea3c018a53a5c94d89cf269d390d812a7d9f874886e60455623d76618f  sub/h2.txt\n
WRITE | r/q/scope.txt | # allowed paths\nsrc/\nREADME.md\nlib/prefix*\n
WRITE | r/q/budget.pdl | BUDGET | max_attempts | 3\nBUDGET | max_seconds | 600\nBUDGET | max_quota_units | 50\nBUDGET | escalate_to | manager\n
WRITE | r/src/a.c | int a;\n
WRITE | r/other/o.c | int o;\n
RUN | git | init | -q | -b | main | $T/r
EXPECT_EXIT | 0 | init
RUN | git | -C | $T/r | add | -A
EXPECT_EXIT | 0 | add
RUN | git | -C | $T/r | -c | user.name=t | -c | user.email=t@t | commit | -q | -m | base
EXPECT_EXIT | 0 | commit
RUN | git | -C | $T/r | worktree | add | -q | -b | work | $T/w | main
EXPECT_EXIT | 0 | worktree
WRITE | w/src/a.c | int a2;\n
WRITE | w/src/new/b.c | int b;\n
WRITE | w/README.md | hi\n
WRITE | w/lib/prefix_x.c | int p;\n
MKDIR | r/q/attempts/001
MKDIR | r/q/attempts/002
RUN | $T/qc.+x | $T/r/q | $T/w | main
EXPECT_EXIT | 0 | valid-exit
EXPECT_OUT | QCHECK\pVERDICT\pPASS\pchecks=5\pfailed=0 | valid-out-QCHECK_VERDICT_PASS_chec
EXPECT_OUT | QCHECK\pPASS\pLOCK\p | valid-out-QCHECK_PASS_LOCK_
EXPECT_OUT | QCHECK\pPASS\pSCOPE\p4 changed | valid-out-QCHECK_PASS_SCOPE_4_chan
EXPECT_OUT | QCHECK\pPASS\pBASE\p | valid-out-QCHECK_PASS_BASE_
EXPECT_OUT | QCHECK\pPASS\pBUDGET\p | valid-out-QCHECK_PASS_BUDGET_
EXPECT_OUT | QCHECK\pPASS\pATTEMPTS\p2 attempt | valid-out-QCHECK_PASS_ATTEMPTS_2_a
EXPECT_OUT_LACKS | QCHECK\pFAIL | valid-no-QCHECK_FAIL
CLEAN |
