EXPECT_HAS | ex/terrain_legend.txt | b\p-0.2\p50\p100\p190\p-\pwater\p | terrain-b
EXPECT_HAS | ex/terrain_legend.txt | c\p0.4\p215\p195\p130\p-\psand\p | terrain-c
EXPECT_HAS | ex/terrain_legend.txt | d\p0.6\p90\p160\p70\p-\pgrass\p | terrain-d
