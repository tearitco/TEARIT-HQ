# dust_gen: LOCKED cases for rpg-dust R2: two real levels and the zoom between them. Source under test: @.apps/rpg-dust/ops/dust_gen.c + dust_hash.c + dust_pdl.c. The rules: same inputs = same bytes; a parameter moves its level and below, not above; a zoom invents and loses nothing (area heights sum to exactly N*N*the region cell's height, all within 0..99), also at the extremes 0 and 99; a tampered area page is refused.
RESULTS | ../results/dust_gen.txt
CASE | dust-gen
SCRATCH |
COPY | @.apps/rpg-dust/ops/dust_gen.c | dust_gen.c
COPY | @.apps/rpg-dust/ops/dust_hash.c | dust_hash.c
COPY | @.apps/rpg-dust/ops/dust_pdl.c | dust_pdl.c
COPY | @.apps/rpg-dust/ops/dust_addr.c | dust_addr.c
COPY | @.apps/rpg-dust/scale.pdl | scale.pdl
RUN | gcc | -std=gnu11 | -Wall | -Wextra | -Werror | -O2 | -I | $T | -o | $T/dg.+x | $T/dust_gen.c
EXPECT_EXIT | 0 | compiles-clean
RUN | $T/dg.+x | region | $T/scale.pdl | globe:3,4/region:0,1 | $T/r1.txt
EXPECT_EXIT | 0 | region-real
RUN | $T/dg.+x | region | $T/scale.pdl | globe:3,4/region:0,1 | $T/r2.txt
EXPECT_EXIT | 0 | region-again
RUN | cmp | $T/r1.txt | $T/r2.txt
EXPECT_EXIT | 0 | region-same-bytes
RUN | $T/dg.+x | region | $T/scale.pdl | globe:3,4/region:0,2 | $T/r3.txt
EXPECT_EXIT | 0 | region-other-addr
RUN | tail | -n | +2 | $T/r1.txt
CAPTURE | ra1
RUN | tail | -n | +2 | $T/r3.txt
CAPTURE | rb1
EXPECT_NE | $ra1 | $rb1 | region-addr-changes-page-heights
EXPECT_HAS | r1.txt | 21 20 09 05 08 23 45 62 75 59 50 37 33 34 32 36 | region-first-row-pinned
EXPECT_HAS | r1.txt | PAGE \p region \p globe:3,4/region:0,1 \p 11499903969309001043 \p 16 | region-header-seed-pinned
WRITE | pg7.pdl | SECTION \p KEY \p VALUE\nSEED \p universe \p 99\nPARAM \p ocean \p 0.7 \p globe\nSCALE \p system \p 36 \p s \p - \p dust_gen_s \p 2d-tiles \p day \p n\nSCALE \p globe \p 20 \p g \p system \p dust_gen_g \p 2d-tiles \p day \p n\nSCALE \p region \p 14 \p r \p globe \p dust_gen_r \p 2d-tiles \p day \p n\nSCALE \p area \p 8 \p a \p region \p dust_gen_a \p 3d-voxel \p 10min \p n\n
WRITE | pg8.pdl | SECTION \p KEY \p VALUE\nSEED \p universe \p 99\nPARAM \p ocean \p 0.8 \p globe\nSCALE \p system \p 36 \p s \p - \p dust_gen_s \p 2d-tiles \p day \p n\nSCALE \p globe \p 20 \p g \p system \p dust_gen_g \p 2d-tiles \p day \p n\nSCALE \p region \p 14 \p r \p globe \p dust_gen_r \p 2d-tiles \p day \p n\nSCALE \p area \p 8 \p a \p region \p dust_gen_a \p 3d-voxel \p 10min \p n\n
WRITE | pa1.pdl | SECTION \p KEY \p VALUE\nSEED \p universe \p 99\nPARAM \p ocean \p 0.7 \p globe\nPARAM \p rough \p 1 \p area\nSCALE \p system \p 36 \p s \p - \p dust_gen_s \p 2d-tiles \p day \p n\nSCALE \p globe \p 20 \p g \p system \p dust_gen_g \p 2d-tiles \p day \p n\nSCALE \p region \p 14 \p r \p globe \p dust_gen_r \p 2d-tiles \p day \p n\nSCALE \p area \p 8 \p a \p region \p dust_gen_a \p 3d-voxel \p 10min \p n\n
WRITE | pa2.pdl | SECTION \p KEY \p VALUE\nSEED \p universe \p 99\nPARAM \p ocean \p 0.7 \p globe\nPARAM \p rough \p 2 \p area\nSCALE \p system \p 36 \p s \p - \p dust_gen_s \p 2d-tiles \p day \p n\nSCALE \p globe \p 20 \p g \p system \p dust_gen_g \p 2d-tiles \p day \p n\nSCALE \p region \p 14 \p r \p globe \p dust_gen_r \p 2d-tiles \p day \p n\nSCALE \p area \p 8 \p a \p region \p dust_gen_a \p 3d-voxel \p 10min \p n\n
RUN | $T/dg.+x | region | $T/pg7.pdl | globe:3,4/region:0,1 | $T/g7r.txt
EXPECT_EXIT | 0 | g7-region
RUN | $T/dg.+x | region | $T/pg8.pdl | globe:3,4/region:0,1 | $T/g8r.txt
EXPECT_EXIT | 0 | g8-region
RUN | tail | -n | +2 | $T/g7r.txt
CAPTURE | ra2
RUN | tail | -n | +2 | $T/g8r.txt
CAPTURE | rb2
EXPECT_NE | $ra2 | $rb2 | globe-param-moves-region-heights
RUN | $T/dg.+x | region | $T/pa1.pdl | globe:3,4/region:0,1 | $T/a1r.txt
EXPECT_EXIT | 0 | a1-region
RUN | $T/dg.+x | region | $T/pa2.pdl | globe:3,4/region:0,1 | $T/a2r.txt
EXPECT_EXIT | 0 | a2-region
RUN | cmp | $T/a1r.txt | $T/a2r.txt
EXPECT_EXIT | 0 | area-param-leaves-region-alone
RUN | $T/dg.+x | area | $T/pa1.pdl | $T/a1r.txt | 7 | 9 | globe:3,4/region:0,1 | $T/a1a.txt
EXPECT_EXIT | 0 | a1-area
RUN | $T/dg.+x | area | $T/pa2.pdl | $T/a1r.txt | 7 | 9 | globe:3,4/region:0,1 | $T/a2a.txt
EXPECT_EXIT | 0 | a2-area
RUN | tail | -n | +2 | $T/a1a.txt
CAPTURE | ra3
RUN | tail | -n | +2 | $T/a2a.txt
CAPTURE | rb3
EXPECT_NE | $ra3 | $rb3 | area-param-moves-area-heights
RUN | $T/dg.+x | area | $T/pa1.pdl | $T/a1r.txt | 7 | 9 | globe:3,4/region:0,1 | $T/a1b.txt
EXPECT_EXIT | 0 | a1-area-again
RUN | cmp | $T/a1a.txt | $T/a1b.txt
EXPECT_EXIT | 0 | area-same-bytes
RUN | $T/dg.+x | area | $T/pa1.pdl | $T/a1r.txt | 7 | 10 | globe:3,4/region:0,1 | $T/a1c.txt
EXPECT_EXIT | 0 | area-other-cell
RUN | tail | -n | +2 | $T/a1a.txt
CAPTURE | ra4
RUN | tail | -n | +2 | $T/a1c.txt
CAPTURE | rb4
EXPECT_NE | $ra4 | $rb4 | area-cell-changes-page-heights
RUN | $T/dg.+x | area | $T/scale.pdl | $T/r1.txt | 0 | 0 | globe:3,4/region:0,1 | $T/ar.txt
EXPECT_EXIT | 0 | real-cell-0-0
RUN | $T/dg.+x | conserve | $T/r1.txt | 0 | 0 | $T/ar.txt
EXPECT_EXIT | 0 | conserve-real-0-0
RUN | $T/dg.+x | area | $T/scale.pdl | $T/r1.txt | 7 | 9 | globe:3,4/region:0,1 | $T/ar.txt
EXPECT_EXIT | 0 | real-cell-7-9
RUN | $T/dg.+x | conserve | $T/r1.txt | 7 | 9 | $T/ar.txt
EXPECT_EXIT | 0 | conserve-real-7-9
RUN | $T/dg.+x | area | $T/scale.pdl | $T/r1.txt | 15 | 15 | globe:3,4/region:0,1 | $T/ar.txt
EXPECT_EXIT | 0 | real-cell-15-15
RUN | $T/dg.+x | conserve | $T/r1.txt | 15 | 15 | $T/ar.txt
EXPECT_EXIT | 0 | conserve-real-15-15
RUN | $T/dg.+x | area | $T/scale.pdl | $T/r1.txt | 3 | 3 | globe:3,4/region:0,1 | $T/ar.txt
EXPECT_EXIT | 0 | real-cell-3-3
RUN | $T/dg.+x | conserve | $T/r1.txt | 3 | 3 | $T/ar.txt
EXPECT_EXIT | 0 | conserve-real-3-3
WRITE | reg.txt | PAGE \p region \p fixture \p 1 \p 16\n00 99 01 98 50 50 50 50 50 50 50 50 50 50 50 50\n50 50 50 50 50 50 50 50 50 50 50 50 50 50 50 50\n50 50 50 50 50 50 50 50 50 50 50 50 50 50 50 50\n50 50 50 50 50 50 50 50 50 50 50 50 50 50 50 50\n50 50 50 50 50 50 50 50 50 50 50 50 50 50 50 50\n50 50 50 50 50 50 50 50 50 50 50 50 50 50 50 50\n50 50 50 50 50 50 50 50 50 50 50 50 50 50 50 50\n50 50 50 50 50 50 50 50 50 50 50 50 50 50 50 50\n50 50 50 50 50 50 50 50 50 50 50 50 50 50 50 50\n50 50 50 50 50 50 50 50 50 50 50 50 50 50 50 50\n50 50 50 50 50 50 50 50 50 50 50 50 50 50 50 50\n50 50 50 50 50 50 50 50 50 50 50 50 50 50 50 50\n50 50 50 50 50 50 50 50 50 50 50 50 50 50 50 50\n50 50 50 50 50 50 50 50 50 50 50 50 50 50 50 50\n50 50 50 50 50 50 50 50 50 50 50 50 50 50 50 50\n50 50 50 50 50 50 50 50 50 50 50 50 50 50 50 50\n
RUN | $T/dg.+x | area | $T/scale.pdl | $T/reg.txt | 0 | 0 | globe:3,4/region:0,1 | $T/e0.txt
EXPECT_EXIT | 0 | ext-gen-0
RUN | $T/dg.+x | conserve | $T/reg.txt | 0 | 0 | $T/e0.txt
EXPECT_EXIT | 0 | ext-conserve-0
EXPECT_OUT | OK cell 0,0: region height 0, area sum 0 | ext-says-0
RUN | $T/dg.+x | area | $T/scale.pdl | $T/reg.txt | 1 | 0 | globe:3,4/region:0,1 | $T/e1.txt
EXPECT_EXIT | 0 | ext-gen-1
RUN | $T/dg.+x | conserve | $T/reg.txt | 1 | 0 | $T/e1.txt
EXPECT_EXIT | 0 | ext-conserve-1
EXPECT_OUT | OK cell 1,0: region height 99, area sum 25344 | ext-says-1
RUN | $T/dg.+x | area | $T/scale.pdl | $T/reg.txt | 2 | 0 | globe:3,4/region:0,1 | $T/e2.txt
EXPECT_EXIT | 0 | ext-gen-2
RUN | $T/dg.+x | conserve | $T/reg.txt | 2 | 0 | $T/e2.txt
EXPECT_EXIT | 0 | ext-conserve-2
EXPECT_OUT | OK cell 2,0: region height 1, area sum 256 | ext-says-2
RUN | $T/dg.+x | area | $T/scale.pdl | $T/reg.txt | 3 | 0 | globe:3,4/region:0,1 | $T/e3.txt
EXPECT_EXIT | 0 | ext-gen-3
RUN | $T/dg.+x | conserve | $T/reg.txt | 3 | 0 | $T/e3.txt
EXPECT_EXIT | 0 | ext-conserve-3
EXPECT_OUT | OK cell 3,0: region height 98, area sum 25088 | ext-says-3
EXPECT_HAS | e0.txt | 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 | zero-parent-is-flat
EXPECT_HAS | e1.txt | 99 99 99 99 99 99 99 99 99 99 99 99 99 99 99 99 | max-parent-is-flat
WRITE | tamper.txt | PAGE \p area \p globe:3,4/region:0,1/cell:7,9 \p 18100347251104407166 \p 16\n59 54 53 45 49 52 59 45 47 53 44 51 49 57 46 54\n48 44 47 57 48 42 48 56 58 58 45 50 55 48 50 55\n51 55 50 51 54 52 57 54 45 57 49 53 42 44 50 47\n53 44 52 57 58 45 42 56 51 56 51 48 55 55 55 56\n47 58 47 44 50 51 51 51 58 46 49 44 53 46 42 54\n54 55 56 49 48 48 53 42 57 54 42 52 57 43 56 49\n52 52 44 58 56 49 54 55 50 54 49 53 53 50 58 47\n48 52 42 44 46 56 48 52 58 47 48 51 58 51 51 49\n46 42 47 50 57 54 52 46 43 49 58 47 44 47 49 57\n44 49 44 57 42 52 58 47 42 53 47 48 43 55 49 44\n43 45 48 56 43 52 44 53 49 57 44 53 57 42 45 46\n54 44 54 45 52 47 47 52 58 43 48 42 57 48 49 45\n45 50 49 45 42 42 50 44 53 49 52 53 43 42 48 44\n51 57 43 54 56 44 51 48 56 48 55 42 52 42 58 50\n54 47 52 52 51 58 44 50 52 55 52 51 54 53 45 56\n42 56 42 58 49 48 46 44 51 47 52 42 57 52 50 45\n
WRITE | short.txt | PAGE \p area \p globe:3,4/region:0,1/cell:7,9 \p 18100347251104407166 \p 16\n58 54 53 45 49 52 59 45 47 53 44 51 49 57 46 54\n48 44 47 57 48 42 48 56 58 58 45 50 55 48 50\n51 55 50 51 54 52 57 54 45 57 49 53 42 44 50 47\n53 44 52 57 58 45 42 56 51 56 51 48 55 55 55 56\n47 58 47 44 50 51 51 51 58 46 49 44 53 46 42 54\n54 55 56 49 48 48 53 42 57 54 42 52 57 43 56 49\n52 52 44 58 56 49 54 55 50 54 49 53 53 50 58 47\n48 52 42 44 46 56 48 52 58 47 48 51 58 51 51 49\n46 42 47 50 57 54 52 46 43 49 58 47 44 47 49 57\n44 49 44 57 42 52 58 47 42 53 47 48 43 55 49 44\n43 45 48 56 43 52 44 53 49 57 44 53 57 42 45 46\n54 44 54 45 52 47 47 52 58 43 48 42 57 48 49 45\n45 50 49 45 42 42 50 44 53 49 52 53 43 42 48 44\n51 57 43 54 56 44 51 48 56 48 55 42 52 42 58 50\n54 47 52 52 51 58 44 50 52 55 52 51 54 53 45 56\n42 56 42 58 49 48 46 44 51 47 52 42 57 52 50 45\n
WRITE | mid.txt | PAGE \p area \p globe:3,4/region:0,1/cell:7,9 \p 18100347251104407166 \p 16\n58 54 53 45 49 52 59 45 47 53 44 51 49 57 46 54\n48 44 47 57 48 42 48 56 58 58 45 50 55 48 50 55\n51 55 50 51 54 52 57 54 45 57 49 53 42 44 50 47\n53 44 52 57 58 45 42 56 51 56 51 48 55 55 55 56\n47 58 47 44 50 51 51 51 58 46 49 44 53 46 42 54\n54 55 56 49 48 48 53 42 57 54 42 52 57 43 56 49\n52 52 44 58 56 49 54 55 50 54 49 53 53 50 58 47\n48 52 42 44 46 56 48 52 58 47 48 51 58 51 51 49\n46 42 47 50 57 54 52 46 43 49 58 47 44 47 49 57\n44 49 44 57 42 52 58 47 42 53 47 48 43 55 49 44\n43 45 48 56 43 52 44 53 49 57 44 53 57 42 45 46\n54 44 54 45 52 47 47 52 58 43 48 42 57 48 49 45\n45 50 49 45 42 42 50 44 53 49 52 53 43 42 48 44\n51 57 43 54 56 44 51 48 56 48 55 42 52 42 58 50\n54 47 52 52 51 58 44 50 52 55 52 51 54 53 45 56\n42 56 42 58 49 48 46 44 51 47 52 42 57 52 50 45\n
RUN | $T/dg.+x | conserve | $T/reg.txt | 7 | 9 | $T/mid.txt
EXPECT_EXIT | 0 | conserve-ok-on-untampered
RUN | $T/dg.+x | conserve | $T/reg.txt | 7 | 9 | $T/tamper.txt
EXPECT_EXIT | 1 | conserve-refuses-tampered
EXPECT_OUT | MISMATCH cell 7,9 | tamper-says
RUN | $T/dg.+x | conserve | $T/reg.txt | 1 | 0 | $T/mid.txt
EXPECT_EXIT | 1 | conserve-refuses-wrong-cell
RUN | $T/dg.+x | conserve | $T/reg.txt | 7 | 9 | $T/short.txt
EXPECT_EXIT | 2 | conserve-unreadable-truncated
RUN | $T/dg.+x | conserve | $T/reg.txt | 7 | 9 | $T/nosuch.txt
EXPECT_EXIT | 2 | conserve-missing-file
RUN | $T/dg.+x | area | $T/scale.pdl | $T/r1.txt | 16 | 0 | globe:3,4/region:0,1 | $T/z.txt
EXPECT_EXIT | 2 | area-cell-16
RUN | $T/dg.+x | area | $T/scale.pdl | $T/r1.txt | -1 | 0 | globe:3,4/region:0,1 | $T/z.txt
EXPECT_EXIT | 2 | area-cell-negative
RUN | $T/dg.+x | area | $T/scale.pdl | $T/nosuch.txt | 0 | 0 | globe:3,4/region:0,1 | $T/z.txt
EXPECT_EXIT | 2 | area-missing-region-page
WRITE | nolevel.pdl | SECTION \p KEY \p VALUE\nSEED \p universe \p 1\nSCALE \p only \p 3 \p o \p - \p dust_gen_o \p 2d-tiles \p day \p n\n
RUN | $T/dg.+x | region | $T/nolevel.pdl | globe:3,4/region:0,1 | $T/z.txt
EXPECT_EXIT | 2 | no-region-level
RUN | $T/dg.+x | bogus
EXPECT_EXIT | 2 | unknown-mode
RUN | $T/dg.+x
EXPECT_EXIT | 2 | no-args
# two cells with the SAME parent height (reg.txt cells 5,0 and 6,0 are both 50): their area pages must still differ, because the cell is part of the seed address
RUN | $T/dg.+x | area | $T/scale.pdl | $T/reg.txt | 5 | 0 | globe:3,4/region:0,1 | $T/s5.txt
EXPECT_EXIT | 0 | same-parent-cell-5
RUN | $T/dg.+x | area | $T/scale.pdl | $T/reg.txt | 6 | 0 | globe:3,4/region:0,1 | $T/s6.txt
EXPECT_EXIT | 0 | same-parent-cell-6
RUN | tail | -n | +2 | $T/s5.txt
CAPTURE | rows5
RUN | tail | -n | +2 | $T/s6.txt
CAPTURE | rows6
EXPECT_NE | $rows5 | $rows6 | same-parent-other-cell-heights-differ
RUN | $T/dg.+x | conserve | $T/reg.txt | 5 | 0 | $T/s5.txt
EXPECT_OUT | OK cell 5,0: region height 50, area sum 12800 | same-parent-5-conserves
# the real zoom of region cell 7,9, rows 1, 2 and 16 pinned from the first run (a byte anchor, and it fails if the area noise stops depending on x or y)
RUN | $T/dg.+x | area | $T/scale.pdl | $T/r1.txt | 7 | 9 | globe:3,4/region:0,1 | $T/pin.txt
EXPECT_EXIT | 0 | pin-area-gen
EXPECT_HAS | pin.txt | 91 77 78 90 77 87 87 91 89 87 77 88 90 83 88 85 | pin-area-row1
EXPECT_HAS | pin.txt | 92 91 92 83 84 86 92 93 85 87 80 82 83 93 80 87 | pin-area-row2
EXPECT_HAS | pin.txt | 87 92 85 89 83 94 90 90 86 82 79 86 87 79 93 91 | pin-area-row16
# ---- R2b: addresses. zoom_in / zoom_out are inverse on the address; page makes the page at an address from the address alone ----
RUN | $T/dg.+x | zoom_in | globe:3,4/region:0,1 | 7 | 9
EXPECT_EXIT | 0 | zoom-in-exit
EXPECT_OUT_IS | globe:3,4/region:0,1/cell:7,9 | zoom-in-address
CAPTURE | zin
RUN | $T/dg.+x | zoom_out | $zin
EXPECT_EXIT | 0 | zoom-out-exit
EXPECT_OUT_IS | globe:3,4/region:0,1 7 9 | zoom-out-returns-parent-and-cell
RUN | $T/dg.+x | zoom_in | a/b | 0 | 15
EXPECT_OUT_IS | a/b/cell:0,15 | zoom-in-corner
RUN | $T/dg.+x | zoom_out | a/b/cell:0,15
EXPECT_OUT_IS | a/b 0 15 | zoom-out-corner
RUN | $T/dg.+x | zoom_in | globe:3,4/region:0,1 | 16 | 0
EXPECT_EXIT | 2 | zoom-in-cell-16
RUN | $T/dg.+x | zoom_in | globe:3,4/region:0,1 | 0 | -1
EXPECT_EXIT | 2 | zoom-in-cell-negative
RUN | $T/dg.+x | zoom_in | globe:3,4/region:0,1/cell:7,9 | 1 | 1
EXPECT_EXIT | 2 | zoom-in-on-an-area-address-refused
RUN | $T/dg.+x | zoom_out | globe:3,4/region:0,1
EXPECT_EXIT | 2 | zoom-out-of-a-region-refused
RUN | $T/dg.+x | zoom_out | globe:3,4/region:0,1/cell:7
EXPECT_EXIT | 2 | zoom-out-malformed-cell
RUN | $T/dg.+x | zoom_out | globe:3,4/region:0,1/cell:7,9x
EXPECT_EXIT | 2 | zoom-out-trailing-junk
RUN | $T/dg.+x | zoom_out | cell:3,3
EXPECT_EXIT | 2 | zoom-out-no-parent
RUN | $T/dg.+x | page | $T/scale.pdl | globe:3,4/region:0,1 | $T/pr.txt
EXPECT_EXIT | 0 | page-region
RUN | cmp | $T/pr.txt | $T/r1.txt
EXPECT_EXIT | 0 | page-region-equals-region-mode
RUN | $T/dg.+x | page | $T/scale.pdl | globe:3,4/region:0,1/cell:7,9 | $T/pa.txt
EXPECT_EXIT | 0 | page-area
RUN | cmp | $T/pa.txt | $T/pin.txt
EXPECT_EXIT | 0 | page-area-equals-region-then-area-files
EXPECT_HAS | pa.txt | PAGE \p area \p globe:3,4/region:0,1/cell:7,9 \p | page-area-header-names-the-address
RUN | $T/dg.+x | conserve | $T/pr.txt | 7 | 9 | $T/pa.txt
EXPECT_EXIT | 0 | page-area-conserves-against-page-region
RUN | $T/dg.+x | page | $T/scale.pdl | globe:3,4/region:0,1/cell:16,0 | $T/z.txt
EXPECT_EXIT | 2 | page-refuses-cell-16
RUN | $T/dg.+x | page | $T/scale.pdl | globe:3,4/region:0,1/cell:7,9x | $T/z.txt
EXPECT_EXIT | 2 | page-refuses-malformed-cell
EXPECT_NOFILE | z.txt | page-refusal-writes-nothing
# the round trip: out, back, and the region page is the same bytes again (page of the address that zoom_out returned)
RUN | $T/dg.+x | page | $T/scale.pdl | globe:3,4/region:0,1 | $T/pr2.txt
RUN | cmp | $T/pr.txt | $T/pr2.txt
EXPECT_EXIT | 0 | round-trip-region-page-identical
# zoom into a different cell and back: a different area page, same region page
RUN | $T/dg.+x | page | $T/scale.pdl | globe:3,4/region:0,1/cell:8,9 | $T/pb.txt
RUN | cmp | -s | $T/pa.txt | $T/pb.txt
EXPECT_EXIT | 1 | neighbour-cell-other-page
# R3: dust_gen export - a height page becomes the board engine's files. Band edges are pinned at every boundary (19|20, 34|35, 44|45, 64|65, 79|80, 91|92) so an off-by-one fails; legend, terrain legend and extrusion are checked against the same band table.
MKDIR | ex
WRITE | ex_page.txt | PAGE \p region \p fixture \p 1 \p 16\n00 19 20 34 35 44 45 64 65 79 80 91 92 99 50 50\n50 50 50 50 50 50 50 50 50 50 50 50 50 50 50 50\n50 50 50 50 50 50 50 50 50 50 50 50 50 50 50 50\n50 50 50 50 50 50 50 50 50 50 50 50 50 50 50 50\n50 50 50 50 50 50 50 50 50 50 50 50 50 50 50 50\n50 50 50 50 50 50 50 50 50 50 50 50 50 50 50 50\n50 50 50 50 50 50 50 50 50 50 50 50 50 50 50 50\n50 50 50 50 50 50 50 50 50 50 50 50 50 50 50 50\n50 50 50 50 50 50 50 50 50 50 50 50 50 50 50 50\n50 50 50 50 50 50 50 50 50 50 50 50 50 50 50 50\n50 50 50 50 50 50 50 50 50 50 50 50 50 50 50 50\n50 50 50 50 50 50 50 50 50 50 50 50 50 50 50 50\n50 50 50 50 50 50 50 50 50 50 50 50 50 50 50 50\n50 50 50 50 50 50 50 50 50 50 50 50 50 50 50 50\n50 50 50 50 50 50 50 50 50 50 50 50 50 50 50 50\n50 50 50 50 50 50 50 50 50 50 50 50 50 50 50 50\n
RUN | $T/dg.+x | export | $T/ex_page.txt | $T/ex
EXPECT_EXIT | 0 | export-ok
EXPECT_HAS | ex/map.txt | aabbccddeeffggdd\ndddddddddddddddd | export-row0-and-row1-bands
RUN | wc | -l | $T/ex/map.txt
EXPECT_OUT | 16 | map-has-16-rows
EXPECT_HAS | ex/ascii_legend.txt | a\p0\p20\p50\p130\p-\pdeep water\p~ | legend-a
EXPECT_HAS | ex/extrusion.pdl | EXTRUDE      \p a                  \p 0 | extrusion-a
EXPECT_HAS | ex/ascii_legend.txt | b\p0\p50\p100\p190\p-\pwater\p~ | legend-b
EXPECT_HAS | ex/extrusion.pdl | EXTRUDE      \p b                  \p 0 | extrusion-b
EXPECT_HAS | ex/ascii_legend.txt | c\p1\p215\p195\p130\p-\psand\p. | legend-c
EXPECT_HAS | ex/extrusion.pdl | EXTRUDE      \p c                  \p 1 | extrusion-c
EXPECT_HAS | ex/ascii_legend.txt | d\p1\p90\p160\p70\p-\pgrass\p" | legend-d
EXPECT_HAS | ex/extrusion.pdl | EXTRUDE      \p d                  \p 1 | extrusion-d
EXPECT_HAS | ex/ascii_legend.txt | e\p2\p40\p110\p50\p-\pforest\pT | legend-e
EXPECT_HAS | ex/extrusion.pdl | EXTRUDE      \p e                  \p 2 | extrusion-e
EXPECT_HAS | ex/ascii_legend.txt | f\p3\p130\p125\p120\p-\prock\p^ | legend-f
EXPECT_HAS | ex/extrusion.pdl | EXTRUDE      \p f                  \p 3 | extrusion-f
EXPECT_HAS | ex/ascii_legend.txt | g\p3\p240\p240\p245\p-\psnow\p* | legend-g
