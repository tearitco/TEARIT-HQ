RUN | $T/m/m7.+x | give | $T/dC | $T/s7 | asa | flamer | 1 | t
RUN | $T/m/m7.+x | give | $T/dC | $T/s7 | asa | fuel | 3 | t
RUN | $T/m/m7.+x | shoot | $T/dC | $T/s7 | asa | flamer | w
RUN | $T/m/m7.+x | wait | $T/dC | $T/s7 | 5
RUN | $T/m/m7.+x | cell | $T/dC | $T/s7 | 23 | 1 | 11
EXPECT_OUT_LACKS | planks | SABOTAGE 7 (cap ignored) is caught: with a cap of 1 block 23 must still be planks at turn 7
RUN | cp | $HOUSE/@.apps/vox/ops/vox_op.c | $T/m/m8.c
RUN | sed | -i | s#!burn(sk(cx, cy, cz)) \p\p ent_find(S.fire, S.nf, cx, cy, cz) >= 0 \p\p S.nf >= MAXF#ent_find(S.fire, S.nf, cx, cy, cz) >= 0 \p\p S.nf >= MAXF# | $T/m/m8.c
RUN | cmp | -s | $HOUSE/@.apps/vox/ops/vox_op.c | $T/m/m8.c
