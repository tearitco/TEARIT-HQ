RUN | gcc | -std=gnu11 | -w | -O2 | -o | $T/m/m8.+x | $T/m/m8.c
EXPECT_EXIT | 0 | mutant 8 compiles
RUN | $T/m/m8.+x | move | $T/dF | $T/s8 | asa | 28 | 1 | 5
RUN | $T/m/m8.+x | give | $T/dF | $T/s8 | asa | flamer | 1 | t
RUN | $T/m/m8.+x | give | $T/dF | $T/s8 | asa | fuel | 3 | t
RUN | $T/m/m8.+x | shoot | $T/dF | $T/s8 | asa | flamer | w
EXPECT_OUT_LACKS | set fire: 2 blocks | SABOTAGE 8 (non-flammable blocks catch fire) is caught: the dirt floor is lit too
RUN | cp | $HOUSE/@.apps/vox/ops/vox_op.c | $T/m/m9.c
RUN | sed | -i | s#ent_add(w->fire, &w->nf, atoi(f\[3\]), atoi(f\[4\]), atoi(f\[5\]), atoi(f\[6\]));#;# | $T/m/m9.c
RUN | cmp | -s | $HOUSE/@.apps/vox/ops/vox_op.c | $T/m/m9.c
EXPECT_EXIT | 1 | mutant 9 (the fold forgets IGNITE) really differs
RUN | gcc | -std=gnu11 | -w | -O2 | -o | $T/m/m9.+x | $T/m/m9.c
EXPECT_EXIT | 0 | mutant 9 compiles
RUN | $T/m/m9.+x | verify | $T/dF | $T/f1
EXPECT_OUT_LACKS | verified | SABOTAGE 9 (a fold that forgets the fire) is caught: the genuine fire ledger no longer verifies
CLEAN |
CASE | the-projection-draws-fire-char-and-wet-cubes
SCRATCH
INCLUDE | ../fixtures/rmmc_house.pdl
MKDIR | h/@.apps/rmmc/rmmc-pchq/pieces/system/maps/rmmc/rmmc-0001
RUN | $T/h/@.apps/vox/ops/+x/vox_op.+x | move | $T/h/@.apps/rmmc/vox | $T/led.txt | asa | 140 | 6 | 100
RUN | $T/h/@.apps/vox/ops/+x/vox_op.+x | give | $T/h/@.apps/rmmc/vox | $T/led.txt | asa | planks | 2 | test
RUN | $T/h/@.apps/vox/ops/+x/vox_op.+x | give | $T/h/@.apps/rmmc/vox | $T/led.txt | asa | flamer | 1 | test
RUN | $T/h/@.apps/vox/ops/+x/vox_op.+x | give | $T/h/@.apps/rmmc/vox | $T/led.txt | asa | fuel | 2 | test
RUN | $T/h/@.apps/vox/ops/+x/vox_op.+x | give | $T/h/@.apps/rmmc/vox | $T/led.txt | asa | watergun | 1 | test
RUN | $T/h/@.apps/vox/ops/+x/vox_op.+x | give | $T/h/@.apps/rmmc/vox | $T/led.txt | asa | waterpack | 2 | test
RUN | $T/h/@.apps/vox/ops/+x/vox_op.+x | place | $T/h/@.apps/rmmc/vox | $T/led.txt | asa | planks | 141 | 6 | 100
RUN | $T/h/@.apps/vox/ops/+x/vox_op.+x | shoot | $T/h/@.apps/rmmc/vox | $T/led.txt | asa | flamer | e
EXPECT_OUT | set fire: 1 blocks | the flame lights the one planks block at (141,6,100)
RUN | $T/h/@.apps/rmmc/ops/+x/rmmc_project_op.+x | project | $T/h/@.apps/rmmc/rmmc-pchq/pieces/system/maps/rmmc/rmmc-0001/seed | $T/h/@.apps/rmmc/rmmc-pchq/pieces/system/maps/rmmc/rmmc-0001 | $T/led.txt | $T/h/@.apps/rmmc/pose.pdl | $T/h/@.apps/rmmc/vox/terrain.heightmap
EXPECT_EXIT | 0 | the projection runs on a fire ledger
EXPECT_HAS | h/@.apps/rmmc/rmmc-pchq/pieces/system/maps/rmmc/rmmc-0001/events.txt | 141 100 240 128 28 fire:3 0 2 0 | a fire cube at column (141,100), level 6 - shift 3 = 3, in the fire colour
RUN | $T/h/@.apps/vox/ops/+x/vox_op.+x | wait | $T/h/@.apps/rmmc/vox | $T/led.txt | 6
RUN | $T/h/@.apps/rmmc/ops/+x/rmmc_project_op.+x | project | $T/h/@.apps/rmmc/rmmc-pchq/pieces/system/maps/rmmc/rmmc-0001/seed | $T/h/@.apps/rmmc/rmmc-pchq/pieces/system/maps/rmmc/rmmc-0001 | $T/led.txt | $T/h/@.apps/rmmc/pose.pdl | $T/h/@.apps/rmmc/vox/terrain.heightmap
EXPECT_HAS | h/@.apps/rmmc/rmmc-pchq/pieces/system/maps/rmmc/rmmc-0001/events.txt | 141 100 30 30 34 char:3 0 2 0 | after the burn-out the cube is a charcoal cube
EXPECT_LACKS | h/@.apps/rmmc/rmmc-pchq/pieces/system/maps/rmmc/rmmc-0001/events.txt | fire:3 | and the fire cube is gone
RUN | $T/h/@.apps/vox/ops/+x/vox_op.+x | move | $T/h/@.apps/rmmc/vox | $T/led.txt | asa | 138 | 6 | 100
RUN | $T/h/@.apps/vox/ops/+x/vox_op.+x | shoot | $T/h/@.apps/rmmc/vox | $T/led.txt | asa | watergun | e
EXPECT_OUT | splash | the water gun at the charcoal 3 cells away pours water in front of it
RUN | $T/h/@.apps/rmmc/ops/+x/rmmc_project_op.+x | project | $T/h/@.apps/rmmc/rmmc-pchq/pieces/system/maps/rmmc/rmmc-0001/seed | $T/h/@.apps/rmmc/rmmc-pchq/pieces/system/maps/rmmc/rmmc-0001 | $T/led.txt | $T/h/@.apps/rmmc/pose.pdl | $T/h/@.apps/rmmc/vox/terrain.heightmap
EXPECT_HAS | h/@.apps/rmmc/rmmc-pchq/pieces/system/maps/rmmc/rmmc-0001/events.txt | 140 100 60 110 214 wet:3 0 2 3 | a water cube at (140,100) level 3, pattern 3 = flow level 3 (a shallow layer in the engine)
RUN | $T/h/@.apps/vox/ops/+x/vox_op.+x | verify | $T/h/@.apps/rmmc/vox | $T/led.txt
EXPECT_OUT | verified | the real-data fire ledger verifies
CLEAN |
