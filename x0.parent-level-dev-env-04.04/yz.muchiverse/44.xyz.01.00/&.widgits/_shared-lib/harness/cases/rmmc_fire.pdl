RUN | $T/m/m4.+x | shoot | $T/dF | $T/s4 | asa | watergun | w
RUN | $T/m/m4.+x | cell | $T/dF | $T/s4 | 23 | 1 | 5
EXPECT_OUT_LACKS | charcoal | SABOTAGE 4 (late douse never chars) is caught
RUN | cp | $HOUSE/@.apps/vox/ops/vox_op.c | $T/m/m5.c
RUN | sed | -i | s#if (e.y > 0 && is_air(sk(e.x, e.y - 1, e.z))) {#if (0) {# | $T/m/m5.c
RUN | cmp | -s | $HOUSE/@.apps/vox/ops/vox_op.c | $T/m/m5.c
EXPECT_EXIT | 1 | mutant 5 (water never falls) really differs
RUN | gcc | -std=gnu11 | -w | -O2 | -o | $T/m/m5.+x | $T/m/m5.c
EXPECT_EXIT | 0 | mutant 5 compiles
RUN | $T/m/m5.+x | move | $T/dF | $T/s5 | asa | 28 | 2 | 14
RUN | $T/m/m5.+x | give | $T/dF | $T/s5 | asa | watergun | 1 | t
RUN | $T/m/m5.+x | give | $T/dF | $T/s5 | asa | waterpack | 3 | t
RUN | $T/m/m5.+x | shoot | $T/dF | $T/s5 | asa | watergun | w
RUN | $T/m/m5.+x | cell | $T/dF | $T/s5 | 24 | 1 | 14
EXPECT_OUT_LACKS | water_f3 | SABOTAGE 5 (no falling) is caught: the cell below stays empty
RUN | cp | $HOUSE/@.apps/vox/ops/vox_op.c | $T/m/m6.c
RUN | sed | -i | s#if (!src && dry > 0 && t - e.start >= dry) {#if (0) {# | $T/m/m6.c
RUN | cmp | -s | $HOUSE/@.apps/vox/ops/vox_op.c | $T/m/m6.c
EXPECT_EXIT | 1 | mutant 6 (water never dries) really differs
RUN | gcc | -std=gnu11 | -w | -O2 | -o | $T/m/m6.+x | $T/m/m6.c
EXPECT_EXIT | 0 | mutant 6 compiles
RUN | $T/m/m6.+x | move | $T/dF | $T/s6 | asa | 28 | 1 | 5
RUN | $T/m/m6.+x | give | $T/dF | $T/s6 | asa | flamer | 1 | t
RUN | $T/m/m6.+x | give | $T/dF | $T/s6 | asa | fuel | 3 | t
RUN | $T/m/m6.+x | give | $T/dF | $T/s6 | asa | watergun | 1 | t
RUN | $T/m/m6.+x | give | $T/dF | $T/s6 | asa | waterpack | 3 | t
RUN | $T/m/m6.+x | shoot | $T/dF | $T/s6 | asa | flamer | w
RUN | $T/m/m6.+x | shoot | $T/dF | $T/s6 | asa | watergun | w
RUN | $T/m/m6.+x | wait | $T/dF | $T/s6 | 40
RUN | $T/m/m6.+x | fire | $T/dF | $T/s6
EXPECT_OUT_LACKS | flow=- | SABOTAGE 6 (puddles never dry) is caught
RUN | cp | $HOUSE/@.apps/vox/ops/vox_op.c | $T/m/m7.c
RUN | sed | -i | s#for (int i = 0; i < n0 && done < cap; i++) {#for (int i = 0; i < n0; i++) {# | $T/m/m7.c
RUN | cmp | -s | $HOUSE/@.apps/vox/ops/vox_op.c | $T/m/m7.c
