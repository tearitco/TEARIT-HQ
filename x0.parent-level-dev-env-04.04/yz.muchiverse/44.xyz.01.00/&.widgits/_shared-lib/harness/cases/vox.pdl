CASE    | replay-and-tamper
# the ledger is the authority: replaying its intent rows into a NEW file gives identical bytes, twice; a hand-edited ledger is refused and nothing is added
RUN | $T/h/@.apps/vox/ops/+x/vox_op.+x | verify | $T/h/@.apps/vox | $T/p/l
EXPECT_OUT_IS | verified | the-untouched-ledger-verifies-(positive-control)
RUN | $T/h/@.apps/vox/ops/+x/vox_op.+x | replay | $T/h/@.apps/vox | $T/p/l | $T/r1/l
EXPECT_OUT_IS | replayed identical | replay-into-a-new-file-reproduces-every-byte
RUN | $T/h/@.apps/vox/ops/+x/vox_op.+x | replay | $T/h/@.apps/vox | $T/p/l | $T/r2/l
RUN | cmp | -s | $T/p/l | $T/r1/l
EXPECT_EXIT | 0 | replay-1-equals-the-ledger-byte-for-byte
RUN | cmp | -s | $T/r1/l | $T/r2/l
EXPECT_EXIT | 0 | replay-twice-gives-identical-bytes
SUMTREE | sa | p
RUN | $T/h/@.apps/vox/ops/+x/vox_op.+x | replay | $T/h/@.apps/vox | $T/p/l | $T/r1/l
EXPECT_EXIT | 2 | replay-into-an-existing-file-refuses-(exit-2)
SUMTREE | sb | p
EXPECT_EQ | $sa | $sb | replay-into-an-existing-file-refuses-wrote-NOTHING
MKDIR | t1
MKDIR | t2
