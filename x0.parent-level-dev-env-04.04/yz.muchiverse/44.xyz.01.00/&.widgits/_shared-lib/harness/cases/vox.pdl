RUN | $T/h/@.apps/vox/ops/+x/vox_op.+x | give | $T/h/@.apps/vox | $T/al/l | joe | cobble | 1 | seed
RUN | sh | $T/h/@.apps/vox/events/vox_place/event_pkg/pages/page_1/cmd_1.sh
