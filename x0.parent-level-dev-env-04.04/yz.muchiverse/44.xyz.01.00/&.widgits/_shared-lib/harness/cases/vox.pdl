RUN | sh | $T/h/@.apps/vox/events/vox_mine/event_pkg/pages/page_1/cmd_1.sh
CAPTURE | page_mine2
EXPECT_EQ | $page_mine2 | broken stage=3 progress=2/2 | the-second-page-run-breaks-it
RUN | $T/h/@.apps/vox/ops/+x/vox_op.+x | mine | $T/h/@.apps/vox | $T/al/l | joe | pick | 3,2,3
RUN | sh | $T/h/@.apps/vox/events/vox_wait/event_pkg/pages/page_1/cmd_1.sh
