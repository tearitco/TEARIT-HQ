# vox (2026-11-22, D105; recipe: STANDARD-RULES-AS-OPS sections 12 to 16): the voxel foundation. ONE op (@.apps/vox/ops/vox_op.c) whose only state is the append-only ledger rows
# GIVE MOVE DAMAGE MINE DROP PLACE TURN DAY SLEEP SPAWNPOINT; every number is a RULE / TOOL / DAYLIGHT / BLOCK row in @.apps/vox; place, mine, wait and sleep are called by four event pages (registry COMMAND rows vox_*).
# Nothing here touches the live ledger: a scratch house under $T holds the pages, the data and a freshly built op (the page wrappers walk up to the folder holding xyzfs, which is $T/h).
# GENERATED from the macro source by an awk one-off (X rows -> RUN rows; MUT rows -> five rows each); every expected number below is HAND-COMPUTED from the data rows, not copied from a run.
# Each SABOTAGE (the MUT rows) copies the op source, breaks ONE clause with sed, builds it, runs the scenario and requires the mutant's output to LACK what the real op prints (so the real check would FAIL on it).
RESULTS | ../results/vox.txt
ENV | LC_ALL | C

CASE    | setup
SCRATCH |
MKDIR | h/xyzfs
MKDIR | h/#.desktop
MKDIR | h/@.apps/vox/ops/+x
MKDIR | b
MKDIR | p
MKDIR | d1
MKDIR | d2
MKDIR | s
MKDIR | r1
MKDIR | r2
MKDIR | al
COPYDIR | @.apps/vox/events | h/@.apps/vox/events
COPY | @.apps/vox/rules.pdl | h/@.apps/vox/rules.pdl
COPY | @.apps/vox/blocks.pdl | h/@.apps/vox/blocks.pdl
COPY | @.apps/vox/terrain.pdl | h/@.apps/vox/terrain.pdl
RUN | gcc | -std=gnu11 | -Wall | -Wextra | -O2 | -o | $T/h/@.apps/vox/ops/+x/vox_op.+x | $HOUSE/@.apps/vox/ops/vox_op.c
EXPECT_EXIT | 0 | vox-op-compiles-without-warnings-into-the-scratch-house
RUN | $T/h/@.apps/vox/ops/+x/vox_op.+x | --describe
EXPECT_OUT | rule vox inputs data_dir | describe-names-the-rule-and-its-inputs
EXPECT_OUT | refusal writes nothing | describe-states-the-all-or-nothing-rule
WRITE | sabotaged_registry.pdl | COMMAND vox_place\n  PARAMS actor,item,cell\nEND\n
WRITE | b/empty_dir_marker | x\n

CASE    | daylight
# start_minute 420 (07:00), minutes_per_turn 10, day_minutes 1440; DAYLIGHT rows 360=8 420=15 1080=15 1140=8 1200=2; linear between rows, integer division toward zero
RUN | $T/h/@.apps/vox/ops/+x/vox_op.+x | status | $T/h/@.apps/vox | $T/d1/l
EXPECT_OUT_IS | turn=0 minute=420 day=0 light=15 | start-is-minute-420-level-15-(HAND-the-DAYLIGHT-420-row)
RUN | $T/h/@.apps/vox/ops/+x/vox_op.+x | wait | $T/h/@.apps/vox | $T/d1/l | 72
EXPECT_OUT_IS | turn=72 | 72-turns-is-turn-72
RUN | $T/h/@.apps/vox/ops/+x/vox_op.+x | status | $T/h/@.apps/vox | $T/d1/l
EXPECT_OUT_IS | turn=72 minute=1140 day=0 light=8 | 19:00-is-level-8-(HAND-420+720=1140-the-DAYLIGHT-1140-row)
RUN | $T/h/@.apps/vox/ops/+x/vox_op.+x | wait | $T/h/@.apps/vox | $T/d1/l | 6
RUN | $T/h/@.apps/vox/ops/+x/vox_op.+x | status | $T/h/@.apps/vox | $T/d1/l
EXPECT_OUT_IS | turn=78 minute=1200 day=0 light=2 | 20:00-is-level-2
RUN | $T/h/@.apps/vox/ops/+x/vox_op.+x | wait | $T/h/@.apps/vox | $T/d1/l | 60
RUN | $T/h/@.apps/vox/ops/+x/vox_op.+x | status | $T/h/@.apps/vox | $T/d1/l
EXPECT_OUT_IS | turn=138 minute=360 day=1 light=8 | 06:00-next-day-is-level-8-and-day-1-(HAND-420+1380=1800-1440)
RUN | $T/h/@.apps/vox/ops/+x/vox_op.+x | wait | $T/h/@.apps/vox | $T/d1/l | 3
RUN | $T/h/@.apps/vox/ops/+x/vox_op.+x | status | $T/h/@.apps/vox | $T/d1/l
EXPECT_OUT_IS | turn=141 minute=390 day=1 light=11 | the-midpoint-390-interpolates-8+7*30/60=11-(HAND-integer-division)
RUN | $T/h/@.apps/vox/ops/+x/vox_op.+x | wait | $T/h/@.apps/vox | $T/d1/l | 144
RUN | $T/h/@.apps/vox/ops/+x/vox_op.+x | status | $T/h/@.apps/vox | $T/d1/l
EXPECT_OUT_IS | turn=285 minute=390 day=2 light=11 | 144-more-turns-is-exactly-one-more-day
RUN | grep | -c | ^DAY | $T/d1/l
EXPECT_OUT_IS | 2 | two-midnights-crossed-two-DAY-rows
EXPECT_HAS | d1/l | DAY \p 1 | DAY-1-row
EXPECT_HAS | d1/l | DAY \p 2 | DAY-2-row
RUN | $T/h/@.apps/vox/ops/+x/vox_op.+x | wait | $T/h/@.apps/vox | $T/d2/l | 144
RUN | $T/h/@.apps/vox/ops/+x/vox_op.+x | status | $T/h/@.apps/vox | $T/d2/l
EXPECT_OUT_IS | turn=144 minute=420 day=1 light=15 | 144-turns-of-10-minutes-is-one-day
RUN | grep | -c | ^DAY | $T/d2/l
EXPECT_OUT_IS | 1 | one-day-is-exactly-one-DAY-row
SUMTREE | sa | d2
RUN | $T/h/@.apps/vox/ops/+x/vox_op.+x | wait | $T/h/@.apps/vox | $T/d2/l | 0
EXPECT_EXIT | 2 | wait-zero-refuses-(exit-2)
SUMTREE | sb | d2
EXPECT_EQ | $sa | $sb | wait-zero-refuses-wrote-NOTHING
SUMTREE | sa | d2
RUN | $T/h/@.apps/vox/ops/+x/vox_op.+x | wait | $T/h/@.apps/vox | $T/d2/l | 10001
EXPECT_EXIT | 2 | wait-over-the-rule-cap-refuses-(exit-2)
SUMTREE | sb | d2
EXPECT_EQ | $sa | $sb | wait-over-the-rule-cap-refuses-wrote-NOTHING
SUMTREE | sa | d2
RUN | $T/h/@.apps/vox/ops/+x/vox_op.+x | wait | $T/h/@.apps/vox | $T/d2/l
EXPECT_EXIT | 2 | wait-needs-an-argument-(exit-2)
SUMTREE | sb | d2
EXPECT_EQ | $sa | $sb | wait-needs-an-argument-wrote-NOTHING

