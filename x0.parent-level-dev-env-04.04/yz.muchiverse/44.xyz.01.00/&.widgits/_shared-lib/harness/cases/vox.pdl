RUN | sed | -i | s/DAMAGE \p joe \p hand \p 3 \p 2 \p 3 \p 1 \p 1$/DAMAGE \p joe \p hand \p 3 \p 2 \p 3 \p 1 \p 5/ | $T/t1/l
RUN | sed | -i | /^DROP/d | $T/t2/l
APPEND | t3/l | MINE \p joe \p 5 \p 2 \p 5 \p dirt\n
APPEND | t4/l | FOO \p bar \p baz\n
