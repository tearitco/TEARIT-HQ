RUN | $T/h/&.widgits/_shared-lib/ops/+x/game_core.+x | $T/h/@.apps/demo-race | $T/g_old | join | C
RUN | $T/h/&.widgits/_shared-lib/ops/+x/game_core.+x | $T/h/@.apps/demo-race | $T/g_old | start
RUN | $T/h/&.widgits/_shared-lib/ops/+x/game_core.+x | $T/h/@.apps/demo-race | $T/g_old | autoplay
RUN | $T/h/&.widgits/_shared-lib/ops/+x/game_core.+x | $T/h/@.apps/demo-race | $T/g_old | ledger_hash
EXPECT_OUT_IS | LEDGER events=30 hash=e974d60c99abbe34 | CAUSE-PROVEN:-without-the-BOARD-rows-the-same-game-has-the-OLD-pinned-digest-(HEAD-636d61338)
RUN | $T/h/&.widgits/_shared-lib/ops/+x/game_core.+x | $T/h/@.apps/demo-race | $T/g_old | replay
EXPECT_OUT_IS | REPLAY events=30 hash=c69a00ab222f3bf2 | and-the-same-STATE-hash-(no-rule-moved)
