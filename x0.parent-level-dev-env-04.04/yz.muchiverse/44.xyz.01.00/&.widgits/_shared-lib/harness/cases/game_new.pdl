# game_new: the GAME FOUNDATION GENERATOR (2026-11-09; owner: "harnesses for simple stuff like making new GAME FOUNDATIONS where we could just put in args"). ops/game_new_op.c + the ONE shared engine/driver/button op
# _shared-lib/ops/game_core.c + harness/templates/game/<kind>/. BOOK 16.game/GAME-FOUNDATION-GENERATOR-HOW-TO-AGENT-GUIDE-2026-11-09.md.
# Method: both programs are COMPILED FROM SOURCE into a scratch folder first (so the case tests the source, not an old binary), a scratch house `h` gets a copy of the templates and the freshly built engine, and everything happens there.
# Every number pinned below was OBSERVED in a scratch run on 2026-11-09 before it was written here (seed 7, 3 players: 30 rows, 9 rounds, winner A). Nothing here touches a live folder or the live editor.
# RULES COVERED: list; new for each kind; every refusal (existing target, name clash with @.apps, bad name, bad title, unknown kind, bad players/seed, unknown flag, a template with an undeclared / misspelt / unclosed placeholder,
#   a declared placeholder the file does not use) writes NOTHING (SUMTREE); --dry-run writes nothing; --into skips the harness files; THE KEY ACCEPTANCE (demo-race, ledger, 3 players, seed 7): a full scripted game to a winner, replay
#   reproduces the ledger hash, hand-edited / deleted / forged rows refused, a stray file fails the audit, deleted projections regenerate identically, the generated case passes (42) and `check` passes; the same for realtime (33) and
#   editor (28); the REAL driver (Play) for each kind in a scratch editor; the lints on the generated tree. MUTANTS: the engine built with GC_MUT_NO_VERIFY / GC_MUT_NO_GHOST makes `check` and the generated case FAIL.
# NOT COVERED: the live editor window (Books dropdown, Play, popup rendering): UNTESTED, see the guide's status table.
RESULTS | ../results/game_new.txt
ENV | LC_ALL | C

CASE    | build
SCRATCH |
MKDIR   | bin
MKDIR   | mut
RUN | gcc | -std=gnu11 | -Wall | -Wextra | -Wno-format-truncation | -Wno-misleading-indentation | -O2 | -o | $T/bin/game_new_op.+x | $HOUSE/&.widgits/_shared-lib/harness/ops/game_new_op.c
EXPECT_EXIT | 0 | game_new_op-compiles-from-source
EXPECT_OUT_LACKS | warning | and-without-a-warning
RUN | gcc | -std=gnu11 | -Wall | -Wextra | -Wno-format-truncation | -Wno-misleading-indentation | -O2 | -o | $T/bin/game_core.+x | $HOUSE/&.widgits/_shared-lib/ops/game_core.c
EXPECT_EXIT | 0 | game_core-compiles-from-source
EXPECT_OUT_LACKS | warning | and-without-a-warning
RUN | gcc | -std=gnu11 | -Wno-format-truncation | -Wno-misleading-indentation | -O2 | -DGC_MUT_NO_VERIFY | -o | $T/mut/verify.+x | $HOUSE/&.widgits/_shared-lib/ops/game_core.c
EXPECT_EXIT | 0 | the-mutant-with-replay-verification-off-compiles
RUN | gcc | -std=gnu11 | -Wno-format-truncation | -Wno-misleading-indentation | -O2 | -DGC_MUT_NO_GHOST | -o | $T/mut/ghost.+x | $HOUSE/&.widgits/_shared-lib/ops/game_core.c
EXPECT_EXIT | 0 | the-mutant-with-the-ghost-audit-off-compiles
MKDIR   | h/&.widgits/_shared-lib/ops/+x
MKDIR   | h/&.widgits/_shared-lib/harness/cases
MKDIR   | h/&.widgits/_shared-lib/harness/results
MKDIR   | h/@.apps/rpg-edit-hq/ops
COPYDIR | &.widgits/_shared-lib/harness/templates | h/&.widgits/_shared-lib/harness/templates
COPY    | @.apps/rpg-edit-hq/ops/edit_open.sh | h/@.apps/rpg-edit-hq/ops/edit_open.sh
RUN | cp | $T/bin/game_core.+x | $T/h/&.widgits/_shared-lib/ops/+x/game_core.+x
EXPECT_EXIT | 0 | the-scratch-house-has-the-freshly-built-engine

