CAPTURE | cy
CALC | ox | 520 | - | $cx
CALC | oy | 260 | - | $cy
CALC | dx | $ox | - | $ox0
CALC | dy | $oy | - | $oy0
EXPECT_LE | $dx | 1 | published-x-agrees-with-the-origin-high
EXPECT_GE | $dx | -1 | published-x-agrees-with-the-origin-low
EXPECT_LE | $dy | 1 | published-y-agrees-with-the-origin-high
EXPECT_GE | $dy | -1 | published-y-agrees-with-the-origin-low

