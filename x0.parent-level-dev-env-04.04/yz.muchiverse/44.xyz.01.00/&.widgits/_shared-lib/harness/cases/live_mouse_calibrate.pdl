CASE    | view-unchanged-and-restore
RUN | $HOUSE/&.widgits/board-viewer/tools/+x/bv_keys.+x | $sess | ~
SLEEP | 5000
RUN | $HOUSE/&.widgits/_shared-lib/ops/+x/relay_drive.+x | shot | $win | $T/after.png
RUN | $HOUSE/&.widgits/_shared-lib/harness/ops/+x/img_op.+x | diff | $T/pinned.png | $T/after.png | 420 | 320 | 1080 | 740
CAPTURE | changed
EXPECT_LE | $changed | 6000 | twelve-clicks-did-not-move-the-view-few-pixels-differ
RUN | /bin/rm | -f | $HOUSE/@.apps/rpg-edit-hq/rpg-edit-hq-pchq/pieces/system/cam_look.txt
RUN | $HOUSE/@.apps/rpg-edit-hq/ops/+x/rpg_edit_hq.+x | load | 9
RUN | /bin/rm | -rf | $HOUSE/@.apps/rpg-edit-hq/state/slots/9
CLEAN |
