COPY | &.widgits/db-hq/data/actors.pdl | &.widgits/db-hq/data/actors.pdl
RUN | nice | -n | 15 | gcc | -std=gnu11 | -O0 | -w | -o | $T/@.apps/mcl-hq/ops/+x/mcl_hq.+x | $T/@.apps/mcl-hq/ops/mcl_hq.c | -lm
EXPECT_EXIT | 0 | setup.build
EXPECT_EXISTS | @.apps/mcl-hq/ops/+x/mcl_hq.+x | setup.binary-exists
# a stand-in window: the game writes ui.txt only while a process named khtpm_core_render with <game>.xhtpm in its command line exists (a copy of tail, no GUI)
RUN | cp | /usr/bin/tail | $T/khtpm_core_render
SPAWN | viewer | $T/khtpm_core_render | -f | /dev/null | mcl-hq.xhtpm
EXPECT_ALIVE | $viewer | setup.viewer-alive
WRITE | @.apps/mcl-hq/state/flag_int.txt | 1
WRITE | @.apps/mcl-hq/state/flag_running.txt | 1
