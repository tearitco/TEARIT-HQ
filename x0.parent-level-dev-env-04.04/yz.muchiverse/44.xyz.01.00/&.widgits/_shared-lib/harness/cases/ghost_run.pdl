# quest q012 ghost_run: LOCKED cases. Binary under test: &.widgits/quest-pilot/ops/+x/ghost_run.+x (build: ops/build_ghost_run.sh); it finds quest_check.+x next to itself.
# NO network: the backend is the compiled fixture fixtures/ghost_fake_backend.c (reply/stderr/exit/hang chosen by files next to it); the judge is fixtures/ghost_chk.c.
# Each scenario builds a scratch repo $T/r (branch main) that holds the quest packet r/qst/ and src/; ghost worktrees go to $T/wts.
RESULTS | ../results/ghost_run.txt
# ---- scenario: good-reply-passes
CASE | good-reply-passes
SCRATCH |
COPY | &.widgits/quest-pilot/ops/+x/ghost_run.+x | gr.+x
COPY | &.widgits/quest-pilot/ops/+x/quest_check.+x | quest_check.+x
COPY | &.widgits/_shared-lib/harness/fixtures/ghost_fake_backend.c | fb.c
COPY | &.widgits/_shared-lib/harness/fixtures/ghost_chk.c | chk.c
RUN | cc | -O0 | -w | -o | $T/fb.+x | $T/fb.c
EXPECT_EXIT | 0 | cc-fb
RUN | cc | -O0 | -w | -o | $T/chk.+x | $T/chk.c
EXPECT_EXIT | 0 | cc-chk
WRITE | fb.+x.reply | Here is the file:\n```text\nGOODWORD line one\n```\nand a second block that must be ignored\n```\nBADWORD\n```\n
WRITE | fb.+x.err | answered by fake (model-x)\n
WRITE | r/qst/harness/h1.txt | H1\n
WRITE | r/qst/LOCK.sha256 | 63f9e4fbad57e95a92472f992662742e21b25e91a648d7353117427babab2c0d  h1.txt\n
WRITE | r/qst/scope.txt | # allowed\nout/\n
WRITE | r/qst/budget.pdl | BUDGET | max_attempts | 2\nBUDGET | max_seconds | 5\nBUDGET | max_quota_units | 50\nBUDGET | escalate_to | manager\n
WRITE | r/qst/RUN.pdl | OUTPUT | out/result.txt\nHARNESS | $T/chk.+x out/result.txt GOODWORD verdict.txt\nVERDICT_FILE | verdict.txt\n
WRITE | r/qst/prompt.txt | Write the file please.\n
WRITE | r/src/seed.txt | seed\n
WRITE | r/other/o.txt | other\n
RUN | git | init | -q | -b | main | $T/r
EXPECT_EXIT | 0 | init
RUN | git | -C | $T/r | add | -A
EXPECT_EXIT | 0 | add
RUN | git | -C | $T/r | -c | user.name=t | -c | user.email=t@t | commit | -q | -m | base
EXPECT_EXIT | 0 | commit
RUN | git | -C | $T/r | rev-parse | main
CAPTURE | tip0
RUN | git | -C | $T/r | branch | --list | main
CAPTURE | m
RUN | $T/gr.+x | $T/r/qst | main | $T/r | --ghost | g1 | --worktrees | $T/wts | --backend | $T/fb.+x
EXPECT_EXIT | 0 | good-exit
EXPECT_OUT | GHOST\pqst\pattempt=1\pRESULT\pPASS\pworktree=$T/wts/g1/qst-a001 | good-final-line
EXPECT_EXISTS | r/qst/attempts/001/reply.txt | good-reply
EXPECT_EXISTS | r/qst/attempts/001/output.diff | good-diff
EXPECT_EXISTS | r/qst/attempts/001/harness.log | good-hlog
EXPECT_EXISTS | r/qst/attempts/001/verdict.txt | good-verdict
EXPECT_EXISTS | r/qst/attempts/001/meta.pdl | good-meta
EXPECT_FILE | r/qst/attempts/001/verdict.txt | PASS ok\n | good-verdict-last-line
EXPECT_HAS | r/qst/attempts/001/meta.pdl | RESULT \p PASS | good-meta-result
EXPECT_HAS | r/qst/attempts/001/meta.pdl | BACKEND \p 0 | good-meta-backend
EXPECT_HAS | r/qst/attempts/001/meta.pdl | PROVIDER \p answered by fake (model-x) | good-meta-provider
EXPECT_HAS | r/qst/attempts/001/meta.pdl | ATTEMPT \p 1 \p g1 | good-meta-attempt
EXPECT_HAS | r/qst/attempts/001/meta.pdl | WALL | good-meta-wall
EXPECT_HAS | r/qst/attempts/001/output.diff | +GOODWORD line one | good-diff-content
EXPECT_HAS | r/qst/attempts/001/reply.txt | BADWORD | good-reply-raw-kept
EXPECT_FILE | wts/g1/qst-a001/out/result.txt | GOODWORD line one\n | good-first-block-only
EXPECT_NOFILE | wts/g1/qst-a001/BADWORD | good-no-extra-file
EXPECT_HAS | fb.+x.env | HORN_TOOLS=off | good-env-tools-off
EXPECT_HAS | fb.+x.env | HORN_CURL_TIMEOUT=5 | good-env-curl-timeout
EXPECT_FILE | fb.+x.prompt | Write the file please.\n | good-prompt-verbatim
RUN | git | -C | $T/wts/g1/qst-a001 | rev-parse | --abbrev-ref | HEAD
EXPECT_OUT_IS | ghost/g1/qst-a001 | good-worktree-branch
RUN | git | -C | $T/r | rev-parse | main
CAPTURE | tip1
EXPECT_EQ | $tip0 | $tip1 | target-branch-untouched
CLEAN |
