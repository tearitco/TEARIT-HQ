COPY | &.widgits/_shared-lib/harness/fixtures/ghost_fake_backend.c | fb.c
COPY | &.widgits/_shared-lib/harness/fixtures/ghost_chk.c | chk.c
RUN | cc | -O0 | -w | -o | $T/fb.+x | $T/fb.c
EXPECT_EXIT | 0 | cc-fb
RUN | cc | -O0 | -w | -o | $T/chk.+x | $T/chk.c
EXPECT_EXIT | 0 | cc-chk
WRITE | fb.+x.reply | Here is the file:\n```text\nGOODWORD line one\n```\nand a second block that must be ignored\n```\nBADWORD\n```\n
WRITE | fb.+x.err | answered by fake (model-x)\n
WRITE | r/qst/harness/h1.txt | H1\n
WRITE | r/qst/LOCK.sha256 | 63f9e4fbad57e95a92472f992662742e21b25e91a648d7353117427babab2c0d  h1.txt\n
WRITE | r/qst/scope.txt | # allowed\nout/\n
WRITE | r/qst/budget.pdl | BUDGET | max_attempts | 2\nBUDGET | max_seconds | 5\nBUDGET | max_quota_units | 50\nBUDGET | escalate_to | manager\n
WRITE | r/qst/RUN.pdl | OUTPUT | out/result.txt\nHARNESS | $T/chk.+x out/result.txt GOODWORD verdict.txt\nVERDICT_FILE | verdict.txt\n
WRITE | r/qst/prompt.txt | Write the file please.\n
WRITE | r/src/seed.txt | seed\n
WRITE | r/other/o.txt | other\n
RUN | git | init | -q | -b | main | $T/r
EXPECT_EXIT | 0 | init
RUN | git | -C | $T/r | add | -A
EXPECT_EXIT | 0 | add
RUN | git | -C | $T/r | -c | user.name=t | -c | user.email=t@t | commit | -q | -m | base
EXPECT_EXIT | 0 | commit
RUN | git | -C | $T/r | rev-parse | main
CAPTURE | tip0
MKDIR | wts/g1/qst-a001
RUN | $T/gr.+x | $T/r/qst | main | $T/r | --ghost | g1 | --worktrees | $T/wts | --backend | $T/fb.+x
EXPECT_EXIT | 13 | pexists-exit
EXPECT_OUT | RESULT\pREFUSED-path-exists | pexists-final
EXPECT_NOFILE | r/qst/attempts | pexists-no-attempt
CLEAN |
# ---- scenario: usage-errors
CASE | usage-errors
SCRATCH |
COPY | &.widgits/quest-pilot/ops/+x/ghost_run.+x | gr.+x
COPY | &.widgits/quest-pilot/ops/+x/quest_check.+x | quest_check.+x
COPY | &.widgits/_shared-lib/harness/fixtures/ghost_fake_backend.c | fb.c
