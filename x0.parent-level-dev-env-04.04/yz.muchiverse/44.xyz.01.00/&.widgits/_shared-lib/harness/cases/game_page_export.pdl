RUN | $T/gpe.+x | $T/other_cell/h/@.apps/g | $T/other_cell/sess | --house | $T/other_cell/h
EXPECT_EXIT | 0 | other_cell-exit-0
EXPECT_OUT | rows=3 | three-rows
EXPECT_HAS | other_cell/sess/desks/bridge.pdl | \p 240 \p 160 \p 3 \p 2 \p . | cell-3-2-is-240-160

