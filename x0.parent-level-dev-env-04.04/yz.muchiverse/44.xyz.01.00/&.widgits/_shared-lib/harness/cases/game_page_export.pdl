MKDIR | other_cell/h/@.apps/g/g-pchq/pieces/system
WRITE | other_cell/h/@.apps/g/g-pchq/pieces/xelector_01/state.txt | pos_x=3\npos_y=2\npossessed_id=hero_01\n
WRITE | other_cell/h/@.apps/g/g-pchq/pieces/hero_01/state.txt | pos_x=3\npos_y=2\n
WRITE | other_cell/h/@.apps/g/g-pchq/pieces/system/arrow_config.txt | default_camera_mode=2\n
MKDIR | other_cell/h/@.apps/g/g-pchq/pieces/system/maps/g/bridge
