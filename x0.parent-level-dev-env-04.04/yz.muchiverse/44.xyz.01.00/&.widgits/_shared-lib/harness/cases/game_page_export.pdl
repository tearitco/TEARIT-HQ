MKDIR | chain/h/@.apps/g/g-pchq/pieces/display
MKDIR | chain/h/@.apps/g/g-pchq/pieces/system
WRITE | chain/h/@.apps/g/g-pchq/pieces/xelector_01/state.txt | entity_type=xelector\npos_x=7\npos_y=5\npossessed_id=hero_01\n
WRITE | chain/h/@.apps/g/g-pchq/pieces/hero_01/state.txt | entity_type=hero\npos_x=7\npos_y=5\n
WRITE | chain/h/@.apps/g/g-pchq/pieces/system/arrow_config.txt | default_camera_mode=2\n
MKDIR | chain/h/@.apps/g/g-pchq/pieces/system/maps/g/bridge
WRITE | chain/h/@.apps/g/g-pchq/pieces/system/maps/g/game.pdl | GAME \p n_desks \p 1\nGAME \p desk_1_id \p bridge\n
WRITE | chain/h/@.apps/g/g-pchq/pieces/system/maps/g/bridge/map.txt | ....\n
RUN | $T/gpe.+x | $T/chain/h/@.apps/g | $T/chain/sess | --house | $T/chain/h
EXPECT_EXIT | 0 | exported
WRITE | chain/h/@.apps/g/g-pchq/pieces/display/open_book_page.txt | source=desk\npdl=$T/chain/sess/desks/bridge.pdl\n
RUN | $T/bc.+x | $T/chain/h/@.apps/g/g-pchq | --house | $T/chain/h
EXPECT_EXIT | 0 | the-bound-game-is-conformant
EXPECT_OUT | checks=14 pass=14 fail=0 skip=0 | all-fourteen-checks-pass-with-the-exported-page
EXPECT_OUT | PASS A10 session: book `g`, open page `bridge` exists | session-resolved
EXPECT_OUT | PASS A8 possession: xelector_01 possesses `hero_01` | possession

CASE | chain_board
MKDIR | chain_board/h/&.widgits
MKDIR | chain_board/h/@.apps/g/state
WRITE | chain_board/h/@.apps/g/state/trainer.txt | room=bridge\nx=7\ny=5\ndir=3\n
MKDIR | chain_board/h/@.apps/g/g-pchq/pieces/hero_01
MKDIR | chain_board/h/@.apps/g/g-pchq/pieces/xelector_01
MKDIR | chain_board/h/@.apps/g/g-pchq/pieces/display
MKDIR | chain_board/h/@.apps/g/g-pchq/pieces/system
WRITE | chain_board/h/@.apps/g/g-pchq/pieces/xelector_01/state.txt | entity_type=xelector\npos_x=7\npos_y=5\npossessed_id=hero_01\n
WRITE | chain_board/h/@.apps/g/g-pchq/pieces/hero_01/state.txt | entity_type=hero\npos_x=7\npos_y=5\n
WRITE | chain_board/h/@.apps/g/g-pchq/pieces/system/arrow_config.txt | default_camera_mode=2\n
MKDIR | chain_board/h/@.apps/g/g-pchq/pieces/system/maps/g/bridge
WRITE | chain_board/h/@.apps/g/g-pchq/pieces/system/maps/g/game.pdl | GAME \p n_desks \p 1\nGAME \p desk_1_id \p bridge\n
WRITE | chain_board/h/@.apps/g/g-pchq/pieces/system/maps/g/bridge/map.txt | ....\n
RUN | $T/gpe.+x | $T/chain_board/h/@.apps/g | $T/chain_board/sess | --house | $T/chain_board/h
WRITE | chain_board/h/@.apps/g/g-pchq/pieces/display/open_book_page.txt | source=board\n
RUN | $T/bc.+x | $T/chain_board/h/@.apps/g/g-pchq | --house | $T/chain_board/h
EXPECT_EXIT | 1 | a-game-still-on-source-board-fails-A2-even-with-the-page-written
EXPECT_OUT | FAIL A2 | binding-is-what-flips-it
CLEAN |
