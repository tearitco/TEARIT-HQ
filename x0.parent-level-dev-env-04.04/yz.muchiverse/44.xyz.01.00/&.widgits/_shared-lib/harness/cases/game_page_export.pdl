# game_page_export: LOCKED cases. Sources: &.widgits/_shared-lib/ops/game_page_export.c and book_check.c compiled -Wall -Wextra -Werror from source into the scratch. Each case builds a tiny house (state/trainer.txt, a pc-hq folder with hero/xelector state, arrow_config, a map book) and runs the op into a scratch session.
# Expected rows are worked out BY HAND from the rules in the op header (pixels = cells x 80; the page is the trainer's room; the xelector stands on the hero and carries its possessed id; camera m= from default_camera_mode, p=6 for modes 1/2 else -90).
RESULTS | ../results/game_page_export.txt
SCRATCH |
CASE | build
RUN | gcc | -std=gnu11 | -Wall | -Wextra | -Werror | -O2 | -o | $T/gpe.+x | $HOUSE/&.widgits/_shared-lib/ops/game_page_export.c
EXPECT_EXIT | 0 | export-compiles-clean
RUN | gcc | -std=gnu11 | -Wall | -Wextra | -Werror | -O2 | -o | $T/bc.+x | $HOUSE/&.widgits/_shared-lib/ops/book_check.c
EXPECT_EXIT | 0 | book_check-compiles-clean

CASE | ok
MKDIR | ok/h/&.widgits
MKDIR | ok/h/@.apps/g/state
WRITE | ok/h/@.apps/g/state/trainer.txt | room=bridge\nx=7\ny=5\ndir=3\n
MKDIR | ok/h/@.apps/g/g-pchq/pieces/hero_01
MKDIR | ok/h/@.apps/g/g-pchq/pieces/xelector_01
MKDIR | ok/h/@.apps/g/g-pchq/pieces/display
MKDIR | ok/h/@.apps/g/g-pchq/pieces/system
WRITE | ok/h/@.apps/g/g-pchq/pieces/xelector_01/state.txt | entity_type=xelector\npos_x=7\npos_y=5\npossessed_id=hero_01\n
WRITE | ok/h/@.apps/g/g-pchq/pieces/hero_01/state.txt | entity_type=hero\npos_x=7\npos_y=5\n
WRITE | ok/h/@.apps/g/g-pchq/pieces/system/arrow_config.txt | default_camera_mode=2\n
MKDIR | ok/h/@.apps/g/g-pchq/pieces/system/maps/g/bridge
WRITE | ok/h/@.apps/g/g-pchq/pieces/system/maps/g/game.pdl | GAME \p n_desks \p 1\nGAME \p desk_1_id \p bridge\n
WRITE | ok/h/@.apps/g/g-pchq/pieces/system/maps/g/bridge/map.txt | ....\n
RUN | $T/gpe.+x | $T/ok/h/@.apps/g | $T/ok/sess | --house | $T/ok/h
EXPECT_EXIT | 0 | ok-exit-0
EXPECT_OUT | wrote | writes
EXPECT_OUT | rows=3 disagreements=0 | three-rows-no-disagreement
EXPECT_OUT | room=bridge cell=7,5 | reads-the-trainer
EXPECT_HAS | ok/sess/desks/bridge.pdl | DESK \p hero_01 \p @.apps/g/g-pchq/pieces/hero_01 \p 560 \p 400 \p 7 \p 5 \p . \p 0 | hero-row-pixels-are-cells-times-80
EXPECT_HAS | ok/sess/desks/bridge.pdl | DESK \p xelector_01 \p @.apps/g/g-pchq/pieces/xelector_01 \p 560 \p 400 \p 7 \p 5 \p hero_01 \p 0 | xelector-on-the-hero-with-its-possessed-id
EXPECT_HAS | ok/sess/desks/bridge.pdl | DESK \p camera_01 \p @.apps/g/g-pchq/pieces/display \p 80 \p 0 \p 1 \p 0 \p m=2,y=180,p=6,z=0,h=0 \p 0 | camera-default
EXPECT_HAS | ok/sess/session.pdl | STATE \p name \p g | book-is-the-game
EXPECT_HAS | ok/sess/session.pdl | STATE \p active_desk \p bridge | open-page-is-the-room

