WRITE | oth_sort/h/@.apps/g/g-pchq/pieces/xelector_01/state.txt | entity_type=xelector\npos_x=4\npos_y=5\npossessed_id=hero_01\n
WRITE | oth_sort/h/@.apps/g/g-pchq/pieces/hero_01/state.txt | entity_type=hero\npos_x=4\npos_y=5\n
WRITE | oth_sort/h/@.apps/g/g-pchq/pieces/system/arrow_config.txt | default_camera_mode=2\n
MKDIR | oth_sort/h/@.apps/g/g-pchq/pieces/system/maps/g/bridge
WRITE | oth_sort/h/@.apps/g/g-pchq/pieces/system/maps/g/game.pdl | GAME \p n_desks \p 1\nGAME \p desk_1_id \p bridge\n
WRITE | oth_sort/h/@.apps/g/g-pchq/pieces/system/maps/g/bridge/map.txt | ....\n
WRITE | oth_sort/h/@.apps/g/state/trainer.txt | room=bridge\nx=7\ny=5\ndir=3\n
WRITE | oth_sort/h/@.apps/g/state/pet_kilo.txt | room=bridge\nx=1\ny=2\ndir=1\nsteps=1\n
WRITE | oth_sort/h/@.apps/g/state/pet_alpha.txt | room=bridge\nx=2\ny=2\ndir=1\nsteps=1\n
WRITE | oth_sort/h/@.apps/g/state/pet_mike.txt | room=bridge\nx=3\ny=2\ndir=1\nsteps=1\n
WRITE | oth_sort/h/@.apps/g/state/pet_bravo.txt | room=bridge\nx=4\ny=2\ndir=1\nsteps=1\n
WRITE | oth_sort/h/@.apps/g/state/pet_zulu.txt | room=bridge\nx=5\ny=2\ndir=1\nsteps=1\n
WRITE | oth_sort/h/@.apps/g/state/pet_charlie.txt | room=bridge\nx=6\ny=2\ndir=1\nsteps=1\n
WRITE | oth_sort/h/@.apps/g/state/pet_delta.txt | room=bridge\nx=7\ny=2\ndir=1\nsteps=1\n
WRITE | oth_sort/h/@.apps/g/state/pet_yankee.txt | room=bridge\nx=8\ny=2\ndir=1\nsteps=1\n
RUN | $T/gpe.+x | $T/oth_sort/h/@.apps/g | $T/oth_sort/sess | --house | $T/oth_sort/h
EXPECT_EXIT | 0 | oth_sort-exit-0
EXPECT_OUT | rows=11 disagreements= | oth_sort.eight-pets-eight-extra-rows
RUN | sh | -c | sed -n "s/^DESK . pet_\([a-z]*\) .*/\1/p" $T/oth_sort/sess/desks/bridge.pdl\p tr "\n" " "
EXPECT_OUT | alpha bravo charlie delta kilo mike yankee zulu | oth_sort.rows-are-sorted-by-id
RUN | $T/gpe.+x | $T/oth_sort/h/@.apps/g | $T/oth_sort/sess | --house | $T/oth_sort/h | --if-changed
EXPECT_OUT | unchanged | oth_sort.a-second-run-writes-nothing
CASE | chain
MKDIR | chain/h/&.widgits
