# snake (Snake): ONE snake on a grid, realtime kind on the shared engine game_core, MODE snake (plan CHUTES-LADDERS-AND-SNAKE-GAME-PLANS-2026-11-09 part B; milestones S0, S1 and S6a below).
# What is BUILT (2026-11-09 realtime spikes: tuning.pdl tick_ms 33..2000, the in-process tick loop, cases snk_tick_*): the deterministic step function as generic code driven by data (head, trail, seeded food, wall solid|wrap, self collision, growth), the inputs-only ledger (turn rows with logical ticks; eat / die / over CONSEQUENCE rows the ticks make and replay must
# remake; ckpt rows every ckpt_every ticks and at the end), the arrow-key tail (codes 1000 to 1003 from the editor's interact_relay.txt read with the driver's OWN byte cursor, no core change). What is NOT built: multi-snake, the page and figures.
# Every number pinned below was OBSERVED in a scratch run on 2026-11-09 before it was written; the small-board scenarios are also SOLVED BY HAND in the labels. Scratch only: nothing here touches a live folder or the live editor.
# Method note: the case copies the app and edits ITS DATA (board size, wall rule, start length): the engine is the same shared binary in every scenario.
RESULTS | ../results/snake.txt
ENV | LC_ALL | C

CASE    | snk_data
SCRATCH |
EXPECT_HAS | $HOUSE/@.apps/snake/rulesets/default/board.pdl | MODE  \p snake | the-step-function-is-chosen-by-DATA
EXPECT_HAS | $HOUSE/@.apps/snake/rulesets/default/board.pdl | BOARD \p cols \p 16 | grid-size-is-data-(16)
EXPECT_HAS | $HOUSE/@.apps/snake/rulesets/default/rules.pdl | walls        \p solid | the-wall-rule-is-data
EXPECT_HAS | $HOUSE/@.apps/snake/rulesets/default/rules.pdl | ckpt_every   \p 64 | checkpoint-every-64-ticks-(the-plan)
EXPECT_HAS | $HOUSE/@.apps/snake/game.pdl | GAME   \p export | and-the-data-studio-exporter-row-is-there
RUN | cp | -r | $HOUSE/@.apps/snake | $T/s_a8
RUN | sed | -i | s/cols \p 16/cols \p 8/ | $T/s_a8/rulesets/default/board.pdl
RUN | sed | -i | s/rows \p 12/rows \p 6/ | $T/s_a8/rulesets/default/board.pdl
RUN | cmp | $HOUSE/@.apps/snake/rulesets/default/board.pdl | $T/s_a8/rulesets/default/board.pdl
EXPECT_EXIT | 1 | vacuity-the-8-by-6-copy-really-differs
RUN | cp | -r | $HOUSE/@.apps/snake | $T/s_bad1
RUN | sed | -i | s/cols \p 16/cols \p 4/ | $T/s_bad1/rulesets/default/board.pdl
RUN | $HOUSE/&.widgits/_shared-lib/ops/+x/game_core.+x | $T/s_bad1 | $T/s_g0 | new | 7
EXPECT_EXIT | 2 | NEGATIVE-a-4-column-grid-is-refused
EXPECT_OUT | BOARD cols and rows are 6 to 32 | and-says-why
RUN | cp | -r | $HOUSE/@.apps/snake | $T/s_bad2
RUN | sed | -i | s/MODE  \p snake/MODE  \p worm/ | $T/s_bad2/rulesets/default/board.pdl
RUN | $HOUSE/&.widgits/_shared-lib/ops/+x/game_core.+x | $T/s_bad2 | $T/s_g0 | new | 7
EXPECT_EXIT | 2 | NEGATIVE-an-unknown-MODE-is-refused
RUN | cp | -r | $HOUSE/@.apps/snake | $T/s_bad3
RUN | sed | -i | s/walls        \p solid/walls        \p sticky/ | $T/s_bad3/rulesets/default/rules.pdl
RUN | $HOUSE/&.widgits/_shared-lib/ops/+x/game_core.+x | $T/s_bad3 | $T/s_g0 | new | 7
EXPECT_EXIT | 2 | NEGATIVE-an-unknown-wall-rule-is-refused
RUN | cp | -r | $HOUSE/@.apps/snake | $T/s_bad4
RUN | sed | -i | s/max_players  \p 1/max_players  \p 2/ | $T/s_bad4/rulesets/default/rules.pdl
RUN | $HOUSE/&.widgits/_shared-lib/ops/+x/game_core.+x | $T/s_bad4 | $T/s_g0 | new | 7
EXPECT_EXIT | 2 | NEGATIVE-two-snakes-are-refused-(multi-snake-is-plan-milestone-S2-not-built)
EXPECT_OUT | exactly one snake | and-says-so
RUN | $HOUSE/&.widgits/_shared-lib/ops/+x/game_core.+x | $HOUSE/@.apps/snake | $T/s_g0 | new | 7
RUN | $HOUSE/&.widgits/_shared-lib/ops/+x/game_core.+x | $HOUSE/@.apps/snake | $T/s_g0 | join | A
RUN | $HOUSE/&.widgits/_shared-lib/ops/+x/game_core.+x | $HOUSE/@.apps/snake | $T/s_g0 | join | B
EXPECT_EXIT | 2 | NEGATIVE-a-second-seat-is-refused-at-the-table
EXPECT_OUT | table is full (1 players) | and-it-says-1
RUN | $HOUSE/&.widgits/_shared-lib/ops/+x/game_core.+x | $HOUSE/@.apps/snake | $T/s_g0 | input | p1 | left
EXPECT_EXIT | 2 | NEGATIVE-the-stub-verb-input-does-not-exist-in-snake-mode-(turn-does)

CASE    | snk_core
# A. hand-solved: an 8 x 6 board, seed 7, a snake of 3 heading right from (4,3); the first food is at (0,2), nowhere near. Head x = 5, 6, 7 after ticks 1-3; tick 4 would be x = 8: a wall. die at tick 4 from cell 7,3, score 0.
MKDIR   | s_gA
RUN | $HOUSE/&.widgits/_shared-lib/ops/+x/game_core.+x | $T/s_a8 | $T/s_gA | new | 7
RUN | $HOUSE/&.widgits/_shared-lib/ops/+x/game_core.+x | $T/s_a8 | $T/s_gA | join | S | human
RUN | $HOUSE/&.widgits/_shared-lib/ops/+x/game_core.+x | $T/s_a8 | $T/s_gA | start
EXPECT_OUT | game started: 1 players | one-snake
RUN | $HOUSE/&.widgits/_shared-lib/ops/+x/game_core.+x | $T/s_a8 | $T/s_gA | status
EXPECT_OUT | SNAKE len=3 grow=0 dir=R score=0 head=4,3 food=0,2 foods=1 | at-the-start-the-head-is-in-the-middle-heading-right-and-the-first-food-is-at-0,2
RUN | $HOUSE/&.widgits/_shared-lib/ops/+x/game_core.+x | $T/s_a8 | $T/s_gA | advance | 3
RUN | $HOUSE/&.widgits/_shared-lib/ops/+x/game_core.+x | $T/s_a8 | $T/s_gA | status
EXPECT_OUT | head=7,3 | HAND-SOLVED-after-3-ticks-the-head-is-at-x=7
EXPECT_OUT | over=0 | still-alive
RUN | $HOUSE/&.widgits/_shared-lib/ops/+x/game_core.+x | $T/s_a8 | $T/s_gA | advance | 1
RUN | $HOUSE/&.widgits/_shared-lib/ops/+x/game_core.+x | $T/s_a8 | $T/s_gA | status
EXPECT_OUT | over=1 | HAND-SOLVED-tick-4-hits-the-wall-and-the-game-is-over
EXPECT_HAS | $T/s_gA/ledger.txt | EVENT\p4\pbank\pdie\pp1\p7,3\pcause=wall | the-die-row-is-a-CONSEQUENCE-row-made-by-the-tick
EXPECT_HAS | $T/s_gA/ledger.txt | EVENT\p4\pbank\pover\p-\p7,3\pwinner=none;ticks=4;score=0;hash=fc21dab834f0c4e3 | and-so-is-over-with-the-final-state-hash
RUN | grep | -c | -F | \pturn\p | $T/s_gA/ledger.txt
EXPECT_OUT_IS | 0 | vacuity-no-turn-row-was-needed-to-go-straight-(no-row-per-tick:-4-ticks-and-the-ledger-has-6-rows)
RUN | $HOUSE/&.widgits/_shared-lib/ops/+x/game_core.+x | $T/s_a8 | $T/s_gA | advance | 1
EXPECT_EXIT | 2 | NEGATIVE-nothing-moves-after-the-game-is-over
# B. hand-solved: seed 3 puts the first food at (6,3), straight ahead: tick 2 eats it. len 3 + 1, score 10, the tail stays put one tick (grow=1), tick 3 shows len 4, tick 4 the wall.
MKDIR   | s_gB
RUN | $HOUSE/&.widgits/_shared-lib/ops/+x/game_core.+x | $T/s_a8 | $T/s_gB | new | 3
RUN | $HOUSE/&.widgits/_shared-lib/ops/+x/game_core.+x | $T/s_a8 | $T/s_gB | join | S | human
RUN | $HOUSE/&.widgits/_shared-lib/ops/+x/game_core.+x | $T/s_a8 | $T/s_gB | start
RUN | $HOUSE/&.widgits/_shared-lib/ops/+x/game_core.+x | $T/s_a8 | $T/s_gB | status
EXPECT_OUT | food=6,3 | the-first-food-for-seed-3-is-at-6,3
RUN | $HOUSE/&.widgits/_shared-lib/ops/+x/game_core.+x | $T/s_a8 | $T/s_gB | advance | 2
EXPECT_HAS | $T/s_gB/ledger.txt | EVENT\p2\pbank\peat\pp1\p6,3\plen=4;score=10;food=6,3;next=4,1 | HAND-SOLVED-tick-2-eats-the-food-at-6,3-and-the-NEXT-food-is-named-in-the-row
RUN | $HOUSE/&.widgits/_shared-lib/ops/+x/game_core.+x | $T/s_a8 | $T/s_gB | status
EXPECT_OUT | SNAKE len=3 grow=1 dir=R score=10 head=6,3 food=4,1 foods=2 | the-snake-grows-over-the-NEXT-tick-(grow=1-pending)-and-the-second-food-is-at-4,1
RUN | $HOUSE/&.widgits/_shared-lib/ops/+x/game_core.+x | $T/s_a8 | $T/s_gB | advance | 1
RUN | $HOUSE/&.widgits/_shared-lib/ops/+x/game_core.+x | $T/s_a8 | $T/s_gB | status
EXPECT_OUT | SNAKE len=4 grow=0 dir=R score=10 head=7,3 | one-tick-later-the-length-is-4
RUN | $HOUSE/&.widgits/_shared-lib/ops/+x/game_core.+x | $T/s_a8 | $T/s_gB | advance | 5
EXPECT_HAS | $T/s_gB/ledger.txt | EVENT\p4\pbank\pdie\pp1\p7,3\pcause=wall | tick-4-the-wall
RUN | $HOUSE/&.widgits/_shared-lib/ops/+x/game_core.+x | $T/s_a8 | $T/s_gB | check
EXPECT_OUT | CHECK ok events=9 | the-invariants-hold
RUN | $HOUSE/&.widgits/_shared-lib/ops/+x/game_core.+x | $T/s_a8 | $T/s_gB | replay
EXPECT_OUT_IS | REPLAY events=9 hash=419c9956ddfafbcd | snk_replay-the-fixed-input-script-gives-the-fixed-score-10-and-the-pinned-state-hash
# C. hand-solved self collision: a snake of 5 on the default 16 x 12 board heading right from (8,6): U at tick 0, L at tick 1, D at tick 2. Cells: (8,5) (7,5) then (7,6), which the body still covers: die cause=self at tick 3 from 7,5.
RUN | cp | -r | $HOUSE/@.apps/snake | $T/s_a16
RUN | sed | -i | s/start_len    \p 3/start_len    \p 5/ | $T/s_a16/rulesets/default/rules.pdl
MKDIR   | s_gC
RUN | $HOUSE/&.widgits/_shared-lib/ops/+x/game_core.+x | $T/s_a16 | $T/s_gC | new | 7
RUN | $HOUSE/&.widgits/_shared-lib/ops/+x/game_core.+x | $T/s_a16 | $T/s_gC | join | S | human
RUN | $HOUSE/&.widgits/_shared-lib/ops/+x/game_core.+x | $T/s_a16 | $T/s_gC | start
RUN | $HOUSE/&.widgits/_shared-lib/ops/+x/game_core.+x | $T/s_a16 | $T/s_gC | turn | p1 | U
RUN | $HOUSE/&.widgits/_shared-lib/ops/+x/game_core.+x | $T/s_a16 | $T/s_gC | advance | 1
RUN | $HOUSE/&.widgits/_shared-lib/ops/+x/game_core.+x | $T/s_a16 | $T/s_gC | turn | p1 | L
RUN | $HOUSE/&.widgits/_shared-lib/ops/+x/game_core.+x | $T/s_a16 | $T/s_gC | advance | 1
RUN | $HOUSE/&.widgits/_shared-lib/ops/+x/game_core.+x | $T/s_a16 | $T/s_gC | turn | p1 | D
RUN | $HOUSE/&.widgits/_shared-lib/ops/+x/game_core.+x | $T/s_a16 | $T/s_gC | advance | 1
EXPECT_HAS | $T/s_gC/ledger.txt | EVENT\p3\pbank\pdie\pp1\p7,5\pcause=self | HAND-SOLVED-the-snake-bites-itself-at-tick-3
RUN | $HOUSE/&.widgits/_shared-lib/ops/+x/game_core.+x | $T/s_a8 | $T/s_gC | replay
EXPECT_EXIT | 1 | NEGATIVE-the-same-ledger-under-the-8x6-board-is-refused-(the-grid-is-in-the-rules-hash)
# the same three turns with a snake of 3 do NOT bite (the tail has left): the control that says the length is what decided it
MKDIR   | s_gC3
RUN | $HOUSE/&.widgits/_shared-lib/ops/+x/game_core.+x | $HOUSE/@.apps/snake | $T/s_gC3 | new | 7
RUN | $HOUSE/&.widgits/_shared-lib/ops/+x/game_core.+x | $HOUSE/@.apps/snake | $T/s_gC3 | join | S | human
RUN | $HOUSE/&.widgits/_shared-lib/ops/+x/game_core.+x | $HOUSE/@.apps/snake | $T/s_gC3 | start
RUN | $HOUSE/&.widgits/_shared-lib/ops/+x/game_core.+x | $HOUSE/@.apps/snake | $T/s_gC3 | turn | p1 | U
RUN | $HOUSE/&.widgits/_shared-lib/ops/+x/game_core.+x | $HOUSE/@.apps/snake | $T/s_gC3 | advance | 1
RUN | $HOUSE/&.widgits/_shared-lib/ops/+x/game_core.+x | $HOUSE/@.apps/snake | $T/s_gC3 | turn | p1 | L
RUN | $HOUSE/&.widgits/_shared-lib/ops/+x/game_core.+x | $HOUSE/@.apps/snake | $T/s_gC3 | advance | 1
RUN | $HOUSE/&.widgits/_shared-lib/ops/+x/game_core.+x | $HOUSE/@.apps/snake | $T/s_gC3 | turn | p1 | D
RUN | $HOUSE/&.widgits/_shared-lib/ops/+x/game_core.+x | $HOUSE/@.apps/snake | $T/s_gC3 | advance | 1
RUN | grep | -c | -F | \pdie\p | $T/s_gC3/ledger.txt
EXPECT_OUT_IS | 0 | a-snake-of-3-making-the-same-turns-is-alive
# D. wrap: the same 4 ticks on the 8 x 6 torus: x = 5 6 7 0, no death
RUN | cp | -r | $T/s_a8 | $T/s_aw
RUN | sed | -i | s/walls        \p solid/walls        \p wrap/ | $T/s_aw/rulesets/default/rules.pdl
RUN | cmp | $T/s_a8/rulesets/default/rules.pdl | $T/s_aw/rulesets/default/rules.pdl
EXPECT_EXIT | 1 | vacuity-the-wrap-copy-really-differs
MKDIR   | s_gD
RUN | $HOUSE/&.widgits/_shared-lib/ops/+x/game_core.+x | $T/s_aw | $T/s_gD | new | 7
RUN | $HOUSE/&.widgits/_shared-lib/ops/+x/game_core.+x | $T/s_aw | $T/s_gD | join | S | human
RUN | $HOUSE/&.widgits/_shared-lib/ops/+x/game_core.+x | $T/s_aw | $T/s_gD | start
RUN | $HOUSE/&.widgits/_shared-lib/ops/+x/game_core.+x | $T/s_aw | $T/s_gD | advance | 4
RUN | $HOUSE/&.widgits/_shared-lib/ops/+x/game_core.+x | $T/s_aw | $T/s_gD | status
EXPECT_OUT | head=0,3 | HAND-SOLVED-on-a-torus-tick-4-wraps-to-x=0-and-lives
EXPECT_OUT | over=0 | alive
# E. refusals append NOTHING
MKDIR   | s_gE
RUN | $HOUSE/&.widgits/_shared-lib/ops/+x/game_core.+x | $T/s_a8 | $T/s_gE | new | 7
RUN | $HOUSE/&.widgits/_shared-lib/ops/+x/game_core.+x | $T/s_a8 | $T/s_gE | join | S | human
RUN | $HOUSE/&.widgits/_shared-lib/ops/+x/game_core.+x | $T/s_a8 | $T/s_gE | start
RUN | $HOUSE/&.widgits/_shared-lib/ops/+x/game_core.+x | $T/s_a8 | $T/s_gE | ledger_hash
CAPTURE | s1
RUN | $HOUSE/&.widgits/_shared-lib/ops/+x/game_core.+x | $T/s_a8 | $T/s_gE | turn | p1 | L
EXPECT_EXIT | 2 | NEGATIVE-a-reversal-into-the-neck-is-refused
EXPECT_OUT | reversal into the neck | and-says-so
RUN | $HOUSE/&.widgits/_shared-lib/ops/+x/game_core.+x | $T/s_a8 | $T/s_gE | turn | p1 | R
EXPECT_EXIT | 2 | NEGATIVE-turning-to-the-way-it-already-heads-is-refused
RUN | $HOUSE/&.widgits/_shared-lib/ops/+x/game_core.+x | $T/s_a8 | $T/s_gE | turn | p1 | X
EXPECT_EXIT | 2 | NEGATIVE-an-unknown-direction
RUN | $HOUSE/&.widgits/_shared-lib/ops/+x/game_core.+x | $T/s_a8 | $T/s_gE | turn | p2 | U
EXPECT_EXIT | 2 | NEGATIVE-an-unknown-player
RUN | $HOUSE/&.widgits/_shared-lib/ops/+x/game_core.+x | $T/s_a8 | $T/s_gE | ledger_hash
EXPECT_OUT_IS | $s1 | the-four-refusals-appended-nothing
RUN | $HOUSE/&.widgits/_shared-lib/ops/+x/game_core.+x | $T/s_a8 | $T/s_gE | turn | p1 | U
RUN | $HOUSE/&.widgits/_shared-lib/ops/+x/game_core.+x | $T/s_a8 | $T/s_gE | turn | p1 | D
EXPECT_EXIT | 2 | NEGATIVE-a-second-turn-in-the-same-tick-is-refused-(it-would-be-a-reversal-through-the-neck)
RUN | $HOUSE/&.widgits/_shared-lib/ops/+x/game_core.+x | $T/s_a8 | $T/s_gE | ledger_hash
RUN | $HOUSE/&.widgits/_shared-lib/ops/+x/game_core.+x | $T/s_a8 | $T/s_gE | ledger_hash
CAPTURE | s2
EXPECT_NE | $s1 | $s2 | vacuity-the-accepted-turn-U-DID-change-the-ledger

CASE    | snk_hand_edit
# every edit below is made on a COPY of a good ledger, proved to differ (cmp exits 1), and must be refused (exit 1) at a row that is named
RUN | cp | $T/s_gB/ledger.txt | $T/s_gB/keep.txt
RUN | $HOUSE/&.widgits/_shared-lib/ops/+x/game_core.+x | $T/s_a8 | $T/s_gB | replay
EXPECT_EXIT | 0 | the-good-ledger-replays
MKDIR   | s_h1
RUN | cp | $T/s_gB/ledger.txt | $T/s_h1/ledger.txt
RUN | sed | -i | s/score=10;food=6,3/score=20;food=6,3/ | $T/s_h1/ledger.txt
RUN | cmp | $T/s_gB/ledger.txt | $T/s_h1/ledger.txt
EXPECT_EXIT | 1 | vacuity-the-score-edit-really-changed-the-file
RUN | $HOUSE/&.widgits/_shared-lib/ops/+x/game_core.+x | $T/s_a8 | $T/s_h1 | replay
EXPECT_EXIT | 1 | NEGATIVE-an-eat-row-with-a-forged-score-is-refused
EXPECT_OUT | ledger line 4: | the-refusal-names-the-row
MKDIR   | s_h2
RUN | cp | $T/s_gB/ledger.txt | $T/s_h2/ledger.txt
RUN | sed | -i | /\peat\p/d | $T/s_h2/ledger.txt
RUN | cmp | $T/s_gB/ledger.txt | $T/s_h2/ledger.txt
EXPECT_EXIT | 1 | vacuity-the-eat-row-is-really-gone
RUN | $HOUSE/&.widgits/_shared-lib/ops/+x/game_core.+x | $T/s_a8 | $T/s_h2 | replay
EXPECT_EXIT | 1 | NEGATIVE-a-DELETED-eat-row-is-refused-(the-tick-made-it-and-no-row-recorded-it)
EXPECT_OUT | that no row recorded | and-says-so
MKDIR   | s_h3
RUN | cp | $T/s_gB/ledger.txt | $T/s_h3/ledger.txt
APPEND  | s_h3/ledger.txt | EVENT|4|bank|eat|p1|7,3|len=5;score=20;food=1,1;next=2,2\n
RUN | $HOUSE/&.widgits/_shared-lib/ops/+x/game_core.+x | $T/s_a8 | $T/s_h3 | replay
EXPECT_EXIT | 1 | NEGATIVE-a-FORGED-eat-row-after-the-end-is-refused
MKDIR   | s_h4
RUN | cp | $T/s_gB/ledger.txt | $T/s_h4/ledger.txt
RUN | sed | -i | s/cause=wall/cause=self/ | $T/s_h4/ledger.txt
RUN | $HOUSE/&.widgits/_shared-lib/ops/+x/game_core.+x | $T/s_a8 | $T/s_h4 | replay
EXPECT_EXIT | 1 | NEGATIVE-a-die-row-with-the-wrong-cause-is-refused
MKDIR   | s_h5
RUN | cp | $T/s_gB/ledger.txt | $T/s_h5/ledger.txt
RUN | sed | -i | s/hash=57bd5f02415e9471/hash=57bd5f02415e9470/ | $T/s_h5/ledger.txt
RUN | $HOUSE/&.widgits/_shared-lib/ops/+x/game_core.+x | $T/s_a8 | $T/s_h5 | replay
EXPECT_EXIT | 1 | NEGATIVE-a-ckpt-row-with-one-digit-of-the-state-hash-changed-is-refused
# an edited INPUT row: the ledger of scenario C (U, L, D) with the L turned into an R
MKDIR   | s_h6
RUN | cp | $T/s_gC/ledger.txt | $T/s_h6/ledger.txt
RUN | sed | -i | s/\pturn\pL\p/\pturn\pR\p/ | $T/s_h6/ledger.txt
RUN | cmp | $T/s_gC/ledger.txt | $T/s_h6/ledger.txt
EXPECT_EXIT | 1 | vacuity-the-turn-edit-really-changed-the-file
RUN | $HOUSE/&.widgits/_shared-lib/ops/+x/game_core.+x | $T/s_a16 | $T/s_h6 | replay
EXPECT_EXIT | 1 | NEGATIVE-a-hand-edited-INPUT-(turn-L-became-turn-R)-is-refused-at-the-next-row-that-does-not-fit
MKDIR   | s_h7
RUN | cp | $T/s_gC/ledger.txt | $T/s_h7/ledger.txt
RUN | sed | -i | s/\pp1\pturn\pD\p/\pp1\pturn\pU\p/ | $T/s_h7/ledger.txt
RUN | $HOUSE/&.widgits/_shared-lib/ops/+x/game_core.+x | $T/s_a16 | $T/s_h7 | replay
EXPECT_EXIT | 1 | NEGATIVE-the-last-turn-edited-D-to-U-is-refused-too-(the-die-row-no-longer-fits)
RUN | $HOUSE/&.widgits/_shared-lib/ops/+x/game_core.+x | $T/s_a16 | $T/s_gC | replay
EXPECT_EXIT | 0 | and-the-untouched-ledger-still-replays
# a turn row written by hand with the numeric key code instead of the letter is not what the engine would have written
MKDIR   | s_h8
RUN | cp | $T/s_gC/ledger.txt | $T/s_h8/ledger.txt
RUN | sed | -i | s/\pturn\pL\p/\pturn\p1000\p/ | $T/s_h8/ledger.txt
RUN | $HOUSE/&.widgits/_shared-lib/ops/+x/game_core.+x | $T/s_a16 | $T/s_h8 | replay
EXPECT_EXIT | 1 | NEGATIVE-the-ledger-stores-L-never-1000-so-a-hand-written-1000-is-refused
# the engine with replay verification OFF (a MUTANT) accepts the forged score: so the refusals above have teeth
RUN | gcc | -std=gnu11 | -Wno-format-truncation | -Wno-misleading-indentation | -O2 | -DGC_MUT_NO_VERIFY | -o | $T/s_mut.+x | $HOUSE/&.widgits/_shared-lib/ops/game_core.c
EXPECT_EXIT | 0 | the-mutant-engine-compiles
RUN | $T/s_mut.+x | $T/s_a8 | $T/s_h1 | replay
EXPECT_EXIT | 0 | MUTANT-with-verification-off-ACCEPTS-the-forged-score
RUN | $HOUSE/&.widgits/_shared-lib/ops/+x/game_core.+x | $T/s_a8 | $T/s_h1 | replay
EXPECT_EXIT | 1 | and-the-real-engine-refuses-the-very-same-file

