CASE    | snk_keys_tail_real_driver
# the REAL driver (what the editor's Play starts) in a scratch editor: it tails state/interact_relay.txt with its OWN cursor, which starts at the END of the file when the driver starts
RUN | cp | -r | $HOUSE/@.apps/snake | $T/s_adrv
RUN | sed | -i | s/walls        \p solid/walls        \p wrap/ | $T/s_adrv/rulesets/default/rules.pdl
