CASE    | snk_keys_tail
# the arrow keys arrive as 1000 left / 1001 right / 1002 up / 1003 down in the editor's state/interact_relay.txt (petslike_core.c header line 34). The verb `keys <file> <offset>` is what the driver does with ITS OWN byte cursor.
WRITE   | s_relay.txt | 1002 100\n
MKDIR   | s_k1
MKDIR   | s_k2
RUN | $HOUSE/&.widgits/_shared-lib/ops/+x/game_core.+x | $HOUSE/@.apps/snake | $T/s_k1 | new | 7
RUN | $HOUSE/&.widgits/_shared-lib/ops/+x/game_core.+x | $HOUSE/@.apps/snake | $T/s_k1 | join | S | human
RUN | $HOUSE/&.widgits/_shared-lib/ops/+x/game_core.+x | $HOUSE/@.apps/snake | $T/s_k1 | start
RUN | $HOUSE/&.widgits/_shared-lib/ops/+x/game_core.+x | $HOUSE/@.apps/snake | $T/s_k2 | new | 7
RUN | $HOUSE/&.widgits/_shared-lib/ops/+x/game_core.+x | $HOUSE/@.apps/snake | $T/s_k2 | join | S | human
RUN | $HOUSE/&.widgits/_shared-lib/ops/+x/game_core.+x | $HOUSE/@.apps/snake | $T/s_k2 | start
RUN | $HOUSE/&.widgits/_shared-lib/ops/+x/game_core.+x | $HOUSE/@.apps/snake | $T/s_k2 | keys | $T/s_relay.txt | 0
EXPECT_OUT_IS | KEYS read=1 applied=1 refused=0 ignored=0 offset=9 tick=0 | POSITIVE-CONTROL-from-byte-0-the-up-arrow-(1002)-in-the-file-IS-read-and-applied
EXPECT_HAS | $T/s_k2/ledger.txt | EVENT\p0\pp1\pturn\pU\p8,6\papplies=0 | as-a-turn-U-row-stamped-with-the-current-tick
RUN | $HOUSE/&.widgits/_shared-lib/ops/+x/game_core.+x | $HOUSE/@.apps/snake | $T/s_k1 | keys | $T/s_relay.txt | 9
EXPECT_OUT_IS | KEYS read=0 applied=0 refused=0 ignored=0 offset=9 tick=0 | NEGATIVE-the-same-line-BEFORE-the-cursor-(byte-9)-is-ignored
RUN | grep | -c | -F | \pturn\p | $T/s_k1/ledger.txt
EXPECT_OUT_IS | 0 | and-no-turn-row-was-written
APPEND  | s_relay.txt | 1003 200\n
RUN | $HOUSE/&.widgits/_shared-lib/ops/+x/game_core.+x | $HOUSE/@.apps/snake | $T/s_k1 | keys | $T/s_relay.txt | 9
EXPECT_OUT_IS | KEYS read=1 applied=1 refused=0 ignored=0 offset=18 tick=0 | a-line-written-AFTER-the-cursor-(down-1003)-is-applied
EXPECT_HAS | $T/s_k1/ledger.txt | EVENT\p0\pp1\pturn\pD\p8,6\papplies=0 | as-turn-D
RUN | $HOUSE/&.widgits/_shared-lib/ops/+x/game_core.+x | $HOUSE/@.apps/snake | $T/s_k1 | advance | 3
APPEND  | s_relay.txt | 1002 300\n
RUN | $HOUSE/&.widgits/_shared-lib/ops/+x/game_core.+x | $HOUSE/@.apps/snake | $T/s_k1 | keys | $T/s_relay.txt | 18
EXPECT_OUT_IS | KEYS read=1 applied=0 refused=1 ignored=0 offset=27 tick=3 | NEGATIVE-up-while-heading-down-is-a-reversal-into-the-neck-and-is-refused
APPEND  | s_relay.txt | 13 400\n1000 500\n
RUN | $HOUSE/&.widgits/_shared-lib/ops/+x/game_core.+x | $HOUSE/@.apps/snake | $T/s_k1 | keys | $T/s_relay.txt | 27
EXPECT_OUT_IS | KEYS read=2 applied=1 refused=0 ignored=1 offset=43 tick=3 | a-key-that-is-not-an-arrow-(13)-is-ignored-and-left-(1000)-turns-at-tick-3
EXPECT_HAS | $T/s_k1/ledger.txt | EVENT\p3\pp1\pturn\pL\p8,9\papplies=3 | THE-HEAD-TURNS-AT-THE-RIGHT-TICK-(3)-from-the-cell-8,9
