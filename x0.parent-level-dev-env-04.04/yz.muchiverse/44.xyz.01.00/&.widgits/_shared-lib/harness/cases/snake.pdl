EXPECT_OUT | TUNING tick_ms=100 source=tuning.pdl | teario-play-ships-the-same-100-ms-(the-generator-template-for-the-realtime-kind)
# determinism: the same game at 33 ms and at 2000 ms is the same ledger bytes (the pace is not a rule), and a ledger made under one replays under the other
MKDIR   | s_gm33
MKDIR   | s_gm2000
RUN | $HOUSE/&.widgits/_shared-lib/ops/+x/game_core.+x | $T/s_tm33 | $T/s_gm33 | new | 7
RUN | $HOUSE/&.widgits/_shared-lib/ops/+x/game_core.+x | $T/s_tm33 | $T/s_gm33 | join | A
RUN | $HOUSE/&.widgits/_shared-lib/ops/+x/game_core.+x | $T/s_tm33 | $T/s_gm33 | start
