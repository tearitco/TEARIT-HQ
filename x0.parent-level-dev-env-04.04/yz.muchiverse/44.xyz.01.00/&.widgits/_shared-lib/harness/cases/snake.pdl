CASE    | snk_tick_ms
# tuning.pdl `TUNE | tick_ms | N` (2026-11-09, BOOK 16.game/REALTIME-SPIKES-HELD-KEYS-TICK-RATE-PICTURE-RATE-2026-11-09.md): milliseconds per logical tick at the normal speed, 33 (30 a second) to 2000; anything else is REFUSED with the reason.
# It is DATA about the window's pace, not a rule: it is not in the rules hash and never in the ledger, so a game replays to the same bytes at 33 ms and at 2000 ms.
EXPECT_HAS | $HOUSE/@.apps/snake/tuning.pdl | TUNE \p tick_ms \p 100 | the-snake-ships-100-ms-per-tick-(10-ticks-a-second)
RUN | $HOUSE/&.widgits/_shared-lib/ops/+x/game_core.+x | $HOUSE/@.apps/snake | $T/s_tg | tuning
EXPECT_EXIT | 0 | the-shipped-tuning-is-accepted
EXPECT_OUT | TUNING tick_ms=100 source=tuning.pdl fast=40 normal=100 slow=250 steps_per_second=10.0 | tick_ms-100-is-parsed-and-the-fast-and-slow-buttons-scale-it-40:100:250
RUN | cp | -r | $HOUSE/@.apps/snake | $T/s_tm33
WRITE   | s_tm33/tuning.pdl | TUNE \p tick_ms \p 33 \p x \p 100\n
RUN | $HOUSE/&.widgits/_shared-lib/ops/+x/game_core.+x | $T/s_tm33 | $T/s_tg | tuning
EXPECT_OUT | TUNING tick_ms=33 source=tuning.pdl fast=33 normal=33 slow=82 steps_per_second=30.3 | 33-ms-is-30-ticks-a-second-and-FAST-is-floored-at-33-(never-faster)
RUN | cp | -r | $HOUSE/@.apps/snake | $T/s_tm2000
WRITE   | s_tm2000/tuning.pdl | TUNE \p tick_ms \p 2000 \p x \p 100\n
RUN | $HOUSE/&.widgits/_shared-lib/ops/+x/game_core.+x | $T/s_tm2000 | $T/s_tg | tuning
EXPECT_OUT | TUNING tick_ms=2000 source=tuning.pdl | 2000-ms-is-the-slowest-accepted
RUN | cp | -r | $HOUSE/@.apps/snake | $T/s_tmnone
RUN | rm | $T/s_tmnone/tuning.pdl
RUN | $HOUSE/&.widgits/_shared-lib/ops/+x/game_core.+x | $T/s_tmnone | $T/s_tg | tuning
EXPECT_OUT | TUNING tick_ms=100 source=default | no-tuning-file-means-the-kind's-default-(realtime-100)
RUN | cp | -r | $HOUSE/@.apps/snake | $T/s_tmb0
WRITE   | s_tmb0/tuning.pdl | TUNE \p tick_ms \p 0 \p x \p 100\n
RUN | $HOUSE/&.widgits/_shared-lib/ops/+x/game_core.+x | $T/s_tmb0 | $T/s_tg | tuning
EXPECT_EXIT | 2 | NEGATIVE-tick_ms-0-is-refused
EXPECT_OUT | tick_ms must be a whole number of milliseconds from 33 (30 steps a second) to 2000, got '0' | and-the-reason-names-the-range-and-the-value
RUN | cp | -r | $HOUSE/@.apps/snake | $T/s_tmb5
WRITE   | s_tmb5/tuning.pdl | TUNE \p tick_ms \p 5 \p x \p 100\n
RUN | $HOUSE/&.widgits/_shared-lib/ops/+x/game_core.+x | $T/s_tmb5 | $T/s_tg | tuning
EXPECT_EXIT | 2 | NEGATIVE-tick_ms-5-(200-a-second)-is-refused
EXPECT_OUT | got '5' | with-its-reason
RUN | cp | -r | $HOUSE/@.apps/snake | $T/s_tmb5000
WRITE   | s_tmb5000/tuning.pdl | TUNE \p tick_ms \p 5000 \p x \p 100\n
RUN | $HOUSE/&.widgits/_shared-lib/ops/+x/game_core.+x | $T/s_tmb5000 | $T/s_tg | tuning
EXPECT_EXIT | 2 | NEGATIVE-tick_ms-5000-is-refused
