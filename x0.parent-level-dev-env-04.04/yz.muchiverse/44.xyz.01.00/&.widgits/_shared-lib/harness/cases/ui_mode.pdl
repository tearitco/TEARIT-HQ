# ui_mode_op (B1 of PROPOSAL-PLAY-MODE-SEATS-AND-GAME-SIDEBARS, 2026-11-07): edit <-> play flips a window's sidebar state keys from layouts.pdl data. Scratch folders only: the live sides.txt is never touched.
# Observed 2026-11-07 with the real @.apps/rpg-edit-hq/layouts.pdl and @.apps/deskopoly/layouts.pdl before any value was pinned here.
RESULTS | ../results/ui_mode.txt
ENV | LC_ALL | C

CASE    | modes
SCRATCH |
WRITE   | sides.txt | side_left=\nside_right=1\nside_pal=1\neditor_note=keep\n
RUN | $HOUSE/&.widgits/_shared-lib/ops/+x/ui_mode_op.+x | $T/sides.txt | --bars | $HOUSE/@.apps/rpg-edit-hq/layouts.pdl | --bars | $HOUSE/@.apps/deskopoly/layouts.pdl | show
EXPECT_OUT_IS | UIMODE edit | a-window-with-no-ui_mode-key-is-in-edit
RUN | $HOUSE/&.widgits/_shared-lib/ops/+x/ui_mode_op.+x | $T/sides.txt | --bars | $HOUSE/@.apps/rpg-edit-hq/layouts.pdl | --bars | $HOUSE/@.apps/deskopoly/layouts.pdl | play
EXPECT_OUT_IS | UIMODE edit->play on=seats off=pets,palettes,chat | play-shows-the-games-bar-and-hides-the-editors
EXPECT_FILE | sides.txt | side_left=\nside_right=\nside_pal=\neditor_note=keep\nside_game_seats=1\nui_mode=play\nmode_edit=\nmode_play=1\n | the-keys-are-1-or-EMPTY-and-a-key-no-bar-declares-is-kept
RUN | cp | $T/sides.txt | $T/sides.before
RUN | $HOUSE/&.widgits/_shared-lib/ops/+x/ui_mode_op.+x | $T/sides.txt | --bars | $HOUSE/@.apps/rpg-edit-hq/layouts.pdl | --bars | $HOUSE/@.apps/deskopoly/layouts.pdl | play
RUN | cmp | $T/sides.txt | $T/sides.before
EXPECT_EXIT | 0 | switching-to-the-mode-you-are-in-changes-nothing
RUN | $HOUSE/&.widgits/_shared-lib/ops/+x/ui_mode_op.+x | $T/sides.txt | --bars | $HOUSE/@.apps/rpg-edit-hq/layouts.pdl | --bars | $HOUSE/@.apps/deskopoly/layouts.pdl | show
EXPECT_OUT_IS | UIMODE play | show-reports-the-mode-and-writes-nothing

# the user hid the palettes in edit, went to play and came back: the editor is exactly as they left it (a round trip)
CASE    | memory
SCRATCH |
WRITE   | sides.txt | side_left=\nside_right=1\nside_pal=\nui_mode=edit\nmode_edit=1\nmode_play=\neditor_note=keep\nside_game_seats=\n
RUN | $HOUSE/&.widgits/_shared-lib/ops/+x/ui_mode_op.+x | $T/sides.txt | --bars | $HOUSE/@.apps/rpg-edit-hq/layouts.pdl | --bars | $HOUSE/@.apps/deskopoly/layouts.pdl | play
RUN | $HOUSE/&.widgits/_shared-lib/ops/+x/ui_mode_op.+x | $T/sides.txt | --bars | $HOUSE/@.apps/rpg-edit-hq/layouts.pdl | --bars | $HOUSE/@.apps/deskopoly/layouts.pdl | edit
EXPECT_OUT_IS | UIMODE play->edit on=chat off=pets,palettes,seats | back-in-edit-the-chat-returns-and-the-hidden-palettes-stay-hidden
EXPECT_FILE | sides.txt | side_left=\nside_right=1\nside_pal=\nui_mode=edit\nmode_edit=1\nmode_play=\neditor_note=keep\nside_game_seats=\n | the-round-trip-restores-the-file-byte-for-byte
EXPECT_HAS | sides_mode_memory.pdl | MEM \p edit \p side_pal \p off | the-memory-file-holds-the-users-choice
EXPECT_HAS | sides_mode_memory.pdl | user PREFERENCE | the-memory-file-says-it-is-a-preference-and-not-game-state
# with no memory the defaults apply: leave a play window with nothing remembered for edit
WRITE   | fresh.txt | ui_mode=play\nside_game_seats=1\n
RUN | $HOUSE/&.widgits/_shared-lib/ops/+x/ui_mode_op.+x | $T/fresh.txt | --memory | $T/nomem.pdl | --bars | $HOUSE/@.apps/rpg-edit-hq/layouts.pdl | --bars | $HOUSE/@.apps/deskopoly/layouts.pdl | edit
EXPECT_OUT_IS | UIMODE play->edit on=palettes,chat off=pets,seats | no-memory-means-the-declared-defaults

# the slot policy is data: bars with the same slot and the same group are exclusive, an empty group stacks freely
CASE    | slots
SCRATCH |
WRITE   | bars.pdl | BAR | a | k_a | left | edit | on | g | first in the group\nBAR | b | k_b | left | edit | on | g | second in the same group\nBAR | c | k_c | left | edit | on |  | no group, stacks freely\nBAR | d | k_d | right | edit | on | g | same group name, other slot, so not exclusive with a\n
WRITE   | sides.txt | ui_mode=play\n
RUN | $HOUSE/&.widgits/_shared-lib/ops/+x/ui_mode_op.+x | $T/sides.txt | --bars | $T/bars.pdl | edit
EXPECT_OUT_IS | UIMODE play->edit on=a,c,d off=b | one-of-an-exclusive-group-wins-a-free-bar-stacks-and-the-same-group-in-another-slot-is-independent

CASE    | refusals
SCRATCH |
WRITE   | sides.txt | ui_mode=edit\n
WRITE   | ok.pdl | BAR | a | k_a | left | edit | on |  | fine\n
RUN | $HOUSE/&.widgits/_shared-lib/ops/+x/ui_mode_op.+x | $T/sides.txt | --bars | $T/ok.pdl | sleep
EXPECT_EXIT | 2 | NEGATIVE-an-unknown-mode-is-refused
WRITE   | b1.pdl | BAR | a | k_a | middle | edit | on |  | x\n
RUN | $HOUSE/&.widgits/_shared-lib/ops/+x/ui_mode_op.+x | $T/sides.txt | --bars | $T/b1.pdl | play
EXPECT_EXIT | 2 | NEGATIVE-a-slot-that-is-not-left-right-top-or-bottom-is-refused
WRITE   | b2.pdl | BAR | a | k_a | left | edit,fly | on |  | x\n
RUN | $HOUSE/&.widgits/_shared-lib/ops/+x/ui_mode_op.+x | $T/sides.txt | --bars | $T/b2.pdl | play
EXPECT_EXIT | 2 | NEGATIVE-a-mode-that-is-not-edit-or-play-is-refused
WRITE   | b3.pdl | BAR | a | k_a | left | edit | on |  | x\nBAR | b | k_a | left | edit | on |  | same key\n
RUN | $HOUSE/&.widgits/_shared-lib/ops/+x/ui_mode_op.+x | $T/sides.txt | --bars | $T/b3.pdl | play
EXPECT_EXIT | 2 | NEGATIVE-two-bars-on-one-key-are-refused
WRITE   | b4.pdl | BAR | a | k_a | left | edit | maybe |  | x\n
RUN | $HOUSE/&.widgits/_shared-lib/ops/+x/ui_mode_op.+x | $T/sides.txt | --bars | $T/b4.pdl | play
EXPECT_EXIT | 2 | NEGATIVE-a-default-that-is-not-on-or-off-is-refused
WRITE   | b5.pdl | BAR | a | k a | left | edit | on |  | x\n
RUN | $HOUSE/&.widgits/_shared-lib/ops/+x/ui_mode_op.+x | $T/sides.txt | --bars | $T/b5.pdl | play
EXPECT_EXIT | 2 | NEGATIVE-a-key-with-a-space-is-refused
RUN | $HOUSE/&.widgits/_shared-lib/ops/+x/ui_mode_op.+x | $T/sides.txt | --bars | $T/missing.pdl | play
EXPECT_EXIT | 2 | NEGATIVE-a-missing-layouts-file-is-refused
RUN | $HOUSE/&.widgits/_shared-lib/ops/+x/ui_mode_op.+x | $T/sides.txt | play | edit
EXPECT_EXIT | 2 | NEGATIVE-no-bars-is-a-usage-error
EXPECT_FILE | sides.txt | ui_mode=edit\n | none-of-the-refusals-touched-sides-txt
