# planet_ball: one formula for every ball page. earth, moon, and mars each
# get a page. solar is the page that holds all three, with gaps so the
# balls do not merge. The earth desk proof stays in earth_moth.pal.
RESULTS | ../results/planet_ball.txt
ENV | LC_ALL | C

CASE | earth
SCRATCH |
RUN | $HOUSE/&.widgits/_shared-lib/harness/ops/+x/planet_ball_op.+x | formula | earth
EXPECT_EXIT | 0 | earth-formula
EXPECT_OUT | FORMULA body=earth R=92 center up=92 dn=92 | earth-radius
EXPECT_OUT | FORMULA outside dist>92 empty | earth-rim
EXPECT_OUT | FORMULA ocean dip=5 | earth-ocean
EXPECT_OUT | FORMULA surface=grass | earth-surface
EXPECT_OUT | FORMULA mc z==surface tile z>=surface-3 dirt else stone | minecraft-stack
EXPECT_OUT | FORMULA slots floor=surface wall=stone | stone-sides

CASE | moon
SCRATCH |
RUN | $HOUSE/&.widgits/_shared-lib/harness/ops/+x/planet_ball_op.+x | formula | moon
EXPECT_EXIT | 0 | moon-formula
EXPECT_OUT | FORMULA body=moon R=25 center up=25 dn=25 | moon-radius
EXPECT_OUT | FORMULA outside dist>25 empty | moon-rim
EXPECT_OUT | FORMULA ocean dip=0 | moon-has-no-ocean
EXPECT_OUT | FORMULA surface=regolith | moon-surface
EXPECT_OUT | FORMULA slots floor=surface wall=stone | stone-sides

CASE | mars
SCRATCH |
RUN | $HOUSE/&.widgits/_shared-lib/harness/ops/+x/planet_ball_op.+x | formula | mars
EXPECT_EXIT | 0 | mars-formula
EXPECT_OUT | FORMULA body=mars R=49 center up=49 dn=49 | mars-radius
EXPECT_OUT | FORMULA outside dist>49 empty | mars-rim
EXPECT_OUT | FORMULA ocean dip=0 | mars-has-no-ocean
EXPECT_OUT | FORMULA surface=dust | mars-surface
EXPECT_OUT | FORMULA slots floor=surface wall=stone | stone-sides

CASE | solar
SCRATCH |
RUN | $HOUSE/&.widgits/_shared-lib/harness/ops/+x/planet_ball_op.+x | formula | solar
EXPECT_EXIT | 0 | solar-formula
EXPECT_OUT | FORMULA solar pages earth moon mars solar | four-pages
EXPECT_OUT | FORMULA solar bodies earth R=92 moon R=25 mars R=49 | three-bodies
EXPECT_OUT | FORMULA solar gap earth-moon 117 | moon-does-not-merge
EXPECT_OUT | FORMULA solar gap earth-mars 141 | mars-does-not-merge

CASE | pages
SCRATCH |
RUN | $HOUSE/@.apps/earth-moth/ops/+x/earth_moth_op.+x | pages | /home/no/Desktop/github/work/NNEST-12.00/#.NNEST_ASSETS/rta-sources/earth-moth/ETOPO5.DAT | /home/no/Desktop/github/work/NNEST-12.00/#.NNEST_ASSETS/mineclonia/mods | $T
EXPECT_EXIT | 0 | three-pages-build
EXPECT_OUT | PAGE | moon-page-named
RUN | grep | -q | -F | 8,6, | $T/moon/cells.txt
EXPECT_EXIT | 0 | moon-is-regolith-on-stone
RUN | grep | -q | -F | 9,6, | $T/mars/cells.txt
EXPECT_EXIT | 0 | mars-is-dust-on-stone
RUN | grep | -q | -F | 2,6, | $T/solar/cells.txt
EXPECT_EXIT | 0 | solar-holds-earth-grass
RUN | grep | -q | -F | 8,6, | $T/solar/cells.txt
EXPECT_EXIT | 0 | solar-holds-the-moon
RUN | grep | -q | -F | 9,6, | $T/solar/cells.txt
EXPECT_EXIT | 0 | solar-holds-mars

CASE | refused
SCRATCH |
RUN | $HOUSE/&.widgits/_shared-lib/harness/ops/+x/planet_ball_op.+x | formula | pluto
EXPECT_EXIT | 2 | NEGATIVE-an-unknown-body-is-refused
RUN | $HOUSE/&.widgits/_shared-lib/harness/ops/+x/planet_ball_op.+x | formula | earth | 40
EXPECT_EXIT | 2 | NEGATIVE-a-body-cannot-pick-its-own-radius
