CASE | a-hand-edited-ledger-is-refused
SCRATCH
RUN | gcc | -std=gnu11 | -Wall | -Wextra | -O2 | -o | $T/map_op.+x | $HOUSE/@.apps/tearit-map/ops/tearit_map_op.c | -lm | -lpng | -lz
RUN | gcc | -std=gnu11 | -Wall | -Wextra | -O2 | -o | $T/civ_op.+x | $HOUSE/@.apps/tearit-map/ops/tearit_civ_op.c
COPY | @.apps/tearit-map/civ.pdl | civ.pdl
ENV | TEARIT_CIV_RULES | $T/civ.pdl
RUN | $T/map_op.+x | gen | 1 | 16 | 16 | $T/h.txt
RUN | $T/civ_op.+x | seat | $T/h.txt | civ1 | human
RUN | $T/civ_op.+x | seat | $T/h.txt | civ2 | agent:basic
RUN | $T/map_op.+x | found | $T/h.txt | $T/h.txt
RUN | $T/civ_op.+x | endturn | $T/h.txt
RUN | $T/civ_op.+x | endturn | $T/h.txt
RUN | $T/map_op.+x | checkpoint | $T/h.txt
EXPECT_EXIT | 0 | a-checkpoint-row-fixes-the-hash
RUN | $T/civ_op.+x | endturn | $T/h.txt
EXPECT_EXIT | 0 | a-true-ledger-passes-the-check-and-takes-a-turn
RUN | cp | $T/h.txt | $T/clean.txt
RUN | cp | $T/clean.txt | $T/bad.txt
RUN | sed | -i | s/FOUND \p \([0-9]*\) \p \([0-9]*\) \p /FOUND \p \2 \p \1 \p /; | $T/bad.txt
RUN | cmp | -s | $T/clean.txt | $T/bad.txt
EXPECT_EXIT | 1 | VACUITY-the-hand-edit-really-changed-the-ledger
RUN | $T/civ_op.+x | endturn | $T/bad.txt
EXPECT_EXIT | 4 | NEGATIVE-a-hand-edited-ledger-is-refused-by-endturn
EXPECT_OUT | fail check | the-reason-is-the-check-row
RUN | grep | -c | ^TURN | $T/bad.txt
EXPECT_OUT | 3 | and-no-turn-row-was-written
RUN | cp | $T/clean.txt | $T/skip.txt
RUN | sed | -i | s/^TURN \p 3$/TURN \p 5/ | $T/skip.txt
RUN | $T/civ_op.+x | status | $T/skip.txt
EXPECT_EXIT | 4 | NEGATIVE-a-TURN-row-out-of-order-is-refused-by-the-fold
RUN | $T/civ_op.+x | endturn | $T/skip.txt
EXPECT_EXIT | 4 | and-endturn-refuses-it-too
CLEAN |
CASE | the-agent-weights-are-data
SCRATCH
RUN | gcc | -std=gnu11 | -Wall | -Wextra | -O2 | -o | $T/map_op.+x | $HOUSE/@.apps/tearit-map/ops/tearit_map_op.c | -lm | -lpng | -lz
RUN | gcc | -std=gnu11 | -Wall | -Wextra | -O2 | -o | $T/civ_op.+x | $HOUSE/@.apps/tearit-map/ops/tearit_civ_op.c
