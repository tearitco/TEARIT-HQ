# tearit_civ.pdl - the Civ shape of the tearit-map book (D136): the turn loop (tearit_civ_op), the seats, the basic agent, and the verb pages (tearit_verb). Scratch ledgers under $T only; the live editor state is never touched.
RESULTS | ../results/tearit_civ.txt
CASE | turn-loop-seats-and-agent
SCRATCH
RUN | gcc | -std=gnu11 | -Wall | -Wextra | -O2 | -o | $T/map_op.+x | $HOUSE/@.apps/tearit-map/ops/tearit_map_op.c | -lm | -lpng | -lz
EXPECT_EXIT | 0 | map op compiles
RUN | gcc | -std=gnu11 | -Wall | -Wextra | -O2 | -o | $T/civ_op.+x | $HOUSE/@.apps/tearit-map/ops/tearit_civ_op.c
EXPECT_EXIT | 0 | civ op compiles
COPY | @.apps/tearit-map/civ.pdl | civ.pdl
ENV | TEARIT_CIV_RULES | $T/civ.pdl
RUN | $T/map_op.+x | gen | 1 | 16 | 16 | $T/l.txt
EXPECT_EXIT | 0 | seed 1 ledger
RUN | $T/civ_op.+x | status | $T/l.txt
EXPECT_OUT | turn=0 cities=0 food=0 ai_cities=0 ai_food=0 civ1=none civ2=none | a fresh ledger is turn 0 with no seats
RUN | $T/civ_op.+x | endturn | $T/l.txt
EXPECT_OUT | aiturn=none | with no seat row the agent plays nothing
RUN | $T/civ_op.+x | seat | $T/l.txt | civ1 | human
EXPECT_EXIT | 0 | civ1 is a human seat row
RUN | $T/civ_op.+x | seat | $T/l.txt | civ2 | agent:basic
EXPECT_EXIT | 0 | civ2 is an agent seat row
RUN | cp | $T/l.txt | $T/seated.txt
EXPECT_EXIT | 0 | ledger saved
RUN | $T/civ_op.+x | seat | $T/l.txt | civ3 | human
EXPECT_EXIT | 2 | NEGATIVE-a-third-civ-is-refused
RUN | $T/civ_op.+x | seat | $T/l.txt | civ2 | robot
EXPECT_EXIT | 2 | NEGATIVE-an-unknown-driver-is-refused
RUN | cmp | -s | $T/l.txt | $T/seated.txt
EXPECT_EXIT | 0 | NEGATIVE-refused-seats-write-nothing
RUN | grep | -c | ^TURN | $T/l.txt
EXPECT_OUT | 1 | exactly-one-TURN-row-so-far-from-the-seatless-endturn
RUN | $T/civ_op.+x | endturn | $T/l.txt
EXPECT_OUT | turn=2 | next-turn-is-turn-2
RUN | grep | -c | ^TURN | $T/l.txt
EXPECT_OUT | 2 | one-endturn-appends-exactly-one-TURN-row
RUN | grep | -c | ^SEAT | $T/l.txt
EXPECT_OUT | 2 | the-seat-rows-are-ledger-rows
RUN | grep | -c | -E | ^(AGENT.*basic\pFOUND.*agent)$ | $T/l.txt
EXPECT_OUT | 1 | the-agent-seat-moved-once-on-its-own-endturn
RUN | $T/civ_op.+x | legal | $T/l.txt
EXPECT_OUT | weight= | the-legal-list-carries-weights
RUN | cp | $T/l.txt | $T/l_before_illegal.txt
EXPECT_EXIT | 0 | ledger saved
RUN | $T/civ_op.+x | agentmove | $T/l.txt | q
EXPECT_EXIT | 4 | NEGATIVE-an-illegal-move-is-refused
EXPECT_OUT | fail illegal | the-refusal-names-the-reason
RUN | $T/civ_op.+x | agentmove | $T/l.txt | found
EXPECT_EXIT | 4 | NEGATIVE-a-second-city-inside-the-gap-is-refused
RUN | cmp | -s | $T/l.txt | $T/l_before_illegal.txt
EXPECT_EXIT | 0 | NEGATIVE-refused-moves-write-nothing
RUN | $T/civ_op.+x | agentmove | $T/l.txt | s
EXPECT_EXIT | 0 | a-legal-step-is-accepted
RUN | cmp | -s | $T/l.txt | $T/l_before_illegal.txt
EXPECT_EXIT | 1 | the-legal-step-wrote-a-row-so-the-control-differs
CLEAN |
