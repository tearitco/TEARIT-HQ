RUN | $T/civ_op.+x | aiturn | $T/w2.txt
EXPECT_EXIT | 2 | NEGATIVE-missing-rules-are-refused-no-weights-live-in-the-C
CLEAN |
# ---- the verb pages are the path (D92, D136, EVENT-VERB-PAGES-DESIGN): a button plays events/<verb>/, the page runs tearit_verb, which calls ONE rule op ----
CASE | verb-pages-are-the-path
SCRATCH |
ENV | BLUEPRINTZ_DEBUG_FILE | /nonexistent
MKDIR | house/xyzfs
MKDIR | house/@.apps/tearit-map/ops/+x
MKDIR | house/@.apps/tearit-map/play/world
RUN | gcc | -std=gnu11 | -Wall | -Wextra | -O2 | -o | $T/house/@.apps/tearit-map/ops/+x/tearit_map_op.+x | $HOUSE/@.apps/tearit-map/ops/tearit_map_op.c | -lm | -lpng | -lz
RUN | gcc | -std=gnu11 | -Wall | -Wextra | -O2 | -o | $T/house/@.apps/tearit-map/ops/+x/tearit_civ_op.+x | $HOUSE/@.apps/tearit-map/ops/tearit_civ_op.c
RUN | gcc | -std=gnu11 | -Wall | -Wextra | -O2 | -o | $T/house/@.apps/tearit-map/ops/+x/tearit_verb.+x | $HOUSE/@.apps/tearit-map/ops/tearit_verb.c
EXPECT_EXIT | 0 | the-verb-engine-compiles-with-no-warning-flags-tripping
COPY | @.apps/tearit-map/civ.pdl | house/@.apps/tearit-map/civ.pdl
COPYDIR | @.apps/tearit-map/events | house/@.apps/tearit-map/events
ENV | TEARIT_CIV_RULES |
ENV | TEARIT_LEDGER | $T/led.txt
RUN | $T/house/@.apps/tearit-map/ops/+x/tearit_map_op.+x | gen | 1 | 16 | 16 | $T/led.txt
EXPECT_EXIT | 0 | seed-1-ledger
EXPECT_HAS | house/@.apps/tearit-map/events/step/event_pkg/pages/page_1/event.ir.pdl | type=tearit_verb \p verb=step | the-step-page-names-the-registered-command
EXPECT_HAS | house/@.apps/tearit-map/events/found/event_pkg/pages/page_1/event.ir.pdl | type=tearit_verb \p verb=found | the-found-page-names-the-registered-command
EXPECT_HAS | house/@.apps/tearit-map/events/eat/event_pkg/pages/page_1/event.ir.pdl | type=tearit_verb \p verb=eat | the-eat-page-names-the-registered-command
EXPECT_HAS | house/@.apps/tearit-map/events/sleep/event_pkg/pages/page_1/event.ir.pdl | type=tearit_verb \p verb=sleep | the-sleep-page-names-the-registered-command
EXPECT_HAS | house/@.apps/tearit-map/events/dig/event_pkg/pages/page_1/event.ir.pdl | type=tearit_verb \p verb=dig | the-dig-page-names-the-registered-command
EXPECT_HAS | house/@.apps/tearit-map/events/place/event_pkg/pages/page_1/event.ir.pdl | type=tearit_verb \p verb=place | the-place-page-names-the-registered-command
EXPECT_HAS | house/@.apps/tearit-map/events/fog/event_pkg/pages/page_1/event.ir.pdl | type=tearit_verb \p verb=fog | the-fog-page-names-the-registered-command
EXPECT_HAS | house/@.apps/tearit-map/events/hut/event_pkg/pages/page_1/event.ir.pdl | type=tearit_verb \p verb=hut | the-hut-page-names-the-registered-command
EXPECT_HAS | house/@.apps/tearit-map/events/endturn/event_pkg/pages/page_1/event.ir.pdl | type=tearit_verb \p verb=endturn | the-endturn-page-names-the-registered-command
EXPECT_HAS | house/@.apps/tearit-map/events/seat/event_pkg/pages/page_1/event.ir.pdl | type=tearit_verb \p verb=seat | the-seat-page-names-the-registered-command
EXPECT_HAS | house/@.apps/tearit-map/events/endturn/event_pkg/pages/page_1/condition.pdl | COND \p trigger \p ui | a-verb-page-has-a-ui-trigger
ENV | GAME_ARG | civ1 human
ENV | MUCHI_TARGET_ENT | $T/house/@.apps/tearit-map/play/world
RUN | /bin/bash | $HOUSE/&.widgits/events-hq/ops/play_event.sh | $T/house/@.apps/tearit-map/events/seat | $T/house | ui
EXPECT_EXIT | 0 | the-seat-page-was-played
EXPECT_HAS | house/@.apps/tearit-map/play/result.txt | ok | the-page-engine-reports-ok
EXPECT_HAS | led.txt | SEAT \p civ1 \p human | the-seat-is-a-ledger-row-written-through-the-page
ENV | GAME_ARG | civ2 agent:basic
RUN | /bin/bash | $HOUSE/&.widgits/events-hq/ops/play_event.sh | $T/house/@.apps/tearit-map/events/seat | $T/house | ui
ENV | GAME_ARG | s
RUN | /bin/bash | $HOUSE/&.widgits/events-hq/ops/play_event.sh | $T/house/@.apps/tearit-map/events/step | $T/house | ui
EXPECT_HAS | led.txt | MOVE \p 4 \p 1 \p s | a-step-page-appended-one-MOVE-row
ENV | GAME_ARG | e
RUN | /bin/bash | $HOUSE/&.widgits/events-hq/ops/play_event.sh | $T/house/@.apps/tearit-map/events/step | $T/house | ui
EXPECT_HAS | house/@.apps/tearit-map/play/result.txt | refused: fail water | a-refused-step-puts-the-rules-reason-on-the-result-file
RUN | grep | -c | ^MOVE | $T/led.txt
EXPECT_OUT | 1 | NEGATIVE-the-refused-step-added-no-row
ENV | GAME_ARG |
RUN | /bin/bash | $HOUSE/&.widgits/events-hq/ops/play_event.sh | $T/house/@.apps/tearit-map/events/found | $T/house | ui
EXPECT_HAS | led.txt | FOUND \p 4 \p 1 | the-found-page-founded-a-city-where-the-person-stands
RUN | /bin/bash | $HOUSE/&.widgits/events-hq/ops/play_event.sh | $T/house/@.apps/tearit-map/events/found | $T/house | ui
EXPECT_HAS | house/@.apps/tearit-map/play/result.txt | refused: fail found | a-second-city-on-that-cell-is-refused-by-the-op-and-reported
RUN | /bin/bash | $HOUSE/&.widgits/events-hq/ops/play_event.sh | $T/house/@.apps/tearit-map/events/endturn | $T/house | ui
EXPECT_HAS | house/@.apps/tearit-map/play/result.txt | ok | the-endturn-page-ran
RUN | grep | -c | ^TURN | $T/led.txt
EXPECT_OUT | 1 | the-endturn-page-appended-exactly-one-TURN-row
RUN | $T/house/@.apps/tearit-map/ops/+x/tearit_civ_op.+x | status | $T/led.txt
EXPECT_OUT | turn=1 cities=1 food=1 | the-fold-shows-one-city-one-food
RUN | /bin/bash | $HOUSE/&.widgits/events-hq/ops/play_event.sh | $T/house/@.apps/tearit-map/events/eat | $T/house | ui
EXPECT_HAS | led.txt | EAT \p 4 \p 1 | the-eat-page-spent-a-ration
RUN | /bin/bash | $HOUSE/&.widgits/events-hq/ops/play_event.sh | $T/house/@.apps/tearit-map/events/fog | $T/house | ui
EXPECT_HAS | house/@.apps/tearit-map/play/result.txt | ok | the-fog-page-ran
EXPECT_FILE | fog.txt | the-fog-preference-file-sits-beside-the-ledger
RUN | $T/house/@.apps/tearit-map/ops/+x/tearit_verb.+x | bogus
EXPECT_EXIT | 2 | NEGATIVE-an-unknown-verb-is-refused-by-the-engine
ENV | GAME_ARG | x
RUN | $T/house/@.apps/tearit-map/ops/+x/tearit_verb.+x | step
EXPECT_EXIT | 2 | NEGATIVE-a-bad-direction-never-reaches-the-op
ENV | GAME_ARG | e'x
RUN | $T/house/@.apps/tearit-map/ops/+x/tearit_verb.+x | step
EXPECT_EXIT | 2 | NEGATIVE-a-quote-in-an-argument-never-reaches-the-op
ENV | GAME_ARG | civ1
RUN | $T/house/@.apps/tearit-map/ops/+x/tearit_verb.+x | seat
EXPECT_EXIT | 2 | NEGATIVE-a-seat-without-who-is-refused
RUN | grep | -c | ^MOVE | $T/led.txt
EXPECT_OUT | 1 | NEGATIVE-none-of-the-refusals-added-a-row
CLEAN |
CASE | the-manifest-covers-every-engine-verb
SCRATCH |
RUN | $HOUSE/&.widgits/events-hq/ops/+x/verbgen.+x | check | $HOUSE/@.apps/tearit-map
EXPECT_EXIT | 0 | verbgen-check-passes-on-the-real-app
EXPECT_OUT | missing-from-manifest 0, not-in-source 0, no-package 0 | ten-engine-verbs-ten-manifest-rows-ten-pages
MKDIR | neg/ops
COPY | @.apps/tearit-map/ops/tearit_verb.c | neg/ops/tearit_verb.c
WRITE | neg/verbs.pdl | GAME \p tearit-map \p tearit_verb \p ops/+x/tearit_verb.+x \p ops/tearit_verb.c\nVERB \p step \p yes \p ui \p dir \p walk\n
RUN | $HOUSE/&.widgits/events-hq/ops/+x/verbgen.+x | check | $T/neg
EXPECT_EXIT | 1 | NEGATIVE-a-manifest-missing-engine-verbs-fails-the-check
CLEAN |
# ---- the REAL tearit_driver in a scratch house (fake owner = a sleeper, fake switches.txt): bar buttons -> queue -> verb engine -> ledger -> status line ----
# NOTE: play_event.sh finds the house from its own location, so a scratch house cannot play a page: here the driver takes its VISIBLE FALLBACK (the same tearit_verb engine, the message says so). The page path itself is the case verb-pages-are-the-path.
CASE | driver-bar-status-and-queue
SCRATCH |
ENV | BLUEPRINTZ_DEBUG_FILE | /nonexistent
ENV | TEARIT_CIV_RULES |
ENV | TEARIT_LEDGER |
ENV | GAME_ARG |
MKDIR | h/xyzfs
MKDIR | h/@.apps/tearit-map/ops/+x
MKDIR | h/@.apps/tearit-map/tearit-map-pchq/pieces/system/maps/tearit-map/board
MKDIR | edit/state/world
WRITE | edit/state/world/switches.txt | running=1\n
COPY | @.apps/tearit-map/civ.pdl | h/@.apps/tearit-map/civ.pdl
COPYDIR | @.apps/tearit-map/events | h/@.apps/tearit-map/events
RUN | gcc | -std=gnu11 | -O2 | -o | $T/h/@.apps/tearit-map/ops/+x/tearit_map_op.+x | $HOUSE/@.apps/tearit-map/ops/tearit_map_op.c | -lm | -lpng | -lz
RUN | gcc | -std=gnu11 | -O2 | -o | $T/h/@.apps/tearit-map/ops/+x/tearit_civ_op.+x | $HOUSE/@.apps/tearit-map/ops/tearit_civ_op.c
RUN | gcc | -std=gnu11 | -O2 | -o | $T/h/@.apps/tearit-map/ops/+x/tearit_verb.+x | $HOUSE/@.apps/tearit-map/ops/tearit_verb.c
RUN | gcc | -std=gnu11 | -O2 | -o | $T/h/@.apps/tearit-map/ops/+x/tearit_ctl.+x | $HOUSE/@.apps/tearit-map/ops/tearit_ctl.c
RUN | gcc | -std=gnu11 | -O2 | -o | $T/h/@.apps/tearit-map/ops/+x/tearit_driver.+x | $HOUSE/@.apps/tearit-map/ops/tearit_driver.c
EXPECT_EXIT | 0 | the-real-driver-compiles
SPAWN | OWN | /usr/bin/sleep | 600
ENV | GAME_OWNER_PID | $OWN
SPAWN | DRV | $T/h/@.apps/tearit-map/ops/+x/tearit_driver.+x | $T/h | $T/h/@.apps/tearit-map | $T/edit
WAIT_HAS | edit/state/game_ui.txt | turn 0 \p cities 0 \p food 0 | 8000 | the-bar-title-is-the-civ-status-line-a-fold-of-the-ledger
EXPECT_ALIVE | $DRV | the-driver-stays-up-while-its-owner-lives
EXPECT_HAS | edit/state/game_ui.txt | gmbar_0_label=Next turn | the-first-button-is-Next-turn
EXPECT_HAS | edit/state/game_ui.txt | gmbar_5_label=Found city | the-bar-has-Found-city
EXPECT_HAS | edit/state/game_ui.txt | gmbar_6_label=Eat | the-bar-has-Eat
EXPECT_HAS | edit/state/game_ui.txt | gmbar_7_label=Sleep | the-bar-has-Sleep
EXPECT_HAS | edit/state/game_ui.txt | gmbar_8_label=Fog | the-bar-has-Fog
EXPECT_HAS | edit/state/game_ui.txt | gmbar_n=9 | nine-bar-buttons
EXPECT_HAS | edit/state/games/tearit-map/game/ledger.txt | SEAT \p civ2 \p agent:basic | the-agent-seat-is-a-ledger-row-written-at-the-first-play
RUN | grep | -c | ^TURN | $T/edit/state/games/tearit-map/game/ledger.txt
