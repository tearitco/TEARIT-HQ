# phone_rpg_edit (2026-11-17; owner: "make sure rpg edit opens as a phone app ... we should explicitly prove/test each"): the rpg-edit PHONE APP (&.hq-apps/app-edit/projects/rpg-edit, op redit_op). SCRATCH house, the REAL redit_op, a STUB editor launcher
# (h/@.apps/rpg-edit-hq/button.sh appends one byte to launched.txt, so a launch is a countable fact) and a stand-in "running editor" process (a sleep whose command line holds the editor board path). The real editor window is never touched.
# Proves: the screen reports the last book:page and "closed"; Open starts the launcher exactly once; with an editor running Open does NOT launch another (control: it did launch when none was running) and the screen says open; a missing launcher is refused;
# the package passes app_check and the layout validator. The live window was opened through a real phone by hand (photo in the design doc); this case guards the logic.
RESULTS | ../results/phone_rpg_edit.txt
ENV | LC_ALL | C

CASE    | setup
SCRATCH |
MKDIR | h/&.hq-apps/plus-phone/instances/p1
MKDIR | h/&.hq-apps/plus-phone/apps
MKDIR | h/@.apps/rpg-edit-hq/state
MKDIR | h/@.apps/rpg-edit-hq/board
RUN | /bin/cp | $HOUSE/&.hq-apps/app-edit/projects/rpg-edit/ops/+x/redit_op.+x | $T/redit_op.+x
EXPECT_EXISTS | redit_op.+x | the-real-op-is-built
WRITE | h/@.apps/rpg-edit-hq/state/last_book.txt | book=centroid\npage=live\n
WRITE | h/@.apps/rpg-edit-hq/button.sh | #!/bin/sh\nprintf x >> $T/launched.txt\n

CASE    | closed
RUN | $T/redit_op.+x | $T/h | pkg | --once | $T/h/&.hq-apps/plus-phone/instances/p1
EXPECT_EXIT | 0 | the-module-publishes-once
EXPECT_HAS | h/&.hq-apps/plus-phone/instances/p1/.hq_manager/ui.txt | last page: centroid : live | the-screen-shows-the-last-book-and-page
EXPECT_HAS | h/&.hq-apps/plus-phone/instances/p1/.hq_manager/ui.txt | editor_open=0 | no-editor-is-running
EXPECT_HAS | h/&.hq-apps/plus-phone/instances/p1/.hq_manager/ui.txt | open the editor | the-button-offers-to-open
EXPECT_HAS | h/&.hq-apps/plus-phone/instances/p1/.hq_manager/ui.txt | window_title=phone | the-window-is-titled-by-the-phone-(plain-name-when-no-phone.txt)

CASE    | open-launches
RUN | $T/redit_op.+x | ui_open | $T/h/&.hq-apps/plus-phone/instances/p1
EXPECT_EXIT | 0 | open-succeeds
RUN | /usr/bin/wc | -c | $T/launched.txt
EXPECT_OUT | 1 $T/launched.txt | the-launcher-ran-exactly-once-CONTROL-for-the-next-case
EXPECT_HAS | h/&.hq-apps/plus-phone/instances/p1/.hq_manager/last.txt | editor was started | the-screen-says-it-started

CASE    | already-open
SPAWN | ED | /bin/sh | -c | sleep 600 | fakeeditor | $T/h/@.apps/rpg-edit-hq/board/pchq-board.xhtpm
RUN | $T/redit_op.+x | $T/h | pkg | --once | $T/h/&.hq-apps/plus-phone/instances/p1
EXPECT_HAS | h/&.hq-apps/plus-phone/instances/p1/.hq_manager/ui.txt | editor_open=1 | a-running-editor-is-seen
EXPECT_HAS | h/&.hq-apps/plus-phone/instances/p1/.hq_manager/ui.txt | editor is open | the-button-says-open
RUN | $T/redit_op.+x | ui_open | $T/h/&.hq-apps/plus-phone/instances/p1
EXPECT_EXIT | 0 | open-while-open-is-not-an-error
RUN | /usr/bin/wc | -c | $T/launched.txt
EXPECT_OUT | 1 $T/launched.txt | NEGATIVE-no-second-launch-while-an-editor-runs
EXPECT_HAS | h/&.hq-apps/plus-phone/instances/p1/.hq_manager/last.txt | already open | the-screen-explains-why

CASE    | missing-launcher
RUN | /bin/rm | -f | $T/h/@.apps/rpg-edit-hq/button.sh
RUN | /usr/bin/pkill | -P | 1 | -f | nothing-matches-this-pattern-xyzzy
RUN | /bin/kill | $ED
RUN | $T/redit_op.+x | ui_open | $T/h/&.hq-apps/plus-phone/instances/p1
EXPECT_EXIT | 2 | a-missing-launcher-is-refused
EXPECT_HAS | h/&.hq-apps/plus-phone/instances/p1/.hq_manager/last.txt | launcher is missing | and-says-so

CASE    | package
RUN | $HOUSE/&.hq-apps/plus-phone/ops/+x/app_check.+x | $HOUSE/&.hq-apps/app-edit/projects/rpg-edit | $HOUSE
EXPECT_OUT | CHECK-OK rpg-edit | the-package-passes-app_check
RUN | $HOUSE/@.apps/layout-studio/ops/+x/layout_check.+x | $HOUSE/&.hq-apps/app-edit/projects/rpg-edit/screens/edit.xhtpm
EXPECT_OUT | 0 error(s), 0 warning(s) | the-screen-passes-the-layout-validator


CASE    | embedded-bridge
WRITE | h/&.hq-apps/plus-phone/instances/p1/phone.txt | # phone.txt\nPHONE \p 3\nPORT \p 41003\nORIENT \p portrait\n
MKDIR | h/&.hq-apps/plus-phone/instances/p1/editor_ui/state
WRITE | h/&.hq-apps/plus-phone/instances/p1/editor_ui/state/ui.txt | bv_session=/x/sessions/1\ncanvas_raw=/x/sessions/1/pieces/display/rgb.raw\nbv_h1=/x/h1.txt\nbv_h2=/x/h2.txt\ninteract_class=interact-active\ninteract_armed=1\ninteract_label=ON\nbook_label=book:centroid\npage_label=page:live\nn_desk_opts=2\nd_0_id=live\nd_0_label=live\nn_file_opts=003\nf_0_label=default\nf_0_verb=load-map\nf_0_arg=default\nf_1_label=Open File Explorer\nf_1_verb=file-hq\nf_1_arg=\nf_2_label=Centroid\nf_2_verb=load-map\nf_2_arg=centroid\n
RUN | $T/redit_op.+x | $T/h | pkg | --once | $T/h/&.hq-apps/plus-phone/instances/p1
EXPECT_EXIT | 0 | the-module-bridges-the-projector-file
EXPECT_HAS | h/&.hq-apps/plus-phone/instances/p1/.hq_manager/ui.txt | window_title=+3 :41003 | the-window-title-is-the-PHONE-name-not-the-app
EXPECT_LACKS | h/&.hq-apps/plus-phone/instances/p1/.hq_manager/ui.txt | window_title=rpg-edit | NEGATIVE-the-app-name-is-not-the-window-title
EXPECT_HAS | h/&.hq-apps/plus-phone/instances/p1/.hq_manager/ui.txt | bv_session=/x/sessions/1 | the-session-passes-through-unchanged
EXPECT_HAS | h/&.hq-apps/plus-phone/instances/p1/.hq_manager/ui.txt | canvas_raw=/x/sessions/1/pieces/display/rgb.raw | the-canvas-passes-through-unchanged
EXPECT_HAS | h/&.hq-apps/plus-phone/instances/p1/.hq_manager/ui.txt | bv_h1=/x/h1.txt | the-In-relay-files-pass-through-unchanged
EXPECT_HAS | h/&.hq-apps/plus-phone/instances/p1/.hq_manager/ui.txt | interact_armed=1 | the-In-armed-flag-passes-through-unchanged
EXPECT_LACKS | h/&.hq-apps/plus-phone/instances/p1/.hq_manager/ui.txt | ed_bv_session= | NEGATIVE-bv_session-is-not-renamed-with-the-ed_-prefix
EXPECT_LACKS | h/&.hq-apps/plus-phone/instances/p1/.hq_manager/ui.txt | ed_canvas_raw= | NEGATIVE-canvas_raw-is-not-renamed-with-the-ed_-prefix
EXPECT_LACKS | h/&.hq-apps/plus-phone/instances/p1/.hq_manager/ui.txt | ed_bv_h1= | NEGATIVE-bv_h1-is-not-renamed-with-the-ed_-prefix
EXPECT_LACKS | h/&.hq-apps/plus-phone/instances/p1/.hq_manager/ui.txt | ed_bv_h2= | NEGATIVE-bv_h2-is-not-renamed-with-the-ed_-prefix
EXPECT_LACKS | h/&.hq-apps/plus-phone/instances/p1/.hq_manager/ui.txt | ed_interact_class= | NEGATIVE-interact_class-is-not-renamed-with-the-ed_-prefix
EXPECT_LACKS | h/&.hq-apps/plus-phone/instances/p1/.hq_manager/ui.txt | ed_interact_armed= | NEGATIVE-interact_armed-is-not-renamed-with-the-ed_-prefix
EXPECT_HAS | h/&.hq-apps/plus-phone/instances/p1/.hq_manager/ui.txt | ed_interact_label=ON | other-projector-vars-get-the-ed_-prefix
EXPECT_HAS | h/&.hq-apps/plus-phone/instances/p1/.hq_manager/ui.txt | ed_d_0_id=live | and-the-page-picker-rows-too
EXPECT_LACKS | h/&.hq-apps/plus-phone/instances/p1/.hq_manager/ui.txt | \nbook_label=book:centroid | NEGATIVE-the-editor-book-label-does-not-overwrite-the-phone-top-bar
EXPECT_HAS | h/&.hq-apps/plus-phone/instances/p1/.hq_manager/ui.txt | ed_n_file_opts=003 | the-book-list-is-bridged
EXPECT_HAS | h/&.hq-apps/plus-phone/instances/p1/.hq_manager/ui.txt | ed_f_2_arg=centroid | a-book-row-keeps-its-load-verb-and-id
EXPECT_HAS | h/&.hq-apps/plus-phone/instances/p1/.hq_manager/ui.txt | ed_f_1_verb=menu | the-File-Explorer-row-is-made-inert
EXPECT_LACKS | h/&.hq-apps/plus-phone/instances/p1/.hq_manager/ui.txt | file-hq | NEGATIVE-no-row-can-start-a-desktop-window-from-the-phone
COPY | &.hq-apps/app-edit/projects/rpg-edit/screens/edit.xhtpm | edit.xhtpm
RUN | /usr/bin/grep | -q | -F | target_id="ed-book" | edit.xhtpm
EXPECT_EXIT | 0 | the-screen-has-a-book-dropdown-like-the-page-one
RUN | /usr/bin/grep | -q | -F | relay="${bv_h1},${bv_h2}" | edit.xhtpm
EXPECT_EXIT | 0 | the-In-tab-declares-the-key-relay
RUN | /usr/bin/grep | -q | -F | class="tab ${interact_class}" | edit.xhtpm
EXPECT_EXIT | 0 | and-takes-its-armed-look-from-the-renderer-var
RUN | /usr/bin/awk | /<canvas / { c = NR } /\$\{PHONE_BARS\}/ { b = NR } /\$\{PHONE_FOOTER\}/ { f = NR } END { exit !(b && c && f && b < c && c < f) } | edit.xhtpm
EXPECT_EXIT | 0 | the-canvas-sits-between-the-phone-top-bar-and-footer

CLEAN   |
