COPY    | @.apps/piececraft-hq/pieces/system/maps/test_walls/desk1/extrusion.pdl | ml_test_walls/pieces/system/maps/test_walls/desk1/extrusion.pdl
COPY    | @.apps/piececraft-hq/pieces/system/maps/test_walls/desk1/map.txt | ml_test_walls/pieces/system/maps/test_walls/desk1/map.txt
COPY    | @.apps/piececraft-hq/pieces/system/maps/test_walls/game.pdl | ml_test_walls/pieces/system/maps/test_walls/game.pdl
