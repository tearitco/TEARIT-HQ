EXPECT_OUT_LACKS | falling back | test_walls-no-fallback-to-flat
# the loaded maps are genuinely different worlds: terraces (extruded) != default
SUMTREE | mlDefault | ml_default/pieces/system/chunks
SUMTREE | mlTerr | ml_test_terraces/pieces/system/chunks
EXPECT_NE | $mlDefault | $mlTerr | terraces-chunks-differ-from-default
# FINDING: test_terraces and test_walls load through the handler path even though maps.pdl does not list them (the registry is a UI list, not a gate)
# unknown map id: the op falls back to flat (empty map_id) instead of failing -> a mistyped CONFIRM_START_MAP silently gives the flat world
MKDIR   | ml_nosuch/pieces/system
ENV     | PRISC_PROJECT_ROOT | $T/ml_nosuch
RUN     | $T/bin/pc_generate_chunk | 7 | 0 | 0 | map:nosuch_map
EXPECT_EXIT | 0 | nosuch-rc-0-silent-fallback
EXPECT_OUT | falling back to flat | nosuch-reports-fallback
ENV     | PRISC_PROJECT_ROOT |
EXPECT_LACKS | ml_nosuch/pieces/world_01/state.txt | map_id=nosuch_map | nosuch-map_id-not-recorded
# SKIP (reason, not a pass): the CONFIRM_START_MAP inbox handler itself (pc_menu_input.c: sets game_state, writes display pin, launches clock daemon + trigger watcher) is NOT exercised: it needs the running manager and spawns daemons. Only the generation argv it builds is run above.
# SKIP (reason, not a pass): no GUI/window check that the loaded level is what a pc-hq window shows.

CLEAN   |
