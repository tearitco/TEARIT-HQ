# phys_field (2026-11-18; owner: Teario-universe, "mario-galaxy style gravity and jumping that all games can reuse", flat level = one field, planets voxel, hop between asteroids): the shared body step
# _shared-lib/phys_field.c (pure, integer Q8, no float) driven by op phys_field_op over SCRATCH scenes. Every pinned number is HAND-COMPUTED from the rules (free fall y = g*n*(n+1)/2; jump rise = sum of the
# impulse speeds); the apex case changes the knob and the prediction changes with it. Replay: the same scene twice gives the same HASH. Sabotage-proven (see the commit message).
RESULTS | ../results/phys_field.txt
ENV | LC_ALL | C

CASE    | setup
SCRATCH |
RUN | /bin/cp | $HOUSE/&.widgits/_shared-lib/ops/+x/phys_field_op.+x | $T/pf
EXPECT_EXISTS | pf | the-real-op-is-built
WRITE | fall.pdl | ROW \p 0 \p ...........\nROW \p 1 \p ...........\nROW \p 2 \p ...........\nROW \p 3 \p ...........\nROW \p 4 \p ...........\nROW \p 5 \p ...........\nROW \p 6 \p ...........\nROW \p 7 \p ...........\nROW \p 8 \p ...........\nROW \p 9 \p ...........\nROW \p 10 \p ...........\nROW \p 11 \p ...........\nROW \p 12 \p ...........\nROW \p 13 \p ...........\nROW \p 14 \p ...........\nROW \p 15 \p ...........\nROW \p 16 \p ...........\nROW \p 17 \p ...........\nROW \p 18 \p ...........\nROW \p 19 \p ...........\nROW \p 20 \p ...........\nROW \p 21 \p ...........\nROW \p 22 \p ...........\nROW \p 23 \p ###########\nFIELD \p 0 \p plane \p 0 1\nBODY \p 512 \p 0 \p 200 \p 200\n
WRITE | land.pdl | ROW \p 0 \p ...........\nROW \p 1 \p ...........\nROW \p 2 \p ...........\nROW \p 3 \p ...........\nROW \p 4 \p ...........\nROW \p 5 \p ...........\nROW \p 6 \p ...........\nROW \p 7 \p ...........\nROW \p 8 \p ...........\nROW \p 9 \p ...........\nROW \p 10 \p ...........\nROW \p 11 \p ...........\nROW \p 12 \p ...........\nROW \p 13 \p ...........\nROW \p 14 \p ...........\nROW \p 15 \p ...........\nROW \p 16 \p ...........\nROW \p 17 \p ...........\nROW \p 18 \p ...........\nROW \p 19 \p ...........\nROW \p 20 \p ...........\nROW \p 21 \p ...........\nROW \p 22 \p ...........\nROW \p 23 \p ###########\nFIELD \p 0 \p plane \p 0 1\nBODY \p 512 \p 4000 \p 200 \p 200\n
WRITE | jump.pdl | ROW \p 0 \p ...........\nROW \p 1 \p ...........\nROW \p 2 \p ...........\nROW \p 3 \p ...........\nROW \p 4 \p ...........\nROW \p 5 \p ...........\nROW \p 6 \p ...........\nROW \p 7 \p ...........\nROW \p 8 \p ...........\nROW \p 9 \p ...........\nROW \p 10 \p ...........\nROW \p 11 \p ...........\nROW \p 12 \p ...........\nROW \p 13 \p ...........\nROW \p 14 \p ...........\nROW \p 15 \p ...........\nROW \p 16 \p ...........\nROW \p 17 \p ...........\nROW \p 18 \p ...........\nROW \p 19 \p ...........\nROW \p 20 \p ...........\nROW \p 21 \p ...........\nROW \p 22 \p ...........\nROW \p 23 \p ###########\nFIELD \p 0 \p plane \p 0 1\nBODY \p 512 \p 5688 \p 200 \p 200\nINPUT \p 1 \p 4\nINPUT \p 2 \p 0\n
WRITE | jump2.pdl | ROW \p 0 \p ...........\nROW \p 1 \p ...........\nROW \p 2 \p ...........\nROW \p 3 \p ...........\nROW \p 4 \p ...........\nROW \p 5 \p ...........\nROW \p 6 \p ...........\nROW \p 7 \p ...........\nROW \p 8 \p ...........\nROW \p 9 \p ...........\nROW \p 10 \p ...........\nROW \p 11 \p ...........\nROW \p 12 \p ...........\nROW \p 13 \p ...........\nROW \p 14 \p ...........\nROW \p 15 \p ...........\nROW \p 16 \p ...........\nROW \p 17 \p ...........\nROW \p 18 \p ...........\nROW \p 19 \p ...........\nROW \p 20 \p ...........\nROW \p 21 \p ...........\nROW \p 22 \p ...........\nROW \p 23 \p ###########\nTUNE \p jump_v \p 300\nFIELD \p 0 \p plane \p 0 1\nBODY \p 512 \p 5688 \p 200 \p 200\nINPUT \p 1 \p 4\nINPUT \p 2 \p 0\n
WRITE | axis.pdl | ROW \p 0 \p ...............\nROW \p 1 \p ...............\nROW \p 2 \p ...............\nROW \p 3 \p ...............\nROW \p 4 \p ...............\nROW \p 5 \p .....#####.....\nROW \p 6 \p .....#####.....\nROW \p 7 \p .....#####.....\nROW \p 8 \p .....#####.....\nROW \p 9 \p .....#####.....\nROW \p 10 \p ...............\nROW \p 11 \p ...............\nROW \p 12 \p ...............\nROW \p 13 \p ...............\nROW \p 14 \p ...............\nFIELD \p 1 \p point \p 1920 1920 \p 3000 \p axis\nBODY \p 2816 \p 1820 \p 200 \p 200\n
WRITE | rad.pdl | ROW \p 0 \p ...............\nROW \p 1 \p ...............\nROW \p 2 \p ...............\nROW \p 3 \p ...............\nROW \p 4 \p ...............\nROW \p 5 \p .....#####.....\nROW \p 6 \p .....#####.....\nROW \p 7 \p .....#####.....\nROW \p 8 \p .....#####.....\nROW \p 9 \p .....#####.....\nROW \p 10 \p ...............\nROW \p 11 \p ...............\nROW \p 12 \p ...............\nROW \p 13 \p ...............\nROW \p 14 \p ...............\nFIELD \p 1 \p point \p 1920 1920 \p 3000 \p radial\nBODY \p 3000 \p 3000 \p 200 \p 200\n
