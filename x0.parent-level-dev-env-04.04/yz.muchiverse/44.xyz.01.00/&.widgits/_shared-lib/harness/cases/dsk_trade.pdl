EXPECT_OUT | p1 offer: id=1;give=prop:8;get=cash:100;round=1 | the-debtor-offers-Sky2-for-100
RUN | $HOUSE/@.apps/deskopoly/ops/+x/deskopoly.+x | $T/app | $T/s11 | accept
EXPECT_OUT | p2 accept: done;give=prop:8;get=cash:100;interest-0;interest-0 | p2-accepts
RUN | $HOUSE/@.apps/deskopoly/ops/+x/deskopoly.+x | $T/app | $T/s11 | status
EXPECT_OUT | phase=debt current=p1 | the-debt-is-still-owed-trading-does-not-pay-it
RUN | $HOUSE/@.apps/deskopoly/ops/+x/deskopoly.+x | $T/app | $T/s11 | pay_debt
EXPECT_OUT | p1 pay_debt: paid-100->bank | and-the-cash-from-the-trade-pays-it
RUN | $HOUSE/@.apps/deskopoly/ops/+x/deskopoly.+x | $T/app | $T/s11 | check
EXPECT_OUT | CHECK ok schema=2 events=185 sum=4500 | conserved
CASE    | buildings
MKDIR   | s12
RUN | /usr/bin/cp | $T/m/ledger.txt | $T/s12/ledger.txt
RUN | /usr/bin/sed | -i | 183,$d | $T/s12/ledger.txt
RUN | $HOUSE/@.apps/deskopoly/ops/+x/deskopoly.+x | $T/app | $T/s12 | offer | p2 | give | prop:3
