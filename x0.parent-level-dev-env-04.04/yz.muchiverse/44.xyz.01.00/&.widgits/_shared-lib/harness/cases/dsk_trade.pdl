EXPECT_OUT | p1 offer: id=1 | POSITIVE-CONTROL-an-unbuilt-tile-of-the-same-owner-IS-allowed

# --- TAMPERING: replay refuses every edit of a finished negotiation (each edit is proven to have changed the file) ---
CASE    | tamper
MKDIR   | t1
RUN | /usr/bin/cp | $T/m/ledger.txt | $T/t1/ledger.txt
RUN | /usr/bin/sed | -i | 301,$d | $T/t1/ledger.txt
RUN | $HOUSE/@.apps/deskopoly/ops/+x/deskopoly.+x | $T/app | $T/t1 | offer | p2 | give | prop:1 | get | cash:30
RUN | $HOUSE/@.apps/deskopoly/ops/+x/deskopoly.+x | $T/app | $T/t1 | accept | as=p2
RUN | $HOUSE/@.apps/deskopoly/ops/+x/deskopoly.+x | $T/app | $T/t1 | status
EXPECT_EXIT | 0 | CONTROL-the-untouched-two-row-trade-replays
MKDIR   | ta
RUN | /usr/bin/cp | $T/t1/ledger.txt | $T/ta/ledger.txt
MKDIR   | tb
RUN | /usr/bin/cp | $T/t1/ledger.txt | $T/tb/ledger.txt
MKDIR   | tc
RUN | /usr/bin/cp | $T/t1/ledger.txt | $T/tc/ledger.txt
MKDIR   | td
RUN | /usr/bin/cp | $T/t1/ledger.txt | $T/td/ledger.txt
RUN | /usr/bin/sed | -i | s/get=cash:30;round=1/get=cash:31;round=1/ | $T/ta/ledger.txt
RUN | /usr/bin/grep | -c | cash:31 | $T/ta/ledger.txt
EXPECT_OUT | 1 | VACUITY-the-offer-price-was-really-edited
RUN | $HOUSE/@.apps/deskopoly/ops/+x/deskopoly.+x | $T/app | $T/ta | status
EXPECT_EXIT | 1 | NEGATIVE-an-edited-offer-no-longer-matches-the-recorded-accept
RUN | /usr/bin/sed | -i | s/interest-3/interest-9/ | $T/tb/ledger.txt
RUN | /usr/bin/grep | -c | interest-9 | $T/tb/ledger.txt
EXPECT_OUT | 1 | VACUITY-the-interest-was-really-edited
RUN | $HOUSE/@.apps/deskopoly/ops/+x/deskopoly.+x | $T/app | $T/tb | status
EXPECT_EXIT | 1 | NEGATIVE-a-forged-interest-is-refused
RUN | /usr/bin/sed | -i | /\pp1\poffer\p/d | $T/tc/ledger.txt
RUN | /usr/bin/grep | -c | \poffer\p | $T/tc/ledger.txt
EXPECT_OUT | 0 | VACUITY-the-offer-row-is-gone
RUN | $HOUSE/@.apps/deskopoly/ops/+x/deskopoly.+x | $T/app | $T/tc | status
EXPECT_EXIT | 1 | NEGATIVE-an-accept-without-its-offer-is-refused
RUN | /usr/bin/sed | -i | s/\pp2\paccept\p/\pp3\paccept\p/ | $T/td/ledger.txt
RUN | /usr/bin/grep | -c | \pp3\paccept\p | $T/td/ledger.txt
EXPECT_OUT | 1 | VACUITY-the-accepting-player-was-really-changed
RUN | $HOUSE/@.apps/deskopoly/ops/+x/deskopoly.+x | $T/app | $T/td | status
EXPECT_EXIT | 1 | NEGATIVE-an-accept-by-someone-other-than-the-addressee-is-refused
MKDIR   | t2
RUN | /usr/bin/cp | $T/m/ledger.txt | $T/t2/ledger.txt
RUN | /usr/bin/sed | -i | 301,$d | $T/t2/ledger.txt
RUN | $HOUSE/@.apps/deskopoly/ops/+x/deskopoly.+x | $T/app | $T/t2 | offer | p2 | give | prop:1+prop:3 | get | -
RUN | /usr/bin/grep | -c | prop:1+prop:3 | $T/t2/ledger.txt
EXPECT_OUT | 1 | VACUITY-the-canonical-form-is-tiles-ascending
RUN | /usr/bin/sed | -i | s/prop:1+prop:3/prop:3+prop:1/ | $T/t2/ledger.txt
RUN | $HOUSE/@.apps/deskopoly/ops/+x/deskopoly.+x | $T/app | $T/t2 | status
EXPECT_EXIT | 1 | NEGATIVE-a-non-canonical-asset-list-is-refused-no-second-spelling-of-one-offer
MKDIR   | t3
RUN | /usr/bin/cp | $T/m/ledger.txt | $T/t3/ledger.txt
RUN | /usr/bin/sed | -i | 301,$d | $T/t3/ledger.txt
RUN | $HOUSE/@.apps/deskopoly/ops/+x/deskopoly.+x | $T/app | $T/t3 | offer | p3 | give | cash:10
RUN | $HOUSE/@.apps/deskopoly/ops/+x/deskopoly.+x | $T/app | $T/t3 | roll
RUN | $HOUSE/@.apps/deskopoly/ops/+x/deskopoly.+x | $T/app | $T/t3 | end_turn
RUN | $HOUSE/@.apps/deskopoly/ops/+x/deskopoly.+x | $T/app | $T/t3 | status
EXPECT_EXIT | 0 | CONTROL-offer-roll-end_turn-expire-replays
RUN | /usr/bin/sed | -i | /\pbank\pexpire\p/d | $T/t3/ledger.txt
RUN | /usr/bin/grep | -c | expire | $T/t3/ledger.txt
EXPECT_OUT | 0 | VACUITY-the-expire-row-is-gone
RUN | $HOUSE/@.apps/deskopoly/ops/+x/deskopoly.+x | $T/app | $T/t3 | check
EXPECT_OUT | FAIL I20 an end_turn left an open offer without its expire row | NEGATIVE-check-finds-the-missing-expire-row
RUN | $HOUSE/@.apps/deskopoly/ops/+x/deskopoly.+x | $T/app | $T/t3 | tick
EXPECT_OUT | an end_turn left an open offer without its expire row | NEGATIVE-and-no-move-is-accepted-on-top-of-it
CLEAN   |
