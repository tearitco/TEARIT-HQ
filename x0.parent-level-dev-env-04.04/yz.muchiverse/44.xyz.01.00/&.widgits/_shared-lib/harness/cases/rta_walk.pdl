WRITE | mb.pdl | BOARD \p rules \p $T/H/@.apps/rta/rules.pdl\nBOARD \p grid \p $T/H/@.apps/rta/road.grid\nBOARD \p life \p $T/H/#.desktop/rta_life_ledger.txt\nBOARD \p desk \p $T/mb/desk\nBOARD \p ui \p $T/mb/ui.txt\nBOARD \p data \p $T/H/@.apps/rta-board/board.pdl\nBOARD \p atlas \p $HOUSE/@.apps/rta-board/atlas.rgba\nBOARD \p entity \p joe\nBOARD \p car \p car\n
