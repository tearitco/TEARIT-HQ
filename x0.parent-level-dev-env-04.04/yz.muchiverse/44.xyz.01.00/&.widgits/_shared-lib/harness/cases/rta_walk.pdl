RUN | $T/H/@.apps/rta/ops/+x/rta_life_op.+x | part | $T/H/@.apps/rta/rules.pdl | $T/s2/l.txt | car | tank | gas | ok:6
RUN | $T/H/@.apps/rta/ops/+x/rta_life_op.+x | part | $T/H/@.apps/rta/rules.pdl | $T/s2/l.txt | car | tires | gas | ok:0
