EXPECT_EXIT | 19 | REAL: south of (0,10) is the road row, and a rules file without R refuses it
RUN | cp | $T/m/orig_life.c | $T/m/m1.c
RUN | sed | -i | s/ \p\p !strchr(glyphs, pl.g\[y\]\[x\])// | $T/m/m1.c
