RUN | cp | $T/m/orig_life.c | $T/m/m2.c
RUN | sed | -i | s/if (s.in_car) { fprintf(stderr, "refused: cannot walk/if (0) { fprintf(stderr, "refused: cannot walk/ | $T/m/m2.c
