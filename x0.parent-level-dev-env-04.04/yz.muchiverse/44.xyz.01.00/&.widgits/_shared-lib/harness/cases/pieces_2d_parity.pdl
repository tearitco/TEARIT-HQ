# 2D view of entity pieces (owner 2026-10-27: everything drawn in 3D must also be in the 2D views). The renderer and the test are COMPILED FROM SOURCE into the scratch dir, so the gate follows the code: bv_2d_piece_test.c
# builds a scratch project (page, xelector, one piece veh_1), runs the renderer and counts pixels in the piece's footprint. POSITIVE = the real renderer; NEGATIVE = the same source built with -DBV_2D_NO_PIECES (the renderer as it
# was before the piece code): the drawing checks must FAIL there, which proves the test can fail.
RESULTS | ../results/pieces_2d_parity.txt
CASE    | build
SCRATCH |
MKDIR | g1
MKDIR | g2
RUN | gcc | -O2 | -w | -I/usr/include/freetype2 | -I/usr/include/libpng16 | -o | $T/r2d_real | $HOUSE/&.widgits/board-viewer/ops/bv_render_2d.c | $HOUSE/&.widgits/board-viewer/ops/bv_cjk_glyph.c | -lfreetype | -lpng16 | -lz | -lm
EXPECT_EXIT | 0 | renderer-builds-from-source
RUN | gcc | -O2 | -w | -DBV_2D_NO_PIECES | -I/usr/include/freetype2 | -I/usr/include/libpng16 | -o | $T/r2d_nopieces | $HOUSE/&.widgits/board-viewer/ops/bv_render_2d.c | $HOUSE/&.widgits/board-viewer/ops/bv_cjk_glyph.c | -lfreetype | -lpng16 | -lz | -lm
EXPECT_EXIT | 0 | negative-fixture-renderer-builds
RUN | gcc | -O2 | -w | -I/usr/include/libpng16 | -o | $T/ptest | $HOUSE/&.widgits/board-viewer/ops/bv_2d_piece_test.c | -lpng16 | -lz
EXPECT_EXIT | 0 | test-program-builds
RUN | gcc | -O2 | -w | -o | $T/menu_input | $HOUSE/&.widgits/board-viewer/ops/bv_menu_input.c | -lm
EXPECT_EXIT | 0 | input-op-builds-from-source
CASE    | positive-real-renderer
ENV | BV2D_INPUT_BIN | $T/menu_input
ENV | BV2D_BIN | $T/r2d_real
RUN | $T/ptest | $T/g1
EXPECT_EXIT | 0 | every-check-of-the-test-holds
EXPECT_OUT | ok  : no piece: no red in the footprint (baseline) | no-piece-no-red-in-the-footprint-baseline
EXPECT_OUT | ok  : a voxel piece of the shown desk is drawn over its footprint (red top) | a-voxel-piece-of-the-shown-desk-is-drawn-over-its-footprint-red-top
EXPECT_OUT | ok  : nothing outside the footprint changed | nothing-outside-the-footprint-changed
EXPECT_OUT | ok  : a piece of another desk is not drawn (same rule as the 3D engine) | a-piece-of-another-desk-is-not-drawn-same-rule-as-the-3d-engine
EXPECT_OUT | ok  : desk=* is drawn on every desk | desk-is-drawn-on-every-desk
EXPECT_OUT | ok  : a tile-faced piece shows its tile picture (both halves) and not the voxel colour | a-tile-faced-piece-shows-its-tile-picture-both-halves-and-not-the-voxe
EXPECT_OUT | ok  : tile-faced: nothing outside the footprint changed | tile-faced-nothing-outside-the-footprint-changed
EXPECT_OUT | ok  : desk picture, no piece: no red | desk-picture-no-piece-no-red
EXPECT_OUT | ok  : desk-picture branch: a piece on the page is drawn | desk-picture-branch-a-piece-on-the-page-is-drawn
EXPECT_OUT | ok  : a piece outside the page is not visible in the main view at fit-page zoom 0 (minimap off here: with it on the piece shows in the minimap) | a-piece-outside-the-page-is-not-visible-in-the-main-view-at-fit-page-z
EXPECT_OUT | ok  : zoom -1 (whole scene) shows the piece that lies outside the page | zoom-1-whole-scene-shows-the-piece-that-lies-outside-the-page
EXPECT_OUT | ok  : zoom -1 with no piece looks exactly like fit-page (no crash, no change) | zoom-1-with-no-piece-looks-exactly-like-fit-page-no-crash-no-change
EXPECT_OUT | ok  : minimap: none when the whole scene is on screen (page only) | minimap-none-when-the-whole-scene-is-on-screen-page-only
EXPECT_OUT | ok  : minimap: shown when a piece lies outside the view (cyan view outline) | minimap-shown-when-a-piece-lies-outside-the-view-cyan-view-outline
EXPECT_OUT | ok  : minimap: gone again at zoom -1 (the whole scene fits) | minimap-gone-again-at-zoom-1-the-whole-scene-fits
EXPECT_OUT | ok  : minimap: VIEW \p view_2d_minimap \p 0 turns it off | minimap-view-view-2d-minimap-0-turns-it-off
EXPECT_OUT | ok  : camera: Shift+D moves the view over to a piece outside the page | camera-shift-d-moves-the-view-over-to-a-piece-outside-the-page
EXPECT_OUT | ok  : camera: the piece was out of view before | camera-the-piece-was-out-of-view-before
EXPECT_OUT | ok  : camera: a far pan is clamped to the scene edge (same frame) | camera-a-far-pan-is-clamped-to-the-scene-edge-same-frame
EXPECT_OUT | ok  : camera: ; deletes the camera file (default view again) | camera-deletes-the-camera-file-default-view-again
EXPECT_OUT | ok  : camera: after ; the default view follows the xelector again (piece out of view) | camera-after-the-default-view-follows-the-xelector-again-piece-out-of-
EXPECT_OUT | ok  : camera: in 3D (render_mode 1) the same keys do not move the 2D camera | camera-in-3d-render-mode-1-the-same-keys-do-not-move-the-2d-camera
EXPECT_OUT | ok  : xelector: drawn green | xelector-drawn-green
EXPECT_OUT | ok  : arrows: the xelector moves inside the view and the CAMERA DOES NOT MOVE | arrows-the-xelector-moves-inside-the-view-and-the-camera-does-not-move
EXPECT_OUT | ok  : arrows: past the edge the camera pans (scrolls by the least amount) and the xelector stays visible | arrows-past-the-edge-the-camera-pans-scrolls-by-the-least-amount-and-t
EXPECT_OUT | ok  : xelector: still visible far past the page (the camera panned after it) | xelector-still-visible-far-past-the-page-the-camera-panned-after-it
EXPECT_OUT | ok  : xelector back where it was: the camera stays where it panned to (not re-centred) | xelector-back-where-it-was-the-camera-stays-where-it-panned-to-not-re-
EXPECT_OUT | ok  : keys: w/a/s/d (here 'd' x3) move the 2D camera | keys-w-a-s-d-here-d-x3-move-the-2d-camera
EXPECT_OUT | ok  : keys: the camera keys did NOT move the xelector | keys-the-camera-keys-did-not-move-the-xelector
EXPECT_OUT | ok  : arrows: the arrow key moves the xelector | arrows-the-arrow-key-moves-the-xelector
EXPECT_OUT | ok  : arrows: ... and the camera did not move | arrows-and-the-camera-did-not-move
EXPECT_OUT | ok  : parallax: none when the desk has no parallax.rgba | parallax-none-when-the-desk-has-no-parallax-rgba
EXPECT_OUT | ok  : parallax: 2D draws the sky from parallax.rgba (the file the 3D engine reads) outside the page | parallax-2d-draws-the-sky-from-parallax-rgba-the-file-the-3d-engine-re
EXPECT_OUT_LACKS | FAIL | no-failed-check
CASE    | negative-renderer-without-pieces
ENV | BV2D_BIN | $T/r2d_nopieces
RUN | $T/ptest | $T/g2
EXPECT_EXIT | 1 | the-test-fails-on-a-renderer-that-ignores-pieces
EXPECT_OUT | FAIL: a voxel piece of the shown desk is drawn over its footprint (red top) | fails-without-piece-code-a-voxel-piece-of-the-shown-desk-is-drawn
EXPECT_OUT | FAIL: desk=* is drawn on every desk | fails-without-piece-code-desk-is-drawn-on-every-desk
EXPECT_OUT | FAIL: a tile-faced piece shows its tile picture (both halves) and not the voxel colour | fails-without-piece-code-a-tile-faced-piece-shows-its-tile-pictur
EXPECT_OUT | FAIL: desk-picture branch: a piece on the page is drawn | fails-without-piece-code-desk-picture-branch-a-piece-on-the-page-
EXPECT_OUT | FAIL: zoom -1 (whole scene) shows the piece that lies outside the page | fails-without-piece-code-zoom-1-whole-scene-shows-the-piece-that-
EXPECT_OUT | FAIL: minimap: shown when a piece lies outside the view (cyan view outline) | fails-without-piece-code-minimap-shown-when-a-piece-lies-outside-
EXPECT_OUT | FAIL: camera: Shift+D moves the view over to a piece outside the page | fails-without-piece-code-camera-shift-d-moves-the-view-over-to-a-
EXPECT_OUT | FAIL: camera: a far pan is clamped to the scene edge (same frame) | fails-without-piece-code-camera-a-far-pan-is-clamped-to-the-scene
EXPECT_OUT | FAIL: parallax: 2D draws the sky from parallax.rgba (the file the 3D engine reads) outside the page | fails-without-piece-code-parallax-2d-draws-the-sky-from-parallax-
CLEAN |
