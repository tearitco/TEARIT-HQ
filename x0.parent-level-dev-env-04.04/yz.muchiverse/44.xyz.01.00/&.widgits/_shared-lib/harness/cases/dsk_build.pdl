# dsk_build: deskopoly classic milestone M6 (spec 4.2, 4.6, 4.7, 6.3): build, sell, mortgage, unmortgage, pay_debt, the supply, net worth, bankruptcy with mortgage interest.
# Method as dsk_jail: one autoplayed 3-pet game (seed 6) is cut as a ledger PREFIX and the next move is driven by hand. Every value was OBSERVED on 2026-11-08.
# VACUITY GUARDS: the base case asserts the game really contains builds, a hotel, sells, mortgages, pay_debt and an interest bankruptcy; net is unchanged by a build and by a mortgage.
# LIMITS: a creditor who cannot pay the 10 percent mortgage interest pays what they have (until M8); stopgap pet policy.
RESULTS | ../results/dsk_build.txt
ENV | LC_ALL | C

CASE    | base
SCRATCH |
COPYDIR | @.apps/deskopoly | app | ops,deskopoly-pchq,state
# M7 (2026-11-08): this case tests the game WITHOUT auctions (RULE auctions=off in its scratch ruleset: a declined tile stays with the bank, exactly the pre-M7 game, so its pinned winners and rounds stay valid). Auctions are tested in dsk_auction.
APPEND  | app/rulesets/classic/rules.pdl | RULE \p auctions \p off\n
MKDIR   | m
RUN | $HOUSE/@.apps/deskopoly/ops/+x/deskopoly.+x | $T/app | $T/m | lobby | classic
RUN | $HOUSE/@.apps/deskopoly/ops/+x/deskopoly.+x | $T/app | $T/m | join | A | pet
RUN | $HOUSE/@.apps/deskopoly/ops/+x/deskopoly.+x | $T/app | $T/m | join | B | pet
RUN | $HOUSE/@.apps/deskopoly/ops/+x/deskopoly.+x | $T/app | $T/m | join | C | pet
RUN | $HOUSE/@.apps/deskopoly/ops/+x/deskopoly.+x | $T/app | $T/m | start | 6
RUN | $HOUSE/@.apps/deskopoly/ops/+x/deskopoly.+x | $T/app | $T/m | autoplay
EXPECT_OUT | AUTOPLAY events=527 rounds=74 over=1 winner=p1 | the-base-game-with-buildings-ends-with-a-winner
RUN | $HOUSE/@.apps/deskopoly/ops/+x/deskopoly.+x | $T/app | $T/m | check
EXPECT_OUT | CHECK ok schema=2 events=527 sum=4500 | invariants-I5-to-I8-hold-over-the-whole-game
RUN | /usr/bin/grep | -cF | \pbuild\p | $T/m/ledger.txt
EXPECT_OUT_IS | 42 | the-game-really-contains-42-builds
RUN | /usr/bin/grep | -cF | hotel;cost | $T/m/ledger.txt
EXPECT_OUT_IS | 9 | and-9-hotels
RUN | /usr/bin/grep | -cF | \psell\p | $T/m/ledger.txt
EXPECT_OUT_IS | 2 | and-2-sells
RUN | /usr/bin/grep | -cF | \pmortgage\p | $T/m/ledger.txt
EXPECT_OUT_IS | 11 | and-11-mortgages
RUN | /usr/bin/grep | -cF | \punmortgage\p | $T/m/ledger.txt
EXPECT_OUT_IS | 2 | and-2-unmortgages
RUN | /usr/bin/grep | -cF | \ppay_debt\p | $T/m/ledger.txt
EXPECT_OUT_IS | 7 | and-7-debts-paid-after-raising-cash
RUN | /usr/bin/grep | -c | interest= | $T/m/ledger.txt
EXPECT_OUT_IS | 2 | and-both-bankruptcies-carried-mortgage-interest

CASE    | build
SCRATCH |
COPYDIR | @.apps/deskopoly | app | ops,deskopoly-pchq,state
APPEND  | app/rulesets/classic/rules.pdl | RULE \p auctions \p off\n
MKDIR   | m
MKDIR   | p
RUN | $HOUSE/@.apps/deskopoly/ops/+x/deskopoly.+x | $T/app | $T/m | lobby | classic
RUN | $HOUSE/@.apps/deskopoly/ops/+x/deskopoly.+x | $T/app | $T/m | join | A | pet
RUN | $HOUSE/@.apps/deskopoly/ops/+x/deskopoly.+x | $T/app | $T/m | join | B | pet
RUN | $HOUSE/@.apps/deskopoly/ops/+x/deskopoly.+x | $T/app | $T/m | join | C | pet
RUN | $HOUSE/@.apps/deskopoly/ops/+x/deskopoly.+x | $T/app | $T/m | start | 6
RUN | $HOUSE/@.apps/deskopoly/ops/+x/deskopoly.+x | $T/app | $T/m | autoplay
RUN | /usr/bin/cp | $T/m/ledger.txt | $T/p/ledger.txt
RUN | /usr/bin/sed | -i | 83,$d | $T/p/ledger.txt
RUN | $HOUSE/@.apps/deskopoly/ops/+x/deskopoly.+x | $T/app | $T/p | status
EXPECT_OUT | cash=662 pos=3 out=0 jail=0 cards=- net=1782 | before-any-build-p1-holds-both-browns-cash-662-net-1782
RUN | $HOUSE/@.apps/deskopoly/ops/+x/deskopoly.+x | $T/app | $T/p | build | Brown1
EXPECT_OUT | p1 build: houses=1;cost=50 | a-house-on-the-first-brown
RUN | $HOUSE/@.apps/deskopoly/ops/+x/deskopoly.+x | $T/app | $T/p | status
EXPECT_OUT | cash=612 pos=3 out=0 jail=0 cards=- net=1782 | a-build-moves-50-from-cash-into-the-building-so-net-worth-is-unchanged
EXPECT_OUT | TILE 1 Brown1 owner=p1 houses=1 | the-status-shows-the-house
RUN | $HOUSE/@.apps/deskopoly/ops/+x/deskopoly.+x | $T/app | $T/p | build | Brown1
EXPECT_EXIT | 2 | NEGATIVE-a-second-house-on-the-same-street-before-the-other-has-one-is-refused
EXPECT_OUT | build evenly | NEGATIVE-the-even-rule-is-named
RUN | $HOUSE/@.apps/deskopoly/ops/+x/deskopoly.+x | $T/app | $T/p | build | Sky1
EXPECT_EXIT | 2 | NEGATIVE-building-on-a-tile-you-do-not-own-is-refused
RUN | $HOUSE/@.apps/deskopoly/ops/+x/deskopoly.+x | $T/app | $T/p | build | nosuch
EXPECT_EXIT | 2 | NEGATIVE-an-unknown-tile-name-is-refused
RUN | $HOUSE/@.apps/deskopoly/ops/+x/deskopoly.+x | $T/app | $T/p | build | Brown2 | as=p2
EXPECT_EXIT | 2 | NEGATIVE-building-as-another-player-is-refused
RUN | $HOUSE/@.apps/deskopoly/ops/+x/deskopoly.+x | $T/app | $T/p | mortgage | Brown2
EXPECT_EXIT | 2 | NEGATIVE-mortgaging-a-street-whose-colour-has-a-building-is-refused
EXPECT_OUT | sell the buildings of that colour first | NEGATIVE-says-why
RUN | $HOUSE/@.apps/deskopoly/ops/+x/deskopoly.+x | $T/app | $T/p | sell | Brown1
EXPECT_OUT | p1 sell: houses=0;get=25 | selling-returns-half-the-cost
RUN | $HOUSE/@.apps/deskopoly/ops/+x/deskopoly.+x | $T/app | $T/p | status
EXPECT_OUT | cash=637 pos=3 out=0 jail=0 cards=- net=1757 | selling-lowers-net-worth-by-the-25-lost
RUN | $HOUSE/@.apps/deskopoly/ops/+x/deskopoly.+x | $T/app | $T/p | sell | Brown1
EXPECT_EXIT | 2 | NEGATIVE-selling-with-no-building-is-refused
RUN | $HOUSE/@.apps/deskopoly/ops/+x/deskopoly.+x | $T/app | $T/p | mortgage | Brown1
EXPECT_OUT | p1 mortgage: mortgaged;get=30 | a-mortgage-pays-half-the-price
RUN | $HOUSE/@.apps/deskopoly/ops/+x/deskopoly.+x | $T/app | $T/p | status
EXPECT_OUT | cash=667 pos=3 out=0 jail=0 cards=- net=1757 | a-mortgage-does-not-change-net-worth-cash-up-tile-value-down
EXPECT_OUT | TILE 1 Brown1 owner=p1 mort=1 | the-status-shows-the-mortgage
RUN | $HOUSE/@.apps/deskopoly/ops/+x/deskopoly.+x | $T/app | $T/p | mortgage | Brown1
EXPECT_EXIT | 2 | NEGATIVE-mortgaging-twice-is-refused
RUN | $HOUSE/@.apps/deskopoly/ops/+x/deskopoly.+x | $T/app | $T/p | build | Brown2
EXPECT_EXIT | 2 | NEGATIVE-building-in-a-colour-with-a-mortgaged-tile-is-refused
RUN | $HOUSE/@.apps/deskopoly/ops/+x/deskopoly.+x | $T/app | $T/p | unmortgage | Brown1
EXPECT_OUT | p1 unmortgage: lifted;pay=33 | lifting-costs-the-30-plus-10-percent-rounded-up-33
RUN | $HOUSE/@.apps/deskopoly/ops/+x/deskopoly.+x | $T/app | $T/p | unmortgage | Brown1
EXPECT_EXIT | 2 | NEGATIVE-lifting-a-tile-that-is-not-mortgaged-is-refused
RUN | $HOUSE/@.apps/deskopoly/ops/+x/deskopoly.+x | $T/app | $T/p | check
EXPECT_OUT | CHECK ok | invariants-after-build-sell-mortgage-unmortgage

