EXPECT_EXIT | 2 | NEGATIVE-no-roll-while-in-debt
RUN | $HOUSE/@.apps/deskopoly/ops/+x/deskopoly.+x | $T/app | $T/p | sell | Brown1
EXPECT_OUT | houses=4;get=25 | selling-the-hotel-raises-cash-in-debt
