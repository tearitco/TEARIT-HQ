RUN | $HOUSE/@.apps/deskopoly/ops/+x/deskopoly.+x | $T/app | $T/p | bankrupt
EXPECT_OUT | p2 bankrupt: out;cash=56;props=7;cards=0;interest=18 | to-a-player-with-seven-tiles-and-18-mortgage-interest
RUN | $HOUSE/@.apps/deskopoly/ops/+x/deskopoly.+x | $T/app | $T/p | status
EXPECT_OUT | TILE 5 Line1 owner=p1 mort=1 | a-mortgaged-tile-stays-mortgaged-in-the-creditors-hands
EXPECT_OUT | out=1 jail=0 cards=- net=0 | the-bankrupt-player-holds-nothing
EXPECT_OUT_LACKS | owner=p2 | no-tile-stays-with-the-bankrupt-player
RUN | $HOUSE/@.apps/deskopoly/ops/+x/deskopoly.+x | $T/app | $T/p | check
EXPECT_OUT | CHECK ok schema=2 events=387 sum=4500 | money-conserved-through-sales-and-interest
CASE    | scarce
SCRATCH |
COPYDIR | @.apps/deskopoly | app | ops,deskopoly-pchq,state
APPEND  | app/rulesets/classic/rules.pdl | RULE \p auctions \p off\n
COPYDIR | @.apps/deskopoly/rulesets/classic | app/rulesets/scarce
APPEND  | app/rulesets/scarce/rules.pdl | RULE \p auctions \p off\n
RUN | /usr/bin/sed | -i | s/houses_total  \p 32/houses_total  \p 4 / | $T/app/rulesets/scarce/rules.pdl
RUN | /usr/bin/sed | -i | s/hotels_total  \p 12/hotels_total  \p 1 / | $T/app/rulesets/scarce/rules.pdl
MKDIR   | m
MKDIR   | p
RUN | $HOUSE/@.apps/deskopoly/ops/+x/deskopoly.+x | $T/app | $T/m | lobby | scarce
RUN | $HOUSE/@.apps/deskopoly/ops/+x/deskopoly.+x | $T/app | $T/m | join | A | pet
RUN | $HOUSE/@.apps/deskopoly/ops/+x/deskopoly.+x | $T/app | $T/m | join | B | pet
RUN | $HOUSE/@.apps/deskopoly/ops/+x/deskopoly.+x | $T/app | $T/m | join | C | pet
RUN | $HOUSE/@.apps/deskopoly/ops/+x/deskopoly.+x | $T/app | $T/m | start | 6
RUN | $HOUSE/@.apps/deskopoly/ops/+x/deskopoly.+x | $T/app | $T/m | autoplay
EXPECT_OUT | over=1 stalemate=p2 | with-4-houses-and-1-hotel-nobody-can-build-much-so-the-game-runs-to-the-cap
RUN | $HOUSE/@.apps/deskopoly/ops/+x/deskopoly.+x | $T/app | $T/m | check
EXPECT_OUT | CHECK ok schema=2 events=2656 sum=4500 | the-supply-invariant-holds-at-the-scarce-limits
RUN | /usr/bin/cp | $T/m/ledger.txt | $T/p/ledger.txt
RUN | /usr/bin/sed | -i | 87,$d | $T/p/ledger.txt
RUN | $HOUSE/@.apps/deskopoly/ops/+x/deskopoly.+x | $T/app | $T/p | build | 1
EXPECT_EXIT | 2 | NEGATIVE-the-fifth-house-is-refused-when-the-bank-has-only-four
EXPECT_OUT | no houses left in the bank | NEGATIVE-says-why
RUN | $HOUSE/@.apps/deskopoly/ops/+x/deskopoly.+x | $T/app | $T/p | build | 3
EXPECT_EXIT | 2 | NEGATIVE-the-other-street-too
