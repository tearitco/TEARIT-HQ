EXPECT_OUT | houses=3;get=25 | and-again
RUN | $HOUSE/@.apps/deskopoly/ops/+x/deskopoly.+x | $T/app | $T/p | pay_debt
EXPECT_OUT | p1 pay_debt: paid-100->bank | now-the-cash-covers-the-debt
RUN | $HOUSE/@.apps/deskopoly/ops/+x/deskopoly.+x | $T/app | $T/p | end_turn
EXPECT_OUT | next=p2;round=11 | and-the-turn-ends-normally

