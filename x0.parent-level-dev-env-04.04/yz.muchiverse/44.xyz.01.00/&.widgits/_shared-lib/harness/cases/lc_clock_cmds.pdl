RUN | $T/lc.+x | $T | cmd | g1 | rate | bogus
RUN | $T/lc.+x | $T | step | 0
RUN | /usr/bin/grep | -c | . | $T/#.desktop/clocks/clock_audit.txt
EXPECT_OUT_IS | 5 | every-accepted-and-refused-command-adds-exactly-one-row
RUN | /usr/bin/head | -n | 1 | $T/#.desktop/clocks/clock_audit.txt
CAPTURE | first2
EXPECT_EQ | $first | $first2 | audit-first-row-never-rewritten
RUN | /usr/bin/tail | -n | 1 | $T/#.desktop/clocks/clock_audit.txt
EXPECT_OUT | \pg1\prate\pbogus\prefused:bad-rate\pctl | audit-rows-in-command-order-last-is-last
CLEAN |
