# lc_clock_cmds (CLOCK-AS-THE-PLAY-SPINE-DESIGN.md 3.1 + 3.4 + 7.1): clock commands through the mailbox (rate, pause, resume, advance, settime) under per-clock
# limits with an append-only audit, chained + master clocks, legacy clocks unchanged. Scratch roots only (no popup, harness event runner). A command only queues a
# mailbox row; the clock changes on the next `step` pass (the daemon is the sole writer). Rate scale: hour = real time (1 game ms per real ms), min = x60, x<n> = n.
RESULTS | ../results/lc_clock_cmds.txt
ENV     | LC_CLOCK_NO_POPUP | 1
ENV     | LC_CLOCK_EVENT_RUNNER | /usr/bin/true
CASE    | rate
SCRATCH |
COPY    | &.widgits/livedesk-clock/ops/+x/lc_clock.+x | lc.+x
RUN | $T/lc.+x | $T | new | g1
RUN | $T/lc.+x | $T | rate | g1 | min
RUN | $T/lc.+x | $T | step | 1000
RUN | $T/lc.+x | $T | list
EXPECT_OUT | g1\puser\pmin\p1\p60000\p | min-rate-1s-is-60s
RUN | $T/lc.+x | $T | cmd | g1 | rate | hour
EXPECT_EXIT | 0 | cmd-queued-rc0
RUN | $T/lc.+x | $T | list
EXPECT_OUT | g1\puser\pmin\p1\p60000\p | queued-cmd-changes-nothing-until-the-daemon-pass
RUN | $T/lc.+x | $T | step | 0
RUN | $T/lc.+x | $T | step | 1000
RUN | $T/lc.+x | $T | list
EXPECT_OUT | g1\puser\phour\p1\p61000\p | rate-hour-advances-1s-for-1s
RUN | $T/lc.+x | $T | cmd | g1 | rate | x2.5
RUN | $T/lc.+x | $T | step | 0
RUN | $T/lc.+x | $T | step | 1000
RUN | $T/lc.+x | $T | list
EXPECT_OUT | g1\puser\px2.5\p1\p63500\p | rate-x2.5-advances-2.5s
RUN | $T/lc.+x | $T | cmd | g1 | rate | off
RUN | $T/lc.+x | $T | step | 0
RUN | $T/lc.+x | $T | step | 5000
RUN | $T/lc.+x | $T | list
EXPECT_OUT | g1\puser\poff\p1\p63500\p | rate-off-freezes
EXPECT_HAS | #.desktop/clocks/clock_audit.txt | \pg1\prate\px2.5\pok\pctl | audit-rate-ok-row
CLEAN |
CASE    | pause-resume
SCRATCH |
COPY    | &.widgits/livedesk-clock/ops/+x/lc_clock.+x | lc.+x
RUN | $T/lc.+x | $T | new | g1
RUN | $T/lc.+x | $T | cmd | g1 | rate | x2
RUN | $T/lc.+x | $T | cmd | g1 | pause
RUN | $T/lc.+x | $T | step | 0
RUN | $T/lc.+x | $T | step | 5000
RUN | $T/lc.+x | $T | list
EXPECT_OUT | g1\puser\px2\p0\p0\p | pause-freezes-at-0
RUN | $T/lc.+x | $T | cmd | g1 | resume
RUN | $T/lc.+x | $T | step | 0
RUN | $T/lc.+x | $T | step | 1000
RUN | $T/lc.+x | $T | list
EXPECT_OUT | g1\puser\px2\p1\p2000\p | resume-runs-again-at-x2
RUN | $T/lc.+x | $T | cmd | g1 | pause
RUN | $T/lc.+x | $T | step | 0
RUN | $T/lc.+x | $T | cmd | g1 | advance | 5000
RUN | $T/lc.+x | $T | step | 9000
RUN | $T/lc.+x | $T | list
EXPECT_OUT | g1\puser\px2\p0\p7000\p | paused-clock-still-obeys-advance-but-not-the-ticker
CLEAN |
CASE    | advance-catchup
SCRATCH |
COPY    | &.widgits/livedesk-clock/ops/+x/lc_clock.+x | lc.+x
RUN | $T/lc.+x | $T | new | g1
RUN | $T/lc.+x | $T | reminder-add | g1 | 86400000 |  | d | every:1day
RUN | $T/lc.+x | $T | cmd | g1 | advance | 3d
RUN | $T/lc.+x | $T | list
EXPECT_OUT | g1\puser\poff\p1\p0\p | advance-is-queued-not-applied-by-the-sender
RUN | $T/lc.+x | $T | step | 0
RUN | $T/lc.+x | $T | list
EXPECT_OUT | g1\puser\poff\p1\p259200000\p | advance-3d-jumps
RUN | $T/lc.+x | $T | sched-count | r1
EXPECT_OUT_IS | 3 | catch-up-fires-the-3-skipped-days
RUN | $T/lc.+x | $T | cmd | g1 | advance | 86400000
RUN | $T/lc.+x | $T | step | 0
RUN | $T/lc.+x | $T | sched-count | r1
EXPECT_OUT_IS | 4 | plain-ms-amount-fires-day-4-once
RUN | $T/lc.+x | $T | cmd | g1 | advance | 0
RUN | $T/lc.+x | $T | cmd | g1 | advance | -86400000
RUN | $T/lc.+x | $T | cmd | g1 | advance | 3parsecs
RUN | $T/lc.+x | $T | step | 0
RUN | $T/lc.+x | $T | list
EXPECT_OUT | g1\puser\poff\p1\p345600000\p | zero-negative-and-garbage-advance-change-nothing
EXPECT_HAS | #.desktop/clocks/clock_audit.txt | \pg1\padvance\p-86400000\prefused:non-positive\p | negative-advance-audited-refused
EXPECT_HAS | #.desktop/clocks/clock_audit.txt | \pg1\padvance\p3parsecs\prefused:bad-amount\p | garbage-advance-audited-refused
CLEAN |
CASE    | settime-back
SCRATCH |
COPY    | &.widgits/livedesk-clock/ops/+x/lc_clock.+x | lc.+x
RUN | $T/lc.+x | $T | new | g1
