EXPECT_OUT_IS | 3 | refused-settime-fired-nothing
RUN | $T/lc.+x | $T | cmd | g1 | settime | 864000000
RUN | $T/lc.+x | $T | step | 0
RUN | $T/lc.+x | $T | list
EXPECT_OUT | g1\puser\poff\p1\p864000000\p | settime-forward-ok
RUN | $T/lc.+x | $T | sched-count | r1
EXPECT_OUT_IS | 10 | settime-forward-catches-up-days-4-to-10
