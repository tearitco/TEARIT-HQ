CASE    | chain-nested-and-unchain
SCRATCH |
COPY    | &.widgits/livedesk-clock/ops/+x/lc_clock.+x | lc.+x
RUN | $T/lc.+x | $T | new | a
RUN | $T/lc.+x | $T | new | b
RUN | $T/lc.+x | $T | new | c
RUN | $T/lc.+x | $T | cmd | a | advance | 100
RUN | $T/lc.+x | $T | step | 0
RUN | $T/lc.+x | $T | chain | b | a | 3
RUN | $T/lc.+x | $T | chain | c | b | 2
RUN | $T/lc.+x | $T | cmd | a | advance | 1000
RUN | $T/lc.+x | $T | step | 0
RUN | $T/lc.+x | $T | list
EXPECT_OUT | a\puser\poff\p1\p1100\p | grandparent
EXPECT_OUT | b\puser\poff\p1\p3000\p | chaining-keeps-the-childs-own-epoch-then-follows-x3
EXPECT_OUT | c\puser\poff\p1\p6000\p | grandchild-follows-x3-x2
RUN | $T/lc.+x | $T | chain | a | c | 1
EXPECT_EXIT | 1 | cycle-a-under-c-refused-3-deep
RUN | $T/lc.+x | $T | chain | a | a | 1
EXPECT_EXIT | 1 | self-parent-refused
RUN | $T/lc.+x | $T | chain | b | nosuch | 1
EXPECT_EXIT | 1 | unknown-parent-refused
RUN | $T/lc.+x | $T | chain | b | a | 0
EXPECT_EXIT | 1 | zero-ratio-refused
RUN | $T/lc.+x | $T | info | a
EXPECT_OUT | a\p\p\p0\p | refused-cycle-left-a-unchained
RUN | $T/lc.+x | $T | unchain | c
RUN | $T/lc.+x | $T | cmd | a | advance | 1000
RUN | $T/lc.+x | $T | step | 0
RUN | $T/lc.+x | $T | list
EXPECT_OUT | c\puser\poff\p1\p6000\p | unchained-clock-keeps-its-time-and-stops-following
EXPECT_OUT | b\puser\poff\p1\p6000\p | b-still-follows-a-x3
