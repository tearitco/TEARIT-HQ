RUN | $T/lc.+x | $T | step | 0
RUN | $T/lc.+x | $T | list
EXPECT_OUT | g1\puser\poff\p1\p172800000\p | allow-settime-back-1-lets-it-go-back
EXPECT_HAS | #.desktop/clocks/clock_audit.txt | \psettime\p172800000\pok:backwards-allowed\p | allowed-back-is-logged-distinctly
RUN | $T/lc.+x | $T | cmd | g1 | advance | 1d
RUN | $T/lc.+x | $T | step | 0
RUN | $T/lc.+x | $T | sched-count | r1
EXPECT_OUT_IS | 10 | ledger-honest-after-an-allowed-back-set-nothing-fires-twice
RUN | $T/lc.+x | $T | limit | g1 | allow_settime_back | 0
RUN | $T/lc.+x | $T | cmd | g1 | settime | 1000
RUN | $T/lc.+x | $T | step | 0
RUN | $T/lc.+x | $T | list
EXPECT_OUT | g1\puser\poff\p1\p259200000\p | back-refused-again-once-flag-cleared
