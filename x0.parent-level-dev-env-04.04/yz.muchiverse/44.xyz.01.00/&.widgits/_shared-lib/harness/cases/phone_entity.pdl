# phone_entity (2026-11-16): an ENTITY (cursword) on the +phone (spec: BOOK 16.game/PLUS-PHONE-CURSWORD-ENTITY-IMPLEMENTATION-SPEC-2026-11-16.md). SCRATCH house, the REAL phone_op and phone_projector, a STUB renderer that logs every launch (a launch COUNT proves "one window"),
# a scratch entity folder whose menu actions only touch marker files. Proves: the bottom bar gets a cell for each LISTED entity that resolves under xyzfs/users/.../pals/<name> (an unlisted one, a symlink out and a folder outside pals get none and cannot be opened);
# tapping it shows the entity's own menu rows as buttons in the SAME window; row N runs exactly that row's action (sh -c form, with the entity folder as $0 and the house as $1, no shell string built), Cancel goes back, Close writes the word CLOSE to the entity's relay and
# nothing else; an unsupported action form, a bad row number and a bad name are refused with no side effect. NEVER touches a real entity (the live Close row would end the owner's cursword). NO network.
RESULTS | ../results/phone_entity.txt
ENV | LC_ALL | C

CASE    | setup
SCRATCH |
MKDIR | h/&.widgits/_shared-lib/ops/+x
MKDIR | h/&.hq-apps/plus-phone/ops/+x
MKDIR | h/_.monads/_.livedesk-taskbar/ops/+x
MKDIR | h/#.desktop
RUN | /bin/cp | $HOUSE/&.hq-apps/plus-phone/ops/+x/phone_op.+x | $T/h/&.hq-apps/plus-phone/ops/+x/phone_op.+x
RUN | /bin/cp | $HOUSE/&.hq-apps/plus-phone/ops/+x/phone_projector.+x | $T/h/&.hq-apps/plus-phone/ops/+x/phone_projector.+x
RUN | /bin/cp | $HOUSE/&.hq-apps/plus-phone/plus-phone.xhtpm | $T/h/&.hq-apps/plus-phone/plus-phone.xhtpm
RUN | /bin/cp | $HOUSE/&.hq-apps/plus-phone/plus-phone-landscape.xhtpm | $T/h/&.hq-apps/plus-phone/plus-phone-landscape.xhtpm
RUN | /bin/cp | $HOUSE/&.hq-apps/plus-phone/plus-phone.css | $T/h/&.hq-apps/plus-phone/plus-phone.css
RUN | /bin/cp | $HOUSE/&.hq-apps/plus-phone/plus-phone-landscape.css | $T/h/&.hq-apps/plus-phone/plus-phone-landscape.css
RUN | /bin/cp | -r | $HOUSE/&.hq-apps/plus-phone/apps | $T/h/&.hq-apps/plus-phone/apps
RUN | /bin/cp | $HOUSE/&.widgits/_shared-lib/kh_spawn.sh | $T/h/&.widgits/_shared-lib/kh_spawn.sh
RUN | /bin/cp | $HOUSE/&.widgits/_shared-lib/ops/+x/proc_reg_op.+x | $T/h/&.widgits/_shared-lib/ops/+x/proc_reg_op.+x
WRITE   | h/_.monads/_.livedesk-taskbar/ops/+x/khtpm_core_render.+x | #!/bin/sh\necho "$2" >> "$3/launch.log"\nsleep 600\n
RUN | /bin/chmod | +x | $T/h/_.monads/_.livedesk-taskbar/ops/+x/khtpm_core_render.+x
RUN | $T/h/&.hq-apps/plus-phone/ops/+x/phone_op.+x | new | $T/h
EXPECT_OUT | PHONE-OPENED 1 | phone-1-is-open
RUN | /bin/cp | $T/h/&.hq-apps/plus-phone/instances/1/plus-phone.xhtpm | $T/picker0.xhtpm
SLEEP | 2500
RUN | /usr/bin/grep | -c | . | $T/h/&.hq-apps/plus-phone/instances/1/launch.log
EXPECT_OUT_IS | 1 | one-launch-so-far
MKDIR | h/xyzfs/users/u1/home/livedesk/pals/cursword
MKDIR | h/xyzfs/users/u1/home/livedesk/pals/other
MKDIR | h/xyzfs/users/u1/home/livedesk/pals/evil
MKDIR | h/bare/pals/bare
WRITE   | h/xyzfs/users/u1/home/livedesk/pals/cursword/menu.chtpm | <window class="entity-menu">\n  <page name="main">\n    <item label="Dir" action="sh -c 'echo ran &gt; &quot;$0/ran_dir&quot;'"/>\n    <item label="Inventory" action="sh -c 'echo &quot;$1&quot; &gt; &quot;$0/ran_house&quot;'"/>\n    <item label="Chat" action="sh -c 'echo &quot;$WIN_X&quot; &gt; &quot;$0/ran_winx&quot;'"/>\n    <item label="Odd" action="exec /bin/true"/>\n    <cli_io id="cmd" target_id="cmd" label="Cli-io: " action="x"/>\n    <item label="Close" action="CLOSE"/>\n    <item label="Cancel" action="void"/>\n  </page>\n</window>\n
WRITE   | h/xyzfs/users/u1/home/livedesk/pals/other/menu.chtpm | <window class="entity-menu"><page name="main"><item label="Dir" action="sh -c 'touch &quot;$0/ran_dir&quot;'"/></page></window>\n
WRITE   | h/xyzfs/users/u1/home/livedesk/pals/evil/menu.chtpm | <window class="entity-menu"><page name="main"><item label="Dir" action="sh -c 'touch &quot;$0/ran_dir&quot;'"/></page></window>\n
WRITE   | h/bare/pals/bare/menu.chtpm | <window class="entity-menu"><page name="main"><item label="Dir" action="sh -c 'touch &quot;$0/ran_dir&quot;'"/></page></window>\n
RUN | /bin/ln | -s | $T/h/xyzfs/users/u1/home/livedesk/pals/evil | $T/h/xyzfs/users/u1/home/livedesk/pals/linked
WRITE   | h/#.desktop/strip_ui.txt | n_tabs=5\ntab_0_label=cursword\ntab_0_sprite=$T/h/xyzfs/users/u1/home/livedesk/pals/cursword\ntab_1_label=other\ntab_1_sprite=$T/h/xyzfs/users/u1/home/livedesk/pals/other\ntab_2_label=linked\ntab_2_sprite=$T/h/xyzfs/users/u1/home/livedesk/pals/linked\ntab_3_label=bare\ntab_3_sprite=$T/h/bare/pals/bare\n
WRITE   | h/&.hq-apps/plus-phone/phone_prefs.pdl | ENTITY | cursword\nENTITY | linked\nENTITY | bare\n
RUN | /bin/cp | $T/h/xyzfs/users/u1/home/livedesk/pals/cursword/menu.chtpm | $T/menu0.chtpm

