# chain_signed: LOCKED cases for signed transactions on a test chain (signatures steps 2-3): wallet pubkey field, chain.pdl SIGNING row, chain_send signature + nonce check.
# SCRATCH only. Signed message: TX|<chain>|<from>|<to>|<amount>|<nonce> under context chain:<chain>; Ed25519 is deterministic, so the expected signature is a literal from the TEST fixture key.
# NOT covered (not built): verification at mining/replay time, escrow rows, the real chain.
RESULTS | ../results/chain_signed.txt
SCRATCH |
COPY | 041.pal-chain⛓️/ops/+x/chain_new.+x | 041.pal-chain/ops/+x/chain_new.+x
COPY | 041.pal-chain⛓️/ops/+x/chain_send.+x | 041.pal-chain/ops/+x/chain_send.+x
COPY | 041.pal-chain⛓️/ops/+x/chain_balance.+x | 041.pal-chain/ops/+x/chain_balance.+x
COPY | 041.pal-chain⛓️/ops/+x/chain_miner.+x | 041.pal-chain/ops/+x/chain_miner.+x
COPY | 041.pal-chain⛓️/ops/+x/chain_create_wallet.+x | 041.pal-chain/ops/+x/chain_create_wallet.+x
COPY | &.widgits/_shared-lib/ops/+x/sig_op.+x | 041.pal-chain/ops/+x/sig_op.+x

CASE | signed-chain-setup
ENV | PRISC_PROJECT_ROOT | $T/041.pal-chain
ENV | CHAIN_DIFFICULTY_HEX_ZEROS | 1
RUN | $T/041.pal-chain/ops/+x/chain_new.+x | sg | --signing | 1 | --cap | 0
EXPECT_EXIT | 0 | signed-chain-created
EXPECT_HAS | 041.pal-chain/chains/sg/chain.pdl | SIGNING \p required                   \p 1 | chain-pdl-says-signing-required
RUN | $T/041.pal-chain/ops/+x/chain_new.+x | lax
EXPECT_HAS | 041.pal-chain/chains/lax/chain.pdl | SIGNING \p required                   \p 0 | default-chain-signing-off
RUN | $T/041.pal-chain/ops/+x/chain_new.+x | bad | --signing | 2
EXPECT_EXIT | 1 | signing-option-must-be-0-or-1
ENV | PRISC_PROJECT_ROOT | $T/041.pal-chain/chains/sg
RUN | $T/041.pal-chain/ops/+x/chain_create_wallet.+x | alice | pw | fde83f690ff40fc4a8e891ac18e0376e43a23c493dc8b0cbd829b5e0086fcf0a
EXPECT_EXIT | 0 | wallet-with-pubkey
EXPECT_HAS | 041.pal-chain/chains/sg/wallets/alice/wallet.txt | pubkey=fde83f690ff40fc4a8e891ac18e0376e43a23c493dc8b0cbd829b5e0086fcf0a | pubkey-stored
RUN | $T/041.pal-chain/ops/+x/chain_create_wallet.+x | carol | pw | xyz
EXPECT_EXIT | 1 | bad-pubkey-refused
RUN | $T/041.pal-chain/ops/+x/chain_create_wallet.+x | mallory | pw
RUN | $T/041.pal-chain/ops/+x/chain_create_wallet.+x | bob | pw
RUN | $T/041.pal-chain/ops/+x/chain_miner.+x | alice | --blocks | 1
EXPECT_EXIT | 0 | alice-funded

CASE | signed-sends
RUN | $T/041.pal-chain/ops/+x/chain_send.+x | alice | bob | 5
EXPECT_EXIT | 3 | unsigned-send-refused-on-signed-chain
RUN | $T/041.pal-chain/ops/+x/chain_send.+x | alice | bob | 5 | 1 | a497790a62a099621b4f8deeb3c0e8a31b0301e13fbf58920b93152eacc46ec02f9215bcd49fe1668eb3eb6ee77883caf90f3e381003bc4fdbe6884b432c8d0f
EXPECT_EXIT | 0 | signed-send-accepted
EXPECT_HAS | 041.pal-chain/chains/sg/data/pending_tx.txt | TX\palice\pbob\p5\p | tx-queued
EXPECT_HAS | 041.pal-chain/chains/sg/data/pending_tx.txt | \pn=1\ps=a497790a62a099621b4f8deeb3c0e8a31b0301e13fbf58920b93152eacc46ec02f9215bcd49fe1668eb3eb6ee77883caf90f3e381003bc4fdbe6884b432c8d0f | nonce-and-sig-recorded
RUN | $T/041.pal-chain/ops/+x/chain_send.+x | alice | bob | 5 | 1 | a497790a62a099621b4f8deeb3c0e8a31b0301e13fbf58920b93152eacc46ec02f9215bcd49fe1668eb3eb6ee77883caf90f3e381003bc4fdbe6884b432c8d0f
EXPECT_EXIT | 3 | replay-refused
RUN | $T/041.pal-chain/ops/+x/chain_send.+x | alice | bob | 6 | 2 | a497790a62a099621b4f8deeb3c0e8a31b0301e13fbf58920b93152eacc46ec02f9215bcd49fe1668eb3eb6ee77883caf90f3e381003bc4fdbe6884b432c8d0f
EXPECT_EXIT | 3 | tampered-amount-refused
RUN | $T/041.pal-chain/ops/+x/chain_send.+x | alice | mallory | 5 | 1 | a497790a62a099621b4f8deeb3c0e8a31b0301e13fbf58920b93152eacc46ec02f9215bcd49fe1668eb3eb6ee77883caf90f3e381003bc4fdbe6884b432c8d0f
EXPECT_EXIT | 3 | other-recipient-refused
RUN | $T/041.pal-chain/ops/+x/chain_send.+x | mallory | bob | 5 | 1 | a497790a62a099621b4f8deeb3c0e8a31b0301e13fbf58920b93152eacc46ec02f9215bcd49fe1668eb3eb6ee77883caf90f3e381003bc4fdbe6884b432c8d0f
EXPECT_EXIT | 3 | wallet-without-pubkey-refused
RUN | $T/041.pal-chain/ops/+x/chain_send.+x | alice | bob | 5 | 7
EXPECT_EXIT | 1 | nonce-without-signature-refused
RUN | grep | -c | ^TX | $T/041.pal-chain/chains/sg/data/pending_tx.txt
EXPECT_OUT_IS | 1 | exactly-one-tx-queued
RUN | $T/041.pal-chain/ops/+x/chain_miner.+x | alice | --blocks | 1
RUN | $T/041.pal-chain/ops/+x/chain_balance.+x | bob
EXPECT_OUT_IS | 5 | mined-signed-tx-still-derives-balance

CASE | unsigned-chain-unchanged
ENV | PRISC_PROJECT_ROOT | $T/041.pal-chain/chains/lax
RUN | $T/041.pal-chain/ops/+x/chain_create_wallet.+x | dan | pw
RUN | $T/041.pal-chain/ops/+x/chain_miner.+x | dan | --blocks | 1
RUN | $T/041.pal-chain/ops/+x/chain_send.+x | dan | erin | 5
EXPECT_EXIT | 0 | unsigned-chain-still-sends-unsigned
