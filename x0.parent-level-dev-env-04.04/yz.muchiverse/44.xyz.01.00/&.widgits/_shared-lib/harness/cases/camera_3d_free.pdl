# 3D free camera (owner 2026-10-27: arrows move the xelector, not the camera; same for 3D). Engine, input op and test are COMPILED FROM SOURCE into the scratch dir; bv_3d_camera_test.c runs the real input op and the real engine on a scratch project and reads
# the camera from the scene receipt. POSITIVE = the real engine; NEGATIVE = the same source built with -DBV_NO_CAM_BASE (the camera as it was before: it sits on the xelector), which must FAIL the 'camera did not move' check.
RESULTS | ../results/camera_3d_free.txt
CASE    | build
SCRATCH |
MKDIR | g1
MKDIR | g2
RUN | gcc | -O2 | -w | -DBV_HAVE_GPU | -fopenmp | -o | $T/engine_real | $HOUSE/&.widgits/board-viewer/ops/bv_render_3d.c | $HOUSE/&.widgits/board-viewer/ops/bv_gpu_raymarch.c | -lm | -lEGL | -lGLESv2
EXPECT_EXIT | 0 | engine-builds-from-source
RUN | gcc | -O2 | -w | -DBV_HAVE_GPU | -DBV_NO_CAM_BASE | -fopenmp | -o | $T/engine_old | $HOUSE/&.widgits/board-viewer/ops/bv_render_3d.c | $HOUSE/&.widgits/board-viewer/ops/bv_gpu_raymarch.c | -lm | -lEGL | -lGLESv2
EXPECT_EXIT | 0 | negative-fixture-engine-builds
RUN | gcc | -O2 | -w | -o | $T/menu_input | $HOUSE/&.widgits/board-viewer/ops/bv_menu_input.c | -lm
EXPECT_EXIT | 0 | input-op-builds-from-source
RUN | gcc | -O2 | -w | -o | $T/ctest | $HOUSE/&.widgits/board-viewer/ops/bv_3d_camera_test.c | -lm
EXPECT_EXIT | 0 | test-program-builds
CASE    | positive-real-engine
ENV | BV2D_INPUT_BIN | $T/menu_input
ENV | BV3D_BIN | $T/engine_real
RUN | $T/ctest | $T/g1
EXPECT_EXIT | 0 | every-check-holds
EXPECT_OUT | ok  : arrows: the xelector moved two cells | xelector-moves
EXPECT_OUT | ok  : arrows: the CAMERA did not move (mode 3, xelector still in view) | camera-does-not-move-with-the-arrows
EXPECT_OUT | ok  : arrows: the xelector is visible in the frame | xelector-visible
EXPECT_OUT | ok  : arrows: past the edge of the view the camera pans after the xelector | camera-pans-past-the-edge
EXPECT_OUT | ok  : arrows: ... and the xelector is still visible | xelector-still-visible-after-the-pan
EXPECT_OUT | ok  : ; puts the camera base back on the xelector | snap-puts-the-base-on-the-xelector
EXPECT_OUT | ok  : mode 2 (the follow camera) is unchanged: the camera follows the xelector | mode-2-follow-camera-unchanged
EXPECT_OUT_LACKS | FAIL | no-failed-check
CASE    | negative-engine-without-the-camera-base
ENV | BV3D_BIN | $T/engine_old
RUN | $T/ctest | $T/g2
EXPECT_EXIT | 1 | the-test-fails-on-the-old-camera
EXPECT_OUT | FAIL: arrows: the CAMERA did not move (mode 3, xelector still in view) | camera-check-fails-with-the-old-camera
CLEAN |
