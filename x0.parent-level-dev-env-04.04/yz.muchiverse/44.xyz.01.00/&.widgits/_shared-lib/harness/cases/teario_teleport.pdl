RUN | $HOUSE/&.widgits/_shared-lib/ops/+x/game_core.+x | $T/tt/fee | $T/gf | status
EXPECT_OUT | score=7 | HAND-COMPUTED-the-fee-7-in-blocks.pdl-is-added-to-the-score
EXPECT_HAS | $T/gf/ledger.txt | EVENT\p12\pbank\pteleport\pp1\p6,6>12,6\pfee=7;score=7 | and-the-row-records-it

CASE    | tt_bad_blocks_are_refused
MKDIR   | badnum_g
MKDIR   | solidtp_g
RUN | $HOUSE/&.widgits/_shared-lib/ops/+x/game_core.+x | $T/tt/badnum | $T/badnum_g | status
EXPECT_EXIT | 2 | NEGATIVE-a-negative-teleport-fee-in-blocks.pdl-is-refused
RUN | $HOUSE/&.widgits/_shared-lib/ops/+x/game_core.+x | $T/tt/solidtp | $T/solidtp_g | status
EXPECT_EXIT | 2 | NEGATIVE-a-teleport-tile-that-is-in-the-solid-set-is-refused

CASE    | tt_rules_hash_unchanged
# D106 policy: blocks.pdl is not part of the rules hash, so the SAME first ledger row (rules=...) is written with and without the teleport row, and an old ledger opens. NEGATIVE CONTROL: a hashed row (patrol_speed) changes it.
MKDIR   | h_old
MKDIR   | h_new
COPYDIR | @.apps/teario-play | tt/ctrl
RUN | sed | -i | s/^RULE \p patrol_speed \p 10/RULE \p patrol_speed \p 11/ | $T/tt/ctrl/rulesets/default/rules.pdl
MKDIR   | h_ctrl
RUN | $HOUSE/&.widgits/_shared-lib/ops/+x/game_core.+x | $T/tt/old | $T/h_old | new | 7
RUN | $HOUSE/&.widgits/_shared-lib/ops/+x/game_core.+x | $T/tt/plat | $T/h_new | new | 7
RUN | $HOUSE/&.widgits/_shared-lib/ops/+x/game_core.+x | $T/tt/ctrl | $T/h_ctrl | new | 7
RUN | sh | -c | head -1 $T/h_old/ledger.txt \p grep -o 'rules=[0-9a-f]*'
CAPTURE | rh_old
RUN | sh | -c | head -1 $T/h_new/ledger.txt \p grep -o 'rules=[0-9a-f]*'
CAPTURE | rh_new
RUN | sh | -c | head -1 $T/h_ctrl/ledger.txt \p grep -o 'rules=[0-9a-f]*'
CAPTURE | rh_ctrl
EXPECT_NE | $rh_old | $rh_ctrl | vacuity-the-hash-DOES-change-with-a-hashed-row
EXPECT_EQ | $rh_old | $rh_new | THE-RULES-HASH-DOES-NOT-CHANGE-with-the-teleport-row-in-blocks.pdl-and-its-tile-in-the-level


CASE    | tt_make_setup
# Make: the stamp bank has `tp`; it is placed by the ordinary paint verb (the Place button's own path); the level doc accepts it; a Play run of THAT level teleports and clears; publish passes.
COPYDIR | @.apps/teario-play | tt/teario-play
COPYDIR | @.apps/teario-make | tt/teario-make
RUN | rm | -rf | $T/tt/teario-play/state | $T/tt/teario-play/teario-play-pchq
RUN | rm | -rf | $T/tt/teario-make/state | $T/tt/teario-make/teario-make-pchq
MKDIR   | mg
RUN | $HOUSE/&.widgits/_shared-lib/ops/+x/game_core.+x | $T/tt/teario-make | $T/mg | new | 7
RUN | $HOUSE/&.widgits/_shared-lib/ops/+x/game_core.+x | $T/tt/teario-make | $T/mg | add | name | Tele
RUN | $HOUSE/&.widgits/_shared-lib/ops/+x/game_core.+x | $T/tt/teario-make | $T/mg | add | start | 3 10
RUN | $HOUSE/&.widgits/_shared-lib/ops/+x/game_core.+x | $T/tt/teario-make | $T/mg | add | goal | 17 10
RUN | $HOUSE/&.widgits/_shared-lib/ops/+x/game_core.+x | $T/tt/teario-make | $T/mg | add | r00 | ....................
RUN | $HOUSE/&.widgits/_shared-lib/ops/+x/game_core.+x | $T/tt/teario-make | $T/mg | add | r01 | ....................
RUN | $HOUSE/&.widgits/_shared-lib/ops/+x/game_core.+x | $T/tt/teario-make | $T/mg | add | r02 | ....................
