# teario_teleport (2026-11-22; decision D111): the TELEPORT block in the REAL game_core platform body, make and play. A scratch copy of teario-play on a 16 x 8 level Tele: START (4,6), teleport tiles at (6,6) and (12,6), ground row 7. The goal is parked out of reach (1,1) so no run ends early.
# HAND-COMPUTED: the body spawns at x 1052 (cell 4); running right it reaches cell 6 at tick 12 (observed, the same tick the coin of teario_blocks is near) and the rule moves it to the exit (12,6): x = 12*256 + 128 - 100 = 3100, y unchanged 1592 (feet on the floor), row `bank|teleport|p1|6,6>12,6|fee=0;score=0` at tick 12. Then it keeps running right at 48 per tick: 8 ticks later x = 3100 + 8*48 = 3484 and there is still exactly ONE teleport row (arriving did not bounce).
# OBSERVED pins (deterministic): the ckpt at tick 20 pins a hash. Level Back has its tiles at (3,6) and (6,6): the body running right from 4 meets only the EXIT (6,6) and is not sent anywhere.
# The rules hash must NOT change: blocks.pdl is not hashed (D106 policy), so a ledger made before the teleport row existed still opens.
RESULTS | ../results/teario_teleport.txt
ENV | LC_ALL | C

CASE    | tt_setup
SCRATCH |
COPYDIR | @.apps/teario | tt/teario
WRITE | tt/teario/levels/tele.pdl | # level.pdl - scratch\nMETA  \p name \p Tele\nMETA  \p size \p 16 x 8\nSTART \p 4 \p 6\nGOAL  \p 1 \p 1\nROW   \p 0 \p ................\nROW   \p 1 \p ................\nROW   \p 2 \p ................\nROW   \p 3 \p ................\nROW   \p 4 \p ................\nROW   \p 5 \p ................\nROW   \p 6 \p ......t.....t...\nROW   \p 7 \p ################
WRITE | tt/teario/levels/back.pdl | # level.pdl - scratch\nMETA  \p name \p Back\nMETA  \p size \p 16 x 8\nSTART \p 4 \p 6\nGOAL  \p 1 \p 1\nROW   \p 0 \p ................\nROW   \p 1 \p ................\nROW   \p 2 \p ................\nROW   \p 3 \p ................\nROW   \p 4 \p ................\nROW   \p 5 \p ................\nROW   \p 6 \p ...t..t.........\nROW   \p 7 \p ################
WRITE | tt/teario/levels/odd.pdl | # level.pdl - scratch\nMETA  \p name \p Odd\nMETA  \p size \p 16 x 8\nSTART \p 4 \p 6\nGOAL  \p 1 \p 1\nROW   \p 0 \p ................\nROW   \p 1 \p ................\nROW   \p 2 \p ................\nROW   \p 3 \p ................\nROW   \p 4 \p ................\nROW   \p 5 \p ................\nROW   \p 6 \p ......t.........\nROW   \p 7 \p ################
WRITE | tt/teario/levels/tele2.pdl | # level.pdl - scratch\nMETA  \p name \p Tele2\nMETA  \p size \p 16 x 8\nSTART \p 4 \p 6\nGOAL  \p 1 \p 1\nROW   \p 0 \p ................\nROW   \p 1 \p ................\nROW   \p 2 \p ................\nROW   \p 3 \p ................\nROW   \p 4 \p ................\nROW   \p 5 \p ................\nROW   \p 6 \p ......t...t.t..\nROW   \p 7 \p ################
COPYDIR | @.apps/teario-play | tt/plat
RUN | sed | -i | s/meadow\.pdl/tele.pdl/ | $T/tt/plat/rulesets/default/board.pdl
COPYDIR | @.apps/teario-play | tt/back
RUN | sed | -i | s/meadow\.pdl/back.pdl/ | $T/tt/back/rulesets/default/board.pdl
COPYDIR | @.apps/teario-play | tt/odd
RUN | sed | -i | s/meadow\.pdl/odd.pdl/ | $T/tt/odd/rulesets/default/board.pdl
COPYDIR | @.apps/teario-play | tt/fee
RUN | sed | -i | s/meadow\.pdl/tele.pdl/ | $T/tt/fee/rulesets/default/board.pdl
RUN | sed | -i | s/^BLOCK \p teleport \p t \p 0/BLOCK \p teleport \p t \p 7/ | $T/tt/fee/rulesets/default/blocks.pdl
COPYDIR | @.apps/teario-play | tt/badnum
RUN | sed | -i | s/meadow\.pdl/tele.pdl/ | $T/tt/badnum/rulesets/default/board.pdl
RUN | sed | -i | s/^BLOCK \p teleport \p t \p 0/BLOCK \p teleport \p t \p -1/ | $T/tt/badnum/rulesets/default/blocks.pdl
COPYDIR | @.apps/teario-play | tt/solidtp
RUN | sed | -i | s/meadow\.pdl/tele.pdl/ | $T/tt/solidtp/rulesets/default/board.pdl
RUN | sed | -i | s/^LEVEL \p solid \p .*/LEVEL \p solid \p #t/ | $T/tt/solidtp/rulesets/default/board.pdl
COPYDIR | @.apps/teario-play | tt/old
RUN | rm | $T/tt/old/rulesets/default/blocks.pdl
RUN | sed | -i | s/meadow\.pdl/tele.pdl/ | $T/tt/old/rulesets/default/board.pdl
EXPECT_HAS | $T/tt/plat/rulesets/default/blocks.pdl | BLOCK \p teleport \p t \p 0 | the-shipped-blocks-file-declares-the-teleport-tile-and-its-fee
EXPECT_HAS | $T/tt/fee/rulesets/default/blocks.pdl | BLOCK \p teleport \p t \p 7 | vacuity-the-fee-copy-has-the-other-number
RUN | grep | -c | ^BLOCK \p teleport | $HOUSE/@.apps/teario-make/rulesets/default/blocks.pdl
EXPECT_OUT_IS | 1 | Make-ships-the-same-teleport-row
MKDIR   | g

CASE    | tt_trip
RUN | $HOUSE/&.widgits/_shared-lib/ops/+x/game_core.+x | $T/tt/plat | $T/g | new | 7
RUN | $HOUSE/&.widgits/_shared-lib/ops/+x/game_core.+x | $T/tt/plat | $T/g | join | H | human
RUN | $HOUSE/&.widgits/_shared-lib/ops/+x/game_core.+x | $T/tt/plat | $T/g | start
RUN | $HOUSE/&.widgits/_shared-lib/ops/+x/game_core.+x | $T/tt/plat | $T/g | input | p1 | right | 0
RUN | $HOUSE/&.widgits/_shared-lib/ops/+x/game_core.+x | $T/tt/plat | $T/g | advance | 12
RUN | $HOUSE/&.widgits/_shared-lib/ops/+x/game_core.+x | $T/tt/plat | $T/g | status
EXPECT_OUT | body=3100,1592,48,0 | HAND-COMPUTED-the-body-was-moved-from-cell-6-to-the-exit-(12,6):-x-3100-y-1592-vx-kept-48
EXPECT_OUT | score=0 | the-fee-in-the-shipped-blocks.pdl-is-0
EXPECT_HAS | $T/g/ledger.txt | EVENT\p12\pbank\pteleport\pp1\p6,6>12,6\pfee=0;score=0 | HAND-COMPUTED-the-consequence-row-at-tick-12
RUN | $HOUSE/&.widgits/_shared-lib/ops/+x/game_core.+x | $T/tt/plat | $T/g | check
EXPECT_EXIT | 0 | the-run-checks-out

CASE    | tt_no_bounce
RUN | $HOUSE/&.widgits/_shared-lib/ops/+x/game_core.+x | $T/tt/plat | $T/g | advance | 8
RUN | $HOUSE/&.widgits/_shared-lib/ops/+x/game_core.+x | $T/tt/plat | $T/g | status
EXPECT_OUT | body=3484,1592,48,0 | HAND-COMPUTED-3100-plus-8-ticks-of-48:-the-body-ran-on-from-the-exit-and-was-not-sent-back
RUN | grep | -c | bank\pteleport | $T/g/ledger.txt
EXPECT_OUT_IS | 1 | exactly-ONE-teleport-row-(arriving-on-the-exit-does-not-send)
EXPECT_HAS | $T/g/ledger.txt | hash=511b65faa7bed70a | OBSERVED-the-ckpt-at-tick-20-pins-the-state-hash

CASE    | tt_replay_twice
RUN | $HOUSE/&.widgits/_shared-lib/ops/+x/game_core.+x | $T/tt/plat | $T/g | status
EXPECT_OUT | tick=20 | the-first-replay-from-the-ledger-alone-gives-the-same-tick
EXPECT_OUT | body=3484,1592,48,0 | and-the-same-body
RUN | $HOUSE/&.widgits/_shared-lib/ops/+x/game_core.+x | $T/tt/plat | $T/g | status
EXPECT_OUT | body=3484,1592,48,0 | and-the-second-replay-gives-it-too
RUN | $HOUSE/&.widgits/_shared-lib/ops/+x/game_core.+x | $T/tt/plat | $T/g | replay
EXPECT_EXIT | 0 | replay-verifies-every-ckpt-hash

CASE    | tt_forged_ledgers
MKDIR   | f1
RUN | sh | -c | grep -v '\pteleport\p' $T/g/ledger.txt > $T/f1/ledger.txt
RUN | cmp | $T/g/ledger.txt | $T/f1/ledger.txt
EXPECT_EXIT | 1 | vacuity-the-forged-file-differs
RUN | $HOUSE/&.widgits/_shared-lib/ops/+x/game_core.+x | $T/tt/plat | $T/f1 | status
EXPECT_EXIT | 1 | NEGATIVE-a-ledger-with-the-teleport-row-deleted-is-refused
EXPECT_OUT | no row recorded | and-the-refusal-says-a-consequence-was-not-recorded
MKDIR   | f2
RUN | sh | -c | sed 's/\p6,6>12,6\p/\p6,6>13,6\p/' $T/g/ledger.txt > $T/f2/ledger.txt
RUN | $HOUSE/&.widgits/_shared-lib/ops/+x/game_core.+x | $T/tt/plat | $T/f2 | status
EXPECT_EXIT | 1 | NEGATIVE-a-teleport-row-with-another-destination-is-refused
MKDIR   | f3
RUN | sh | -c | sed 's/\p6,6>12,6\p/\p5,6>12,6\p/' $T/g/ledger.txt > $T/f3/ledger.txt
RUN | $HOUSE/&.widgits/_shared-lib/ops/+x/game_core.+x | $T/tt/plat | $T/f3 | status
EXPECT_EXIT | 1 | NEGATIVE-a-teleport-row-with-another-source-is-refused
MKDIR   | f4
RUN | sh | -c | sed 's/fee=0;score=0/fee=5;score=5/' $T/g/ledger.txt > $T/f4/ledger.txt
RUN | $HOUSE/&.widgits/_shared-lib/ops/+x/game_core.+x | $T/tt/plat | $T/f4 | status
EXPECT_EXIT | 1 | NEGATIVE-a-row-with-another-fee-is-refused
MKDIR   | f5
RUN | sh | -c | sed 's/^EVENT\p12\pbank\pteleport/EVENT\p11\pbank\pteleport/' $T/g/ledger.txt > $T/f5/ledger.txt
RUN | $HOUSE/&.widgits/_shared-lib/ops/+x/game_core.+x | $T/tt/plat | $T/f5 | status
EXPECT_EXIT | 1 | NEGATIVE-a-teleport-row-at-another-tick-is-refused

CASE    | tt_exit_alone_sends_nothing
MKDIR   | gb
RUN | $HOUSE/&.widgits/_shared-lib/ops/+x/game_core.+x | $T/tt/back | $T/gb | new | 7
RUN | $HOUSE/&.widgits/_shared-lib/ops/+x/game_core.+x | $T/tt/back | $T/gb | join | H | human
RUN | $HOUSE/&.widgits/_shared-lib/ops/+x/game_core.+x | $T/tt/back | $T/gb | start
RUN | $HOUSE/&.widgits/_shared-lib/ops/+x/game_core.+x | $T/tt/back | $T/gb | input | p1 | right | 0
RUN | $HOUSE/&.widgits/_shared-lib/ops/+x/game_core.+x | $T/tt/back | $T/gb | advance | 20
RUN | $HOUSE/&.widgits/_shared-lib/ops/+x/game_core.+x | $T/tt/back | $T/gb | status
EXPECT_OUT | body=1844,1592,48,0 | OBSERVED-the-body-ran-across-the-EXIT-(6,6)-to-1844-and-was-not-moved-(the-same-run-on-Tele-is-at-3484)
EXPECT_LACKS | $T/gb/ledger.txt | teleport | NEGATIVE-no-teleport-row-when-only-an-exit-was-touched
MKDIR   | go
RUN | $HOUSE/&.widgits/_shared-lib/ops/+x/game_core.+x | $T/tt/odd | $T/go | new | 7
RUN | $HOUSE/&.widgits/_shared-lib/ops/+x/game_core.+x | $T/tt/odd | $T/go | join | H | human
RUN | $HOUSE/&.widgits/_shared-lib/ops/+x/game_core.+x | $T/tt/odd | $T/go | start
RUN | $HOUSE/&.widgits/_shared-lib/ops/+x/game_core.+x | $T/tt/odd | $T/go | input | p1 | right | 0
RUN | $HOUSE/&.widgits/_shared-lib/ops/+x/game_core.+x | $T/tt/odd | $T/go | advance | 20
RUN | $HOUSE/&.widgits/_shared-lib/ops/+x/game_core.+x | $T/tt/odd | $T/go | status
EXPECT_OUT | body=1844,1592,48,0 | OBSERVED-a-single-unpaired-tile-is-inert-(the-body-ran-through-it)
EXPECT_LACKS | $T/go/ledger.txt | teleport | NEGATIVE-no-teleport-row-for-an-unpaired-tile

CASE    | tt_fee_is_data
MKDIR   | gf
RUN | $HOUSE/&.widgits/_shared-lib/ops/+x/game_core.+x | $T/tt/fee | $T/gf | new | 7
RUN | $HOUSE/&.widgits/_shared-lib/ops/+x/game_core.+x | $T/tt/fee | $T/gf | join | H | human
