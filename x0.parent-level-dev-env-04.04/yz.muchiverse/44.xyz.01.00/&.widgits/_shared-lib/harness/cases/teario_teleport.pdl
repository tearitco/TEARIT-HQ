RUN | $HOUSE/&.widgits/_shared-lib/ops/+x/game_core.+x | $T/tt/teario-make | $T/mg | add | r06 | ....................
RUN | $HOUSE/&.widgits/_shared-lib/ops/+x/game_core.+x | $T/tt/teario-make | $T/mg | add | r07 | ....................
RUN | $HOUSE/&.widgits/_shared-lib/ops/+x/game_core.+x | $T/tt/teario-make | $T/mg | add | r08 | ....................
RUN | $HOUSE/&.widgits/_shared-lib/ops/+x/game_core.+x | $T/tt/teario-make | $T/mg | add | r09 | ....................
RUN | $HOUSE/&.widgits/_shared-lib/ops/+x/game_core.+x | $T/tt/teario-make | $T/mg | add | r10 | ....................
RUN | $HOUSE/&.widgits/_shared-lib/ops/+x/game_core.+x | $T/tt/teario-make | $T/mg | add | r11 | ####################
RUN | grep | ^STAMP | $T/tt/teario-make/rulesets/default/stamps.pdl
EXPECT_HAS | $T/tt/teario-make/rulesets/default/stamps.pdl | STAMP \p tp     \p teleport \p tile | the-bank-row-exists-(a-tile-class-stamp)
RUN | $HOUSE/&.widgits/_shared-lib/ops/+x/game_core.+x | $T/tt/teario-make | $T/mg | stamps
EXPECT_OUT | STAMP tp teleport tile | the-bank-lists-the-teleport-stamp
RUN | $HOUSE/&.widgits/_shared-lib/ops/+x/game_core.+x | $T/tt/teario-make | $T/mg | paint | tp | 6 | 10
EXPECT_EXIT | 0 | the-ordinary-paint-verb-places-the-first-teleport
RUN | $HOUSE/&.widgits/_shared-lib/ops/+x/game_core.+x | $T/tt/teario-make | $T/mg | paint | tp | 11 | 10
EXPECT_EXIT | 0 | and-the-second
RUN | $HOUSE/&.widgits/_shared-lib/ops/+x/game_core.+x | $T/tt/teario-make | $T/mg | paint | tp | 11 | 10
EXPECT_EXIT | 2 | NEGATIVE-painting-a-teleport-on-a-teleport-is-refused
EXPECT_OUT | already a teleport | and-says-so
RUN | $HOUSE/&.widgits/_shared-lib/ops/+x/game_core.+x | $T/tt/teario-make | $T/mg | export
EXPECT_HAS | $T/mg/level.pdl | ROW   \p 10 \p ......t....t........ | the-exported-level-has-the-two-teleport-tiles
RUN | $HOUSE/&.widgits/_shared-lib/ops/+x/game_core.+x | $T/tt/teario-make | $T/mg | play | $T/tt/teario-play | $T/mp
