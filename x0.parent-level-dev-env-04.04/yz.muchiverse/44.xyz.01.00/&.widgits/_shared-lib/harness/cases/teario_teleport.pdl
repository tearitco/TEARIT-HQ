EXPECT_EXIT | 0 | PUBLISH-PASSES-with-a-level-that-has-teleports
RUN | $HOUSE/&.widgits/_shared-lib/ops/+x/game_core.+x | $T/tt/teario-make | $T/mg | audit
EXPECT_EXIT | 0 | the-Make-audit-passes-(no-ghost-data)

CASE    | tt_teleport_really_saves_the_walk
# the SAME level without the two tiles (set r10 back to empty) is won in 76 ticks: the teleport is what made it 47
RUN | $HOUSE/&.widgits/_shared-lib/ops/+x/game_core.+x | $T/tt/teario-make | $T/mg | set | r10 | ....................
RUN | $HOUSE/&.widgits/_shared-lib/ops/+x/game_core.+x | $T/tt/teario-make | $T/mg | play | $T/tt/teario-play | $T/mp2
RUN | $HOUSE/&.widgits/_shared-lib/ops/+x/game_core.+x | $T/tt/teario-play | $T/mp2 | input | p1 | right | 0
RUN | $HOUSE/&.widgits/_shared-lib/ops/+x/game_core.+x | $T/tt/teario-play | $T/mp2 | advance | 120
RUN | $HOUSE/&.widgits/_shared-lib/ops/+x/game_core.+x | $T/tt/teario-play | $T/mp2 | verify_clear
EXPECT_OUT | ticks=76 | OBSERVED-without-the-teleport-the-walk-takes-76-ticks-(47-with-it)
EXPECT_LACKS | $T/mp2/ledger.txt | teleport | NEGATIVE-no-teleport-row-without-the-tiles

CASE    | tt_stamp_picture_and_figures
MKDIR   | pic
RUN | $HOUSE/&.widgits/_shared-lib/ops/+x/game_core.+x | $T/tt/teario-make | $T/stampimg/tp/game | stampimg | tp | $T/pic/tp | $HOUSE/@.apps/teario-make/teario-make-pchq/pieces/system/maps/teario-make/board/cells.rgba
EXPECT_EXIT | 0 | the-picture-of-the-tp-stamp-is-made
EXPECT_OUT | STAMPIMG tp | and-says-so
RUN | grep | -c | 60,150,255,255 | $T/pic/tp/sprite.csv
CAPTURE | tp_blue
EXPECT_GE | $tp_blue | 1 | the-tp-picture-shows-the-SENDER-colour-(60-150-255)
RUN | $HOUSE/&.widgits/_shared-lib/ops/+x/game_core.+x | $T/tt/teario-make | $T/stampimg/ground/game | stampimg | ground | $T/pic/ground | $HOUSE/@.apps/teario-make/teario-make-pchq/pieces/system/maps/teario-make/board/cells.rgba
RUN | grep | -c | 60,150,255,255 | $T/pic/ground/sprite.csv
CAPTURE | g_blue
EXPECT_EQ | $g_blue | 0 | NEGATIVE-the-ground-picture-has-no-teleport-colour

CASE    | tt_driver_2d_and_3d_figures
# The REAL driver (built from source, scratch house): a teleport tile is a STATIC tile; the player figure (events.txt, drawn over map.png in 2D and read by the 3D engine) jumps to the exit cell, the map.png picture stays the same (nothing in the land changed), and each end of the pair is a figure: sender blue (60 150 255), exit violet (160 90 255).
SCRATCH |
RUN | gcc | -std=gnu11 | -O2 | -w | -o | $T/gc | $HOUSE/&.widgits/_shared-lib/ops/game_core.c | -lm
COPYDIR | @.apps/teario | house/@.apps/teario
COPYDIR | @.apps/teario-play | house/@.apps/teario-play
RUN | rm | -rf | $T/house/@.apps/teario-play/state | $T/house/@.apps/teario-play/board
RUN | sed | -i | s/meadow\.pdl/tele.pdl/ | $T/house/@.apps/teario-play/rulesets/default/board.pdl
WRITE | house/@.apps/teario/levels/tele.pdl | # level.pdl - scratch\nMETA  \p name \p Tele\nMETA  \p size \p 16 x 8\nSTART \p 4 \p 6\nGOAL  \p 1 \p 1\nROW   \p 0 \p ................\nROW   \p 1 \p ................\nROW   \p 2 \p ................\nROW   \p 3 \p ................\nROW   \p 4 \p ................\nROW   \p 5 \p ................\nROW   \p 6 \p ......t.....t...\nROW   \p 7 \p ################
MKDIR   | house/@.apps/teario-play/state/games/teario-play/game
MKDIR   | house/@.apps/teario-play/state/world
COPY    | &.widgits/_shared-lib/ops/+x/raw_to_png.+x | house/&.widgits/_shared-lib/ops/+x/raw_to_png.+x
RUN | $T/gc | $T/house/@.apps/teario-play | $T/house/@.apps/teario-play/state/games/teario-play/game | new | 7
RUN | $T/gc | $T/house/@.apps/teario-play | $T/house/@.apps/teario-play/state/games/teario-play/game | join | H | human
RUN | $T/gc | $T/house/@.apps/teario-play | $T/house/@.apps/teario-play/state/games/teario-play/game | start
EXPECT_EXIT | 0 | a-started-game-with-a-human-seat-on-the-teleport-level
SPAWN   | DRV | $T/gc | driver | $T/house | $T/house/@.apps/teario-play | $T/house/@.apps/teario-play
WAIT_HAS | house/@.apps/teario-play/state/game_ui.txt | RUNNING | 15000 | VACUITY-the-driver-runs
WAIT_HAS | house/@.apps/teario-play/teario-play-pchq/pieces/system/maps/teario-play/play/cells.txt | cells | 10000 | VACUITY-the-driver-drew-the-desk
SLEEP   | 2000
EXPECT_EXISTS | house/@.apps/teario-play/teario-play-pchq/pieces/system/maps/teario-play/play/map.png | VACUITY-the-2D-picture-exists
RUN | cp | $T/house/@.apps/teario-play/teario-play-pchq/pieces/system/maps/teario-play/play/map.png | $T/before.png
EXPECT_HAS | house/@.apps/teario-play/teario-play-pchq/pieces/system/maps/teario-play/play/events.txt | 6 6 60 150 255 | THE-SENDER-figure-(blue)-is-at-(6,6)-before-the-trip
EXPECT_HAS | house/@.apps/teario-play/teario-play-pchq/pieces/system/maps/teario-play/play/events.txt | 12 6 160 90 255 | THE-EXIT-figure-(violet)-is-at-(12,6)
EXPECT_HAS | house/@.apps/teario-play/teario-play-pchq/pieces/system/maps/teario-play/play/events.txt | 4 6 | VACUITY-the-player-figure-starts-at-the-start-cell-(4,6)
WRITE   | house/@.apps/teario-play/state/interact_relay.txt | 1001\n
WAIT_HAS | house/@.apps/teario-play/state/games/teario-play/game/ledger.txt | teleport\pp1\p6,6>12,6 | 15000 | THE-TELEPORT-ROW-(driver-run-by-the-key-1001)
SLEEP   | 2500
RUN | /usr/bin/kill | $DRV
SLEEP   | 1500
RUN | grep | -c | ^4 6 220 60 60 People1 | $T/house/@.apps/teario-play/teario-play-pchq/pieces/system/maps/teario-play/play/events.txt
EXPECT_OUT_IS | 0 | NEGATIVE-the-player-figure-is-no-longer-on-the-start-cell-(4,6)
RUN | grep | -c | ^1[2-9] 6 220 60 60 People1 | $T/house/@.apps/teario-play/teario-play-pchq/pieces/system/maps/teario-play/play/events.txt
EXPECT_OUT_IS | 1 | THE-PLAYER-FIGURE-IS-PAST-THE-EXIT-(column-12-or-more)-on-the-same-row-in-events.txt-(the-picture-the-2D-window-and-the-3D-engine-draw)
EXPECT_HAS | house/@.apps/teario-play/teario-play-pchq/pieces/system/maps/teario-play/play/events.txt | 6 6 60 150 255 | the-sender-figure-is-still-there-(a-static-tile)
RUN | cmp | -s | $T/before.png | $T/house/@.apps/teario-play/teario-play-pchq/pieces/system/maps/teario-play/play/map.png
EXPECT_EXIT | 0 | the-2D-land-picture-is-unchanged-(the-tile-is-static,-only-the-player-figure-moved)
CLEAN   |
