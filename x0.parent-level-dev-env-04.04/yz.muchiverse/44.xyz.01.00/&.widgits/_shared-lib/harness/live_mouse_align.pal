# live_mouse_align.pal - LIVE case (LIVE_OK=1): real X clicks on the 3D canvas; the published click, the pointer marker origin and the 3D raycast round trip must agree. See cases/live_mouse_align.pdl
exec ./ops/+x/harness_case_op.+x cases/live_mouse_align.pdl
exec ./ops/+x/harness_verdict_op.+x cases/live_mouse_align.pdl
halt
