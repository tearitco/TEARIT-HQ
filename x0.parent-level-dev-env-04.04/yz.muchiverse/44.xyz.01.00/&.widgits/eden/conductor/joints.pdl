JOINT | j_talk | eden | w_talk | @weights.pdl | step=1 | min=0 | max=20 | autonomy=0 | owner_seat=1 | note="weight of the talk act"
JOINT | j_build | eden | w_build | @weights.pdl | step=1 | min=0 | max=20 | autonomy=0 | owner_seat=1 | note="weight of the build act"
JOINT | j_study | eden | w_study | @weights.pdl | step=1 | min=0 | max=20 | autonomy=0 | owner_seat=1 | note="weight of the study act"
JOINT | j_rest | eden | w_rest | @weights.pdl | step=1 | min=0 | max=20 | autonomy=0 | owner_seat=1 | note="weight of the rest act"
JOINT | j_feed | eden | w_feed | @weights.pdl | step=1 | min=0 | max=20 | autonomy=0 | owner_seat=1 | note="weight of the feed act"
