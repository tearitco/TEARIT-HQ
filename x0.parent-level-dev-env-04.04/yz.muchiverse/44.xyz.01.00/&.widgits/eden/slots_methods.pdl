METHOD       | Save 7 | sh -c 'exec "$0/ops/+x/eden_op.+x" "$0" save 7'
METHOD       | Save 8 | sh -c 'exec "$0/ops/+x/eden_op.+x" "$0" save 8'
METHOD       | Save 9 | sh -c 'exec "$0/ops/+x/eden_op.+x" "$0" save 9'
METHOD       | Save 10 | sh -c 'exec "$0/ops/+x/eden_op.+x" "$0" save 10'
METHOD       | Load 1 | sh -c 'exec "$0/ops/+x/eden_op.+x" "$0" load 1'
