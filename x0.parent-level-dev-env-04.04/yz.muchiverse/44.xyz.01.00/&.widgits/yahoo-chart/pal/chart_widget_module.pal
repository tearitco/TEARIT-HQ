# chart_widget_module.pal - pieces/chtpm/layouts/chart.chtpm's own
# dedicated module for the yahoo-chart widget session.
# Same proven shape as broker_widget_module.pal.
li x1, 0

drain:
read_history pieces/apps/player_app/interact_relay.txt x2, x1
beq x2, x0, drain_done
j drain
drain_done:

li x9, 0
chart_menu_input x9
chart_compose_frame
hit_frame
read_pos x7, "pieces/display/chart_screen_changed.txt"

loop:
li x9, 0
chart_menu_input x9
read_pos x8, "pieces/display/chart_screen_changed.txt"
beq x7, x8, check_key
addi x7, x8, 0
j render

check_key:
read_history pieces/apps/player_app/interact_relay.txt x2, x1
beq x2, x0, no_key
chart_menu_input x2
j render

no_key:
sleep 30000
j loop

render:
chart_compose_frame
hit_frame
sleep 30000
j loop
