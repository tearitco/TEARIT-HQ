# broker_select_module.pal - pieces/chtpm/layouts/broker_select.chtpm's
# own dedicated module. Same proven shape as bank_module.pal.
li x1, 0

drain:
read_history pieces/apps/player_app/interact_relay.txt x2, x1
beq x2, x0, drain_done
j drain
drain_done:

li x9, 0
yahoo_menu_input x9
yahoo_compose_frame
hit_frame
read_pos x7, "pieces/display/yahoo_screen_changed.txt"

loop:
li x9, 0
yahoo_compose_frame
yahoo_menu_input x9
read_pos x8, "pieces/display/yahoo_screen_changed.txt"
beq x7, x8, check_key
addi x7, x8, 0
j render

check_key:
read_history pieces/apps/player_app/interact_relay.txt x2, x1
beq x2, x0, no_key
yahoo_menu_input x2
j render

no_key:
sleep 30000
j loop

render:
yahoo_compose_frame
hit_frame
sleep 30000
j loop
