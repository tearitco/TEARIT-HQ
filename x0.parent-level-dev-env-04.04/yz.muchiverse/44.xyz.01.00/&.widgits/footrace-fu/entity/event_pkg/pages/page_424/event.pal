# event.pal - Time Skip 5: forward 1d4 (finish rule applies) (trigger cast_timeskip). Every line is one tiny op run with cwd = the game state dir; see README for the ops.
exec ops/+x/rand_roll.+x . dice_seed rand_counter abilities.pdl:ab_1_die ts_roll
exec ops/+x/var_math.+x . set fcur act_pos
exec ops/+x/var_math.+x . add ftgt act_pos ts_roll
exec ops/+x/event_page_op.+x . . --trigger finrule --state .
exec ops/+x/var_math.+x . set ph_cast 3
halt
