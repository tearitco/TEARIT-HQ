# event.pal - Land 5: first ninja to Finish wins (also an enemy sent there) (trigger land). Every line is one tiny op run with cwd = the game state dir; see README for the ops.
exec ops/+x/var_math.+x . set winner lp
exec ops/+x/var_math.+x . set winner_n ln
exec ops/+x/var_math.+x . set switches.txt:game_over 1
exec ops/+x/var_math.+x . set game_over_reason 1
exec ops/+x/row_append.+x . ledger.txt WIN {turn} {lp} {ln}
halt
