# event.pal - TurnStart 2: seat 3 - stances (Block, shield) and the free-Block flag end with the owner's new turn (trigger turnstart). Every line is one tiny op run with cwd = the game state dir; see README for the ops.
exec ops/+x/var_math.+x . set guard_3_1 0
exec ops/+x/var_math.+x . set shield_3_1 0
exec ops/+x/var_math.+x . set fb_3_1 0
exec ops/+x/var_math.+x . set guard_3_2 0
exec ops/+x/var_math.+x . set shield_3_2 0
exec ops/+x/var_math.+x . set fb_3_2 0
exec ops/+x/var_math.+x . set guard_3_3 0
exec ops/+x/var_math.+x . set shield_3_3 0
exec ops/+x/var_math.+x . set fb_3_3 0
exec ops/+x/var_math.+x . set guard_3_4 0
exec ops/+x/var_math.+x . set shield_3_4 0
exec ops/+x/var_math.+x . set fb_3_4 0
exec ops/+x/var_math.+x . set guard_3_5 0
exec ops/+x/var_math.+x . set shield_3_5 0
exec ops/+x/var_math.+x . set fb_3_5 0
halt
