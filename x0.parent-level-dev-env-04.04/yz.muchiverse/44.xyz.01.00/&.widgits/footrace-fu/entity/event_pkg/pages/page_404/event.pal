# event.pal - CastCheck 5: double sixes (trigger castcheck). Every line is one tiny op run with cwd = the game state dir; see README for the ops.
exec ops/+x/dice_roll.+x . dice_seed dice_counter
exec ops/+x/var_math.+x . eq c6a dice1 6
exec ops/+x/var_math.+x . eq c6b dice2 6
exec ops/+x/var_math.+x . mul cc_ok c6a c6b
halt
