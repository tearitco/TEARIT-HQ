# event.pal - Combat 6: defender re-roll (trigger combat). Every line is one tiny op run with cwd = the game state dir; see README for the ops.
exec ops/+x/dice_roll.+x . dice_seed dice_counter
exec ops/+x/var_math.+x . set d_die dice2
exec ops/+x/var_math.+x . add d_roll d_die d_blk
exec ops/+x/var_math.+x . set rr_{cmb_dp}_{cmb_dn} 1
exec ops/+x/row_append.+x . ledger.txt REROLL {turn} {cmb_dp} {cmb_dn} defender {d_die}
halt
