# event.pal - Move 20: log, done (trigger move). Every line is one tiny op run with cwd = the game state dir; see README for the ops.
exec ops/+x/row_append.+x . ledger.txt ACT {turn} {current} {sel} move {mv_die} {mv_dist} {act_pos} {ftgt} {fin_cancel} {mv_go}
exec ops/+x/var_math.+x . set ph_move 0
halt
