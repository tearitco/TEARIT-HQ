# event.pal - Warp Ally 3: pay, count, check the coin flip (trigger cast_warp). Every line is one tiny op run with cwd = the game state dir; see README for the ops.
exec ops/+x/var_math.+x . sub tokens tokens g_cost
exec ops/+x/var_math.+x . add use_{g_ab}_{current}_{sel} g_use 1
exec ops/+x/var_math.+x . add tp_{current}_{sel} g_tp g_tele
exec ops/+x/var_math.+x . set g_cdv abilities.pdl:ab_{g_ab}_cd
exec ops/+x/var_math.+x . add rdy_{g_ab}_{current}_{sel} round g_cdv
exec ops/+x/event_page_op.+x . . --trigger castcheck --state .
exec ops/+x/var_math.+x . set wp current
exec ops/+x/var_math.+x . set wn ally_1
exec ops/+x/var_math.+x . set ph_cast 2
halt
