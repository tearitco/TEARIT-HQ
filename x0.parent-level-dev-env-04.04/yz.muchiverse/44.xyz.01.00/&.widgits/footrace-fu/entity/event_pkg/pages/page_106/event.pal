# event.pal - EndTurn 5: turn cap -> draw (winner 0, reason 4) (trigger endturn). Every line is one tiny op run with cwd = the game state dir; see README for the ops.
exec ops/+x/var_math.+x . set switches.txt:game_over 1
exec ops/+x/var_math.+x . set game_over_reason 4
exec ops/+x/var_math.+x . set winner 0
exec ops/+x/row_append.+x . ledger.txt DRAW {turn}
halt
