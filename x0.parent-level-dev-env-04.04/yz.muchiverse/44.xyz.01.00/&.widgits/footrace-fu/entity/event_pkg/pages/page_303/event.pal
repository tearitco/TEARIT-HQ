# event.pal - Move 4: refused (dead ninja or not enough tokens): nothing changes (trigger move). Every line is one tiny op run with cwd = the game state dir; see README for the ops.
exec ops/+x/row_append.+x . ledger.txt REFUSE {turn} {current} {sel} move {act_alive} {tokens}
exec ops/+x/var_math.+x . set ph_move 0
halt
