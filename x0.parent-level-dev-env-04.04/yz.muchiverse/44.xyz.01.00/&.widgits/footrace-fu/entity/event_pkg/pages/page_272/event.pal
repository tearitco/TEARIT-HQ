# event.pal - ArmyCheck 3: no army left (both last ninjas fell together) -> draw (trigger armycheck). Every line is one tiny op run with cwd = the game state dir; see README for the ops.
exec ops/+x/var_math.+x . set winner 0
exec ops/+x/var_math.+x . set winner_n 0
exec ops/+x/var_math.+x . set switches.txt:game_over 1
exec ops/+x/var_math.+x . set game_over_reason 3
exec ops/+x/row_append.+x . ledger.txt DRAW {turn}
halt
