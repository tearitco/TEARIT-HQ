# event.pal - Setup: seat 3 is in the game (players >= 3): alive, start cash from the bank (trigger setup). Every line is one tiny op run with cwd = the game state dir; see README for the ops.
exec ops/+x/var_math.+x . set alive_3 1
exec ops/+x/cash_transfer.+x . bank 3 rules.pdl:start_cash start
halt
