# event.pal - Buy 1/3: load cash and the tile price, can the player afford it (trigger buy). Every line is one tiny op run with cwd = the game state dir; see README for the ops.
exec ops/+x/var_math.+x . set cur_cash cash_{current}
exec ops/+x/var_math.+x . set cur_pos pos_{current}
exec ops/+x/tile_lookup.+x . cur_pos price tile_price
exec ops/+x/var_math.+x . ge can_buy cur_cash tile_price
halt
