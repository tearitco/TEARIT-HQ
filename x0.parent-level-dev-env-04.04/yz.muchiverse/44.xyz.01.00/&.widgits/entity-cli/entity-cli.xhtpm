<!-- One real cli_io. Enter runs the typed line. Escape leaves the
     field. The shared renderer draws ^ while the field is armed. -->
<window label="Cli-io" class="single-click">
  <page name="main">
    <panel id="body" class="settings-block">
      <text label="Type a command. Enter commits. Escape leaves the field."/>
      <text label="range a1 b2 2 6   or   advance page"/>
      <cli_io id="cmd" target_id="cmd" label="&gt; " action="'${PKG}/ops/entity_cli_commit.sh'"/>
    </panel>
  </page>
</window>
