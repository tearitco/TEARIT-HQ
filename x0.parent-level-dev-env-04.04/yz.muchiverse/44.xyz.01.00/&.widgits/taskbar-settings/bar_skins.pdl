# bar_skins.pdl - RPG Maker tile bar skins the taskbar-settings window can switch between.
# SKIN | id | label | left folder | middle folder | right folder
# bar_skin= in #.desktop/hq_ui.pdl names an id; empty = off.
# stone-ledge and wood-rail are the two already on branch claude.
# The eight below are new looks. Text-band is where the opaque bar sits in the 48px cell.
# upper: timber-brace, stone-arch, metal-truss
# center: wood-posts, neon-tube, iron-gate, red-curtain
# lower: white-panel, and the existing wood-rail (bottom plank)
SKIN | stone-ledge | Stone ledge | &.widgits/taskbar-settings/skins/stone-ledge/left | &.widgits/taskbar-settings/skins/stone-ledge/mid | &.widgits/taskbar-settings/skins/stone-ledge/right
SKIN | wood-rail | Wood rail | &.widgits/taskbar-settings/skins/wood-rail/left | &.widgits/taskbar-settings/skins/wood-rail/mid | &.widgits/taskbar-settings/skins/wood-rail/right
SKIN | timber-brace | Timber brace | &.widgits/taskbar-settings/skins/timber-brace/left | &.widgits/taskbar-settings/skins/timber-brace/mid | &.widgits/taskbar-settings/skins/timber-brace/right
