<!-- taskbar-settings-pal.xhtpm - static-template port of the swatch-picker /
     taskbar-settings window that today runs as the g_is_swatch_picker C
     path inside khtpm_core_render.c.

     WHY THE CLASS IS SAFE: khtpm_core_render.c (~line 17902) sets
     g_is_swatch_picker only on an EXACT class-token match of
     "swatch-picker". This window's classes are "taskbar-settings-pal"
     and "database-window" - neither trips g_is_swatch_picker,
     g_is_db_hq, g_is_events_hq, g_is_palettes, g_is_bookmarks or
     g_is_stats_hq (those match "db-hq" / "events-hq" / "palettes" /
     "bookmarks" / "stats-hq" respectively). So this is a plain generic
     default/popup window.

     WHY IT STILL WORKS WITHOUT THE FLAG:
       * The swatch-grid LAYOUT path (khtpm_core_render.c ~8716) keys on
         "is there any <item class=\"swatch\"> among the page children",
         not on g_is_swatch_picker. 12 swatches + the non-swatch
         opacity/close items get positioned exactly as the old window.
       * dispatch() handles "PICK:<n>", "OPACITY_MINUS", "OPACITY_PLUS"
         and "CLOSE" as generic recognised action tokens (~8918-8949),
         also not flag-gated. "PICK:<n>" writes
         #.desktop/taskbar_settings_action.txt with an incrementing seq,
         which the UNMODIFIED swatch_picker_manager.c already consumes.

     THE PROJECTOR: the <module> forks taskbar_settings_projector.+x. It
     READS the manager's published state file
     (#.desktop/taskbar_settings_state.txt: phase/bg/fg/apply) and
     WRITES #.desktop/taskbar_settings_ui.txt (key=value), content-gated.
     This template consumes that file via vars= and ${...}. A token that
     starts with '#' in vars= resolves against house_root
     (kh_find_vars_attr), so this is <house>/#.desktop/taskbar_settings_ui.txt.

     THE MANAGER: the generic default/popup mode does NOT fork the
     manager (only the g_is_swatch_picker path did, ~18736), so
     button-pal.sh starts swatch_picker_manager.+x alongside the
     renderer. The manager is used verbatim - no edits.

     3RD-STATE "CHOSEN" RING: the projector emits sw_<i>_ring = "ring-bg"
     for the chosen background swatch, "ring-fg" for the chosen
     foreground swatch, "" otherwise. Substituted into class=; the ring
     is a CSS border (draw_elem() paints border-color on top of the
     swatch bg fill). No renderer change needed. -->
<window label="taskbar settings - ${prompt}" class="taskbar-settings-pal database-window" vars="#.desktop/taskbar_settings_ui.txt">
  <module src="&.widgits/taskbar-settings/ops/+x/taskbar_settings_projector.+x"/>
  <page name="main">
    <!-- REAL, NEW 2026-09-04, direct live request ("can we add grey and
         brown to swatch colors... that shouldn't be hardcoded, should
         be from layout/module") - the swatch list is now a real
         <repeat> over what taskbar_settings_projector.c publishes
         (n_swatches / sw_<i>_name / sw_<i>_hex / sw_<i>_ring), itself
         read from &.widgits/taskbar-settings/swatches.pdl - not a
         fixed set of 12 hardcoded <item class="sw-<name>"> tags +
         matching compile-time CSS rules. Color comes from the new,
         generic bg="${...}" attribute (apply_attr()/draw_elem()) -
         an arbitrary hex a manager/projector can publish per element -
         instead of a class name. Add/remove a row in swatches.pdl and
         this grid (plus swatch_picker_manager.c's own PICK:<n> -> hex
         mapping) picks it up on next launch, no template/CSS edit. -->
    <repeat count="${n_swatches}" bind="sw">
    <item id="sw${sw.#}" action="PICK:${sw.#}" class="swatch ${sw.ring} ${sw.tone}" bg="${sw.hex}" label="${sw.name}"/>
    </repeat>
    <!-- 2026-10-08 RELAYOUT (owner: "id like some kind of change on the
         settings window... i need evidence on my io this is moving
         forward usably"). The generic swatch-grid layout puts every
         non-swatch <item> in chip rows ABOVE the grid and starts a new
         row whenever an item's FIRST class changes, so each setting is
         its own row: first class = the row name, second = the look.
         Each row leads with a value chip (current opacity/size/font/
         click mode, published by taskbar_settings_projector.+x) so a
         button sits next to the value it changes. Swatch labels pick a
         readable tone per fill (sw.tone). Ids and actions are unchanged,
         so every relay/harness that drives them still works. -->
    <item id="colors-info" class="row-colors info-chip info-wide" label="${colors_label}"/>
    <item id="opacity-value" class="row-opacity info-chip skin-bar" label="${opacity_label}"/>
    <item id="opacity-minus" action="OPACITY_MINUS" class="row-opacity opacity-btn step-btn" label="-"/>
    <item id="opacity-plus"  action="OPACITY_PLUS"  class="row-opacity opacity-btn step-btn" label="+"/>
    <item id="size-value" class="row-size info-chip skin-bar" label="${size_label}"/>
    <item id="ui-scale-minus" action="UI_SCALE_MINUS" class="row-size opacity-btn step-btn" label="-"/>
    <item id="ui-scale-plus"  action="UI_SCALE_PLUS"  class="row-size opacity-btn step-btn" label="+"/>
    <item id="font-family-name" class="row-font info-chip skin-bar" label="${font_label}"/>
    <item id="font-family-prev" action="UI_FONT_FAMILY_PREV" class="row-font opacity-btn step-btn" label="&lt;"/>
    <item id="font-family-next" action="UI_FONT_FAMILY_NEXT" class="row-font opacity-btn step-btn" label="&gt;"/>
    <!-- RPG Maker tile bars (2026-10-08): the row cycles bar_skin= off -> skins in bar_skins.pdl. Elements with
         class="skin-bar" draw as whole tile blocks while a skin is on (khtpm_draw_core.c kh_draw_bar_skin); the
         value chips above opt in too, and the preview below shows a 7-block bar with a sample label. -->
    <item id="bar-skin-value" class="row-bars info-chip skin-bar" label="${bar_skin_label}"/>
    <item id="bar-skin-prev" action="BAR_SKIN_PREV" class="row-bars opacity-btn step-btn" label="&lt;"/>
    <item id="bar-skin-next" action="BAR_SKIN_NEXT" class="row-bars opacity-btn step-btn" label="&gt;"/>
    <item id="click-twostep-toggle" action="CLICK_TWOSTEP_TOGGLE" class="row-click opacity-btn" label="${click_two_step_label} (press to switch)"/>
    <repeat count="${n_skins}" bind="sk">
    <item id="skin${sk.#}" action="BAR_SKIN_SET:${sk.id}" class="row-skins skin-pick ${sk.bar} ${sk.ring}" label="${sk.label}"/>
    </repeat>
    <item id="bar-preview" class="row-preview info-chip skin-bar bar-big" label="book:pre-design"/>
    <item id="close" action="CLOSE" class="close-btn" label="x"/>
  </page>
</window>
