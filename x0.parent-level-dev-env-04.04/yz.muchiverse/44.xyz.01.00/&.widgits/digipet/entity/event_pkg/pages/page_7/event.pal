# event.pal - Status: write status.txt (label line, then the value, for hunger coins apples hp hungry days)
# hand-written in the registry PAL shape (relative paths; event_page_op runs it with cwd = the entity state dir)
li x15, 1
li x13, 1
ecall "status.txt"
addi x5, x12, 0
li x15, 3
addi x12, x5, 0
ecall "hunger"
li x15, 6
li x13, 0
ecall "variables.txt" "hunger"
addi x13, x12, 0
li x15, 4
addi x12, x5, 0
ecall
li x15, 3
addi x12, x5, 0
ecall "coins"
li x15, 6
li x13, 0
ecall "variables.txt" "coins"
addi x13, x12, 0
li x15, 4
addi x12, x5, 0
ecall
li x15, 3
addi x12, x5, 0
ecall "apples"
li x15, 6
li x13, 0
ecall "items.txt" "item_apple"
addi x13, x12, 0
li x15, 4
addi x12, x5, 0
ecall
li x15, 3
addi x12, x5, 0
ecall "hp"
li x15, 6
li x13, 0
ecall "actor_1_stats.txt" "hp"
addi x13, x12, 0
li x15, 4
addi x12, x5, 0
ecall
li x15, 3
addi x12, x5, 0
ecall "hungry"
li x15, 6
li x13, 0
ecall "actor_states.txt" "state_1:1"
addi x13, x12, 0
li x15, 4
addi x12, x5, 0
ecall
li x15, 3
addi x12, x5, 0
ecall "days"
li x15, 6
li x13, 0
ecall "variables.txt" "days"
addi x13, x12, 0
li x15, 4
addi x12, x5, 0
ecall
halt
