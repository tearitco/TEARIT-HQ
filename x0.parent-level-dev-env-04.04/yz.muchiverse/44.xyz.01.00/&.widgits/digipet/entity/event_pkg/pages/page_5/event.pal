# event.pal - Feed page 5 (has food, hunger >= nutrition): eat, hunger -= nutrition_apple, change_items -1
# hand-written in the registry PAL shape (relative paths; event_page_op runs it with cwd = the entity state dir)
li x15, 6
li x13, 0
ecall "needs_tunables.pdl" "nutrition_apple"
addi x2, x12, 0
li x15, 6
li x13, 0
ecall "variables.txt" "hunger"
_l2:
beq x2, x0, _d2
addi x12, x12, -1
addi x2, x2, -1
j _l2
_d2:
li x15, 7
ecall "variables.txt" "hunger"
li x15, 6
li x13, 0
ecall "items.txt" "item_apple"
addi x12, x12, -1
li x15, 7
ecall "items.txt" "item_apple"
li x15, 6
li x13, 0
ecall "variables.txt" "fed_total"
addi x12, x12, 1
li x15, 7
ecall "variables.txt" "fed_total"
halt
