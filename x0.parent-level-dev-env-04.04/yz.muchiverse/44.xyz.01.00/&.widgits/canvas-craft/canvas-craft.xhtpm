<!-- canvas-craft.xhtpm - PHASE 1 (CANVAS-CRAFT-DESIGN.md).
     Static layout only, rendered by the shared khtpm_core_render.+x.
     class="canvas-craft-window database-window": neither token hits a
     g_is_* strcmp trigger, so this rides the generic sidebar/panel/
     scrolllist path - zero new renderer C ("database-window" is
     CSS-only, same trick chat-hai / events-hq / irc-chat-hq use).

     One <module>: ops/+x/canvascraft_manager.+x - parses the recipe
     registry, runs the quantity resolver, publishes canvas-craft_ui.txt
     (consumed here via vars=), polls canvas-craft_action.txt written by
     ops/cc_item.sh.

     Phase 1 = LEFT recipe list + MIDDLE recipe card, read-only (have=0).
     RIGHT inventory panel, the POE tab, the formula bar, drag-to-place
     and the atom inspector are later phases. -->
<window label="Canvas-Craft" class="canvas-craft-window database-window" vars="canvas-craft_ui.txt">
  <module src="&.widgits/canvas-craft/ops/+x/canvascraft_manager.+x"/>
  <page name="main">

    <sidebar id="sidebar" class="cc-sidebar">
      <text id="side-hdr" label="Recipes" class="cc-side-hdr"/>
      <scrolllist class="from-top">
        <repeat count="${n_recipes}" bind="rc">
          <item id="rc${rc.#}" class="cc-recipe ${rc.cls}" label="${rc.name}"
                action="'${PKG}/ops/cc_item.sh' 'SELECT ${rc.id}'"/>
        </repeat>
      </scrolllist>
    </sidebar>

    <panel id="content" class="cc-panel">
      <text id="pick-hint" class="cc-quiet"
            label="Pick a recipe on the left." show="${sel_empty}"/>

      <text id="sel-name" class="cc-sel-name"
            label="${sel_name}   x${sel_yield}" show="${sel_show}"/>
      <text id="sel-sub" class="cc-sel-sub"
            label="${sel_tier}   -   ${sel_pne}" show="${sel_show}"/>

      <text id="ing-hdr" class="cc-ing-hdr"
            label="Ingredients (highest common denominator):" show="${sel_show}"/>
      <scrolllist class="from-top">
        <repeat count="${n_ing}" bind="ing">
          <text id="ing${ing.#}" class="cc-ing"
                label="${ing.have} / ${ing.need}   ${ing.name}   ${ing.bar}"/>
        </repeat>
      </scrolllist>

      <text id="sel-note" class="cc-note" label="${sel_note}" show="${sel_note}"/>
      <text id="craft-btn" class="cc-craft" label="[  CRAFT  ]" show="${sel_show}"/>
    </panel>

  </page>
</window>
