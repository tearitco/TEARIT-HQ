# hq_ui.pdl - per-desktop UI options read by khtpm_core_render (every
# HQ / x11-hq window). Plain key=value. Live-reloaded.

# close_combo: the ONLY keyboard gesture that closes a focused window
# (Escape deliberately does NOT - too easy to hit by accident). The
# window's [X] chrome button always works too. Format: ctrl+<key>,
# optionally with shift:  ctrl+c   ctrl+q   ctrl+w   ctrl+shift+w
close_combo=ctrl+c

# win_top_y: y (px) where a new HQ window spawns / fullscreen starts /
# window drag is clamped - clears the GNOME panel + livedesk top strip.
# Bump it if a window opens too high (into the top taskbar).
win_top_y=96

# click_two_step: 1 = first click focuses, second activates (default).
#   0 = one click activates.
click_two_step=1
