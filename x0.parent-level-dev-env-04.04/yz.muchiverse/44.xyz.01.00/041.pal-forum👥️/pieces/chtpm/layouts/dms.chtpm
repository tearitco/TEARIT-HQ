<panel time_reactive="true">
    <module>system/prisc+x pal/dms_module.pal</module>
    <interact src="pieces/apps/player_app/interact_relay.txt" />
    <text label="+============================================================+" /><br/>
    <text label="|                        M E S S A G E S                       |" /><br/>
    <text label="+============================================================+" /><br/>
    <cli_io id="dm_to_input" label="Recipient User ID" target_id="dm_to_input" /><br/>
    <cli_io id="dm_text_input" label="Message" target_id="dm_text_input" /><br/>
    ${piece_methods}
    <button label="Back to Home" href="pieces/chtpm/layouts/home.chtpm" /><br/>
    <text label="+============================================================+" /><br/>
    <text label="${game_map}" /><br/>
    <text label="+============================================================+" /><br/>
    <text label=" (Ctrl+C to quit)" /><br/>
</panel>
