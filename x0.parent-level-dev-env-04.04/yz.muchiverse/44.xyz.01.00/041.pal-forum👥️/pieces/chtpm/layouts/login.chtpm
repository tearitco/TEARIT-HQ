<panel time_reactive="true">
    <module>system/prisc+x pal/login_module.pal</module>
    <interact src="pieces/apps/player_app/interact_relay.txt" />
    <text label="+============================================================+" /><br/>
    <text label="|                       P A L - F O R U M                     |" /><br/>
    <text label="+============================================================+" /><br/>
    <cli_io id="user_id_input" label="User ID" target_id="user_id_input" /><br/>
    <cli_io id="display_name_input" label="Display Name" target_id="display_name_input" /><br/>
    ${piece_methods}
    <button label="Continue to Home" href="pieces/chtpm/layouts/home.chtpm" visibility="${logged_in}" /><br/>
    <text label="+============================================================+" /><br/>
    <text label="${game_map}" /><br/>
    <text label="+============================================================+" /><br/>
    <text label=" (Ctrl+C to quit)" /><br/>
</panel>
