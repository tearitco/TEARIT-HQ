# pal-chat-irc main_loop_chtpm.pal - persistent screen-dispatch loop,
# direct copy of pal-forum's/pal-chain's own proven shape - real href
# navigation + ${piece_methods} KEY:n dispatch + real <cli_io> free
# text, NO onClick="INTERACT", no map. Runs forever (matching real
# fuzz-op_manager.c's own persistent-daemon precedent - see
# xyzos-standards.txt sec. 0-CORRECTED), surviving every href screen
# switch via chtpm_parser_pal.c's own liveness-based launch_module()
# guard.
#
# chat_menu_input x9 (x9 always 0) runs every loop tick - a cheap,
# usually-no-op check that catches up on a real href screen change
# chtpm just made on its own, gated on
# pieces/display/chat_screen_changed.txt so this doesn't recompose on
# every idle tick.
# PRE-SYNC BEFORE FIRST COMPOSE (mass-refactor 2026-07-26, same fix
# applied to muchi-pals' main_loop_chtpm.pal - see that project's own
# header comment for the full "[No Methods]"-style stale-first-render
# root cause: this module is killed+relaunched on every href transition,
# so an unconditional compose before the loop's own first idle-sync
# would read dynamic content from before this screen's own METHOD rows
# had ever been generated for it).
li x1, 0

li x9, 0
chat_menu_input x9
chat_compose_frame
hit_frame
read_pos x7, "pieces/display/chat_screen_changed.txt"

loop:
li x9, 0
chat_menu_input x9
read_pos x8, "pieces/display/chat_screen_changed.txt"
beq x7, x8, check_key
addi x7, x8, 0
j render

check_key:
read_history pieces/apps/player_app/interact_relay.txt x2, x1
beq x2, x0, no_key
chat_menu_input x2
j render

no_key:
sleep 30000
j loop

render:
chat_compose_frame
hit_frame
sleep 30000
j loop
