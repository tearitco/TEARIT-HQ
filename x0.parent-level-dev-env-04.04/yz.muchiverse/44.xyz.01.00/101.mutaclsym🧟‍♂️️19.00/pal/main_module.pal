# main_module.pal - pieces/chtpm/layouts/main.chtpm's own dedicated
# module. INPUT ARCHITECTURE: reads from player_app/history.txt
# (same file keyboard_input.c and x11_mirror.c write to via append_key()).
# NOT interact_relay.txt — keyboard_input never writes there.
li x1, 0

drain:
read_history pieces/apps/player_app/history.txt x2, x1
beq x2, x0, drain_done
j drain
drain_done:

li x9, 0
mua_menu_input x9
mua_compose_frame
hit_frame
read_pos x7, "pieces/display/pc_screen_changed.txt"

loop:
li x9, 0
mua_menu_input x9
read_pos x8, "pieces/display/pc_screen_changed.txt"
beq x7, x8, check_key
addi x7, x8, 0
j render

check_key:
read_history pieces/apps/player_app/history.txt x2, x1
beq x2, x0, no_key
mua_menu_input x2
j render

no_key:
sleep 30000
j loop

render:
mua_compose_frame
hit_frame
sleep 30000
j loop
