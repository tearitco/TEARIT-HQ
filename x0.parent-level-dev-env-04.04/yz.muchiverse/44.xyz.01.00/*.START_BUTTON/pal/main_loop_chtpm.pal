# start-button main loop — house pal shape
# idle tick bridges active_target_id after href; keys dispatch RUN handoff
li x1, 0

start_compose_frame
hit_frame
read_pos x7, "pieces/display/start_screen_changed.txt"

loop:
li x9, 0
start_menu_input x9
read_pos x8, "pieces/display/start_screen_changed.txt"
beq x7, x8, check_key
addi x7, x8, 0
j render

check_key:
read_history pieces/apps/player_app/interact_relay.txt x2, x1
beq x2, x0, no_key
start_menu_input x2
j render

no_key:
sleep 30000
j loop

render:
start_compose_frame
hit_frame
sleep 30000
j loop
