# user-pal main_loop_chtpm.pal - persistent screen-dispatch loop,
# direct copy of pal-forum's/pal-chain's own proven shape
# (USER-PAL-STANDARD.txt sec. 3) - real ${piece_methods} KEY:n dispatch
# + real <cli_io> free text, NO onClick="INTERACT", no map, no href
# navigation (user-pal has exactly one screen).
#
# userpal_menu_input x9 (x9 always 0) runs every loop tick as a cheap
# no-op catch-up check (same shape as chain/forum, kept for structural
# consistency even though user-pal never navigates - see
# userpal_menu_input.c's own header comment).
li x1, 0

userpal_compose_frame
hit_frame
read_pos x7, "pieces/display/userpal_screen_changed.txt"

loop:
li x9, 0
userpal_menu_input x9
read_pos x8, "pieces/display/userpal_screen_changed.txt"
beq x7, x8, check_key
addi x7, x8, 0
j render

check_key:
read_history pieces/apps/player_app/interact_relay.txt x2, x1
beq x2, x0, no_key
userpal_menu_input x2
j render

no_key:
sleep 30000
j loop

render:
userpal_compose_frame
hit_frame
sleep 30000
j loop
