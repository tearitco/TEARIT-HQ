# avatar-creation main_loop - same shape as muchi-pals/user-pal
# (idle sync before first compose, marker-driven render only).
li x1, 0

li x9, 0
avatar_menu_input x9
avatar_compose_frame
hit_frame
read_pos x7, "pieces/display/avatar_screen_changed.txt"

loop:
li x9, 0
avatar_menu_input x9
read_pos x8, "pieces/display/avatar_screen_changed.txt"
beq x7, x8, check_key
addi x7, x8, 0
j render

check_key:
read_history pieces/apps/player_app/interact_relay.txt x2, x1
beq x2, x0, no_key
avatar_menu_input x2
j render

no_key:
sleep 30000
j loop

render:
avatar_compose_frame
hit_frame
sleep 30000
j loop
