<panel time_reactive="true">
  <module>system/prisc+x pal/horn_main_loop.pal</module>
  <interact src="pieces/apps/player_app/interact_relay.txt" />
  <text label="╔══════════════════════════════════════════════════════════════╗" /><br/>
  <text label="║  HORN_CHAT v0.1   OpenRouter · prisc+x + chtpm           [/] quit  ║" /><br/>
  <text label="╚══════════════════════════════════════════════════════════════╝" /><br/>
  <text label="  model: ${horn_model}" /><br/>
  <text label="  status: ${horn_status}" /><br/>
  <text label="  turns: ${horn_turns}" /><br/>
  <text label="╟──────────────────────────────────────────────────────────────╢" /><br/>
  <text label="${game_map}" /><br/>
  <text label="╟──────────────────────────────────────────────────────────────╢" /><br/>
  <!-- target_id, NOT id="input_text". chtpm's compose_frame() re-parses the
       whole layout whenever the "input_text" variable changes, and a cli_io
       with that id live-syncs every keystroke into it - so the layout is
       torn down and rebuilt between characters and the element's input
       buffer is lost, leaving a box that shows one character at a time.
       Under a target_id the sync goes to that key instead, "input_text"
       never changes, and the buffer survives. -->
  <cli_io id="horn_prompt" target_id="horn_prompt" label="  you: " /><br/>
  <text label="╚══════════════════════════════════════════════════════════════╝" /><br/>
</panel>