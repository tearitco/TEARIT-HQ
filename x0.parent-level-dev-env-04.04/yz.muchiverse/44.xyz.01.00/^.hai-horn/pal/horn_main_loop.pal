# horn_main_loop.pal - HORN_CHAT's pal-native main loop.
#
# Launched by the layout's own <module> tag (layouts/horn_chat.chtpm), so
# chtpm_parser_pal forks this once at parse time and keeps it alive for
# the whole session. It is a dispatch table and nothing else: every real
# behaviour lives in ops/, so this file stays readable as "what happens on
# which keystroke".
#
# INPUT CONTRACT (why this loop looks like this):
#
#   The composer is a chtpm <cli_io>, which chtpm owns completely. It
#   accumulates keystrokes into its own element buffer and renders them
#   itself; this loop never sees a character. On Enter, chtpm's own
#   process_key() handler does three things (see chtpm_parser_pal.c's
#   cli_io Enter branch):
#     1. saves the full typed text to gui_state.txt under "horn_prompt"
#     2. clears its element buffer and sets suppress_next_gui_sync
#     3. injects raw key 13 into the <interact> relay file
#
#   So the ONLY signal reaching us is that single 13. That is deliberate
#   on chtpm's part and it is why this loop reads the relay file rather
#   than the keyboard history: reading keyboard/history.txt would see
#   every character and race chtpm's own buffer. This is the same
#   conclusion the handoff reached about '@' completion - prompt-level
#   parsing is a harness concern, not a parser one.
#
#   The approve/deny keys arrive the same way: the layout's buttons use
#   onClick="KEY:1" / "KEY:0", which chtpm turns into injected keycodes on
#   the same relay.
#
#   Keys we deliberately ignore: everything else. Navigation, editing and
#   rendering are chtpm's job.

li x1, 0                    # byte cursor into the interact relay
li x2, 13                   # Enter
li x10, 0                   # scratch / "no key"
li x12, 0                   # comparison scratch
li x13, 0                   # idle-tick counter for the pending poll
li x14, 20                  # poll cadence, in ticks

# Start the cursor at the CURRENT END of the relay, not at 0. The relay is
# append-only and is NOT cleared between sessions, so a fresh pal loop
# starting at 0 would replay every Enter the user ever pressed - each one
# re-dispatching horn_turn against whatever text is in gui_state right now.
# That showed up live as phantom turns in the transcript after a restart,
# duplicating history.
read_pos x1, pieces/apps/player_app/interact_relay.txt

# ── main loop ────────────────────────────────────────────────────────
loop:
    # Incremental tail of the relay file. Literal-path form (3-arg) so
    # the cursor register actually advances; the 2-arg form silently
    # leaves it at r0, which is reset every instruction, and would
    # re-read byte 0 forever.
    read_history pieces/apps/player_app/interact_relay.txt x11, x1

    # No new key this tick: 0 means EOF/nothing to read.
    beq x11, x10, idle

    # Enter FIRST. The approve/deny labels sit below this block; an earlier
    # version put them above it, which stranded "exec horn_turn" inside the
    # deny branch where nothing could reach it, so Enter fell through to the
    # approve branch and every submitted message silently vanished.
    bne x11, x2, not_enter

    exec ../ops/+x/horn_turn.+x
    hit_frame
    j loop

not_enter:
    # Approve / deny for gated tools (see the "gate" list in
    # tools/horn_tools.json). These reach us at all only because horn_turn
    # detaches itself: the pal loop dispatches it with a BLOCKING exec, so a
    # turn that stopped to ask for approval would wedge the only process
    # able to deliver the answer.
    li x12, 49                  # '1' = approve
    beq x11, x12, approve
    li x12, 48                  # '0' = deny
    beq x11, x12, deny

    # Anything else belongs to chtpm's own handling.
    j loop

approve:
    exec ../ops/+x/horn_decide.+x y
    j loop

deny:
    exec ../ops/+x/horn_decide.+x n
    j loop

idle:
    # Poll for a pending approval, but NOT every tick.
    #
    # hq-cpu-safety.md 3c: anything added inside a tick loop that touches
    # more than one file needs an explicit answer to how often it actually
    # needs to run. This poll runs while the session is idle and the answer
    # is almost always "nothing pending" - and it costs file I/O, so every
    # tick is spending real CPU to learn nothing.
    #
    # Every 20th tick is ~2.4s at the 120ms sleep below. That is well
    # inside human reaction time for noticing a prompt appear, and it cuts
    # the idle cost by 20x. horn_turn ALSO publishes the moment it creates
    # a prompt, so this poll is only the belt-and-braces path, not the
    # primary one - which is what makes a slow cadence acceptable here.
    addi x13, x13, 1
    li x14, 20
    bne x13, x14, skip_pending_poll
    li x13, 0
    exec ../ops/+x/horn_publish_pending.+x
skip_pending_poll:
    # ~120ms between ticks. NEVER remove this sleep - hq-cpu-safety.md
    # names the house crash that came from an unthrottled idle-poll loop.
    sleep 120000
    j loop