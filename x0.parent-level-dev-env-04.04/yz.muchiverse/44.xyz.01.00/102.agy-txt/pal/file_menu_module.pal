# file_menu_module.pal - PHASE 2 per-screen module split (2026-07-31,
# #.haiku+/!.xyzos-standards+1.txt §41), proven first in 01.muchi-
# pals-🥚️-13.01, now applied here. pieces/chtpm/layouts/file_menu.chtpm's
# own DEDICATED module - editor.chtpm and file_menu.chtpm used to
# share one main_loop_chtpm.pal; each now gets its own, so
# chtpm_parser_pal.c's real launch_module() liveness check (kill+
# relaunch on genuine navigation, reuse while staying on one screen)
# applies per screen. Reuses the SAME shared ops (agy_compose_view,
# agy_edit_key) the original shared module also called - splitting
# those into per-screen dedicated files is a separate, later step.
# Structure is a straight copy of the original main_loop_chtpm.pal.
li x1, 0

agy_compose_view
hit_frame
read_pos x7, "pieces/display/editor_screen_changed.txt"

loop:
    li x9, 0
    agy_edit_key x9
    read_pos x8, "pieces/display/editor_screen_changed.txt"
    beq x7, x8, check_key
    addi x7, x8, 0
    j render

check_key:
    read_history pieces/apps/player_app/interact_relay.txt x2, x1
    beq x2, x0, no_key
    agy_edit_key x2
    j render

no_key:
    sleep 30000
    j loop

render:
    agy_compose_view
    hit_frame
    sleep 30000
    j loop
