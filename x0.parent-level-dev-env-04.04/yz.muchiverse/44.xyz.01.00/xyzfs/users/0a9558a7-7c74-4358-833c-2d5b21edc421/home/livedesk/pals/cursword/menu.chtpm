<window class="entity-menu">
  <page name="main">
    <item label="Dir" action="sh -c 'mkdir -p &quot;$0/audit&quot;; GDK_BACKEND=x11 xdg-open &quot;$0&quot; >>&quot;$0/audit/dir.log&quot; 2>&amp;1'"/>
    <item label="Chat" action="sh -c 'exec sh &quot;$1/&amp;.widgits/open-hai/chat_button.sh&quot; &quot;$1&quot; &quot;$0/chat&quot; cursword-chat'"/>
    <item label="Bookmarks" action="sh -c 'exec sh &quot;$1/&amp;.widgits/bookmarks/bm_menu.sh&quot; &quot;$1&quot; &quot;$0&quot;'"/>
    <item label="Play" action="sh -c 'exec sh &quot;$1/*.monads/*.muchi-pet/ops/play_event.sh&quot; &quot;$0&quot;'"/>
    <item label="Close" action="CLOSE"/>
    <item label="Cancel" action="void"/>
  </page>
</window>
