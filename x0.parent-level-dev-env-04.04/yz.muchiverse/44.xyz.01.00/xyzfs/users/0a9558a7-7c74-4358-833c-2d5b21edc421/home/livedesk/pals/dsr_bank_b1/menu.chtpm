<!-- menu.chtpm — dsr_bank_b1's real entity context menu, generated 2026-09-15
     (direct live report: "why do the new 'city entities' context menus
     have different color scheme than all the others?" - root cause:
     these 16 DSR pals had no menu.chtpm at all, so open_context_menu()
     fell through to the OLD legacy popup path (ENTITY-MENU-LEGACY-
     DEPRECATION-PLAN.md), which hardcodes WhitePixel/BlackPixel and
     never loads #.desktop/livedesk_theme.pdl - every OTHER entity
     (book-stack, ava, asa...) already has its own menu.chtpm and goes
     through the modern, themed khtpm_entity_menu_render.c path
     instead. Converted 1:1 from this entity's own real meta.pdl (same
     METHOD rows, same action strings verbatim), same real mechanical
     conversion rule book-stack/ava/asa's own menu.chtpm already use -
     not hand-designed, not a new template shape. -->
<window class="entity-menu">
  <page name="main">
    <item label="Events (hq)" action="sh -c 'exec &quot;$1/&amp;.widgits/events-hq/button.sh&quot; &quot;$0&quot; &quot;$1&quot;'"/>
    <item label="Dir" action="sh -c 'exec xdg-open &quot;$0&quot;'"/>
    <item label="Close" action="CLOSE"/>
    <item label="Cancel" action="void"/>
  </page>
</window>
