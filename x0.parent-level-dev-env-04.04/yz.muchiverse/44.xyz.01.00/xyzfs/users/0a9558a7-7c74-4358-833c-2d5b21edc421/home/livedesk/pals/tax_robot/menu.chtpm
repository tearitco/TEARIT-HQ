<window class="entity-menu">
  <page name="main">
    <item label="Play" action="sh -c 'exec sh &quot;$1/&amp;.widgits/events-hq/ops/play_event.sh&quot; &quot;$0&quot;'"/>
    <item label="Events (hq)" action="sh -c 'exec &quot;$1/&amp;.widgits/events-hq/button.sh&quot; &quot;$0&quot; &quot;$1&quot;'"/>
    <item label="Close" action="CLOSE"/>
    <cli_io id="cmd" target_id="cmd" label="Cli-io: " action="${HOUSE}/&amp;.widgits/entity-cli/ops/entity_cli_commit.sh"/>
  </page>
</window>
