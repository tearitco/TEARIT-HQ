<!-- menu.chtpm — asa's real entity context menu, Stage 2c
     ROLLOUT (2026-08-16, direct instruction "yes we need to finish those" -
     entity-context-menu rollout beyond ava). Converted 1:1 from this
     entity's own real meta.pdl (same METHOD rows, same action strings
     verbatim) via the same real mechanical conversion rule proven on ava/asa
     (scratchpad meta_to_chtpm.py) - action= values reuse the real shell
     commands as-is, &quot;/&amp; entity-decoded by khtpm_entity_menu_
     render.c's own apply_attr(), the same 2 entities that parser already
     supports. -->
<window class="entity-menu">
  <page name="main">
    <item label="Chat" action="sh -c 'cd &quot;$0&quot; &amp;&amp; H=&quot;$1&quot; &amp;&amp; exec gnome-terminal -- &quot;$H/@.apps/asa-&amp;-ava/pieces/asa/chat.sh&quot;'"/>
    <item label="Events" action="sh -c 'exec &quot;$1/&amp;.widgits/events-hq/button.sh&quot; &quot;$0&quot; &quot;$1&quot;'"/>
    <item label="Events (mock)" action="sh -c 'cd &quot;$0&quot; &amp;&amp; H=&quot;$1&quot; &amp;&amp; exec sh &quot;$H/&amp;.widgits/event-editor/gl_mock/button.sh&quot; run'"/>
    <item label="Events (ez)" action="sh -c 'cd &quot;$0&quot; &amp;&amp; H=&quot;$1&quot; &amp;&amp; exec env EZ_PKG_NAME=asa-$(cat &quot;$0/instance_id.txt&quot;) EZ_PKG_DIR=&quot;$H/@.apps/asa-&amp;-ava/pieces/asa/event_pkg&quot; sh &quot;$H/&amp;.widgits/event-ez/button.sh&quot; run-widget'"/>
    <item label="Play" action="sh -c 'cd &quot;$0&quot; &amp;&amp; H=&quot;$1&quot; &amp;&amp; test -f &quot;$H/@.apps/asa-&amp;-ava/pieces/asa/event_pkg/pages/page_1/event.pal&quot; &amp;&amp; exec &quot;$H/101.mutaclsym🧟‍♂️️+18.01/system/prisc+x&quot; &quot;$H/@.apps/asa-&amp;-ava/pieces/asa/event_pkg/pages/page_1/event.pal&quot;'"/>
    <item label="Stop" action="void"/>
    <item label="Ledger" action="sh -c 'cd &quot;$0&quot; &amp;&amp; H=&quot;$1&quot; &amp;&amp; exec gedit &quot;$H/@.apps/asa-&amp;-ava/pieces/asa/master_ledger.txt&quot;'"/>
    <item label="Dir" action="sh -c 'exec xdg-open &quot;$0&quot;'"/>
    <item label="Close" action="CLOSE"/>
    <item label="Cancel" action="void"/>
  </page>
</window>
