<!-- menu.chtpm — m8_redhorned's real entity context menu, Stage 2c
     ROLLOUT (2026-08-16, direct instruction "yes we need to finish those").
     Converted 1:1 from this entity's own real objects.pdl (same PAGE/OBJECT
     rows, same action strings verbatim) via the same real mechanical
     conversion rule proven on ava/asa (scratchpad objects_to_chtpm.py).
     KNOWN GAP, not silently papered over: khtpm_core_render.c's
     own dispatch() does not implement STATE:<key> (real text-input rows)
     yet - only CLOSE/void/GOTO:/BACK are real reserved forms there today,
     same as this house's other khtpm apps' own real STATE: gaps. The
     row(s) below fall through to the raw-shell-command branch and fail
     harmlessly (menu still closes) rather than crash - a real, pre-
     existing limitation, not a regression from this conversion:
       page=main label="Rename" action=STATE:pending_name
-->
<window class="entity-menu">
  <page name="main">
    <item label="Feed" action="void"/>
    <item label="Menu" action="/home/no/Desktop/🤖️🪤️🏠️/🥡️🪜️/🪜️-00.00/NNEST_CLEAN_PARENT/NNEST-11.17/x0.parent-level-dev-env-04.04/yz.muchiverse/44.xyz.01.00/*.monads/*.muchi-pet/ops/open_rp_menu.sh"/>
    <item label="Play" action="/home/no/Desktop/🤖️🪤️🏠️/🥡️🪜️/🪜️-00.00/NNEST_CLEAN_PARENT/NNEST-11.17/x0.parent-level-dev-env-04.04/yz.muchiverse/44.xyz.01.00/*.monads/*.muchi-pet/ops/play_event.sh"/>
    <item label="Events (ez)" action="/home/no/Desktop/🤖️🪤️🏠️/🥡️🪜️/🪜️-00.00/NNEST_CLEAN_PARENT/NNEST-11.17/x0.parent-level-dev-env-04.04/yz.muchiverse/44.xyz.01.00/*.monads/*.muchi-pet/ops/open_event_ez.sh"/>
    <item label="Events (hq)" action="sh -c 'exec &quot;$1/&amp;.widgits/events-hq/button.sh&quot; &quot;$0&quot; &quot;$1&quot;'"/>
    <item label="More" action="GOTO:activities"/>
    <item label="Rename" action="STATE:pending_name"/>
    <item label="Dir" action="xdg-open"/>
    <item label="Close" action="CLOSE"/>
    <item label="Cancel" action="void"/>
  </page>
  <page name="activities">
    <item label="Train" action="void"/>
    <item label="Rest" action="void"/>
    <item label="Tournament" action="void"/>
    <item label="Errantry" action="void"/>
    <item label="Back" action="BACK"/>
    <item label="Cancel" action="void"/>
  </page>
  <page name="menu">
    <item label="-- m8_redhorned --" action="void"/>
    <item label="Level: 1" action="void"/>
    <item label="XP: 0 / 100 to next" action="void"/>
    <item label="qolq (gold): 35" action="void"/>
    <item label="HP: 42 / 100" action="void"/>
    <item label="MP: 50 / 50" action="void"/>
    <item label="Items" action="GOTO:items"/>
    <item label="Skills" action="GOTO:skills"/>
    <item label="Status" action="GOTO:status"/>
    <item label="Back" action="BACK"/>
    <item label="Cancel" action="void"/>
  </page>
  <page name="items">
    <item label="-- Items (soon) --" action="void"/>
    <item label="(no items yet)" action="void"/>
    <item label="Back" action="BACK"/>
    <item label="Cancel" action="void"/>
  </page>
  <page name="skills">
    <item label="-- Skills (soon) --" action="void"/>
    <item label="(no skills yet)" action="void"/>
    <item label="Back" action="BACK"/>
    <item label="Cancel" action="void"/>
  </page>
  <page name="status">
    <item label="-- Status --" action="void"/>
    <item label="Name: m8_redhorned" action="void"/>
    <item label="Level: 1" action="void"/>
    <item label="XP: 0 / 100" action="void"/>
    <item label="qolq (gold): 35" action="void"/>
    <item label="HP: 42 / 100" action="void"/>
    <item label="MP: 50 / 50" action="void"/>
    <item label="Back" action="BACK"/>
    <item label="Cancel" action="void"/>
  </page>
</window>
