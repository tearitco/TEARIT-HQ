# task5_view_tab_switch_demo.pal - PROOF-OF-CONCEPT PAL-authored harness
# (2026-08-27, HARNESS-AUTHORING-GUIDE.md section 3 - proving PAL/event
# harness authoring is real, not just documented). Drives events-hq's
# Task 5 view-tab switch end-to-end using ONLY real prisc+x syscalls:
# opens the real relay file, injects digit '2' then Enter, polls the
# real events_hq_view_mode.txt sibling file until view_mode=1, then
# injects the PNG-dump code. No bash relay-injection used for the
# actual drive sequence below - only real ecall syscalls.
#
# Registers used, so a human reading this doesn't have to guess:
#   x12 - the "working" register: every syscall reads/writes its main
#         value here (fd for open/write/close, the read-back int for
#         GET_KV_INT). It gets clobbered by almost every ecall, which is
#         why the file handle is copied out to x14 immediately below.
#   x13 - the syscall's SECOND input register (open mode / GET_KV_INT
#         default value). Only meaningful right before the ecall that
#         reads it.
#   x14 - our own scratch register, holding the relay file's descriptor
#         (fd) safely across other syscalls that would otherwise
#         overwrite x12.
#   x15 - the syscall NUMBER (1=OPEN, 2=CLOSE, 3=WRITE_LINE, 6=GET_KV_INT,
#         7=SET_KV_INT - see prisc+x.c's own SYS_* #defines for the full,
#         authoritative list).
#   x2  - a plain scratch constant, used here to hold "1" for the
#         beq comparison against view_mode.

li x15, 1          # x15 = 1 -> next ecall will be SYS_OPEN
li x13, 2          # x13 = 2 -> open mode "append" (0=read,1=write,2=append)
ecall "/home/no/Desktop/🤖️🪤️🏠️/🥡️🪜️/🪜️-00.00/NNEST_CLEAN_PARENT/NNEST-11.17/x0.parent-level-dev-env-04.04/yz.muchiverse/44.xyz❤️‍🔥️00.17/#.desktop/events_hq_history.txt"  # open the real relay file; x12 <- fd (or -1 on failure)
addi x14, x12, 0   # x14 = x12 + 0, i.e. "mv x14, x12" - stash the fd where later syscalls can't clobber it

li x15, 3          # x15 = 3 -> next ecall will be SYS_WRITE_LINE
addi x12, x14, 0   # restore the saved fd into x12 (WRITE_LINE reads the fd from x12)
ecall "50"         # append the literal text "50\n" to the relay - ASCII 50 = digit '2', a real keypress the render process is polling for

li x15, 3          # x15 = 3 -> SYS_WRITE_LINE again
addi x12, x14, 0   # restore fd into x12 again (every ecall needs it fresh)
ecall "13"         # append "13\n" - ASCII 13 = Enter, activates whichever tab focus landed on after the '2' digit-jump

li x15, 2          # x15 = 2 -> SYS_CLOSE
addi x12, x14, 0   # fd into x12 one more time
ecall              # close the relay file handle - done injecting for this step

_poll:             # label: the top of our real "wait until ready" loop (hand-rolled - no Loop command exists yet, see HARNESS-AUTHORING-GUIDE.md 3b)
li x15, 6          # x15 = 6 -> next ecall will be SYS_GET_KV_INT (read one key=value out of a flat file)
li x13, -1         # x13 = -1 -> the DEFAULT value to use if the key/file isn't found yet (so we don't false-positive on a missing file)
ecall "/home/no/Desktop/🤖️🪤️🏠️/🥡️🪜️/🪜️-00.00/NNEST_CLEAN_PARENT/NNEST-11.17/x0.parent-level-dev-env-04.04/yz.muchiverse/44.xyz❤️‍🔥️00.17/#.desktop/events_hq_view_mode.txt" "view_mode"  # read view_mode's current value; x12 <- that value
li x2, 1           # x2 = 1 -> the value we're waiting for (view_mode=1 means "Scratch tab is now active")
beq x12, x2, _ready   # if x12 == x2 (view_mode really is 1 now), jump straight to _ready
j _poll            # otherwise, loop back and read the file again - this IS the busy-poll, no sleep exists yet (see HARNESS-AUTHORING-GUIDE.md 3a for why)

_ready:            # label: view_mode really is 1 now - safe to capture proof
li x15, 1          # x15 = 1 -> SYS_OPEN again, for the PNG-dump injection
li x13, 2          # append mode again
ecall "/home/no/Desktop/🤖️🪤️🏠️/🥡️🪜️/🪜️-00.00/NNEST_CLEAN_PARENT/NNEST-11.17/x0.parent-level-dev-env-04.04/yz.muchiverse/44.xyz❤️‍🔥️00.17/#.desktop/events_hq_history.txt"  # reopen the relay; x12 <- fresh fd
addi x14, x12, 0   # stash this new fd in x14 again (the old one is long closed)
li x15, 3          # SYS_WRITE_LINE
addi x12, x14, 0   # fd back into x12
ecall "112"        # append "112\n" - ASCII 112 = 'p', the real dump_frame_png() trigger key for this window
li x15, 2          # SYS_CLOSE
addi x12, x14, 0   # fd into x12 one last time
ecall              # close the relay file - the render process's own forced-redraw-before-dump fix (2026-08-27) guarantees the resulting PNG shows THIS state, not a stale one

halt               # stop the VM - script's job is done
