# setup main_loop_chtpm.pal - Match Setup WIDGIT's persistent screen loop.
# Same proven shape as @.apps/civ-txt/pal/main_module.pal and
# &.widgits/file-menu/pal/main_loop_chtpm.pal: pre-sync the input op with
# key 0 before the first compose, then loop - render on screen change,
# dispatch relayed keys, idle otherwise.
li x1, 0

li x9, 0
setup_menu_input x9
setup_compose_frame
hit_frame
read_pos x7, "pieces/display/setup_screen_changed.txt"

loop:
li x9, 0
setup_menu_input x9
read_history pieces/apps/player_app/interact_relay.txt x2, x1
beq x2, x0, no_key
setup_menu_input x2
j render

no_key:
read_pos x8, "pieces/display/setup_screen_changed.txt"
beq x7, x8, idle
addi x7, x8, 0
j render

idle:
sleep 30000
j loop

render:
setup_compose_frame
hit_frame
sleep 30000
j loop
