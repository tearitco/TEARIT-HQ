<!-- Teario-Make BOARD window (owner 2026-11-19: Teario has its OWN window and header, the rpg-edit top bar is not edited; plan BOOK 16.game TEARIO-MAKE-PLAY-LEVEL-EDITOR-AND-PLATFORMER-PLAN, section "Owner decision 2026-11-19 and the build plan", phase P1).
     A trimmed copy of the editor board shape (same standard: tabbar, dropdown rows that end with cancel, one pinned left bar, canvas, footer), keeping ONLY the generic pieces: the In toggle and the book and page cells are the shared pc-hq ones (rows from the shared projector, actions through the shared pchq_board_action.sh),
     the LEFT bar is the Teario stamp bank (feed ../state/stamps_ui.txt written by game_core), the game popup is drawn from the game feed ../state/game_ui.txt. Nothing here calls the rpg-edit app.
     Launch: sh @.apps/teario-make/button.sh run. vars: the Teario feeds FIRST, the board files after (canvas_raw and interact_* are the projector's). RULES: no angle brackets inside comments. -->
<window label="Teario-Make" class="pchq-board-pal database-window managed user-resizable" vars="../state/game_ui.txt ../state/stamps_ui.txt state/ui.txt state/pchq/ui.txt state/sides.txt">
  <module src="@.apps/piececraft-hq/ops/+x/pchq_board_projector.+x" args="teario-make-pchq"/>
  <page name="main">
    <tabbar id="toolbar" class="pchq-toolbar">
      <tab id="tb-in" class="pchq-tb ${interact_class}" label="In: ${interact_label}" relay="${bv_h1},${bv_h2}" onclick="'${HOUSE}/@.apps/piececraft-hq/ops/pchq_board_action.sh' '${bv_session}' 'interact'"/>
      <tab id="tb-book" class="pchq-tb" label="${book_label} ▾" onclick="ACTIVATE" target_id="tb-book"/>
      <tab id="tb-page" class="pchq-tb" label="${page_label} ▾" onclick="ACTIVATE" target_id="tb-page"/>
    </tabbar>
    <sidebar id="rail" class="pchq-rail sidebar">
      <repeat count="${n_file_opts}" bind="f">
        <item id="fo-${f.#}" class="pchq-menu-row dropdown-child ${f.active}" target_id="tb-book" label="${f.label}" action="'${HOUSE}/@.apps/piececraft-hq/ops/pchq_board_action.sh' '${bv_session}' '${f.verb}' '${f.arg}'"/>
      </repeat>
      <item id="bk-cancel" class="pchq-menu-row dropdown-child quiet" target_id="tb-book" label="- cancel -" action="void"/>
      <repeat count="${n_desk_opts}" bind="d">
        <item id="do-${d.#}" class="pchq-menu-row dropdown-child ${d.active}" target_id="tb-page" label="${d.label}" action="'${HOUSE}/@.apps/piececraft-hq/ops/pchq_board_action.sh' '${bv_session}' 'desk' '${d.id}'"/>
      </repeat>
      <item id="pg-cancel" class="pchq-menu-row dropdown-child quiet" target_id="tb-page" label="- cancel -" action="void"/>
    </sidebar>
    <panel id="view-panel" class="pchq-view">
      <canvas id="view" sprite="${canvas_raw}"/>
      <!-- LEFT pinned bar: the STAMP BANK of Teario Make (a Mario Maker style item bank). Pinned = takes its width out of the canvas (class ov-pin, width from side_style.pdl). It is OPEN by default (state/sides.txt side_stamp=1, seeded by open_board.sh), the underscore minimizes it and the footer cell stamps brings it back, both through the shared side_toggle op. The list is the game feed (stamp_on, n_stamp, stamp_i_label and _cls and _act): a new stamp is a row in the game stamps.pdl, no row here. Each row carries a PICTURE (stamp_i_sprite, 2026-11-22): the stampimg verb paints the stamp into a scratch level with the same paint the Place button runs and crops the projection, so the picture is the placed result. A pick runs the game own ctl pick; the PICKED stamp has class stamp-picked and a greater-than sign in its label. -->
      <row id="side-s" class="canvas-overlay-left ov-pin ov-scroll ov-chrome pchq-hotbar theme" show="${side_stamp}">
        <text label="stamps" class="hb-quiet ov-title theme-3 ov-line"/>
        <item id="ss-min" class="ov-min hb-slot skin-bar theme-3" label="_" action="'${HOUSE}/@.apps/layout-studio/ops/+x/side_toggle.+x' '${HOUSE}/@.apps/teario-make/board/state/sides.txt' side_stamp toggle"/>
        <text label="open Make and press new level" class="ph-quiet ov-line" show="${stamp_off}"/>
        <repeat count="${n_stamp}" bind="stamp">
          <item id="st${stamp.#}" class="pchq-ft skin-bar sprite-inline sprite-big ${stamp.cls}" label="${stamp.label}" sprite="${stamp.sprite}" action="${stamp.act}"/>
        </repeat>
      </row>
      <!-- the game popup (new level, place, publish...) from the game feed: gm_on, gm_title, gmt_i_text, gmb_i_label and _act. It is the same feed the editor drew; here it is Teario own row. -->
      <row id="game-ov" class="canvas-overlay-at ov-chrome rp-chat-ov theme" show="${gm_on}">
        <text label="${gm_title}" class="hb-quiet ov-title theme-3"/>
        <repeat count="${gm_nt}" bind="gmt"><text label="${gmt.text}" class="hb-quiet"/></repeat>
        <repeat count="${gm_nb}" bind="gmb"><item id="gmb${gmb.#}" class="rp-menu-row" label="${gmb.label}" action="${gmb.act}"/></repeat>
      </row>
    </panel>
    <footer id="statusbar" class="pchq-footer">
      <text label="bars" class="quiet"/>
      <item id="ss-toggle" class="pchq-ft" label="stamps" action="'${HOUSE}/@.apps/layout-studio/ops/+x/side_toggle.+x' '${HOUSE}/@.apps/teario-make/board/state/sides.txt' side_stamp toggle"/>
    </footer>
    <text label="No live board-viewer session - open the board with open_board.sh." class="quiet" show="${no_session}"/>
  </page>
</window>
