<!-- Draw Battle board. Same popup shape as the editor game bar Teropoly uses: a title, text rows, and buttons, all from ../state/game_ui.txt. The fight rules stay in db_battle_op. -->
<window label="Draw Battle" class="pchq-board-pal database-window managed user-resizable" vars="../state/run_ui.txt ../state/clock_ui.txt ../state/game_ui.txt ../state/pick_ui.txt state/ui.txt state/pchq/ui.txt state/sides.txt">
  <module src="@.apps/piececraft-hq/ops/+x/pchq_board_projector.+x" args="draw-battle-pchq"/>
  <page name="main">
    <tabbar id="toolbar" class="pchq-toolbar">
      <tab id="tb-in" class="pchq-tb ${interact_class}" label="In: ${interact_label}" relay="${bv_h1},${bv_h2}" onclick="'${HOUSE}/@.apps/piececraft-hq/ops/pchq_board_action.sh' '${bv_session}' 'interact'"/>
      <tab id="tb-book" class="pchq-tb" label="${book_label} ▾" onclick="ACTIVATE" target_id="tb-book"/>
      <tab id="tb-page" class="pchq-tb" label="${page_label} ▾" onclick="ACTIVATE" target_id="tb-page"/>
      <tab id="tb-player" class="pchq-tb" label="${run_label} ▾" onclick="ACTIVATE" target_id="tb-player"/>
      <tab id="tb-time" class="pchq-tb" label="${time_label} ▾" onclick="ACTIVATE" target_id="tb-time"/>
    </tabbar>
    <sidebar id="rail" class="pchq-rail sidebar">
      <repeat count="${n_file_opts}" bind="f">
        <item id="fo-${f.#}" class="pchq-menu-row dropdown-child ${f.active}" target_id="tb-book" label="${f.label}" action="'${HOUSE}/@.apps/piececraft-hq/ops/pchq_board_action.sh' '${bv_session}' '${f.verb}' '${f.arg}'"/>
      </repeat>
      <item id="bk-cancel" class="pchq-menu-row dropdown-child quiet" target_id="tb-book" label="- cancel -" action="void"/>
      <repeat count="${n_desk_opts}" bind="d">
        <item id="do-${d.#}" class="pchq-menu-row dropdown-child ${d.active}" target_id="tb-page" label="${d.label}" action="'${HOUSE}/@.apps/piececraft-hq/ops/pchq_board_action.sh' '${bv_session}' 'desk' '${d.id}'"/>
      </repeat>
      <item id="pg-cancel" class="pchq-menu-row dropdown-child quiet" target_id="tb-page" label="- cancel -" action="void"/>
      <item id="pm-play" class="pchq-menu-row dropdown-child" target_id="tb-player" label="Play" action="'${HOUSE}/&.widgits/_shared-lib/ops/+x/db_battle_op.+x' play '${HOUSE}/@.apps/draw-battle/state' '${HOUSE}'"/>
      <item id="pm-stop" class="pchq-menu-row dropdown-child" target_id="tb-player" label="Stop" action="'${HOUSE}/&.widgits/_shared-lib/ops/+x/db_battle_op.+x' stop '${HOUSE}/@.apps/draw-battle/state' '${HOUSE}'"/>
      <item id="pm-cancel" class="pchq-menu-row dropdown-child quiet" target_id="tb-player" label="- cancel -" action="void"/>
      <item id="tm-min" class="pchq-menu-row dropdown-child" target_id="tb-time" label="speed: normal (1 min/sec)" action="'${HOUSE}/&.widgits/_shared-lib/ops/+x/db_battle_op.+x' clock '${HOUSE}/@.apps/draw-battle/state' '${HOUSE}' rate min"/>
      <item id="tm-sec" class="pchq-menu-row dropdown-child" target_id="tb-time" label="speed: fast" action="'${HOUSE}/&.widgits/_shared-lib/ops/+x/db_battle_op.+x' clock '${HOUSE}/@.apps/draw-battle/state' '${HOUSE}' rate sec"/>
      <item id="tm-hour" class="pchq-menu-row dropdown-child" target_id="tb-time" label="speed: real time" action="'${HOUSE}/&.widgits/_shared-lib/ops/+x/db_battle_op.+x' clock '${HOUSE}/@.apps/draw-battle/state' '${HOUSE}' rate hour"/>
      <item id="tm-reinst" class="pchq-menu-row dropdown-child" target_id="tb-time" label="reinstall schedule" action="'${HOUSE}/&.widgits/_shared-lib/ops/+x/db_battle_op.+x' clock '${HOUSE}/@.apps/draw-battle/state' '${HOUSE}' reinstall"/>
      <item id="tm-cancel" class="pchq-menu-row dropdown-child quiet" target_id="tb-time" label="- cancel -" action="void"/>
    </sidebar>
    <panel id="view-panel" class="pchq-view">
      <canvas id="view" sprite="${canvas_raw}"/>
      <row id="side-c" class="canvas-overlay-left ov-pin ov-scroll ov-chrome pchq-hotbar theme" show="${side_cat}">
        <text label="${pick_title}" class="hb-quiet ov-title theme-3 ov-line"/>
        <item id="sc-min" class="ov-min hb-slot skin-bar theme-3" label="_" action="'${HOUSE}/@.apps/layout-studio/ops/+x/side_toggle.+x' '${HOUSE}/@.apps/draw-battle/board/state/sides.txt' side_cat hide"/>
        <item id="sc-back" class="pchq-ft skin-bar" label="&lt; back" show="${can_back}" action="'${HOUSE}/&.widgits/_shared-lib/ops/+x/db_battle_op.+x' pick '${HOUSE}/@.apps/draw-battle/rulesets/default/units.pdl' '${HOUSE}/@.apps/draw-battle/state/pick_ui.txt' back"/>
        <repeat count="${n_dcat}" bind="dcat">
          <item id="dc${dcat.#}" class="pchq-ft skin-bar" label="${dcat.label}" show="${side_list}" action="${dcat.act}"/>
        </repeat>
        <repeat count="${n_opt}" bind="opt">
          <item id="do${opt.#}" class="pchq-ft skin-bar ${opt.cls}" label="${opt.label}" show="${side_opt}" action="${opt.act}"/>
        </repeat>
      </row>
      <row id="game-ov" class="canvas-overlay-at ov-chrome rp-chat-ov theme" show="${gm_on}">
        <text label="${gm_title}" class="hb-quiet ov-title theme-3"/>
        <repeat count="${gm_nt}" bind="gmt"><text label="${gmt.text}" class="hb-quiet"/></repeat>
        <repeat count="${gm_nb}" bind="gmb"><item id="gmb${gmb.#}" class="rp-menu-row" label="${gmb.label}" action="${gmb.act}"/></repeat>
      </row>
    </panel>
    <footer id="statusbar" class="pchq-footer">
      <text label="draw battle" class="quiet"/>
      <item id="sc-toggle" class="pchq-ft" label="types" action="'${HOUSE}/@.apps/layout-studio/ops/+x/side_toggle.+x' '${HOUSE}/@.apps/draw-battle/board/state/sides.txt' side_cat toggle"/>
    </footer>
    <text label="No live board session." class="quiet" show="${no_session}"/>
  </page>
</window>
