<!-- pet-house.xhtpm - the pet's room and its controls (layout studio first consumer). Static layout: pet_manager (the module) owns the state and publishes
     state/ui.txt; the canvas shows the room + pet drawn by pet_scene (gravity when this window is moved). RULES: one sidebar plus one panel; no angle
     brackets inside comments. Everything the player can do is a pet_event.sh verb; the field at the bottom takes chat, "teach words = verb item", good, bad. -->
<window label="Pet house - ${name}" class="pet-house database-window fixed-size" vars="state/ui.txt">
  <module src="@.apps/pet-house/ops/+x/pet_manager.+x" id="_"/>
  <page name="main">
    <tabbar class="tab-bar">
      <tab id="t_save" class="tab" label="Save" action="sh '${HOUSE}/@.apps/pet-house/ops/pet_event.sh' fire save_1"/>
      <tab id="t_load" class="tab" label="Load" action="sh '${HOUSE}/@.apps/pet-house/ops/pet_event.sh' fire load_1"/>
      <tab id="t_play" class="tab" label="Play" action="sh '${HOUSE}/@.apps/pet-house/ops/pet_event.sh' fire start"/>
      <tab id="t_stop" class="tab" label="Stop" action="sh '${HOUSE}/@.apps/pet-house/ops/pet_event.sh' fire stop"/>
      <tab id="t_player" class="tab" label="Player" action="sh '${HOUSE}/@.apps/pet-house/ops/pet_event.sh' menu_toggle"/>
      <tab id="t_events" class="tab" label="Events" action="sh '${HOUSE}/&.widgits/events-hq/button.sh' '${HOUSE}/@.apps/pet-house/state' '${HOUSE}'"/>
      <tab id="t_newev" class="tab" label="+Event" action="sh '${HOUSE}/@.apps/pet-house/ops/pet_event.sh' new_event"/>
    </tabbar>
    <sidebar id="side" class="sidebar">
      <text id="light" label="${run_label}" class="${run_cls}"/>
      <item id="menu_btn" class="ph-row" label="Player menu (${n_menu})" action="sh '${HOUSE}/@.apps/pet-house/ops/pet_event.sh' menu_toggle"/>
      <scrolllist>
        <repeat count="${n_menu_shown}" bind="menu">
          <item id="mn${menu.#}" class="ph-row" label="${menu.label}" action="sh '${HOUSE}/@.apps/pet-house/ops/pet_event.sh' ${menu.verb} ${menu.arg}"/>
        </repeat>
      </scrolllist>
      <item id="inv_btn" class="ph-row" label="Inventory (${inv_n})" action="sh '${HOUSE}/@.apps/pet-house/ops/pet_event.sh' inv_toggle"/>
      <scrolllist>
        <repeat count="${inv_shown}" bind="inv">
          <item id="iv${inv.#}" class="ph-row" label="${inv.text}" action="sh '${HOUSE}/@.apps/pet-house/ops/pet_event.sh' inv_use ${inv.#}"/>
        </repeat>
      </scrolllist>
      <text label="Chat" class="ph-title"/>
      <text label="${chat_0}" class="ph-chat"/>
      <text label="${chat_1}" class="ph-chat"/>
      <text label="${chat_2}" class="ph-chat"/>
      <text label="${chat_3}" class="ph-chat"/>
      <cli_io id="say" target_id="pet-say" label="say: " action="sh '${HOUSE}/@.apps/pet-house/ops/pet_event.sh' chat_input"/>
      <text label="${stage} lv ${level} ${state}" class="ph-quiet"/>
      <text label="hunger ${hunger} energy ${energy}" class="ph-quiet"/>
      <text label="clean ${clean} happy ${happy}" class="ph-quiet"/>
    </sidebar>
    <panel id="room_p" class="ph-panel">
      <canvas id="room" class="ph-room" sprite="${scene_raw}"/>
    </panel>
  </page>
</window>
