# rules.pdl - the numbers of civ-snes (CONFIG: an input, never written by the game). Read by ops/civ_op.c; the harness may point CIV_RULES at a copy.
# Integer only (D93). The hash of every RULE row is in the first ledger row: edit a number after a game began and the ledger is refused (exit 14).
# RULE | name | integer
# ---- setup presets (the owner's setup step: size, difficulty, rivals, map, seed). Index 0 small, 1 medium, 2 large; the default is the BIGGEST (large).
# Why 40 x 30 = 1200 tiles: the reference SNES Civilization map is 80 x 50 = 4000 tiles; 202.snes-civ (the repo's own reference) uses 40 x 30; the desk page limit is 64 x 64; the engine stays interactive at that size (measured in the build log).
RULE | size_small_w | 20
RULE | size_small_h | 14
RULE | size_small_noise | 4
RULE | size_small_edge | 3
RULE | size_small_land | 60
RULE | size_medium_w | 30
RULE | size_medium_h | 22
RULE | size_medium_noise | 5
RULE | size_medium_edge | 3
RULE | size_medium_land | 130
RULE | size_large_w | 40
RULE | size_large_h | 30
RULE | size_large_noise | 6
RULE | size_large_edge | 4
RULE | size_large_land | 250
RULE | default_size | 2
RULE | default_diff | 1
RULE | default_rivals | 1
RULE | default_map | 0
RULE | default_seed | 4
RULE | seed_max | 99999999
# ---- difficulty (easy normal hard): what each level really changes. normal is the base game.
# rival_shield_add: extra shields a turn in every city of an agent civ; rival_settlers: extra settlers each rival starts with; human_warriors: extra warriors the human starts with; agent_actions: the actions an agent may take a turn
RULE | diff_easy_rival_shield_add | 0
RULE | diff_easy_rival_settlers | 0
RULE | diff_easy_human_warriors | 1
RULE | diff_easy_agent_actions | 3
RULE | diff_normal_rival_shield_add | 0
RULE | diff_normal_rival_settlers | 0
RULE | diff_normal_human_warriors | 0
RULE | diff_normal_agent_actions | 6
RULE | diff_hard_rival_shield_add | 1
RULE | diff_hard_rival_settlers | 1
RULE | diff_hard_human_warriors | 0
RULE | diff_hard_agent_actions | 8
# ---- the real Earth map (the setup option "map: earth"): sampled from ETOPO5 (the file @.apps/earth-moth reads), the sea level and the sampling are data
# the map covers earth_lat_north down to earth_lat_south (degrees) over 360 degrees of longitude; a tile is the mean of earth_sub x earth_sub samples (metres); water below earth_sea, hills from earth_hill, mountains from earth_mount
RULE | earth_lat_north | 75
RULE | earth_lat_south | -60
RULE | earth_sub | 3
RULE | earth_sea | 0
RULE | earth_hill | 600
RULE | earth_mount | 1800
# ---- terrain from a seeded value noise (random maps): fine noise amplitude, border sinking, thresholds (sea < hill < mount), forest share of the rest
RULE | noise_fine | 14
RULE | edge_pen | 7
RULE | sea | 42
RULE | hill | 70
RULE | mount | 82
RULE | forest_pct | 62
# movement: cost of entering a tile (water is never entered by a land unit); move points per turn; the last step may overspend
RULE | cost_grass | 1
RULE | cost_forest | 2
RULE | cost_hills | 2
RULE | cost_mountain | 3
RULE | mp_settler | 1
RULE | mp_warrior | 2
# cities and production: citygap = the smallest Manhattan distance between two cities; shields per turn = city_shields + (rough neighbours / rough_div)
RULE | citygap | 3
RULE | city_shields | 1
RULE | rough_div | 3
RULE | cost_warrior | 3
RULE | cost_settler | 5
# default_build: 0 settler, 1 warrior
RULE | default_build | 1
# fog: a unit or city sees this many tiles in every direction (Chebyshev), and remembers
RULE | sight | 1
# calendar
RULE | year0 | -4000
RULE | year_step | 20
# the basic agent (every rival civ): the actions per turn are the difficulty rows above; weights (the highest score wins, the first in the list on a tie); it wants ai_cities cities, then builds warriors
RULE | aiw_found | 100
RULE | aiw_explore | 4
RULE | aiw_walk | 1
RULE | aiw_build | 20
RULE | ai_cities | 2
# ---- the civs (data, SNES-Civ style): the player picks one in setup, the rivals are the next civs of this list; rgb = the colour on the board, lat/lon = the home region on the earth map (degrees), explore_pct = how eagerly the rival agent explores (100 = the base weight aiw_explore)
RULE | civ_count | 8
RULE | default_civ | 0
RULE | civ_1_r | 210
RULE | civ_1_g | 40
RULE | civ_1_b | 40
RULE | civ_1_lat | 42
RULE | civ_1_lon | 12
RULE | civ_1_explore_pct | 100
RULE | civ_2_r | 235
RULE | civ_2_g | 190
RULE | civ_2_b | 40
RULE | civ_2_lat | 27
RULE | civ_2_lon | 31
RULE | civ_2_explore_pct | 100
RULE | civ_3_r | 60
RULE | civ_3_g | 190
RULE | civ_3_b | 90
RULE | civ_3_lat | 34
RULE | civ_3_lon | 108
RULE | civ_3_explore_pct | 70
RULE | civ_4_r | 60
RULE | civ_4_g | 110
RULE | civ_4_b | 230
RULE | civ_4_lat | 39
RULE | civ_4_lon | -95
RULE | civ_4_explore_pct | 130
RULE | civ_5_r | 40
RULE | civ_5_g | 200
RULE | civ_5_b | 200
RULE | civ_5_lat | 19
RULE | civ_5_lon | -99
RULE | civ_5_explore_pct | 100
RULE | civ_6_r | 240
RULE | civ_6_g | 130
RULE | civ_6_b | 30
RULE | civ_6_lat | -28
RULE | civ_6_lon | 30
RULE | civ_6_explore_pct | 150
RULE | civ_7_r | 150
RULE | civ_7_g | 90
RULE | civ_7_b | 50
RULE | civ_7_lat | 47
RULE | civ_7_lon | 105
RULE | civ_7_explore_pct | 120
RULE | civ_8_r | 190
RULE | civ_8_g | 80
RULE | civ_8_b | 220
RULE | civ_8_lat | 52
RULE | civ_8_lon | 0
RULE | civ_8_explore_pct | 100
# ---- the huge preset (60 x 40 = 2400 tiles; under the desk limit 64 x 64)
RULE | size_huge_w | 60
RULE | size_huge_h | 40
RULE | size_huge_noise | 7
RULE | size_huge_edge | 5
RULE | size_huge_land | 450
