KEY          | render_mode_toggle | 112       # 'p'  toggle 2D <-> 3D (camera keys are Y U I O P, D152)
KEY          | pov_mode_1         | 121       # 'y'  first person
KEY          | pov_mode_2         | 117       # 'u'  third person
KEY          | pov_mode_3         | 105       # 'i'  free roam
KEY          | pov_mode_4         | 111       # 'o'  bird's eye
KEY          | pov_mode_1_alt     | 0
KEY          | pov_mode_2_alt     | 0

KEY          | possess_next            | 93     # ]  take the rig:civ token
KEY          | possess_prev            | 91     # [
KEY          | possess_release_alt     | 108    # l  let go
KEY          | possess_enter_anywhere  | 1      # Enter with nothing under the cursor takes the token
