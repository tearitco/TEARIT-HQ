<!-- game-dev-hq. Top bar is INT, Book, Page, the same two slots as the other games.
     Book and Page open the left menu: hire and train on Book, contract and advertise on Page.
     Staff names are the footer buttons only. RULES: no angle brackets inside comments. -->
<window label="${title}" class="database-window fixed-size managed user-resizable" vars="state/ui.txt">
  <module src="@.apps/game-dev-hq/ops/+x/game_dev_hq.+x"/>
  <page name="main">
    <tabbar id="toolbar" class="tab-bar">
      <tab id="tb-int" class="tab rp-tb ${interact_class}" label="INT ${interact_label}" relay="${rp_h1},${rp_h2}" onclick="'${HOUSE}/@.apps/game-dev-hq/ops/+x/game_dev_hq.+x' int"/>
      <tab id="tb-book" class="tab rp-tb" label="Book ▾" onclick="ACTIVATE" target_id="tb-book"/>
      <tab id="tb-page" class="tab rp-tb" label="Page ▾" onclick="ACTIVATE" target_id="tb-page"/>
    </tabbar>
    <sidebar id="side" class="rp-rail sidebar"/>
    <panel id="room_p" class="rp-panel">
      <canvas id="room" class="rp-room" sprite="${canvas_raw}"/>
      <row id="side-l" class="canvas-overlay-left ov-pin ov-chrome rp-side-ov" show="${left_visible}">
        <text label="studio" class="gd-title"/>
        <item id="side-min" class="ov-min hb-slot skin-bar theme-3" label="_" action="'${HOUSE}/@.apps/game-dev-hq/ops/+x/game_dev_hq.+x' toggle left"/>
        <text label="${cash_label}" class="gd-ink"/>
        <text label="${fame_label}   hype ${hype}" class="gd-ink"/>
        <text label="Week ${week}   office ${office}" class="gd-ink"/>
        <text label="${game_line}" class="gd-ink"/>
        <text label="${note}" class="gd-note"/>
        <repeat count="${n_hire}" bind="hire">
          <item id="h${hire.#}" class="gd-ink" label="${hire.line}" action="'${HOUSE}/@.apps/game-dev-hq/ops/+x/game_dev_hq.+x' hire ${hire.job} ${hire.name}"/>
        </repeat>
        <item id="tr-prog" class="gd-ink" label="Train programming" action="'${HOUSE}/@.apps/game-dev-hq/ops/+x/game_dev_hq.+x' train ${active_id}:programming"/>
        <item id="tr-sc" class="gd-ink" label="Train scenario" action="'${HOUSE}/@.apps/game-dev-hq/ops/+x/game_dev_hq.+x' train ${active_id}:scenario"/>
        <item id="tr-gr" class="gd-ink" label="Train graphics" action="'${HOUSE}/@.apps/game-dev-hq/ops/+x/game_dev_hq.+x' train ${active_id}:graphics"/>
        <item id="tr-rest" class="gd-ink" label="Rest" action="'${HOUSE}/@.apps/game-dev-hq/ops/+x/game_dev_hq.+x' rest ${active_id}"/>
        <item id="ct-ar" class="gd-ink" label="New game action/rpg" action="'${HOUSE}/@.apps/game-dev-hq/ops/+x/game_dev_hq.+x' start action:rpg"/>
        <item id="ct-ra" class="gd-ink" label="New game rpg/adventure" action="'${HOUSE}/@.apps/game-dev-hq/ops/+x/game_dev_hq.+x' start rpg:adventure"/>
        <item id="ct-ps" class="gd-ink" label="New game puzzle/sim" action="'${HOUSE}/@.apps/game-dev-hq/ops/+x/game_dev_hq.+x' start puzzle:sim"/>
        <item id="ct-as" class="gd-ink" label="Assign selected" action="'${HOUSE}/@.apps/game-dev-hq/ops/+x/game_dev_hq.+x' assign ${active_id}"/>
        <item id="ct-go" class="gd-ink" label="Advance" action="'${HOUSE}/@.apps/game-dev-hq/ops/+x/game_dev_hq.+x' advance"/>
        <item id="ct-ship" class="gd-ink" label="Ship" action="'${HOUSE}/@.apps/game-dev-hq/ops/+x/game_dev_hq.+x' ship"/>
        <item id="ad-s" class="gd-ink" label="Advertise small $5000" action="'${HOUSE}/@.apps/game-dev-hq/ops/+x/game_dev_hq.+x' advertise small"/>
        <item id="ad-m" class="gd-ink" label="Advertise mid $15000" action="'${HOUSE}/@.apps/game-dev-hq/ops/+x/game_dev_hq.+x' advertise mid"/>
        <item id="ad-b" class="gd-ink" label="Advertise big $40000" action="'${HOUSE}/@.apps/game-dev-hq/ops/+x/game_dev_hq.+x' advertise big"/>
        <item id="bk-play" class="gd-ink" label="Play" action="'${HOUSE}/@.apps/game-dev-hq/ops/+x/game_dev_hq.+x' play"/>
        <item id="bk-stop" class="gd-ink" label="Stop" action="'${HOUSE}/@.apps/game-dev-hq/ops/+x/game_dev_hq.+x' stop"/>
      </row>
      <row id="chat-ov" class="canvas-overlay-right ov-pin ov-chrome rp-chat-ov theme" show="${chat_visible}">
        <text label="chat" class="hb-quiet ov-title theme-3"/>
        <item id="chat-min" class="ov-min hb-slot skin-bar theme-3" label="_" action="'${HOUSE}/@.apps/game-dev-hq/ops/+x/game_dev_hq.+x' toggle chat"/>
        <item id="chat-clear" class="rp-menu-row" label="clear chat" action="'${HOUSE}/@.apps/game-dev-hq/ops/+x/game_dev_hq.+x' clearchat"/>
        <text label="${chat_0}" class="rp-chat ${chat_cls_0}"/>
        <text label="${chat_1}" class="rp-chat ${chat_cls_1}"/>
        <text label="${chat_2}" class="rp-chat ${chat_cls_2}"/>
        <text label="${chat_3}" class="rp-chat ${chat_cls_3}"/>
        <text label="${chat_4}" class="rp-chat ${chat_cls_4}"/>
        <text label="${chat_5}" class="rp-chat ${chat_cls_5}"/>
        <text label="${chat_6}" class="rp-chat ${chat_cls_6}"/>
        <text label="${chat_7}" class="rp-chat ${chat_cls_7}"/>
        <text label="${chat_8}" class="rp-chat ${chat_cls_8}"/>
        <text label="${chat_9}" class="rp-chat ${chat_cls_9}"/>
      </row>
    </panel>
    <footer id="statusbar" class="pchq-footer">
      <text label="${cash_label}" class="rp-big"/>
      <text label="${fame_label}" class="rp-big"/>
      <text label="Wk ${week}" class="rp-quiet"/>
      <item id="chat-toggle" class="pchq-ft skin-bar" label="chat" action="'${HOUSE}/@.apps/game-dev-hq/ops/+x/game_dev_hq.+x' toggle chat"/>
      <repeat count="${n_party}" bind="party">
        <item id="pt${party.#}" class="pchq-ft skin-bar ${party.cls}" label="${party.label}" action="'${HOUSE}/@.apps/game-dev-hq/ops/+x/game_dev_hq.+x' select ${party.id}"/>
      </repeat>
    </footer>
  </page>
</window>
