<!-- game-dev-hq: one studio. Verbs are the daemon. No map walk. -->
<window label="${title}" class="database-window fixed-size user-resizable" vars="state/ui.txt">
  <module src="@.apps/game-dev-hq/ops/+x/game_dev_hq.+x"/>
  <page name="main">
    <tabbar id="toolbar" class="tab-bar">
      <tab id="tb-staff" class="tab" label="Staff ▾" onclick="ACTIVATE" target_id="tb-staff"/>
      <tab id="tb-dev" class="tab" label="Develop ▾" onclick="ACTIVATE" target_id="tb-dev"/>
      <tab id="tb-train" class="tab" label="Train ▾" onclick="ACTIVATE" target_id="tb-train"/>
    </tabbar>
    <sidebar id="side" class="sidebar">
      <repeat count="${n_hire}" bind="hire">
        <item id="h${hire.#}" class="dropdown-child" target_id="tb-staff" label="${hire.line}" action="'${HOUSE}/@.apps/game-dev-hq/ops/+x/game_dev_hq.+x' hire ${hire.job} ${hire.name}"/>
      </repeat>
      <item id="st-cancel" class="dropdown-child quiet" target_id="tb-staff" label="- cancel -" action="void"/>
      <item id="dv-ar" class="dropdown-child" target_id="tb-dev" label="Start action/rpg" action="'${HOUSE}/@.apps/game-dev-hq/ops/+x/game_dev_hq.+x' start action:rpg"/>
      <item id="dv-rs" class="dropdown-child" target_id="tb-dev" label="Start rpg/adventure" action="'${HOUSE}/@.apps/game-dev-hq/ops/+x/game_dev_hq.+x' start rpg:adventure"/>
      <item id="dv-ps" class="dropdown-child" target_id="tb-dev" label="Start puzzle/sim" action="'${HOUSE}/@.apps/game-dev-hq/ops/+x/game_dev_hq.+x' start puzzle:sim"/>
      <item id="dv-a1" class="dropdown-child" target_id="tb-dev" label="Assign Rex" action="'${HOUSE}/@.apps/game-dev-hq/ops/+x/game_dev_hq.+x' assign s1"/>
      <item id="dv-a2" class="dropdown-child" target_id="tb-dev" label="Assign Pip" action="'${HOUSE}/@.apps/game-dev-hq/ops/+x/game_dev_hq.+x' assign s2"/>
      <item id="dv-a3" class="dropdown-child" target_id="tb-dev" label="Assign Gus" action="'${HOUSE}/@.apps/game-dev-hq/ops/+x/game_dev_hq.+x' assign s3"/>
      <item id="dv-go" class="dropdown-child" target_id="tb-dev" label="Advance one phase" action="'${HOUSE}/@.apps/game-dev-hq/ops/+x/game_dev_hq.+x' advance"/>
      <item id="dv-ship" class="dropdown-child" target_id="tb-dev" label="Ship" action="'${HOUSE}/@.apps/game-dev-hq/ops/+x/game_dev_hq.+x' ship"/>
      <item id="dv-cancel" class="dropdown-child quiet" target_id="tb-dev" label="- cancel -" action="void"/>
      <item id="tr-1" class="dropdown-child" target_id="tb-train" label="Train Rex programming" action="'${HOUSE}/@.apps/game-dev-hq/ops/+x/game_dev_hq.+x' train s1:programming"/>
      <item id="tr-2" class="dropdown-child" target_id="tb-train" label="Train Pip scenario" action="'${HOUSE}/@.apps/game-dev-hq/ops/+x/game_dev_hq.+x' train s2:scenario"/>
      <item id="tr-3" class="dropdown-child" target_id="tb-train" label="Train Gus graphics" action="'${HOUSE}/@.apps/game-dev-hq/ops/+x/game_dev_hq.+x' train s3:graphics"/>
      <item id="tr-r1" class="dropdown-child" target_id="tb-train" label="Rest Rex" action="'${HOUSE}/@.apps/game-dev-hq/ops/+x/game_dev_hq.+x' rest s1"/>
      <item id="tr-r2" class="dropdown-child" target_id="tb-train" label="Rest Pip" action="'${HOUSE}/@.apps/game-dev-hq/ops/+x/game_dev_hq.+x' rest s2"/>
      <item id="tr-r3" class="dropdown-child" target_id="tb-train" label="Rest Gus" action="'${HOUSE}/@.apps/game-dev-hq/ops/+x/game_dev_hq.+x' rest s3"/>
      <item id="tr-cancel" class="dropdown-child quiet" target_id="tb-train" label="- cancel -" action="void"/>
    </sidebar>
    <panel id="body" class="gd-panel">
      <item class="gd-line" label="${studio_line}"/>
      <item class="gd-line" label="${game_line}"/>
      <item class="gd-note" label="${note}"/>
      <repeat count="${n_staff}" bind="st">
        <item class="gd-row" label="${st.line}"/>
      </repeat>
    </panel>
  </page>
</window>
