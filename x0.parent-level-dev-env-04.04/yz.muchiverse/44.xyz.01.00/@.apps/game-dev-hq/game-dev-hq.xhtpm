<!-- game-dev-hq. Top bar is INT, Book, Page, the same two slots as the other games.
     Book and Page open the left menu: hire and train on Book, contract and advertise on Page.
     Staff names are the footer buttons only. RULES: no angle brackets inside comments. -->
<window label="${title}" class="database-window fixed-size managed user-resizable" vars="state/ui.txt state/clock_ui.txt">
  <module src="@.apps/game-dev-hq/ops/+x/game_dev_hq.+x"/>
  <page name="main">
    <tabbar id="toolbar" class="tab-bar">
      <tab id="tb-int" class="tab rp-tb ${interact_class}" label="INT ${interact_label}" relay="${rp_h1},${rp_h2}" onclick="'${HOUSE}/@.apps/game-dev-hq/ops/+x/game_dev_hq.+x' int"/>
      <tab id="tb-book" class="tab rp-tb" label="Book ▾" onclick="ACTIVATE" target_id="tb-book"/>
      <tab id="tb-page" class="tab rp-tb" label="Page ▾" onclick="ACTIVATE" target_id="tb-page"/>
      <tab id="tb-player" class="tab rp-tb" label="Player ▾" onclick="ACTIVATE" target_id="tb-player"/>
      <tab id="tb-time" class="tab rp-tb" label="${time_label} ▾" onclick="ACTIVATE" target_id="tb-time"/>
      <tab id="tb-menu" class="tab rp-tb" label="Menu ▾" onclick="ACTIVATE" target_id="tb-menu"/>
    </tabbar>
    <sidebar id="side" class="rp-rail sidebar">
      <repeat count="${n_hire}" bind="hire">
        <item id="h${hire.#}" class="rp-menu-row dropdown-child" target_id="mn-hire" label="${hire.line}" action="'${HOUSE}/@.apps/game-dev-hq/ops/+x/game_dev_hq.+x' hire ${hire.job} ${hire.name}"/>
      </repeat>
      <item id="hi-x" class="rp-menu-row dropdown-child quiet" target_id="mn-hire" label="- cancel -" action="void"/>
      <item id="tr-prog" class="rp-menu-row dropdown-child" target_id="mn-train" label="Programming" action="'${HOUSE}/@.apps/game-dev-hq/ops/+x/game_dev_hq.+x' train ${active_id}:programming"/>
      <item id="tr-sc" class="rp-menu-row dropdown-child" target_id="mn-train" label="Scenario" action="'${HOUSE}/@.apps/game-dev-hq/ops/+x/game_dev_hq.+x' train ${active_id}:scenario"/>
      <item id="tr-gr" class="rp-menu-row dropdown-child" target_id="mn-train" label="Graphics" action="'${HOUSE}/@.apps/game-dev-hq/ops/+x/game_dev_hq.+x' train ${active_id}:graphics"/>
      <item id="tr-rest" class="rp-menu-row dropdown-child" target_id="mn-train" label="Rest" action="'${HOUSE}/@.apps/game-dev-hq/ops/+x/game_dev_hq.+x' rest ${active_id}"/>
      <item id="tr-x" class="rp-menu-row dropdown-child quiet" target_id="mn-train" label="- cancel -" action="void"/>
      <item id="ct-ar" class="rp-menu-row dropdown-child" target_id="mn-contract" label="New game action/rpg" action="'${HOUSE}/@.apps/game-dev-hq/ops/+x/game_dev_hq.+x' start action:rpg"/>
      <item id="ct-ra" class="rp-menu-row dropdown-child" target_id="mn-contract" label="New game rpg/adventure" action="'${HOUSE}/@.apps/game-dev-hq/ops/+x/game_dev_hq.+x' start rpg:adventure"/>
      <item id="ct-ps" class="rp-menu-row dropdown-child" target_id="mn-contract" label="New game puzzle/sim" action="'${HOUSE}/@.apps/game-dev-hq/ops/+x/game_dev_hq.+x' start puzzle:sim"/>
      <item id="ct-as" class="rp-menu-row dropdown-child" target_id="mn-contract" label="Assign selected" action="'${HOUSE}/@.apps/game-dev-hq/ops/+x/game_dev_hq.+x' assign ${active_id}"/>
      <item id="ct-go" class="rp-menu-row dropdown-child" target_id="mn-contract" label="Advance" action="'${HOUSE}/@.apps/game-dev-hq/ops/+x/game_dev_hq.+x' advance"/>
      <item id="ct-ship" class="rp-menu-row dropdown-child" target_id="mn-contract" label="Ship" action="'${HOUSE}/@.apps/game-dev-hq/ops/+x/game_dev_hq.+x' ship"/>
      <item id="ct-x" class="rp-menu-row dropdown-child quiet" target_id="mn-contract" label="- cancel -" action="void"/>
      <item id="ad-s" class="rp-menu-row dropdown-child" target_id="mn-ad" label="Small $5000" action="'${HOUSE}/@.apps/game-dev-hq/ops/+x/game_dev_hq.+x' advertise small"/>
      <item id="ad-m" class="rp-menu-row dropdown-child" target_id="mn-ad" label="Mid $15000" action="'${HOUSE}/@.apps/game-dev-hq/ops/+x/game_dev_hq.+x' advertise mid"/>
      <item id="ad-b" class="rp-menu-row dropdown-child" target_id="mn-ad" label="Big $40000" action="'${HOUSE}/@.apps/game-dev-hq/ops/+x/game_dev_hq.+x' advertise big"/>
      <item id="ad-x" class="rp-menu-row dropdown-child quiet" target_id="mn-ad" label="- cancel -" action="void"/>
      <item id="pm-play" class="rp-menu-row dropdown-child" target_id="tb-player" label="Play" action="'${HOUSE}/@.apps/game-dev-hq/ops/+x/game_dev_hq.+x' play"/>
      <item id="pm-stop" class="rp-menu-row dropdown-child" target_id="tb-player" label="Stop" action="'${HOUSE}/@.apps/game-dev-hq/ops/+x/game_dev_hq.+x' stop"/>
      <item id="pm-save" class="rp-menu-row dropdown-child" target_id="tb-player" label="Save (slot 1)" action="'${HOUSE}/@.apps/game-dev-hq/ops/+x/game_dev_hq.+x' save 1"/>
      <item id="pm-load" class="rp-menu-row dropdown-child" target_id="tb-player" label="Load (slot 1)" action="'${HOUSE}/@.apps/game-dev-hq/ops/+x/game_dev_hq.+x' load 1"/>
      <item id="pm-save2" class="rp-menu-row dropdown-child" target_id="tb-player" label="Save (slot 2)" action="'${HOUSE}/@.apps/game-dev-hq/ops/+x/game_dev_hq.+x' save 2"/>
      <item id="pm-load2" class="rp-menu-row dropdown-child" target_id="tb-player" label="Load (slot 2)" action="'${HOUSE}/@.apps/game-dev-hq/ops/+x/game_dev_hq.+x' load 2"/>
      <item id="pm-new" class="rp-menu-row dropdown-child" target_id="tb-player" label="New game" action="'${HOUSE}/@.apps/game-dev-hq/ops/+x/game_dev_hq.+x' newgame"/>
      <item id="pm-undo" class="rp-menu-row dropdown-child" target_id="tb-player" label="Undo new game" action="'${HOUSE}/@.apps/game-dev-hq/ops/+x/game_dev_hq.+x' load 0"/>
      <item id="pm-x" class="rp-menu-row dropdown-child quiet" target_id="tb-player" label="- cancel -" action="void"/>
      <item id="tm-cent" class="rp-menu-row dropdown-child" target_id="tb-time" label="speed: turbo" action="'${HOUSE}/@.apps/game-dev-hq/ops/+x/game_dev_hq.+x' clock rate cent"/>
      <item id="tm-sec" class="rp-menu-row dropdown-child" target_id="tb-time" label="speed: fast" action="'${HOUSE}/@.apps/game-dev-hq/ops/+x/game_dev_hq.+x' clock rate sec"/>
      <item id="tm-min" class="rp-menu-row dropdown-child" target_id="tb-time" label="speed: normal" action="'${HOUSE}/@.apps/game-dev-hq/ops/+x/game_dev_hq.+x' clock rate min"/>
      <item id="tm-hour" class="rp-menu-row dropdown-child" target_id="tb-time" label="speed: real time" action="'${HOUSE}/@.apps/game-dev-hq/ops/+x/game_dev_hq.+x' clock rate hour"/>
      <item id="tm-adv1d" class="rp-menu-row dropdown-child" target_id="tb-time" label="skip +1 day" action="'${HOUSE}/@.apps/game-dev-hq/ops/+x/game_dev_hq.+x' clock advance 1d"/>
      <item id="tm-x" class="rp-menu-row dropdown-child quiet" target_id="tb-time" label="- cancel -" action="void"/>
      <item id="mn-info" class="rp-menu-row dropdown-child" target_id="tb-menu" label="Studio show / hide" action="'${HOUSE}/@.apps/game-dev-hq/ops/+x/game_dev_hq.+x' toggle left"/>
      <item id="mn-chat" class="rp-menu-row dropdown-child" target_id="tb-menu" label="Chat show / hide" action="'${HOUSE}/@.apps/game-dev-hq/ops/+x/game_dev_hq.+x' toggle chat"/>
      <item id="mn-clear" class="rp-menu-row dropdown-child" target_id="tb-menu" label="Clear chat" action="'${HOUSE}/@.apps/game-dev-hq/ops/+x/game_dev_hq.+x' clearchat"/>
      <item id="mn-reset" class="rp-menu-row dropdown-child" target_id="tb-menu" label="Reset house (keeps a backup)" action="'${HOUSE}/@.apps/game-dev-hq/ops/+x/game_dev_hq.+x' newgame"/>
      <item id="mn-x" class="rp-menu-row dropdown-child quiet" target_id="tb-menu" label="- cancel -" action="void"/>
    </sidebar>
    <panel id="room_p" class="rp-panel">
      <canvas id="room" class="rp-room" sprite="${canvas_raw}"/>
      <row id="side-l" class="canvas-overlay-left ov-pin ov-chrome rp-side-ov" show="${left_visible}">
        <text label="studio" class="gd-title"/>
        <item id="side-min" class="ov-min hb-slot skin-bar theme-3" label="_" action="'${HOUSE}/@.apps/game-dev-hq/ops/+x/game_dev_hq.+x' toggle left"/>
        <text label="${cash_label}" class="gd-ink"/>
        <text label="${fame_label}   hype ${hype}" class="gd-ink"/>
        <text label="Week ${week}   office ${office}" class="gd-ink"/>
        <text label="${game_line}" class="gd-ink"/>
        <text label="${note}" class="gd-note"/>
        <item id="mn-hire" class="gd-ink" label="Hire" onclick="ACTIVATE"/>
        <item id="mn-train" class="gd-ink" label="Train" onclick="ACTIVATE"/>
        <item id="mn-contract" class="gd-ink" label="Contract" onclick="ACTIVATE"/>
        <item id="mn-ad" class="gd-ink" label="Advertise" onclick="ACTIVATE"/>
      </row>
      <row id="chat-ov" class="canvas-overlay-right ov-pin ov-chrome rp-chat-ov theme" show="${chat_visible}">
        <text label="chat" class="hb-quiet ov-title theme-3"/>
        <item id="chat-min" class="ov-min hb-slot skin-bar theme-3" label="_" action="'${HOUSE}/@.apps/game-dev-hq/ops/+x/game_dev_hq.+x' toggle chat"/>
        <item id="chat-clear" class="rp-menu-row" label="clear chat" action="'${HOUSE}/@.apps/game-dev-hq/ops/+x/game_dev_hq.+x' clearchat"/>
        <text label="${chat_0}" class="rp-chat ${chat_cls_0}"/>
        <text label="${chat_1}" class="rp-chat ${chat_cls_1}"/>
        <text label="${chat_2}" class="rp-chat ${chat_cls_2}"/>
        <text label="${chat_3}" class="rp-chat ${chat_cls_3}"/>
        <text label="${chat_4}" class="rp-chat ${chat_cls_4}"/>
        <text label="${chat_5}" class="rp-chat ${chat_cls_5}"/>
        <text label="${chat_6}" class="rp-chat ${chat_cls_6}"/>
        <text label="${chat_7}" class="rp-chat ${chat_cls_7}"/>
        <text label="${chat_8}" class="rp-chat ${chat_cls_8}"/>
        <text label="${chat_9}" class="rp-chat ${chat_cls_9}"/>
      </row>
    </panel>
    <footer id="statusbar" class="pchq-footer">
      <text label="${cash_label}" class="rp-big"/>
      <text label="${fame_label}" class="rp-big"/>
      <text label="Wk ${week}" class="rp-quiet"/>
      <item id="chat-toggle" class="pchq-ft skin-bar" label="chat" action="'${HOUSE}/@.apps/game-dev-hq/ops/+x/game_dev_hq.+x' toggle chat"/>
      <repeat count="${n_party}" bind="party">
        <item id="pt${party.#}" class="pchq-ft skin-bar ${party.cls}" label="${party.label}" action="'${HOUSE}/@.apps/game-dev-hq/ops/+x/game_dev_hq.+x' select ${party.id}"/>
      </repeat>
    </footer>
  </page>
</window>
