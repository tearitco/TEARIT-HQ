<!-- Teario-Play BOARD window (copy of the Teario-Make template: own title, own package, own window state) (owner 2026-11-19: Teario has its OWN window and header, the rpg-edit top bar is not edited; plan BOOK 16.game TEARIO-MAKE-PLAY-LEVEL-EDITOR-AND-PLATFORMER-PLAN, section "Owner decision 2026-11-19 and the build plan", phase P1).
     A trimmed copy of the editor board shape (same standard: tabbar, dropdown rows that end with cancel, one pinned left bar, canvas, footer), keeping ONLY the generic pieces: the In toggle and the book and page cells are the shared pc-hq ones (rows from the shared projector, actions through the shared pchq_board_action.sh),
     the LEFT bar is the Teario stamp bank (feed ../state/stamps_ui.txt written by game_core), the game popup is drawn from the game feed ../state/game_ui.txt. Nothing here calls the rpg-edit app.
     Launch: sh @.apps/teario-make/button.sh run. vars: the Teario feeds FIRST, the board files after (canvas_raw and interact_* are the projector's). RULES: no angle brackets inside comments. -->
<window label="Teario-Play" class="pchq-board-pal database-window managed user-resizable" vars="../state/game_ui.txt ../state/stamps_ui.txt state/ui.txt state/pchq/ui.txt state/sides.txt">
  <module src="@.apps/piececraft-hq/ops/+x/pchq_board_projector.+x" args="teario-play-pchq"/>
  <page name="main">
    <tabbar id="toolbar" class="pchq-toolbar">
      <tab id="tb-in" class="pchq-tb ${interact_class}" label="In: ${interact_label}" relay="${bv_h1},${bv_h2}" onclick="'${HOUSE}/@.apps/piececraft-hq/ops/pchq_board_action.sh' '${bv_session}' 'interact'"/>
      <tab id="tb-book" class="pchq-tb" label="${book_label} ▾" onclick="ACTIVATE" target_id="tb-book"/>
      <tab id="tb-page" class="pchq-tb" label="${page_label} ▾" onclick="ACTIVATE" target_id="tb-page"/>
    </tabbar>
    <sidebar id="rail" class="pchq-rail sidebar">
      <repeat count="${n_file_opts}" bind="f">
        <item id="fo-${f.#}" class="pchq-menu-row dropdown-child ${f.active}" target_id="tb-book" label="${f.label}" action="'${HOUSE}/@.apps/piececraft-hq/ops/pchq_board_action.sh' '${bv_session}' '${f.verb}' '${f.arg}'"/>
      </repeat>
      <item id="bk-cancel" class="pchq-menu-row dropdown-child quiet" target_id="tb-book" label="- cancel -" action="void"/>
      <repeat count="${n_desk_opts}" bind="d">
        <item id="do-${d.#}" class="pchq-menu-row dropdown-child ${d.active}" target_id="tb-page" label="${d.label}" action="'${HOUSE}/@.apps/piececraft-hq/ops/pchq_board_action.sh' '${bv_session}' 'desk' '${d.id}'"/>
      </repeat>
      <item id="pg-cancel" class="pchq-menu-row dropdown-child quiet" target_id="tb-page" label="- cancel -" action="void"/>
    </sidebar>
    <panel id="view-panel" class="pchq-view">
      <canvas id="view" sprite="${canvas_raw}"/>
      <!-- the game popup (new level, place, publish...) from the game feed: gm_on, gm_title, gmt_i_text, gmb_i_label and _act. It is the same feed the editor drew; here it is Teario own row. -->
      <row id="game-ov" class="canvas-overlay-right ov-pin ov-scroll ov-chrome pchq-hotbar theme" show="${gm_on}">
        <text label="${gm_title}" class="hb-quiet ov-title theme-3"/>
        <repeat count="${gm_nt}" bind="gmt"><text label="${gmt.text}" class="hb-quiet"/></repeat>
        <repeat count="${gm_nb}" bind="gmb"><item id="gmb${gmb.#}" class="pchq-ft skin-bar" label="${gmb.label}" action="${gmb.act}"/></repeat>
      </row>
    </panel>
    <footer id="statusbar" class="pchq-footer">
      <text label="bars" class="quiet"/>
    </footer>
    <text label="No live board-viewer session - open the board with open_board.sh." class="quiet" show="${no_session}"/>
  </page>
</window>
