<!-- df-hq BOARD window (owner 2026-10-11: df-hq as a module of the pc-hq board engine; the old standalone @.apps/df-hq/df-hq.xhtpm stays beside it for comparison).
     A copy of the layout-studio sandbox board (pinned side bars) with df-hq's own rows: the pets and stats are the LEFT bar, chat is the RIGHT bar, the bag hotbar is the bottom overlay,
     the dropdowns are df-hq's. The canvas is the board engine frame (2D default, 0 = 3D, 1-4 POV, camera keys, backtick = glyph view) of the book maps/df-hq that df_hq.+x exports.
     Launch: sh @.apps/df-hq/board/open_board.sh. vars: df-hq's state files FIRST, the board's after, so canvas_raw / interact_* are the board's. RULES: no angle brackets inside comments. -->
<window label="df-hq board" class="pchq-board-pal database-window managed user-resizable" vars="../state/ui.txt ../state/clock_ui.txt state/ui.txt state/pchq/ui.txt state/sides.txt state/ctx.txt">
  <module src="@.apps/piececraft-hq/ops/+x/pchq_board_projector.+x" args="df-hq-pchq"/>
  <page name="main">
    <tabbar id="toolbar" class="pchq-toolbar">
      <tab id="tb-in" class="pchq-tb ${interact_class}" label="In: ${interact_label}" relay="${bv_h1},${bv_h2}" onclick="'${HOUSE}/@.apps/df-hq/ops/+x/df_hq.+x' int"/>
      <tab id="tb-book" class="pchq-tb" label="Pals ▾" onclick="ACTIVATE" target_id="tb-book"/>
      <tab id="tb-page" class="pchq-tb" label="${room_label} ▾" onclick="ACTIVATE" target_id="tb-page"/>
      <tab id="tb-shop" class="pchq-tb" label="Shop ▾" onclick="ACTIVATE" target_id="tb-shop"/>
      <tab id="tb-menu" class="pchq-tb" label="Menu ▾" onclick="ACTIVATE" target_id="tb-menu"/>
      <tab id="tb-player" class="pchq-tb" label="${run_label} ▾" onclick="ACTIVATE" target_id="tb-player"/>
      <tab id="tb-time" class="pchq-tb" label="${time_label} ▾" onclick="ACTIVATE" target_id="tb-time"/>
      <tab id="tb-db" class="pchq-tb" label="db ▾" onclick="ACTIVATE" target_id="tb-db"/>
      <tab id="tb-load" class="pchq-tb" label="${PID} ${load_label}" onclick="void" show="${load_ok}"/>
      <tab id="tb-loadw" class="pchq-tb pchq-tb-warn" label="${PID} ${load_label}" onclick="void" show="${load_warn}"/>
    </tabbar>
    <sidebar id="rail" class="pchq-rail sidebar">
      <repeat count="${n_party}" bind="party">
        <item id="bk-${party.#}" class="pchq-menu-row dropdown-child ${party.cls}" target_id="tb-book" label="${party.label}" action="'${HOUSE}/@.apps/df-hq/ops/+x/df_hq.+x' select ${party.id}"/>
      </repeat>
      <item id="tp-book-0" class="pchq-menu-row dropdown-child" target_id="tb-book" label="${book_post_0_label}" action="${book_post_0_act}" show="${book_post_0_label}"/>
      <item id="tp-book-1" class="pchq-menu-row dropdown-child" target_id="tb-book" label="${book_post_1_label}" action="${book_post_1_act}" show="${book_post_1_label}"/>
      <item id="tp-book-2" class="pchq-menu-row dropdown-child" target_id="tb-book" label="${book_post_2_label}" action="${book_post_2_act}" show="${book_post_2_label}"/>
      <item id="tp-book-3" class="pchq-menu-row dropdown-child" target_id="tb-book" label="${book_post_3_label}" action="${book_post_3_act}" show="${book_post_3_label}"/>
      <repeat count="${n_room}" bind="room">
        <item id="rm${room.#}" class="pchq-menu-row dropdown-child " target_id="tb-page" label="${room.label}" action="'${HOUSE}/@.apps/df-hq/ops/+x/df_hq.+x' fire goto ${room.id}"/>
      </repeat>
      <item id="tp-page-0" class="pchq-menu-row dropdown-child" target_id="tb-page" label="${page_post_0_label}" action="${page_post_0_act}" show="${page_post_0_label}"/>
      <item id="tp-page-1" class="pchq-menu-row dropdown-child" target_id="tb-page" label="${page_post_1_label}" action="${page_post_1_act}" show="${page_post_1_label}"/>
      <item id="tp-page-2" class="pchq-menu-row dropdown-child" target_id="tb-page" label="${page_post_2_label}" action="${page_post_2_act}" show="${page_post_2_label}"/>
      <item id="tp-page-3" class="pchq-menu-row dropdown-child" target_id="tb-page" label="${page_post_3_label}" action="${page_post_3_act}" show="${page_post_3_label}"/>
      <repeat count="${n_item}" bind="it"><item id="ti-${it.#}" class="pchq-menu-row dropdown-child" target_id="${it.tab}" label="${it.label}" action="${it.act}"/></repeat>
      <repeat count="${n_shop}" bind="shop">
        <item id="sh${shop.#}" class="pchq-menu-row dropdown-child " target_id="tb-shop" label="${shop.label}" action="'${HOUSE}/@.apps/df-hq/ops/+x/df_hq.+x' fire buy ${shop.key}"/>
      </repeat>
      <item id="sh-cancel" class="pchq-menu-row dropdown-child quiet" target_id="tb-shop" label="- cancel -" action="void"/>
      <item id="mn-control" class="pchq-menu-row dropdown-child " target_id="tb-menu" label="${control_label} (switch: Tab)" action="'${HOUSE}/@.apps/df-hq/ops/+x/df_hq.+x' fire control"/>
      <item id="mn-voice" class="pchq-menu-row dropdown-child " target_id="tb-menu" label="Voice on / off" action="'${HOUSE}/@.apps/df-hq/ops/+x/df_hq.+x' toggle voice"/>
      <item id="mn-reset" class="pchq-menu-row dropdown-child " target_id="tb-menu" label="Reset house (keeps a backup)" action="'${HOUSE}/@.apps/df-hq/ops/+x/df_hq.+x' reset"/>
      <item id="mn-entbar" class="pchq-menu-row dropdown-child " target_id="tb-menu" label="Entities bar on/off" action="sh '${HOUSE}/@.apps/piececraft-hq/ops/pc_toggle_pdl_opt.sh' '${HOUSE}/@.apps/df-hq/df-hq-pchq/pieces/system/pchq.pdl' 'entities_bar'"/>
      <item id="mn-cancel" class="pchq-menu-row dropdown-child quiet" target_id="tb-menu" label="- cancel -" action="void"/>
      <item id="db-hq" class="pchq-menu-row dropdown-child " target_id="tb-db" label="db-hq" action="sh '${HOUSE}/&.hq-apps/db-hq-pal/button.sh' '${HOUSE}'"/>
      <item id="db-sql" class="pchq-menu-row dropdown-child " target_id="tb-db" label="sql-hq" action="sh '${HOUSE}/&.hq-apps/sql-hq/button.sh' '${HOUSE}'"/>
      <item id="db-cancel" class="pchq-menu-row dropdown-child quiet" target_id="tb-db" label="- cancel -" action="void"/>
      <item id="pm-int" class="pchq-menu-row dropdown-child " target_id="tb-player" label="INT on/off (arrow keys drive a pet)" action="'${HOUSE}/@.apps/df-hq/ops/+x/df_hq.+x' int"/>
      <item id="pm-mode" class="pchq-menu-row dropdown-child " target_id="tb-player" label="${mode_label}" action="'${HOUSE}/@.apps/df-hq/ops/+x/df_hq.+x' mode"/>
      <item id="pm-play" class="pchq-menu-row dropdown-child " target_id="tb-player" label="Play" action="'${HOUSE}/@.apps/df-hq/ops/+x/df_hq.+x' play"/>
      <item id="pm-stop" class="pchq-menu-row dropdown-child " target_id="tb-player" label="Stop" action="'${HOUSE}/@.apps/df-hq/ops/+x/df_hq.+x' stop"/>
      <item id="pm-save" class="pchq-menu-row dropdown-child " target_id="tb-player" label="Save (slot 1)" action="'${HOUSE}/@.apps/df-hq/ops/+x/df_hq.+x' fire save 1"/>
      <item id="pm-load" class="pchq-menu-row dropdown-child " target_id="tb-player" label="Load (slot 1)" action="'${HOUSE}/@.apps/df-hq/ops/+x/df_hq.+x' fire load 1"/>
      <item id="pm-cancel" class="pchq-menu-row dropdown-child quiet" target_id="tb-player" label="- cancel -" action="void"/>
      <item id="tm-cent" class="pchq-menu-row dropdown-child " target_id="tb-time" label="speed: turbo (testing)" action="'${HOUSE}/@.apps/df-hq/ops/+x/df_hq.+x' clock rate cent"/>
      <item id="tm-sec" class="pchq-menu-row dropdown-child " target_id="tb-time" label="speed: fast (1 hour/sec)" action="'${HOUSE}/@.apps/df-hq/ops/+x/df_hq.+x' clock rate sec"/>
      <item id="tm-min" class="pchq-menu-row dropdown-child " target_id="tb-time" label="speed: normal (1 min/sec)" action="'${HOUSE}/@.apps/df-hq/ops/+x/df_hq.+x' clock rate min"/>
      <item id="tm-hour" class="pchq-menu-row dropdown-child " target_id="tb-time" label="speed: real time" action="'${HOUSE}/@.apps/df-hq/ops/+x/df_hq.+x' clock rate hour"/>
      <item id="tm-adv1h" class="pchq-menu-row dropdown-child " target_id="tb-time" label="skip +1 hour" action="'${HOUSE}/@.apps/df-hq/ops/+x/df_hq.+x' clock advance 1h"/>
      <item id="tm-adv1d" class="pchq-menu-row dropdown-child " target_id="tb-time" label="skip +1 day" action="'${HOUSE}/@.apps/df-hq/ops/+x/df_hq.+x' clock advance 1d"/>
      <item id="tm-reinst" class="pchq-menu-row dropdown-child " target_id="tb-time" label="reinstall schedule" action="'${HOUSE}/@.apps/df-hq/ops/+x/df_hq.+x' clock reinstall"/>
      <item id="tm-cancel" class="pchq-menu-row dropdown-child quiet" target_id="tb-time" label="- cancel -" action="void"/>
    </sidebar>
    <panel id="view-panel" class="pchq-view">
      <canvas id="view" sprite="${canvas_raw}"/>
      <!-- LEFT pinned bar: the pets and their stats. Pinned = takes its width out of the canvas (class ov-pin, width from side_style.pdl), the _ hides it, the footer cell left toggles it. -->
      <row id="side-l" class="canvas-overlay-left ov-pin ov-scroll ov-chrome pchq-hotbar theme" show="${side_left}">
        <text label="cast - coins ${coins}" class="hb-quiet ov-title theme-3"/>
        <item id="sl-min" class="ov-min hb-slot skin-bar theme-3" label="_" action="'${HOUSE}/@.apps/layout-studio/ops/+x/side_toggle.+x' '${HOUSE}/@.apps/df-hq/board/state/sides.txt' side_left hide"/>
        <text id="light" label="${run_label}" class="${run_cls}"/>
        <text label="${nick_line}" class="ph-quiet"/>
        <text label="${stat_line}" class="ph-quiet"/>
        <text label="${stat_line2}" class="ph-quiet"/>
        <repeat count="${n_party}" bind="party">
          <item id="pt${party.#}" class="pchq-ft skin-bar ${party.cls}" label="${party.label}" action="'${HOUSE}/@.apps/df-hq/ops/+x/df_hq.+x' select ${party.id}"/>
        </repeat>
      </row>
      <!-- RIGHT pinned bar: chat as the selected entity (Harold or a pet). -->
      <row id="side-r" class="canvas-overlay-right ov-pin ov-chrome pchq-hotbar theme" show="${side_right}">
        <text label="chat - ${active_name}" class="hb-quiet ov-title theme-3"/>
        <item id="sr-min" class="ov-min hb-slot skin-bar theme-3" label="_" action="'${HOUSE}/@.apps/layout-studio/ops/+x/side_toggle.+x' '${HOUSE}/@.apps/df-hq/board/state/sides.txt' side_right hide"/>
        <text label="${chat_0}" class="rp-chat"/>
        <text label="${chat_1}" class="rp-chat"/>
        <text label="${chat_2}" class="rp-chat"/>
        <text label="${chat_3}" class="rp-chat"/>
        <text label="${chat_4}" class="rp-chat"/>
        <text label="${chat_5}" class="rp-chat"/>
        <item id="chat-clear" class="pchq-ft skin-bar" label="clear chat" action="'${HOUSE}/@.apps/df-hq/ops/+x/df_hq.+x' clearchat"/>
        <cli_io id="say" target_id="rp-say" rows="3" class="rp-say" label="&gt; " action="'${PKG}/ops/+x/df_hq.+x'"/>
      </row>
      <row id="hotbar-ov" class="canvas-overlay-bottom ov-chrome ov-slide-x rp-hotbar theme" show="${hb_visible}">
        <text label="${hb_title}" class="hb-quiet ov-title theme-3"/>
        <item id="hb-min" class="ov-min hb-slot skin-bar theme-3" label="_" action="'${HOUSE}/@.apps/df-hq/ops/+x/df_hq.+x' toggle hb"/>
        <repeat count="${hb_n_slots}" bind="hb">
          <item id="hbs${hb.#}" class="hb-slot skin-bar" label="${hb.text}" action="'${HOUSE}/@.apps/df-hq/ops/+x/df_hq.+x' fire use ${hb.key}"/>
        </repeat>
      </row>
    </panel>
    <footer id="statusbar" class="pchq-footer" show="${entities_bar_on}">
      <text label="ents" class="quiet"/>
      <item id="sl-toggle" class="pchq-ft" label="cast" action="'${HOUSE}/@.apps/layout-studio/ops/+x/side_toggle.+x' '${HOUSE}/@.apps/df-hq/board/state/sides.txt' side_left toggle"/>
      <item id="sr-toggle" class="pchq-ft" label="chat" action="'${HOUSE}/@.apps/layout-studio/ops/+x/side_toggle.+x' '${HOUSE}/@.apps/df-hq/board/state/sides.txt' side_right toggle"/>
      <item id="hb-toggle" class="pchq-ft" label="hb" action="'${HOUSE}/@.apps/df-hq/ops/+x/df_hq.+x' toggle hb"/>
      <repeat count="${n_ent}" bind="ent">
        <item id="eok${ent.#}" class="pchq-ft sprite-inline sprite-big hpb-ok" label="${ent.label} ${ent.hpb}" sprite="${ent.sprite}" action="'${HOUSE}/@.apps/df-hq/ops/+x/df_hq.+x' selev '${ent.kind}' '${ent.label}' '${ent.x}' '${ent.y}' '${ent.z}' '${ent.id}'" show="${ent.hp_ok}"/>
        <item id="elow${ent.#}" class="pchq-ft sprite-inline sprite-big hpb-low" label="${ent.label} ${ent.hpb}" sprite="${ent.sprite}" action="'${HOUSE}/@.apps/df-hq/ops/+x/df_hq.+x' selev '${ent.kind}' '${ent.label}' '${ent.x}' '${ent.y}' '${ent.z}' '${ent.id}'" show="${ent.hp_low}"/>
        <item id="eko${ent.#}" class="pchq-ft sprite-inline sprite-big hpb-ko" label="${ent.label} ${ent.hpb}" sprite="${ent.sprite}" action="'${HOUSE}/@.apps/df-hq/ops/+x/df_hq.+x' selev '${ent.kind}' '${ent.label}' '${ent.x}' '${ent.y}' '${ent.z}' '${ent.id}'" show="${ent.hp_ko}"/>
        <item id="enone${ent.#}" class="pchq-ft sprite-inline sprite-big" label="${ent.label}" sprite="${ent.sprite}" action="'${HOUSE}/@.apps/df-hq/ops/+x/df_hq.+x' selev '${ent.kind}' '${ent.label}' '${ent.x}' '${ent.y}' '${ent.z}' '${ent.id}'" show="${ent.hp_none}"/>
      </repeat>
    </footer>
    <text label="No live board-viewer session - open the board with open_board.sh." class="quiet" show="${no_session}"/>
  </page>
</window>
