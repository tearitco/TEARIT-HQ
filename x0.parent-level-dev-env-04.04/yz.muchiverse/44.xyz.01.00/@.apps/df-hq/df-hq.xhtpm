<!-- df-hq.xhtpm - the RPG Maker pet house (toys menu), SAME GUI as @.apps/pet-trainer: top bar INT | book (the six pets) | page (rooms) | Shop | Menu, a sidebar with the dropdown rows,
     the pet stats and what is in the room, a canvas with chat (right) and bag hotbar (bottom) overlays, and a footer with chat / hb / view and the six pet buttons. The pets are RPG Maker DB entries
     (&.widgits/db-hq/data PetParty + ACTOR rows); every picture is an RPG Maker MV tile or character frame. Static layout, shared khtpm_core_render.+x, zero renderer C.
     state/ui.txt is written by ops/+x/df_hq.+x (C): on every verb, and by its resident mode (the module below) that polls INT keys and walks the pet. Guide: HOW-TO-RPG-PET.md.
     RULES: no angle brackets inside comments. -->
<window label="${title}" class="df-hq database-window fixed-size managed user-resizable" vars="state/ui.txt state/clock_ui.txt">
  <module src="@.apps/df-hq/ops/+x/df_hq.+x"/>
  <page name="main">
    <tabbar id="toolbar" class="tab-bar">
      <tab id="tb-int" class="tab rp-tb ${interact_class}" label="INT ${interact_label}" relay="${rp_h1},${rp_h2}" onclick="'${HOUSE}/@.apps/df-hq/ops/+x/df_hq.+x' int"/>
      <tab id="tb-book" class="tab rp-tb" label="${book_label} ▾" onclick="ACTIVATE" target_id="tb-book"/>
      <tab id="tb-page" class="tab rp-tb" label="${page_label} ▾" onclick="ACTIVATE" target_id="tb-page"/>
      <tab id="tb-shop" class="tab rp-tb" label="Shop ▾" onclick="ACTIVATE" target_id="tb-shop"/>
      <tab id="tb-menu" class="tab rp-tb" label="Menu ▾" onclick="ACTIVATE" target_id="tb-menu"/>
      <tab id="tb-help" class="tab rp-tb" label="Help ▾" onclick="ACTIVATE" target_id="tb-help"/>
      <tab id="tb-player" class="tab rp-tb" label="Player ▾" onclick="ACTIVATE" target_id="tb-player"/>
      <tab id="tb-time" class="tab rp-tb" label="${time_label} ▾" onclick="ACTIVATE" target_id="tb-time"/>
    </tabbar>
    <sidebar id="side" class="sidebar">
      <repeat count="${n_party}" bind="party">
        <item id="bk-${party.#}" class="rp-menu-row dropdown-child ${party.cls}" target_id="tb-book" label="${party.label}" action="'${HOUSE}/@.apps/df-hq/ops/+x/df_hq.+x' select ${party.id}"/>
      </repeat>
      <item id="bk-cancel" class="rp-menu-row dropdown-child quiet" target_id="tb-book" label="- cancel -" action="void"/>
      <repeat count="${n_room}" bind="room">
        <item id="rm${room.#}" class="rp-menu-row dropdown-child" target_id="tb-page" label="${room.label}" action="'${HOUSE}/@.apps/df-hq/ops/+x/df_hq.+x' goto ${room.id}"/>
      </repeat>
      <item id="rm-cancel" class="rp-menu-row dropdown-child quiet" target_id="tb-page" label="- cancel -" action="void"/>
      <item id="tm-cent" class="rp-menu-row dropdown-child" target_id="tb-time" label="speed: turbo (testing)" action="'${HOUSE}/@.apps/df-hq/ops/+x/df_hq.+x' clock rate cent"/>
      <item id="tm-sec" class="rp-menu-row dropdown-child" target_id="tb-time" label="speed: fast (1 hour/sec)" action="'${HOUSE}/@.apps/df-hq/ops/+x/df_hq.+x' clock rate sec"/>
      <item id="tm-min" class="rp-menu-row dropdown-child" target_id="tb-time" label="speed: normal (1 min/sec)" action="'${HOUSE}/@.apps/df-hq/ops/+x/df_hq.+x' clock rate min"/>
      <item id="tm-hour" class="rp-menu-row dropdown-child" target_id="tb-time" label="speed: real time" action="'${HOUSE}/@.apps/df-hq/ops/+x/df_hq.+x' clock rate hour"/>
      <item id="tm-adv1h" class="rp-menu-row dropdown-child" target_id="tb-time" label="skip +1 hour" action="'${HOUSE}/@.apps/df-hq/ops/+x/df_hq.+x' clock advance 1h"/>
      <item id="tm-adv1d" class="rp-menu-row dropdown-child" target_id="tb-time" label="skip +1 day" action="'${HOUSE}/@.apps/df-hq/ops/+x/df_hq.+x' clock advance 1d"/>
      <item id="tm-reinst" class="rp-menu-row dropdown-child" target_id="tb-time" label="reinstall schedule" action="'${HOUSE}/@.apps/df-hq/ops/+x/df_hq.+x' clock reinstall"/>
      <item id="tm-cancel" class="rp-menu-row dropdown-child quiet" target_id="tb-time" label="- cancel -" action="void"/>
      <repeat count="${n_shop}" bind="shop">
        <item id="sh${shop.#}" class="rp-menu-row dropdown-child" target_id="tb-shop" label="${shop.label}" action="'${HOUSE}/@.apps/df-hq/ops/+x/df_hq.+x' buy ${shop.key}"/>
      </repeat>
      <item id="sh-cancel" class="rp-menu-row dropdown-child quiet" target_id="tb-shop" label="- cancel -" action="void"/>
      <item id="mn-chat" class="rp-menu-row dropdown-child" target_id="tb-menu" label="Chat show / hide" action="'${HOUSE}/@.apps/df-hq/ops/+x/df_hq.+x' toggle chat"/>
      <item id="mn-hotbar" class="rp-menu-row dropdown-child" target_id="tb-menu" label="Hotbar show / hide" action="'${HOUSE}/@.apps/df-hq/ops/+x/df_hq.+x' toggle hb"/>
      <item id="mn-control" class="rp-menu-row dropdown-child" target_id="tb-menu" label="${control_label} (switch: Tab)" action="'${HOUSE}/@.apps/df-hq/ops/+x/df_hq.+x' control"/>
      <item id="mn-voice" class="rp-menu-row dropdown-child" target_id="tb-menu" label="Voice on / off" action="'${HOUSE}/@.apps/df-hq/ops/+x/df_hq.+x' toggle voice"/>
      <item id="mn-view" class="rp-menu-row dropdown-child" target_id="tb-menu" label="View: 2D / 3D / glyph" action="'${HOUSE}/@.apps/df-hq/ops/+x/df_hq.+x' view"/>
      <item id="mn-dig" class="rp-menu-row dropdown-child" target_id="tb-menu" label="Dig: mark the tile in front" action="'${HOUSE}/@.apps/df-hq/ops/+x/df_hq.+x' dig"/>
      <item id="mn-dig-area" class="rp-menu-row dropdown-child" target_id="tb-menu" label="Dig area: set a corner / mark the area" action="'${HOUSE}/@.apps/df-hq/ops/+x/df_hq.+x' dig_area"/>
      <item id="mn-undig" class="rp-menu-row dropdown-child" target_id="tb-menu" label="Dig: cancel the mark in front" action="'${HOUSE}/@.apps/df-hq/ops/+x/df_hq.+x' undig"/>
      <item id="mn-help" class="rp-menu-row dropdown-child" target_id="tb-menu" label="Help: how to dig (click for the next step)" action="'${HOUSE}/@.apps/df-hq/ops/+x/df_hq.+x' help"/>
      <item id="mn-reset" class="rp-menu-row dropdown-child" target_id="tb-menu" label="Reset house (keeps a backup)" action="'${HOUSE}/@.apps/df-hq/ops/+x/df_hq.+x' reset"/>
      <item id="hp-open" class="rp-menu-row dropdown-child" target_id="tb-help" label="Open help" action="'${HOUSE}/@.apps/df-hq/ops/+x/df_hq.+x' helppanel open"/>
      <item id="hp-next" class="rp-menu-row dropdown-child" target_id="tb-help" label="Next page" action="'${HOUSE}/@.apps/df-hq/ops/+x/df_hq.+x' helppanel next"/>
      <item id="hp-prev" class="rp-menu-row dropdown-child" target_id="tb-help" label="Prev page" action="'${HOUSE}/@.apps/df-hq/ops/+x/df_hq.+x' helppanel prev"/>
      <item id="hp-close" class="rp-menu-row dropdown-child" target_id="tb-help" label="Close help" action="'${HOUSE}/@.apps/df-hq/ops/+x/df_hq.+x' helppanel close"/>
      <item id="hp-cancel" class="rp-menu-row dropdown-child quiet" target_id="tb-help" label="- cancel -" action="void"/>
      <item id="mn-cancel" class="rp-menu-row dropdown-child quiet" target_id="tb-menu" label="- cancel -" action="void"/>
      <item id="pm-mode" class="rp-menu-row dropdown-child" target_id="tb-player" label="${mode_label}" action="'${HOUSE}/@.apps/df-hq/ops/+x/df_hq.+x' mode"/>
      <item id="pm-play" class="rp-menu-row dropdown-child" target_id="tb-player" label="Play" action="'${HOUSE}/@.apps/df-hq/ops/+x/df_hq.+x' play"/>
      <item id="pm-stop" class="rp-menu-row dropdown-child" target_id="tb-player" label="Stop" action="'${HOUSE}/@.apps/df-hq/ops/+x/df_hq.+x' stop"/>
      <item id="pm-save" class="rp-menu-row dropdown-child" target_id="tb-player" label="Save (slot 1)" action="'${HOUSE}/@.apps/df-hq/ops/+x/df_hq.+x' save 1"/>
      <item id="pm-load" class="rp-menu-row dropdown-child" target_id="tb-player" label="Load (slot 1)" action="'${HOUSE}/@.apps/df-hq/ops/+x/df_hq.+x' load 1"/>
      <item id="pm-new" class="rp-menu-row dropdown-child" target_id="tb-player" label="New game" action="'${HOUSE}/@.apps/df-hq/ops/+x/df_hq.+x' newgame"/>
      <item id="pm-load0" class="rp-menu-row dropdown-child" target_id="tb-player" label="Undo new game" action="'${HOUSE}/@.apps/df-hq/ops/+x/df_hq.+x' load 0"/>
      <item id="pm-save2" class="rp-menu-row dropdown-child" target_id="tb-player" label="Save (slot 2)" action="'${HOUSE}/@.apps/df-hq/ops/+x/df_hq.+x' save 2"/>
      <item id="pm-load2" class="rp-menu-row dropdown-child" target_id="tb-player" label="Load (slot 2)" action="'${HOUSE}/@.apps/df-hq/ops/+x/df_hq.+x' load 2"/>
      <item id="pm-fort" class="rp-menu-row dropdown-child" target_id="tb-player" label="Load test fortress" action="'${HOUSE}/@.apps/df-hq/ops/+x/df_hq.+x' load fortress"/>
      <item id="pm-cancel" class="rp-menu-row dropdown-child quiet" target_id="tb-player" label="- cancel -" action="void"/>
      <text id="light" label="${run_label}" class="${run_cls}"/>
      <text label="coins ${coins}" class="rp-big"/>
      <text label="${note}" class="ph-green"/>
      <text label="${nick_line}" class="ph-quiet"/>
      <text label="${wallet_line}" class="ph-quiet"/>
      <text label="${profile_line}" class="ph-quiet"/>
      <text label="${friend_line}" class="ph-quiet"/>
      <text label="${stat_line}" class="ph-quiet"/>
      <text label="${stat_line2}" class="ph-quiet"/>
      <text label="in this room (click to pick up)" class="rp-quiet"/>
      <scrolllist>
        <repeat count="${n_placed}" bind="placed">
          <item id="pl${placed.#}" class="rp-row" label="${placed.label}" action="'${HOUSE}/@.apps/df-hq/ops/+x/df_hq.+x' remove ${placed.id}"/>
        </repeat>
      </scrolllist>
    </sidebar>
    <panel id="room_p" class="rp-panel">
      <canvas id="room" class="rp-room" sprite="${canvas_raw}"/>
      <row id="help-ov" class="canvas-overlay-left ov-pin ov-chrome rp-help-ov theme" show="${help_visible}">
        <text label="${help_0}" class="hb-quiet ov-title theme-3"/>
        <text label="${help_1}" class="rp-chat"/>
        <text label="${help_2}" class="rp-chat"/>
        <text label="${help_3}" class="rp-chat"/>
        <text label="${help_4}" class="rp-chat"/>
        <text label="${help_5}" class="rp-chat"/>
        <text label="${help_6}" class="rp-chat"/>
        <text label="${help_7}" class="rp-chat"/>
        <text label="${help_8}" class="rp-chat"/>
        <text label="${help_9}" class="rp-chat"/>
        <text label="${help_10}" class="rp-chat"/>
        <item id="help-next" class="rp-menu-row rp-help-row" label="next page" action="'${HOUSE}/@.apps/df-hq/ops/+x/df_hq.+x' helppanel next"/>
        <item id="help-x" class="rp-menu-row rp-help-row" label="close help" action="'${HOUSE}/@.apps/df-hq/ops/+x/df_hq.+x' helppanel close"/>
      </row>
      <row id="chat-ov" class="canvas-overlay-right ov-pin ov-chrome rp-chat-ov theme" show="${chat_visible}">
        <text label="chat - ${active_name}" class="hb-quiet ov-title theme-3"/>
        <item id="chat-min" class="ov-min hb-slot skin-bar theme-3" label="_" action="'${HOUSE}/@.apps/df-hq/ops/+x/df_hq.+x' toggle chat"/>
        <item id="chat-clear" class="rp-menu-row" label="clear chat" action="'${HOUSE}/@.apps/df-hq/ops/+x/df_hq.+x' clearchat"/>
        <text label="${chat_0}" class="rp-chat ${chat_cls_0}"/>
        <text label="${chat_1}" class="rp-chat ${chat_cls_1}"/>
        <text label="${chat_2}" class="rp-chat ${chat_cls_2}"/>
        <text label="${chat_3}" class="rp-chat ${chat_cls_3}"/>
        <text label="${chat_4}" class="rp-chat ${chat_cls_4}"/>
        <text label="${chat_5}" class="rp-chat ${chat_cls_5}"/>
        <text label="${chat_6}" class="rp-chat ${chat_cls_6}"/>
        <text label="${chat_7}" class="rp-chat ${chat_cls_7}"/>
        <text label="${chat_8}" class="rp-chat ${chat_cls_8}"/>
        <text label="${chat_9}" class="rp-chat ${chat_cls_9}"/>
        <cli_io id="say" target_id="rp-say" rows="3" class="rp-say" label="&gt; " action="'${PKG}/ops/+x/df_hq.+x'"/>
      </row>
      <row id="hotbar-ov" class="canvas-overlay-bottom ov-chrome ov-slide-x rp-hotbar theme" show="${hb_visible}">
        <text label="${hb_title}" class="hb-quiet ov-title theme-3"/>
        <item id="hb-min" class="ov-min hb-slot skin-bar theme-3" label="_" action="'${HOUSE}/@.apps/df-hq/ops/+x/df_hq.+x' toggle hb"/>
        <repeat count="${hb_n_slots}" bind="hb">
          <item id="hbs${hb.#}" class="hb-slot skin-bar" label="${hb.text}" action="'${HOUSE}/@.apps/df-hq/ops/+x/df_hq.+x' use ${hb.key}"/>
        </repeat>
      </row>
    </panel>
    <footer id="statusbar" class="pchq-footer">
      <text label="tii" class="quiet"/>
      <item id="chat-toggle" class="pchq-ft skin-bar" label="chat" action="'${HOUSE}/@.apps/df-hq/ops/+x/df_hq.+x' toggle chat"/>
      <item id="hb-toggle" class="pchq-ft skin-bar" label="hb" action="'${HOUSE}/@.apps/df-hq/ops/+x/df_hq.+x' toggle hb"/>
      <repeat count="${n_party}" bind="party">
        <item id="pt${party.#}" class="pchq-ft skin-bar ${party.cls}" label="${party.label}" action="'${HOUSE}/@.apps/df-hq/ops/+x/df_hq.+x' select ${party.id}"/>
      </repeat>
    </footer>
  </page>
</window>
