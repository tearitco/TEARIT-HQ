# main_module.pal - pieces/chtpm/layouts/main.chtpm's own dedicated
# module, per xyzos-standards §41's per-screen module convention.
# Structure copied directly from my-chara-txt's own pal/main_module.pal.
#
# FIXED (2026-08-02, was a known limitation): mybiotech_menu_input's
# RESEARCH command used to make a SYNCHRONOUS real Gemma-LAN call,
# blocking this whole module for the full call duration (observed
# ~45-70s). Now launches ops/mybiotech_research_worker.+x as a detached,
# PID-tracked background process (same pattern chain_miner.+x uses) and
# returns immediately - this loop keeps rendering/accepting input the
# entire time a research call is in flight. mybiotech_compose_frame.c
# polls pieces/system/research_status.txt to show live "researching..."
# progress.
li x1, 0

li x9, 0
mybiotech_menu_input x9
mybiotech_compose_frame
hit_frame
read_pos x7, "pieces/display/mybiotech_screen_changed.txt"

loop:
li x9, 0
mybiotech_menu_input x9
read_pos x8, "pieces/display/mybiotech_screen_changed.txt"
beq x7, x8, check_key
addi x7, x8, 0
j render

check_key:
read_history pieces/apps/player_app/interact_relay.txt x2, x1
beq x2, x0, no_key
mybiotech_menu_input x2
j render

no_key:
sleep 30000
j loop

render:
mybiotech_compose_frame
hit_frame
sleep 30000
j loop
