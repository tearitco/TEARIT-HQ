<!-- media-daw-hq — HOW2_DAW pass-2. Page-level canvas (nested canvas in
     panel is not laid out). Tabbar like csv-hq; chrome like pchq. -->
<window label="Muchi DAW - ${lcd}" class="database-window" vars="state/media_daw_hq_ui.txt">
  <module src="@.apps/media-daw-hq/ops/+x/media_daw_hq_manager.+x" id="_"/>
  <page name="main">
    <item id="close" class="chrome-btn" label="x" onclick="CLOSE"/>
    <item id="fullscreen" class="chrome-btn" label="!" onclick="TOGGLE_FULLSCREEN"/>
    <item id="minimize" class="chrome-btn" label="_" onclick="MINIMIZE"/>
    <tabbar class="tab-bar">
      <tab id="new" class="tab" label="New"
           action="'${HOUSE}/@.apps/media-daw-hq/ops/media_daw_hq_action.sh' 'NEW'"/>
      <tab id="demo" class="tab" label="Demo"
           action="'${HOUSE}/@.apps/media-daw-hq/ops/media_daw_hq_action.sh' 'DEMO'"/>
      <tab id="addtrk" class="tab" label="+ Track"
           action="'${HOUSE}/@.apps/media-daw-hq/ops/media_daw_hq_action.sh' 'ADD_TRACK'"/>
      <tab id="mixtgl" class="tab" label="Mixer"
           action="'${HOUSE}/@.apps/media-daw-hq/ops/media_daw_hq_action.sh' 'MIX_TOGGLE'"/>
    </tabbar>
    <tabbar class="tab-bar">
      <tab id="rew" class="tab" label="|&lt;"
           action="'${HOUSE}/@.apps/media-daw-hq/ops/media_daw_hq_action.sh' 'REW'"/>
      <tab id="stop" class="tab" label="[]"
           action="'${HOUSE}/@.apps/media-daw-hq/ops/media_daw_hq_action.sh' 'STOP'"/>
      <tab id="play" class="tab ${play_cls}" label="${play_label}"
           action="'${HOUSE}/@.apps/media-daw-hq/ops/media_daw_hq_action.sh' 'PLAY'"/>
      <tab id="rec" class="tab ${rec_cls}" label="(o) rec"
           action="'${HOUSE}/@.apps/media-daw-hq/ops/media_daw_hq_action.sh' 'REC'"/>
      <tab id="cyc" class="tab ${cycle_cls}" label="cyc"
           action="'${HOUSE}/@.apps/media-daw-hq/ops/media_daw_hq_action.sh' 'CYCLE'"/>
      <tab id="bpmdn" class="tab" label="BPM -"
           action="'${HOUSE}/@.apps/media-daw-hq/ops/media_daw_hq_action.sh' 'BPM:-'"/>
      <tab id="bpmup" class="tab" label="BPM +"
           action="'${HOUSE}/@.apps/media-daw-hq/ops/media_daw_hq_action.sh' 'BPM:+'"/>
    </tabbar>
    <canvas id="view" class="ms-canvas" sprite="${canvas_raw}"/>
    <text label="${gutter}" class="ms-gutter"/>
    <repeat count="${n_tracks}" bind="t">
      <item id="trk${t.#}" class="daw-trk ${t.cls}" label="${t.hdr}"
            action="'${HOUSE}/@.apps/media-daw-hq/ops/media_daw_hq_action.sh' 'SEL_TRACK:${t.#}'"
            backspace_action="'${HOUSE}/@.apps/media-daw-hq/ops/media_daw_hq_action.sh' 'MUTE:${t.#}'"/>
    </repeat>
    <repeat count="${n_mix}" bind="m">
      <item id="mx${m.#}" class="daw-mx" label="${m.fader}"
            action="'${HOUSE}/@.apps/media-daw-hq/ops/media_daw_hq_action.sh' 'FADER:${m.#}'"/>
    </repeat>
  </page>
</window>
