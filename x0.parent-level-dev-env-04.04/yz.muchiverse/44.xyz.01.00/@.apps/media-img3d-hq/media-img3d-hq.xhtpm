<!-- media-img3d-hq.xhtpm
     Combined 2D image editor + 3D viewport. Skeleton 2 (sidebar+panel+canvas).
     One manager, one template, camera state shared. Actions via
     media_img3d_hq_action.sh — zero renderer C. -->
<window label="Muchi Image + 3D - ${mode_label}" class="database-window" vars="state/media_img3d_hq_ui.txt">
  <module src="@.apps/media-img3d-hq/ops/+x/media_img3d_hq_manager.+x" id="_"/>
  <page name="main">
    <sidebar id="side" class="ms-side">
      <tabbar class="tab-bar">
        <tab id="new" class="tab" label="New"
             action="'${HOUSE}/@.apps/media-img3d-hq/ops/media_img3d_hq_action.sh' 'NEW'"/>
        <tab id="demo" class="tab" label="Demo"
             action="'${HOUSE}/@.apps/media-img3d-hq/ops/media_img3d_hq_action.sh' 'DEMO'"/>
        <tab id="export" class="tab" label="Export"
             action="'${HOUSE}/@.apps/media-img3d-hq/ops/media_img3d_hq_action.sh' 'EXPORT'"/>
      </tabbar>
      <row class="toolbar">
        <item id="m2d" class="ms-btn ${mode2d_cls}" label="2D"
              action="'${HOUSE}/@.apps/media-img3d-hq/ops/media_img3d_hq_action.sh' 'MODE:2D'"/>
        <item id="m3d" class="ms-btn ${mode3d_cls}" label="3D"
              action="'${HOUSE}/@.apps/media-img3d-hq/ops/media_img3d_hq_action.sh' 'MODE:3D'"/>
      </row>
      <text label="tools" class="ms-quiet"/>
      <row class="toolbar" show="${show_2d}">
        <item id="tb" class="ms-btn ${tB}" label="B"
              action="'${HOUSE}/@.apps/media-img3d-hq/ops/media_img3d_hq_action.sh' 'TOOL:B'"/>
        <item id="te" class="ms-btn ${tE}" label="E"
              action="'${HOUSE}/@.apps/media-img3d-hq/ops/media_img3d_hq_action.sh' 'TOOL:E'"/>
        <item id="tg" class="ms-btn ${tG}" label="G"
              action="'${HOUSE}/@.apps/media-img3d-hq/ops/media_img3d_hq_action.sh' 'TOOL:G'"/>
        <item id="tr" class="ms-btn ${tR}" label="R"
              action="'${HOUSE}/@.apps/media-img3d-hq/ops/media_img3d_hq_action.sh' 'TOOL:R'"/>
        <item id="ti" class="ms-btn ${tI}" label="I"
              action="'${HOUSE}/@.apps/media-img3d-hq/ops/media_img3d_hq_action.sh' 'TOOL:I'"/>
        <item id="th" class="ms-btn ${tH}" label="H"
              action="'${HOUSE}/@.apps/media-img3d-hq/ops/media_img3d_hq_action.sh' 'TOOL:H'"/>
      </row>
      <row class="toolbar" show="${show_3d}">
        <item id="tsel" class="ms-btn ${tSEL}" label="Sel"
              action="'${HOUSE}/@.apps/media-img3d-hq/ops/media_img3d_hq_action.sh' 'TOOL:SEL'"/>
        <item id="tgr" class="ms-btn ${tGRAB}" label="Grab"
              action="'${HOUSE}/@.apps/media-img3d-hq/ops/media_img3d_hq_action.sh' 'TOOL:GRAB'"/>
        <item id="trot" class="ms-btn ${tROT}" label="Rot"
              action="'${HOUSE}/@.apps/media-img3d-hq/ops/media_img3d_hq_action.sh' 'TOOL:ROT'"/>
        <item id="tscl" class="ms-btn ${tSCL}" label="Scl"
              action="'${HOUSE}/@.apps/media-img3d-hq/ops/media_img3d_hq_action.sh' 'TOOL:SCL'"/>
      </row>
      <row class="toolbar" show="${show_2d}">
        <item id="bsz-" class="ms-btn" label="[ -"
              action="'${HOUSE}/@.apps/media-img3d-hq/ops/media_img3d_hq_action.sh' 'BRUSH:-'"/>
        <item id="bsz+" class="ms-btn" label="] +"
              action="'${HOUSE}/@.apps/media-img3d-hq/ops/media_img3d_hq_action.sh' 'BRUSH:+'"/>
        <item id="swap" class="ms-btn" label="X fg/bg"
              action="'${HOUSE}/@.apps/media-img3d-hq/ops/media_img3d_hq_action.sh' 'SWAP_FG'"/>
        <item id="blob" class="ms-btn" label="stroke"
              action="'${HOUSE}/@.apps/media-img3d-hq/ops/media_img3d_hq_action.sh' 'STROKE'"/>
      </row>
      <row class="toolbar">
        <item id="cL" class="ms-btn" label="cam &lt;"
              action="'${HOUSE}/@.apps/media-img3d-hq/ops/media_img3d_hq_action.sh' 'CAM:L'"/>
        <item id="cR" class="ms-btn" label="cam &gt;"
              action="'${HOUSE}/@.apps/media-img3d-hq/ops/media_img3d_hq_action.sh' 'CAM:R'"/>
        <item id="cU" class="ms-btn" label="cam ^"
              action="'${HOUSE}/@.apps/media-img3d-hq/ops/media_img3d_hq_action.sh' 'CAM:U'"/>
        <item id="cD" class="ms-btn" label="cam v"
              action="'${HOUSE}/@.apps/media-img3d-hq/ops/media_img3d_hq_action.sh' 'CAM:D'"/>
      </row>
      <row class="toolbar">
        <item id="zin" class="ms-btn" label="zoom +"
              action="'${HOUSE}/@.apps/media-img3d-hq/ops/media_img3d_hq_action.sh' 'CAM:IN'"/>
        <item id="zout" class="ms-btn" label="zoom -"
              action="'${HOUSE}/@.apps/media-img3d-hq/ops/media_img3d_hq_action.sh' 'CAM:OUT'"/>
        <item id="creset" class="ms-btn" label="frame"
              action="'${HOUSE}/@.apps/media-img3d-hq/ops/media_img3d_hq_action.sh' 'CAM:FRAME'"/>
      </row>
      <text label="layers / outliner" class="ms-quiet"/>
      <scrolllist>
        <repeat count="${n_items}" bind="it">
          <item id="row${it.#}" class="ms-row ${it.cls}" label="${it.name}"
                action="'${HOUSE}/@.apps/media-img3d-hq/ops/media_img3d_hq_action.sh' 'PICK:${it.#}'"
                backspace_action="'${HOUSE}/@.apps/media-img3d-hq/ops/media_img3d_hq_action.sh' 'VIS:${it.#}'"/>
        </repeat>
      </scrolllist>
      <row class="toolbar">
        <item id="nlayer" class="ms-btn" label="+ layer"
              action="'${HOUSE}/@.apps/media-img3d-hq/ops/media_img3d_hq_action.sh' 'NEW_LAYER'"/>
        <item id="clayer" class="ms-btn" label="clear"
              action="'${HOUSE}/@.apps/media-img3d-hq/ops/media_img3d_hq_action.sh' 'CLEAR_LAYER'"/>
        <item id="addc" class="ms-btn" label="+ cube"
              action="'${HOUSE}/@.apps/media-img3d-hq/ops/media_img3d_hq_action.sh' 'ADD:CUBE'"/>
        <item id="adds" class="ms-btn" label="+ sph"
              action="'${HOUSE}/@.apps/media-img3d-hq/ops/media_img3d_hq_action.sh' 'ADD:SPHERE'"/>
      </row>
    </sidebar>
    <panel id="main" class="ms-main">
      <text label="${status_line}" class="ms-status"/>
      <canvas id="view" class="ms-canvas" sprite="${canvas_raw}"/>
      <text label="${msg}" class="ms-msg" show="${msg}"/>
    </panel>
  </page>
</window>
