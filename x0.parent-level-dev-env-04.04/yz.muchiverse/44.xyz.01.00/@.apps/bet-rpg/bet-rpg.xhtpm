<!-- Casino Island. Cast and clock are this app's. No wagers yet. No angle brackets in comments. -->
<window label="Casino Island" class="bet-rpg database-window fixed-size managed user-resizable" vars="state/ui.txt state/clock_ui.txt">
  <module src="@.apps/bet-rpg/ops/+x/bet_rpg.+x"/>
  <page name="main">
    <tabbar id="toolbar" class="tab-bar">
      <tab id="tb-int" class="tab rp-tb ${interact_class}" label="INT ${interact_label}" onclick="'${HOUSE}/@.apps/bet-rpg/ops/+x/bet_rpg.+x' int"/>
      <tab id="tb-book" class="tab rp-tb" label="Book ▾" onclick="ACTIVATE" target_id="tb-book"/>
      <tab id="tb-page" class="tab rp-tb" label="Page ▾" onclick="ACTIVATE" target_id="tb-page"/>
      <tab id="tb-menu" class="tab rp-tb" label="Menu ▾" onclick="ACTIVATE" target_id="tb-menu"/>
      <tab id="tb-help" class="tab rp-tb" label="Help ▾" onclick="ACTIVATE" target_id="tb-help"/>
      <tab id="tb-time" class="tab rp-tb" label="${time_label}" onclick="void"/>
    </tabbar>
    <sidebar id="rail" class="sidebar rp-rail">
      <repeat count="${n_party}" bind="pet">
        <item id="bk${pet.#}" class="rp-menu-row dropdown-child" target_id="tb-book" label="${pet.label}" action="'${HOUSE}/@.apps/bet-rpg/ops/+x/bet_rpg.+x' select ${pet.id}"/>
      </repeat>
      <repeat count="${n_town}" bind="town">
        <item id="pg${town.#}" class="rp-menu-row dropdown-child quiet" target_id="tb-page" label="${town.label}" action="void"/>
      </repeat>
      <item id="pg-bj" class="rp-menu-row dropdown-child" target_id="tb-page" label="Sit blackjack" action="'${HOUSE}/@.apps/bet-rpg/ops/+x/bet_rpg.+x' play bj"/>
      <item id="pg-hl" class="rp-menu-row dropdown-child" target_id="tb-page" label="Sit hold'em" action="'${HOUSE}/@.apps/bet-rpg/ops/+x/bet_rpg.+x' play hl"/>
      <item id="pg-rl" class="rp-menu-row dropdown-child" target_id="tb-page" label="Sit roulette" action="'${HOUSE}/@.apps/bet-rpg/ops/+x/bet_rpg.+x' play rl"/>
      <item id="pg-sl" class="rp-menu-row dropdown-child" target_id="tb-page" label="Sit slots" action="'${HOUSE}/@.apps/bet-rpg/ops/+x/bet_rpg.+x' play sl"/>
      <item id="pg-cr" class="rp-menu-row dropdown-child" target_id="tb-page" label="Sit craps" action="'${HOUSE}/@.apps/bet-rpg/ops/+x/bet_rpg.+x' play cr"/>
      <item id="mn-help" class="rp-menu-row dropdown-child" target_id="tb-menu" label="Help" action="'${HOUSE}/@.apps/bet-rpg/ops/+x/bet_rpg.+x' help"/>
      <item id="hp-0" class="rp-menu-row dropdown-child quiet" target_id="tb-help" label="${help_line}" action="void"/>
    </sidebar>
    <panel id="mainp" class="rp-panel">
      <canvas id="island" class="rp-room" sprite="${canvas_raw}"/>
      <row id="side-l" class="canvas-overlay-left ov-pin ov-chrome rp-side-ov theme" show="${left_visible}">
        <text label="info - ${active_name}" class="hb-quiet ov-title theme-3 rp-side-t"/>
        <item id="side-min" class="ov-min hb-slot skin-bar theme-3" label="_" action="'${HOUSE}/@.apps/bet-rpg/ops/+x/bet_rpg.+x' toggle left"/>
        <text label="${phase_line}" class="rp-big rp-side-t"/>
        <item id="side-room" class="rp-menu-row" label="${room_line}" action="void"/>
        <text label="${note}" class="ph-quiet rp-side-t"/>
        <item id="nv-bet" class="rp-menu-row" label="Bet" action="'${HOUSE}/@.apps/bet-rpg/ops/+x/bet_rpg.+x' act bet" show="${nav_table}"/>
        <item id="nv-hit" class="rp-menu-row" label="Hit" action="'${HOUSE}/@.apps/bet-rpg/ops/+x/bet_rpg.+x' act hit" show="${nav_bj}"/>
        <item id="nv-stand" class="rp-menu-row" label="Stand" action="'${HOUSE}/@.apps/bet-rpg/ops/+x/bet_rpg.+x' act stand" show="${nav_bj}"/>
        <item id="nv-double" class="rp-menu-row" label="Double" action="'${HOUSE}/@.apps/bet-rpg/ops/+x/bet_rpg.+x' act double" show="${nav_bj}"/>
        <item id="nv-check" class="rp-menu-row" label="Check" action="'${HOUSE}/@.apps/bet-rpg/ops/+x/bet_rpg.+x' act check" show="${nav_hl}"/>
        <item id="nv-call" class="rp-menu-row" label="Call" action="'${HOUSE}/@.apps/bet-rpg/ops/+x/bet_rpg.+x' act call" show="${nav_hl}"/>
        <item id="nv-raise" class="rp-menu-row" label="Raise" action="'${HOUSE}/@.apps/bet-rpg/ops/+x/bet_rpg.+x' act raise" show="${nav_hl}"/>
        <item id="nv-fold" class="rp-menu-row" label="Fold" action="'${HOUSE}/@.apps/bet-rpg/ops/+x/bet_rpg.+x' act fold" show="${nav_hl}"/>
        <item id="nv-red" class="rp-menu-row" label="Red" action="'${HOUSE}/@.apps/bet-rpg/ops/+x/bet_rpg.+x' act red" show="${nav_rl}"/>
        <item id="nv-black" class="rp-menu-row" label="Black" action="'${HOUSE}/@.apps/bet-rpg/ops/+x/bet_rpg.+x' act black" show="${nav_rl}"/>
        <item id="nv-odd" class="rp-menu-row" label="Odd" action="'${HOUSE}/@.apps/bet-rpg/ops/+x/bet_rpg.+x' act odd" show="${nav_rl}"/>
        <item id="nv-even" class="rp-menu-row" label="Even" action="'${HOUSE}/@.apps/bet-rpg/ops/+x/bet_rpg.+x' act even" show="${nav_rl}"/>
        <item id="nv-leave" class="rp-menu-row" label="Leave" action="'${HOUSE}/@.apps/bet-rpg/ops/+x/bet_rpg.+x' leave" show="${nav_table}"/>
      </row>
      <row id="chat-ov" class="canvas-overlay-right ov-pin ov-chrome rp-chat-ov theme" show="${chat_visible}">
        <text label="chat - ${active_name}" class="hb-quiet ov-title theme-3"/>
        <item id="chat-min" class="ov-min hb-slot skin-bar theme-3" label="_" action="'${HOUSE}/@.apps/bet-rpg/ops/+x/bet_rpg.+x' toggle chat"/>
        <item id="chat-clear" class="rp-menu-row" label="clear chat" action="'${HOUSE}/@.apps/bet-rpg/ops/+x/bet_rpg.+x' clearchat"/>
        <text label="${chat_0}" class="rp-chat"/>
        <text label="${chat_1}" class="rp-chat"/>
        <text label="${chat_2}" class="rp-chat"/>
        <text label="${chat_3}" class="rp-chat"/>
        <text label="${chat_4}" class="rp-chat"/>
        <text label="${chat_5}" class="rp-chat"/>
        <text label="${chat_6}" class="rp-chat"/>
        <text label="${chat_7}" class="rp-chat"/>
      </row>
    </panel>
    <footer id="statusbar" class="pchq-footer">
      <item id="chat-toggle" class="pchq-ft skin-bar" label="chat" action="'${HOUSE}/@.apps/bet-rpg/ops/+x/bet_rpg.+x' toggle chat"/>
      <item id="left-toggle" class="pchq-ft skin-bar" label="info" action="'${HOUSE}/@.apps/bet-rpg/ops/+x/bet_rpg.+x' toggle left"/>
      <repeat count="${n_party}" bind="party">
        <item id="pt${party.#}" class="pchq-ft skin-bar ${party.cls}" label="${party.label}" action="'${HOUSE}/@.apps/bet-rpg/ops/+x/bet_rpg.+x' select ${party.id}"/>
      </repeat>
    </footer>
  </page>
</window>
