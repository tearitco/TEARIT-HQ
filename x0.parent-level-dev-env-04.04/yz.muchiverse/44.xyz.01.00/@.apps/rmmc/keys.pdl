# keys.pdl - what each GAMEKEY name of rmmc-pchq/pieces/system/keybinds.pdl DOES: one verb page (CONFIG; rmmc_driver holds no verb of its own).
# KEYVERB | gamekey name | verb | arg
KEYVERB | left  | walk | w
KEYVERB | right | walk | e
KEYVERB | up    | walk | n
KEYVERB | down  | walk | s
KEYVERB | jump  | jump | -
KEYVERB | mine  | mine | -
KEYVERB | place | place | -
KEYVERB | craft | craft | -
# RULE rows: poll_ms = how often the driver looks at the relay file; idle_after_ms = how long after the last key the pose goes back to idle (the ledger has no clock, so the DRIVER owns the expiry: it re-projects with --idle)
RULE | poll_ms | 50
# idle_poll_ms: how often the driver looks at the relay file when no key came for 3 s (0 = same as poll_ms). The first key after a rest can be this late (owner 2026-11-26: "its costing on idle")
RULE | idle_poll_ms | 120
RULE | idle_after_ms | 400
# step_ms: the shortest time between two walk steps (a held arrow key repeats ~55 times a second); a press inside it is dropped, not queued. 120 = about 8 cells a second; 0 = every press steps (the old behaviour, a backlog builds)
RULE | step_ms | 100
KEYVERB | slot1 | pick | 1
KEYVERB | slot2 | pick | 2
KEYVERB | slot3 | pick | 3
KEYVERB | slot4 | pick | 4
KEYVERB | slot5 | pick | 5
KEYVERB | slot6 | pick | 6
KEYVERB | slot7 | pick | 7
KEYVERB | slot8 | pick | 8
KEYVERB | slot9 | pick | 9
KEYVERB | page | pick | page
KEYVERB | reset | reset | -
