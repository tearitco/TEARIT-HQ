<!-- media-img-hq — skeleton 3 (page-level canvas). Sidebar+panel does
     not size a nested <canvas> (khtpm_core_render.c only lays canvas
     out as a direct <page> child). -->
<window label="Muchi Image - ${status_line}" class="database-window" vars="state/media_img_hq_ui.txt">
  <module src="@.apps/media-img-hq/ops/+x/media_img_hq_manager.+x" id="_"/>
  <page name="main">
    <item id="new" class="ms-btn" label="New"
          action="'${HOUSE}/@.apps/media-img-hq/ops/media_img_hq_action.sh' 'NEW'"/>
    <item id="demo" class="ms-btn" label="Demo"
          action="'${HOUSE}/@.apps/media-img-hq/ops/media_img_hq_action.sh' 'DEMO'"/>
    <item id="tb" class="ms-btn ${tB}" label="B"
          action="'${HOUSE}/@.apps/media-img-hq/ops/media_img_hq_action.sh' 'TOOL:B'"/>
    <item id="te" class="ms-btn ${tE}" label="E"
          action="'${HOUSE}/@.apps/media-img-hq/ops/media_img_hq_action.sh' 'TOOL:E'"/>
    <item id="tg" class="ms-btn ${tG}" label="G"
          action="'${HOUSE}/@.apps/media-img-hq/ops/media_img_hq_action.sh' 'TOOL:G'"/>
    <item id="tr" class="ms-btn ${tR}" label="R"
          action="'${HOUSE}/@.apps/media-img-hq/ops/media_img_hq_action.sh' 'TOOL:R'"/>
    <item id="ti" class="ms-btn ${tI}" label="I"
          action="'${HOUSE}/@.apps/media-img-hq/ops/media_img_hq_action.sh' 'TOOL:I'"/>
    <item id="th" class="ms-btn ${tH}" label="H"
          action="'${HOUSE}/@.apps/media-img-hq/ops/media_img_hq_action.sh' 'TOOL:H'"/>
    <item id="bsz-" class="ms-btn" label="[ -"
          action="'${HOUSE}/@.apps/media-img-hq/ops/media_img_hq_action.sh' 'BRUSH:-'"/>
    <item id="bsz+" class="ms-btn" label="] +"
          action="'${HOUSE}/@.apps/media-img-hq/ops/media_img_hq_action.sh' 'BRUSH:+'"/>
    <item id="nlayer" class="ms-btn" label="+L"
          action="'${HOUSE}/@.apps/media-img-hq/ops/media_img_hq_action.sh' 'NEW_LAYER'"/>
    <canvas id="view" class="ms-canvas" sprite="${canvas_raw}"/>
    <text label="${gutter}" class="ms-gutter"/>
    <repeat count="${n_items}" bind="it">
      <item id="row${it.#}" class="ms-row ${it.cls}" label="${it.name}"
            action="'${HOUSE}/@.apps/media-img-hq/ops/media_img_hq_action.sh' 'PICK:${it.#}'"
            backspace_action="'${HOUSE}/@.apps/media-img-hq/ops/media_img_hq_action.sh' 'VIS:${it.#}'"/>
    </repeat>
  </page>
</window>
