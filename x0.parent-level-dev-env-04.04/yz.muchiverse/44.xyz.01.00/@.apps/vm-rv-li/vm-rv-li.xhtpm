<!-- vm-rv-li.xhtpm - STATIC layout for the RVLV emulator terminal toy.
     Layout only, never hand-generated by the manager (house §6). The
     <module> above (vm_rv_li_manager.+x) owns all state and publishes
     state/ui.txt as plain key=value; this template just projects it with
     generic tags already proven by co-lab-hai.

     The terminal screen is the UART console text (row_0_text..row_N_text,
     newest lines land at row N = bottom because the manager scrolls the
     grid up on overflow). A <cli_io> at the bottom is the user's input
     line: hitting Enter fires input_action, which the renderer resolves to
     ops/vm_rv_li_input.sh and appends <typed_value> - exactly mirroring
     co-lab-hai's composer, so human and agent write the same relay. -->
<window label="vm-rv-li" class="vm-rv-li database-window" vars="state/ui.txt">
  <module src="@.apps/vm-rv-li/+x/vm_rv_li_manager.+x"/>
  <page name="main">
    <sidebar>
      <text label="vm-rv-li" class="quiet"/>
      <text label="status: ${status}" class="quiet"/>
      <text label="cursor ${cursor_x},${cursor_y}" class="quiet"/>
    </sidebar>
    <panel>
      <scrolllist id="screen" class="terminal-screen from-bottom">
        <repeat count="${rowcount}" bind="row">
          <text label="${row.text}" class="terminal-row"/>
        </repeat>
      </scrolllist>
      <cli_io id="kbd" target_id="kbd" label="&gt; " action="${input_action}"/>
    </panel>
  </page>
</window>
