<!-- pchq-board.xhtpm - MILESTONE A (PCHQ-ENTITY-MENU-AND-TASKBAR-DESIGN.md
     §6a): the board window as a NORMAL sidebar+panel HQ window.

       <sidebar class="pchq-toolbar">  - In/File/Desk/Menu/Player/clock.
         (A2, per direct feedback: move this to a horizontal <tabbar>
          top row + add a <footer> row.)
       <panel id="view-panel"><canvas id="view"/>  - the 2D/3D blit.
         kh_layout_canvas_in_region() fills the panel box with the
         canvas, sets g_has_canvas, wires canvas_raw, writes
         #.desktop/pchq_board_view.txt so bv_render_3d renders that
         exact pixel size (1:1 blit). The dropdown-child panels are
         page-level (NOT nested in the sidebar) so layout_sidebar_panel
         picks view-panel as the content region.

     Free now (no board-specific C): X/!/_ chrome, taskbar entry,
     minimize/restore, and REAL Desk/Menu dropdowns (generic
     onclick="ACTIVATE" + class="dropdown-child" + target_id).

     Rollback: pchq-board.hascanvas.xhtpm (PCHQ_BOARD_HASCANVAS=1). -->
<window label="piececraft-hq board" class="pchq-board-pal database-window managed user-resizable" vars="state/ui.txt">
  <module src="@.apps/piececraft-hq/ops/+x/pchq_board_projector.+x" args="piececraft-hq"/>
  <page name="main">
    <sidebar id="toolbar" class="pchq-toolbar sidebar">
      <item id="tb-in" class="pchq-tb ${interact_class}" label="In: ${interact_label}"
            relay="${bv_h1},${bv_h2}"
            action="'${HOUSE}/@.apps/piececraft-hq/ops/pchq_board_action.sh' '${bv_session}' 'interact'"/>
      <item id="tb-file" class="pchq-tb" label="File"
            action="'${HOUSE}/@.apps/piececraft-hq/ops/pchq_board_action.sh' '${bv_session}' 'file-hq'"/>
      <item id="tb-desk" class="pchq-tb" label="Desk ▾" onclick="ACTIVATE" target_id="tb-desk"/>
      <item id="tb-menu" class="pchq-tb" label="Menu ▾" onclick="ACTIVATE" target_id="tb-menu"/>
      <item id="tb-player" class="pchq-tb quiet" label="Player" action="void"/>
      <item id="tb-clock" class="pchq-tb quiet" label="${clock}" action="void"/>
    </sidebar>

    <panel id="view-panel" class="pchq-view">
      <canvas id="view" sprite="${canvas_raw}"/>
    </panel>

    <!-- dropdown overlays: page-level so they don't shadow view-panel -->
    <panel class="dropdown-child" target_id="tb-desk">
      <repeat count="${n_desk_opts}" bind="d">
        <item id="do-${d.#}" class="pchq-menu-row ${d.active}" label="${d.label}"
              action="'${HOUSE}/@.apps/piececraft-hq/ops/pchq_board_action.sh' '${bv_session}' 'desk' '${d.#}'"/>
      </repeat>
    </panel>
    <panel class="dropdown-child" target_id="tb-menu">
      <item id="mn-entbar" class="pchq-menu-row" label="Entities bar (todo)" action="void"/>
      <item id="mn-db" class="pchq-menu-row quiet" label="Db (todo)" action="void"/>
    </panel>

    <text label="No live board-viewer session - open 'View Board' from the game first." class="quiet" show="${no_session}"/>
  </page>
</window>
