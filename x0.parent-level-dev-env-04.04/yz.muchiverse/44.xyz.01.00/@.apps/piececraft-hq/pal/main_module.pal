# main_module.pal - pieces/chtpm/layouts/main.chtpm's own dedicated
# module, per xyzos-standards §41's per-screen module convention. Same
# proven shape as tactics-txt's own main_module.pal, including that
# file's own real drain-on-launch fix (see its own header comment for
# the full "why a fresh module always starts its own interact_relay.txt
# cursor at 0, and why that requires draining pre-existing backlog
# first" writeup - identical root cause applies here).
li x1, 0

drain:
read_history pieces/apps/player_app/interact_relay.txt x2, x1
beq x2, x0, drain_done
j drain
drain_done:

li x9, 0
pc_menu_input x9
pc_compose_frame
hit_frame
read_pos x7, "pieces/display/pc_screen_changed.txt"

# FOOTPRINT (owner 2026-10-25: "keep our own footprint managed"): pc_menu_input with key 0 is the engine's command pump (it drains
# widget_cmds/inbox.txt, mirrors the HUD tick, notices a piece change). It used to be exec'd on EVERY idle tick (two process spawns,
# ~15 a second). The pal VM's own read_pos (a file size, no process) now says when the inbox holds a command, and the pump
# otherwise runs on every 6th idle tick (~180 ms) for the slow work. The inbox is the REAL instance's (../../.. from this
# session folder pieces/sessions/<id> is the instance root), the same file pc_menu_input drains.
li x6, 0
li x5, 6

# LOOP EXIT (owner 2026-10-26: "have loops exit as well"): when the board-viewer loop of this stack finds its engine gone it appends a byte to
# <instance>/pieces/system/stack_stop.txt (board-viewer ops/loop_guard.c). This loop compares that file's SIZE with the size it saw at boot (marker
# standard, a VM file-size read, no process) and ends too, instead of pumping an engine that no longer exists.
read_pos x10, "../../../pieces/system/stack_stop.txt"

loop:
read_pos x11, "../../../pieces/system/stack_stop.txt"
bne x10, x11, stopped
read_pos x4, "../../../pieces/system/widget_cmds/inbox.txt"
bne x4, x0, pump
addi x6, x6, 1
beq x6, x5, pump
j scan
pump:
li x6, 0
li x9, 0
pc_menu_input x9
scan:
read_pos x8, "pieces/display/pc_screen_changed.txt"
beq x7, x8, check_key
addi x7, x8, 0
j render

check_key:
read_history pieces/apps/player_app/interact_relay.txt x2, x1
beq x2, x0, no_key
pc_menu_input x2
j render

no_key:
sleep 30000
j loop

render:
pc_compose_frame
hit_frame
sleep 30000
j loop

stopped:
halt
