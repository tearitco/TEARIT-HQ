<!-- rpg-edit-hq BOARD window (owner 2026-10-11: rpg-edit-hq as a module of the pc-hq board engine; the old standalone @.apps/rpg-edit-hq/rpg-edit-hq.xhtpm stays beside it for comparison).
     A copy of the layout-studio sandbox board (pinned side bars) with rpg-edit-hq's own rows: the pets and stats are the LEFT bar, chat is the RIGHT bar, the bag hotbar is the bottom overlay,
     the dropdowns are rpg-edit-hq's. The canvas is the board engine frame (2D default, 0 = 3D, 1-4 POV, camera keys, backtick = glyph view) of the book maps/rpg-edit-hq that rpg_edit_hq.+x exports.
     Launch: sh @.apps/rpg-edit-hq/board/open_board.sh. vars: rpg-edit-hq's state files FIRST, the board's after, so canvas_raw / interact_* are the board's. RULES: no angle brackets inside comments. -->
<window label="rpg-edit-hq board" class="pchq-board-pal database-window managed user-resizable" vars="../state/ui.txt ../state/clock_ui.txt state/ui.txt state/pchq/ui.txt state/sides.txt state/pal.txt state/prefs_ui.txt state/ctx.txt">
  <module src="@.apps/piececraft-hq/ops/+x/pchq_board_projector.+x" args="rpg-edit-hq-pchq"/>
  <page name="main">
    <tabbar id="toolbar" class="pchq-toolbar">
      <tab id="tb-in" class="pchq-tb ${interact_class}" label="In: ${interact_label}" relay="${bv_h1},${bv_h2}" onclick="'${HOUSE}/@.apps/rpg-edit-hq/ops/+x/rpg_edit_hq.+x' int"/>
      <tab id="tb-book" class="pchq-tb" label="${book_label} ▾" onclick="ACTIVATE" target_id="tb-book"/>
      <tab id="tb-page" class="pchq-tb" label="${page_label} ▾" onclick="ACTIVATE" target_id="tb-page"/>
      <tab id="tb-menu" class="pchq-tb" label="Menu ▾" onclick="ACTIVATE" target_id="tb-menu"/>
      <tab id="tb-pals" class="pchq-tb" label="Pals ▾" onclick="ACTIVATE" target_id="tb-pals"/>
      <tab id="tb-chat" class="pchq-tb" label="${chat_mode_label} ▾" onclick="ACTIVATE" target_id="tb-chat"/>
      <tab id="tb-shop" class="pchq-tb" label="Shop ▾" onclick="ACTIVATE" target_id="tb-shop"/>
      <!-- 2026-11-04: the ledger (coin) shop, the owner's ONE released caller: ONE tab with 7 item rows (a dropdown that would run off the screen scrolls, so keep it short); picking an item opens the popup below; hidden unless books/shop/RELEASE exists (n_lshop=0) -->
      <tab id="tb-lshop" class="pchq-tb" label="Coin shop ${lshop_coins}c ▾" onclick="ACTIVATE" target_id="tb-lshop" show="${n_lshop}"/>
      <tab id="tb-player" class="pchq-tb" label="${run_label} ▾" onclick="ACTIVATE" target_id="tb-player"/>
      <tab id="tb-time" class="pchq-tb" label="${time_label} ▾" onclick="ACTIVATE" target_id="tb-time"/>
      <tab id="tb-db" class="pchq-tb" label="db ▾" onclick="ACTIVATE" target_id="tb-db"/>
      <tab id="tb-set" class="pchq-tb" label="Settings ▾" onclick="ACTIVATE" target_id="tb-set"/>
      <tab id="tb-load" class="pchq-tb no-nav" label="${load_label}" onclick="void" show="${load_ok}"/>
      <tab id="tb-loadw" class="pchq-tb pchq-tb-warn no-nav" label="${load_label}" onclick="void" show="${load_warn}"/>
    </tabbar>
    <sidebar id="rail" class="pchq-rail sidebar">
      <repeat count="${n_party}" bind="party">
        <item id="bk-${party.#}" class="pchq-menu-row dropdown-child ${party.cls}" target_id="tb-pals" label="${party.label}" action="'${HOUSE}/@.apps/rpg-edit-hq/ops/+x/rpg_edit_hq.+x' select ${party.id}"/>
      </repeat>
      <item id="tp-book-0" class="pchq-menu-row dropdown-child" target_id="tb-pals" label="${book_post_0_label}" action="${book_post_0_act}" show="${book_post_0_label}"/>
      <item id="tp-book-1" class="pchq-menu-row dropdown-child" target_id="tb-pals" label="${book_post_1_label}" action="${book_post_1_act}" show="${book_post_1_label}"/>
      <item id="tp-book-2" class="pchq-menu-row dropdown-child" target_id="tb-pals" label="${book_post_2_label}" action="${book_post_2_act}" show="${book_post_2_label}"/>
      <item id="tp-book-3" class="pchq-menu-row dropdown-child" target_id="tb-pals" label="${book_post_3_label}" action="${book_post_3_act}" show="${book_post_3_label}"/>
      <repeat count="${n_file_opts}" bind="f">
        <item id="fo-${f.#}" class="pchq-menu-row dropdown-child ${f.active}" target_id="tb-book" label="${f.label}" action="'${HOUSE}/@.apps/piececraft-hq/ops/pchq_board_action.sh' '${bv_session}' '${f.verb}' '${f.arg}'"/>
      </repeat>
      <item id="bk-cancel" class="pchq-menu-row dropdown-child quiet" target_id="tb-book" label="- cancel -" action="void"/>
      <repeat count="${n_room}" bind="room">
        <item id="rm${room.#}" class="pchq-menu-row dropdown-child " target_id="tb-page" label="${room.label}" action="'${HOUSE}/@.apps/rpg-edit-hq/ops/+x/rpg_edit_hq.+x' fire goto ${room.id}"/>
      </repeat>
      <item id="tp-page-0" class="pchq-menu-row dropdown-child" target_id="tb-page" label="${page_post_0_label}" action="${page_post_0_act}" show="${page_post_0_label}"/>
      <item id="tp-page-1" class="pchq-menu-row dropdown-child" target_id="tb-page" label="${page_post_1_label}" action="${page_post_1_act}" show="${page_post_1_label}"/>
      <item id="tp-page-2" class="pchq-menu-row dropdown-child" target_id="tb-page" label="${page_post_2_label}" action="${page_post_2_act}" show="${page_post_2_label}"/>
      <item id="tp-page-3" class="pchq-menu-row dropdown-child" target_id="tb-page" label="${page_post_3_label}" action="${page_post_3_act}" show="${page_post_3_label}"/>
      <repeat count="${n_item}" bind="it"><item id="ti-${it.#}" class="pchq-menu-row dropdown-child" target_id="${it.tab}" label="${it.label}" action="${it.act}"/></repeat>
      <repeat count="${n_shop}" bind="shop">
        <item id="sh${shop.#}" class="pchq-menu-row dropdown-child " target_id="tb-shop" label="${shop.label}" action="'${HOUSE}/@.apps/rpg-edit-hq/ops/+x/rpg_edit_hq.+x' fire buy ${shop.key}"/>
      </repeat>
      <item id="sh-cancel" class="pchq-menu-row dropdown-child quiet" target_id="tb-shop" label="- cancel -" action="void"/>
      <repeat count="${n_lshop}" bind="lshop">
        <item id="lshp${lshop.#}" class="pchq-menu-row dropdown-child " target_id="tb-lshop" label="${lshop.row}" action="'${HOUSE}/@.apps/rpg-edit-hq/ops/+x/rpg_edit_hq.+x' fire lshop pick ${lshop.key}"/>
      </repeat>
      <item id="lsh-cancel" class="pchq-menu-row dropdown-child quiet" target_id="tb-lshop" label="- cancel -" action="void"/>
      <item id="mn-control" class="pchq-menu-row dropdown-child " target_id="tb-menu" label="${control_label} (switch: Tab)" action="'${HOUSE}/@.apps/rpg-edit-hq/ops/+x/rpg_edit_hq.+x' fire control"/>
      <item id="mn-voice" class="pchq-menu-row dropdown-child " target_id="tb-menu" label="Voice on / off" action="'${HOUSE}/@.apps/rpg-edit-hq/ops/+x/rpg_edit_hq.+x' toggle voice"/>
      <item id="mn-reset" class="pchq-menu-row dropdown-child " target_id="tb-menu" label="Reset house (keeps a backup)" action="'${HOUSE}/@.apps/rpg-edit-hq/ops/+x/rpg_edit_hq.+x' reset"/>
      <item id="mn-entbar" class="pchq-menu-row dropdown-child " target_id="tb-menu" label="Entities bar on/off" action="sh '${HOUSE}/@.apps/piececraft-hq/ops/pc_toggle_pdl_opt.sh' '${HOUSE}/@.apps/rpg-edit-hq/rpg-edit-hq-pchq/pieces/system/pchq.pdl' 'entities_bar'"/>
      <item id="mn-cancel" class="pchq-menu-row dropdown-child quiet" target_id="tb-menu" label="- cancel -" action="void"/>
      <item id="db-hq" class="pchq-menu-row dropdown-child " target_id="tb-db" label="db-hq" action="sh '${HOUSE}/&.hq-apps/db-hq-pal/button.sh' '${HOUSE}'"/>
      <item id="db-bp" class="pchq-menu-row dropdown-child " target_id="tb-db" label="blueprintz" action="sh '${HOUSE}/&.hq-apps/blueprintz/button.sh' '${HOUSE}'"/>
      <item id="db-sql" class="pchq-menu-row dropdown-child " target_id="tb-db" label="sql-hq" action="sh '${HOUSE}/&.hq-apps/sql-hq/button.sh' '${HOUSE}'"/>
      <!-- Settings (2026-11-03, owner: "a different settings for the rpg-edit inside the player, not the old settings menu"): one row per preference, press = next value. edit_prefs rewrites
           state/prefs.txt (values) and board/state/prefs_ui.txt (these labels); open_board.sh reads editor_open, pal_side.c reads sidebar_start. Add a preference = a row in ops/edit_prefs.c + a row here. -->
      <item id="set-open" class="pchq-menu-row dropdown-child " target_id="tb-set" label="${pref_editor_open_label}" action="'${HOUSE}/@.apps/rpg-edit-hq/ops/+x/edit_prefs.+x' '${HOUSE}' cycle editor_open"/>
      <item id="set-side" class="pchq-menu-row dropdown-child " target_id="tb-set" label="${pref_sidebar_start_label}" action="'${HOUSE}/@.apps/rpg-edit-hq/ops/+x/edit_prefs.+x' '${HOUSE}' cycle sidebar_start"/>
      <item id="set-cancel" class="pchq-menu-row dropdown-child quiet" target_id="tb-set" label="- close -" action="void"/>
      <item id="db-cancel" class="pchq-menu-row dropdown-child quiet" target_id="tb-db" label="- cancel -" action="void"/>
      <item id="pm-int" class="pchq-menu-row dropdown-child " target_id="tb-player" label="INT on/off (arrow keys drive a pet)" action="'${HOUSE}/@.apps/rpg-edit-hq/ops/+x/rpg_edit_hq.+x' int"/>
      <item id="pm-mode" class="pchq-menu-row dropdown-child " target_id="tb-player" label="${mode_label}" action="'${HOUSE}/@.apps/rpg-edit-hq/ops/+x/rpg_edit_hq.+x' mode"/>
      <item id="pm-play" class="pchq-menu-row dropdown-child " target_id="tb-player" label="Play" action="'${HOUSE}/@.apps/rpg-edit-hq/ops/+x/rpg_edit_hq.+x' play"/>
      <item id="pm-stop" class="pchq-menu-row dropdown-child " target_id="tb-player" label="Stop" action="'${HOUSE}/@.apps/rpg-edit-hq/ops/+x/rpg_edit_hq.+x' stop"/>
      <item id="pm-blueprintz" class="pchq-menu-row dropdown-child " target_id="tb-player" label="blueprintz" action="sh '${HOUSE}/_.monads/_.livedesk-taskbar/ops/open_blueprintz.sh'"/>
      <item id="pm-save" class="pchq-menu-row dropdown-child " target_id="tb-player" label="Save (slot 1)" action="'${HOUSE}/@.apps/rpg-edit-hq/ops/+x/rpg_edit_hq.+x' fire save 1"/>
      <item id="pm-load" class="pchq-menu-row dropdown-child " target_id="tb-player" label="Load (slot 1)" action="'${HOUSE}/@.apps/rpg-edit-hq/ops/+x/rpg_edit_hq.+x' fire load 1"/>
      <item id="pm-synch" class="pchq-menu-row dropdown-child " target_id="tb-player" label="Synch (desk to game)" action="'${HOUSE}/@.apps/rpg-edit-hq/ops/+x/rpg_edit_hq.+x' synch"/>
      <item id="pm-synch2" class="pchq-menu-row dropdown-child " target_id="tb-player" label="Synch (game to desk)" action="'${HOUSE}/@.apps/rpg-edit-hq/ops/+x/rpg_edit_hq.+x' synch to-desk"/>
      <item id="pm-cancel" class="pchq-menu-row dropdown-child quiet" target_id="tb-player" label="- cancel -" action="void"/>
      <item id="ch-edit" class="pchq-menu-row dropdown-child " target_id="tb-chat" label="edit (pet chat)" action="'${HOUSE}/@.apps/rpg-edit-hq/ops/+x/rpg_edit_hq.+x' chatmode edit"/>
      <item id="ch-hai" class="pchq-menu-row dropdown-child " target_id="tb-chat" label="h-ai (API, edits this book)" action="'${HOUSE}/@.apps/rpg-edit-hq/ops/+x/rpg_edit_hq.+x' chatmode hai"/>
      <item id="ch-net" class="pchq-menu-row dropdown-child " target_id="tb-chat" label="network (pets, read only)" action="'${HOUSE}/@.apps/rpg-edit-hq/ops/+x/rpg_edit_hq.+x' chatmode network"/>
      <item id="ch-nroom" class="pchq-menu-row dropdown-child " target_id="tb-chat" label="net: next room" action="'${HOUSE}/@.apps/rpg-edit-hq/ops/+x/rpg_edit_hq.+x' netroom next"/>
      <item id="ch-nkill" class="pchq-menu-row dropdown-child " target_id="tb-chat" label="net: pet kill switch" action="'${HOUSE}/@.apps/rpg-edit-hq/ops/+x/rpg_edit_hq.+x' netguard kill"/>
      <item id="ch-nok" class="pchq-menu-row dropdown-child " target_id="tb-chat" label="net: approve held pet line" action="'${HOUSE}/@.apps/rpg-edit-hq/ops/+x/rpg_edit_hq.+x' netguard approve"/>
      <item id="ch-nno" class="pchq-menu-row dropdown-child " target_id="tb-chat" label="net: veto held pet line" action="'${HOUSE}/@.apps/rpg-edit-hq/ops/+x/rpg_edit_hq.+x' netguard veto"/>
      <item id="tm-cent" class="pchq-menu-row dropdown-child " target_id="tb-time" label="speed: turbo (testing)" action="'${HOUSE}/@.apps/rpg-edit-hq/ops/+x/rpg_edit_hq.+x' clock rate cent"/>
      <item id="tm-sec" class="pchq-menu-row dropdown-child " target_id="tb-time" label="speed: fast (1 hour/sec)" action="'${HOUSE}/@.apps/rpg-edit-hq/ops/+x/rpg_edit_hq.+x' clock rate sec"/>
      <item id="tm-min" class="pchq-menu-row dropdown-child " target_id="tb-time" label="speed: normal (1 min/sec)" action="'${HOUSE}/@.apps/rpg-edit-hq/ops/+x/rpg_edit_hq.+x' clock rate min"/>
      <item id="tm-hour" class="pchq-menu-row dropdown-child " target_id="tb-time" label="speed: real time" action="'${HOUSE}/@.apps/rpg-edit-hq/ops/+x/rpg_edit_hq.+x' clock rate hour"/>
      <item id="tm-adv1h" class="pchq-menu-row dropdown-child " target_id="tb-time" label="skip +1 hour" action="'${HOUSE}/@.apps/rpg-edit-hq/ops/+x/rpg_edit_hq.+x' clock advance 1h"/>
      <item id="tm-adv1d" class="pchq-menu-row dropdown-child " target_id="tb-time" label="skip +1 day" action="'${HOUSE}/@.apps/rpg-edit-hq/ops/+x/rpg_edit_hq.+x' clock advance 1d"/>
      <item id="tm-start" class="pchq-menu-row dropdown-child " target_id="tb-time" label="clock: start / resume" action="'${HOUSE}/@.apps/rpg-edit-hq/ops/+x/rpg_edit_hq.+x' clock start"/>
      <item id="tm-stop" class="pchq-menu-row dropdown-child " target_id="tb-time" label="clock: pause" action="'${HOUSE}/@.apps/rpg-edit-hq/ops/+x/rpg_edit_hq.+x' clock stop"/>
      <item id="tm-adv10m" class="pchq-menu-row dropdown-child " target_id="tb-time" label="skip +10 minutes" action="'${HOUSE}/@.apps/rpg-edit-hq/ops/+x/rpg_edit_hq.+x' clock advance 10m"/>
      <item id="tm-adv6h" class="pchq-menu-row dropdown-child " target_id="tb-time" label="skip +6 hours" action="'${HOUSE}/@.apps/rpg-edit-hq/ops/+x/rpg_edit_hq.+x' clock advance 6h"/>
      <item id="tm-reinst" class="pchq-menu-row dropdown-child " target_id="tb-time" label="reinstall schedule" action="'${HOUSE}/@.apps/rpg-edit-hq/ops/+x/rpg_edit_hq.+x' clock reinstall"/>
      <item id="tm-cancel" class="pchq-menu-row dropdown-child quiet" target_id="tb-time" label="- cancel -" action="void"/>
    </sidebar>
    <panel id="view-panel" class="pchq-view">
      <canvas id="view" sprite="${canvas_raw}"/>
      <!-- LEFT pinned bar: the pets and their stats. Pinned = takes its width out of the canvas (class ov-pin, width from side_style.pdl), the _ hides it, the footer cell left toggles it. -->
      <row id="side-l" class="canvas-overlay-left ov-pin ov-scroll ov-chrome pchq-hotbar theme" show="${side_left}">
        <text label="pets - coins ${coins}" class="hb-quiet ov-title theme-3 ov-line"/>
        <item id="sl-min" class="ov-min hb-slot skin-bar theme-3" label="_" action="'${HOUSE}/@.apps/rpg-edit-hq/ops/+x/pal_side.+x' '${HOUSE}' none"/>
        <text id="light" label="${run_label}" class="${run_cls} ov-line"/>
        <text label="${nick_line}" class="ph-quiet ov-line"/>
        <text label="${stat_line}" class="ph-quiet ov-line"/>
        <text label="${stat_line2}" class="ph-quiet ov-line"/>
        <repeat count="${n_party}" bind="party">
          <item id="pt${party.#}" class="pchq-ft skin-bar ${party.cls}" label="${party.label}" action="'${HOUSE}/@.apps/rpg-edit-hq/ops/+x/rpg_edit_hq.+x' select ${party.id}"/>
        </repeat>
      </row>
      <!-- LEFT pinned bar, palettes (shares the left slot with the pets bar: pal_side writes side_left / side_pal together, so only one shows). Two views by state key: the category list (pal_is_list), or one category (pal_is_tiles) with a back row. Tiles: the category's tiles as sprite rows; a click arms the brush (pal_side arm). -->
      <row id="side-p" class="canvas-overlay-left ov-pin ov-scroll ov-chrome pchq-hotbar theme" show="${side_pal}">
        <text label="${pal_title}" class="hb-quiet ov-title theme-3 ov-line"/>
        <text label="${pal_sub}" class="ph-quiet ov-line" show="${pal_sub}"/>
        <item id="sp-min" class="ov-min hb-slot skin-bar theme-3" label="_" action="'${HOUSE}/@.apps/rpg-edit-hq/ops/+x/pal_side.+x' '${HOUSE}' none"/>
        <item id="sp-back" class="pchq-ft skin-bar" label="&lt; back" show="${pal_can_back}" action="'${HOUSE}/@.apps/rpg-edit-hq/ops/+x/pal_side.+x' '${HOUSE}' back"/>
        <repeat count="${n_pcat}" bind="pcat">
          <item id="pc${pcat.#}" class="pchq-ft skin-bar" label="${pcat.label}" show="${pal_is_list}" action="'${HOUSE}/@.apps/rpg-edit-hq/ops/+x/pal_side.+x' '${HOUSE}' pick ${pcat.key}"/>
        </repeat>
        <text label="no tile grid for this palette yet" class="ph-quiet ov-line" show="${pal_empty}"/>
        <text label="${pal_more}" class="ph-quiet ov-line" show="${pal_more}"/>
        <item id="sp-prev" class="pchq-ft skin-bar" label="&lt; previous 48" show="${pal_can_prev}" action="'${HOUSE}/@.apps/rpg-edit-hq/ops/+x/pal_side.+x' '${HOUSE}' prev"/>
        <item id="sp-next" class="pchq-ft skin-bar" label="next 48 &gt;" show="${pal_can_next}" action="'${HOUSE}/@.apps/rpg-edit-hq/ops/+x/pal_side.+x' '${HOUSE}' next"/>
        <text label="armed: ${pal_armed}" class="ph-quiet ov-line" show="${pal_armed}"/>
        <repeat count="${n_ptile}" bind="ptile">
          <item id="pt-${ptile.#}" class="pchq-ft sprite-inline sprite-big skin-bar" label="${ptile.glyph}" sprite="${ptile.sprite}" show="${pal_is_tiles}" action="'${HOUSE}/@.apps/rpg-edit-hq/ops/+x/pal_side.+x' '${HOUSE}' arm ${ptile.#}"/>
        </repeat>
      </row>
      <!-- RIGHT pinned bar: chat as the selected entity (Harold or a pet). -->
      <row id="side-r" class="canvas-overlay-right ov-pin ov-scroll ov-chrome pchq-hotbar theme" show="${side_right}">
        <text label="chat - ${active_name}" class="hb-quiet ov-title theme-3 ov-line" show="${chat_is_edit}"/>
        <text label="h-ai (API)" class="hb-quiet ov-title theme-3 ov-line" show="${chat_is_hai}"/>
        <text label="network (read only)" class="hb-quiet ov-title theme-3 ov-line" show="${chat_is_net}"/>
        <item id="sr-min" class="ov-min hb-slot skin-bar theme-3" label="_" action="'${HOUSE}/@.apps/layout-studio/ops/+x/side_toggle.+x' '${HOUSE}/@.apps/rpg-edit-hq/board/state/sides.txt' side_right hide"/>
        <repeat count="${n_chat}" bind="chat"><text label="${chat.label}" class="rp-chat ov-line ov-scrolltext ${chat.cls}"/></repeat>
        <cli_io id="say" target_id="rp-say" rows="3" class="rp-say" label="&gt; " action="'${HOUSE}/@.apps/rpg-edit-hq/ops/+x/rpg_edit_hq.+x'"/>
      </row>
      <row id="hotbar-ov" class="canvas-overlay-bottom ov-chrome ov-slide-x rp-hotbar theme" show="${hb_visible}">
        <text label="${hb_title}" class="hb-quiet ov-title theme-3"/>
        <item id="hb-min" class="ov-min hb-slot skin-bar theme-3" label="_" action="'${HOUSE}/@.apps/rpg-edit-hq/ops/+x/rpg_edit_hq.+x' toggle hb"/>
        <repeat count="${hb_n_slots}" bind="hb">
          <item id="hbs${hb.#}" class="hb-slot skin-bar" label="${hb.text}" action="'${HOUSE}/@.apps/rpg-edit-hq/ops/+x/rpg_edit_hq.+x' fire use ${hb.key}"/>
        </repeat>
      </row>
      <!-- 2026-11-04 the coin shop popup: pick an item in the Coin shop tab, then Buy / Sell / Close here (the "Show Choices" pattern of the rpg-space helm popup); it stays open so you can repeat, and shows the last answer -->
      <row id="lshop-ov" class="canvas-overlay-at ov-chrome rp-chat-ov theme" show="${lshop_ov}">
        <text label="${lshop_ov_title}" class="hb-quiet ov-title theme-3"/>
        <text label="${lshop_ov_text}" class="rp-big"/>
        <text label="${lshop_ov_coins}" class="hb-quiet"/>
        <text label="${lshop_ov_last}" class="hb-quiet"/>
        <item id="lshop-buy" class="rp-menu-row" label="Buy 1" action="'${HOUSE}/@.apps/rpg-edit-hq/ops/+x/rpg_edit_hq.+x' fire lshop buy"/>
        <item id="lshop-sell" class="rp-menu-row" label="Sell 1" action="'${HOUSE}/@.apps/rpg-edit-hq/ops/+x/rpg_edit_hq.+x' fire lshop sell"/>
        <item id="lshop-close" class="rp-menu-row" label="Close" action="'${HOUSE}/@.apps/rpg-edit-hq/ops/+x/rpg_edit_hq.+x' fire lshop close"/>
      </row>
    </panel>
    <footer id="statusbar" class="pchq-footer" show="${entities_bar_on}">
      <text label="ents" class="quiet"/>
      <item id="sl-toggle" class="pchq-ft" label="pets" action="'${HOUSE}/@.apps/rpg-edit-hq/ops/+x/pal_side.+x' '${HOUSE}' pets"/>
      <item id="sp-toggle" class="pchq-ft" label="palettes" action="'${HOUSE}/@.apps/rpg-edit-hq/ops/+x/pal_side.+x' '${HOUSE}' open"/>
      <item id="sr-toggle" class="pchq-ft" label="chat" action="'${HOUSE}/@.apps/layout-studio/ops/+x/side_toggle.+x' '${HOUSE}/@.apps/rpg-edit-hq/board/state/sides.txt' side_right toggle"/>
      <item id="hb-toggle" class="pchq-ft" label="hb" action="'${HOUSE}/@.apps/rpg-edit-hq/ops/+x/rpg_edit_hq.+x' toggle hb"/>
      <repeat count="${n_ent}" bind="ent">
        <item id="eok${ent.#}" class="pchq-ft sprite-inline sprite-big hpb-ok" label="${ent.label} ${ent.hpb}" sprite="${ent.sprite}" action="'${HOUSE}/@.apps/rpg-edit-hq/ops/+x/rpg_edit_hq.+x' selev '${ent.kind}' '${ent.label}' '${ent.x}' '${ent.y}' '${ent.z}' '${ent.id}'" show="${ent.hp_ok}"/>
        <item id="elow${ent.#}" class="pchq-ft sprite-inline sprite-big hpb-low" label="${ent.label} ${ent.hpb}" sprite="${ent.sprite}" action="'${HOUSE}/@.apps/rpg-edit-hq/ops/+x/rpg_edit_hq.+x' selev '${ent.kind}' '${ent.label}' '${ent.x}' '${ent.y}' '${ent.z}' '${ent.id}'" show="${ent.hp_low}"/>
        <item id="eko${ent.#}" class="pchq-ft sprite-inline sprite-big hpb-ko" label="${ent.label} ${ent.hpb}" sprite="${ent.sprite}" action="'${HOUSE}/@.apps/rpg-edit-hq/ops/+x/rpg_edit_hq.+x' selev '${ent.kind}' '${ent.label}' '${ent.x}' '${ent.y}' '${ent.z}' '${ent.id}'" show="${ent.hp_ko}"/>
        <item id="enone${ent.#}" class="pchq-ft sprite-inline sprite-big" label="${ent.label}" sprite="${ent.sprite}" action="'${HOUSE}/@.apps/rpg-edit-hq/ops/+x/rpg_edit_hq.+x' selev '${ent.kind}' '${ent.label}' '${ent.x}' '${ent.y}' '${ent.z}' '${ent.id}'" show="${ent.hp_none}"/>
      </repeat>
    </footer>
    <text label="No live board-viewer session - open the board with open_board.sh." class="quiet" show="${no_session}"/>
  </page>
</window>
