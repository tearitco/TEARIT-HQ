"tools":[
{"type":"function","function":{"name":"battle","description":"Pick a muchi entity and fight it. target=entity name (e.g. m8_redhorned). Deals damage to the target and gains xp.","parameters":{"type":"object","properties":{"target":{"type":"string"}},"required":["target"]}}},
{"type":"function","function":{"name":"move","description":"Move around the grid. dx and dy are integers (-1,0,1). Logs the move to the ledger.","parameters":{"type":"object","properties":{"dx":{"type":"integer"},"dy":{"type":"integer"}},"required":["dx","dy"]}}},
{"type":"function","function":{"name":"learn","description":"Record a new fact or lesson. fact=the thing you learned. Appends to the corpus and feeds it back to you.","parameters":{"type":"object","properties":{"fact":{"type":"string"}},"required":["fact"]}}},
{"type":"function","function":{"name":"build_self","description":"Improve your own monad. what=description of the improvement (e.g. add a new feature op, tune a script). Appends to a self-improvement log.","parameters":{"type":"object","properties":{"what":{"type":"string"}},"required":["what"]}}},
{"type":"function","function":{"name":"charge","description":"Refill your battery using stored energy. amount=how much battery to add.","parameters":{"type":"object","properties":{"amount":{"type":"integer"}},"required":["amount"]}}},
{"type":"function","function":{"name":"buy_batteries","description":"Spend gold to buy battery packs. qty=number of packs. Each pack costs 5 gold and gives 20 battery.","parameters":{"type":"object","properties":{"qty":{"type":"integer"}},"required":["qty"]}}},
{"type":"function","function":{"name":"chat","description":"Have a real chat turn with the LAN brain model. msg=what you want to say. Appends the exchange to the ledger.","parameters":{"type":"object","properties":{"msg":{"type":"string"}},"required":["msg"]}}},
{"type":"function","function":{"name":"write_other_bots","description":"Write a brand new bot into this monad's entities/ dir. name=bot name, glyph=its emoji glyph, note=what it is for. Creates a fresh entity dir + meta.pdl + ledger.","parameters":{"type":"object","properties":{"name":{"type":"string"},"glyph":{"type":"string"},"note":{"type":"string"}},"required":["name","glyph","note"]}}}
]