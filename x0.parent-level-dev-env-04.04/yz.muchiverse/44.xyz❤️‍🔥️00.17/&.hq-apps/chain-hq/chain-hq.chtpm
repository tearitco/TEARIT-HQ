<!-- chain-hq.chtpm - REAL, NEW 2026-08-31, real HQ-style window shell
     for the network cell's "Chain" row (NETWORK-CELL-HQ-WINDOWS-
     DESIGN.md §12). Same real mechanism as irc-chat-hq.chtpm's own
     header comment - "chain-window" is a genuinely new class, falls
     through to the generic sidebar+panel+button+text renderer via the
     SAME shared khtpm_core_render.+x, zero new C code.

     Real content is STATIC PLACEHOLDER TEXT ONLY (no wiring yet). Real
     shape (Wallet/Send/Mine/History tabs, a wallet dashboard, NOT a
     chat/feed shape - deliberately different, per its own real
     feature set) matches 041.pal-chain's own real schema (TX|from|to|
     amount|ts|tx_id, BLOCK|... records, a real miner state file) and
     real ops (chain_create_wallet.c, chain_login.c, chain_balance.c,
     chain_send.c, chain_miner.c) - see §12's own real wiring plan for
     what each element dispatches to once wired. -->
<window class="database-window chain-window">
  <sidebar id="sidebar" class="sidebar">
    <item class="data-item active" label="Wallet"/>
    <item class="data-item" label="Send"/>
    <item class="data-item" label="Mine"/>
    <item class="data-item" label="History"/>
  </sidebar>
  <panel id="panel" class="panel">
    <text class="block-title" label="Wallet"/>
    <text label="wallet id: (none yet - chain_create_wallet.c / chain_login.c)"/>
    <text label="balance: (chain_balance.c)"/>
    <text label=" "/>
    <text label="to wallet id: ____________"/>
    <text label="amount: ____________"/>
    <button class="btn-primary" label="Send"/>
    <text label=" "/>
    <text label="miner: stopped (chain_miner.c)"/>
    <button class="btn-primary" label="Start Mining"/>
  </panel>
</window>
