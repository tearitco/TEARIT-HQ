# main_module.pal - pieces/chtpm/layouts/main.chtpm's own dedicated
# module, per xyzos-standards §41's per-screen module convention.
# Structure copied directly from 041.pal-chain's own wallet_main_module.pal
# / 01.muchi-pals' own store_module.pal (same proven shape: idle-sync
# once before the first compose so a freshly-launched module's first
# frame is already correct, then loop on screen_changed-diff / real
# relayed key, only recomposing when something actually changed -
# Pitfall 48).
#
# mychara_ai_decide (added retroactively, §10a of MY_CHARA_TXT_DESIGN.md)
# is called once per idle tick in no_key, same ~30ms cadence as the
# existing mychara_menu_input x9 idle poll already runs at safely - the
# op is a self-gating cheap no-op unless supervision_mode is semi/full,
# so this adds no CPU cost in the default (manual) case. Runs from
# EVERY screen's module, not just automation.chtpm's, so Full/Semi
# automation keeps advancing regardless of which screen a human happens
# to be looking at.
li x1, 0

li x9, 0
mychara_menu_input x9
mychara_compose_frame
hit_frame
read_pos x7, "pieces/display/mychara_screen_changed.txt"

loop:
li x9, 0
mychara_menu_input x9
read_pos x8, "pieces/display/mychara_screen_changed.txt"
beq x7, x8, check_key
addi x7, x8, 0
j render

check_key:
read_history pieces/apps/player_app/interact_relay.txt x2, x1
beq x2, x0, no_key
mychara_menu_input x2
j render

no_key:
mychara_ai_decide
sleep 30000
j loop

render:
mychara_compose_frame
hit_frame
sleep 30000
j loop
