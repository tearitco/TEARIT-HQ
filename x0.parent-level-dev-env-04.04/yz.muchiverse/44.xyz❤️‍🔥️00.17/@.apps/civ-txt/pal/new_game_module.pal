# new_game_module.pal - pieces/chtpm/layouts/new_game.chtpm's own
# dedicated module, per xyzos-standards §41's per-screen module
# convention. Same proven shape as @.apps/my-chara-txt's own
# main_module.pal.
li x1, 0

li x9, 0
civ_menu_input x9
civ_compose_frame
hit_frame
read_pos x7, "pieces/display/civ_screen_changed.txt"

loop:
li x9, 0
civ_menu_input x9
read_pos x8, "pieces/display/civ_screen_changed.txt"
beq x7, x8, check_key
addi x7, x8, 0
j render

check_key:
read_history pieces/apps/player_app/interact_relay.txt x2, x1
beq x2, x0, no_key
civ_menu_input x2
j render

no_key:
sleep 30000
j loop

render:
civ_compose_frame
hit_frame
sleep 30000
j loop
