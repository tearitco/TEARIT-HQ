# agy-editor main_loop_chtpm.pal - persistent screen-dispatch loop
# House shape: compose → read interact_relay → menu_input → recompose
# INTERACT keys (typing into canvas) and KEY:n methods (NEW/CLEAR/EXIT)
# both land on interact_relay; menu_input owns the buffer.
li x1, 0

editor_compose_frame
hit_frame
read_pos x7, "pieces/display/editor_screen_changed.txt"

loop:
li x9, 0
editor_menu_input x9
read_pos x8, "pieces/display/editor_screen_changed.txt"
beq x7, x8, check_key
addi x7, x8, 0
j render

check_key:
read_history pieces/apps/player_app/interact_relay.txt x2, x1
beq x2, x0, no_key
editor_menu_input x2
j render

no_key:
sleep 30000
j loop

render:
editor_compose_frame
hit_frame
sleep 30000
j loop
