<!-- menu.chtpm — ava's real entity context menu, Stage 2c PROOF (2026-08-16,
     direct instruction: "oh use chtpm. its standard" - overriding the
     smaller module-only-bolt-on option). This is a TEST case, ONE entity
     only - the current tp_desktop_window_rgb.c popup engine (objects.pdl/
     meta.pdl) still owns every OTHER entity's menu until this is proven
     live. See local-2do-15.txt's own entity-context-menu entry for the
     full reasoning/rollout plan.

     Converted 1:1 from this entity's own real meta.pdl (same METHOD rows,
     same action strings verbatim). action= values reuse the real shell
     commands as-is, which contain literal " characters (for "$0"-style
     var quoting inside the sh -c '...' wrapper) - since this parser only
     supports double-quote-delimited attributes with no entity decoding
     built in elsewhere in this house, khtpm_core_render.c's own
     apply_attr() decodes &quot;/&amp; for the action attribute
     specifically (real, minimal XML entity decoding, not a made-up
     scheme - only the 2 entities actually needed here). Emoji in the
     Play action's real house path is kept as a literal UTF-8 character,
     not entity-escaped - it isn't one of XML's reserved characters. -->
<window class="entity-menu">
  <page name="main">
    <item label="Chat" action="sh -c 'cd &quot;$0&quot; &amp;&amp; H=&quot;$1&quot; &amp;&amp; exec gnome-terminal -- &quot;$H/@.apps/asa-&-ava/pieces/ava/chat.sh&quot;'"/>
    <item label="Events" action="sh -c 'exec &quot;$1/&.widgits/events-hq/button.sh&quot; &quot;$0&quot; &quot;$1&quot;'"/>
    <item label="Events (mock)" action="sh -c 'cd &quot;$0&quot; &amp;&amp; H=&quot;$1&quot; &amp;&amp; exec sh &quot;$H/&.widgits/event-editor/gl_mock/button.sh&quot; run'"/>
    <item label="Events (ez)" action="sh -c 'cd &quot;$0&quot; &amp;&amp; H=&quot;$1&quot; &amp;&amp; exec env EZ_PKG_NAME=ava-$(cat &quot;$0/instance_id.txt&quot;) EZ_PKG_DIR=&quot;$H/@.apps/asa-&-ava/pieces/ava/event_pkg&quot; sh &quot;$H/&.widgits/event-ez/button.sh&quot; run-widget'"/>
    <item label="Play" action="sh -c 'cd &quot;$0&quot; &amp;&amp; H=&quot;$1&quot; &amp;&amp; test -f &quot;$H/@.apps/asa-&-ava/pieces/ava/event_pkg/pages/page_1/event.pal&quot; &amp;&amp; exec &quot;$H/101.mutaclsym🧟‍♂️️+18.01/system/prisc+x&quot; &quot;$H/@.apps/asa-&-ava/pieces/ava/event_pkg/pages/page_1/event.pal&quot;'"/>
    <item label="Stop" action="void"/>
    <item label="Ledger" action="sh -c 'cd &quot;$0&quot; &amp;&amp; H=&quot;$1&quot; &amp;&amp; exec gedit &quot;$H/@.apps/asa-&-ava/pieces/ava/master_ledger.txt&quot;'"/>
    <item label="Dir" action="sh -c 'exec xdg-open &quot;$0&quot;'"/>
    <item label="Close" action="CLOSE"/>
    <item label="Cancel" action="void"/>
  </page>
</window>
