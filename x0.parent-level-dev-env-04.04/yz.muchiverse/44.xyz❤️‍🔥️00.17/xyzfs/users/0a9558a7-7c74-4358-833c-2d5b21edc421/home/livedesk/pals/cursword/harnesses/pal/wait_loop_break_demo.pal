# wait_loop_break_demo.pal - PAL-authored, fully self-contained proof of the
# Tier-3 Loop / Break Loop / Repeat Above compiler idioms PLUS the Wait
# command's mechanism, in EXACTLY the shape compile_page() emits (see
# khtpm_events_hq_manager.c's Loop/Break/Repeat case and the `wait` registry
# block in event_commands.registry.pdl - the W-1 caveat: Wait compiles to the
# VM's EXISTING `sleep <micros>` opcode, NOT a new SYS_SLEEP syscall).
# Companion to task3_switch_branch_verify.pal: that one proved if/else fork
# shapes; this one proves the loop machinery that wraps them.
#
# The loop-shape under test (RPG Maker semantics, exactly what the compiler
# writes for  Loop / <body> / if(cond)->Break Loop / end / Repeat Above):
#     _loop_1:            <- from "loop"
#       sleep 100000      <- from "wait" ms=100  ({ms}000 micros)
#       counter++         <- loop body
#       beq  counter,2 -> _loop_end_1   <- "if true -> break_loop"
#       j _loop_1         <- "repeat_above" (the ONLY backward jump)
#     _loop_end_1:        <- emitted physically AFTER the repeat; the only
#                            break target, so a break always EXITS cleanly
#                            and can never loop back into the body
#       control_switch done=1   <- post-loop work: proves we reached code
#                                   that the body can never reach by falling
#                                   through the repeat
#       verdict (PASS==1 / FAIL==0) into a real results file
#
# Registers (same roles as the other harnesses):
#   x2  - loop counter (loop-local variable, starts 0, ++ each iteration)
#   x3  - the break point (2) - a scratch constant, reused for the final
#         equality check too
#   x15 - the syscall NUMBER (7 = SYS_SET_KV_INT)
#   x12 - syscall value register (the value SET / the PASS-FAIL verdict)
# NOTE: counter-increment here is plain register arithmetic because this
# hand-written demo has no real "read variable, add, write back" runtime
# yet; a real authored loop would instead flip a switch via control_switch
# or drive control_variable SYS_GET_KV_INT/SYS_SET_KV_INT pairs - the
# break_loop `j _loop_end_1` line itself is IDENTICAL either way.
#
# Real files (all /tmp, ASCII-safe, disposable - this exact class of file
# once broke ecall/fopen under a Unicode house-root path, see task3):
#   /tmp/wait_loop_break_demo_results.txt - the real verdict, cat this
#     after running: pass=1 (PASS) or pass=0 (FAIL)

li x2, 0              # x2 = 0 -> loop counter starts at zero
_loop_1:              # label from "loop": the body always re-enters here
sleep 100000          # from "wait" ms=100 -> 100000 micros (real pacing, not a spin)
addi x2, x2, 1        # loop body: counter++
li x3, 2              # x3 = 2 -> the break point
beq x2, x3, _loop_end_1   # "if counter==2 take the true branch" -> break_loop:
                          # a forward jump BY NAME (VM resolves labels after
                          # parse) - lands on _loop_end_1, past the repeat
j _loop_1             # "repeat_above": backward jump to the loop start.
                      # NOT fall-through: nothing after this line is reachable
                      # from the body, so _loop_end_1 below is provably the
                      # break landing, never a body re-entry

_loop_end_1:          # the break target, emitted right after the repeat
li x15, 7             # x15 = 7 -> SYS_SET_KV_INT
li x12, 1             # x12 = 1 -> "done = ON" switch value
ecall "/tmp/wait_loop_break_demo_results.txt" "done"   # control_switch done = 1

li x12, 1             # default verdict: PASS (counter reached 2 and broke)
li x3, 2
beq x2, x3, _verdict_pass   # if counter REALLY is 2 (body ran exactly twice,
                            # break really fired), keep PASS
li x12, 0             # FAIL if 0, 1, or 3+ iterations somehow happened
_verdict_pass:
li x15, 7
ecall "/tmp/wait_loop_break_demo_results.txt" "pass"   # the real verdict

halt                  # done - cat /tmp/wait_loop_break_demo_results.txt