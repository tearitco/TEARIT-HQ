<!-- menu.chtpm — book-stack's real entity context menu, Stage 2c
     ROLLOUT (2026-08-16, direct instruction "yes we need to finish those" -
     entity-context-menu rollout beyond ava). Converted 1:1 from this
     entity's own real meta.pdl (same METHOD rows, same action strings
     verbatim) via the same real mechanical conversion rule proven on ava/asa
     (scratchpad meta_to_chtpm.py) - action= values reuse the real shell
     commands as-is, &quot;/&amp; entity-decoded by khtpm_entity_menu_
     render.c's own apply_attr(), the same 2 entities that parser already
     supports. -->
<window class="entity-menu">
  <page name="main">
    <item label="Read" action="sh -c 'export PACKAGE_DIR=&quot;$0&quot;; H=&quot;$1&quot;; exec &quot;$(find &quot;$H&quot; -maxdepth 1 -name &quot;101.mutaclsym🧟‍♂️️*&quot; -type d 2&gt;/dev/null | head -1)/system/prisc+x&quot; &quot;$(find &quot;$H&quot; -path &quot;*monads/*book-stack/pieces/reader/event_pkg/pages/page_1/event.pal&quot; 2&gt;/dev/null | head -1)&quot;'"/>
    <item label="Dir" action="sh -c 'exec xdg-open &quot;$0&quot;'"/>
    <item label="Close" action="CLOSE"/>
    <item label="Cancel" action="void"/>
  </page>
</window>
