# task3_switch_branch_verify.pal - PAL-authored PORT of
# events_hq_task3_test_harness.sh's real runtime check (T3/T4): set a
# switch ON, verify the true branch fires; set it OFF, verify the false
# branch fires. Fully self-contained - no bash orchestration at all,
# just real prisc+x syscalls. This is a genuinely different kind of
# proof than task5_view_tab_switch_demo.pal (which drives a live GUI
# window) - this one is a full, HEADLESS replacement of an existing
# bash test's actual verification logic, see HARNESS-AUTHORING-GUIDE.md
# section "3a-proof2" for the full writeup.
#
# Registers used:
#   x12 - working register: every syscall's main input/output value
#         (the switch value to SET, the switch value read back by GET,
#         the fd returned by OPEN, the PASS/FAIL flag we write out).
#   x13 - syscall's second input (open-mode for SYS_OPEN / default value
#         for SYS_GET_KV_INT). Only meaningful right before its ecall.
#   x15 - the syscall NUMBER (1=OPEN, 2=CLOSE, 6=GET_KV_INT, 7=SET_KV_INT).
#   x1  - scratch: holds the fd we got back from opening a marker file
#         for read, so we can compare it against -1 AFTER closing it.
#   x2  - scratch constant, reused for different comparison values at
#         different points below (1 for "switch is ON", -1 for "file
#         did not open/doesn't exist").
#
# Real files this script reads/writes (all in /tmp, disposable, ASCII-
# safe paths - see this house's own k9 testing doc for why a Unicode
# house-root path caused a real ecall/fopen bug once; not worth risking
# here since none of these files need to live under the real house
# root at all):
#   /tmp/pal_harness_switches.txt   - the one switch this script flips
#   /tmp/pal_harness_on_marker.txt  - written if the ON step took the true branch
#   /tmp/pal_harness_off_marker.txt - written if the ON step took the false branch (should NOT happen)
#   /tmp/pal_harness_on_marker2.txt - written if the OFF step took the true branch (should NOT happen)
#   /tmp/pal_harness_off_marker2.txt- written if the OFF step took the false branch (expected)
#   /tmp/pal_harness_results.txt    - the real PASS(1)/FAIL(0) flags this script's own "test result" is judged on

# ===== Step 1: switch ON =====
li x15, 7          # x15 = 7 -> next ecall is SYS_SET_KV_INT (write one key=value into a flat file, preserving other keys)
li x12, 1          # x12 = 1 -> the value we're about to write (switch = ON)
ecall "/tmp/pal_harness_switches.txt" "test_switch"   # write test_switch=1 into the switches file

li x15, 6          # x15 = 6 -> SYS_GET_KV_INT, read the switch back (mirrors what the REAL compiled event.pal does at runtime)
li x13, 0          # x13 = 0 -> default value if the key were somehow missing (shouldn't happen, we just wrote it)
ecall "/tmp/pal_harness_switches.txt" "test_switch"   # x12 <- the switch's current value
li x2, 1           # x2 = 1 -> "ON" for comparison
bne x12, x2, _else_on_step   # if switch != 1 (shouldn't happen this step), take the false branch instead
li x15, 1          # x15 = 1 -> SYS_OPEN
li x13, 1          # x13 = 1 -> mode "write" (create/truncate)
ecall "/tmp/pal_harness_on_marker.txt"   # create the ON marker - proves the TRUE branch really ran
li x15, 2          # SYS_CLOSE
ecall              # x12 already holds the fd from the OPEN above - close it
j _after_on_step   # skip over the else-branch below

_else_on_step:     # label: the FALSE branch for this step (should not be taken when switch=1)
li x15, 1
li x13, 1
ecall "/tmp/pal_harness_off_marker.txt"   # create the (wrong, unexpected) OFF marker
li x15, 2
ecall
_after_on_step:    # label: both branches rejoin here

li x15, 1          # SYS_OPEN, this time to CHECK whether on_marker exists
li x13, 0          # mode 0 = read (fopen fails / returns -1 if the file doesn't exist)
ecall "/tmp/pal_harness_on_marker.txt"    # x12 <- fd, or -1 if the marker was never created
addi x1, x12, 0    # stash the fd/(-1) result in x1 before it gets clobbered by the CLOSE below
li x15, 2          # SYS_CLOSE (harmless even if x12 is -1 - exec_ecall's own bounds check handles that)
ecall
li x2, -1          # x2 = -1 -> "file did not exist" sentinel
li x12, 1          # default assumption: PASS (marker existed)
beq x1, x2, _r1_fail   # if x1 really was -1 (marker missing), jump down and flip to FAIL instead
j _r1_pass
_r1_fail:
li x12, 0          # overwrite with FAIL
_r1_pass:
li x15, 7          # SYS_SET_KV_INT
ecall "/tmp/pal_harness_results.txt" "on_marker_exists"   # write the real PASS(1)/FAIL(0) result for step 1

# ===== Step 2: switch OFF (same shape as step 1, opposite expected branch) =====
li x15, 7
li x12, 0          # x12 = 0 -> switch = OFF this time
ecall "/tmp/pal_harness_switches.txt" "test_switch"

li x15, 6
li x13, 0
ecall "/tmp/pal_harness_switches.txt" "test_switch"   # x12 <- switch's current value (should be 0 now)
li x2, 1
bne x12, x2, _else_off_step   # switch != 1 (it's 0), so THIS branch is the one we expect to take
li x15, 1
li x13, 1
ecall "/tmp/pal_harness_on_marker2.txt"    # (wrong, unexpected) ON marker for this step
li x15, 2
ecall
j _after_off_step
_else_off_step:    # label: the expected branch when switch=OFF
li x15, 1
li x13, 1
ecall "/tmp/pal_harness_off_marker2.txt"   # create the OFF marker - proves the FALSE branch really ran this time
li x15, 2
ecall
_after_off_step:

li x15, 1
li x13, 0
ecall "/tmp/pal_harness_off_marker2.txt"   # check whether off_marker2 exists this time
addi x1, x12, 0
li x15, 2
ecall
li x2, -1
li x12, 1          # default: PASS
beq x1, x2, _r2_fail
j _r2_pass
_r2_fail:
li x12, 0          # FAIL
_r2_pass:
li x15, 7
ecall "/tmp/pal_harness_results.txt" "off_marker2_exists"   # write the real PASS/FAIL result for step 2

halt               # done - a human (or another script) can now `cat /tmp/pal_harness_results.txt` for the real verdict
