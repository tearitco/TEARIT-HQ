<!-- palettes-emojis.chtpm — real TPMOS-compliant rebuild (2026-08-25,
     au11-hq/TPMOS-COMPLIANCE-DEBT.md's own standing rule). Static,
     checked in, never regenerated by palettes_menu.sh - matches
     stats-hq/bookmarks' own real dashboard.chtpm/bookmarks.chtpm shape.
     Real tile ROWS are injected at runtime by khtpm_entity_menu_render.c's
     own dbhq_inject_palette_tiles(), reading palettes_manager.c's own
     published palettes-emojis_state.txt - not baked into this file. -->
<window class="database-window palettes">
  <module src="*.monads/*.livedesk-taskbar/ops/+x/palettes_manager.+x" args="emojis" />
  <panel class="settings-block">
    <title class="block-title" label="palettes: Emojis"/>
    <text class="pal-hint" label="Click an emoji to place it on the desk."/>
  </panel>
</window>
