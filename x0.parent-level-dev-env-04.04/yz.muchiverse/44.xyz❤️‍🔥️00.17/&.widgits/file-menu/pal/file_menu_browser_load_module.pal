# file_menu_browser_load_module.pal - PHASE 2 per-screen module split
# (2026-07-31, #.haiku+/!.xyzos-standards+1.txt §41), proven first in
# 01.muchi-pals-🥚️-13.01, now applied here. pieces/chtpm/layouts/
# file_menu_browser_load.chtpm's own DEDICATED module - every other
# file-menu screen gets its own module too, so chtpm_parser_pal.c's
# real launch_module() liveness check (kill+relaunch on genuine
# navigation, reuse while staying on one screen) applies per screen,
# not once for the whole widget.
#
# Reuses the SAME shared ops (fm_menu_input, fm_compose_frame) every
# other screen's module also calls - splitting those into per-screen
# dedicated files is a separate, later step, not done here. Structure
# is a straight copy of the original main_loop_chtpm.pal's own shape.
li x1, 0

li x9, 0
fm_menu_input x9
fm_compose_frame
hit_frame
read_pos x7, "pieces/display/fm_screen_changed.txt"

loop:
li x9, 0
fm_menu_input x9
read_history pieces/apps/player_app/interact_relay.txt x2, x1
beq x2, x0, no_key
fm_menu_input x2
j render_always

no_key:
read_pos x8, "pieces/display/fm_screen_changed.txt"
beq x7, x8, no_render
addi x7, x8, 0

render_always:
fm_compose_frame
hit_frame
sleep 16667
j loop

no_render:
sleep 16667
j loop
