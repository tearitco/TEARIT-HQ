<panel time_reactive="true">
    <module>system/prisc+x pal/main_loop_chtpm.pal</module>
    <interact src="pieces/apps/player_app/interact_relay.txt" />
    <text label="${game_map}" /><br/>
    <button label="EDIT TEXT (INTERACT)" onClick="INTERACT" id="edit_canvas" /><br/>
    <button label="FILE MENU" href="pieces/chtpm/layouts/file_menu.chtpm" /><br/>
    <text label=" Esc exits INTERACT | Ctrl+C quit" /><br/>
</panel>
