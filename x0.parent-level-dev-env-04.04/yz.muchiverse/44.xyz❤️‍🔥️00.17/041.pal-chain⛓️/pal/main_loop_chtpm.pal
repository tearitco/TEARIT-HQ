# pal-chain main_loop.pal - CHTPM-MODULE VARIANT, modeled directly on
# wsr-pal's own pal/main_loop_chtpm.pal (that project's own real fix for
# the flicker regression and the double-dispatch bug - see that file's
# own header comment for the full account; pal-chain reuses the exact
# same shape verbatim, just renamed to its own ops/marker files, since
# it has the identical "menu-only, no map" structure wsr-pal does).
#
#   - read_history reads pieces/apps/player_app/interact_relay.txt via
#     the literal-path 3-arg form.
#   - x1 (read_history position) starts at 0, never persisted.
#   - chain_menu_input 0, every loop iteration, cheaply re-derives the
#     current screen from pieces/display/current_layout.txt (chtpm's own
#     export) - a genuine no-op when nothing changed (see
#     chain_menu_input.c's own header comment), only bumping
#     pieces/display/chain_screen_changed.txt on a real screen change.
#   - read_pos's own literal-path argument gates compose_frame/hit_frame
#     so idle ticks (~33/sec) don't re-render when nothing happened.
#
# PRE-SYNC BEFORE FIRST COMPOSE (mass-refactor 2026-07-26, same fix
# applied to muchi-pals'/pal-chat-irc's own main_loop_chtpm.pal - see
# muchi-pals' own header comment for the full "[No Methods]"-style
# stale-first-render root cause): this module is killed+relaunched on
# every href transition, so an unconditional compose before the loop's
# own first idle-sync would read dynamic content from before this
# screen's own METHOD rows had ever been generated for it.
li x1, 0

li x9, 0
chain_menu_input x9
compose_frame
hit_frame
read_pos x7, "pieces/display/chain_screen_changed.txt"

loop:
li x9, 0
chain_menu_input x9
read_pos x8, "pieces/display/chain_screen_changed.txt"
beq x7, x8, check_key
addi x7, x8, 0
j render

check_key:
read_history pieces/apps/player_app/interact_relay.txt x2, x1
beq x2, x0, no_key
chain_menu_input x2
j render

no_key:
sleep 30000
j loop

render:
compose_frame
hit_frame
sleep 30000
j loop
