# event_bus.pal - Event Bus helpers for XOD.
#
# Reads events from pieces/apps/player_app/interact_relay.txt
# and dispatches them to the appropriate handler.
#
# Events are pipe-delimited lines:
#   FRAME_CHANGED|<timestamp>
#   KEY_INJECTED|<code>|<behavior>
#   BEHAVIOR_START|<name>|<params>
#   BEHAVIOR_COMPLETE|<name>|<result>
#   ATTRITION_TICK|<resources>
#   GOAL_ADOPTED|<goal_id>|<desc>
#   PLAN_STEP|<index>|<behavior>
#   HARNESS_DONE|<name>|<result>
#
# This is the "Nervous System" of XOD: a file-mediated event bus
# that connects the FSM driver, GOAP planner, attrition model,
# and presentation harnesses.

# Read next event from the bus
# read_event <event_id> <event_out> <timestamp_out>
# Reads the next unprocessed event from interact_relay.txt
# Returns 1 if an event was found, 0 if no event.

# Helper: read the current event position from state
read_pos x5, "pieces/apps/player_app/event_cursor.txt"

# Read the next event from the bus
read_history pieces/apps/player_app/interact_relay.txt x6, x5

# If no event, return 0
beq x6, x0, no_event

# Update the cursor position
addi x7, x5, 1
write_pos "pieces/apps/player_app/event_cursor.txt", x7

# Parse the event: split on '|' to get type and payload
# For now, we just check the first token (event type)
# Full parsing would require a string split op

# Event type dispatch
# x6 contains the event line; we can check prefixes

# Check for FRAME_CHANGED
# (would need string comparison op; for now, we just log)

# Write event to event_log.txt
write "pieces/apps/player_app/event_log.txt", x6

# Return 1 (event found)
li x1, 1
j done

no_event:
    li x1, 0

done:
    halt